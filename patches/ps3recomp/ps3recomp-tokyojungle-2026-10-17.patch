+/* TJ_INDEXED_DIAG=1: read only data the matching indexed uploader will read.
+ * ppu_vm_size==0 retains the runtime's normal unchecked-VM convention; when
+ * it is known, every diagnostic index/attribute span is checked first. */
+static int tj_indexed_diag_guest_span(u32 ea, u64 bytes)
+{
+    extern u32 ppu_vm_size;
+    u64 cap = ppu_vm_size ? (u64)ppu_vm_size : (1ULL << 32);
+    return ea != 0xFFFFFFFFu && bytes <= cap && (u64)ea <= cap - bytes;
