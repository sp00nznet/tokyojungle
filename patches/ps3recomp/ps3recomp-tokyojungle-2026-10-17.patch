+/* Mapping changes are owned by cellGcmSys.  This is intentionally a narrow
+ * atomic read: exclusive commit must not invoke offset translation. */
+extern u8* vm_base;
+extern u32 ppu_vm_size;
+
+static int gpu_main_canonical_identity(u32 raw, u32 pitch, u32 w, u32 h,
+                                       u32* out_ea, u64* out_span, u64* out_gen)
+{
+    if (!pitch || !w || !h) return -1;
+    const u64 row_bytes = (u64)w * 4u;
+    if (row_bytes > pitch) return -1;
+    const u64 prior_rows = (u64)h - 1u;
+    if (prior_rows > UINT64_MAX / pitch) return -1;
+    const u64 prior_bytes = prior_rows * pitch;
+    if (prior_bytes > UINT64_MAX - row_bytes) return -1;
+    const u64 span = prior_bytes + row_bytes;
+    if (!span) return -1;
+    u64 before = cellGcmMainMappingGeneration();
+    u32 ea;
+    int resolved = cellGcmResolveLocatedChecked(0, raw, &ea);
+    u64 after = cellGcmMainMappingGeneration();
+    const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ull << 32);
+    if (!resolved || span > UINT64_MAX - (u64)ea || (u64)ea + span > vm_cap ||
+        !rsx_exact_blit_mapping_generation_stable(before, after)) return -1;
+    if (out_ea) *out_ea = ea;
+    if (out_span) *out_span = span;
+    if (out_gen) *out_gen = before;
+    return 0;
+}
+
+static int gpu_blit_record_mapping_valid(const RsxD3D12ExactBlit* b)
+{
+    if (!b) return 0;
+    u64 before = cellGcmMainMappingGeneration();
+    u32 src_ea, dst_ea;
+    int src_resolved = cellGcmResolveLocatedChecked(b->src_local, b->src_raw,
+                                                     &src_ea);
+    int dst_resolved = cellGcmResolveLocatedChecked(b->dst_local, b->dst_raw,
+                                                     &dst_ea);
+    u64 after = cellGcmMainMappingGeneration();
+    return src_resolved && dst_resolved && rsx_exact_blit_record_mapping_matches(
+        b->mapping_generation, before, after, b->src_ea, src_ea,
+        b->dst_ea, dst_ea);
+}
+
+static int gpu_mirror_find_canonical_containing(u32 ea, u32 pitch, u32 w, u32 h,
+                                                u64 expected_generation,
+                                                u32 before_record,
+                                                u32* out_x, u32* out_y)
+{
+    if ((expected_generation & 1u) ||
+        cellGcmMainMappingGeneration() != expected_generation) return -2;
+    for (int i = 0; i < MAX_GPU_MIRRORS; ++i) {
+        const GpuMirror* m = &s_d3d.gpu_mirror[i];
+        if (!m->valid || m->immutable_source || m->local || m->pitch != pitch ||
+            !m->canonical_span || (m->mapping_generation & 1u)) continue;
+        /* Replay reads see only prior FIFO writers. Preflight passes UINT32_MAX
+         * because allocation/alias reservation must still see every backing. */
+        if (before_record != UINT32_MAX &&
+            (!m->first_write_record_plus_one ||
+             m->first_write_record_plus_one > before_record)) continue;
+        if (m->mapping_generation != expected_generation) return -2;
+        if (rsx_scaled_blit_alias_origin(m->canonical_ea, ea, pitch, m->w, m->h,
+                                          w, h, out_x, out_y)) return i;
+    }
+    return -1;
+}
+
+static int gpu_mirror_canonical_overlap(u32 ea, u64 span, u64 expected_generation,
+                                         u32 before_record)
+{
+    u64 end = (u64)ea + span;
+    if ((expected_generation & 1u) ||
+        cellGcmMainMappingGeneration() != expected_generation) return -1;
+    for (int i = 0; i < MAX_GPU_MIRRORS; ++i) {
+        const GpuMirror* m = &s_d3d.gpu_mirror[i];
+        if (!m->valid || m->immutable_source || m->local || !m->canonical_span)
+            continue;
+        if (before_record != UINT32_MAX &&
+            (!m->first_write_record_plus_one ||
+             m->first_write_record_plus_one > before_record)) continue;
+        if (m->mapping_generation != expected_generation) return -1;
+        u64 mend = (u64)m->canonical_ea + m->canonical_span;
+        if ((u64)ea < mend && end > m->canonical_ea) return 1;
+    }
+    return 0;
+}
+
+static void exact_writeback_release(void)
+{
+    for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+        ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+        if (p->readback_mapped && p->readback) {
+            D3D12_RANGE wr = {0, 0};
+            p->readback->lpVtbl->Unmap(p->readback, 0, &wr);
+            p->readback_mapped = 0;
+            p->mapped_rgba = NULL;
+        }
+        GpuScratchAllocation a = {p->readback, NULL, D3D12_RESOURCE_STATE_COPY_DEST,
+            GPU_SCRATCH_READBACK, p->readback_pitch, p->h, p->allocation_bytes};
+        gpu_scratch_retain(&a);
+        free(p->packed_argb);
+        rsx_d3d12_blit_snapshot_release(p->baseline, p->packed_bytes);
+    }
+    memset(s_exact_writeback, 0, sizeof(s_exact_writeback));
+    s_exact_writeback_count = 0;
+}
+
+/* A failed fence leaves command completion unknown.  Do not release a D3D
+ * readback resource the GPU may still reference; intentionally leak that COM
+ * reference while permanently halting this backend. */
+static void exact_writeback_abandon_after_submit(void)
+{
+    for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+        free(s_exact_writeback[i].packed_argb);
+        rsx_d3d12_blit_snapshot_release(s_exact_writeback[i].baseline,
+                                         s_exact_writeback[i].packed_bytes);
+        s_exact_writeback[i].readback = NULL;
+    }
+    memset(s_exact_writeback, 0, sizeof(s_exact_writeback));
+    s_exact_writeback_count = 0;
+}
+
+/* Conservative lifetime ownership, including evicted render targets. CPU
+ * writes never clear it: a page once claimed by the GPU cannot silently fall
+ * back to stale guest VRAM. Reset only with the whole renderer. */
+#define TJ_LOCAL_VRAM_BYTES (256u << 20)
+#define TJ_LOCAL_PAGE_SHIFT 12u
+static u8 s_local_gpu_pages[TJ_LOCAL_VRAM_BYTES >> TJ_LOCAL_PAGE_SHIFT];
+static int s_local_gpu_ownership_unknown;
+
+static void local_gpu_claim_span(u32 raw, u64 span)
+{
+    if (!span || raw >= TJ_LOCAL_VRAM_BYTES || span > TJ_LOCAL_VRAM_BYTES - raw) {
+        s_local_gpu_ownership_unknown = 1;
+        return;
+    }
+    u32 first = raw >> TJ_LOCAL_PAGE_SHIFT;
+    u32 last = (u32)(((u64)raw + span - 1) >> TJ_LOCAL_PAGE_SHIFT);
+    memset(s_local_gpu_pages + first, 1, last - first + 1);
+}
+
+static void local_gpu_claim_surface(u32 raw, u32 pitch, u32 w, u32 h, u32 bpp)
+{
+    u64 row = (u64)w * bpp;
+    u64 stride = pitch > row ? pitch : row;
+    if (!w || !h || !bpp || stride > TJ_LOCAL_VRAM_BYTES ||
+        h > TJ_LOCAL_VRAM_BYTES / stride) {
+        s_local_gpu_ownership_unknown = 1;
+        return;
+    }
+    local_gpu_claim_span(raw, stride * h);
+}
+
+static int local_gpu_span_is_cpu(u32 raw, u64 span)
+{
+    if (s_local_gpu_ownership_unknown || !span || raw >= TJ_LOCAL_VRAM_BYTES ||
+        span > TJ_LOCAL_VRAM_BYTES - raw) return 0;
+    u32 first = raw >> TJ_LOCAL_PAGE_SHIFT;
+    u32 last = (u32)(((u64)raw + span - 1) >> TJ_LOCAL_PAGE_SHIFT);
+    return memchr(s_local_gpu_pages + first, 1, last - first + 1) == NULL;
+}
+
+/* Capture both existing backings and queued producers before cache eviction
+ * or FIFO replay can discard their identities. At record time, draws contains
+ * only preceding commands, so future GPU writes cannot erase a CPU snapshot. */
+static void local_gpu_claim_pending(void)
+{
+    for (int i = 0; i < MAX_OFF_RTS; ++i) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (r->res && r->local)
+            local_gpu_claim_surface(r->off, r->raw_pitch, r->w, r->h,
+                                    dxgi_bytes_per_pixel((DXGI_FORMAT)r->dxgi));
+    }
+    for (int i = 0; i < MAX_DEPTH_SURFACES; ++i) {
+        const DepthSurface* r = &s_d3d.depth_surface[i];
+        if (r->valid && r->local)
+            local_gpu_claim_surface(r->raw, r->pitch, r->w, r->h, r->format == 1 ? 2 : 4);
+    }
+    for (int i = 0; i < MAX_DISPLAY_SURFACES; ++i) {
+        const DisplaySurface* r = &s_d3d.display_surface[i];
+        if (r->res) local_gpu_claim_surface(r->raw, r->pitch, r->w, r->h, 4);
+    }
+    for (u32 i = 0; i < s_d3d.draw_count && i < MAX_DRAWS; ++i) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[i];
+        if (dr->is_scaled_blit) {
+            const RsxD3D12ExactBlit* b = &dr->scaled_blit;
+            if (b->dst_local) {
+                u32 w = (u32)b->dst_x + b->copy_w, h = (u32)b->dst_y + b->copy_h;
+                if (w < b->dst_w) w = b->dst_w;
+                if (h < b->dst_h) h = b->dst_h;
+                local_gpu_claim_surface(b->dst_raw, b->dst_pitch, w, h, 4);
+            }
+            continue;
+        }
+        if (!dr->is_vp && !legacy_record_supported(dr)) continue;
+        u32 targets[4] = {dr->rt_off, dr->rt_mrt[0], dr->rt_mrt[1], dr->rt_mrt[2]};
+        u8 local[4] = {dr->rt_local, dr->rt_mrt_local[0], dr->rt_mrt_local[1], dr->rt_mrt_local[2]};
+        u32 bpp = dxgi_bytes_per_pixel(rsx_surface_dxgi(dr->rt_fmt));
+        for (int t = 0; t < 4; ++t) {
+            if (!local[t] || !dr_rt_attachment_enabled(dr, t)) continue;
+            u32 w = dr->rt_w ? dr->rt_w : s_d3d.width;
+            u32 h = dr->rt_h ? dr->rt_h : s_d3d.height;
+            u32 pitch = 0;
+            for (int p = 0; p < 4; ++p)
+                if (dr->rt_raw[p] == targets[t] && dr->rt_raw_local[p] == local[t])
+                    pitch = dr->rt_pitch[p];
+            if (!pitch) pitch = w * bpp;
+            u32 x = 0, y = 0;
+            u64 span = h ? (u64)(h - 1) * pitch + (u64)w * bpp : 0;
+            u32 raw = off_rt_tile_canonical(targets[t], pitch, bpp, span, &x, &y);
+            u64 end_x = (u64)x + dr->rt_window_x + w;
+            u64 end_y = (u64)y + dr->rt_window_y + h;
+            if (end_x > UINT32_MAX || end_y > UINT32_MAX)
+                s_local_gpu_ownership_unknown = 1;
+            else local_gpu_claim_surface(raw, pitch, (u32)end_x, (u32)end_y, bpp);
+        }
+        if (dr->zeta_local && dr->zeta_pitch) {
+            u32 w, h;
+            depth_surface_extent(dr, s_d3d.width, s_d3d.height, &w, &h);
+            local_gpu_claim_surface(dr->zeta_raw, dr->zeta_pitch, w, h,
+                                    dr->zeta_format == 1 ? 2 : 4);
+        }
+    }
+}
+
+int rsx_d3d12_backend_local_source_is_cpu(u32 raw, u32 pitch, u32 w, u32 h)
+{
+    VP_SNAP_PAR_BARRIER(BLIT);
+    if (!s_d3d.initialized || s_d3d.gcm2d_backend_halted || !pitch ||
+        (pitch & 3u) || !w || !h || (u64)w * 4u > pitch) return 0;
+    local_gpu_claim_pending();
+    return local_gpu_span_is_cpu(raw, (u64)pitch * h);
+}
+
+static int exact_writeback_authoritative_source(const GpuBlitEndpoint* src)
+{
+    if (src->kind == GPU_BLIT_DISPLAY)
+        return src->slot >= 0 && src->slot < MAX_DISPLAY_SURFACES &&
+               s_d3d.display_surface[src->slot].valid;
+    if (src->kind == GPU_BLIT_OFFRT) return 1;
+    return src->kind == GPU_BLIT_MIRROR && src->slot >= 0 &&
+           src->slot < MAX_GPU_MIRRORS &&
+           !s_d3d.gpu_mirror[src->slot].immutable_source &&
+           s_d3d.gpu_mirror[src->slot].authoritative;
+}
+
+static int tj_main_mapped_commit_enabled(void)
+{
+#if !defined(__SSE2__) && !defined(_M_X64)
+    /* This optimization moves conversion into the guest suspension window. */
+    return 0;
+#else
+    static int cached = -1;
+    if (cached < 0) {
+        const char* value = getenv("TJ_MAIN_MAPPED_COMMIT");
+        cached = value && strcmp(value, "1") == 0;
+    }
+    return cached;
+#endif
+}
+
+static int exact_writeback_readback_alloc(ExactBlitWritebackPlan* p,
+                                          const char** out_code,
+                                          HRESULT* out_hr)
+{
+    if (out_code) *out_code = "READBACK_LIMIT";
+    if (out_hr) *out_hr = S_OK;
+    if (!p || !p->w || !p->h || p->dxgi != DXGI_FORMAT_R8G8B8A8_UNORM ||
+        p->w > 16384u || p->h > 16384u || p->w > UINT32_MAX / 4u)
+        return -1;
+    u32 row_bytes = p->w * 4u;
+    p->readback_pitch = (row_bytes + 255u) & ~255u;
+    p->packed_bytes = (u64)row_bytes * p->h;
+    if (!p->readback_pitch || p->packed_bytes == 0 ||
+        p->packed_bytes > (256ULL << 20) ||
+        (u64)p->readback_pitch * p->h > (256ULL << 20) ||
+        p->packed_bytes > SIZE_MAX)
+        return -1;
+    p->mapped_commit = tj_main_mapped_commit_enabled();
+    LONGLONG perf_mark = tj_gcm2d_backend_perf_subphase_begin();
+    if (!p->mapped_commit)
+        p->packed_argb = (u8*)malloc((size_t)p->packed_bytes);
+    if (s_tj_gcm2d_backend_perf_sample)
+        tj_gcm2d_backend_perf_subphase_end(
+            &s_tj_gcm2d_backend_perf_sample->readback_host_alloc_ticks, perf_mark);
+    if (!p->mapped_commit && !p->packed_argb) {
+        if (out_code) *out_code = "READBACK_MALLOC";
+        return -1;
+    }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width = (u64)p->readback_pitch * p->h;
+    rd.Height = 1; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    perf_mark = tj_gcm2d_backend_perf_subphase_begin();
+    GpuScratchAllocation scratch = {0};
+    HRESULT hr = S_OK;
+    if (gpu_scratch_take(GPU_SCRATCH_READBACK, p->readback_pitch, p->h, &scratch)) {
+        p->readback = scratch.res;
+        p->allocation_bytes = scratch.bytes;
+    } else {
+        hr = s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&p->readback);
+        if (SUCCEEDED(hr) && p->readback)
+            p->allocation_bytes = gpu_scratch_allocation_bytes(&rd);
+    }
+    if (s_tj_gcm2d_backend_perf_sample)
+        tj_gcm2d_backend_perf_subphase_end(
+            &s_tj_gcm2d_backend_perf_sample->readback_d3d_alloc_ticks, perf_mark);
+    if (FAILED(hr) || !p->readback) {
+        if (out_code) *out_code = "READBACK_CREATE";
+        if (out_hr) *out_hr = hr;
+        return -1;
+    }
+    return 0;
+}
+
+/* Preflight all terminal MAIN writes before ANY replay.  The destination
+ * resource is batch-local; raw/EA/generation are captured once here. */
+static void exact_writeback_preflight_reject(const char* code, u32 record,
+                                             const RsxD3D12ExactBlit* b,
+                                             int mirror_slot,
+                                             u64 x, u64 y, u64 later_x,
+                                             u64 later_y, HRESULT hr)
+{
+    static unsigned reports = 0;
+    if (reports++ >= 32) return;
+    u64 current_generation = cellGcmMainMappingGeneration();
+    u32 live_src_ea = 0, live_dst_ea = 0;
+    int live_src_resolved = 0, live_dst_resolved = 0;
+    const GpuMirror* m = NULL;
+    if (b) {
+        live_src_resolved = cellGcmResolveLocatedChecked(b->src_local,
+                                                          b->src_raw, &live_src_ea);
+        live_dst_resolved = cellGcmResolveLocatedChecked(b->dst_local,
+                                                          b->dst_raw, &live_dst_ea);
+    }
+    if (mirror_slot >= 0 && mirror_slot < MAX_GPU_MIRRORS)
+        m = &s_d3d.gpu_mirror[mirror_slot];
+    fprintf(stderr,
+            "[GCM2D-WB] preflight-reject code=%s rec=%u plans=%u "
+            "gen=rec:%llu cur:%llu src=raw:%08X ea:%08X/%08X(%d) "
+            "dst=raw:%08X ea:%08X/%08X(%d) mirror=%d:%d mgen:%llu mea:%08X "
+            "mspan:%llu rect=%llu,%llu %ux%u later=%llu,%llu hr=0x%08lX\n",
+            code, record, s_exact_writeback_count,
+            (unsigned long long)(b ? b->mapping_generation : 0),
+            (unsigned long long)current_generation,
+            b ? b->src_raw : 0, b ? b->src_ea : 0, live_src_ea, live_src_resolved,
+            b ? b->dst_raw : 0, b ? b->dst_ea : 0, live_dst_ea, live_dst_resolved,
+            mirror_slot, m ? m->valid : 0,
+            (unsigned long long)(m ? m->mapping_generation : 0),
+            m ? m->canonical_ea : 0,
+            (unsigned long long)(m ? m->canonical_span : 0),
+            (unsigned long long)x, (unsigned long long)y,
+            b ? b->copy_w : 0, b ? b->copy_h : 0,
+            (unsigned long long)later_x, (unsigned long long)later_y, (long)hr);
+}
+
+static void exact_writeback_transfer_baseline(ExactBlitWritebackPlan* p,
+                                              RsxD3D12ExactBlit* b)
+{
+    p->baseline = b->dst_post_snapshot;
+    b->dst_post_snapshot = NULL;
+    b->dst_post_snapshot_bytes = 0;
+}
+
+/* Metadata only: a terminal export needs canonical MAIN ownership and the
+ * recorded baseline, but no intermediate destination texture. */
+static int exact_writeback_direct_identity(const RsxD3D12ExactBlit* b,
+                                            GpuMirror* m)
+{
+    if (!b || !m || b->dst_local || !b->dst_pitch || (b->dst_pitch & 3u) ||
+        !b->copy_w || !b->copy_h || !b->dst_snapshot ||
+        !b->dst_post_snapshot || b->dst_post_snapshot_bytes !=
+            (u64)b->copy_w * b->copy_h * 4u) return -1;
+    u64 end_x = (u64)b->dst_x + b->copy_w;
+    u64 end_y = (u64)b->dst_y + b->copy_h;
+    u32 w = b->dst_pitch / 4u;
+    u64 h = b->dst_h > end_y ? b->dst_h : end_y;
+    if (end_x > w || b->dst_w > w || !h || w > 16384u || h > 16384u ||
+        h * b->dst_pitch > (256ULL << 20) ||
+        h * b->dst_pitch > b->dst_snapshot_bytes) return -1;
+    memset(m, 0, sizeof(*m));
+    if (gpu_main_canonical_identity(b->dst_raw, b->dst_pitch, w, (u32)h,
+                                    &m->canonical_ea, &m->canonical_span,
+                                    &m->mapping_generation) != 0 ||
+        m->canonical_ea != b->dst_ea ||
+        m->mapping_generation != b->mapping_generation ||
+        gpu_mirror_canonical_overlap(m->canonical_ea, m->canonical_span,
+                                     m->mapping_generation, UINT32_MAX) != 0)
+        return -1;
+    m->raw = b->dst_raw; m->pitch = b->dst_pitch; m->w = w; m->h = (u32)h;
+    m->dxgi = DXGI_FORMAT_R8G8B8A8_UNORM;
+    return 0;
+}
+
+static int exact_writeback_preflight(void)
+{
+    exact_writeback_release();
+    for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS; ++d) {
+        D3D12DrawRecord* dr = &s_d3d.draws[d];
+        if (!dr->is_scaled_blit || !dr->scaled_blit_prepared) continue;
+        RsxD3D12ExactBlit* b = &dr->scaled_blit;
+        if (!gpu_blit_record_mapping_valid(b)) {
+            exact_writeback_preflight_reject("RECORD_MAPPING", d, b, -1, 0, 0, 0, 0, S_OK);
+            return -1;
+        }
+        GpuBlitEndpoint src = {dr->scaled_blit_src_kind, dr->scaled_blit_src_slot,
+                               dr->scaled_blit_src_x, dr->scaled_blit_src_y};
+        GpuBlitEndpoint dst = {dr->scaled_blit_dst_kind, dr->scaled_blit_dst_slot,
+                               dr->scaled_blit_dst_x, dr->scaled_blit_dst_y};
+        if (b->dst_local || dst.kind != GPU_BLIT_MIRROR ||
+            !dr->scaled_blit_src_authoritative) continue;
+        GpuMirror direct_identity = {0};
+        int direct = dr->scaled_blit_direct_readback;
+        if (direct && (d + 1u != s_d3d.draw_count || !b->src_local ||
+            b->src_cpu_owned || exact_writeback_direct_identity(b, &direct_identity))) {
+            exact_writeback_preflight_reject("DIRECT_IDENTITY", d, b, -1, 0, 0, 0, 0, S_OK);
+            return -1;
+        }
+        if (!direct && (dst.slot < 0 || dst.slot >= MAX_GPU_MIRRORS ||
+            s_d3d.gpu_mirror[dst.slot].immutable_source)) {
+            exact_writeback_preflight_reject("MIRROR_SLOT", d, b, dst.slot, 0, 0, 0, 0, S_OK);
+            return -1;
+        }
+        const GpuMirror* m = direct ? &direct_identity : &s_d3d.gpu_mirror[dst.slot];
+        u64 x = (u64)dst.x + b->dst_x, y = (u64)dst.y + b->dst_y;
+        if (x > UINT32_MAX || y > UINT32_MAX ||
+            x + b->copy_w > m->w || y + b->copy_h > m->h) {
+            exact_writeback_preflight_reject("RECT_BOUNDS", d, b, dst.slot, x, y, 0, 0, S_OK);
+            return -1;
+        }
+        int overwritten = 0;
+        for (u32 later = d + 1; later < s_d3d.draw_count && later < MAX_DRAWS; ++later) {
+            D3D12DrawRecord* next = &s_d3d.draws[later];
+            if (!next->is_scaled_blit || !next->scaled_blit_prepared) continue;
+            const RsxD3D12ExactBlit* nb = &next->scaled_blit;
+            if (next->scaled_blit_dst_kind != GPU_BLIT_MIRROR ||
+                next->scaled_blit_dst_slot != dst.slot) continue;
+            u64 nx = (u64)next->scaled_blit_dst_x + nb->dst_x;
+            u64 ny = (u64)next->scaled_blit_dst_y + nb->dst_y;
+            if (nx > UINT32_MAX || ny > UINT32_MAX) {
+                exact_writeback_preflight_reject("LATER_RECT_COORD", d, b, dst.slot,
+                                                  x, y, nx, ny, S_OK);
+                return -1;
+            }
+            if (rsx_exact_blit_rects_overlap((u32)x, (u32)y, b->copy_w, b->copy_h,
+                                             (u32)nx, (u32)ny, nb->copy_w, nb->copy_h)) {
+                /* A complete later cover is ordinary last-write-wins. Any
+                 * partial overlap would make dropping this plan lose its
+                 * non-overlapped bytes, and multiple overlapping readbacks
+                 * would violate all-or-none commit, so reject pre-submit. */
+                if (rsx_exact_blit_rect_fully_contains((u32)nx, (u32)ny,
+                                                        nb->copy_w, nb->copy_h,
+                                                        (u32)x, (u32)y,
+                                                        b->copy_w, b->copy_h)) {
+                    overwritten = 1;
+                    break;
+                }
+                exact_writeback_preflight_reject("PARTIAL_OVERLAP", d, b, dst.slot,
+                                                  x, y, nx, ny, S_OK);
+                return -1;
+            }
+        }
+        if (overwritten) continue;
+        if (s_exact_writeback_count >= MAX_DRAWS || !b->dst_post_snapshot ||
+            b->dst_post_snapshot_bytes != (u64)b->copy_w * b->copy_h * 4u) {
+            exact_writeback_preflight_reject("PLAN_SNAPSHOT", d, b, dst.slot, x, y, 0, 0, S_OK);
+            return -1;
+        }
+        ExactBlitWritebackPlan* p = &s_exact_writeback[s_exact_writeback_count++];
+        memset(p, 0, sizeof(*p));
+        if (tj_prefix_wait_trace_enabled())
+            p->trace_source_flags = (dr->scaled_blit_src_authoritative ? 1u : 0u) |
+                (b->src_local && !b->dst_local ? 2u : 0u);
+        p->direct_readback = direct;
+        if (!m->canonical_span || (m->mapping_generation & 1u) ||
+            m->mapping_generation != b->mapping_generation ||
+            cellGcmMainMappingGeneration() != m->mapping_generation) {
+            exact_writeback_preflight_reject("MIRROR_MAPPING", d, b, dst.slot,
+                                              x, y, 0, 0, S_OK);
+            return -1;
+        }
+        u64 mapping_before = cellGcmMainMappingGeneration();
+        u32 guest_base;
+        if (!cellGcmResolveLocatedChecked(0, b->dst_raw, &guest_base) ||
+            mapping_before != b->mapping_generation || guest_base != b->dst_ea) {
+            exact_writeback_preflight_reject("DEST_MAPPING", d, b, dst.slot,
+                                              x, y, 0, 0, S_OK);
+            return -1;
+        }
+        u64 guest_delta = (u64)b->dst_y * b->dst_pitch + (u64)b->dst_x * 4u;
+        if (guest_delta > UINT32_MAX || guest_base > UINT32_MAX - guest_delta) {
+            exact_writeback_preflight_reject("GUEST_DELTA", d, b, dst.slot,
+                                              x, y, 0, 0, S_OK);
+            return -1;
+        }
+        p->record = d; p->mirror_slot = (u32)dst.slot;
+        p->mapping_raw = b->dst_raw; p->canonical_raw = m->raw;
+        p->canonical_ea = m->canonical_ea;
+        p->guest_ea = (u32)(guest_base + guest_delta);
+        p->guest_pitch = b->dst_pitch; p->x = (u32)x; p->y = (u32)y;
+        p->w = b->copy_w; p->h = b->copy_h; p->dxgi = m->dxgi;
+        p->canonical_span = m->canonical_span;
+        p->mapping_generation = cellGcmMainMappingGeneration();
+        if (!rsx_exact_blit_mapping_generation_stable(mapping_before,
+                                                       p->mapping_generation) ||
+            p->mapping_generation != m->mapping_generation ||
+            p->mapping_generation != b->mapping_generation) {
+            exact_writeback_preflight_reject("PLAN_GENERATION", d, b, dst.slot,
+                                              x, y, 0, 0, S_OK);
+            return -1;
+        }
+        /* ppu_vm_size == 0 is the runtime's full 32-bit guest-VM mode; the
+         * span helper below deliberately maps that sentinel to 1ULL << 32. */
+        if (!vm_base) {
+            exact_writeback_preflight_reject("VM_BASE", d, b, dst.slot,
+                                              x, y, 0, 0, S_OK);
+            return -1;
+        }
+        if (!rsx_scaled_blit_guest_span_valid(p->canonical_ea, m->pitch, m->w, m->h,
+                                               ppu_vm_size, NULL)) {
+            exact_writeback_preflight_reject("CANONICAL_SPAN", d, b, dst.slot,
+                                              x, y, 0, 0, S_OK);
+            return -1;
+        }
+        if (!rsx_scaled_blit_guest_span_valid(p->guest_ea, p->guest_pitch, p->w, p->h,
+                                               ppu_vm_size, NULL)) {
+            exact_writeback_preflight_reject("GUEST_SPAN", d, b, dst.slot,
+                                              x, y, 0, 0, S_OK);
+            return -1;
+        }
+        const char* alloc_code = "READBACK_LIMIT";
+        HRESULT alloc_hr = S_OK;
+        if (exact_writeback_readback_alloc(p, &alloc_code, &alloc_hr) != 0) {
+            exact_writeback_preflight_reject(alloc_code, d, b, dst.slot,
+                                              x, y, 0, 0, alloc_hr);
+            return -1;
+        }
+        p->guest_rows = vm_base + p->guest_ea;
+        exact_writeback_transfer_baseline(p, b);
+    }
+    return 0;
+}
+
+static int exact_writeback_queue(u32 record)
+{
+    for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+        ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+        if (p->record != record) continue;
+        if (p->direct_readback) {
+            D3D12DrawRecord* dr = &s_d3d.draws[record];
+            GpuBlitEndpoint source = {dr->scaled_blit_src_kind, dr->scaled_blit_src_slot,
+                                      dr->scaled_blit_src_x, dr->scaled_blit_src_y};
+            if (!p->readback || !dr->scaled_blit_direct_readback ||
+                !dr->scaled_blit_prepared || !dr->scaled_blit_src_authoritative ||
+                !gpu_blit_direct_source_valid(&dr->scaled_blit, &source))
+                return -1;
+            ID3D12Resource* resource = gpu_blit_endpoint_resource(&source);
+            if (!resource) return -1;
+            D3D12_RESOURCE_STATES restore = gpu_blit_endpoint_state(&source);
+            gpu_blit_endpoint_transition(&source, D3D12_RESOURCE_STATE_COPY_SOURCE);
+            D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+            dst.pResource = p->readback; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+            dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+            dst.PlacedFootprint.Footprint.Width = p->w;
+            dst.PlacedFootprint.Footprint.Height = p->h;
+            dst.PlacedFootprint.Footprint.Depth = 1;
+            dst.PlacedFootprint.Footprint.RowPitch = p->readback_pitch;
+            src.pResource = resource; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+            u32 x = source.x + dr->scaled_blit.src_x;
+            u32 y = source.y + dr->scaled_blit.src_y;
+            D3D12_BOX box = {x, y, 0, x + p->w, y + p->h, 1};
+            d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, &box);
+            gpu_blit_endpoint_transition(&source, restore);
+            if (s_d3d.gcm2d_backend_halted) return -1;
+            p->queued = dr->scaled_blit_executed = 1;
+            if (rsx_survival_trace_is_armed()) {
+                static unsigned direct_logs;
+                if (direct_logs++ < 4)
+                    fprintf(stderr, "[TJ-MAIN-DIRECT] rec=%u src=%08X dst=%08X copy=%ux%u upload_removed=%llu intermediate_removed=%llu\n",
+                        record, dr->scaled_blit.src_raw, p->mapping_raw, p->w, p->h,
+                        (unsigned long long)p->canonical_span,
+                        (unsigned long long)p->w * p->h * 4u);
+            }
+            continue;
+        }
+        if (p->mirror_slot >= MAX_GPU_MIRRORS || !p->readback) return -1;
+        GpuMirror* m = &s_d3d.gpu_mirror[p->mirror_slot];
+        D3D12_RESOURCE_STATES restore = m->st;
+        gpu_mirror_transition((int)p->mirror_slot, D3D12_RESOURCE_STATE_COPY_SOURCE);
+        D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+        dst.pResource = p->readback; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        dst.PlacedFootprint.Footprint.Width = p->w; dst.PlacedFootprint.Footprint.Height = p->h;
+        dst.PlacedFootprint.Footprint.Depth = 1; dst.PlacedFootprint.Footprint.RowPitch = p->readback_pitch;
+        src.pResource = m->res; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_BOX box = {p->x, p->y, 0, p->x + p->w, p->y + p->h, 1};
+        d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, &box);
+        gpu_mirror_transition((int)p->mirror_slot, restore);
+        p->queued = 1;
+    }
+    return 0;
+}
+
+static int tj_main_overwrite_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_MAIN_OVERWRITE");
+        enabled = value && strcmp(value, "1") == 0;
+    }
+    /* TJ_RENDER_SCALE keeps full MAIN mirror uploads (backend init logs it). */
+    return enabled && s_d3d.scale <= 1;
+}
+
+/* Create a persistent exact-copy backing from guest bytes.  This is only an
+ * initial value: once a deferred NV3089 copy writes it, later copies/samplers
+ * see the GPU version rather than a stale guest-memory re-upload. */
+static int gpu_mirror_get(u8 local, u32 raw, u32 pitch, u32 w, u32 h,
+                          const u8* snapshot, u64 snapshot_bytes,
+                          int immutable_source, u32 overwrite_w)
+{
+    if (!pitch) { s_d3d.gcm2d_endpoint_reason = "mirror-pitch-zero"; return -1; }
+    if (pitch & 3u) { s_d3d.gcm2d_endpoint_reason = "mirror-pitch-align"; return -1; }
+    if (!w) { s_d3d.gcm2d_endpoint_reason = "mirror-width-zero"; return -1; }
+    if (!h) { s_d3d.gcm2d_endpoint_reason = "mirror-height-zero"; return -1; }
+    if (!snapshot) {
+        s_d3d.gcm2d_endpoint_reason = immutable_source
+            ? "src-snapshot-null" : "dst-snapshot-null";
+        return -1;
+    }
+    if (!s_d3d.device) { s_d3d.gcm2d_endpoint_reason = "mirror-no-device"; return -1; }
+    if (!s_d3d.cmd_list) { s_d3d.gcm2d_endpoint_reason = "mirror-no-list"; return -1; }
+    u32 physical_w = pitch / 4u;
+    if (physical_w < w) { s_d3d.gcm2d_endpoint_reason = "mirror-pitch"; return -1; }
+    if (overwrite_w && (local || immutable_source || overwrite_w > w)) {
+        s_d3d.gcm2d_endpoint_reason = "mirror-overwrite-range";
+        return -1;
+    }
+    u64 required_bytes = (u64)(h - 1u) * pitch + (u64)physical_w * 4u;
+    if (required_bytes > snapshot_bytes || physical_w > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+        h > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION || required_bytes > (256ULL << 20)) {
+        s_d3d.gcm2d_endpoint_reason = "mirror-span";
+        return -1;
+    }
+    u32 canonical_ea = 0;
+    u64 canonical_span = 0, mapping_generation = 0;
+    if (!local && !immutable_source &&
+        gpu_main_canonical_identity(raw, pitch, physical_w, h,
+                                    &canonical_ea, &canonical_span,
+                                    &mapping_generation) != 0) {
+        s_d3d.gcm2d_endpoint_reason = "mirror-mapping";
+        return -1;
+    }
+    int slot = immutable_source ? -1 : (local ? gpu_mirror_find(local, raw, pitch, w, h) : -1);
+    if (slot >= 0) return slot;
+    if (!local && !immutable_source &&
+        gpu_mirror_canonical_overlap(canonical_ea, canonical_span,
+                                     mapping_generation, UINT32_MAX) != 0) {
+        s_d3d.gcm2d_endpoint_reason = "mirror-canonical-overlap";
+        return -1;
+    }
+    for (int i = 0; i < MAX_GPU_MIRRORS; i++)
+        if (!s_d3d.gpu_mirror[i].valid) { slot = i; break; }
+    if (slot < 0) { s_d3d.gcm2d_endpoint_reason = "mirror-cap"; return -1; }
+
+    GpuMirror* m = &s_d3d.gpu_mirror[slot];
+    u32 row_pitch = (pitch + 255u) & ~255u;
+    LONGLONG perf_mark = tj_gcm2d_backend_perf_subphase_begin();
+    GpuScratchAllocation scratch = {0};
+    if (gpu_scratch_take(GPU_SCRATCH_MIRROR, physical_w, h, &scratch)) {
+        m->res = scratch.res; m->up = scratch.up;
+        m->st = scratch.st; m->allocation_bytes = scratch.bytes;
+    } else {
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = physical_w; td.Height = h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&m->res))) {
+        if (s_tj_gcm2d_backend_perf_sample)
+            tj_gcm2d_backend_perf_subphase_end(
+                &s_tj_gcm2d_backend_perf_sample->mirror_create_ticks, perf_mark);
+        { s_d3d.gcm2d_endpoint_reason = "mirror-default"; return -1; }
+    }
+    D3D12_HEAP_PROPERTIES hu = {0}; hu.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Width = (u64)row_pitch * h; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hu, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+            &IID_ID3D12Resource, (void**)&m->up))) {
+        if (s_tj_gcm2d_backend_perf_sample)
+            tj_gcm2d_backend_perf_subphase_end(
+                &s_tj_gcm2d_backend_perf_sample->mirror_create_ticks, perf_mark);
+        m->res->lpVtbl->Release(m->res); m->res = NULL;
+        s_d3d.gcm2d_endpoint_reason = "mirror-upload"; return -1;
+    }
+    u64 texture_bytes = gpu_scratch_allocation_bytes(&td);
+    u64 upload_bytes = gpu_scratch_allocation_bytes(&bd);
+    m->allocation_bytes = texture_bytes && upload_bytes &&
+        texture_bytes <= UINT64_MAX - upload_bytes ? texture_bytes + upload_bytes : 0;
+    m->st = D3D12_RESOURCE_STATE_COPY_DEST;
+    }
+    if (s_tj_gcm2d_backend_perf_sample)
+        tj_gcm2d_backend_perf_subphase_end(
+            &s_tj_gcm2d_backend_perf_sample->mirror_create_ticks, perf_mark);
+    perf_mark = tj_gcm2d_backend_perf_subphase_begin();
+    TJMirrorUploadCostSample upload_cost = {0};
+    tj_prefix_mirror_upload_cost_begin(&upload_cost);
+    if (overwrite_w < physical_w) {
+        void* mapped = NULL; D3D12_RANGE nr = {0, 0};
+        if (d3d12_prefix_owner_object_mutable(m->up) != 0) {
+            tj_prefix_mirror_upload_cost_phase(&upload_cost, TJ_MIRROR_UPLOAD_OWNER_GUARD);
+            tj_prefix_mirror_upload_cost_abort(&upload_cost, 0);
+            return -1;
+        }
+        tj_prefix_mirror_upload_cost_phase(&upload_cost, TJ_MIRROR_UPLOAD_OWNER_GUARD);
+        if (FAILED(m->up->lpVtbl->Map(m->up, 0, &nr, &mapped)) || !mapped) {
+            tj_prefix_mirror_upload_cost_phase(&upload_cost, TJ_MIRROR_UPLOAD_MAP);
+            tj_prefix_mirror_upload_cost_abort(&upload_cost, 1);
+            if (s_tj_gcm2d_backend_perf_sample)
+                tj_gcm2d_backend_perf_subphase_end(
+                    &s_tj_gcm2d_backend_perf_sample->mirror_upload_ticks, perf_mark);
+            if (mapped) m->up->lpVtbl->Unmap(m->up, 0, NULL);
+            m->up->lpVtbl->Release(m->up); m->up = NULL;
+            m->res->lpVtbl->Release(m->res); m->res = NULL;
+            s_d3d.gcm2d_endpoint_reason = "mirror-map"; return -1;
+        }
+        tj_prefix_mirror_upload_cost_phase(&upload_cost, TJ_MIRROR_UPLOAD_MAP);
+        if (!overwrite_w) {
+            rsx_argb_upload_rows((u8*)mapped, row_pitch, snapshot, pitch, physical_w, h);
+        } else {
+            /* The FIFO copy replaces these left columns for every row. Keep
+             * the untouched right columns, including physical pitch padding.
+             * A tight one-row destination pitch avoids clearing past this
+             * subrectangle in rsx_argb_upload_rows. */
+            u32 tail_bytes = (physical_w - overwrite_w) * 4u;
+            for (u32 y = 0; y < h; ++y)
+                rsx_argb_upload_rows((u8*)mapped + (u64)y * row_pitch + overwrite_w * 4u,
+                    tail_bytes, snapshot + (u64)y * pitch + overwrite_w * 4u,
+                    tail_bytes, physical_w - overwrite_w, 1);
+        }
+        tj_prefix_mirror_upload_cost_phase(&upload_cost, TJ_MIRROR_UPLOAD_CONVERT);
+        m->up->lpVtbl->Unmap(m->up, 0, NULL);
+        tj_prefix_mirror_upload_cost_phase(&upload_cost, TJ_MIRROR_UPLOAD_UNMAP);
+    } else {
+        tj_prefix_mirror_upload_cost_skip(&upload_cost, TJ_MIRROR_UPLOAD_OWNER_GUARD);
+        tj_prefix_mirror_upload_cost_skip(&upload_cost, TJ_MIRROR_UPLOAD_MAP);
+        tj_prefix_mirror_upload_cost_skip(&upload_cost, TJ_MIRROR_UPLOAD_CONVERT);
+        tj_prefix_mirror_upload_cost_skip(&upload_cost, TJ_MIRROR_UPLOAD_UNMAP);
+    }
+    gpu_mirror_transition(slot, D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = m->res; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = m->up; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    src.PlacedFootprint.Footprint.Width = physical_w; src.PlacedFootprint.Footprint.Height = h;
+    src.PlacedFootprint.Footprint.Depth = 1; src.PlacedFootprint.Footprint.RowPitch = row_pitch;
+    if (!overwrite_w) {
+        d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, NULL);
+    } else if (overwrite_w < physical_w) {
+        D3D12_BOX tail = {overwrite_w, 0, 0, physical_w, h, 1};
+        d3d12_owned_copy_texture(&dst, overwrite_w, 0, 0, &src, &tail);
+    }
+    tj_prefix_mirror_upload_cost_phase(&upload_cost, TJ_MIRROR_UPLOAD_TRANSITION_COPY);
+    tj_prefix_mirror_upload_cost_finish(&upload_cost, physical_w, overwrite_w, h);
+    if (s_tj_gcm2d_backend_perf_sample)
+        tj_gcm2d_backend_perf_subphase_end(
+            &s_tj_gcm2d_backend_perf_sample->mirror_upload_ticks, perf_mark);
+    m->raw = raw; m->pitch = pitch; m->w = physical_w; m->h = h;
+    m->dxgi = DXGI_FORMAT_R8G8B8A8_UNORM; m->local = local;
+    m->immutable_source = immutable_source;
+    m->canonical_ea = canonical_ea;
+    m->canonical_span = canonical_span;
+    m->mapping_generation = mapping_generation;
+    m->st = D3D12_RESOURCE_STATE_COPY_DEST; m->valid = 1;
+    {
+        u32 used = 0;
+        for (int i = 0; i < MAX_GPU_MIRRORS; ++i)
+            if (s_d3d.gpu_mirror[i].valid) ++used;
+        if (used > s_d3d.gcm2d_mirror_peak) s_d3d.gcm2d_mirror_peak = used;
+    }
+    gpu_mirror_transition(slot, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    return slot;
+}
+
+static int gpu_blit_endpoint_get(const RsxD3D12ExactBlit* b, int source,
+                                 GpuBlitEndpoint* out)
+{
+    u8 local = source ? b->src_local : b->dst_local;
+    u32 raw = source ? b->src_raw : b->dst_raw;
+    u32 pitch = source ? b->src_pitch : b->dst_pitch;
+    u32 w = b->src_w, h = b->src_h;
+    if (!source) {
+        u64 end_x = (u64)b->dst_x + b->copy_w;
+        u64 end_y = (u64)b->dst_y + b->copy_h;
+        if (end_x > UINT32_MAX || end_y > UINT32_MAX) {
+            s_d3d.gcm2d_endpoint_reason = "dst-overflow";
+            return -1;
+        }
+        w = b->dst_w > end_x ? b->dst_w : (u32)end_x;
+        h = b->dst_h > end_y ? b->dst_h : (u32)end_y;
+    }
+    if (source && local && b->src_cpu_owned) {
+        int mirror = gpu_mirror_get(1, raw, pitch, w, h,
+                                     b->src_snapshot, b->src_snapshot_bytes, 1, 0);
+        if (mirror < 0) return -1;
+        out->kind = GPU_BLIT_MIRROR;
+        out->slot = mirror;
+        out->x = out->y = 0;
+        static unsigned cpu_local_logs;
+        if (cpu_local_logs++ < 4)
+            fprintf(stderr, "[GCM2D-GPU] CPU LOCAL source=%08X %ux%u pitch=%u snapshot=%llu\n",
+                    raw, w, h, pitch, (unsigned long long)b->src_snapshot_bytes);
+        return 0;
+    }
+    if (local) {
+        CellGcmDisplayInfo info = {0};
+        extern int cellGcmGetDisplaySurfaceInfo(u32, u32, u32, u32, CellGcmDisplayInfo*);
+        extern int cellGcmGetDisplaySurfaceContaining(u32, u32, u32, u32,
+                                                       CellGcmDisplayInfo*, u32*, u32*);
+        if (cellGcmGetDisplaySurfaceContaining(raw, pitch, w, h, &info,
+                                                &out->x, &out->y)) {
+            int ds = display_surface_get(&info);
+            if (ds >= 0) { out->kind = GPU_BLIT_DISPLAY; out->slot = ds; return 0; }
+        }
+        if (cellGcmGetDisplaySurfaceInfo(raw, pitch, w, h, &info)) {
+            int ds = display_surface_get(&info);
+            if (ds >= 0) { out->kind = GPU_BLIT_DISPLAY; out->slot = ds; out->x = out->y = 0; return 0; }
+        }
+        int rt = off_rt_find_containing(1, raw, pitch, w, h, &out->x, &out->y);
+        if (rt >= 0) {
+            out->kind = GPU_BLIT_OFFRT; out->slot = rt; return 0;
+        }
+        /* CPU-owned LOCAL images took the immutable path above. Remaining
+         * LOCAL inputs require a real GPU owner; never substitute guest VRAM
+         * for an unresolved GPU image. */
+        s_d3d.gcm2d_endpoint_reason = "local-unresolved";
+        return -1;
+    }
+    /* Sequential preflight makes a lower record's mutable MAIN mirror the
+     * only legal same-batch source reuse.  Never reuse an immutable snapshot
+     * and never look forward: that would resurrect stale CPU bytes. */
+    int immutable_source = source && !local;
+    u32 canonical_ea = 0;
+    u64 canonical_span = 0;
+    u64 mapping_generation = 0;
+    if (gpu_main_canonical_identity(raw, pitch, w, h, &canonical_ea,
+                                    &canonical_span, &mapping_generation) != 0) {
+        s_d3d.gcm2d_endpoint_reason = "endpoint-mapping";
+        return -1;
+    }
+    if (mapping_generation != b->mapping_generation ||
+        canonical_ea != (source ? b->src_ea : b->dst_ea)) {
+        s_d3d.gcm2d_endpoint_reason = "endpoint-record-mapping-drift";
+        return -1;
+    }
+    int mirror = gpu_mirror_find_canonical_containing(canonical_ea, pitch, w, h,
+                                                        mapping_generation, UINT32_MAX,
+                                                        &out->x, &out->y);
+    if (mirror == -2) {
+        s_d3d.gcm2d_endpoint_reason = "mirror-mapping-drift";
+        return -1;
+    }
+    if (source && mirror >= 0 && !s_d3d.gpu_mirror[mirror].authoritative) {
+        s_d3d.gcm2d_endpoint_reason = "mirror-source-nonauth";
+        return -1;
+    }
+    if (mirror >= 0) { out->kind = GPU_BLIT_MIRROR; out->slot = mirror; return 0; }
+    /* An immutable snapshot is valid only for disjoint MAIN input.  An alias
+     * of any mutable backing (including equal EA with a different pitch) must
+     * either reuse the compatible authoritative mirror above or halt; falling
+     * back to a record-time CPU snapshot would resurrect stale bytes. */
+    if (source && gpu_mirror_canonical_overlap(canonical_ea, canonical_span,
+                                                mapping_generation, UINT32_MAX) != 0) {
+        s_d3d.gcm2d_endpoint_reason = "mirror-source-canonical-overlap";
+        return -1;
+    }
+    /* Only a new MAIN destination's first, full-height left rectangle can
+     * discard its old columns. Existing alias owners returned above; sources
+     * and partial-height/offset copies still upload the complete snapshot.
+     * Earlier raster readers retain their own snapshots until the FIFO writer.
+     * Replay/bounds failure rejects the list before any writeback publication. */
+    u32 overwrite_w = !source && b->src_local && !b->src_cpu_owned &&
+        tj_main_overwrite_enabled() && !b->dst_x && !b->dst_y && b->copy_h == h &&
+        b->copy_w && !(pitch & 3u) && b->copy_w <= pitch / 4u ? b->copy_w : 0;
+    mirror = gpu_mirror_get(local, raw, pitch, w, h,
+                            source ? b->src_snapshot : b->dst_snapshot,
+                            source ? b->src_snapshot_bytes : b->dst_snapshot_bytes,
+                            immutable_source, overwrite_w);
+    if (mirror < 0) return -1;
+    if (overwrite_w && rsx_survival_trace_is_armed()) {
+        static unsigned overwrite_logs;
+        if (overwrite_logs++ < 4)
+            fprintf(stderr, "[TJ-MAIN-OVERWRITE] dst=%08X copy=%ux%u physical=%ux%u skipped_bytes=%llu\n",
+                raw, overwrite_w, h, pitch / 4u, h,
+                (unsigned long long)overwrite_w * h * 4u);
+    }
+    out->kind = GPU_BLIT_MIRROR; out->slot = mirror; out->x = out->y = 0;
+    return 0;
+}
+
+static ID3D12Resource* gpu_blit_endpoint_resource(const GpuBlitEndpoint* e)
+{
+    if (e->kind == GPU_BLIT_DISPLAY) return s_d3d.display_surface[e->slot].res;
+    if (e->kind == GPU_BLIT_OFFRT) return s_d3d.off_rt[e->slot].res;
+    return s_d3d.gpu_mirror[e->slot].res;
+}
+
+static void gpu_blit_endpoint_transition(const GpuBlitEndpoint* e, D3D12_RESOURCE_STATES to)
+{
+    if (e->kind == GPU_BLIT_DISPLAY) display_surface_transition(e->slot, to);
+    else if (e->kind == GPU_BLIT_OFFRT) off_rt_transition(e->slot, to);
+    else gpu_mirror_transition(e->slot, to);
+}
+
+static D3D12_RESOURCE_STATES gpu_blit_endpoint_state(const GpuBlitEndpoint* e)
+{
+    if (e->kind == GPU_BLIT_DISPLAY) return s_d3d.display_surface[e->slot].st;
+    if (e->kind == GPU_BLIT_OFFRT) return s_d3d.off_rt[e->slot].st;
+    return s_d3d.gpu_mirror[e->slot].st;
+}
+
+/* TJ_RENDER_SCALE host factor of an endpoint: displays may be scaled; OffRTs
+ * and MAIN/LOCAL mirrors are always 1x. Endpoint rects stay guest units. */
+static u32 gpu_blit_endpoint_scale(const GpuBlitEndpoint* e)
+{
+    if (e->kind == GPU_BLIT_DISPLAY && e->slot >= 0 && e->slot < MAX_DISPLAY_SURFACES)
+        return rs_factor(s_d3d.display_surface[e->slot].scale);
+    return 1;
+}
+
+static int gpu_blit_direct_source_valid(const RsxD3D12ExactBlit* b,
+                                       const GpuBlitEndpoint* src)
+{
+    if (!b || !src || !b->src_local || b->src_cpu_owned || !b->copy_w ||
+        !b->copy_h || src->slot < 0 ||
+        (src->kind == GPU_BLIT_DISPLAY ? src->slot >= MAX_DISPLAY_SURFACES :
+         src->kind == GPU_BLIT_OFFRT ? src->slot >= MAX_OFF_RTS : 1)) return 0;
+    ID3D12Resource* resource = gpu_blit_endpoint_resource(src);
+    if (!resource) return 0;
+    D3D12_RESOURCE_DESC desc = {0};
+    resource->lpVtbl->GetDesc(resource, &desc);
+    const u32 scale = gpu_blit_endpoint_scale(src);
+    u64 x = (u64)src->x + b->src_x, y = (u64)src->y + b->src_y;
+    return desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+        desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM &&
+        desc.DepthOrArraySize == 1 && desc.MipLevels && desc.SampleDesc.Count == 1 &&
+        x + b->copy_w <= desc.Width / scale && y + b->copy_h <= desc.Height / scale &&
+        x + b->copy_w <= UINT32_MAX && y + b->copy_h <= UINT32_MAX;
+}
+
+static int gpu_blit_endpoint_bounds_valid(const RsxD3D12ExactBlit* b,
+                                          const GpuBlitEndpoint* src,
+                                          const GpuBlitEndpoint* dst)
+{
+    if (!b || !b->copy_w || !b->copy_h ||
+        (src->kind == dst->kind && src->slot == dst->slot)) {
+        s_d3d.gcm2d_endpoint_reason = "copy-self-or-empty";
+        return -1;
+    }
+    ID3D12Resource* src_res = gpu_blit_endpoint_resource(src);
+    ID3D12Resource* dst_res = gpu_blit_endpoint_resource(dst);
+    if (!src_res || !dst_res) { s_d3d.gcm2d_endpoint_reason = "endpoint-resource"; return -1; }
+    D3D12_RESOURCE_DESC src_desc = {0}, dst_desc = {0};
+    src_res->lpVtbl->GetDesc(src_res, &src_desc);
+    dst_res->lpVtbl->GetDesc(dst_res, &dst_desc);
+    /* Guest rectangles against the guest extent (desc / host scale). */
+    const u32 src_scale = gpu_blit_endpoint_scale(src);
+    const u32 dst_scale = gpu_blit_endpoint_scale(dst);
+    u64 sx = (u64)src->x + b->src_x, sy = (u64)src->y + b->src_y;
+    u64 dx = (u64)dst->x + b->dst_x, dy = (u64)dst->y + b->dst_y;
+    if (sx + b->copy_w > src_desc.Width / src_scale ||
+        sy + b->copy_h > src_desc.Height / src_scale ||
+        dx + b->copy_w > dst_desc.Width / dst_scale ||
+        dy + b->copy_h > dst_desc.Height / dst_scale) {
+        s_d3d.gcm2d_endpoint_reason = "copy-bounds";
+        return -1;
+    }
+    return 0;
+}
+
+static void gpu_blit_endpoint_cache(D3D12DrawRecord* dr,
+                                    const GpuBlitEndpoint* src,
+                                    const GpuBlitEndpoint* dst)
+{
+    dr->scaled_blit_src_kind = src->kind; dr->scaled_blit_src_slot = src->slot;
+    dr->scaled_blit_src_x = src->x; dr->scaled_blit_src_y = src->y;
+    dr->scaled_blit_dst_kind = dst->kind; dr->scaled_blit_dst_slot = dst->slot;
+    dr->scaled_blit_dst_x = dst->x; dr->scaled_blit_dst_y = dst->y;
+    dr->scaled_blit_prepared = 1;
+}
+
+/* Resolve a raster colour producer by registered display identity.  Raw tile
+ * aliases must converge on the DisplaySurface slot, never just raw equality. */
+static int display_raster_target_slot(const D3D12DrawRecord* dr)
+{
+    if (!dr || (!dr->is_vp && !legacy_record_supported(dr)) ||
+        dr->is_scaled_blit || !dr->rt_is_display)
+        return -1;
+    if (dr->is_clear && !(dr->clear_flags & RSX_CLEAR_COLOR_MASK))
+        return -1;
+    if (!dr->is_clear && (!dr->cmask || !dr->vertex_count ||
+        (((dr->cull_key >> 1) & 3u) == 3u &&
+         vp_topology_type(dr->topology) == D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE)))
+        return -1;
+    CellGcmDisplayInfo info = {0};
+    extern int cellGcmGetDisplaySurfaceInfo(u32, u32, u32, u32, CellGcmDisplayInfo*);
+    int active_surface = (dr->rt_target == 2) ? 1 : 0;
+    if (!cellGcmGetDisplaySurfaceInfo(dr->rt_display_raw,
+            dr->rt_pitch[active_surface], dr->rt_w, dr->rt_h, &info))
+        return -1;
+    return display_surface_get(&info);
+}
+
+/* Raster coverage is bounded by viewport and scissor, but those bounds do not
+ * prove that the submitted triangles covered every pixel. Keep the rectangle
+ * for FIFO diagnostics/dependencies while reserving DisplaySurface.valid for
+ * a true full clear or exact-copy proof. */
+static int display_raster_bounds(const D3D12DrawRecord* dr,
+                                 const DisplaySurface* display,
+                                 u32* out_x, u32* out_y,
+                                 u32* out_w, u32* out_h)
+{
+    if (!dr || !display || !dr->cmask || !display->w || !display->h ||
+        !out_x || !out_y || !out_w || !out_h)
+        return 0;
+    D3D12_VIEWPORT vp = draw_viewport_rect(
+        dr, 0, 0, display->w, display->h);
+    u32 vx = (u32)vp.TopLeftX, vy = (u32)vp.TopLeftY;
+    u32 vw = (u32)vp.Width, vh = (u32)vp.Height;
+    D3D12_RECT sc = draw_scissor_rect(dr, 0, 0, display->w, display->h);
+    u32 sx0 = sc.left < 0 ? 0u : (u32)sc.left;
+    u32 sy0 = sc.top < 0 ? 0u : (u32)sc.top;
+    u32 sx1 = sc.right < 0 ? 0u : (u32)sc.right;
+    u32 sy1 = sc.bottom < 0 ? 0u : (u32)sc.bottom;
+    if (sx1 > display->w) sx1 = display->w;
+    if (sy1 > display->h) sy1 = display->h;
+    const u32 vx1 = vx + vw, vy1 = vy + vh;
+    const u32 x0 = vx > sx0 ? vx : sx0;
+    const u32 y0 = vy > sy0 ? vy : sy0;
+    const u32 x1 = vx1 < sx1 ? vx1 : sx1;
+    const u32 y1 = vy1 < sy1 ? vy1 : sy1;
+    if (x1 <= x0 || y1 <= y0) return 0;
+    *out_x = x0; *out_y = y0; *out_w = x1 - x0; *out_h = y1 - y0;
+    return 1;
+}
+
+/* Exact-copy coverage is intentionally bounded and persistent for one FIFO
+ * epoch. Plan rectangles carry their record index, so readers never borrow a
+ * later producer; executed rectangles survive released prefix records. */
+static void display_coverage_reset(DisplaySurface* s)
+{
+    s->fifo_coverage_count = s->fifo_coverage_overflow = 0;
+    s->plan_coverage_count = s->plan_coverage_overflow = 0;
+}
+
+static void display_coverage_add(DisplayCoverageRect* rects, u8* count,
+                                 u8* overflow, u32 x, u32 y, u32 w, u32 h,
+                                 u32 record, int merge)
+{
+    if (!w || !h || x > UINT32_MAX - w || y > UINT32_MAX - h || *overflow) return;
+    if (merge) {
+        /* Executed rectangles describe a union, not a draw counter. A full
+         * clear followed by many raster bounds must retain its coverage;
+         * duplicate/subset writes cannot exhaust this bounded proof list.
+         * Planned records do not take this path: their FIFO indices must
+         * remain separate so a reader cannot borrow a future writer. */
+        for (u32 i = 0; i < *count; ++i) {
+            const DisplayCoverageRect* r = &rects[i];
+            if (r->x <= x && r->y <= y && r->x + r->w >= x + w &&
+                r->y + r->h >= y + h)
+                return;
+        }
+        for (u32 i = 0; i < *count;) {
+            const DisplayCoverageRect* r = &rects[i];
+            if (x <= r->x && y <= r->y && x + w >= r->x + r->w &&
+                y + h >= r->y + r->h)
+                rects[i] = rects[--(*count)];
+            else
+                ++i;
+        }
+        for (u32 i = 0; i < *count; ++i) {
+            DisplayCoverageRect* r = &rects[i];
+            if (r->y == y && r->h == h && (r->x + r->w == x || x + w == r->x)) {
+                u32 left = r->x < x ? r->x : x;
+                u32 right = r->x + r->w > x + w ? r->x + r->w : x + w;
+                r->x = left; r->w = right - left;
+                return;
+            }
+            if (r->x == x && r->w == w && (r->y + r->h == y || y + h == r->y)) {
+                u32 top = r->y < y ? r->y : y;
+                u32 bottom = r->y + r->h > y + h ? r->y + r->h : y + h;
+                r->y = top; r->h = bottom - top;
+                return;
+            }
+        }
+    }
+    if (*count == MAX_DISPLAY_COVERAGE_RECTS) { *overflow = 1; return; }
+    rects[*count] = (DisplayCoverageRect){x, y, w, h, record};
+    ++*count;
+}
+
+static int display_coverage_contains(const DisplaySurface* s, u32 reader_record,
+                                     int planned, u32 want_x, u32 want_y,
+                                     u32 want_w, u32 want_h)
+{
+    if (!want_w || !want_h || want_x > UINT32_MAX - want_w ||
+        want_y > UINT32_MAX - want_h) return 0;
+    const DisplayCoverageRect* actual = s->fifo_coverage;
+    const DisplayCoverageRect* plan = s->plan_coverage;
+    if (s->fifo_coverage_overflow || (planned && s->plan_coverage_overflow)) return 0;
+    u32 x_cut[MAX_DISPLAY_COVERAGE_RECTS * 4 + 2], n = 2;
+    u32 want_x_end = want_x + want_w, want_y_end = want_y + want_h;
+    x_cut[0] = want_x; x_cut[1] = want_x_end;
+    for (u32 pass = 0; pass < (planned ? 2u : 1u); ++pass) {
+        const DisplayCoverageRect* list = pass ? plan : actual;
+        u32 count = pass ? s->plan_coverage_count : s->fifo_coverage_count;
+        for (u32 i = 0; i < count; ++i) {
+            const DisplayCoverageRect* r = &list[i];
+            u64 x1 = (u64)r->x + r->w, y1 = (u64)r->y + r->h;
+            if ((pass && r->record >= reader_record) || r->x >= want_x_end ||
+                r->y >= want_y_end || x1 <= want_x || y1 <= want_y) continue;
+            if (n + 2 > sizeof(x_cut) / sizeof(x_cut[0])) return 0;
+            x_cut[n++] = r->x < want_x ? want_x : r->x;
+            x_cut[n++] = x1 > want_x_end ? want_x_end : (u32)x1;
+        }
+    }
+    for (u32 i = 1; i < n; ++i) { u32 v = x_cut[i], j = i; while (j && x_cut[j - 1] > v) { x_cut[j] = x_cut[j - 1]; --j; } x_cut[j] = v; }
+    for (u32 xi = 0; xi + 1 < n; ++xi) {
+        u32 left = x_cut[xi], right = x_cut[xi + 1], covered = want_y;
+        if (left == right) continue;
+        for (;;) {
+            u32 best = covered;
+            for (u32 pass = 0; pass < (planned ? 2u : 1u); ++pass) {
+                const DisplayCoverageRect* list = pass ? plan : actual;
+                u32 count = pass ? s->plan_coverage_count : s->fifo_coverage_count;
+                for (u32 i = 0; i < count; ++i) {
+                    const DisplayCoverageRect* r = &list[i];
+                    u64 x1 = (u64)r->x + r->w, y1 = (u64)r->y + r->h;
+                    if ((pass && r->record >= reader_record) || r->x > left ||
+                        x1 < right || r->y > covered || y1 <= covered) continue;
+                    if (y1 > best) best = y1 > want_y_end ? want_y_end : (u32)y1;
+                }
+            }
+            if (best == covered) return 0;
+            covered = best;
+            if (covered >= want_y_end) break;
+        }
+    }
+    return 1;
+}
+
+static void display_raster_coverage_note(const D3D12DrawRecord* dr,
+                                         DisplaySurface* display, u32 record)
+{
+    u32 x, y, w, h;
+    if (!display_raster_bounds(dr, display, &x, &y, &w, &h)) return;
+    display_coverage_add(display->fifo_coverage, &display->fifo_coverage_count,
+                         &display->fifo_coverage_overflow, x, y, w, h,
+                         record, 1);
+    /* Never set display->valid here: viewport/scissor bounds are only an
+     * upper bound on rasterized primitives. */
+}
+
+static int display_surface_prior_dirty_producer(u32 reader_record, int display_slot,
+                                                int executed_only)
+{
+    if (display_slot < 0 || display_slot >= MAX_DISPLAY_SURFACES)
+        return 0;
+    for (u32 producer_record = 0; producer_record < reader_record; ++producer_record) {
+        const D3D12DrawRecord* producer = &s_d3d.draws[producer_record];
+        if (display_raster_target_slot(producer) == display_slot &&
+            (!executed_only || producer->display_color_produced))
+            return 1;
+        if (producer->is_scaled_blit && producer->scaled_blit_prepared &&
+            producer->scaled_blit_dst_kind == GPU_BLIT_DISPLAY &&
+            producer->scaled_blit_dst_slot == display_slot &&
+            (!executed_only || producer->scaled_blit_executed))
+            return 1;
+    }
+    return 0;
+}
+
+static int display_surface_prior_content_producer(u32 reader_record, int display_slot,
+                                                  int executed_only,
+                                                  u32 want_x, u32 want_y,
+                                                  u32 want_w, u32 want_h)
+{
+    if (display_slot < 0 || display_slot >= MAX_DISPLAY_SURFACES)
+        return 0;
