+static void d3d12_bind_texture(void* ud, u32 unit, const rsx_texture_state* tex)
+{
+    (void)ud;
+    extern uint8_t* vm_base;
+
+    if (!tex) return;
+    /* Clear before any invalid-input return. A malformed/null-VM update must
+     * not leave this unit sampling the previous image. */
+    if (unit < RSX_MAX_TEXTURES) {
+        memset(&s_d3d.cur_texs[unit], 0, sizeof(s_d3d.cur_texs[unit]));
+        if (unit == 0) s_d3d.tex_bound = 0;
+    }
+    u32 dimension = (tex->format >> 4) & 0xFu;
+    if (dimension < 1u || dimension > 3u) dimension = 2u;
+    int cube = dimension == 2u && (tex->format & 4u);
+    u32 width  = (tex->image_rect >> 16) & 0xFFFF;
+    u32 height = dimension == 1u ? 1u : tex->image_rect & 0xFFFF;
+    u32 depth = dimension == 3u ? tex->depth : 1u;
+    u32 format = (tex->format >> 8) & 0xFF;
+    /* Defensive canonicalization for callers that construct texture state
+     * without passing through the FIFO parser. */
+    u32 offset = tex->offset & 0x7FFFFFFFu;
+
+    static int log_count = 0;
+    if (log_count < 10) {
+        printf("[D3D12] bind_texture(unit=%u, offset=0x%X, fmt=0x%02X, %ux%u)\n",
+               unit, offset, format, width, height);
+        log_count++;
+    }
+    /* MOVIE_BIND=1: trace movie-plane binds (640x360 Y / 320x180 U/V) with the
+     * resolved EA + a content probe -- used to diagnose the Bink frame-buffer
+     * ring mismatch (the draw binds a cleared buffer 0x4D80 before the one the
+     * decoder actually fills). */
+    static _Thread_local int movie_bind_enabled = -1;
+    if (movie_bind_enabled < 0) movie_bind_enabled = getenv("MOVIE_BIND") != NULL;
+    if (movie_bind_enabled &&
+        ((width == 640 && height == 360) || (width == 320 && height == 180))) {
+        static int _mv = 0; if (_mv++ < 24) {
+            /* Resolve the SAME raw offset both ways -- as LOCAL (VRAM) and as MAIN
+             * (IO-mapped) -- and count nonzero bytes over the whole plane for each.
+             * If the plane the game declares (loc bits fmt&3) is zero but the OTHER
+             * pool has content, the decoder wrote to a different memory space than
+             * our texture resolve picked (the local-vs-main mismatch). */
+            u32 loc = tex->format & 3;               /* 1=LOCAL, 2=MAIN */
+            u32 ea_loc = 0, ea_main = 0;
+            int loc_resolved = cellGcmResolveLocatedChecked(1, offset, &ea_loc);
+            int main_resolved = cellGcmResolveLocatedChecked(0, offset, &ea_main);
+            u32 plane = width * height;
+            u32 nz_loc = 0, nz_main = 0;
+            if (vm_base) for (u32 i = 0; i < plane; i += 137) {
+                if (loc_resolved && vm_base[ea_loc + i]) nz_loc++;
+                if (main_resolved && vm_base[ea_main + i]) nz_main++;
+            }
+            fprintf(stderr, "[mv-bind] unit=%u fmt=0x%02X loc=%u %ux%u off=0x%X | LOCAL ea=0x%08X(%d) nz=%u | MAIN ea=0x%08X(%d) nz=%u\n",
+                    unit, format, loc, width, height, offset,
+                    ea_loc, loc_resolved, nz_loc, ea_main, main_resolved, nz_main);
+        }
+    }
+
+    if (!vm_base || width == 0 || height == 0 || depth == 0) return;
+
+    /* NV4097 TEXTURE_CONTROL0 bit 31 is the unit-enable bit. */
+    if (unit < RSX_MAX_TEXTURES) {
+        if (!(tex->control0 & 0x80000000u)) return;
+    }
+
+    /* Record texture state now; upload happens later while the command list is
+     * open. Unsupported encodings stay unset instead of being misread as B8. */
+    u32 base_fmt = format & 0x9F;   /* strip LN(0x20)/UN(0x40) flags */
+    u16 mip_count = vp_tex_exact_mip_count(width, height, depth, format,
+                                            cube ? 4u : dimension,
+                                            tex->format >> 16);
+    /* VP path: record the latest bound texture (any supported format) so draws
+     * can carry it per-draw. Location bits (format[1:0]): 1 = LOCAL, 2 = MAIN. */
+    u32 resolved_offset;
+    int texture_resolved = cellGcmResolveLocatedChecked(
+        (tex->format & 3) == 1, offset, &resolved_offset);
+    if (unit < RSX_MAX_TEXTURES && texture_resolved && vp_tex_format_info(base_fmt, NULL)) {
+        s_d3d.cur_texs[unit].off = resolved_offset;
+        s_d3d.cur_texs[unit].raw = offset;
+        s_d3d.cur_texs[unit].w = width; s_d3d.cur_texs[unit].h = height;
+        s_d3d.cur_texs[unit].depth = depth;
+        s_d3d.cur_texs[unit].fmt = format;   /* full byte: LN(0x20)/UN(0x40) kept */
+        s_d3d.cur_texs[unit].mips = mip_count;
+        s_d3d.cur_texs[unit].cube = cube;
+        s_d3d.cur_texs[unit].dimension = cube ? 4u : dimension;
+        s_d3d.cur_texs[unit].location = tex->format & 3;
+        s_d3d.cur_texs[unit].pitch = tex->pitch;
+        s_d3d.cur_texs[unit].ctrl1 = tex->control1;
+        s_d3d.cur_texs[unit].address = tex->address;
+        s_d3d.cur_texs[unit].control0 = tex->control0;
+        s_d3d.cur_texs[unit].filter = tex->filter;
+        s_d3d.cur_texs[unit].border_color = tex->border_color;
+        s_d3d.cur_texs[unit].border_type = (u8)((tex->format >> 3) & 1u);
+        s_d3d.cur_texs[unit].set = 1;
+    }
+    if (base_fmt == 0x81 /* B8 */ && texture_resolved) {
+        s_d3d.tex_src_offset = resolved_offset;
+        if (s_d3d.tex_w != width || s_d3d.tex_h != height) {
+            /* dims changed -> resource must be (re)created in render_frame */
+            s_d3d.tex_ready = 0;
+        }
+        s_d3d.tex_w     = width;
+        s_d3d.tex_h     = height;
+        s_d3d.tex_bound = 1;
+        s_d3d.tex_dirty = 1;
+    } else {
+        s_d3d.tex_bound = 0;
+    }
+}
