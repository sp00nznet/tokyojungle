+           primitive <= RSX_PRIMITIVE_LINE_STRIP)
+            ? D3D_TOPOLOGY_LINELIST : D3D_TOPOLOGY_TRIANGLELIST;
+
+    for (u32 cursor = 0; cursor < count;) {
+        while (cursor < count &&
+               read_guest_index_raw(state, first + cursor) == state->restart_index)
+            cursor++;
+        u32 segment = cursor;
+        while (cursor < count &&
+               read_guest_index_raw(state, first + cursor) != state->restart_index)
+            cursor++;
+        u32 n = cursor - segment;
+        if (!n) continue;
+
+        if (primitive == RSX_PRIMITIVE_POINTS) {
+            for (u32 i = 0; i < n; i++)
+                if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                        read_guest_index(state, first + segment + i))) goto full;
+        } else if (primitive == RSX_PRIMITIVE_LINES) {
+            for (u32 i = 0; i + 1 < n; i += 2)
+                for (u32 k = 0; k < 2; k++)
+                    if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                            read_guest_index(state, first + segment + i + k))) goto full;
+        } else if (primitive == RSX_PRIMITIVE_LINE_STRIP ||
+                   primitive == RSX_PRIMITIVE_LINE_LOOP) {
+            for (u32 i = 0; i + 1 < n; i++) {
+                if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                        read_guest_index(state, first + segment + i))) goto full;
+                if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                        read_guest_index(state, first + segment + i + 1))) goto full;
+            }
+            if (primitive == RSX_PRIMITIVE_LINE_LOOP && n >= 2) {
+                if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                        read_guest_index(state, first + segment + n - 1))) goto full;
+                if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                        read_guest_index(state, first + segment))) goto full;
+            }
+        } else if (primitive == RSX_PRIMITIVE_TRIANGLES) {
+            for (u32 i = 0; i + 2 < n; i += 3)
+                for (u32 k = 0; k < 3; k++)
+                    if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                            read_guest_index(state, first + segment + i + k))) goto full;
+        } else if (primitive == RSX_PRIMITIVE_TRIANGLE_STRIP) {
+            for (u32 i = 0; i + 2 < n; i++) {
+                u32 order[3] = {i, i + 1, i + 2};
+                if (i & 1u) { u32 t = order[1]; order[1] = order[2]; order[2] = t; }
+                for (u32 k = 0; k < 3; k++)
+                    if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                            read_guest_index(state, first + segment + order[k]))) goto full;
+            }
+        } else if (primitive == RSX_PRIMITIVE_TRIANGLE_FAN ||
+                   primitive == RSX_PRIMITIVE_POLYGON) {
+            for (u32 i = 1; i + 1 < n; i++) {
+                u32 order[3] = {0, i, i + 1};
+                for (u32 k = 0; k < 3; k++)
+                    if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                            read_guest_index(state, first + segment + order[k]))) goto full;
+            }
+        } else if (primitive == RSX_PRIMITIVE_QUADS) {
+            static const u32 order[6] = {0, 1, 2, 0, 2, 3};
+            for (u32 i = 0; i + 3 < n; i += 4)
+                for (u32 k = 0; k < 6; k++)
+                    if (!emit_indexed_vp_vertex(state, out, &emitted, capacity,
+                            read_guest_index(state, first + segment + i + order[k]))) goto full;
+        } else if (primitive == RSX_PRIMITIVE_QUAD_STRIP) {
+            static const u32 order[6] = {0, 1, 3, 0, 3, 2};
+            for (u32 i = 0; i + 3 < n; i += 2)
+                for (u32 k = 0; k < 6; k++)
