+/* frame_count is the existing absolute presented-frame serial; counter fields
+ * are independently exchanged one-second deltas around that timestamp. */
+static void vp_texture_churn_trace_report(ULONGLONG t_ms, u64 frame_count,
+                                          ULONGLONG interval_ms)
+{
+    if (!vp_texture_churn_trace_enabled()) return;
+    vp_hash_ucode_reuse_report(t_ms, frame_count, interval_ms);
+    u64 occupied_complete_slots = 0;
+    u64 empty_slots = 0;
+    u64 incomplete_slots = 0;
+    u64 slots_with_source_identity = 0;
+    for (int i = 0; i < VP_TEX_SLOTS; ++i) {
+        const VPTexSlot* slot = &s_d3d.vp_tex[i];
+        if (slot->res && slot->up) ++occupied_complete_slots;
+        else if (!slot->res && !slot->up) ++empty_slots;
+        else ++incomplete_slots;
+        if (slot->source_snapshot) ++slots_with_source_identity;
+    }
+    const u64 snapshot_live_bytes = s_d3d.vp_tex_snapshot_bytes;
+    const u32 snapshot_pool_entries = s_d3d.vp_tex_snapshot_pool_count;
+    const u64 snapshot_pool_bytes = s_d3d.vp_tex_snapshot_pool_bytes;
+    fprintf(stderr,
+            "[TJ-TEXTURE-CHURN] t_ms=%llu frame_count=%llu interval_ms=%llu "
+            "occupied_complete_slots=%llu empty_slots=%llu incomplete_slots=%llu "
+            "slots_with_source_identity=%llu snapshot_live_bytes=%llu "
+            "snapshot_pool_enabled=%d snapshot_pool_entries=%u snapshot_pool_bytes=%llu "
+            "new_snapshots=%llu new_snapshot_bytes=%llu budget_rejections=%llu "
+            "trim_p0_ref_drops=%llu trim_p0_ref_drop_bytes=%llu trim_p0_frees=%llu trim_p0_freed_bytes=%llu "
+            "trim_p1_ref_drops=%llu trim_p1_ref_drop_bytes=%llu trim_p1_frees=%llu trim_p1_freed_bytes=%llu "
+            "upload_misses=%llu upload_source_bytes=%llu same_snapshot_other_off_requests=%llu "
+            "same_off_other_identity_hash_equal_requests=%llu "
+            "same_off_other_identity_hash_different_requests=%llu fresh_allocations=%llu reused_storage_uploads=%llu "
+            "shape_plain_linear_uploads=%llu shape_plain_linear_padded_uploads=%llu shape_other_uploads=%llu "
+            "same_off_full_layout_candidate_uploads=%llu logical_compare_attempts=%llu "
+            "logical_compare_equal=%llu logical_compare_different=%llu logical_compare_capped=%llu "
+            "snapshot_pool_admissions=%llu snapshot_pool_admission_bytes=%llu "
+            "snapshot_pool_hint_reuses=%llu snapshot_pool_hint_reuse_bytes=%llu "
+            "snapshot_pool_hash_reuses=%llu snapshot_pool_hash_same_off_reuses=%llu "
+            "snapshot_pool_hash_other_off_reuses=%llu snapshot_pool_hash_reuse_bytes=%llu "
+            "snapshot_pool_hint_retargets=%llu "
+            "snapshot_pool_cap_evictions=%llu snapshot_pool_cap_owner_drop_bytes=%llu "
+            "snapshot_pool_budget_reclaims=%llu snapshot_pool_budget_owner_drop_bytes=%llu "
+            "snapshot_pool_oversize_skips=%llu snapshot_pool_oversize_skip_bytes=%llu\n",
+            (unsigned long long)t_ms, (unsigned long long)frame_count,
+            (unsigned long long)interval_ms,
+            (unsigned long long)occupied_complete_slots,
+            (unsigned long long)empty_slots,
+            (unsigned long long)incomplete_slots,
+            (unsigned long long)slots_with_source_identity,
+            (unsigned long long)snapshot_live_bytes,
+            s_d3d.vp_tex_snapshot_pool_enabled, snapshot_pool_entries,
+            (unsigned long long)snapshot_pool_bytes,
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.new_snapshot_count),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.new_snapshot_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.budget_rejections),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p0_ref_drops),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p0_ref_drop_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p0_frees),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p0_freed_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p1_ref_drops),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p1_ref_drop_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p1_frees),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.trim_p1_freed_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.upload_misses),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.upload_source_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.same_snapshot_other_off_requests),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.same_off_other_identity_hash_equal_requests),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.same_off_other_identity_hash_different_requests),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.fresh_allocations),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.reused_storage_uploads),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.shape_plain_linear_uploads),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.shape_plain_linear_padded_uploads),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.shape_other_uploads),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.same_off_full_layout_candidate_uploads),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.logical_compare_attempts),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.logical_compare_equal),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.logical_compare_different),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.logical_compare_capped),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_admissions),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_admission_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_hint_reuses),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_hint_reuse_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_hash_reuses),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_hash_same_off_reuses),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_hash_other_off_reuses),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_hash_reuse_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_hint_retargets),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_cap_evictions),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_cap_owner_drop_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_budget_reclaims),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_budget_owner_drop_bytes),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_oversize_skips),
+            (unsigned long long)vp_texture_churn_take(&s_vp_texture_churn.snapshot_pool_oversize_skip_bytes));
+    fflush(stderr);
+    vp_texture_churn_probe_budget_reset();
+}
+
+static void vp_texture_cache_reset_usage(void)
+{
+    for (int i = 0; i < VP_TEX_SLOTS; ++i)
+        s_d3d.vp_tex[i].used = 0;
+}
+
+static void vp_texture_cache_trim_sources(u32 bytes)
+{
+    VP_SNAP_PAR_BARRIER_INDEX(OTHER);
+    const int churn_trace = vp_texture_churn_trace_enabled();
+    /* Reclaim pooled owners before cache identities, then keep later final
+     * releases in this trim from immediately repopulating the pool. */
+    const int pool_enabled = s_d3d.vp_tex_snapshot_pool_enabled;
+    if (pool_enabled) {
+        vp_texture_snapshot_pool_reclaim_for_budget(bytes);
+        ++s_d3d.vp_tex_snapshot_pool_suppress;
+    }
+    /* Prefer inactive slots, then drop remaining cache-only references if
+     * necessary. GPU resources contain their own uploaded bytes; forgetting
+     * their CPU identity neither changes those bytes nor releases a resource.
+     * Live records keep their own references throughout both passes. */
+    for (int pass = 0; pass < 2 &&
+         s_d3d.vp_tex_snapshot_bytes + bytes > VP_TEX_SNAPSHOT_MAX_BYTES; ++pass) {
+        for (int i = 0; i < VP_TEX_SLOTS &&
+             s_d3d.vp_tex_snapshot_bytes + bytes > VP_TEX_SNAPSHOT_MAX_BYTES; ++i) {
+            VPTexSlot* slot = &s_d3d.vp_tex[i];
+            if (slot->source_snapshot && (pass || !slot->used) &&
+                !d3d12_prefix_owner_texture_reserved((u32)i)) {
+                if (churn_trace) {
+                    VPTexSnapshot* source = slot->source_snapshot;
+                    const u64 source_bytes = source->bytes;
+                    const u64 budget_before = s_d3d.vp_tex_snapshot_bytes;
+                    vp_texture_cache_set_source(slot, NULL);
+                    const u64 budget_after = s_d3d.vp_tex_snapshot_bytes;
+                    const u64 freed_bytes = budget_before > budget_after
+                        ? budget_before - budget_after : 0;
+                    vp_texture_churn_record_trim((u32)pass, source_bytes,
+                                                 freed_bytes);
+                } else {
+                    vp_texture_cache_set_source(slot, NULL);
+                }
+            }
+        }
+    }
+    if (pool_enabled) --s_d3d.vp_tex_snapshot_pool_suppress;
+}
+
+static void vp_draw_texture_snapshots_release(D3D12DrawRecord* dr)
+{
+    if (!dr) return;
+    VP_SNAP_PAR_BARRIER(RENDER);
+    for (u32 u = 0; u < RSX_MAX_TEXTURES; ++u)
+        vp_texture_snapshot_release(&dr->tex_snapshot[u]);
+    for (u32 u = 0; u < RSX_MAX_VERTEX_TEXTURES; ++u)
+        vp_texture_snapshot_release(&dr->vtex_snapshot[u]);
+    dr->tex_snapshot_fault_mask = 0;
+    dr->vtex_snapshot_fault_mask = 0;
+}
+
+static RsxTextureWriteWatch s_vp_write_watch;
+static u64 s_vp_watch_hits, s_vp_watch_bytes, s_vp_watch_mismatches;
+
+static int vp_texture_write_watch_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* value = getenv("TJ_TEXTURE_WRITE_WATCH");
+        mode = value && !strcmp(value, "1") ? 1 :
+               value && !strcmp(value, "2") ? 2 : 0;
+        if (mode) fprintf(stderr, "[TJ-TEXTURE-WATCH] mode=%s\n",
+                           mode == 2 ? "audit-all-bytes" : "reuse-clean-pages");
+    }
+    return mode;
+}
+
+/* The ordinary observation: one GetWriteWatch(RESET) over this range now.
+ * Post-copy checks call it directly; they must observe the hash/copy window. */
+static u64 vp_texture_write_stamp_percall(const u8* base, u64 span, u32 off, u32 bytes,
+                                          RsxTextureWriteStampHint* hint)
+{
+    if (!vp_texture_write_watch_mode()) return 0;
+    /* TJ_SNAPSHOT_PARALLEL: queued observations precede this one, and the
+     * helper must be done with the watch before the presenter touches it. */
+    VP_SNAP_PAR_BARRIER_INDEX(WATCH);
+    int previous = s_vp_write_watch.state;
+    u64 stamp = rsx_texture_write_watch_stamp_cached(&s_vp_write_watch, base, span, off, bytes, hint);
+    if (previous >= 0 && s_vp_write_watch.state < 0)
+        fprintf(stderr, "[TJ-TEXTURE-WATCH] unavailable error=%u; full byte checks retained\n",
+                s_vp_write_watch.error);
+    return stamp;
+}
+
+/* ---------------------------------------------------------------------------
+ * TJ_WATCH_BATCH=1 (opt-in; needs TJ_TEXTURE_WRITE_WATCH=1 or 2). Unset or any
+ * other value never enters this code: vp_texture_write_stamp calls the
+ * unchanged per-call path above and every arm/note below returns at once.
+ *
+ * Instead of one GetWriteWatch(RESET) per texture capture (~1400 per heavy
+ * frame), the first capture after a pass boundary queries the watched
+ * texture coverage once (one call per contiguous run, normally a few) and
+ * records every dirty page in page_epochs. Later captures of that pass read
+ * their stamp from page epochs with no kernel call. The stamp value and hint
+ * contract are the per-call ones, so hint/hash/pool/frame-reuse logic and
+ * stored stamps are unchanged.
+ *
+ * Pass boundaries ("arms"; the batch itself is lazy, at the first capture):
+ *  - FIFO walk start: rsx_d3d12_backend_fifo_faulted is the first call of
+ *    every cellGcm_rsx_process_fifo walk, before PUT is sampled. Each walk
+ *    therefore batches after its own PUT read, so every guest write ordered
+ *    before that PUT (the normal texture-upload contract) is observed.
+ *  - NV406E acquire: rsx_d3d12_backend_acquire_gpu_free runs before the label
+ *    compare; data released by a guest/SPU label is observed after a match.
+ *  - FIFO prefix completion end (replay, MAIN commits, label publication).
+ *  - NV3089 blit: rsx_d3d12_backend_exact_blit_capture_enabled runs before
+ *    every non-swizzled CPU transfer into guest memory (no capture between).
+ *  Exact writeback commits invalidate just their rows' coverage.
+ *  Zero-capture walks never query; coverage is learned per 1 MiB chunk from
+ *  requested ranges and ages out after VP_WATCH_BATCH_AGE unused batches.
+ *
+ * Correctness/safety net:
+ *  - Only the stamp-equal reuse (watch mode 1 hint hit, frame-reuse hit) skips
+ *    bytes on an epoch stamp. Any capture that will compare, hash or copy
+ *    first re-queries its range per call, so new snapshots carry an exact
+ *    pre-copy stamp and a change found by bytes also reaches page epochs for
+ *    overlapping ranges later in the pass. Post-copy checks always query.
+ *  - Uncovered ranges (first use, aged out, invalidated) and a failed batch
+ *    (the rest of the pass) use the ordinary per-call query. Repeated batch
+ *    failures switch batching off for the run.
+ *  - Audit mode 2 still compares every byte with the epoch stamp's verdict;
+ *    a mismatch logs [TJ-WATCH-BATCH] post_batch_write=1 when the range had
+ *    an unobserved write since the batch, then disables the watch as before.
+ * Residual (documented, not closed here): a write landing after the batch
+ * query and before a same-pass stamp-equal reuse of those bytes is not seen
+ * until the next pass. Guest PPU/SPU writes ordered by PUT/acquire are
+ * covered above; unordered guest writes race the RSX on hardware too.
+ * Renderer CPU writes inside a walk WITHOUT a backend range hook: NV308A
+ * inline COLOR words, NV309E swizzled NV3089 destinations and NV0039 copies.
+ * They are FIFO-ordered before later draws, so a same-walk stamp-equal reuse
+ * must see them. Until cellGcmSys.c calls rsx_d3d12_backend_note_guest_write
+ * (ea, bytes) after each such store (then set VP_WATCH_BATCH_GUEST_WRITE_HOOKS
+ * to 1):
+ *  - every generic non-3D label flush (the edge those stores follow) makes
+ *    the rest of the pass use per-call queries (wb_soft events,
+ *    wb_soft_percall stamps), i.e. the old exact behaviour;
+ *  - TJ_NON3D_LABEL_PASS=1 lets NV308A LOCAL stores skip that flush with no
+ *    signal at all, so watch mode 1 keeps batching off with it (audit mode 2
+ *    still batches: its byte compare catches any staleness).
+ * Single renderer thread, like every other snapshot index.
+ * -----------------------------------------------------------------------*/
+#define VP_WATCH_BATCH_CHUNK_SHIFT 20u                 /* 1 MiB coverage chunk */
+#define VP_WATCH_BATCH_CHUNKS (1u << (32u - VP_WATCH_BATCH_CHUNK_SHIFT))
+#define VP_WATCH_BATCH_AGE 128u        /* batches (~10 frames) an unused chunk stays */
+#define VP_WATCH_BATCH_GAP 4u          /* join runs up to GAP-1 empty chunks apart */
+#define VP_WATCH_BATCH_FAIL_LIMIT 8u   /* consecutive failed batches: stop batching */
+/* 1 only once cellGcmSys.c reports every renderer guest store (NV308A words,
+ * swizzled NV3089 scatter, NV0039 copy) via rsx_d3d12_backend_note_guest_write. */
+#define VP_WATCH_BATCH_GUEST_WRITE_HOOKS 0
+
+typedef struct VPWatchBatchWindow {  /* one [TJ-PERF] window */
+    u64 batches, calls, pages, dirty, ticks;
+    u64 epoch_stamps, uncovered, failed_pass, requeries;
+    u64 arms, soft, soft_percall, notes, failures, audit;
+} VPWatchBatchWindow;
+
+static int s_vp_watch_batch_config = -1; /* TJ_WATCH_BATCH, read once */
+static struct {
+    int off;                /* batching stopped after repeated failures */
+    int cov_failed;         /* this pass's batch failed: per-call until next arm */
+    int soft;               /* non-3D CPU store of unknown range since the batch */
+    int last_epoch;         /* the last batch-mode stamp came from page epochs */
+    u32 consecutive_failures;
+    LONG arm_gen;           /* bumped by every pass boundary */
+    LONG batch_gen;         /* arm_gen the current coverage was queried after */
+    u32 serial;             /* current batch; 0 = none yet */
+    u32 cov_chunks;         /* chunks covered by the current batch */
+    u32 covered[VP_WATCH_BATCH_CHUNKS];  /* == serial: queried by this batch */
+    u32 wanted[VP_WATCH_BATCH_CHUNKS];   /* batch serial of the last request */
+    u64 wanted_bits[VP_WATCH_BATCH_CHUNKS / 64u];
+    VPWatchBatchWindow win;
+} s_vp_watch_batch;
+
+static int vp_watch_batch_enabled(void)
+{
+    if (s_vp_watch_batch_config < 0) {
+        const char* value = getenv("TJ_WATCH_BATCH");
+        const int requested = value && strcmp(value, "1") == 0;
+        /* Only a requested batch consults the watch mode (and its one-time
+         * log line); unset keeps the original first-use order. */
+        const int mode = requested ? vp_texture_write_watch_mode() : 0;
+        const char* label_pass = requested ? getenv("TJ_NON3D_LABEL_PASS") : NULL;
+        /* Unhooked NV308A LOCAL stores skip the flush under label-pass: no
+         * signal, so mode-1 reuse could serve pre-store bytes. */
+        const int unguarded = !VP_WATCH_BATCH_GUEST_WRITE_HOOKS && mode == 1 &&
+                              label_pass && strcmp(label_pass, "1") == 0;
+        const int enabled = requested && mode != 0 && !unguarded;
+        s_vp_watch_batch_config = enabled;
+        if (value && value[0])
+            fprintf(stderr, "[TJ-WATCH-BATCH] enabled=%d%s\n", enabled,
+                    !requested || enabled ? "" :
+                    unguarded ? " inactive=TJ_NON3D_LABEL_PASS_needs_guest_write_hooks_or_watch_2"
+                              : " inactive=needs_TJ_TEXTURE_WRITE_WATCH=1_or_2");
+    }
+    return s_vp_watch_batch_config > 0 && !s_vp_watch_batch.off;
+}
+
+/* Coverage and page epochs share the watch's lifetime: reset with it. */
+static void vp_watch_batch_reset(void)
+{
+    memset(&s_vp_watch_batch, 0, sizeof(s_vp_watch_batch));
+}
+
+/* A pass boundary: the next stamp request re-queries the coverage. */
+static void vp_watch_batch_arm(void)
+{
+    if (!vp_watch_batch_enabled()) return;
+    InterlockedIncrement(&s_vp_watch_batch.arm_gen);
+    ++s_vp_watch_batch.win.arms;
+}
+
+/* Generic non-3D label flush: a renderer CPU store of unknown range follows. */
+static void vp_watch_batch_soft(void)
+{
+    if (!vp_watch_batch_enabled()) return;
+    s_vp_watch_batch.soft = 1;
+    ++s_vp_watch_batch.win.soft;
+}
+
+/* A renderer write to [ea, ea + bytes) that the current coverage may not have
+ * observed. Call after the store (or before it with no capture in between):
+ * its chunks fall back to per-call queries until the next batch. */
+static void vp_watch_batch_note_write(u32 ea, u64 bytes)
+{
+    if (!bytes || !vp_watch_batch_enabled() || !s_vp_watch_batch.serial) return;
+    const u64 end = (u64)ea + bytes - 1u;
+    const u32 first = ea >> VP_WATCH_BATCH_CHUNK_SHIFT;
+    const u32 last = end >> 32 ? VP_WATCH_BATCH_CHUNKS - 1u
+                               : (u32)(end >> VP_WATCH_BATCH_CHUNK_SHIFT);
+    for (u32 c = first; c <= last; ++c)
+        if (s_vp_watch_batch.covered[c] == s_vp_watch_batch.serial)
+            s_vp_watch_batch.covered[c] = 0;
+    ++s_vp_watch_batch.win.notes;
+}
+
+/* Exported for FIFO-side CPU stores into guest memory (NV308A/NV3089/NV309E/
+ * NV0039); no-op unless TJ_WATCH_BATCH is active. */
+void rsx_d3d12_backend_note_guest_write(u32 ea, u32 bytes)
+{
+    VP_SNAP_PAR_BARRIER(BLIT);
+    vp_watch_batch_note_write(ea, bytes);
+}
+
+static void vp_watch_batch_stop(const char* why)
+{
+    s_vp_watch_batch.off = 1;
+    s_vp_watch_batch.last_epoch = 0;
+    fprintf(stderr, "[TJ-WATCH-BATCH] stopped reason=%s; per-call queries retained\n", why);
+}
+
+/* Query+reset chunks [c_first, c_last] (clipped to the watch); 0 on success. */
+static int vp_watch_batch_query_run(u32 c_first, u32 c_last, u32 serial)
+{
+    RsxTextureWriteWatch* watch = &s_vp_write_watch;
+    const u64 per_chunk = (1ull << VP_WATCH_BATCH_CHUNK_SHIFT) / watch->page_size;
+    const u64 span_pages = watch->span / watch->page_size;
+    const u64 first = (u64)c_first * per_chunk;
+    u64 last = ((u64)c_last + 1u) * per_chunk - 1u;
+    if (first >= span_pages) return 0;
+    if (last >= span_pages) last = span_pages - 1u;
+    u64 dirty = 0;
+    ++s_vp_watch_batch.win.calls;
+    const int previous = watch->state;
+    const UINT error = rsx_texture_write_watch_query_pages(watch, first, last, &dirty);
+    if (error) {
+        if (previous >= 0 && watch->state < 0)
+            fprintf(stderr, "[TJ-TEXTURE-WATCH] unavailable error=%u; full byte checks retained\n",
+                    watch->error);
+        return 1;
+    }
+    s_vp_watch_batch.win.pages += last - first + 1u;
+    s_vp_watch_batch.win.dirty += dirty;
+    for (u32 c = c_first; c <= c_last; ++c) s_vp_watch_batch.covered[c] = serial;
+    s_vp_watch_batch.cov_chunks += c_last - c_first + 1u;
+    return 0;
+}
+
+/* The pass's batch: one query per run of recently requested chunks. */
+static void vp_watch_batch_run(void)
+{
+    static LARGE_INTEGER frequency;
+    LARGE_INTEGER begin, end;
+    if (!frequency.QuadPart) QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&begin);
+    if (s_vp_watch_batch.serial >= 0xFFFFFF00u) {
+        /* Serial wrap (years of batches): forget coverage, keep the counters. */
+        VPWatchBatchWindow win = s_vp_watch_batch.win;
+        vp_watch_batch_reset();
+        s_vp_watch_batch.win = win;
+    }
+    const u32 serial = ++s_vp_watch_batch.serial;
+    s_vp_watch_batch.batch_gen = s_vp_watch_batch.arm_gen;
+    s_vp_watch_batch.cov_failed = 0;
+    s_vp_watch_batch.soft = 0;
+    s_vp_watch_batch.cov_chunks = 0;
+    ++s_vp_watch_batch.win.batches;
+    u32 run_first = UINT32_MAX, run_last = 0;
+    int failed = 0;
+    for (u32 word = 0; word < VP_WATCH_BATCH_CHUNKS / 64u && !failed; ++word) {
+        u64 bits = s_vp_watch_batch.wanted_bits[word];
+        while (bits && !failed) {
+            unsigned long bit;
+            _BitScanForward64(&bit, bits);
+            bits &= bits - 1u;
+            const u32 c = word * 64u + (u32)bit;
+            if (serial - s_vp_watch_batch.wanted[c] > VP_WATCH_BATCH_AGE) {
+                s_vp_watch_batch.wanted[c] = 0;
+                s_vp_watch_batch.wanted_bits[word] &= ~(1ull << bit);
+                continue;
+            }
+            if (run_first != UINT32_MAX && c - run_last <= VP_WATCH_BATCH_GAP) {
+                run_last = c;
+                continue;
+            }
+            if (run_first != UINT32_MAX)
+                failed = vp_watch_batch_query_run(run_first, run_last, serial);
+            run_first = run_last = c;
+        }
+    }
+    if (!failed && run_first != UINT32_MAX)
+        failed = vp_watch_batch_query_run(run_first, run_last, serial);
+    if (failed) {
+        s_vp_watch_batch.cov_failed = 1;
+        ++s_vp_watch_batch.win.failures;
+        if (++s_vp_watch_batch.consecutive_failures >= VP_WATCH_BATCH_FAIL_LIMIT)
+            vp_watch_batch_stop("batch_query_failures");
+    } else {
+        s_vp_watch_batch.consecutive_failures = 0;
+    }
+    QueryPerformanceCounter(&end);
+    if (frequency.QuadPart && end.QuadPart > begin.QuadPart)
+        s_vp_watch_batch.win.ticks += (u64)(end.QuadPart - begin.QuadPart);
+}
+
+static u64 vp_watch_batch_stamp(const u8* base, u64 span, u32 off, u32 bytes,
+                                RsxTextureWriteStampHint* hint)
+{
+    RsxTextureWriteWatch* watch = &s_vp_write_watch;
+    s_vp_watch_batch.last_epoch = 0;
+    /* Uninitialized (first use), disabled, foreign or invalid ranges keep
+     * the ordinary path, which also performs the watch's lazy setup. */
+    if (watch->state != 1 || !base || base != watch->base || span != watch->span ||
+        span > (1ull << 32) || !bytes || (u64)off + bytes > span ||
+        !watch->page_size || watch->page_size > (1u << VP_WATCH_BATCH_CHUNK_SHIFT))
+        return vp_texture_write_stamp_percall(base, span, off, bytes, hint);
+    const u32 first = off >> VP_WATCH_BATCH_CHUNK_SHIFT;
+    const u32 last = (u32)(((u64)off + bytes - 1u) >> VP_WATCH_BATCH_CHUNK_SHIFT);
+    const u32 mark = s_vp_watch_batch.serial + 1u; /* covered from the next batch on */
+    for (u32 c = first; c <= last; ++c) {
+        s_vp_watch_batch.wanted[c] = mark;
+        s_vp_watch_batch.wanted_bits[c >> 6] |= 1ull << (c & 63u);
+    }
+    if (!s_vp_watch_batch.serial ||
+        s_vp_watch_batch.arm_gen != s_vp_watch_batch.batch_gen) {
+        vp_watch_batch_run();
+        if (s_vp_watch_batch.off || watch->state != 1)
+            return vp_texture_write_stamp_percall(base, span, off, bytes, hint);
+    }
+    if (!VP_WATCH_BATCH_GUEST_WRITE_HOOKS && s_vp_watch_batch.soft) {
+        /* A renderer store of unknown range may follow the batch: exact
+         * per-call observation until the next pass boundary re-batches. */
+        ++s_vp_watch_batch.win.soft_percall;
+        return vp_texture_write_stamp_percall(base, span, off, bytes, hint);
+    }
+    int covered = !s_vp_watch_batch.cov_failed;
+    for (u32 c = first; covered && c <= last; ++c)
+        covered = s_vp_watch_batch.covered[c] == s_vp_watch_batch.serial;
+    if (!covered) {
+        if (s_vp_watch_batch.cov_failed) ++s_vp_watch_batch.win.failed_pass;
+        else ++s_vp_watch_batch.win.uncovered;
+        return vp_texture_write_stamp_percall(base, span, off, bytes, hint);
+    }
+    const u64 stamp = rsx_texture_write_watch_stamp_epochs(watch, off, bytes, hint);
+    if (stamp) {
+        s_vp_watch_batch.last_epoch = 1;
+        ++s_vp_watch_batch.win.epoch_stamps;
+    }
+    return stamp;
+}
+
+/* Safety net: a capture that is about to compare, hash or copy replaces an
+ * epoch stamp with the ordinary per-call observation of its range. */
+static u64 vp_watch_batch_requery(const u8* base, u64 span, u32 off, u32 bytes,
+                                  RsxTextureWriteStampHint* hint)
+{
+    s_vp_watch_batch.last_epoch = 0;
+    ++s_vp_watch_batch.win.requeries;
+    return vp_texture_write_stamp_percall(base, span, off, bytes, hint);
+}
+
+/* Audit (mode 2) found different bytes under an unchanged epoch stamp. Ask
+ * the OS whether the range was written after the batch (the documented
+ * residual) before the caller disables the watch as usual. */
+static void vp_watch_batch_audit_mismatch(const u8* base, u64 span, u32 off,
+        u32 bytes, u64 stamp, const RsxTextureWriteStampHint* hint)
+{
+    RsxTextureWriteStampHint probe = *hint;
+    const u64 fresh = vp_texture_write_stamp_percall(base, span, off, bytes, &probe);
+    ++s_vp_watch_batch.win.audit;
+    fprintf(stderr, "[TJ-WATCH-BATCH] audit mismatch off=0x%X bytes=%u "
+            "post_batch_write=%d soft=%d\n", off, bytes,
+            fresh ? fresh != stamp : -1, s_vp_watch_batch.soft);
+}
+
+/* [TJ-PERF] suffix for the window just ended ("" when off), then a new
+ * window. wb_epoch = per-call queries avoided; wb_calls = batch kernel calls. */
+static void vp_watch_batch_window(char* out, size_t size)
+{
+    out[0] = '\0';
+    if (s_vp_watch_batch_config <= 0) return;
+    static LARGE_INTEGER frequency;
+    if (!frequency.QuadPart) QueryPerformanceFrequency(&frequency);
+    const VPWatchBatchWindow* w = &s_vp_watch_batch.win;
+    snprintf(out, size, " wb_batches=%llu wb_calls=%llu wb_pages=%llu wb_dirty=%llu "
+             "wb_us=%llu wb_epoch=%llu wb_uncovered=%llu wb_failpass=%llu "
+             "wb_requery=%llu wb_arms=%llu wb_soft=%llu wb_soft_percall=%llu "
+             "wb_notes=%llu wb_fail=%llu wb_audit=%llu wb_cov_mib=%u%s",
+             (unsigned long long)w->batches, (unsigned long long)w->calls,
+             (unsigned long long)w->pages, (unsigned long long)w->dirty,
+             (unsigned long long)(frequency.QuadPart
+                 ? w->ticks * 1000000ull / (u64)frequency.QuadPart : 0),
+             (unsigned long long)w->epoch_stamps, (unsigned long long)w->uncovered,
+             (unsigned long long)w->failed_pass, (unsigned long long)w->requeries,
+             (unsigned long long)w->arms, (unsigned long long)w->soft,
+             (unsigned long long)w->soft_percall, (unsigned long long)w->notes,
+             (unsigned long long)w->failures, (unsigned long long)w->audit,
+             s_vp_watch_batch.cov_chunks, s_vp_watch_batch.off ? " wb_off=1" : "");
+    memset(&s_vp_watch_batch.win, 0, sizeof(s_vp_watch_batch.win));
+}
+
+static u64 vp_texture_write_stamp(const u8* base, u64 span, u32 off, u32 bytes,
+                                 RsxTextureWriteStampHint* hint)
+{
+    if (!vp_texture_write_watch_mode()) return 0;
+    VP_SNAP_PAR_BARRIER_INDEX(WATCH);
+    if (vp_watch_batch_enabled())
+        return vp_watch_batch_stamp(base, span, off, bytes, hint);
+    return vp_texture_write_stamp_percall(base, span, off, bytes, hint);
+}
+
+static int vp_snapshot_bytes_equal(const void* a, const void* b, size_t bytes)
+{
+#if defined(RSX_BYTES_EQUAL_HAS_AVX2) && defined(PF_AVX2_INSTRUCTIONS_AVAILABLE)
+    /* The Windows capability includes OS vector-state support. Cache per
+     * thread so concurrent callers neither race nor query on every draw. */
+    static _Thread_local int avx2 = -1;
+    if (bytes >= 128) {
+        if (avx2 < 0) avx2 = IsProcessorFeaturePresent(PF_AVX2_INSTRUCTIONS_AVAILABLE) != 0;
+        if (avx2) return rsx_bytes_equal_avx2(a, b, bytes);
+    }
+#endif
+    return rsx_bytes_equal(a, b, bytes);
+}
+
+/* TJ_SNAPSHOT_PARALLEL: the write-watch observation of exactly [off, off +
+ * bytes) that vp_snap_par_observe took for this capture, in capture order,
+ * before any later capture's query. NULL = the ordinary per-call query. */
+typedef struct VPSnapParObs {
+    int valid;                     /* the query ran for this off/bytes */
+    u32 off, bytes;
+    u64 stamp;                     /* 0 = unavailable; hint left untouched */
+    RsxTextureWriteStampHint hint; /* the per-call query's hint output */
+    LONGLONG query_qpc;            /* when it ran (audit diagnostics) */
+} VPSnapParObs;
+static void vp_snap_par_audit_mismatch(u32 off, u32 bytes, u64 stamp,
+                                       const RsxTextureWriteStampHint* hint,
+                                       const VPSnapParObs* obs);
+
+static int vp_capture_tex_snapshot_impl_obs(u32 off, u32 w, u32 h, u32 depth,
+                                   u32 fmt, u32 pitch, int cube, u32 dimension,
+                                   u32 mips, int has_border, VPTexSnapshot** out,
+                                   const VPSnapParObs* obs)
+{
+    extern u8* vm_base;
+    extern u32 ppu_vm_size;
+    if (!out) return -1;
+    *out = NULL;
+    if (!w || !h || !depth) return 0;
+    u32 bytes = 0;
+    if (vp_tex_source_span(w, h, depth, fmt, pitch, cube, dimension,
+                           mips, has_border, &bytes, NULL) != 0)
+        return 0; /* unsupported uploads retain their existing null path */
+    const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ull << 32);
+    if (!vm_base || (u64)off + bytes > vm_cap ||
+        bytes > VP_TEX_SNAPSHOT_SINGLE_MAX_BYTES)
+        return -1;
+    const u8* source = vm_base + off;
+    const int churn_trace = vp_texture_churn_trace_enabled();
+    VPTexSnapshot* candidate = vp_texture_snapshot_hint_find(off, bytes);
+    RsxTextureWriteStampHint stamp_hint = {0};
+    if (candidate) stamp_hint = candidate->source_stamp_hint;
+    u64 write_stamp;
+    if (obs && obs->valid && obs->off == off && obs->bytes == bytes) {
+        /* TJ_SNAPSHOT_PARALLEL: this capture's own per-call query, already
+         * taken. Its value and hint output do not depend on the hint passed
+         * in (that only short-cuts an unchanged page walk); a failed or
+         * disabled watch (0) leaves the candidate's hint, as here. */
+        write_stamp = obs->stamp;
+        if (write_stamp) stamp_hint = obs->hint;
+    } else {
+        write_stamp = vp_texture_write_stamp(vm_base, vm_cap, off, bytes, &stamp_hint);
+    }
+    /* A repeated source already has an immutable copy. Verify every byte at
+     * this FIFO position before reusing it, avoiding the old hash-then-memcmp
+     * double scan. Address/size alone never validate mutable guest memory.
+     * Collisions and writes fall back to the existing content-dedup path. */
+    if (candidate) {
+        const int unchanged = write_stamp && candidate->source_write_stamp == write_stamp;
+        const int equal = (unchanged && vp_texture_write_watch_mode() == 1) ||
+            vp_snapshot_bytes_equal(candidate->data, source, bytes);
+        if (unchanged) {
+            ++s_vp_watch_hits;
+            s_vp_watch_bytes += bytes;
+            if (!equal) {
+                ++s_vp_watch_mismatches;
+                if (s_vp_watch_batch.last_epoch) /* TJ_WATCH_BATCH stamp */
+                    vp_watch_batch_audit_mismatch(vm_base, vm_cap, off, bytes,
+                                                  write_stamp, &stamp_hint);
+                if (obs && obs->valid) /* TJ_SNAPSHOT_PARALLEL observation */
+                    vp_snap_par_audit_mismatch(off, bytes, write_stamp,
+                                               &stamp_hint, obs);
+                /* Audit never skipped bytes. Disable even on a concurrent
+                 * post-query write: investigate any discrepancy before reuse. */
+                rsx_texture_write_watch_fail(&s_vp_write_watch, ERROR_INVALID_DATA);
+                fprintf(stderr, "[TJ-TEXTURE-WATCH] audit mismatch off=0x%X bytes=%u\n", off, bytes);
+            }
+        }
+        if (equal) {
+            candidate->source_write_stamp = write_stamp;
+            candidate->source_stamp_hint = stamp_hint;
+            if (churn_trace && candidate->pool_retained) {
+                InterlockedIncrement64(&s_vp_texture_churn.snapshot_pool_hint_reuses);
+                InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_hint_reuse_bytes,
+                                 (LONG64)candidate->bytes);
+            }
+            ++candidate->refs;
+            *out = candidate;
+            return 0;
+        }
+    }
+    /* TJ_WATCH_BATCH: bytes are hashed/compared/copied below, so take the
+     * ordinary per-call observation of this range first (never set when off). */
+    if (s_vp_watch_batch.last_epoch)
+        write_stamp = vp_watch_batch_requery(vm_base, vm_cap, off, bytes, &stamp_hint);
+    const u64 hash = vp_tex_source_hash(source, bytes, 1u, bytes, 1u);
+    VPTexSnapshot* existing = s_d3d.vp_tex_snapshot_buckets[
+        hash & (VP_TEX_SNAPSHOT_BUCKETS - 1u)];
+    for (; existing; existing = existing->hash_next) {
+        if (existing->bytes == bytes && existing->hash == hash &&
+            vp_snapshot_bytes_equal(existing->data, source, bytes)) {
+            const int same_source_off = existing->source_off == off;
+            if (churn_trace && existing->pool_retained) {
+                InterlockedIncrement64(&s_vp_texture_churn.snapshot_pool_hash_reuses);
+                InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_hash_reuse_bytes,
+                                 (LONG64)existing->bytes);
+                InterlockedIncrement64(same_source_off
+                    ? &s_vp_texture_churn.snapshot_pool_hash_same_off_reuses
+                    : &s_vp_texture_churn.snapshot_pool_hash_other_off_reuses);
+            }
+            if (same_source_off) {
+                vp_texture_snapshot_hint_upsert(existing);
+                existing->source_write_stamp = write_stamp;
+                existing->source_stamp_hint = stamp_hint;
+            } else if (vp_texture_snapshot_hint_retarget_enabled() &&
+                       vp_texture_snapshot_hint_retarget(existing, off, bytes,
+                                                         write_stamp, &stamp_hint)) {
+                if (churn_trace)
+                    InterlockedIncrement64(&s_vp_texture_churn.snapshot_pool_hint_retargets);
+            }
+            ++existing->refs;
+            *out = existing;
+            return 0;
+        }
+    }
+    /* Reuse above adds references, not bytes. Charge the shared budget only
+     * when allocating a new immutable source. Cached upload identities must
+     * not consume the capacity required by live record-time snapshots. */
+    vp_texture_cache_trim_sources(bytes);
+    if (s_d3d.vp_tex_snapshot_bytes + bytes > VP_TEX_SNAPSHOT_MAX_BYTES) {
+        if (churn_trace) vp_texture_churn_record_budget_reject();
+        return -1;
+    }
+    VPTexSnapshot* snapshot = (VPTexSnapshot*)calloc(1, sizeof(*snapshot));
+    if (!snapshot) return -1;
+    snapshot->data = (u8*)malloc(bytes);
+    if (!snapshot->data) { free(snapshot); return -1; }
+    memcpy(snapshot->data, source, bytes);
+    snapshot->bytes = bytes;
+    snapshot->source_off = off;
+    const int watch_mode = vp_texture_write_watch_mode();
+    u64 owned_hash;
+    if (write_stamp && watch_mode == 1 &&
+        bytes >= VP_TEX_SNAPSHOT_HASH_REUSE_MIN_BYTES) {
+        /* The post-copy query costs more than it saves for small inputs. Keep
+         * the old double-hash path below the measured 16 KiB cutoff. */
+        RsxTextureWriteStampHint post_hint = stamp_hint;
+        const u64 post_stamp =
+            vp_texture_write_stamp_percall(vm_base, vm_cap, off, bytes, &post_hint);
+        if (post_stamp == write_stamp)
+            owned_hash = hash;
+        else
+            owned_hash = vp_tex_source_hash(snapshot->data, bytes, 1u, bytes, 1u);
+    } else if (write_stamp && watch_mode == 2) {
+        /* Audit always hashes the owned copy and checks the post-copy stamp,
+         * including small textures. A stable mismatch disables tracking. */
+        RsxTextureWriteStampHint post_hint = stamp_hint;
+        const u64 post_stamp =
+            vp_texture_write_stamp_percall(vm_base, vm_cap, off, bytes, &post_hint);
+        owned_hash = vp_tex_source_hash(snapshot->data, bytes, 1u, bytes, 1u);
+        if (post_stamp == write_stamp && owned_hash != hash) {
+            ++s_vp_watch_mismatches;
+            rsx_texture_write_watch_fail(&s_vp_write_watch, ERROR_INVALID_DATA);
+            fprintf(stderr, "[TJ-TEXTURE-WATCH] copy audit mismatch off=0x%X bytes=%u\n",
+                    off, bytes);
+        }
+    } else {
+        owned_hash = vp_tex_source_hash(snapshot->data, bytes, 1u, bytes, 1u);
+    }
+    snapshot->hash = owned_hash;
+    snapshot->refs = 1;
+    snapshot->source_write_stamp = write_stamp;
+    snapshot->source_stamp_hint = stamp_hint;
+    u32 bucket = snapshot->hash & (VP_TEX_SNAPSHOT_BUCKETS - 1u);
+    snapshot->hash_next = s_d3d.vp_tex_snapshot_buckets[bucket];
+    s_d3d.vp_tex_snapshot_buckets[bucket] = snapshot;
+    vp_texture_snapshot_hint_upsert(snapshot);
+    s_d3d.vp_tex_snapshot_bytes += bytes;
+    *out = snapshot;
+    if (churn_trace) vp_texture_churn_record_new_snapshot(bytes);
+    return 0;
+}
+
+/* The ordinary capture: its own per-call query. TJ_SNAPSHOT_PARALLEL: every
+ * queued capture is applied first, so this one keeps its serial position. */
+static int vp_capture_tex_snapshot_impl(u32 off, u32 w, u32 h, u32 depth,
+                                   u32 fmt, u32 pitch, int cube, u32 dimension,
+                                   u32 mips, int has_border, VPTexSnapshot** out)
+{
+    VP_SNAP_PAR_BARRIER_INDEX(WATCH);
+    return vp_capture_tex_snapshot_impl_obs(off, w, h, depth, fmt, pitch, cube,
+                                            dimension, mips, has_border, out, NULL);
+}
+
+/* ---------------------------------------------------------------------------
+ * TJ_SNAPSHOT_FRAME_REUSE=1 (opt-in). Unset or any other value never enters
+ * this code: vp_capture_tex_snapshot below calls the unchanged
+ * vp_capture_tex_snapshot_impl directly, as before.
+ *
+ * Within one recorded epoch -- the records accumulated between two record
+ * releases (FIFO-prefix completion, final present, clear boundary, halt,
+ * truncation, shutdown) -- a repeated capture of the same exact key returns
+ * the snapshot the earlier capture produced, skipping the span, hint, hash,
+ * compare and copy work, but only when the write watch proves the source
+ * range unchanged since that earlier capture:
+ *  - Key: every input of the capture -- resolved guest offset, width, height,
+ *    depth, full format word (base format, LN/swizzle and UN bits), pitch,
+ *    cube, dimension, requested mip count and border porch. The captured
+ *    bytes are exactly vm_base[off, off + span(key)). Remap, filter, address
+ *    and border colour never reach the capture; each draw record keeps its
+ *    own copy for replay.
+ *  - Proof: the existing GetWriteWatch query/reset still runs for every
+ *    capture, hit or not (with TJ_WATCH_BATCH=1 the observation may be the
+ *    pass's batch query instead; see vp_watch_batch_stamp for its limits).
+ *    A hit needs watch mode 1 (reuse-clean-pages), a
+ *    nonzero stamp and the stamp equal to the one observed BEFORE the earlier
+ *    capture compared, hashed or copied any byte. A range stamp grows once a
+ *    write to its pages is observed, including notifications consumed by an
+ *    overlapping range's query, so equality proves that no CPU, SPU DMA, MAIN
+ *    writeback/blit commit, label or other guest write reached the range
+ *    since then. GPU-owned/render-target inputs never reach this capture.
+ *  - Stamp source: the capture stores its pre-compare write_stamp/stamp_hint
+ *    into the snapshot it returns whenever that snapshot's source_off is the
+ *    requested offset (hint, same-offset hash, alias retarget and new paths);
+ *    those are read back straight after the call. A snapshot shared from
+ *    another offset carries another range's stamp: the entry then uses this
+ *    function's own query taken just before the call (a failed hit check), or
+ *    is marked to take one before the next capture of that key.
+ *  - Anything else (watch Off/Audit or unavailable, changed stamp, bounds, an
+ *    uncacheable result) runs the unchanged capture; a cacheable result then
+ *    refreshes the entry.
+ *  - Ownership: each live entry holds one strong reference. A hit adds the
+ *    caller's reference, exactly like the hint/hash reuse paths. Invalidation
+ *    releases the table's references before the records release theirs.
+ * Single renderer thread, like every other snapshot index.
+ * -----------------------------------------------------------------------*/
+#define VP_SNAPSHOT_FRAME_REUSE_SLOTS 1024u /* power of two; u16 live indices */
+#define VP_SNAPSHOT_FRAME_REUSE_PROBES 16u
+#define VP_SNAPSHOT_FRAME_REUSE_MAX_LIVE (VP_SNAPSHOT_FRAME_REUSE_SLOTS * 3u / 4u)
+
+typedef struct VPSnapshotFrameEntry {
+    VPTexSnapshot* snapshot;             /* strong; NULL = dead, never a hit */
+    u64 write_stamp;                     /* pre-compare stamp; 0 = dead */
+    RsxTextureWriteStampHint stamp_hint; /* table-owned hint for this range */
+    u32 off, w, h, depth, fmt, pitch, dimension, mips;
+    int cube, has_border;
+    u32 bytes;                           /* exact source span, 0 = unknown */
+    u8 used;                             /* slot occupied in this epoch */
+    u8 prequery;                         /* dead: observe before next capture */
+} VPSnapshotFrameEntry;
+
+typedef struct VPSnapshotFrameReuseStats {
+    u64 calls, hits, hit_bytes, misses, inserts, updates, table_full;
+    u64 forced_write, forced_watch_unavailable, forced_watch_mode;
+    u64 forced_bounds, forced_dead, prequeries;
+    u64 uncached_fail, uncached_null, uncached_other_off, uncached_no_stamp;
+    u64 invalidations, released;
+} VPSnapshotFrameReuseStats;
+
+static struct {
+    VPSnapshotFrameEntry entries[VP_SNAPSHOT_FRAME_REUSE_SLOTS];
+    u16 live[VP_SNAPSHOT_FRAME_REUSE_SLOTS];
+    u32 live_count;
+    VPSnapshotFrameReuseStats stats; /* per-report-window deltas */
+} s_vp_frame_reuse;
+
+static int vp_snapshot_frame_reuse_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_SNAPSHOT_FRAME_REUSE");
+        enabled = value && strcmp(value, "1") == 0;
+        if (value && value[0])
+            fprintf(stderr, "[tj-snap-reuse] enabled=%d watch_mode=%d%s\n",
+                    enabled, vp_texture_write_watch_mode(),
+                    enabled && vp_texture_write_watch_mode() != 1
+                        ? " inactive=needs_TJ_TEXTURE_WRITE_WATCH=1" : "");
+    }
+    return enabled;
+}
+
+/* Per-second [tj-snap-reuse] line: TJ_DRAW_COST_TRACE=1 or TJ_VERBOSE_STATS. */
+static int vp_snapshot_frame_reuse_report_enabled(void)
+{
+    static int report = -1;
+    if (report < 0) {
+        const char* cost = getenv("TJ_DRAW_COST_TRACE");
+        report = (cost && strcmp(cost, "1") == 0) || tj_verbose_stats();
+    }
+    return report && vp_snapshot_frame_reuse_enabled();
+}
+
+static u32 vp_snapshot_frame_reuse_hash(u32 off, u32 w, u32 h, u32 depth,
+        u32 fmt, u32 pitch, int cube, u32 dimension, u32 mips, int has_border)
+{
+    u64 x = (u64)off * 0x9E3779B97F4A7C15ull;
+    x ^= (((u64)w << 32) | h) * 0xC2B2AE3D27D4EB4Full;
+    x ^= (((u64)depth << 32) | fmt) * 0x165667B19E3779F9ull;
+    x ^= (((u64)pitch << 32) | mips) * 0x27D4EB2F165667C5ull;
+    x ^= (((u64)dimension << 2) | ((u64)(cube != 0) << 1) |
+          (u64)(has_border != 0)) * 0x94D049BB133111EBull;
+    x ^= x >> 31;
+    x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 29;
+    return (u32)x;
+}
+
+static int vp_snapshot_frame_reuse_key_equal(const VPSnapshotFrameEntry* e,
+        u32 off, u32 w, u32 h, u32 depth, u32 fmt, u32 pitch, int cube,
+        u32 dimension, u32 mips, int has_border)
+{
+    return e->off == off && e->w == w && e->h == h && e->depth == depth &&
+           e->fmt == fmt && e->pitch == pitch && e->cube == cube &&
+           e->dimension == dimension && e->mips == mips &&
+           e->has_border == has_border;
+}
+
+/* Occupy an unused slot for this epoch; it stays occupied (possibly dead)
+ * until invalidation, so probe chains never break. */
+static void vp_snapshot_frame_reuse_claim(VPSnapshotFrameEntry* e, u32 index,
+        u32 off, u32 w, u32 h, u32 depth, u32 fmt, u32 pitch, int cube,
+        u32 dimension, u32 mips, int has_border)
+{
+    e->off = off; e->w = w; e->h = h; e->depth = depth; e->fmt = fmt;
+    e->pitch = pitch; e->cube = cube; e->dimension = dimension; e->mips = mips;
+    e->has_border = has_border;
+    e->snapshot = NULL;
+    e->write_stamp = 0;
+    memset(&e->stamp_hint, 0, sizeof(e->stamp_hint));
+    e->bytes = 0;
+    e->prequery = 0;
+    e->used = 1;
+    s_vp_frame_reuse.live[s_vp_frame_reuse.live_count++] = (u16)index;
+}
+
+/* Ends the recorded epoch. Called before any record releases its snapshots
+ * and at backend init/shutdown before the pool drain and watch teardown (the
+ * entries' stamp hints share the watch's lifetime). Empty table: no work. */
+static void vp_snapshot_frame_reuse_invalidate(void)
+{
+    if (!s_vp_frame_reuse.live_count) return;
+    for (u32 i = 0; i < s_vp_frame_reuse.live_count; ++i) {
+        VPSnapshotFrameEntry* e = &s_vp_frame_reuse.entries[s_vp_frame_reuse.live[i]];
+        if (e->snapshot) {
+            vp_texture_snapshot_release(&e->snapshot);
+            ++s_vp_frame_reuse.stats.released;
+        }
+        e->write_stamp = 0;
+        e->prequery = 0;
+        e->used = 0;
+    }
+    s_vp_frame_reuse.live_count = 0;
+    ++s_vp_frame_reuse.stats.invalidations;
+}
+
+static void vp_snapshot_frame_reuse_report(ULONGLONG t_ms, u64 frame_count,
+                                           ULONGLONG interval_ms)
+{
+    if (!vp_snapshot_frame_reuse_report_enabled()) return;
+    VPSnapshotFrameReuseStats* st = &s_vp_frame_reuse.stats;
+    fprintf(stderr,
+            "[tj-snap-reuse] t_ms=%llu frame_count=%llu interval_ms=%llu calls=%llu "
+            "hits=%llu hit_bytes=%llu misses=%llu inserts=%llu updates=%llu "
+            "table_full=%llu forced_write=%llu forced_watch_unavailable=%llu "
+            "forced_watch_mode=%llu forced_bounds=%llu forced_dead=%llu "
+            "prequeries=%llu uncached_fail=%llu uncached_null=%llu "
+            "uncached_other_off=%llu uncached_no_stamp=%llu "
+            "invalidations=%llu released=%llu live=%u\n",
+            (unsigned long long)t_ms, (unsigned long long)frame_count,
+            (unsigned long long)interval_ms, (unsigned long long)st->calls,
+            (unsigned long long)st->hits, (unsigned long long)st->hit_bytes,
+            (unsigned long long)st->misses, (unsigned long long)st->inserts,
+            (unsigned long long)st->updates, (unsigned long long)st->table_full,
+            (unsigned long long)st->forced_write,
+            (unsigned long long)st->forced_watch_unavailable,
+            (unsigned long long)st->forced_watch_mode,
+            (unsigned long long)st->forced_bounds,
+            (unsigned long long)st->forced_dead,
+            (unsigned long long)st->prequeries,
+            (unsigned long long)st->uncached_fail,
+            (unsigned long long)st->uncached_null,
+            (unsigned long long)st->uncached_other_off,
+            (unsigned long long)st->uncached_no_stamp,
+            (unsigned long long)st->invalidations,
+            (unsigned long long)st->released, s_vp_frame_reuse.live_count);
+    fflush(stderr);
+    memset(st, 0, sizeof(*st));
+}
+
+/* *created (when requested) is the TJ-SNAPSHOT-PERF new/reuse split: refs == 1
+ * straight after the ordinary capture, before any table reference. */
+static int vp_snapshot_frame_reuse_capture(u32 off, u32 w, u32 h, u32 depth,
+        u32 fmt, u32 pitch, int cube, u32 dimension, u32 mips, int has_border,
+        VPTexSnapshot** out, int* created)
+{
+    extern u8* vm_base;
+    extern u32 ppu_vm_size;
+    VPSnapshotFrameReuseStats* st = &s_vp_frame_reuse.stats;
+    if (!out || vp_texture_write_watch_mode() != 1) {
+        /* Off has no stamps; Audit must keep comparing every byte. */
+        if (out) { ++st->calls; ++st->forced_watch_mode; }
+        const int plain = vp_capture_tex_snapshot_impl(off, w, h, depth, fmt,
+            pitch, cube, dimension, mips, has_border, out);
+        if (created) *created = plain >= 0 && out && *out && (*out)->refs == 1;
+        return plain;
+    }
+    ++st->calls;
+    const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ull << 32);
+    const u32 first = vp_snapshot_frame_reuse_hash(off, w, h, depth, fmt, pitch,
+                                                   cube, dimension, mips, has_border);
+    VPSnapshotFrameEntry* slot = NULL;
+    u32 slot_index = 0;
+    int found = 0;
+    for (u32 probe = 0; probe < VP_SNAPSHOT_FRAME_REUSE_PROBES; ++probe) {
+        const u32 index = (first + probe) & (VP_SNAPSHOT_FRAME_REUSE_SLOTS - 1u);
+        VPSnapshotFrameEntry* e = &s_vp_frame_reuse.entries[index];
+        if (!e->used) { slot = e; slot_index = index; break; }
+        if (vp_snapshot_frame_reuse_key_equal(e, off, w, h, depth, fmt, pitch,
+                                              cube, dimension, mips, has_border)) {
+            slot = e; slot_index = index; found = 1;
+            break;
+        }
+    }
+    /* This call's own pre-compare observation, when it made one. */
+    u64 pre_stamp = 0;
+    RsxTextureWriteStampHint pre_hint = {0};
+    if (found && slot->bytes &&
+        (!vm_base || (u64)off + slot->bytes > vm_cap ||
+         slot->bytes > VP_TEX_SNAPSHOT_SINGLE_MAX_BYTES ||
+         (slot->snapshot && slot->snapshot->bytes != slot->bytes))) {
+        ++st->forced_bounds;
+    } else if (found && slot->snapshot && slot->write_stamp) {
+        /* The same OS query/reset the ordinary capture runs at this point. */
+        pre_stamp = vp_texture_write_stamp(vm_base, vm_cap, off, slot->bytes,
+                                           &slot->stamp_hint);
+        if (pre_stamp && pre_stamp == slot->write_stamp) {
+            ++slot->snapshot->refs; /* the caller's, as on hint/hash reuse */
+            *out = slot->snapshot;
+            if (created) *created = 0;
+            ++st->hits;
+            st->hit_bytes += slot->bytes;
+            /* An unchanged-stamp reuse, like the hint path's watch hit, so
+             * watch_hits_total stays comparable with the flag off. */
+            ++s_vp_watch_hits;
+            s_vp_watch_bytes += slot->bytes;
+            return 0;
+        }
+        if (pre_stamp) ++st->forced_write;
+        else ++st->forced_watch_unavailable;
+        pre_hint = slot->stamp_hint;
+    } else if (found && slot->prequery && slot->bytes) {
+        /* The last result was owned by another offset: observe now, before
+         * the ordinary capture compares or copies anything. */
+        pre_stamp = vp_texture_write_stamp(vm_base, vm_cap, off, slot->bytes,
+                                           &slot->stamp_hint);
+        pre_hint = slot->stamp_hint;
+        ++st->prequeries;
+    } else if (found) {
+        ++st->forced_dead;
+    } else {
+        ++st->misses;
+    }
+
+    /* Ordinary capture, unchanged; it repeats its own query before it
+     * compares or copies. */
+    const int result = vp_capture_tex_snapshot_impl(off, w, h, depth, fmt, pitch,
+                                                    cube, dimension, mips,
+                                                    has_border, out);
+    VPTexSnapshot* snapshot = result == 0 ? *out : NULL;
+    if (created) *created = result >= 0 && *out && (*out)->refs == 1;
+    u64 stamp = 0;
+    RsxTextureWriteStampHint hint = {0};
+    int other_off = 0;
+    if (snapshot && !snapshot->is_override) {
+        if (snapshot->source_off == off) {
+            stamp = snapshot->source_write_stamp; /* this call's observation */
+            hint = snapshot->source_stamp_hint;
+        } else if (pre_stamp && found && slot->bytes == snapshot->bytes) {
+            stamp = pre_stamp;
+            hint = pre_hint;
+        } else {
+            other_off = 1;
+        }
+    }
+    if (result != 0) {
+        ++st->uncached_fail;
+    } else if (!snapshot) {
+        ++st->uncached_null;
+    } else if (other_off) {
+        ++st->uncached_other_off;
+    } else if (!stamp) {
+        ++st->uncached_no_stamp;
+    } else if (!slot || (!found &&
+               s_vp_frame_reuse.live_count >= VP_SNAPSHOT_FRAME_REUSE_MAX_LIVE)) {
+        ++st->table_full;
+        return result;
+    } else {
+        if (!found) {
+            vp_snapshot_frame_reuse_claim(slot, slot_index, off, w, h, depth, fmt,
+                                          pitch, cube, dimension, mips, has_border);
+            ++st->inserts;
+        } else {
+            ++st->updates;
+        }
+        if (slot->snapshot != snapshot) {
+            ++snapshot->refs; /* the table's own reference */
+            vp_texture_snapshot_release(&slot->snapshot);
+            slot->snapshot = snapshot;
+        }
+        slot->bytes = snapshot->bytes;
+        slot->write_stamp = stamp;
+        slot->stamp_hint = hint;
+        slot->prequery = 0;
+        return result;
+    }
+    /* Not cacheable now: an existing entry must stop vouching for its older
+     * snapshot. Another-offset results arm a pre-query for the next capture. */
+    if (!found && other_off && slot &&
+        s_vp_frame_reuse.live_count < VP_SNAPSHOT_FRAME_REUSE_MAX_LIVE) {
+        vp_snapshot_frame_reuse_claim(slot, slot_index, off, w, h, depth, fmt,
+                                      pitch, cube, dimension, mips, has_border);
+        found = 1;
+    }
+    if (found) {
+        vp_texture_snapshot_release(&slot->snapshot);
+        slot->write_stamp = 0;
+        if (other_off) {
+            slot->bytes = snapshot->bytes;
+            slot->prequery = 1;
+        } else {
+            slot->prequery = 0;
+        }
+    }
+    return result;
+}
+
+/* Opt-in record-time cost, independent of later GPU upload and fence work.
+ * TJ_DRAW_COST_TRACE wraps this outer host-call span; it does not change the
+ * snapshot function's result or reuse/new accounting. A non-NULL obs is a
+ * TJ_SNAPSHOT_PARALLEL apply (that option excludes TJ_SNAPSHOT_FRAME_REUSE). */
+static int vp_capture_tex_snapshot_obs(u32 off, u32 w, u32 h, u32 depth,
+                                   u32 fmt, u32 pitch, int cube, u32 dimension,
+                                   u32 mips, int has_border, VPTexSnapshot** out,
+                                   const VPSnapParObs* obs)
+{
+    int draw_cost_trace = tj_draw_cost_trace_enabled();
+    LONGLONG draw_cost_start = draw_cost_trace
+        ? tj_present_work_trace_sync_begin() : 0;
+    if (!tj_gcm2d_backend_perf_enabled()) {
+        int result = obs
+            ? vp_capture_tex_snapshot_impl_obs(off,w,h,depth,fmt,pitch,cube,
+                                               dimension,mips,has_border,out,obs)
+            : vp_snapshot_frame_reuse_enabled()
+            ? vp_snapshot_frame_reuse_capture(off,w,h,depth,fmt,pitch,cube,
+                                              dimension,mips,has_border,out,NULL)
+            : vp_capture_tex_snapshot_impl(off,w,h,depth,fmt,pitch,cube,
+                                           dimension,mips,has_border,out);
+        if (draw_cost_trace) {
+            if (result < 0) ++s_tj_present_work_trace.texture_snapshot_failures;
+            else if (out && *out)
+                s_tj_present_work_trace.texture_snapshot_bytes += (*out)->bytes;
+            tj_present_work_trace_sync_finish(draw_cost_start,
+                &s_tj_present_work_trace.texture_snapshot_ticks,
+                &s_tj_present_work_trace.texture_snapshot_calls);
+        }
+        return result;
+    }
+    static _Thread_local u64 epoch, ticks, calls, reuse_bytes, new_bytes, failures;
+    u64 begin = (u64)tj_gcm2d_backend_perf_now();
+    if (!epoch) epoch = begin;
+    int created = -1; /* set only by TJ_SNAPSHOT_FRAME_REUSE (see there) */
+    int result = obs
+        ? vp_capture_tex_snapshot_impl_obs(off,w,h,depth,fmt,pitch,cube,
+                                           dimension,mips,has_border,out,obs)
+        : vp_snapshot_frame_reuse_enabled()
+        ? vp_snapshot_frame_reuse_capture(off,w,h,depth,fmt,pitch,cube,
+                                          dimension,mips,has_border,out,&created)
+        : vp_capture_tex_snapshot_impl(off,w,h,depth,fmt,pitch,cube,
+                                       dimension,mips,has_border,out);
+    u64 end = (u64)tj_gcm2d_backend_perf_now();
+    ticks += end - begin;
+    ++calls;
+    if (result < 0) ++failures;
+    else if (out && *out) {
+        if (created >= 0 ? created : (*out)->refs == 1) new_bytes += (*out)->bytes;
+        else reuse_bytes += (*out)->bytes;
+    }
+    u64 window_us = tj_gcm2d_backend_perf_us(end - epoch);
+    if (window_us >= 1000000) {
+        fprintf(stderr, "[TJ-SNAPSHOT-PERF] window_us=%llu calls=%llu total_us=%llu "
+                "reuse_bytes=%llu new_bytes=%llu failures=%llu "
+                "watch_hits_total=%llu watch_bytes_total=%llu watch_mismatches_total=%llu\n",
+                (unsigned long long)window_us, (unsigned long long)calls,
+                (unsigned long long)tj_gcm2d_backend_perf_us(ticks),
+                (unsigned long long)reuse_bytes, (unsigned long long)new_bytes,
+                (unsigned long long)failures,
+                (unsigned long long)s_vp_watch_hits,
+                (unsigned long long)s_vp_watch_bytes,
+                (unsigned long long)s_vp_watch_mismatches);
+        epoch=end; ticks=calls=reuse_bytes=new_bytes=failures=0;
+    }
+    if (draw_cost_trace) {
+        if (result < 0) ++s_tj_present_work_trace.texture_snapshot_failures;
+        else if (out && *out)
+            s_tj_present_work_trace.texture_snapshot_bytes += (*out)->bytes;
+        tj_present_work_trace_sync_finish(draw_cost_start,
+            &s_tj_present_work_trace.texture_snapshot_ticks,
+            &s_tj_present_work_trace.texture_snapshot_calls);
+    }
+    return result;
+}
+
+static int vp_capture_tex_snapshot(u32 off, u32 w, u32 h, u32 depth,
+                                   u32 fmt, u32 pitch, int cube, u32 dimension,
+                                   u32 mips, int has_border, VPTexSnapshot** out)
+{
+    return vp_capture_tex_snapshot_obs(off, w, h, depth, fmt, pitch, cube,
+                                       dimension, mips, has_border, out, NULL);
+}
+
+#ifdef PS3RECOMP_PROMPT_ART
+/* ---------------------------------------------------------------------------
+ * PC key prompts in the game's UI atlases (rsx_prompt_atlas.c draws the key
+ * caps; cellPad_prompt_keys gives the bound keys).
+ *
+ * Record time, fragment units only: when a captured snapshot's content hash
+ * is a known button atlas, the draw record gets an override snapshot instead:
+ * a copy of the atlas whose prompt cells show the bound PC keys, in the same
+ * guest format and byte layout. Replay, the upload cache and prefix
+ * ownership see an ordinary immutable snapshot; the new pointer misses
+ * VP_TEX_SLOT_EXACT_HIT once, uploads once, then hits.
+ *
+ * Ownership (record/replay thread, like every other snapshot reference):
+ *  - an atlas entry holds a strong reference on the last matched original,
+ *    so the atlas is never copied and hashed again after the retention pool
+ *    evicts it, and on up to two override variants (current and previous
+ *    key set, so a keyboard/controller flip back costs no rebuild);
+ *  - original->prompt_override is a WEAK cache, valid only while
+ *    original->prompt_sig equals the latched signature. Only an entry's
+ *    current original carries it; it is cleared when the entry lets that
+ *    original go, and every resolve clears it before a variant is evicted;
+ *  - overrides (is_override) never enter the content buckets, the hint
+ *    table or the retention pool; their bytes are charged to the snapshot
+ *    budget after the usual trim; a full budget (or no memory) keeps the
+ *    original art and the build is retried TJ_PROMPT_RETRY_PRESENTS later.
+ *
+ * The signature is latched once per final present (render_frame after its
+ * FIFO-prefix early return, next to the F1 overlay pass) and held while the
+ * F1/F2 screen is open. Signature 0 = original PS3 art. Per draw this costs one compare
+ * of snapshot->prompt_sig; each snapshot is checked against the atlas
+ * hashes once per signature. The bound shape (format, size) is checked per
+ * draw of a matched atlas, because snapshots are shared by content.
+ * -----------------------------------------------------------------------*/
+#include "rsx_prompt_atlas.h"
+
+#define TJ_PROMPT_MAX_ATLASES 8u
+#define TJ_PROMPT_VARIANTS 2u
+_Static_assert(PAD_PROMPT_BUTTON_COUNT == CELL_PAD_PROMPT_ACTIONS,
+               "pad_prompt_art and cellPad action order");
+
+typedef struct TjPromptEntry {
+    VPTexSnapshot* original;                    /* strong */
+    VPTexSnapshot* var[TJ_PROMPT_VARIANTS];     /* strong; [0] most recent */
+    u64 var_sig[TJ_PROMPT_VARIANTS];
+    u32 failures;                               /* patch errors in a row; 3 = PS3 art */
+    u32 retry_at;                               /* present count (budget/memory wait) */
+    u8 retry_wait;
+    u8 matched_logged, shape_logged;
+} TjPromptEntry;
+
+typedef struct TjPromptLatch {
+    volatile LONG64 sig;
+    int vks[CELL_PAD_PROMPT_ACTIONS];
+} TjPromptLatch;
+
+static TjPromptEntry s_tj_prompt_entries[TJ_PROMPT_MAX_ATLASES];
+static TjPromptLatch s_tj_prompt_latches[2];   /* the latch writes the other one */
+static volatile LONG s_tj_prompt_latch_index;
+static volatile LONG64 s_tj_prompt_sig;        /* latched signature, 0 = PS3 art */
+static u32 s_tj_prompt_latch_logs;
+static u32 s_tj_prompt_presents;               /* final presents seen by the latch */
+#define TJ_PROMPT_RETRY_PRESENTS 60u           /* wait after a budget/memory failure */
+
+/* Other button-prompt atlases from the research inventory. Not redrawn yet;
+ * matched only to log (once each) that this US build really draws them. */
+static const struct { const char* name; u64 hash; u32 w, h; } k_tj_prompt_watch[] = {
+    {"gameTexPack.pac[12] (round pause-window icons)", 0xBA5345544AC8043Cull, 1024u, 464u},
+    {"gameTexPack_EN.pac[12] (Controls screen)",       0x8979F38AD7A36B9Dull, 1280u, 720u},
+    {"gameTexPack_EN.pac[2] (HUD SELECT/START plates)", 0xB938B14BE0E52850ull, 2048u, 1024u},
+    {"gameTexPack_EN.pac[8] (NEXT)",                    0x71CF4B9F68FB48C6ull, 1024u, 2088u},
+    {"gameTexPack_EN.pac[9] (item window icons)",       0xF9A4078C105B5285ull, 1024u, 1108u},
+    {"gameTexPack.pac[10] (JP action banners)",         0x7FC07FB666B78C84ull, 512u, 1408u},
+    {"titleTexPack_EN.pac[2] (R1 Fast Forward)",        0x65FB2F122C9AE4FDull, 1920u, 1080u},
+    {"titleTexPack.pac[9] (Triangle, EXIT START)",      0x95E5723C87D71341ull, 512u, 512u},
+    {"titleTexPack.pac[12] (JP R1 plate)",              0xC41E4E2849DE819Full, 1024u, 768u},
+    {"map_info_EN.gtf (map Triangle/L1/R1/D-pad)",      0x5D05224F82ED0B9Bull, 780u, 512u},
+    {"map_info2_EN.gtf (map SELECT)",                   0x84EC2F5CC79D3846ull, 340u, 2000u},
+};
+static u8 s_tj_prompt_watch_logged[sizeof(k_tj_prompt_watch) / sizeof(k_tj_prompt_watch[0])];
