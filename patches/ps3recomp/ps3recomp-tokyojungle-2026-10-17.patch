+static void tj_compose_capture_before_draw(u32 d, u32 selected_display_raw,
+                                           int selected_display_valid)
+{
+    if (!s_tj_compose_capture.active || s_tj_compose_capture.alias_active ||
+        s_tj_compose_capture.copy_active || s_tj_main_prov.active) return;
+    if (tj_compose_target_enabled()) {
+        for (u32 n = 0; n < s_tj_compose_target_count && n < 2; ++n) {
+            if (d != s_tj_compose_target_ordinal[n]) continue;
+            int ds = tj_compose_capture_selected_surface(s_tj_compose_target_raw[n], 1);
+            if (ds >= 0) {
+                DisplaySurface* s = &s_d3d.display_surface[ds];
+                char name[48];
+                snprintf(name, sizeof(name), "fp%08X_%u_before_op%03u",
+                         s_tj_compose_target_fp, n, d);
+                tj_compose_capture_queue(name, s->res, 0, 0, s->w, s->h,
+                                         DXGI_FORMAT_R8G8B8A8_UNORM, s->st);
+            }
+        }
+        return;
+    }
+    if (d == 87 || d == 90) {
+        char name[48];
+        snprintf(name, sizeof(name), "live_before_op%03u", d);
+        int ds = tj_compose_capture_selected_surface(selected_display_raw,
+                                                     selected_display_valid);
+        if (ds >= 0) {
+            DisplaySurface* s = &s_d3d.display_surface[ds];
+            tj_compose_capture_queue(name, s->res, 0, 0, s->w, s->h,
+                                     DXGI_FORMAT_R8G8B8A8_UNORM, s->st);
+        } else {
+            fprintf(stderr, "[TJ-COMPOSE-CAP] %s omitted=display-surface-unavailable\n", name);
+        }
+    }
+    if (d != 97) return;
+
+    int base = off_rt_find(0x0E300000u, 1);
+    if (base >= 0) {
+        OffRT* r = &s_d3d.off_rt[base];
+        tj_compose_capture_queue("offrt_0E300000_before_op097", r->res, 0, 0,
+                                 r->w, r->h, r->dxgi, r->st);
+        u32 tex_fmt = r->dxgi == DXGI_FORMAT_R16G16B16A16_FLOAT ? 0x9Au :
+                      r->dxgi == DXGI_FORMAT_R32G32B32A32_FLOAT ? 0x9Bu :
+                      r->dxgi == DXGI_FORMAT_R32_FLOAT ? 0x9Cu : 0x85u;
+        int parent = -1; u32 x = 0, y = 0;
+        if (off_rt_find_packed_view(0x0E301000u, 1, 320, 180, tex_fmt,
+                                    &parent, &x, &y) == 0) {
+            OffRT* p = &s_d3d.off_rt[parent];
+            tj_compose_capture_queue("offrt_0E301000_320x180_before_op097",
+                                     p->res, x, y, 320, 180, p->dxgi, p->st);
+        } else {
+            fprintf(stderr, "[TJ-COMPOSE-CAP] offrt_0E301000 omitted=view-unresolved\n");
+        }
+    } else {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] offrt_0E300000 omitted=base-unresolved\n");
+    }
+    for (int i = 0; i < MAX_DISPLAY_HISTORY; ++i) {
+        DisplayHistory* h = &s_d3d.display_history[i];
+        if (h->res && h->raw == 0x00740000u) {
+            tj_compose_capture_queue("history_00740000_before_op097", h->res,
+                                     0, 0, h->w, h->h,
+                                     DXGI_FORMAT_R8G8B8A8_UNORM, h->st);
+            return;
+        }
+    }
+    fprintf(stderr, "[TJ-COMPOSE-CAP] history_00740000 omitted=unallocated\n");
+}
+
+static void tj_compose_capture_after_draw(u32 d, u32 selected_display_raw,
+                                          int selected_display_valid)
+{
+    if (!s_tj_compose_capture.active || s_tj_compose_capture.alias_active ||
+        s_tj_compose_capture.copy_active || s_tj_main_prov.active) return;
+    if (tj_compose_target_enabled()) {
+        for (u32 n = 0; n < s_tj_compose_target_count; ++n) {
+            if (d != s_tj_compose_target_ordinal[n]) continue;
+            int ds = tj_compose_capture_selected_surface(s_tj_compose_target_raw[n], 1);
+            if (ds >= 0) {
+                DisplaySurface* s = &s_d3d.display_surface[ds];
+                char name[48];
+                snprintf(name, sizeof(name), "fp%08X_%u_after_op%03u",
+                         s_tj_compose_target_fp, n, d);
+                tj_compose_capture_queue(name, s->res, 0, 0, s->w, s->h,
+                                         DXGI_FORMAT_R8G8B8A8_UNORM, s->st);
+            }
+        }
+        return;
+    }
+    if (d != 97 && d != 98) return;
+    char name[48];
+    snprintf(name, sizeof(name), "live_after_op%03u", d);
+    int ds = tj_compose_capture_selected_surface(selected_display_raw,
+                                                 selected_display_valid);
+    if (ds >= 0) {
+        DisplaySurface* s = &s_d3d.display_surface[ds];
+        tj_compose_capture_queue(name, s->res, 0, 0, s->w, s->h,
+                                 DXGI_FORMAT_R8G8B8A8_UNORM, s->st);
+    } else {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] %s omitted=display-surface-unavailable\n", name);
+    }
+}
