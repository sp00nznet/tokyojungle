+/* Alias mode samples the dynamically last raw-740 consumer.  These are
+ * existing resources only: no materialisation or replay state changes. */
+static void tj_compose_capture_alias_surface(const char* name, int slot)
+{
+    if (slot < 0 || slot >= MAX_DISPLAY_SURFACES) return;
+    DisplaySurface* s = &s_d3d.display_surface[slot];
+    if (s->res)
+        tj_compose_capture_queue(name, s->res, 0, 0, s->w, s->h,
+                                 DXGI_FORMAT_R8G8B8A8_UNORM, s->st);
+}
+
+static void tj_compose_capture_alias_history(const char* name)
+{
+    int slot = s_tj_compose_capture.history_slot;
+    if (slot < 0 || slot >= MAX_DISPLAY_HISTORY) return;
+    DisplayHistory* h = &s_d3d.display_history[slot];
+    if (h->res)
+        tj_compose_capture_queue(name, h->res, 0, 0, h->w, h->h,
+                                 DXGI_FORMAT_R8G8B8A8_UNORM, h->st);
+}
+
+static void tj_compose_capture_alias_boundary(const char* phase)
+{
+    char name[48];
+    if (!s_tj_compose_capture.alias_active) return;
+    snprintf(name, sizeof(name), "alias_parent0_%s", phase);
+    tj_compose_capture_alias_surface(name, s_tj_compose_capture.parent_slot[0]);
+    snprintf(name, sizeof(name), "alias_parent1_%s", phase);
+    tj_compose_capture_alias_surface(name, s_tj_compose_capture.parent_slot[1]);
+    snprintf(name, sizeof(name), "alias_history_740_%s", phase);
+    tj_compose_capture_alias_history(name);
+    snprintf(name, sizeof(name), "alias_selected_%s", phase);
+    tj_compose_capture_alias_surface(name, s_tj_compose_capture.selected_slot);
+}
