+/* Serial unless enabled and the draw is large enough. */
+static void vp_convert_range(const rsx_state* state, u32 first, VPSlot* out,
+                             u32 count, int indexed)
+{
+    VPVertexPlan storage;
+    const VPVertexPlan* plan = NULL;
+    if (count && vp_vertex_plan_enabled()) {
+        vp_vertex_plan_init(&storage, state);
+        plan = &storage;
+    }
+    static volatile LONG busy;   /* one pooled job at a time; others stay serial */
+    if (count >= VP_PAR_MIN_VERTS && s_vp_par_workers != 0 &&
+        InterlockedCompareExchange(&busy, 1, 0) == 0) {
+        if (vp_par_init() <= 0) {
+            InterlockedExchange(&busy, 0);
+            goto serial;
+        }
+        VPParJob* j = &s_vp_par_job;
+        j->state = state; j->out = out; j->first = first; j->count = count;
+        j->plan = plan;
+        j->indexed = (u32)indexed; j->attr_mask = s_tj_vp_upload_attr_mask;
+        j->next_chunk = 0;
+        /* The caller runs chunks too: wake at most one helper per extra chunk. */
+        const u32 chunks = (count + VP_PAR_CHUNK - 1u) / VP_PAR_CHUNK;
+        const int helpers = (u32)s_vp_par_workers < chunks - 1u
+                          ? s_vp_par_workers : (int)(chunks - 1u);
+        j->pending = helpers;
+        for (int i = 0; i < helpers; ++i) SetEvent(s_vp_par_wake[i]);
+        vp_par_run(j);
+        if (helpers > 0) WaitForSingleObject(s_vp_par_done, INFINITE);
+        InterlockedExchange(&busy, 0);
+        s_vp_par_draws++; s_vp_par_verts += count;
+        if ((s_vp_par_draws & 0x3FFFu) == 1)
+            fprintf(stderr, "[tj-vertex-parallel] draws=%llu verts=%llu\n",
+                    (unsigned long long)s_vp_par_draws, (unsigned long long)s_vp_par_verts);
+        return;
+    }
+serial:
+    for (u32 k = 0; k < count; ++k) {
+        const u32 vi = indexed ? read_guest_index(state, first + k) : first + k;
+        if (plan) read_vp_vertex_planned(plan, vi, &out[k * 16]);
+        else read_vp_vertex(state, vi, &out[k * 16]);
+    }
+}
