+int rsx_d3d12_backend_exact_blit_capture_enabled(void)
+{
+    /* NV3089 asks before every non-swizzled CPU transfer into guest memory,
+     * with no texture capture in between: a TJ_WATCH_BATCH pass boundary. */
+    VP_SNAP_PAR_BARRIER(BLIT);
+    vp_watch_batch_arm();
+    return s_d3d.initialized && !s_d3d.gcm2d_backend_halted;
+}
+
+void rsx_d3d12_backend_note_exact_blit_fault(void)
+{
+    VP_SNAP_PAR_BARRIER(BLIT);
+    if (s_d3d.initialized) gcm2d_backend_halt("CPU exact copy not mirrored");
+}
+
+void rsx_d3d12_backend_trace_texture_read_prefix(void)
+{
+    if (!tj_gcm2d_backend_perf_enabled()) return;
+    VP_SNAP_PAR_BARRIER(LABEL); /* reads record snapshots */
+    /* Coverage only, not permission to bypass a semaphore. GPU authority,
+     * record-buffer capacity and later guest observations still need proof. */
+    static u64 begin_ms, releases, empty, outstanding, snapshot_only;
+    static u64 gpu_inputs, missing_inputs, other_records, invalid_programs;
+    const u64 now = GetTickCount64();
+    if (!begin_ms) begin_ms = now;
+    ++releases;
+    if (!s_d3d.draw_count) ++empty;
+    if (s_d3d.fifo_prefix_outstanding) ++outstanding;
+    int gpu = 0, missing = 0, other = 0, invalid = 0;
+    for (u32 i = 0; i < s_d3d.draw_count && i < MAX_DRAWS; ++i) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[i];
+        if (!dr->is_vp || dr->is_clear || dr->is_scaled_blit) {
+            other = 1;
+            continue;
+        }
+        if (!dr->fp_program_valid) invalid = 1;
+        const u32 mask = dr->fp_program_valid
+            ? dr->fp_program.texture_read_mask | 1u : 0xFFFFu;
+        for (u32 u = 0; u < RSX_MAX_TEXTURES; ++u) {
+            if (!(mask & (1u << u)) || !dr->tex[u].set) continue;
+            if (vp_record_texture_is_gpu_owned(dr, dr->tex[u].raw, dr->tex[u].location)) gpu = 1;
+            else if (!dr->tex_snapshot[u] || (dr->tex_snapshot_fault_mask & (1u << u))) missing = 1;
+        }
+        for (u32 u = 0; u < RSX_MAX_VERTEX_TEXTURES; ++u) {
+            if (!dr->vtex[u].set) continue;
+            if (vp_record_texture_is_gpu_owned(dr, dr->vtex[u].raw, dr->vtex[u].location)) gpu = 1;
+            else if (!dr->vtex_snapshot[u] || (dr->vtex_snapshot_fault_mask & (1u << u))) missing = 1;
+        }
+    }
+    gpu_inputs += gpu; missing_inputs += missing;
+    other_records += other; invalid_programs += invalid;
+    if (s_d3d.draw_count && !gpu && !missing && !other && !invalid &&
+        !s_d3d.fifo_prefix_outstanding) ++snapshot_only;
+    if (now - begin_ms >= 1000) {
+        fprintf(stderr, "[TJ-TEXTURE-READ-COVERAGE] window_ms=%llu releases=%llu empty=%llu "
+                "outstanding=%llu snapshot_only=%llu gpu_inputs=%llu missing_inputs=%llu "
+                "other_records=%llu invalid_programs=%llu\n",
+                (unsigned long long)(now - begin_ms), (unsigned long long)releases,
+                (unsigned long long)empty, (unsigned long long)outstanding,
