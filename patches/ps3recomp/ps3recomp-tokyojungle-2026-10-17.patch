+static int off_rt_view_get(int parent, u32 x, u32 y, u32 w, u32 h)
+{
+    if (parent < 0 || parent >= MAX_OFF_RTS || !w || !h) return -1;
+    OffRT* source = &s_d3d.off_rt[parent];
+    if (!source->res || (u64)x + w > source->w || (u64)y + h > source->h)
+        return -1;
+    for (int i = 0; i < MAX_OFF_RT_VIEWS; i++) {
+        OffRTView* v = &s_d3d.off_rt_view[i];
+        if (v->res && v->parent == parent && v->x == x && v->y == y &&
+            v->w == w && v->h == h && v->dxgi == source->dxgi) {
+            v->used = 1;
+            return i;
+        }
+    }
+    int slot = -1;
+    for (int i = 0; i < MAX_OFF_RT_VIEWS; i++)
+        if (!s_d3d.off_rt_view[i].res) { slot = i; break; }
+    if (slot < 0) {
+        for (int i = 0; i < MAX_OFF_RT_VIEWS; i++)
+            if (!s_d3d.off_rt_view[i].used) { slot = i; break; }
+        if (slot < 0) return -1;
+        s_d3d.off_rt_view[slot].res->lpVtbl->Release(s_d3d.off_rt_view[slot].res);
+        s_d3d.off_rt_view[slot].res = NULL;
+    }
+
+    OffRTView* v = &s_d3d.off_rt_view[slot];
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w; td.Height = h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = (DXGI_FORMAT)source->dxgi;
+    td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&v->res)))
+        return -1;
+    v->parent = parent;
+    v->x = x; v->y = y; v->w = w; v->h = h;
+    v->dxgi = source->dxgi;
+    v->st = D3D12_RESOURCE_STATE_COPY_DEST;
+    v->used = 1;
+    return slot;
+}
+
+/* Write a texture SRV (or a null SRV when res == NULL) at an absolute SRV
+ * heap slot. Used to fill per-draw t0-t15 descriptor windows. */
+static void srv_write_dimension(u32 heap_slot, ID3D12Resource* res,
+                                DXGI_FORMAT fmt, UINT mapping,
+                                u32 mip_count, u32 dimension, int cube)
+{
+    if (d3d12_prefix_owner_object_capture(res) != 0) return;
+    /* TJ_NULL_SRV_REUSE_BEGIN */
+    u8* cached_default_null = NULL;
+    const int default_null_2d = !res && fmt == DXGI_FORMAT_R8G8B8A8_UNORM &&
+        mapping == D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING &&
+        (mip_count == 0 || mip_count == 1) && !cube &&
+        dimension != 1u && dimension != 3u;
+    if (heap_slot >= DRAW_SRV_BASE && heap_slot < SRV_HEAP_SIZE) {
+        const u32 draw_slot = heap_slot - DRAW_SRV_BASE;
+        if (!s_d3d.prefix_owner_active) {
+            cached_default_null = &s_d3d.draw_null_srv_cached[draw_slot];
+        } else if (s_d3d.prefix_owner_active <= 2) {
+            D3D12PrefixOwner* owner =
+                &s_d3d.prefix_owners[s_d3d.prefix_owner_active - 1];
+            if (owner->srv_heap == s_d3d.srv_heap)
+                cached_default_null = &owner->draw_null_srv_cached[draw_slot];
+        }
+    }
+    if (cached_default_null) {
+        if (default_null_2d) {
+            if (*cached_default_null) return;
+        } else {
+            *cached_default_null = 0;
+        }
+    }
+    /* TJ_NULL_SRV_REUSE_END */
+    LONGLONG descriptor_mark = tj_gcm2d_backend_perf_subphase_begin();
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = fmt;
+    sv.Shader4ComponentMapping = mapping;
+    if (!mip_count) mip_count = 1;
+    if (cube) {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+        sv.TextureCube.MostDetailedMip = 0;
+        sv.TextureCube.MipLevels = mip_count;
+        sv.TextureCube.ResourceMinLODClamp = 0.0f;
+    } else if (dimension == 1u) {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE1D;
+        sv.Texture1D.MostDetailedMip = 0;
+        sv.Texture1D.MipLevels = mip_count;
+        sv.Texture1D.ResourceMinLODClamp = 0.0f;
+    } else if (dimension == 3u) {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE3D;
+        sv.Texture3D.MostDetailedMip = 0;
+        sv.Texture3D.MipLevels = mip_count;
+        sv.Texture3D.ResourceMinLODClamp = 0.0f;
+    } else {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sv.Texture2D.MostDetailedMip = 0;
+        sv.Texture2D.MipLevels = mip_count;
+        sv.Texture2D.ResourceMinLODClamp = 0.0f;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &h);
+    h.ptr += (u64)heap_slot * s_d3d.srv_inc;
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, res, &sv, h);
+    /* TJ_NULL_SRV_REUSE_BEGIN */
+    if (cached_default_null && default_null_2d) *cached_default_null = 1;
+    /* TJ_NULL_SRV_REUSE_END */
+    if (s_tj_gcm2d_backend_perf_sample) {
+        tj_gcm2d_backend_perf_subphase_end(
+            &s_tj_gcm2d_backend_perf_sample->descriptor_ticks, descriptor_mark);
+        ++s_tj_gcm2d_backend_perf_sample->descriptor_calls;
+    }
+}
+
+static void srv_write_ex(u32 heap_slot, ID3D12Resource* res, DXGI_FORMAT fmt,
+                         UINT mapping, u32 mip_count, int cube)
+{
+    srv_write_dimension(heap_slot, res, fmt, mapping, mip_count, 2u, cube);
+}
+
+static void srv_write(u32 heap_slot, ID3D12Resource* res, DXGI_FORMAT fmt,
+                      UINT mapping)
+{
+    srv_write_ex(heap_slot, res, fmt, mapping, 1, 0);
+}
+
+static int off_rt_sample_ensure(int slot)
+{
+    if (slot < 0 || slot >= MAX_OFF_RTS) return -1;
+    OffRT* r = &s_d3d.off_rt[slot];
+    if (r->sample) return 0;
+    if (!r->res) return -1;
+
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = r->w;
+    td.Height = r->h;
+    td.DepthOrArraySize = 1;
+    td.MipLevels = 1;
+    td.Format = (DXGI_FORMAT)r->dxgi;
+    td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&r->sample)))
+        return -1;
+    r->sample_st = D3D12_RESOURCE_STATE_COPY_DEST;
+    return 0;
+}
+
+static int display_sample_ensure(void)
+{
+    if (s_d3d.display_sample) return 0;
+
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = s_d3d.width;
+    td.Height = s_d3d.height;
+    td.DepthOrArraySize = 1;
+    td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+
+    HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(
+        s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+        D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+        &IID_ID3D12Resource, (void**)&s_d3d.display_sample);
+    if (FAILED(hr)) {
+        printf("[D3D12] display-buffer sample texture creation failed (0x%08lX)\n", hr);
+        return -1;
+    }
+    s_d3d.display_sample_state = D3D12_RESOURCE_STATE_COPY_DEST;
+    printf("[D3D12] display-buffer snapshot enabled (%ux%u)\n",
+           s_d3d.width, s_d3d.height);
+    return 0;
+}
+
+/* Preserve RSX ordering when a draw samples a registered display buffer.
+ * Hardware has two local-memory display surfaces; the compact backend aliases
+ * both to one swap-chain buffer.  Copying the current contents before the draw
+ * reproduces the read-old-buffer/write-new-buffer post-process dependency and
+ * avoids binding one resource as both RTV and SRV. */
+static void display_sample_snapshot(u32 frame_index)
+{
+    if (display_sample_ensure() != 0) return;
+
+    { static unsigned traced = 0;
+      if (traced++ < 16)
+          printf("[D3D12] display-buffer snapshot #%u (swap=%u)\n",
+                 traced, frame_index); }
+
+    D3D12_RESOURCE_BARRIER before[2] = {0};
+    UINT n = 0;
+    if (s_d3d.display_sample_state != D3D12_RESOURCE_STATE_COPY_DEST) {
+        before[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        before[n].Transition.pResource = s_d3d.display_sample;
+        before[n].Transition.StateBefore = s_d3d.display_sample_state;
+        before[n].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        before[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        n++;
+    }
+    before[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    before[n].Transition.pResource = s_d3d.render_targets[frame_index];
+    before[n].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    before[n].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    before[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    n++;
+    d3d12_owned_barriers(n, before);
+
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = s_d3d.display_sample;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.SubresourceIndex = 0;
+    src.pResource = s_d3d.render_targets[frame_index];
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.SubresourceIndex = 0;
+    d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, NULL);
+
+    D3D12_RESOURCE_BARRIER after[2] = {0};
+    after[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    after[0].Transition.pResource = s_d3d.render_targets[frame_index];
+    after[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    after[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    after[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    after[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    after[1].Transition.pResource = s_d3d.display_sample;
+    after[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    after[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    after[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    d3d12_owned_barriers(2, after);
+    s_d3d.display_sample_state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+}
+
+/* Lazily allocate one persistent completed-frame image per display raw
+ * identity. A newly seen history starts black; it becomes valid only when the
+ * current completed backbuffer is committed at frame end. */
+static int display_history_get(const CellGcmDisplayInfo* info)
+{
+    if (!info || !info->width || !info->height || !s_d3d.rt_rtv_heap) return -1;
+    int slot = -1;
+    for (int i = 0; i < MAX_DISPLAY_HISTORY; i++) {
+        DisplayHistory* h = &s_d3d.display_history[i];
+        if (!h->res) { if (slot < 0) slot = i; continue; }
+        if (h->raw == info->offset && h->pitch == info->pitch &&
+            h->w == info->width && h->h == info->height)
+            return i;
+    }
+    if (slot < 0) return -1;
+
+    DisplayHistory* h = &s_d3d.display_history[slot];
+    /* TJ_RENDER_SCALE: history mirrors its display at the display's host
+     * scale; raw/pitch/w/h keep the guest identity. */
+    const u8 scale = rs_display_geometry_scale(info->width, info->height);
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = (u64)info->width * scale; td.Height = info->height * scale;
+    td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = td.Format;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_RENDER_TARGET, &cv,
+            &IID_ID3D12Resource, (void**)&h->res)))
+        return -1;
+    h->raw = info->offset; h->pitch = info->pitch;
+    h->w = info->width; h->h = info->height;
+    h->scale = scale;
+    h->st = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    h->valid = 0;
+    { extern int cellGcmOffsetIsDisplay(u32 offset);
+      h->history_alias = !cellGcmOffsetIsDisplay(info->offset); }
+    d3d12_owned_rtv(h->res, NULL, display_history_rtv(slot));
+    const float black[4] = {0, 0, 0, 1};
+    s_d3d.cmd_list->lpVtbl->ClearRenderTargetView(
+        s_d3d.cmd_list, display_history_rtv(slot), black, 0, NULL);
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = h->res;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    d3d12_owned_barriers(1, &b);
+    h->st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    { static unsigned traced = 0;
+      if (traced++ < 16)
+          printf("[D3D12] display history raw=0x%X slot=%d %ux%u\n",
+                 h->raw, slot, h->w, h->h); }
+    return slot;
+}
+
+/* Discover strict next-stride aliases before committing a completed display.
+ * The consumer can occur in the next FIFO batch, before it has a chance to
+ * lazily allocate its history resource; allocation must therefore precede the
+ * one completed-frame copy below. Metadata alone never makes an alias valid. */
+static void display_history_prepare_strict_aliases(void)
+{
+    extern int cellGcmOffsetIsDisplay(u32 offset);
+    for (u32 first = 0; first < CELL_GCM_MAX_DISPLAY_BUFFER_NUM; ++first) {
+        const CellGcmDisplayInfo* a = cellGcmGetDisplayBufferByFlipIndex(first);
+        if (!a || !a->pitch || !a->width || !a->height ||
+            !cellGcmOffsetIsDisplay(a->offset))
+            continue;
+        for (u32 second = 0; second < CELL_GCM_MAX_DISPLAY_BUFFER_NUM; ++second) {
+            const CellGcmDisplayInfo* b = cellGcmGetDisplayBufferByFlipIndex(second);
+            if (!b || !b->pitch || !b->width || !b->height ||
+                !cellGcmOffsetIsDisplay(b->offset) || b->offset <= a->offset ||
+                b->pitch != a->pitch || b->width != a->width || b->height != a->height)
+                continue;
+            u64 alias_raw = (u64)b->offset + ((u64)b->offset - a->offset);
+            if (alias_raw > UINT32_MAX) continue;
+            CellGcmDisplayInfo alias = *a;
+            CellGcmDisplayInfo parent[2] = {{0}};
+            alias.offset = (u32)alias_raw;
+            if (!cellGcmGetDisplayHistoryAliasParents(alias.offset, alias.pitch,
+                    alias.width, alias.height, &parent[0], &parent[1]) ||
+                parent[0].offset != a->offset || parent[1].offset != b->offset ||
+                parent[0].pitch != a->pitch || parent[1].pitch != b->pitch ||
+                parent[0].width != a->width || parent[1].width != b->width ||
+                parent[0].height != a->height || parent[1].height != b->height)
+                continue;
+            /* display_history_get deduplicates identity and refuses pool overflow. */
+            (void)display_history_get(&alias);
+        }
+    }
+}
+
+/* Commit only the display identity that actually completed this frame. Strict
+ * unregistered next-stride history identities intentionally track every frame;
+ * inactive registered slots retain their own prior contents. At 1x the source
+ * is the swap-chain image, left in COPY_SOURCE. With TJ_RENDER_SCALE the swap
+ * chain is output only: copy the selected display surface at its host size
+ * through its own state tracker and leave the backbuffer state untouched. */
+static int display_history_commit(u32 frame_index, u32 completed_raw,
+                                  int completed_valid,
+                                  D3D12_RESOURCE_STATES source_state,
+                                  int source_display)
+{
+    int count = 0;
+    if (!completed_valid) return 0;
+    for (int i = 0; i < MAX_DISPLAY_HISTORY; i++) {
+        DisplayHistory* h = &s_d3d.display_history[i];
+        if (h->res && (h->raw == completed_raw || h->history_alias)) count++;
+    }
+    if (!count) return 0;
+    const DisplaySurface* display = NULL;
+    if (s_d3d.scale > 1) {
+        if (source_display < 0 || source_display >= MAX_DISPLAY_SURFACES ||
+            !s_d3d.display_surface[source_display].res)
+            return 0;
+        display = &s_d3d.display_surface[source_display];
+        display_surface_transition(source_display, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    }
+
+    D3D12_RESOURCE_BARRIER before[1 + MAX_DISPLAY_HISTORY] = {0};
+    UINT n = 0;
+    if (!display) {
+        before[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        before[n].Transition.pResource = s_d3d.render_targets[frame_index];
+        before[n].Transition.StateBefore = source_state;
+        before[n].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        before[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        n++;
+    }
+    for (int i = 0; i < MAX_DISPLAY_HISTORY; i++) {
+        DisplayHistory* h = &s_d3d.display_history[i];
+        if (!h->res || !(h->raw == completed_raw || h->history_alias) ||
+            h->st == D3D12_RESOURCE_STATE_COPY_DEST) continue;
+        before[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        before[n].Transition.pResource = h->res;
+        before[n].Transition.StateBefore = h->st;
+        before[n].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        before[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        n++;
+    }
+    if (n) d3d12_owned_barriers(n, before);
+
+    for (int i = 0; i < MAX_DISPLAY_HISTORY; i++) {
+        DisplayHistory* h = &s_d3d.display_history[i];
+        if (!h->res || !(h->raw == completed_raw || h->history_alias)) continue;
+        u32 w, hgt;
+        if (display) {
+            const u32 source_w = display->w * rs_factor(display->scale);
+            const u32 source_h = display->h * rs_factor(display->scale);
+            const u32 history_w = h->w * rs_factor(h->scale);
+            const u32 history_h = h->h * rs_factor(h->scale);
+            w = history_w < source_w ? history_w : source_w;
+            hgt = history_h < source_h ? history_h : source_h;
+        } else {
+            w = h->w < s_d3d.width ? h->w : s_d3d.width;
+            hgt = h->h < s_d3d.height ? h->h : s_d3d.height;
+        }
+        D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+        dst.pResource = h->res;
+        dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        src.pResource = display ? display->res : s_d3d.render_targets[frame_index];
+        src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_BOX box = {0, 0, 0, w, hgt, 1};
+        d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, &box);
+        h->valid = 1;
+    }
+
+    D3D12_RESOURCE_BARRIER after[MAX_DISPLAY_HISTORY] = {0};
+    n = 0;
+    for (int i = 0; i < MAX_DISPLAY_HISTORY; i++) {
+        DisplayHistory* h = &s_d3d.display_history[i];
+        if (!h->res || !(h->raw == completed_raw || h->history_alias)) continue;
+        after[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        after[n].Transition.pResource = h->res;
+        after[n].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        after[n].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        after[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        n++;
+        h->st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    }
+    if (n) d3d12_owned_barriers(n, after);
+    if (tj_compose_alias_diag_enabled()) {
+        for (int i = 0; i < MAX_DISPLAY_HISTORY; ++i) {
+            DisplayHistory* h = &s_d3d.display_history[i];
+            if (h->res && h->history_alias && h->raw == 0x00740000u) {
+                s_tj_compose_capture.history_generation = s_tj_compose_capture.batch;
+                s_tj_compose_capture.history_completed_raw = completed_raw;
+                break;
+            }
+        }
+    }
+    return 1;
+}
+
+static void off_rt_transition(int slot, D3D12_RESOURCE_STATES to)
+{
+    OffRT* r = &s_d3d.off_rt[slot];
+    if (r->st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource   = r->res;
+    b.Transition.StateBefore = r->st;
+    b.Transition.StateAfter  = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    d3d12_owned_barriers(1, &b);
+    r->st = to;
+}
+
+static int gpu_mirror_find(u8 local, u32 raw, u32 pitch, u32 w, u32 h)
+{
+    u32 physical_w = pitch / 4u;
+    for (int i = 0; i < MAX_GPU_MIRRORS; i++) {
+        const GpuMirror* m = &s_d3d.gpu_mirror[i];
+        if (m->valid && !m->immutable_source && m->local == local && m->raw == raw &&
+            m->pitch == pitch && m->w == physical_w && m->h == h &&
+            m->dxgi == (u32)DXGI_FORMAT_R8G8B8A8_UNORM)
+            return i;
+    }
+    return -1;
+}
+
+static int gpu_mirror_find_containing(u8 local, u32 raw, u32 pitch, u32 w, u32 h,
+                                      u32* out_x, u32* out_y)
+{
+    for (int i = 0; i < MAX_GPU_MIRRORS; i++) {
+        const GpuMirror* m = &s_d3d.gpu_mirror[i];
+        if (m->valid && !m->immutable_source && m->local == local && m->pitch == pitch &&
+            m->dxgi == (u32)DXGI_FORMAT_R8G8B8A8_UNORM &&
+            rsx_scaled_blit_alias_origin(m->raw, raw, pitch, m->w, m->h,
+                                          w, h, out_x, out_y))
+            return i;
+    }
+    return -1;
+}
+
+/* A destination first seen through a higher alias cannot be safely expanded
+ * later to its lower base without replacing a resource already referenced by
+ * this command list.  Observed Tokyo streams are base-first; reject reverse
+ * overlap rather than create a second, incoherent backing. */
+static int gpu_mirror_has_unresolved_overlap(u8 local, u32 raw, u32 pitch, u32 h)
+{
+    u64 end = (u64)raw + (u64)pitch * h;
+    for (int i = 0; i < MAX_GPU_MIRRORS; ++i) {
+        const GpuMirror* m = &s_d3d.gpu_mirror[i];
+        if (!m->valid || m->immutable_source || m->local != local || m->pitch != pitch)
+            continue;
+        u64 mirror_end = (u64)m->raw + (u64)m->pitch * m->h;
+        if ((u64)raw < mirror_end && end > m->raw) return 1;
+    }
+    return 0;
+}
+
+static int off_rt_find_containing(u8 local, u32 raw, u32 pitch, u32 w, u32 h,
+                                  u32* out_x, u32* out_y)
+{
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (r->res && r->local == local && r->raw_pitch == pitch &&
+            r->dxgi == (u32)DXGI_FORMAT_R8G8B8A8_UNORM &&
+            rsx_scaled_blit_alias_origin(r->off, raw, pitch, r->w, r->h,
+                                          w, h, out_x, out_y))
+            return i;
+    }
+    return -1;
+}
+
+static void gpu_mirror_transition(int slot, D3D12_RESOURCE_STATES to)
+{
+    if (slot < 0 || slot >= MAX_GPU_MIRRORS) return;
+    GpuMirror* m = &s_d3d.gpu_mirror[slot];
+    if (!m->res || m->st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = m->res;
+    b.Transition.StateBefore = m->st;
+    b.Transition.StateAfter = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    d3d12_owned_barriers(1, &b);
+    m->st = to;
+}
+
+static void gpu_scratch_dispose(GpuScratchAllocation* a)
+{
+    if (a->res) a->res->lpVtbl->Release(a->res);
+    if (a->up) a->up->lpVtbl->Release(a->up);
+    memset(a, 0, sizeof(*a));
+}
+
+static int gpu_scratch_take(u32 kind, u32 w, u32 h, GpuScratchAllocation* out)
+{
+    for (u32 i = 0; i < GPU_SCRATCH_SLOTS; ++i) {
+        GpuScratchAllocation* a = &s_gpu_scratch[i];
+        if (a->res && a->kind == kind && a->w == w && a->h == h &&
+            !d3d12_prefix_owner_object_reserved(a->res) &&
+            !d3d12_prefix_owner_object_reserved(a->up)) {
+            *out = *a;
+            s_gpu_scratch_bytes -= a->bytes;
+            memset(a, 0, sizeof(*a));
+            ++s_gpu_scratch_hits;
+            return 1;
+        }
+    }
+    ++s_gpu_scratch_misses;
+    return 0;
+}
+
+/* Call only where releasing the resources was already safe: after a checked
+ * fence, or when their command list was never submitted. Unknown completion
+ * uses the existing abandon/halt path and must never populate this cache. */
+static void gpu_scratch_retain(GpuScratchAllocation* a)
+{
+    if (d3d12_prefix_owner_object_mutable(a->res) != 0 ||
+        d3d12_prefix_owner_object_mutable(a->up) != 0) return;
+    if (!a->res || !a->bytes || a->bytes > GPU_SCRATCH_MAX_BYTES) {
+        gpu_scratch_dispose(a);
+        return;
+    }
+    int slot = -1;
+    for (u32 i = 0; i < GPU_SCRATCH_SLOTS; ++i)
+        if (!s_gpu_scratch[i].res) { slot = (int)i; break; }
+    while (slot < 0 || s_gpu_scratch_bytes > GPU_SCRATCH_MAX_BYTES - a->bytes) {
+        u32 i = s_gpu_scratch_cursor++ % GPU_SCRATCH_SLOTS;
+        if (s_gpu_scratch[i].res) {
+            s_gpu_scratch_bytes -= s_gpu_scratch[i].bytes;
+            gpu_scratch_dispose(&s_gpu_scratch[i]);
+            ++s_gpu_scratch_evictions;
+        }
+        if (slot < 0) slot = (int)i;
+    }
+    s_gpu_scratch[slot] = *a;
+    s_gpu_scratch_bytes += a->bytes;
+    memset(a, 0, sizeof(*a));
+}
+
+static void gpu_scratch_release_all(void)
+{
+    for (u32 i = 0; i < GPU_SCRATCH_SLOTS; ++i)
+        gpu_scratch_dispose(&s_gpu_scratch[i]);
+    s_gpu_scratch_bytes = 0;
+    s_gpu_scratch_cursor = 0;
+}
+
+static u64 gpu_scratch_allocation_bytes(const D3D12_RESOURCE_DESC* desc)
+{
+    D3D12_RESOURCE_ALLOCATION_INFO info = {0};
+    s_d3d.device->lpVtbl->GetResourceAllocationInfo(s_d3d.device, &info, 0, 1, desc);
+    /* A failed size query only disables caching; allocation behavior stays
+     * unchanged. Use actual heap requirements, not a width*height estimate. */
+    return info.SizeInBytes == UINT64_MAX ? 0 : info.SizeInBytes;
+}
+
+static void gpu_mirror_retire(GpuMirror* m)
+{
+    if (d3d12_prefix_owner_object_mutable(m->res) != 0 ||
+        d3d12_prefix_owner_object_mutable(m->up) != 0) return;
+    GpuScratchAllocation a = {m->res, m->up, m->st,
+        GPU_SCRATCH_MIRROR, m->w, m->h, m->allocation_bytes};
+    gpu_scratch_retain(&a);
+    memset(m, 0, sizeof(*m));
+}
+
+/* Mirror identity stays batch-local. render_frame has fenced before this
+ * runs; only its now-idle allocations survive for a fresh full upload. */
+static void gpu_mirror_reset_batch(void)
+{
+    for (int i = 0; i < MAX_GPU_MIRRORS; i++) {
+        GpuMirror* m = &s_d3d.gpu_mirror[i];
+        gpu_mirror_retire(m);
+    }
+}
+
+/* A successful MAIN readback has made MAIN mirrors disposable; immutable
+ * snapshots are likewise stale across the FIFO completion edge.  Retain only
+ * mutable local mirrors, whose backing has no guest-MAIN writeback. */
+static void gpu_mirror_release_prefix_exports(void)
+{
+    for (int i = 0; i < MAX_GPU_MIRRORS; ++i) {
+        GpuMirror* m = &s_d3d.gpu_mirror[i];
+        if (!m->immutable_source && m->local) continue;
+        gpu_mirror_retire(m);
+    }
+}
