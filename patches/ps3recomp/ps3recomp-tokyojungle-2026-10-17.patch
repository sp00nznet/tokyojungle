+/* Convert one enabled attribute using read_vp_vertex's offset/frequency/type
+ * rules, but only after a checked source span. */
+static int tj_indexed_diag_read_attr(const rsx_state* state, unsigned attr, u32 vi,
+                                    u32* out_ei, u32* out_ea, float out[4])
+{
+    extern uint8_t* vm_base;
+    if (!state || attr >= 16 || !vm_base) return 0;
+    const rsx_vertex_attrib* a = &state->vertex_attribs[attr];
+    for (u32 k = 0; k < 4; ++k) out[k] = state->vertex_data4f[attr][k];
+    if (!a->enabled || !a->stride) return 0;
+    u32 ei = vi;
+    if (a->frequency > 1 && !vp_frequency_override_disabled())
+        ei = (state->frequency_divider_op & (1u << attr)) ? vi % a->frequency : vi / a->frequency;
