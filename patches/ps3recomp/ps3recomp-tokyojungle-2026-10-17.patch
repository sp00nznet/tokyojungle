+texture_base_ready:
+    /* Remaining mip levels follow the base level in guest memory. Linear
+     * textures retain the programmed pitch at every level; actual Morton
+     * levels use their logical row size. */
+    u64 guest_level_off = base_source.slice_bytes;
+    u32 level_w = w > 1u ? w >> 1 : 1u;
+    u32 level_h = h > 1u ? h >> 1 : 1u;
+    for (u32 level = 1; level < mip_count; ++level) {
+        VPTexSourceLevel source_level;
+        if (vp_tex_source_level(&info, fmt, level_w, level_h, 1u, dimension,
+                                has_border, src_pitch, &source_level) != 0 ||
+            vp_copy_tex_level_layout((u8*)mapped + footprints[level].Offset,
+                                     footprints[level].Footprint.RowPitch,
+                                     source + guest_level_off, &source_level,
+                                     level_w, level_h, 0, 1, basef, 0) != 0) {
+            t->up->lpVtbl->Unmap(t->up, 0, NULL);
+            return -1;
+        }
+        guest_level_off += source_level.slice_bytes;
+        level_w = level_w > 1u ? level_w >> 1 : 1u;
+        level_h = level_h > 1u ? level_h >> 1 : 1u;
