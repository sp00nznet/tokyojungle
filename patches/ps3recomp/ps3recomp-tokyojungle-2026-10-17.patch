+#define TJ_VP_DUMP_HASH_MAX 8
+static u32 s_tj_vp_dump_hashes[TJ_VP_DUMP_HASH_MAX];
+static unsigned s_tj_vp_dump_hash_count;
+
+static void tj_vp_dump_target_after_compile(u32 hash, const u8* ucode, u32 bytes,
+                                            const char* hlsl)
+{
+    u32 target;
+    if (!tj_env_u32_hex("TJ_VP_DUMP_HASH", &target) || target != hash) return;
+    for (unsigned i = 0; i < s_tj_vp_dump_hash_count; ++i)
+        if (s_tj_vp_dump_hashes[i] == hash) return;
+    if (s_tj_vp_dump_hash_count >= TJ_VP_DUMP_HASH_MAX) return;
+    s_tj_vp_dump_hashes[s_tj_vp_dump_hash_count++] = hash;
+
+    const char* capture_dir = getenv("TJ_INDEXED_CAPTURE_DIR");
+    const char* dir = capture_dir && *capture_dir ? capture_dir : ".";
+    size_t len = strlen(dir);
+    int sep = len && dir[len - 1] != '\\' && dir[len - 1] != '/';
+    if (capture_dir && *capture_dir) CreateDirectoryA(dir, NULL);
+    char hlsl_path[1024], bin_path[1024];
+    int hn = snprintf(hlsl_path, sizeof(hlsl_path), "%s%svp_target_%08X.hlsl",
+                      dir, sep ? "\\" : "", hash);
+    int bn = snprintf(bin_path, sizeof(bin_path), "%s%svp_target_%08X.bin",
+                      dir, sep ? "\\" : "", hash);
+    int ok = hn > 0 && hn < (int)sizeof(hlsl_path) &&
+             bn > 0 && bn < (int)sizeof(bin_path);
+    FILE* hf = ok ? fopen(hlsl_path, "wb") : NULL;
+    if (!hf) ok = 0;
+    else {
+        size_t hlsl_bytes = strlen(hlsl);
+        if (fwrite(hlsl, 1, hlsl_bytes, hf) != hlsl_bytes) ok = 0;
+        if (fclose(hf) != 0) ok = 0;
+    }
+    FILE* bf = ok ? fopen(bin_path, "wb") : NULL;
+    if (!bf) ok = 0;
+    else {
+        if (fwrite(ucode, 1, bytes, bf) != bytes) ok = 0;
+        if (fclose(bf) != 0) ok = 0;
+    }
+    printf("[TJ-VP-DUMP] hash=%08X hlsl=%s bin=%s %s\n", hash,
+           hn > 0 && hn < (int)sizeof(hlsl_path) ? hlsl_path : "?",
+           bn > 0 && bn < (int)sizeof(bin_path) ? bin_path : "?",
+           ok ? "success" : "failed");
+}
