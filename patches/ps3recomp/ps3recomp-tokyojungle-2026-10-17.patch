+void rsx_d3d12_backend_display_vblank_stop(void)
+{
+    s_dvb.running = 0;
+    s_dvb.window_dirty = s_dvb.display_changed = 0;
+    if (!s_dvb.thread) return;
+    InterlockedExchange(&s_dvb.stop, 1);
+    /* WaitForVBlank returns within a refresh while the display runs; a dark
+     * monitor can hold it longer. Never free what a live waiter may touch.
+     * A later stop (backend shutdown after the presenter's) only re-checks:
+     * no second 250 ms wait, no duplicate log. */
+    if (WaitForSingleObject(s_dvb.thread, s_dvb.waiter_abandoned ? 0 : 250) != WAIT_OBJECT_0) {
+        if (!s_dvb.waiter_abandoned)
+            fprintf(stderr, "[TJ-VBLANK-SOURCE] event=stop waiter=blocked handles=retained\n");
+        s_dvb.waiter_abandoned = 1;
+        return;
+    }
+    s_dvb.waiter_abandoned = 0;
+    CloseHandle(s_dvb.thread);
+    s_dvb.thread = NULL;
+    AcquireSRWLockExclusive(&s_dvb.lock);
+    IDXGIOutput* pending = s_dvb.pending_output;
+    s_dvb.pending_output = NULL;
+    ReleaseSRWLockExclusive(&s_dvb.lock);
+    if (pending) pending->lpVtbl->Release(pending);
+    if (s_dvb.tick_event) {
+        CloseHandle(s_dvb.tick_event);
+        s_dvb.tick_event = NULL;
+    }
+}
