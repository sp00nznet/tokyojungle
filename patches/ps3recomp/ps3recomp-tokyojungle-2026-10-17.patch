+        const size_t name_len = raw_len > 255 ? 255 : raw_len;
+        vm_write8(out + 0x34, is_dir ? CELL_FS_TYPE_DIR : CELL_FS_TYPE_REG);
+        vm_write8(out + 0x35, (uint8_t)name_len);
