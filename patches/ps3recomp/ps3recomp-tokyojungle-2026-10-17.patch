+    emit_method(NV4097_SET_INDEX_ARRAY_ADDRESS, 0x00123400);
+    emit_method(NV4097_SET_INDEX_ARRAY_DMA, 0x11);
+    emit_method(NV4097_SET_BEGIN_END, RSX_PRIMITIVE_TRIANGLES);
