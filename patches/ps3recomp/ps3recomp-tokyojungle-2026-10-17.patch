+/* TJ_VP_ATTR_USED_MASK=1: skip CPU fetch/convert/store of VP vertex slots the
+ * compiled VS never reads. Unset keeps every slot written exactly as before. */
+static int vp_attr_mask_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_VP_ATTR_USED_MASK");
+        enabled = value && strcmp(value, "1") == 0;
+        if (enabled) fprintf(stderr, "[tj-vp-attr-mask] enabled\n");
+    }
+    return enabled;
+}
+
+/* Local copy of IID_ID3D11ShaderReflection: d3dcompiler.h is included before
+ * initguid.h, so the SDK symbol would need dxguid.lib. */
+static const GUID s_tj_iid_d3d11_shader_reflection =
+    {0x8d536ca1, 0x0cca, 0x4956, {0xa8, 0x37, 0x78, 0x69, 0x63, 0x75, 0x55, 0x84}};
+
+/* Input-signature read mask of a decompiled VS: bit i = ATTRi has a nonzero
+ * ReadWriteMask. Any failure or non-ATTR input is treated as "reads all". */
+static u16 vp_attr_reflect_mask(ID3DBlob* blob)
+{
+    ID3D11ShaderReflection* refl = NULL;
+    D3D11_SHADER_DESC desc;
+    u16 mask = 0;
+    if (!blob || FAILED(D3DReflect(blob->lpVtbl->GetBufferPointer(blob),
+                                   blob->lpVtbl->GetBufferSize(blob),
+                                   &s_tj_iid_d3d11_shader_reflection,
+                                   (void**)&refl)) || !refl)
+        return 0xFFFFu;
+    if (FAILED(refl->lpVtbl->GetDesc(refl, &desc))) mask = 0xFFFFu;
+    for (UINT i = 0; mask != 0xFFFFu && i < desc.InputParameters; ++i) {
+        D3D11_SIGNATURE_PARAMETER_DESC p;
+        if (FAILED(refl->lpVtbl->GetInputParameterDesc(refl, i, &p)) ||
+            !p.SemanticName || strcmp(p.SemanticName, "ATTR") != 0 ||
+            p.SemanticIndex >= 16 || p.SystemValueType != D3D_NAME_UNDEFINED) {
+            mask = 0xFFFFu;
+            break;
+        }
+        if (p.ReadWriteMask) mask |= (u16)(1u << p.SemanticIndex);
+    }
+    refl->lpVtbl->Release(refl);
+    return mask;
+}
+
+/* TJ_SHADER_PREFETCH slot states (VPVSEntry.prefetch_state). */
+#define VP_VS_READY   0
+#define VP_VS_PENDING 1
+#define VP_VS_FAILED  2
+static SRWLOCK s_vp_vs_resolve_lock = SRWLOCK_INIT;
+
+/* Every reader of vp_vs[i].vs / attr_read_mask (and of hash/uses_c03 where a
+ * failed compile must look like vs_idx -1) calls this first. Returns 1 when
+ * the slot holds a usable VS, 0 when its prefetched compile failed. Slots
+ * built synchronously are always READY, so with prefetch off this is one
+ * load and never blocks. A PENDING slot waits for its job (bounded by that
+ * compile), then is filled exactly as vp_get_vs's synchronous path fills it. */
+static int vp_vs_resolve(int vs_idx)
+{
+    if (vs_idx < 0 || vs_idx >= VP_VS_CACHE) return 1;
+    VPVSEntry* v = &s_d3d.vp_vs[vs_idx];
+    LONG state;
+    /* Plain volatile read: READY is final, and every non-READY slot takes
+     * the lock below (full barrier) before reading its fields. */
+    if (v->prefetch_state == VP_VS_READY) return 1;
+    AcquireSRWLockExclusive(&s_vp_vs_resolve_lock);
+    if (v->prefetch_state == VP_VS_PENDING) {
+        TJShaderJob* job = v->prefetch_job;
+        ID3DBlob* vb = NULL;
+        ID3DBlob* e = NULL;
+        HRESULT hr = tj_shader_prefetch_take(job, &vb, &e);
+        v->prefetch_job = NULL;
+        tj_shader_prefetch_forget(job);
+        tj_shader_job_release(job);   /* the slot's reference */
+        if (e) e->lpVtbl->Release(e);
+        if (FAILED(hr) || !vb) {
+            static int fail_logs = 0;
+            if (vb) vb->lpVtbl->Release(vb);
+            if (fail_logs++ < 4)
+                printf("[VP] per-draw VS compile FAIL (hash=0x%08X)\n", v->hash);
+            InterlockedExchange(&v->prefetch_state, VP_VS_FAILED);
+        } else {
+            v->vs = vb;
+            v->attr_read_mask = 0xFFFFu;
+            if (vp_attr_mask_enabled()) {
+                static int logged = 0;
+                v->attr_read_mask = vp_attr_reflect_mask(vb);
+                if (logged++ < 64)
+                    fprintf(stderr, "[tj-vp-attr-mask] vs=%d hash=0x%08X mask=0x%04X\n",
+                            vs_idx, v->hash, v->attr_read_mask);
+            }
+            { static int cached_logs = 0;
+              if (cached_logs++ < 6)
+                  printf("[VP] per-draw VS cached (hash=0x%08X, %d instrs, slot %d)\n",
+                         v->hash, v->prefetch_instrs, vs_idx); }
+            InterlockedExchange(&v->prefetch_state, VP_VS_READY);
+        }
+    }
+    state = v->prefetch_state;
+    ReleaseSRWLockExclusive(&s_vp_vs_resolve_lock);
+    return state == VP_VS_READY;
+}
+
+/* Backend shutdown, before the PS blob and session caches are released: no
+ * worker may still be compiling. Unstarted jobs are aborted, every pending VS
+ * slot and retained job is waited for and released. No-op when off. */
+static void tj_shader_prefetch_drain(void)
+{
+    TJShaderPrefetch* p = &s_tj_prefetch;
+    TJShaderJob* aborted;
+    if (!p->enabled) return;
+    AcquireSRWLockExclusive(&p->lock);
+    aborted = p->head;
+    p->head = p->tail = NULL;
+    for (TJShaderJob* q = aborted; q; q = q->next) q->queued = 0;
+    ReleaseSRWLockExclusive(&p->lock);
+    while (aborted) {
+        TJShaderJob* next = aborted->next;
+        aborted->next = NULL;
+        aborted->hr = E_ABORT;
+        InterlockedExchange(&aborted->finished, 1);
+        SetEvent(aborted->done);
+        tj_shader_job_release(aborted);   /* queue reference */
+        aborted = next;
+    }
+    for (int i = 0; i < s_d3d.vp_vs_n; ++i) {
+        VPVSEntry* v = &s_d3d.vp_vs[i];
+        if (v->prefetch_state != VP_VS_PENDING) continue;
+        WaitForSingleObject(v->prefetch_job->done, INFINITE);
+        tj_shader_job_release(v->prefetch_job);
+        v->prefetch_job = NULL;
+        InterlockedExchange(&v->prefetch_state, VP_VS_FAILED);
+    }
+    for (;;) {
+        TJShaderJob* job = NULL;
+        AcquireSRWLockExclusive(&p->lock);
+        if (p->table_n) job = tj_shader_prefetch_unlink(p->table_n - 1u);
+        ReleaseSRWLockExclusive(&p->lock);
+        if (!job) break;
+        WaitForSingleObject(job->done, INFINITE);
+        tj_shader_job_release(job);
+    }
+}
+
+/* Upload mask for a recorded VP draw. The FP-PSO path runs vp_vs[vs_idx]; a
+ * failed FP build falls back to the fixed primary VS on the same record, so
+ * include its inputs too. Until that primary is final, keep every slot. */
+static u16 vp_upload_attr_mask(int vs_idx)
+{
+    static ID3DBlob* primary_blob;
+    static u16 primary_mask = 0xFFFFu;
+    if (vs_idx < 0 || vs_idx >= s_d3d.vp_vs_n ||
+        !s_d3d.vp_ready || !s_d3d.vp_vs_blob ||
+        !vp_vs_resolve(vs_idx) || !s_d3d.vp_vs[vs_idx].vs)
+        return 0xFFFFu;
+    if (primary_blob != s_d3d.vp_vs_blob) {
+        primary_blob = s_d3d.vp_vs_blob;
+        primary_mask = vp_attr_reflect_mask(primary_blob);
+        fprintf(stderr, "[tj-vp-attr-mask] primary mask=0x%04X\n", primary_mask);
+    }
+    return (u16)(s_d3d.vp_vs[vs_idx].attr_read_mask | primary_mask);
+}
+
+static int vp_get_vs(const rsx_state* st)
+{
+    extern int rsx_vp_decompile_entry_tex(
+        const uint8_t*, u32, u32, u32, char*, u32);
+    if (!st || st->vp_ucode_bytes < 16) return -1;
+    /* Keep the complete resident bank: immediate branch/call targets are
+     * absolute slots and may point before or after START. Mix START into the
+     * cache key because one bank can expose several entry points. */
+    u32 entry = st->transform_program_start;
+    if (entry * 16u >= st->vp_ucode_bytes) entry = 0;
+    const u8* ucode = st->vp_ucode;
+    u32 bytes = st->vp_ucode_bytes;
+    u32 tex_dims = vp_texture_dimension_key(st);
+    u32 hash = vp_hash_ucode_reuse(ucode, bytes);
+    hash ^= entry + 0x9E3779B9u + (hash << 6) + (hash >> 2);
+    hash ^= tex_dims + 0x85EBCA6Bu + (hash << 6) + (hash >> 2);
+    if (!hash) hash = 1u;
+    /* Exact index over vp_vs[]: hashes are unique per slot (a slot is added
+     * only after this lookup misses), so the first match equals the old
+     * linear scan's result. */
+    static u16 vs_index[VP_VS_INDEX_SIZE];
+    u32 probe = (hash * 0x9E3779B1u) & (VP_VS_INDEX_SIZE - 1u);
+    for (u32 n = 0; n < VP_VS_INDEX_SIZE; ++n) {
+        const u16 e = vs_index[probe];
+        if (!e) break;
+        if (s_d3d.vp_vs[e - 1u].hash == hash) return (int)(e - 1u);
+        probe = (probe + 1u) & (VP_VS_INDEX_SIZE - 1u);
+    }
+
+    static char hlsl[768 * 1024];
+    int ni = rsx_vp_decompile_entry_tex(ucode, bytes, entry, tex_dims,
+                                        hlsl, sizeof hlsl);
+    if (ni <= 0) return -1;
+    if (getenv("VP_DUMP")) { static int _d=0; if (_d++ < 4) {
+        FILE* f = fopen("vp2_dump.hlsl", _d==1 ? "w" : "a");
+        if (f) { fprintf(f, "/* per-draw VS hash pending, %d instrs */%s%s", ni, hlsl, "\n"); fclose(f); } } }
+    /* TJ_SHADER_PREFETCH: publish the slot now with a pending compile job;
+     * vp_vs_resolve fills vs/attr_read_mask (or marks the slot failed) when a
+     * consumer first needs them. A full cache or an unavailable job keeps the
+     * synchronous path below unchanged. */
+    if (s_d3d.vp_vs_n < VP_VS_CACHE && tj_shader_prefetch_state()->vs_enabled) {
+        TJShaderJob* job = tj_shader_prefetch_submit(hlsl, strlen(hlsl), "guest_vp2",
+                                                     "main", "vs_5_0", 0, 0);
+        if (job) {
+            int slot = s_d3d.vp_vs_n++;
+            VPVSEntry* v = &s_d3d.vp_vs[slot];
+            v->hash = hash;
+            v->vs = NULL;
+            v->uses_c03 =
+                (strstr(hlsl, "vp_c[0]") || strstr(hlsl, "vp_c[1]") ||
+                 strstr(hlsl, "vp_c[2]") || strstr(hlsl, "vp_c[3]")) ? 1 : 0;
+            v->attr_read_mask = 0xFFFFu;
+            v->prefetch_job = job;
+            v->prefetch_instrs = ni;
+            InterlockedExchange(&v->prefetch_state, VP_VS_PENDING);
+            vs_index[probe] = (u16)(slot + 1);
+            return slot;
+        }
+    }
+    ID3DBlob* vb = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = tj_shader_compile_cached(hlsl, strlen(hlsl), "guest_vp2",
+                                          "main", "vs_5_0", 0, 0, &vb, &e, NULL);
+    if (e) e->lpVtbl->Release(e);
+    if (FAILED(hr) || !vb) {
+        static int _e=0; if (_e++<4) printf("[VP] per-draw VS compile FAIL (hash=0x%08X)\n", hash);
+        return -1;
+    }
+    /* Keep only compiler-accepted source/raw pairs. */
+    tj_vp_dump_target_after_compile(hash, ucode, bytes, hlsl);
+    if (s_d3d.vp_vs_n >= VP_VS_CACHE) {
+        vb->lpVtbl->Release(vb);
+        static int warned = 0;
+        if (warned++ < 4)
+            fprintf(stderr, "[VP] stable VS cache exhausted (%u entries)\n",
+                    (u32)VP_VS_CACHE);
+        return -1;
+    }
+    int slot = s_d3d.vp_vs_n++;
+    vs_index[probe] = (u16)(slot + 1);  /* probe = first empty cell found above */
+    s_d3d.vp_vs[slot].hash = hash;
+    s_d3d.vp_vs[slot].vs   = vb;
+    s_d3d.vp_vs[slot].uses_c03 =
+        (strstr(hlsl, "vp_c[0]") || strstr(hlsl, "vp_c[1]") ||
+         strstr(hlsl, "vp_c[2]") || strstr(hlsl, "vp_c[3]")) ? 1 : 0;
+    s_d3d.vp_vs[slot].attr_read_mask = 0xFFFFu;
+    if (vp_attr_mask_enabled()) {
+        static int logged = 0;
+        s_d3d.vp_vs[slot].attr_read_mask = vp_attr_reflect_mask(vb);
+        if (logged++ < 64)
+            fprintf(stderr, "[tj-vp-attr-mask] vs=%d hash=0x%08X mask=0x%04X\n",
+                    slot, hash, s_d3d.vp_vs[slot].attr_read_mask);
+    }
+    { static int _n=0; if (_n++<6) printf("[VP] per-draw VS cached (hash=0x%08X, %d instrs, slot %d)\n", hash, ni, slot); }
+    return slot;
+}
+
+/* --- Guest blend state -> packed PSO key ----------------------------------
+ * RSX blend factors/equation carry GL enums; each SFACTOR/DFACTOR/EQUATION
+ * word packs (alpha<<16)|colour. The key packs D3D12 enums so the PSO cache
+ * distinguishes real blend modes: bit0 enable, [5:1] srcC, [10:6] dstC,
+ * [15:11] srcA, [20:16] dstA, [23:21] opC, [26:24] opA. DeferredShading's
+ * light accumulation is additive (ONE,ONE) -- the old hardcoded straight-
+ * alpha PSO turned each light pass into a screen-blanking flash. */
+static u8 gl_blend_factor_d3d(u32 f, int is_alpha)
+{
+    switch (f & 0xFFFF) {
+    case 0x0000: return D3D12_BLEND_ZERO;
+    case 0x0001: return D3D12_BLEND_ONE;
+    case 0x0300: return is_alpha ? D3D12_BLEND_SRC_ALPHA     : D3D12_BLEND_SRC_COLOR;
+    case 0x0301: return is_alpha ? D3D12_BLEND_INV_SRC_ALPHA : D3D12_BLEND_INV_SRC_COLOR;
+    case 0x0302: return D3D12_BLEND_SRC_ALPHA;
+    case 0x0303: return D3D12_BLEND_INV_SRC_ALPHA;
+    case 0x0304: return D3D12_BLEND_DEST_ALPHA;
+    case 0x0305: return D3D12_BLEND_INV_DEST_ALPHA;
+    case 0x0306: return is_alpha ? D3D12_BLEND_DEST_ALPHA     : D3D12_BLEND_DEST_COLOR;
+    case 0x0307: return is_alpha ? D3D12_BLEND_INV_DEST_ALPHA : D3D12_BLEND_INV_DEST_COLOR;
+    case 0x0308: return D3D12_BLEND_SRC_ALPHA_SAT;
+    case 0x8001: return D3D12_BLEND_BLEND_FACTOR;       /* CONSTANT_COLOR   */
+    case 0x8002: return D3D12_BLEND_INV_BLEND_FACTOR;
+    case 0x8003: return D3D12_BLEND_BLEND_FACTOR;       /* CONSTANT_ALPHA ~ */
+    case 0x8004: return D3D12_BLEND_INV_BLEND_FACTOR;
+    default:     return D3D12_BLEND_ONE;
+    }
+}
+static u8 gl_blend_op_d3d(u32 e)
+{
+    switch (e & 0xFFFF) {
+    case 0x8007: return D3D12_BLEND_OP_MIN;
+    case 0x8008: return D3D12_BLEND_OP_MAX;
+    case 0x800A: return D3D12_BLEND_OP_SUBTRACT;
+    case 0x800B: return D3D12_BLEND_OP_REV_SUBTRACT;
+    default:     return D3D12_BLEND_OP_ADD;   /* 0x8006 FUNC_ADD / unset */
+    }
+}
+static u32 rsx_blend_key(const rsx_state* st, int enable)
+{
+    if (!enable) return 0;
+    /* Factors never programmed: keep the legacy straight-alpha behaviour
+     * (dbgfont-style text enables blending without setting factors). */
+    if (!st || (st->blend_sfactor == 0 && st->blend_dfactor == 0))
+        return 1u
+             | ((u32)D3D12_BLEND_SRC_ALPHA     << 1)
+             | ((u32)D3D12_BLEND_INV_SRC_ALPHA << 6)
+             | ((u32)D3D12_BLEND_ONE           << 11)
+             | ((u32)D3D12_BLEND_INV_SRC_ALPHA << 16)
+             | ((u32)D3D12_BLEND_OP_ADD << 21) | ((u32)D3D12_BLEND_OP_ADD << 24);
+    return 1u
+         | ((u32)gl_blend_factor_d3d(st->blend_sfactor,       0) << 1)
+         | ((u32)gl_blend_factor_d3d(st->blend_dfactor,       0) << 6)
+         | ((u32)gl_blend_factor_d3d(st->blend_sfactor >> 16, 1) << 11)
+         | ((u32)gl_blend_factor_d3d(st->blend_dfactor >> 16, 1) << 16)
+         | ((u32)gl_blend_op_d3d(st->blend_equation)       << 21)
+         | ((u32)gl_blend_op_d3d(st->blend_equation >> 16) << 24);
+}
+
+static u32 rsx_color_mask_d3d(u32 mask)
+{
+    return ((mask & 0x00010000u) ? 1u : 0u)  /* R */
+         | ((mask & 0x00000100u) ? 2u : 0u)  /* G */
+         | ((mask & 0x00000001u) ? 4u : 0u)  /* B */
+         | ((mask & 0x01000000u) ? 8u : 0u); /* A */
+}
+
+static u32 rsx_mrt_key(const rsx_state* st)
+{
+    if (!st) return 0xFu;
+    u32 key = rsx_color_mask_d3d(st->color_mask);
+    for (u32 rt = 1; rt < 4; rt++) {
+        u32 guest = (st->color_mask_mrt >> (rt * 4u)) & 0xFu; /* A,R,G,B */
+        u32 d3d = ((guest & 0x2u) ? 1u : 0u)
+                | ((guest & 0x4u) ? 2u : 0u)
+                | ((guest & 0x8u) ? 4u : 0u)
+                | ((guest & 0x1u) ? 8u : 0u);
+        key |= d3d << (rt * 4u);
+    }
+    key |= ((st->blend_enable_mrt >> 1u) & 0x7u) << 16u;
+    return key;
+}
+
+static u8 rsx_logic_key(const rsx_state* st)
+{
+    if (!st || !st->logic_op_enable) return 0;
+    D3D12_LOGIC_OP op;
+    switch (st->logic_op & 0xFFFFu) {
+    case 0x1500: op = D3D12_LOGIC_OP_CLEAR; break;
+    case 0x1501: op = D3D12_LOGIC_OP_AND; break;
+    case 0x1502: op = D3D12_LOGIC_OP_AND_REVERSE; break;
+    case 0x1503: op = D3D12_LOGIC_OP_COPY; break;
+    case 0x1504: op = D3D12_LOGIC_OP_AND_INVERTED; break;
+    case 0x1505: op = D3D12_LOGIC_OP_NOOP; break;
+    case 0x1506: op = D3D12_LOGIC_OP_XOR; break;
+    case 0x1507: op = D3D12_LOGIC_OP_OR; break;
+    case 0x1508: op = D3D12_LOGIC_OP_NOR; break;
+    case 0x1509: op = D3D12_LOGIC_OP_EQUIV; break;
+    case 0x150A: op = D3D12_LOGIC_OP_INVERT; break;
+    case 0x150B: op = D3D12_LOGIC_OP_OR_REVERSE; break;
+    case 0x150C: op = D3D12_LOGIC_OP_COPY_INVERTED; break;
+    case 0x150D: op = D3D12_LOGIC_OP_OR_INVERTED; break;
+    case 0x150E: op = D3D12_LOGIC_OP_NAND; break;
+    case 0x150F: op = D3D12_LOGIC_OP_SET; break;
+    default:     op = D3D12_LOGIC_OP_COPY; break;
+    }
+    return (u8)(1u | ((u8)op << 1u));
+}
+
+static u32 rsx_depth_key(const rsx_state* st)
+{
+    if (!st) return 0;
+    return (st->depth_test_enable ? 1u : 0u)
+         | (st->depth_mask ? 2u : 0u)
+         | ((st->depth_func & 0xFFFFu) << 8);
+}
+
+static D3D12_COMPARISON_FUNC rsx_depth_func_d3d(u32 func)
+{
+    switch (func & 0xFFFFu) {
+    case 0x0200: return D3D12_COMPARISON_FUNC_NEVER;
+    case 0x0201: return D3D12_COMPARISON_FUNC_LESS;
+    case 0x0202: return D3D12_COMPARISON_FUNC_EQUAL;
+    case 0x0203: return D3D12_COMPARISON_FUNC_LESS_EQUAL;
+    case 0x0204: return D3D12_COMPARISON_FUNC_GREATER;
+    case 0x0205: return D3D12_COMPARISON_FUNC_NOT_EQUAL;
+    case 0x0206: return D3D12_COMPARISON_FUNC_GREATER_EQUAL;
+    case 0x0207: return D3D12_COMPARISON_FUNC_ALWAYS;
+    default:     return D3D12_COMPARISON_FUNC_LESS_EQUAL;
+    }
+}
+
+static D3D12_STENCIL_OP rsx_stencil_op_d3d(u32 op)
+{
+    switch (op & 0xFFFFu) {
+    case 0x0000: return D3D12_STENCIL_OP_ZERO;
+    case 0x150A: return D3D12_STENCIL_OP_INVERT;
+    case 0x1E00: return D3D12_STENCIL_OP_KEEP;
+    case 0x1E01: return D3D12_STENCIL_OP_REPLACE;
+    case 0x1E02: return D3D12_STENCIL_OP_INCR_SAT;
+    case 0x1E03: return D3D12_STENCIL_OP_DECR_SAT;
+    case 0x8507: return D3D12_STENCIL_OP_INCR;
+    case 0x8508: return D3D12_STENCIL_OP_DECR;
+    default:     return D3D12_STENCIL_OP_KEEP;
+    }
+}
+
+/* Stencil references remain dynamic. D3D12's classic PSO has shared front/back
+ * masks, but supports distinct functions and operations. */
+static u64 rsx_stencil_key(const rsx_state* st)
+{
+    if (!st || !st->stencil_test_enable) return 0;
+    u64 key = 1ull
+         | ((u64)rsx_depth_func_d3d(st->stencil_func) << 1)
+         | ((u64)rsx_stencil_op_d3d(st->stencil_op_fail) << 5)
+         | ((u64)rsx_stencil_op_d3d(st->stencil_op_zfail) << 9)
+         | ((u64)rsx_stencil_op_d3d(st->stencil_op_zpass) << 13)
+         | ((u64)(st->stencil_mask & 0xFFu) << 17)
+         | ((u64)(st->stencil_write_mask & 0xFFu) << 25);
+    if (st->two_sided_stencil_test_enable)
+        key |= 1ull << 33
+             | ((u64)rsx_depth_func_d3d(st->back_stencil_func) << 34)
+             | ((u64)rsx_stencil_op_d3d(st->back_stencil_op_fail) << 38)
+             | ((u64)rsx_stencil_op_d3d(st->back_stencil_op_zfail) << 42)
+             | ((u64)rsx_stencil_op_d3d(st->back_stencil_op_zpass) << 46);
+    return key;
+}
+
+static u8 rsx_cull_key(const rsx_state* st)
+{
+    if (!st) return 0x10u;
+    u8 key = (u8)((st->front_face == 0x0901 ? 0x08u : 0u) |
+                  ((((st->zmin_max_control & 0xFu) != 0) &&
+                    ((st->zmin_max_control & 0xF0u) == 0)) ? 0x10u : 0u));
+    u8 mode = 0;
+    if (st->cull_face_enable) {
+        mode = st->cull_face == 0x0404 ? 1u :
+               st->cull_face == 0x0408 ? 3u : 2u;
+        key = (u8)(key | 1u | (mode << 1));
+    }
+
+    /* D3D12 has one fill mode for both faces.  When one face is culled, use
+     * the surviving face's RSX mode exactly; with both faces visible, a common
+     * LINE mode is exact while mixed front/back modes remain solid. */
+    u32 polygon_mode = 0x1B02u; /* FILL */
+    if (mode == 1u) polygon_mode = st->back_polygon_mode;
+    else if (mode == 2u) polygon_mode = st->front_polygon_mode;
+    else if (!mode && st->front_polygon_mode == st->back_polygon_mode)
+        polygon_mode = st->front_polygon_mode;
+    if (polygon_mode == 0x1B01u) key |= 0x20u; /* LINE */
+    if (st->shade_mode == 0x1D00u) key |= 0x40u; /* FLAT */
+    return key;
+}
+
+static void rsx_polygon_offset(const rsx_state* st, u32 topology,
+                               INT* depth_bias, float* slope_bias)
+{
+    *depth_bias = 0;
+    *slope_bias = 0.0f;
+    if (!st) return;
+    int enabled = topology == D3D_PRIMITIVE_TOPOLOGY_POINTLIST
+        ? st->poly_offset_point_enable
+        : (topology == D3D_PRIMITIVE_TOPOLOGY_LINELIST ||
+           topology == D3D_PRIMITIVE_TOPOLOGY_LINESTRIP)
+            ? st->poly_offset_line_enable : st->poly_offset_fill_enable;
+    if (!enabled) return;
+    float bias = st->polygon_offset_bias;
+    float slope = st->polygon_offset_scale_factor;
+    if (!isfinite(bias)) bias = 0.0f;
+    if (!isfinite(slope)) slope = 0.0f;
+    if (bias >= (float)INT_MAX) *depth_bias = INT_MAX;
+    else if (bias <= (float)INT_MIN) *depth_bias = INT_MIN;
+    else *depth_bias = (INT)lrintf(bias);
+    *slope_bias = slope;
+}
+
+/* Colour attachments needed by the guest pipeline. A masked-off colour
+ * surface must not clip a larger depth-only pass to its backing dimensions.
+ * Keep clears and the legacy/fallback pipelines on their existing bindings. */
+static int dr_num_rts(const D3D12DrawRecord* dr)
+{
+    int n = 1;
+    while (n < 4 && dr->rt_target >= (n == 1 ? 0x13u : n == 2 ? 0x17u : 0x1Fu)) n++;
+    u32 active_masks = (1u << (4u * (u32)n)) - 1u;
+    if (dr->is_vp && !dr->is_clear && dr->fp_addr && dr->fp_program_valid &&
+        !(dr->mrt_key & active_masks))
+        return 0;
+    return n;
+}
+
+static int rt_identity_is_offscreen(u32 off, u8 local)
+{
+    return off != 0 || !local;
+}
+
+static int dr_rt_attachment_enabled(const D3D12DrawRecord* dr, int attachment)
+{
+    if (!dr) return 0;
+    if (attachment == 0) return 1;
+    return attachment == 1 ? dr->rt_target >= 0x13u :
+           attachment == 2 ? dr->rt_target >= 0x17u :
+           attachment == 3 ? dr->rt_target >= 0x1Fu : 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * TJ_RENDER_SCALE classification. Pure functions of registered/canonical
+ * identity, evaluated the same way at record time (WPOS lane, slope bias) and
+ * when surfaces are allocated. Guest w/h, pitch, coverage and ownership stay
+ * 1x; only D3D12 descriptors, viewports, scissors, clear rects and copy boxes
+ * use host units. Every helper returns 1 while the opt-in is off.
+ * -----------------------------------------------------------------------*/
+static u32 rs_factor(u8 scale)
+{
+    return scale > 1 ? (u32)scale : 1u;
+}
+
+/* Host factor of a registered display geometry (displays, their history). */
+static u8 rs_display_geometry_scale(u32 w, u32 h)
+{
+    const u32 n = s_d3d.scale;
+    if (n <= 1 || !w || !h ||
+        (u64)w * n > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+        (u64)h * n > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION)
+        return 1;
+    return (u8)n;
+}
+
+/* Exact registered display raw -> scale of the DisplaySurface replay binds. */
+static u8 rs_display_raw_scale(u32 raw)
+{
+    CellGcmDisplayInfo info = {0};
+    if (s_d3d.scale <= 1 || !cellGcmGetDisplaySurfaceInfo(raw, 0, 0, 0, &info) ||
+        info.offset != raw)
+        return 1;
+    return rs_display_geometry_scale(info.width, info.height);
+}
+
+/* The swap chain is internal-sized (out == internal in this slice), so the
+ * (0, LOCAL) backbuffer sentinel renders at the global scale. */
+static u8 rs_backbuffer_scale(void)
+{
+    return s_d3d.scale > 1 ? (u8)s_d3d.scale : 1u;
+}
+
+static void rs_backbuffer_size(u32* w, u32* h)
+{
+    *w = s_d3d.scale > 1 ? s_d3d.out_w : s_d3d.width;
+    *h = s_d3d.scale > 1 ? s_d3d.out_h : s_d3d.height;
+}
+
+/* Main-zeta rule from canonical identity only, never from one draw's clip or
+ * viewport: LOCAL depth whose pitch is a registered display's pitch and whose
+ * pitch-derived width is that display's width (Tokyo Jungle 0x740000). The
+ * shadow zeta and other pitches stay 1x. */
+static u8 rs_zeta_identity_scale(u8 local, u32 pitch, u8 format)
+{
+    const u32 bpp = format == 1 ? 2u : 4u;
+    if (s_d3d.scale <= 1 || !local || !pitch || pitch % bpp) return 1;
+    for (u32 i = 0; i < CELL_GCM_MAX_DISPLAY_BUFFER_NUM; ++i) {
+        const CellGcmDisplayInfo* d = cellGcmGetDisplayInfo(i);
+        if (d && d->pitch == pitch && d->width == pitch / bpp && d->height)
+            return rs_display_geometry_scale(d->width, d->height);
+    }
+    return 1;
+}
+
+/* Attachments a record writes: active write-mask nibbles of enabled targets
+ * only (MRT blend-enable bits excluded), or a clear's colour flags. */
+static u32 rs_record_color_writes(const D3D12DrawRecord* dr)
+{
+    if (dr->is_clear)
+        return (dr->clear_flags & RSX_CLEAR_COLOR_MASK) ? 1u : 0u;
+    u32 writes = 0;
+    for (int a = 0; a < 4; ++a)
+        if (dr_rt_attachment_enabled(dr, a) && ((dr->mrt_key >> (4u * (u32)a)) & 0xFu))
+            writes |= 1u << a;
+    return writes;
+}
+
+/* Primary colour scale exactly as replay resolves the target: registered
+ * display -> its DisplaySurface, (0, LOCAL) -> swap chain, anything else ->
+ * a 1x OffRT. MRT B/C/D always resolve to 1x OffRTs in this slice. */
+static u8 rs_record_color_scale(const D3D12DrawRecord* dr)
+{
+    if (s_d3d.scale <= 1) return 1;
+    if (dr->rt_is_display) return rs_display_raw_scale(dr->rt_display_raw);
+    if (!rt_identity_is_offscreen(dr->rt_off, dr->rt_local)) return rs_backbuffer_scale();
+    return 1;
+}
+
+/* Colour scale when the record writes colour, else its zeta's scale. A
+ * depth-only shadow pass bound beside a display therefore stays 1x. */
+static u8 rs_record_raster_scale(const D3D12DrawRecord* dr)
+{
+    if (s_d3d.scale <= 1 || !dr) return 1;
+    const u32 writes = rs_record_color_writes(dr);
+    if (writes & 1u) return rs_record_color_scale(dr);
+    if (writes) return 1;                   /* only 1x MRT B/C/D write */
+    if (dr->zeta_pitch)
+        return rs_zeta_identity_scale(dr->zeta_local, dr->zeta_pitch, dr->zeta_format);
+    return rs_record_color_scale(dr);       /* nothing written: bound colour */
+}
+
+/* Replay twins over the resources actually bound. */
+static u32 rs_bound_color_scale(int cur_rt, int cur_display, int cur_scratch)
+{
+    if (s_d3d.scale <= 1) return 1;
+    if (cur_display >= 0 && cur_display < MAX_DISPLAY_SURFACES)
+        return rs_factor(s_d3d.display_surface[cur_display].scale);
+    if (cur_scratch || cur_rt >= 0) return 1;
+    return rs_backbuffer_scale();
+}
+
+static u32 rs_bound_depth_scale(u8 cur_depth)
+{
+    if (!cur_depth || cur_depth > MAX_DEPTH_SURFACES) return 0;
+    return rs_factor(s_d3d.depth_surface[cur_depth - 1u].scale);
+}
+
+static u32 rs_bound_raster_scale(const D3D12DrawRecord* dr, int color_count,
+                                 u32 color_scale, u8 cur_depth)
+{
+    if (s_d3d.scale <= 1) return 1;
+    const u32 depth_scale = rs_bound_depth_scale(cur_depth);
+    if (color_count) {
+        const u32 writes = rs_record_color_writes(dr);
+        if (writes & 1u) return color_scale;
+        if (writes) return 1;
+    }
+    if (depth_scale) return depth_scale;
+    return color_count ? color_scale : rs_factor(dr->raster_scale);
+}
+
+/* Logical (guest) rectangles become host rectangles exactly once, here. */
+static void rs_scale_viewport(D3D12_VIEWPORT* vp, u32 scale)
+{
+    if (scale <= 1) return;
+    vp->TopLeftX *= (float)scale;
+    vp->TopLeftY *= (float)scale;
+    vp->Width *= (float)scale;
+    vp->Height *= (float)scale;
+}
+
+static void rs_scale_rect(D3D12_RECT* rect, u32 scale)
+{
+    if (scale <= 1) return;
+    rect->left *= (LONG)scale;
+    rect->top *= (LONG)scale;
+    rect->right *= (LONG)scale;
+    rect->bottom *= (LONG)scale;
+}
+
+static int rs_audit_first(u64 key)
+{
+    static u64 seen[64];
+    static u32 count;
+    for (u32 i = 0; i < count; ++i)
+        if (seen[i] == key) return 0;
+    if (count == 64) return 0;
+    seen[count++] = key;
+    return 1;
+}
+
+/* A scaled primary that is written beside 1x MRT B/C/D targets would clip
+ * the whole draw to the 1x attachment (stale display quadrants, magnified MRT
+ * output). Such draws bind null RTVs (same format, writes discarded, no size)
+ * in the MRT slots instead: the display and zeta stay correct at N x and the
+ * MRT writes of that draw are dropped and counted as mixed-mrt. */
+static int rs_mrt_null_bind(const D3D12DrawRecord* dr, u32 primary_scale,
+                            int scratch_draw)
+{
+    return primary_scale > 1 && !scratch_draw && !dr->is_clear &&
+           (rs_record_color_writes(dr) & 1u) != 0 && s_d3d.scale_blit_rtv_heap;
+}
+
+/* RTV heap slot 0 is the copy-pass scratch; slots 1..3 are MRT null views. */
+static D3D12_CPU_DESCRIPTOR_HANDLE rs_mrt_null_rtv(int mrt, DXGI_FORMAT format)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE handle;
+    s_d3d.scale_blit_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(
+        s_d3d.scale_blit_rtv_heap, &handle);
+    handle.ptr += (SIZE_T)(1 + mrt) * s_d3d.rtv_descriptor_size;
+    D3D12_RENDER_TARGET_VIEW_DESC desc = {0};
+    desc.Format = format;
+    desc.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
+    d3d12_owned_rtv(NULL, &desc, handle);
+    return handle;
+}
+
+/* Gate for shipping the opt-in, judged on what the draw rasterizes (writes
+ * and raster_scale), not on what happens to be bound: depth/stencil tested
+ * at a different scale than the raster lands at the wrong positions, a
+ * smaller DSV clips a written larger primary, and a written primary beside
+ * written 1x MRT targets drops those MRT writes (rs_mrt_null_bind). Counted,
+ * logged once per identity pair. */
+static void rs_audit_draw(const D3D12DrawRecord* dr, u32 record, int color_count,
+                          int cur_rt, int cur_display, int cur_scratch,
+                          const int cur_m[3], u8 cur_depth, u32 raster_scale)
+{
+    static u64 mismatches, mixed, mixed_mrt;
+    if (s_d3d.scale <= 1) return;
+    if (raster_scale != rs_factor(dr->raster_scale) && ++mismatches <= 8)
+        fprintf(stderr, "[tj-scale] record/replay scale differ record=%u fp=%08X "
+                "recorded=%u bound=%u draws=%llu\n", record, dr->fp_addr,
+                rs_factor(dr->raster_scale), raster_scale,
+                (unsigned long long)mismatches);
+    if (!color_count) return;
+    const u32 writes = rs_record_color_writes(dr);
+    const u32 color_scale = rs_bound_color_scale(cur_rt, cur_display, cur_scratch);
+    const u32 color_raw = dr->rt_is_display ? dr->rt_display_raw : dr->rt_off;
+    const u32 depth_scale = rs_bound_depth_scale(cur_depth);
+    if (depth_scale && depth_scale != raster_scale) {
+        const DepthSurface* ds = &s_d3d.depth_surface[cur_depth - 1u];
+        u32 rtv_w = 0, rtv_h = 0;
+        if (cur_display >= 0) {
+            rtv_w = s_d3d.display_surface[cur_display].w * color_scale;
+            rtv_h = s_d3d.display_surface[cur_display].h * color_scale;
+        } else if (cur_scratch) {
+            rtv_w = s_d3d.off_rt_scratch[0].w; rtv_h = s_d3d.off_rt_scratch[0].h;
+        } else if (cur_rt >= 0) {
+            rtv_w = s_d3d.off_rt[cur_rt].w; rtv_h = s_d3d.off_rt[cur_rt].h;
+        } else {
+            rs_backbuffer_size(&rtv_w, &rtv_h);
+        }
+        const int depth = (dr->depth_key & 1u) != 0;
+        const int stencil = (dr->stencil_key & 1ull) != 0;
+        if (depth || stencil ||
+            ((writes & 1u) && ((u64)ds->w * depth_scale < rtv_w ||
+                               (u64)ds->h * depth_scale < rtv_h))) {
+            ++mixed;
+            if (rs_audit_first(((u64)color_raw << 32) ^ ds->raw ^ 1ull))
+                fprintf(stderr, "[tj-scale] mixed colour=%s%08X x%u zeta=%08X x%u "
+                        "depth=%d stencil=%d record=%u fp=%08X draws=%llu\n",
+                        dr->rt_is_display ? "display:" : cur_rt >= 0 ? "offrt:" : "host:",
+                        color_raw, color_scale, ds->raw, depth_scale, depth, stencil,
+                        record, dr->fp_addr, (unsigned long long)mixed);
+        }
+    }
+    if (rs_mrt_null_bind(dr, color_scale, cur_scratch)) {
+        for (int m = 0; m < 3; ++m) {
+            if (cur_m[m] < 0 || !(writes & (2u << m))) continue;
+            ++mixed_mrt;
+            if (rs_audit_first(((u64)color_raw << 32) ^ s_d3d.off_rt[cur_m[m]].off ^ 2ull))
+                fprintf(stderr, "[tj-scale] mixed-mrt primary=%08X x%u target%d=%08X x1 "
+                        "writes dropped record=%u fp=%08X draws=%llu\n", color_raw, color_scale,
+                        m + 1, s_d3d.off_rt[cur_m[m]].off, record, dr->fp_addr,
+                        (unsigned long long)mixed_mrt);
+            break;
+        }
+    }
+}
+
+static void d3d12_dump_device_failure(const char* where, HRESULT call_hr)
+{
+    static LONG dumped = 0;
+    if (!s_d3d.device || InterlockedExchange(&dumped, 1)) return;
+
+    HRESULT removed = s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device);
+    fprintf(stderr, "[D3D12-FAIL] where=%s call=0x%08lX removed=0x%08lX\n",
+            where, (long)call_hr, (long)removed);
+
+    ID3D12InfoQueue* iq = NULL;
+    if (SUCCEEDED(s_d3d.device->lpVtbl->QueryInterface(
+            s_d3d.device, &IID_ID3D12InfoQueue, (void**)&iq)) && iq) {
+        UINT64 count = iq->lpVtbl->GetNumStoredMessages(iq);
+        fprintf(stderr, "[D3D12-FAIL] info-queue messages=%llu\n",
+                (unsigned long long)count);
+        UINT64 first = count > 64 ? count - 64 : 0;
+        for (UINT64 i = first; i < count; i++) {
+            SIZE_T len = 0;
+            iq->lpVtbl->GetMessage(iq, i, NULL, &len);
+            D3D12_MESSAGE* msg = (D3D12_MESSAGE*)malloc(len);
+            if (msg && SUCCEEDED(iq->lpVtbl->GetMessage(iq, i, msg, &len)))
+                fprintf(stderr, "[D3D12-FAIL][IQ sev=%d id=%d] %s\n",
+                        (int)msg->Severity, (int)msg->ID, msg->pDescription);
+            free(msg);
+        }
+        iq->lpVtbl->Release(iq);
+    }
+
+    ID3D12DeviceRemovedExtendedData* dred = NULL;
+    if (SUCCEEDED(s_d3d.device->lpVtbl->QueryInterface(
+            s_d3d.device, &IID_ID3D12DeviceRemovedExtendedData,
+            (void**)&dred)) && dred) {
+        D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT crumbs = {0};
+        HRESULT bhr = dred->lpVtbl->GetAutoBreadcrumbsOutput(dred, &crumbs);
+        fprintf(stderr, "[D3D12-FAIL] DRED breadcrumbs hr=0x%08lX\n", (long)bhr);
+        int node_index = 0;
+        for (const D3D12_AUTO_BREADCRUMB_NODE* node = crumbs.pHeadAutoBreadcrumbNode;
+             node && node_index < 16; node = node->pNext, node_index++) {
+            UINT done = node->pLastBreadcrumbValue ? *node->pLastBreadcrumbValue : 0;
+            UINT completed_op = done ? done - 1 : 0;
+            UINT pending_op = done < node->BreadcrumbCount ? done : completed_op;
+            fprintf(stderr,
+                    "[D3D12-FAIL][DRED node=%d] list=%s queue=%s done=%u/%u "
+                    "completed-op=%u pending-op=%u\n",
+                    node_index,
+                    node->pCommandListDebugNameA ? node->pCommandListDebugNameA : "?",
+                    node->pCommandQueueDebugNameA ? node->pCommandQueueDebugNameA : "?",
+                    done, node->BreadcrumbCount,
+                    node->pCommandHistory && node->BreadcrumbCount
+                        ? (unsigned)node->pCommandHistory[completed_op] : 0,
+                    node->pCommandHistory && node->BreadcrumbCount
+                        ? (unsigned)node->pCommandHistory[pending_op] : 0);
+        }
+
+        D3D12_DRED_PAGE_FAULT_OUTPUT fault = {0};
+        HRESULT fhr = dred->lpVtbl->GetPageFaultAllocationOutput(dred, &fault);
+        fprintf(stderr, "[D3D12-FAIL] DRED page-fault hr=0x%08lX va=0x%llX\n",
+                (long)fhr, (unsigned long long)fault.PageFaultVA);
+        int allocation_index = 0;
+        for (const D3D12_DRED_ALLOCATION_NODE* allocation =
+                 fault.pHeadExistingAllocationNode;
+             allocation && allocation_index < 16;
+             allocation = allocation->pNext, allocation_index++) {
+            fprintf(stderr, "[D3D12-FAIL][DRED allocation=%d] type=%u name=%s\n",
+                    allocation_index, (unsigned)allocation->AllocationType,
+                    allocation->ObjectNameA ? allocation->ObjectNameA : "?");
+        }
+        dred->lpVtbl->Release(dred);
+    }
+    fflush(stderr);
+}
+
+/* Stable PS compilation identity.  `exp32` is already reflected in most
+ * decompilations, but remains explicit so a future decompiler change cannot
+ * accidentally reuse a blob across a compile-affecting mode. */
+#define VP_FP_BLOB_MODE_PS_5_0 0x00050000u
+static u64 vp_fp_blob_hash(const char* source, size_t source_len)
+{
+    u64 hash = 14695981039346656037ULL;
+    for (size_t i = 0; i < source_len; ++i) {
+        hash ^= (u8)source[i];
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static int tj_fp_pso_trace_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_FP_PSO_TRACE");
+        enabled = value && value[0] == '1' && value[1] == '\0';
+    }
+    return enabled;
+}
+
+/* `out_cache_owned` tells the caller whether the returned blob remains owned
+ * by this cache.  D3D PSO construction consumes the bytecode synchronously,
+ * so a renderer-thread-only cache pointer is safe through that call. */
+static HRESULT vp_fp_blob_get_or_compile(const char* source, size_t source_len,
+                                         int exp32, int perf_trace,
+                                         ID3DBlob** out_blob,
+                                         ID3DBlob** out_error,
+                                         int* out_cache_owned)
+{
+    if (out_blob) *out_blob = NULL;
+    if (out_error) *out_error = NULL;
+    if (out_cache_owned) *out_cache_owned = 0;
+    if (!source || !source_len || !out_blob) return E_INVALIDARG;
+
+    const u32 compile_mode = VP_FP_BLOB_MODE_PS_5_0 | (exp32 ? 1u : 0u);
+    const u64 source_hash = vp_fp_blob_hash(source, source_len);
+    if (perf_trace) s_tj_perf_phase.fp_blob_lookups++;
+    for (int i = 0; i < s_d3d.vp_fp_blob_n; ++i) {
+        VPFPBlobEntry* entry = &s_d3d.vp_fp_blob[i];
+        if (entry->blob && entry->source && entry->source_hash == source_hash &&
+            entry->source_len == source_len && entry->compile_mode == compile_mode &&
+            memcmp(entry->source, source, source_len) == 0) {
+            if (perf_trace) s_tj_perf_phase.fp_blob_hits++;
+            entry->last_use = ++s_d3d.vp_fp_blob_clock;
+            *out_blob = entry->blob;
+            if (out_cache_owned) *out_cache_owned = 1;
+            return S_OK;
+        }
+    }
+    if (perf_trace) s_tj_perf_phase.fp_blob_misses++;
+
+    ID3DBlob* blob = NULL;
+    ID3DBlob* error = NULL;
+    LONGLONG start = perf_trace ? tj_perf_now() : 0;
+    /* TJ_SHADER_PREFETCH: a record-time job for these exact bytes already
+     * holds (or is producing) this helper call's result; take it instead of
+     * compiling again. No job: the unchanged synchronous call. */
+    TJShaderJob* prefetched = tj_shader_prefetch_claim(source, source_len, "guest_fp",
+                                                       "main", "ps_5_0", 0, 0);
+    HRESULT hr = prefetched
+        ? tj_shader_prefetch_take(prefetched, &blob, &error)
+        : tj_shader_compile_cached(source, source_len, "guest_fp",
+                                   "main", "ps_5_0", 0, 0, &blob, &error, NULL);
+    tj_shader_job_release(prefetched);
+    if (perf_trace) {
+        u64 ticks = (u64)(tj_perf_now() - start);
+        s_tj_perf_phase.fp_compile_ticks += ticks;
+        s_tj_perf_phase.fp_blob_compile_ticks += ticks;
+    }
+    if (FAILED(hr) || !blob) {
+        if (blob) blob->lpVtbl->Release(blob);
+        if (out_error) *out_error = error;
+        else if (error) error->lpVtbl->Release(error);
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+    if (error) error->lpVtbl->Release(error);
+
+    /* Allocation failure only disables reuse for this one compile; it never
+     * changes the shader bytes supplied to the PSO. */
+    char* exact_source = (char*)malloc(source_len + 1u);
+    if (!exact_source) {
+        *out_blob = blob;
+        return S_OK;
+    }
+    memcpy(exact_source, source, source_len);
+    exact_source[source_len] = '\0';
+
+    /* Entries are unique (admitted only after a full miss), so lookup order
+     * is irrelevant: evict the least-recently-used entry in place. */
+    int blob_slot = s_d3d.vp_fp_blob_n;
+    if (s_d3d.vp_fp_blob_n >= VP_FP_BLOB_CACHE) {
+        blob_slot = 0;
+        for (int i = 1; i < VP_FP_BLOB_CACHE; ++i)
+            if (s_d3d.vp_fp_blob[i].last_use < s_d3d.vp_fp_blob[blob_slot].last_use)
+                blob_slot = i;
+        VPFPBlobEntry* old = &s_d3d.vp_fp_blob[blob_slot];
+        if (old->blob) old->blob->lpVtbl->Release(old->blob);
+        free(old->source);
+        if (perf_trace) s_tj_perf_phase.fp_blob_evictions++;
+    } else {
+        ++s_d3d.vp_fp_blob_n;
+    }
+    VPFPBlobEntry* entry = &s_d3d.vp_fp_blob[blob_slot];
+    entry->source_hash = source_hash;
+    entry->source_len = source_len;
+    entry->compile_mode = compile_mode;
+    entry->source = exact_source;
+    entry->blob = blob;
+    entry->last_use = ++s_d3d.vp_fp_blob_clock;
+    *out_blob = blob;
+    if (out_cache_owned) *out_cache_owned = 1;
+    return S_OK;
+}
+
+static void vp_fp_blob_release_all(void)
+{
+    for (int i = 0; i < s_d3d.vp_fp_blob_n; ++i) {
+        if (s_d3d.vp_fp_blob[i].blob)
+            s_d3d.vp_fp_blob[i].blob->lpVtbl->Release(s_d3d.vp_fp_blob[i].blob);
+        free(s_d3d.vp_fp_blob[i].source);
+        memset(&s_d3d.vp_fp_blob[i], 0, sizeof(s_d3d.vp_fp_blob[i]));
+    }
+    s_d3d.vp_fp_blob_n = 0;
+    s_d3d.vp_fp_blob_clock = 0;
+}
+
+static int rsx_fragment_texture_shadow_compare(
+    const D3D12DrawRecord* record, u32 unit)
+{
+    if (!record || unit >= RSX_MAX_TEXTURES || !record->tex[unit].set)
+        return 0;
+    const u32 basef = record->tex[unit].fmt & 0x9Fu;
+    const u32 zfunc = (record->tex[unit].address >> 28) & 0xFu;
+    /* CONTROL0 bit 2 selects texture alpha-kill instead of depth compare.
+     * Never/always need no comparison fetch. HLSL exposes no Texture3D
+     * SampleCmp method, so that uncommon case remains a normal depth fetch. */
+    if ((record->tex[unit].control0 & 4u) || zfunc == 0u || zfunc >= 7u ||
+        record->tex[unit].dimension == RSX_FP_TEXTURE_DIM_3D)
+        return 0;
+    /* RSX DEPTH24_D8, DEPTH24_D8_FLOAT, DEPTH16, DEPTH16_FLOAT. */
+    return basef >= 0x90u && basef <= 0x93u;
+}
+
+static u64 dr_texture_shader_key(const D3D12DrawRecord* record)
+{
+    u64 key = 0;
+    for (u32 unit = 0; unit < RSX_MAX_TEXTURES; ++unit) {
+        u32 dimension = RSX_FP_TEXTURE_DIM_2D;
+        if (record && record->tex[unit].set) {
+            dimension = record->tex[unit].cube
+                ? RSX_FP_TEXTURE_DIM_CUBE : record->tex[unit].dimension;
+            if (dimension < RSX_FP_TEXTURE_DIM_1D ||
+                dimension > RSX_FP_TEXTURE_DIM_CUBE)
+                dimension = RSX_FP_TEXTURE_DIM_2D;
+        }
+        key |= (u64)dimension << (unit * 3u);
+        if (rsx_fragment_texture_shadow_compare(record, unit))
+            key |= RSX_FP_TEXTURE_SHADOW_BIT(unit);
+    }
+    return key;
+}
+
+static int rsx_hlsl_add_qualifier(char* hlsl, size_t capacity,
+                                  const char* declaration,
+                                  const char* qualifier)
+{
+    char* at = strstr(hlsl, declaration);
+    if (!at) return 0;
+    size_t length = strlen(hlsl);
+    size_t extra = strlen(qualifier);
+    if (length + extra + 1u > capacity) return 0;
+    size_t offset = (size_t)(at - hlsl);
+    memmove(hlsl + offset + extra, hlsl + offset, length - offset + 1u);
+    memcpy(hlsl + offset, qualifier, extra);
+    return 1;
+}
+
+static void rsx_flat_shade_hlsl(char* hlsl, size_t capacity)
+{
+    static const char* declarations[] = {
+        "float4 col0 : COLOR0", "float4 col1 : COLOR1",
+        "float4 bcol0 : COLOR2", "float4 bcol1 : COLOR3"
+    };
+    for (u32 i = 0; i < sizeof(declarations) / sizeof(declarations[0]); ++i)
+        rsx_hlsl_add_qualifier(hlsl, capacity, declarations[i],
+                               "nointerpolation ");
+}
+
+/* Guest-FP HLSL buffer size; the decompiler output depends on it, so the
+ * record-time prefetch copy below must use the same value as vp_get_fp_pso. */
+#define VP_FP_HLSL_CAPACITY 32768
+
+/* TJ_SHADER_PREFETCH: submit, at record time, the exact final HLSL that
+ * vp_get_fp_pso will pass to vp_fp_blob_get_or_compile for this record: the
+ * same record-captured program, buffer size, exp32, texture shader key,
+ * clamped output count and flat-shade edit (all fixed at record time).
+ * Address-selected debug injections (FP_FORCE/FP_ONE/probes/RTT_VIEWRT) and
+ * FP_OFF disable PS prefetch globally at init. A record-thread seen filter
+ * decompiles each variant once; a colliding or stale filter cell only skips
+ * or repeats a prefetch, since replay matches jobs by exact source bytes. */
+static void tj_shader_prefetch_record_fp(const D3D12DrawRecord* dr)
+{
+    static u64 seen[4096];
+    static char hlsl[VP_FP_HLSL_CAPACITY];
+    if (!dr || !dr->fp_addr || !dr->fp_program_valid) return;
+    if (!tj_shader_prefetch_state()->ps_enabled) return;
+    const RSXFPStructuralProgram* program = &dr->fp_program;
+    int nrt = dr_num_rts(dr);
+    if (nrt < 0) nrt = 0;
+    if (nrt > 4) nrt = 4;
+    const int exp32 = dr->fp_exp32;
+    const u64 texture_state = dr_texture_shader_key(dr);
+    const int flat = (dr->cull_key & 0x40u) != 0;
+    const u64 parts[4] = {
+        program->structural_hash, texture_state,
+        ((u64)program->size_bytes << 32) | program->inline_count,
+        (u64)(u32)exp32 | ((u64)(u32)nrt << 32) | ((u64)flat << 40)
+    };
+    u64 vkey = tj_shader_prefetch_hash((const char*)parts, sizeof(parts));
+    if (!vkey) vkey = 1;
+    u64* cell = &seen[vkey & 4095u];
+    if (*cell == vkey) return;
+    *cell = vkey;
+    int n = rsx_fp_decompile_template_tex(program, hlsl, sizeof(hlsl), exp32,
+                                          texture_state, nrt ? nrt : 1);
+    if (n <= 0) return;   /* replay reports the same decompile failure */
+    if (flat) rsx_flat_shade_hlsl(hlsl, sizeof(hlsl));
+    tj_shader_job_release(tj_shader_prefetch_submit(hlsl, strlen(hlsl), "guest_fp",
+                                                    "main", "ps_5_0", 0, 0));
+}
+
+/* Exact cache-hit predicate for vp_get_fp_pso entry i, shared by its full
+ * scan and the TJ_LOOKUP_FASTPATH last-hit probe. It reads that function's
+ * key locals. */
+#define VP_FP_CACHE_EXACT_HIT(i) \
+    (s_d3d.vp_fp[i].fp_addr == fp_addr && s_d3d.vp_fp[i].vs_idx == vs_idx && \
+     s_d3d.vp_fp[i].vs_hash == vs_hash && s_d3d.vp_fp[i].gen == s_d3d.vp_gen && \
+     s_d3d.vp_fp[i].blend == blend && s_d3d.vp_fp[i].nrt == nrt && \
+     s_d3d.vp_fp[i].rtfmt == (u32)rtfmt && s_d3d.vp_fp[i].exp32 == exp32 && \
+     s_d3d.vp_fp[i].structural_hash == structural_hash && \
+     s_d3d.vp_fp[i].structural_size == structural_size && \
+     s_d3d.vp_fp[i].inline_count == inline_count && \
+     s_d3d.vp_fp[i].cmask == cmask && \
+     s_d3d.vp_fp[i].mrt_key == mrt_key && \
+     s_d3d.vp_fp[i].logic_key == logic_key && \
+     s_d3d.vp_fp[i].depth_bias == depth_bias && \
+     s_d3d.vp_fp[i].slope_bias_bits == slope_bias_bits && \
+     s_d3d.vp_fp[i].dsvfmt == (u32)dsvfmt && \
+     s_d3d.vp_fp[i].depth_key == depth_key && \
+     s_d3d.vp_fp[i].stencil_key == stencil_key && \
+     s_d3d.vp_fp[i].cull_key == cull_key && \
+     s_d3d.vp_fp[i].texture_state == texture_state && \
+     s_d3d.vp_fp[i].topology_type == topology_type && \
+     rsx_fp_structural_equal(&s_d3d.vp_fp[i].structural_program, program))
+static int s_vp_fp_last_hit = -1; /* TJ_LOOKUP_FASTPATH: last returned entry */
+/* Dense fp_addr shadow of s_d3d.vp_fp[i].fp_addr, written beside the only
+ * fp_addr writer; lets TJ_LOOKUP_FASTPATH=1 reject most scan entries without
+ * touching the large entries. Every scanned i < vp_fp_n was admitted there. */
+static u32 s_vp_fp_addr[VP_FP_CACHE];
+
+static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, const D3D12DrawRecord* record,
+                                          u32 blend, int nrt,
+                                          DXGI_FORMAT rtfmt, int exp32, u32 cmask,
+                                          u32 mrt_key, u8 logic_key, u32 depth_key,
+                                          u64 stencil_key,
+                                          u8 cull_key, u32 topology)
+{
+    int perf_trace = tj_perf_phase_active();
+    LONGLONG perf_t0 = 0;
+    if (nrt < 0) nrt = 0; if (nrt > 4) nrt = 4;
+    if (rtfmt == 0) rtfmt = DXGI_FORMAT_R8G8B8A8_UNORM;
+    u32 fp_addr = record ? record->fp_addr : 0;
+    const RSXFPStructuralProgram* program =
+        record && record->fp_program_valid ? &record->fp_program : NULL;
+    if (!fp_addr || !program) return NULL;
+    if (perf_trace) perf_t0 = tj_perf_now();
+    { static int _off=-1; if(_off<0)_off=getenv("FP_OFF")?1:0; if(_off) return NULL; }
+    /* Resolve the VS: the draw's cached per-VP blob, else the primary. */
+    ID3DBlob* vsb = NULL; u32 vs_hash = 0;
+    /* A failed prefetched slot keeps vsb NULL and vs_hash 0: the same key
+     * and primary-VS fallback as the synchronous path's vs_idx -1. */
+    if (vs_idx >= 0 && vs_idx < s_d3d.vp_vs_n && vp_vs_resolve(vs_idx)) {
+        vsb = s_d3d.vp_vs[vs_idx].vs; vs_hash = s_d3d.vp_vs[vs_idx].hash;
+    }
+    if (!vsb) { vsb = s_d3d.vp_vs_blob; vs_idx = -1; }
+    if (!vsb) return NULL;
+
+    /* fp_addr stays in the key because address-selected debug/probe HLSL is
+     * injected before compilation. Structural identity deliberately excludes
+     * only inline payload words, so A/B patches at one address share a PSO. */
+    u64 structural_hash = program->structural_hash;
+    u32 structural_size = program->size_bytes;
+    u32 inline_count = program->inline_count;
+    u32 uhash = (u32)(structural_hash ^ (structural_hash >> 32));
+    u64 texture_state = dr_texture_shader_key(record);
+    u32 topology_type = (u32)vp_topology_type(topology);
+    INT depth_bias = record ? record->depth_bias : 0;
+    DXGI_FORMAT dsvfmt = record && record->zeta_pitch && record->zeta_format == 1
+        ? DXGI_FORMAT_D16_UNORM : DXGI_FORMAT_D24_UNORM_S8_UINT;
+    u32 slope_bias_bits = 0;
+    if (record)
+        memcpy(&slope_bias_bits, &record->slope_scaled_depth_bias,
+               sizeof(slope_bias_bits));
+
+    if (perf_trace) {
+        s_tj_perf_phase.fp_hash_ticks += (u64)(tj_perf_now() - perf_t0);
+        s_tj_perf_phase.fp_cache_lookups++;
+    }
+
+    /* The existing fphash timer ends above. Measure only the ordered cache
+     * search here; a hit's entry count is its actual position in the list. */
+    int draw_cost_trace = tj_draw_cost_trace_enabled();
+    LONGLONG fp_search_start = draw_cost_trace
+        ? tj_present_work_trace_sync_begin() : 0;
+    /* TJ_LOOKUP_FASTPATH: test the last returned entry first with the scan's
+     * exact predicate. Entries are admitted only after a full miss and never
+     * re-keyed except by eviction, so at most one entry matches and it is the
+     * one the scan would return. The hit keeps the scan's LRU stamp and
+     * counters, including the entry's scan position for the draw-cost trace. */
+    const int lookup_fast = tj_lookup_fastpath_mode();
+    int fast_fp = -1;
+    if (lookup_fast && s_vp_fp_last_hit >= 0 &&
+        s_vp_fp_last_hit < s_d3d.vp_fp_n &&
+        VP_FP_CACHE_EXACT_HIT(s_vp_fp_last_hit))
+        fast_fp = s_vp_fp_last_hit;
+    if (lookup_fast == 1 && fast_fp >= 0) {
+        s_d3d.vp_fp[fast_fp].last_use = vp_fp_cache_next_stamp();
+        if (perf_trace) s_tj_perf_phase.fp_cache_hits++;
+        if (draw_cost_trace) {
+            ++s_tj_present_work_trace.fp_cache_hits;
+            s_tj_present_work_trace.fp_cache_search_entries += (u64)fast_fp + 1;
+            tj_present_work_trace_sync_finish(fp_search_start,
+                &s_tj_present_work_trace.fp_cache_search_ticks,
+                &s_tj_present_work_trace.fp_cache_search_calls);
+        }
+        return s_d3d.vp_fp[fast_fp].pso;
+    }
+    /* Reject cheap state mismatches before walking either shader program. */
+    for (int i = 0; i < s_d3d.vp_fp_n; i++)
+        if ((lookup_fast != 1 || s_vp_fp_addr[i] == fp_addr) && VP_FP_CACHE_EXACT_HIT(i)) {
+            if (lookup_fast == 2 && fast_fp != i)
+                tj_lookup_fastpath_mismatch("fp_pso", fast_fp, i);
+            if (lookup_fast) s_vp_fp_last_hit = i;
+            s_d3d.vp_fp[i].last_use = vp_fp_cache_next_stamp();
+            if (perf_trace) s_tj_perf_phase.fp_cache_hits++;
+            if (draw_cost_trace) {
+                ++s_tj_present_work_trace.fp_cache_hits;
+                s_tj_present_work_trace.fp_cache_search_entries += (u64)i + 1;
+                tj_present_work_trace_sync_finish(fp_search_start,
+                    &s_tj_present_work_trace.fp_cache_search_ticks,
+                    &s_tj_present_work_trace.fp_cache_search_calls);
+            }
+            return s_d3d.vp_fp[i].pso;
+        }
+    if (lookup_fast == 2 && fast_fp >= 0)
+        tj_lookup_fastpath_mismatch("fp_pso", fast_fp, -1);
+    if (draw_cost_trace) {
+        ++s_tj_present_work_trace.fp_cache_misses;
+        s_tj_present_work_trace.fp_cache_search_entries += s_d3d.vp_fp_n;
+        tj_present_work_trace_sync_finish(fp_search_start,
+            &s_tj_present_work_trace.fp_cache_search_ticks,
+            &s_tj_present_work_trace.fp_cache_search_calls);
+    }
+    if (perf_trace) {
+        s_tj_perf_phase.fp_cache_misses++;
+        perf_t0 = tj_perf_now();
+    }
+    static char hlsl[VP_FP_HLSL_CAPACITY];
+    /* Keep the ordinary colour export for a DSV-only PSO; the output merger
+     * discards it when no RTV is bound. This preserves shader discard/depth
+     * effects without requiring a zero-export decompiler variant. */
+    int n = rsx_fp_decompile_template_tex(program, hlsl, sizeof(hlsl), exp32,
+                                          texture_state, nrt ? nrt : 1);
+    if (perf_trace) s_tj_perf_phase.fp_decompile_ticks += (u64)(tj_perf_now() - perf_t0);
+    if (n <= 0) { static int _e=0; if(_e++<16) printf("[FP] decompile fail (fp=0x%08X)\n", fp_addr); return NULL; }
+    if (cull_key & 0x40u)
+        rsx_flat_shade_hlsl(hlsl, sizeof(hlsl));
+    u8 captured_ucode[RSX_FP_MAX_PROGRAM_BYTES];
+    fp_structural_to_guest_bytes(program, captured_ucode);
+    { u32 target;
+      if (tj_env_u32_hex("FP_DUMP_TARGET", &target) && target == fp_addr)
+          tj_fp_dump_target(fp_addr, record->fp_resolved_off, uhash, vs_idx, vs_hash, blend,
+                            nrt, (u32)rtfmt, exp32, cmask, depth_key,
+                            program, captured_ucode, hlsl); }
+    if (getenv("FP_DUMP")) { static int _d=0; if (_d++ < 4) {
+        FILE* f = fopen("fp_dump.hlsl", _d==1 ? "w" : "a");
+        if (f) {
+            u32 bytes = program->size_bytes < 32u ? program->size_bytes : 32u;
+            fprintf(f, "/* fp_addr=0x%08X record-time raw:", fp_addr);
+            for (u32 _b = 0; _b < bytes; ++_b) fprintf(f, " %02X", captured_ucode[_b]);
+            fprintf(f, " */\n%s\n", hlsl); fclose(f);
+        } } }
+
+    /* The resource scan is intentionally exclusive: it wins over the other
+     * target probes, preventing stacked early returns from becoming ambiguous.
+     * FP_FORCE remains a separate explicit override below. */
+    if (tj_fp_probe_t0_selected(fp_addr)) {
+        int applied = rsx_fp_probe_t0_screen_inject(hlsl, sizeof(hlsl));
+        static unsigned probe_t0_logs;
+        if (probe_t0_logs++ < 16)
+            printf("[TJ-FP-PROBE-T0] fp=0x%08X %s (precedence=zeroq,lategrid,stagegrid,t1)\n",
+                   fp_addr, applied ? "applied" : "declarations-or-marker-missing");
+    } else {
+        if (tj_txp_zeroq_selected(fp_addr)) {
+            int applied = rsx_fp_probe_txp_zeroq_inject(hlsl, sizeof(hlsl));
+            static unsigned txp_zeroq_logs;
+            if (txp_zeroq_logs++ < 16)
+                printf("[TJ-TXP-ZEROQ] fp=0x%08X %s\n", fp_addr,
+                       applied ? "applied" : "exact-marker-missing");
+        }
+        if (tj_fp_probe_lategrid_selected(fp_addr)) {
+            int applied = rsx_fp_probe_lategrid_inject(hlsl, sizeof(hlsl));
+            static unsigned lategrid_logs;
+            if (lategrid_logs++ < 16)
+                printf("[TJ-FP-PROBE-LATEGRID] fp=0x%08X %s\n", fp_addr,
+                       applied ? "applied" : "declarations-or-marker-missing");
+        } else if (tj_fp_probe_stagegrid_selected(fp_addr)) {
+            int applied = rsx_fp_probe_stagegrid_inject(hlsl, sizeof(hlsl));
+            static unsigned stagegrid_logs;
+            if (stagegrid_logs++ < 16)
+                printf("[TJ-FP-PROBE-STAGEGRID] fp=0x%08X %s\n", fp_addr,
+                       applied ? "applied" : "declarations-or-marker-missing");
+        }
+        if (!tj_fp_probe_lategrid_selected(fp_addr) &&
+            !tj_fp_probe_stagegrid_selected(fp_addr) && tj_fp_probe_t1_selected(fp_addr)) {
+            int applied = tj_fp_probe_t1_inject(hlsl, sizeof(hlsl));
+            static unsigned probe_t1_logs;
+            if (probe_t1_logs++ < 16)
+                printf("[TJ-FP-PROBE-T1] fp=0x%08X %s\n", fp_addr,
+                       applied ? "applied" : "declarations-or-marker-missing");
+        }
+    }
+
+    /* Debug FP_ONE=<hex fp_addr>: force that program's colour output to
+     * all-ones (e.g. wave's colour-detect -> full mask -> island borders
+     * everywhere -> the water sim must visibly radiate if it works). */
+    { const char* f1 = getenv("FP_ONE");
+      if (f1 && (u32)strtoul(f1, NULL, 16) == fp_addr) {
+          char* rp = strstr(hlsl, "PSOut _po; _po.c0 = r[0];");
+          if (rp) memcpy(rp, "PSOut _po; _po.c0=(1).xxxx;", 27);
+      } }
+    /* FP_FORCE=1 applies to every translated FP; a hexadecimal program address
+     * applies only to that program.  The injected return bypasses kill/alpha. */
+    if (tj_fp_force_selected(fp_addr)) {
+        int applied = tj_fp_force_inject(hlsl, sizeof(hlsl));
+        static unsigned force_logs;
+        if (force_logs++ < 32)
+            printf("[FP_FORCE] fp=0x%08X %s\n", fp_addr,
+                   applied ? "applied" : "marker-missing");
+    }
+    ID3DBlob* pb = NULL; ID3DBlob* e = NULL;
+    int pb_cache_owned = 0;
+    HRESULT hr = vp_fp_blob_get_or_compile(hlsl, strlen(hlsl), exp32,
+                                           perf_trace, &pb, &e,
+                                           &pb_cache_owned);
+    if (FAILED(hr) || !pb) {
+        static int _e2=0; if (_e2++<16)
+            printf("[FP] PS compile FAIL (fp=0x%08X): %s\n", fp_addr,
+                   e ? (const char*)e->lpVtbl->GetBufferPointer(e) : "?");
+        if (e) e->lpVtbl->Release(e);
+        return NULL;
+    }
+    if (e) e->lpVtbl->Release(e);
+
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    for (int _i = 0; _i < 16; _i++) {
+        il[_i].SemanticName = "ATTR"; il[_i].SemanticIndex = _i;
+        il[_i].Format = DXGI_FORMAT_R32G32B32A32_FLOAT; il[_i].InputSlot = 0;
+        il[_i].AlignedByteOffset = (UINT)(_i * 16);
+        il[_i].InputSlotClass = D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA;
+        il[_i].InstanceDataStepRate = 0;
+    }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = s_d3d.vp_root_sig;
+    pd.VS.pShaderBytecode = vsb->lpVtbl->GetBufferPointer(vsb);
+    pd.VS.BytecodeLength  = vsb->lpVtbl->GetBufferSize(vsb);
+    pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb);
+    pd.PS.BytecodeLength  = pb->lpVtbl->GetBufferSize(pb);
+    pd.InputLayout.pInputElementDescs = il; pd.InputLayout.NumElements = 16;
+    pd.RasterizerState.FillMode = (cull_key & 0x20u)
+        ? D3D12_FILL_MODE_WIREFRAME : D3D12_FILL_MODE_SOLID;
+    switch ((cull_key >> 1) & 3u) {
+    case 1: pd.RasterizerState.CullMode = D3D12_CULL_MODE_FRONT; break;
+    case 2: pd.RasterizerState.CullMode = D3D12_CULL_MODE_BACK; break;
+    default: pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE; break;
+    }
+    pd.RasterizerState.FrontCounterClockwise =
+        (cull_key & 0x08u) ? TRUE : FALSE;
+    pd.RasterizerState.DepthClipEnable = (cull_key & 0x10u) ? TRUE : FALSE;
+    pd.RasterizerState.DepthBias = depth_bias;
+    if (record)
+        pd.RasterizerState.SlopeScaledDepthBias =
+            record->slope_scaled_depth_bias;
+    /* Blend per the guest's packed key (see rsx_blend_key): dbgfont text needs
+     * straight alpha; demosaic's effect passes blend OFF; DeferredShading's
+     * light accumulation is additive ONE,ONE. */
+    pd.BlendState.RenderTarget[0].BlendEnable    = (blend & 1) ? TRUE : FALSE;
+    pd.BlendState.RenderTarget[0].SrcBlend       = (blend & 1) ? (D3D12_BLEND)((blend >> 1)  & 0x1F) : D3D12_BLEND_ONE;
+    pd.BlendState.RenderTarget[0].DestBlend      = (blend & 1) ? (D3D12_BLEND)((blend >> 6)  & 0x1F) : D3D12_BLEND_ZERO;
+    pd.BlendState.RenderTarget[0].BlendOp        = (blend & 1) ? (D3D12_BLEND_OP)((blend >> 21) & 0x7) : D3D12_BLEND_OP_ADD;
+    pd.BlendState.RenderTarget[0].SrcBlendAlpha  = (blend & 1) ? (D3D12_BLEND)((blend >> 11) & 0x1F) : D3D12_BLEND_ONE;
+    pd.BlendState.RenderTarget[0].DestBlendAlpha = (blend & 1) ? (D3D12_BLEND)((blend >> 16) & 0x1F) : D3D12_BLEND_ZERO;
+    pd.BlendState.RenderTarget[0].BlendOpAlpha   = (blend & 1) ? (D3D12_BLEND_OP)((blend >> 24) & 0x7) : D3D12_BLEND_OP_ADD;
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    if (logic_key & 1u) {
+        D3D12_LOGIC_OP logic_op =
+            (D3D12_LOGIC_OP)((logic_key >> 1u) & 0x1Fu);
+        pd.BlendState.RenderTarget[0].BlendEnable = FALSE;
+        /* COPY is the ordinary unblended write; do not require optional
+         * output-merger logic-op format support for that exact operation. */
+        if (logic_op != D3D12_LOGIC_OP_COPY) {
+            pd.BlendState.RenderTarget[0].LogicOpEnable = TRUE;
+            pd.BlendState.RenderTarget[0].LogicOp = logic_op;
+        }
+    }
+    pd.BlendState.IndependentBlendEnable = nrt > 1 ? TRUE : FALSE;
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = (D3D12_PRIMITIVE_TOPOLOGY_TYPE)topology_type;
+    pd.NumRenderTargets = (UINT)nrt;
+    for (int _r = 0; _r < nrt; _r++) {
+        pd.RTVFormats[_r] = rtfmt;
+        /* Share factors/equations, then apply RSX per-target enables/masks. */
+        pd.BlendState.RenderTarget[_r] = pd.BlendState.RenderTarget[0];
+        if (_r > 0)
+            pd.BlendState.RenderTarget[_r].BlendEnable =
+                (mrt_key & (1u << (15u + (u32)_r))) ? TRUE : FALSE;
+        if (logic_key & 1u)
+            pd.BlendState.RenderTarget[_r].BlendEnable = FALSE;
+        pd.BlendState.RenderTarget[_r].RenderTargetWriteMask =
+            (UINT8)((mrt_key >> ((u32)_r * 4u)) & 0xFu);
+    }
+    pd.DSVFormat = dsvfmt;
+    pd.DepthStencilState.DepthEnable = (depth_key & 1u) ? TRUE : FALSE;
+    pd.DepthStencilState.DepthWriteMask = (depth_key & 2u)
+        ? D3D12_DEPTH_WRITE_MASK_ALL : D3D12_DEPTH_WRITE_MASK_ZERO;
+    pd.DepthStencilState.DepthFunc = rsx_depth_func_d3d(depth_key >> 8);
+    pd.DepthStencilState.StencilEnable =
+        dsvfmt == DXGI_FORMAT_D24_UNORM_S8_UINT && (stencil_key & 1ull)
+            ? TRUE : FALSE;
+    pd.DepthStencilState.StencilReadMask = (UINT8)((stencil_key >> 17) & 0xFFu);
+    pd.DepthStencilState.StencilWriteMask = (UINT8)((stencil_key >> 25) & 0xFFu);
+    pd.DepthStencilState.FrontFace.StencilFunc =
+        (D3D12_COMPARISON_FUNC)((stencil_key >> 1) & 0xFu);
+    pd.DepthStencilState.FrontFace.StencilFailOp =
+        (D3D12_STENCIL_OP)((stencil_key >> 5) & 0xFu);
+    pd.DepthStencilState.FrontFace.StencilDepthFailOp =
+        (D3D12_STENCIL_OP)((stencil_key >> 9) & 0xFu);
+    pd.DepthStencilState.FrontFace.StencilPassOp =
+        (D3D12_STENCIL_OP)((stencil_key >> 13) & 0xFu);
+    if (stencil_key & (1ull << 33)) {
+        pd.DepthStencilState.BackFace.StencilFunc =
+            (D3D12_COMPARISON_FUNC)((stencil_key >> 34) & 0xFu);
+        pd.DepthStencilState.BackFace.StencilFailOp =
+            (D3D12_STENCIL_OP)((stencil_key >> 38) & 0xFu);
+        pd.DepthStencilState.BackFace.StencilDepthFailOp =
+            (D3D12_STENCIL_OP)((stencil_key >> 42) & 0xFu);
+        pd.DepthStencilState.BackFace.StencilPassOp =
+            (D3D12_STENCIL_OP)((stencil_key >> 46) & 0xFu);
+    } else {
+        pd.DepthStencilState.BackFace = pd.DepthStencilState.FrontFace;
+    }
+    pd.SampleDesc.Count = 1;
+
+    ID3D12PipelineState* pso = NULL;
+    if (perf_trace) perf_t0 = tj_perf_now();
+    const LONGLONG pso_trace_start = tj_present_work_trace_sync_begin();
+    hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+        s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&pso);
+    tj_present_work_trace_sync_finish(pso_trace_start,
+        &s_tj_present_work_trace.pso_create_ticks,
+        &s_tj_present_work_trace.pso_create_calls);
+    if (perf_trace) s_tj_perf_phase.fp_pso_ticks += (u64)(tj_perf_now() - perf_t0);
+    if (tj_fp_pso_trace_enabled()) {
+        static unsigned attempts;
+        if (attempts++ < 64u) {
+            const u64 vs_bytecode_hash = vp_fp_blob_hash(
+                (const char*)pd.VS.pShaderBytecode, pd.VS.BytecodeLength);
+            const u64 ps_bytecode_hash = vp_fp_blob_hash(
+                (const char*)pd.PS.pShaderBytecode, pd.PS.BytecodeLength);
+            printf("[TJ-FP-PSO] hr=0x%08lX fp=0x%08X vs_idx=%d vs_hash=0x%08X "
+                   "vs_len=%zu vs_fnv=0x%016llX ps_len=%zu ps_fnv=0x%016llX "
+                   "pb_cache_owned=%d "
+                   "nrt=%d rtfmt=0x%08X exp32=%d cmask=0x%08X blend=0x%08X "
+                   "mrt_key=0x%08X logic_key=0x%02X depth_key=0x%08X "
+                   "stencil_key=0x%016llX cull_key=0x%02X topology=0x%08X "
+                   "topology_type=%u dsvfmt=0x%08X depth_bias=%d "
+                   "slope_bias_bits=0x%08X texture_state=0x%016llX "
+                   "structural_hash=0x%016llX structural_size=%u inline_count=%u\n",
+                   hr, fp_addr, vs_idx, vs_hash,
+                   pd.VS.BytecodeLength, (unsigned long long)vs_bytecode_hash,
+                   pd.PS.BytecodeLength, (unsigned long long)ps_bytecode_hash,
+                   pb_cache_owned,
+                   nrt, (u32)rtfmt, exp32, cmask, blend,
+                   mrt_key, logic_key, depth_key, (unsigned long long)stencil_key,
+                   cull_key, topology, topology_type, (u32)dsvfmt, depth_bias,
+                   slope_bias_bits, (unsigned long long)texture_state,
+                   (unsigned long long)structural_hash, structural_size, inline_count);
+        }
+    }
+    if (!pb_cache_owned) pb->lpVtbl->Release(pb);
+    if (FAILED(hr)) {
+        static int _e3=0; if (_e3++<16) printf("[FP] PSO FAIL (fp=0x%08X, 0x%08lX)\n", fp_addr, hr);
+        d3d12_dump_device_failure("guest-fp-pso", hr);
+        return NULL;
+    }
+    { static int _ok=0; if (_ok++<32) printf("[FP] guest FP pipeline ready (fp=0x%08X)\n", fp_addr); }
+
+    /* Admit only a successfully created PSO; retain the requested full key. */
+    if (s_d3d.vp_fp_n >= VP_FP_CACHE && perf_trace)
+        s_tj_perf_phase.fp_cache_evictions++;
+    int fp_slot = vp_fp_cache_insert_slot();
+    s_d3d.vp_fp[fp_slot].fp_addr = fp_addr;
+    s_vp_fp_addr[fp_slot] = fp_addr;
+    s_d3d.vp_fp[fp_slot].vs_idx  = vs_idx;
+    s_d3d.vp_fp[fp_slot].vs_hash = vs_hash;
+    s_d3d.vp_fp[fp_slot].gen     = s_d3d.vp_gen;
+    s_d3d.vp_fp[fp_slot].blend   = blend;
+    s_d3d.vp_fp[fp_slot].nrt     = nrt;
+    s_d3d.vp_fp[fp_slot].rtfmt   = (u32)rtfmt;
+    s_d3d.vp_fp[fp_slot].exp32   = exp32;
+    s_d3d.vp_fp[fp_slot].structural_hash = structural_hash;
+    s_d3d.vp_fp[fp_slot].structural_size = structural_size;
+    s_d3d.vp_fp[fp_slot].inline_count = inline_count;
+    s_d3d.vp_fp[fp_slot].structural_program = *program;
+    s_d3d.vp_fp[fp_slot].cmask   = cmask;
+    s_d3d.vp_fp[fp_slot].mrt_key = mrt_key;
+    s_d3d.vp_fp[fp_slot].logic_key = logic_key;
+    s_d3d.vp_fp[fp_slot].depth_bias = depth_bias;
+    s_d3d.vp_fp[fp_slot].slope_bias_bits = slope_bias_bits;
+    s_d3d.vp_fp[fp_slot].dsvfmt = (u32)dsvfmt;
+    s_d3d.vp_fp[fp_slot].depth_key = depth_key;
+    s_d3d.vp_fp[fp_slot].stencil_key = stencil_key;
+    s_d3d.vp_fp[fp_slot].cull_key = cull_key;
+    s_d3d.vp_fp[fp_slot].texture_state = texture_state;
+    s_d3d.vp_fp[fp_slot].topology_type = topology_type;
+    s_d3d.vp_fp[fp_slot].pso = pso;
+    s_d3d.vp_fp[fp_slot].last_use = vp_fp_cache_next_stamp();
+    if (lookup_fast) s_vp_fp_last_hit = fp_slot;
+    return pso;
+}
+#undef VP_FP_CACHE_EXACT_HIT
+
+/* Upload the guest texture for a VP draw into a per-frame texture slot
+ * (re-uploaded every frame: gcm/cube's plasma animates in guest memory).
+ * Returns the slot index (SRV at heap VP_TEX_SRV_BASE+slot) or -1. Must run while the
+ * command list is open, before the draw passes. */
+static u32 rsx_special_16bit_remap(u32 control1);
+
+/* Apply the format-defined CONTROL1 remaps before consuming the component
+ * crossbar. X16/Y16_X16/HILO use the special two-channel encoding; floating
+ * formats have fixed hardware mappings. G8B8 uses ordinary CONTROL1 remap. */
+static u32 rsx_texture_control1_normalize(u32 control1, u32 basef)
+{
+    switch (basef) {
+    case 0x9Au: /* W16_Z16_Y16_X16_FLOAT */
+    case 0x9Bu: /* W32_Z32_Y32_X32_FLOAT */
+    case 0x9Cu: /* X32_FLOAT */
+        control1 = (control1 & ~0xFFu) | 0xE4u;
+        break;
+    case 0x9Fu: /* Y16_X16_FLOAT */
+        control1 = (control1 & 0xFF00u) |
+            ((control1 >> 16u) ? 0x56u : 0x66u);
+        break;
+    case 0x94u: /* X16 */
+    case 0x95u: /* Y16_X16 */
+    case 0x98u: /* COMPRESSED_HILO8 */
+    case 0x99u: /* COMPRESSED_HILO_S8 */
+        control1 = rsx_special_16bit_remap(control1);
+        break;
+    default:
+        break;
+    }
+    control1 &= 0xFFFFu;
+    return control1 ? control1 : 0xAAE4u;
+}
+
+/* NV4097 TEXTURE_CONTROL1 component remap -> D3D12 Shader4ComponentMapping.
+ * Low byte = crossbar: bits[1:0] select the SOURCE (0=A,1=R,2=G,3=B) for
+ * output A, [3:2] for R, [5:4] for G, [7:6] for B. Next byte = per-output op:
+ * 0 = force ZERO, 1 = force ONE, 2 = use crossbar (identity word = 0xAAE4).
+ * Our uploaded resource holds guest R,G,B,A at comps 0,1,2,3. */
+static u32 rsx_remap_to_d3d_ex(u32 c1, u32 basef, int forced_alpha)
+{
+    /* The four low-byte fields are A,R,G,B, LSB first. Source selectors also
+     * name the presented {A,R,G,B} vector. All host uploads and BC decoders
+     * expose RGBA, so translate that vector to resource components 3,0,1,2. */
+    static const u8 lanes_argb[4] = {3, 0, 1, 2};
+    /* B8 presents the byte in RGB and constant one in alpha. */
+    static const u8 lanes_b8[4] = {5, 0, 0, 0};
+    /* G8B8/Y16_X16 expose RGBA={G,R,G,R}; HILO/Y16_X16_FLOAT expose
+     * RGBA={R,G,R,G}. These are the canonical RSX base-format swizzles. */
+    static const u8 lanes_g8b8[4] = {0, 1, 0, 1};
+    static const u8 lanes_hilo[4] = {1, 0, 1, 0};
+    static const u8 lanes_scalar[4] = {0, 0, 0, 0};
+    static const u8 lanes_x16[4] = {5, 0, 5, 0};
+    static const u8 lanes_y16x16[4] = {0, 1, 0, 1};
+    const u8* src2res = lanes_argb;
+    if (basef == 0x81)
+        src2res = lanes_b8;
+    else if (basef == 0x8B)
+        src2res = lanes_g8b8;
+    else if (basef == 0x98 || basef == 0x99 || basef == 0x9F)
+        src2res = lanes_hilo;
+    else if (basef == 0x90 || basef == 0x92 || basef == 0x9C)
+        src2res = lanes_scalar;
+    else if (basef == 0x94)
+        src2res = lanes_x16;
+    else if (basef == 0x95)
+        src2res = lanes_y16x16;
+    c1 = rsx_texture_control1_normalize(c1, basef);
+    u32 out[4];                                    /* outputs A,R,G,B */
+    for (int i = 0; i < 4; i++) {
+        u32 s = (c1 >> (i * 2)) & 3, op = (c1 >> (8 + i * 2)) & 3;
+        out[i] = (op == 0) ? 4u : (op == 1) ? 5u
+               : (forced_alpha >= 0 && s == 0u) ? (u32)(4 + forced_alpha)
+               : (u32)src2res[s];
+    }
+    /* D3D12 mapping: destR | destG<<3 | destB<<6 | destA<<9 | valid bit */
+    return out[1] | (out[2] << 3) | (out[3] << 6) | (out[0] << 9) | (1u << 12);
+}
+
+static u32 rsx_remap_to_d3d(u32 c1, u32 basef)
+{
+    return rsx_remap_to_d3d_ex(c1, basef, -1);
+}
+
+/* Surface X channels are defined constants. D1/D8 texture formats also force
+ * one regardless of which compatible surface produced the resource. */
+static u32 rsx_rt_remap_to_d3d(u32 c1, u32 basef, u32 surface_fmt)
+{
+    int forced_alpha = -1;
+    if (basef == 0x9D || basef == 0x9E)
+        forced_alpha = 1;
+    else {
+        switch (surface_fmt & 0x1Fu) {
+        case 0x01: case 0x04: case 0x0E: forced_alpha = 0; break;
+        case 0x02: case 0x05: case 0x0F: forced_alpha = 1; break;
+        default: break;
+        }
+    }
+    return rsx_remap_to_d3d_ex(c1, basef, forced_alpha);
+}
+
+static D3D12_TEXTURE_ADDRESS_MODE rsx_sampler_address_d3d(u32 mode)
+{
+    switch (mode & 0xFu) {
+    case 1: return D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+    case 2: return D3D12_TEXTURE_ADDRESS_MODE_MIRROR;
+    case 3: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;       /* clamp-to-edge */
+    case 4: return D3D12_TEXTURE_ADDRESS_MODE_BORDER;
+    case 5: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    case 6: /* mirror-once clamp-to-edge */
+        return D3D12_TEXTURE_ADDRESS_MODE_MIRROR_ONCE;
+    case 7: /* mirror-once border: D3D12 has no mirrored border mode */
+        return D3D12_TEXTURE_ADDRESS_MODE_BORDER;
+    case 8: /* mirror-once clamp: closest D3D12 mode; half-texel clamp differs */
+        return D3D12_TEXTURE_ADDRESS_MODE_MIRROR_ONCE;
+    default: return D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    }
+}
+
+/* RSX texture Z compares are encoded as sampled-depth OP reference. D3D12
+ * SampleCmp applies reference OP sampled-depth, so ordered functions reverse. */
+static D3D12_COMPARISON_FUNC rsx_texture_compare_d3d(u32 zfunc)
+{
+    switch (zfunc & 0xFu) {
+    case 0: return D3D12_COMPARISON_FUNC_NEVER;
+    case 1: return D3D12_COMPARISON_FUNC_GREATER;
+    case 2: return D3D12_COMPARISON_FUNC_EQUAL;
+    case 3: return D3D12_COMPARISON_FUNC_GREATER_EQUAL;
+    case 4: return D3D12_COMPARISON_FUNC_LESS;
+    case 5: return D3D12_COMPARISON_FUNC_NOT_EQUAL;
+    case 6: return D3D12_COMPARISON_FUNC_LESS_EQUAL;
+    case 7: return D3D12_COMPARISON_FUNC_ALWAYS;
+    default: return D3D12_COMPARISON_FUNC_ALWAYS;
+    }
+}
+
+/* TEXTURE_BORDER_COLOR is AARRGGBB. The texture format's border-type bit is
+ * captured even though D3D12's legacy sampler desc only accepts float values.
+ * Float textures use the documented 8-bit normalized register colour; signed
+ * channels use the TEXTURE_FILTER ARGB signed flags. Leave component mapping
+ * to the SRV so the RSX swizzle is applied exactly once. */
+static void rsx_sampler_border_color(u32 border, u32 filter, u32 fmt,
+                                     u32 border_type, float out[4])
+{
+    const u32 basef = fmt & 0x9Fu;
+    const int float_format = basef == 0x9Au || basef == 0x9Bu ||
+        basef == 0x9Cu || basef == 0x9Fu || basef == 0x91u || basef == 0x93u;
+    const int signed_format = basef == 0x99u;
+    const u8 raw_argb[4] = {
+        (u8)(border >> 24), (u8)(border >> 16),
+        (u8)(border >> 8), (u8)border
+    };
+    float argb[4];
+    for (u32 i = 0; i < 4u; ++i) {
+        const int signed_channel = !float_format &&
+            (signed_format || (border_type && ((filter >> (28u + i)) & 1u)));
+        if (signed_channel) {
+            const int value = (signed char)raw_argb[i];
+            argb[i] = value < -127 ? -1.0f : (float)value / 127.0f;
+        } else {
+            argb[i] = (float)raw_argb[i] / 255.0f;
+        }
+    }
+    out[0] = argb[1]; out[1] = argb[2];
+    out[2] = argb[3]; out[3] = argb[0];
+}
+
+static void rsx_sampler_desc(u32 address, u32 control0, u32 filter,
+                             u32 border, u32 fmt, u32 border_type,
+                             int comparison,
+                             D3D12_SAMPLER_DESC* out)
+{
+    static const UINT anisotropy[8] = { 1, 2, 4, 6, 8, 10, 12, 16 };
+    memset(out, 0, sizeof(*out));
+    u32 minf = (filter >> 16) & 7u;
+    u32 magf = (filter >> 24) & 7u;
+    int min_linear = minf == 2 || minf == 4 || minf == 6 || minf == 7;
+    int mag_linear = magf == 2 || magf == 4;
+    int mip_linear = minf == 5 || minf == 6 || minf == 7;
+    /* D3D12 basic-filter encoding: mip=bit0, mag=bit2, min=bit4. */
+    out->Filter = (D3D12_FILTER)((mip_linear ? 0x01 : 0) |
+                                 (mag_linear ? 0x04 : 0) |
+                                 (min_linear ? 0x10 : 0));
+    out->AddressU = rsx_sampler_address_d3d(address);
+    out->AddressV = rsx_sampler_address_d3d(address >> 8);
+    out->AddressW = rsx_sampler_address_d3d(address >> 16);
+    int bias = (int)(filter & 0x1FFFu);
+    if (bias & 0x1000) bias -= 0x2000;
+    out->MipLODBias = (float)bias / 256.0f;
+    out->MaxAnisotropy = anisotropy[(control0 >> 4) & 7u];
+    if (out->MaxAnisotropy > 1)
+        out->Filter = comparison ? D3D12_FILTER_COMPARISON_ANISOTROPIC
+                                 : D3D12_FILTER_ANISOTROPIC;
+    else if (comparison)
+        out->Filter = (D3D12_FILTER)((u32)out->Filter | 0x80u);
+    out->ComparisonFunc = comparison
+        ? rsx_texture_compare_d3d(address >> 28)
+        : D3D12_COMPARISON_FUNC_ALWAYS;
+    rsx_sampler_border_color(border, filter, fmt, border_type,
+                             out->BorderColor);
+    out->MinLOD = (float)((control0 >> 19) & 0xFFFu) / 256.0f;
+    out->MaxLOD = (float)((control0 >> 7) & 0xFFFu) / 256.0f;
+    if (out->MaxLOD < out->MinLOD) out->MaxLOD = out->MinLOD;
+}
+
+static void rsx_vertex_sampler_desc(u32 address, u32 control0, u32 filter,
+                                    u32 border, u32 fmt, u32 border_type,
+                                    D3D12_SAMPLER_DESC* out)
+{
+    rsx_sampler_desc(address, control0, filter, border, fmt, border_type,
+                     0, out);
+    /* NV4097 vertex texture filtering is fixed to nearest. FILTER contributes
+     * signed LOD bias only; its fragment min/mag fields are not applicable. */
+    out->Filter = D3D12_FILTER_MIN_MAG_MIP_POINT;
+    out->MaxAnisotropy = 1;
+}
+
+static ID3D12DescriptorHeap* sampler_heap_get(u32 page)
+{
+    if (page >= SAMPLER_HEAP_PAGE_COUNT) return NULL;
+    if (!s_d3d.sampler_heaps[page]) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        HRESULT hr;
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+        hd.NumDescriptors = SAMPLER_HEAP_SIZE;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+            s_d3d.device, &hd, &IID_ID3D12DescriptorHeap,
+            (void**)&s_d3d.sampler_heaps[page]);
+        if (FAILED(hr)) {
+            fprintf(stderr, "[D3D12] sampler heap page %u creation failed (0x%08lX)\n",
+                    page, hr);
+            if (s_d3d.prefix_owner_active)
+                (void)d3d12_command_result_checked(hr, "prefix owner sampler page create");
+            return NULL;
+        }
+    }
+    return s_d3d.sampler_heaps[page];
+}
+
+/* TJ_LOOKUP_FASTPATH: last returned sampler table + 1, or 0. */
+static u32 s_sampler_table_last_plus1 = 0;
+
+static u16 sampler_table_get(const D3D12DrawRecord* dr)
+{
+    const int sampler_cost = tj_prefix_sampler_cost_enabled();
+    const unsigned sampler_reason = sampler_cost
+        ? tj_prefix_sampler_cost_reason() : 0;
+    const unsigned sampler_heap = sampler_cost
+        ? tj_prefix_sampler_cost_heap() : 0;
+    const LONGLONG sampler_lookup_start = sampler_cost
+        ? tj_prefix_sampler_cost_lookup_begin(sampler_reason, sampler_heap) : 0;
+    u32 key[DRAW_TEXTURE_COUNT * SAMPLER_KEY_WORDS] = {0};
+    for (int u = 0; u < RSX_MAX_TEXTURES; u++) {
+        if (!dr->tex[u].set) continue;
+        key[u * SAMPLER_KEY_WORDS + 0] = dr->tex[u].address;
+        key[u * SAMPLER_KEY_WORDS + 1] = dr->tex[u].control0;
+        key[u * SAMPLER_KEY_WORDS + 2] = dr->tex[u].filter;
+        key[u * SAMPLER_KEY_WORDS + 3] = dr->tex[u].border_color;
+        key[u * SAMPLER_KEY_WORDS + 4] =
+            (u32)rsx_fragment_texture_shadow_compare(dr, (u32)u);
+        key[u * SAMPLER_KEY_WORDS + 5] = dr->tex[u].border_type;
+        key[u * SAMPLER_KEY_WORDS + 6] = dr->tex[u].fmt;
+        key[u * SAMPLER_KEY_WORDS + 7] = dr->tex[u].ctrl1;
+    }
+    for (int u = 0; u < RSX_MAX_VERTEX_TEXTURES; u++) {
+        int k = RSX_MAX_TEXTURES + u;
+        if (!dr->vtex[u].set) continue;
+        key[k * SAMPLER_KEY_WORDS + 0] = dr->vtex[u].address;
+        key[k * SAMPLER_KEY_WORDS + 1] = dr->vtex[u].control0;
+        key[k * SAMPLER_KEY_WORDS + 2] = dr->vtex[u].filter;
+        key[k * SAMPLER_KEY_WORDS + 3] = dr->vtex[u].border_color;
+        key[k * SAMPLER_KEY_WORDS + 5] = dr->vtex[u].border_type;
+        key[k * SAMPLER_KEY_WORDS + 6] = dr->vtex[u].fmt;
+        key[k * SAMPLER_KEY_WORDS + 7] = dr->vtex[u].ctrl1;
+    }
+    /* TJ_LOOKUP_FASTPATH: test the last returned table first with the scan's
+     * exact key compare. Tables are appended only after a full miss, so keys
+     * are unique and a match is the index the scan would return. */
+    const int lookup_fast = tj_lookup_fastpath_mode();
+    int fast_table = -1;
+    if (lookup_fast && s_sampler_table_last_plus1 &&
+        s_sampler_table_last_plus1 <= s_d3d.sampler_table_count &&
+        memcmp(s_d3d.sampler_keys[s_sampler_table_last_plus1 - 1u], key,
+               sizeof(key)) == 0)
+        fast_table = (int)(s_sampler_table_last_plus1 - 1u);
+    if (lookup_fast == 1 && fast_table >= 0) {
+        if (sampler_cost) {
+            ++s_tj_prefix_sampler_cost.exact_hits[sampler_reason][sampler_heap];
+            tj_prefix_sampler_cost_finish(sampler_reason, sampler_heap,
+                                          sampler_lookup_start, 0);
+        }
+        return (u16)fast_table;
+    }
+    for (u32 i = 0; i < s_d3d.sampler_table_count; i++)
+        if (memcmp(s_d3d.sampler_keys[i], key, sizeof(key)) == 0) {
+            if (lookup_fast == 2 && fast_table != (int)i)
+                tj_lookup_fastpath_mismatch("sampler_table", fast_table, i);
+            if (lookup_fast) s_sampler_table_last_plus1 = i + 1u;
+            if (sampler_cost) {
+                ++s_tj_prefix_sampler_cost.exact_hits[sampler_reason][sampler_heap];
+                tj_prefix_sampler_cost_finish(sampler_reason, sampler_heap,
+                                              sampler_lookup_start, 0);
+            }
+            return (u16)i;
+        }
+    if (lookup_fast == 2 && fast_table >= 0)
+        tj_lookup_fastpath_mismatch("sampler_table", fast_table, -1);
+
+    if (s_d3d.sampler_table_count >= MAX_DRAWS) {
+        static unsigned full_logs = 0;
+        if (full_logs++ < 8)
+            fprintf(stderr, "[D3D12] sampler table capacity exhausted\n");
+        if (sampler_cost) {
+            ++s_tj_prefix_sampler_cost.capacity_failures[sampler_reason][sampler_heap];
+            tj_prefix_sampler_cost_finish(sampler_reason, sampler_heap,
+                                          sampler_lookup_start, 0);
+        }
+        return 0;
+    }
+    u32 table = s_d3d.sampler_table_count;
+    u32 page = table / SAMPLER_TABLE_CAP;
+    u32 slot = table % SAMPLER_TABLE_CAP;
+    ID3D12DescriptorHeap* heap = sampler_heap_get(page);
+    if (!heap) {
+        static unsigned heap_logs = 0;
+        if (heap_logs++ < 8)
+            fprintf(stderr, "[D3D12] sampler heap page %u unavailable\n", page);
+        if (sampler_cost) {
+            ++s_tj_prefix_sampler_cost.heap_failures[sampler_reason][sampler_heap];
+            tj_prefix_sampler_cost_finish(sampler_reason, sampler_heap,
+                                          sampler_lookup_start, 0);
+        }
+        return 0;
+    }
+    const LONGLONG descriptor_start = sampler_cost
+        ? tj_prefix_sampler_cost_qpc() : 0;
+    s_d3d.sampler_table_count++;
+    memcpy(s_d3d.sampler_keys[table], key, sizeof(key));
+    if (lookup_fast) s_sampler_table_last_plus1 = table + 1u;
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(heap, &h);
+    h.ptr += (u64)slot * DRAW_TEXTURE_COUNT * s_d3d.sampler_inc;
+    for (int u = 0; u < DRAW_TEXTURE_COUNT; u++) {
+        D3D12_SAMPLER_DESC desc;
+        if (u < RSX_MAX_TEXTURES)
+            rsx_sampler_desc(key[u * SAMPLER_KEY_WORDS + 0],
+                             key[u * SAMPLER_KEY_WORDS + 1],
+                             key[u * SAMPLER_KEY_WORDS + 2],
+                             key[u * SAMPLER_KEY_WORDS + 3],
+                             key[u * SAMPLER_KEY_WORDS + 6],
+                             key[u * SAMPLER_KEY_WORDS + 5],
+                             key[u * SAMPLER_KEY_WORDS + 4] != 0, &desc);
+        else
+            rsx_vertex_sampler_desc(key[u * SAMPLER_KEY_WORDS + 0],
+                                    key[u * SAMPLER_KEY_WORDS + 1],
+                                    key[u * SAMPLER_KEY_WORDS + 2],
+                                    key[u * SAMPLER_KEY_WORDS + 3],
+                                    key[u * SAMPLER_KEY_WORDS + 6],
+                                    key[u * SAMPLER_KEY_WORDS + 5], &desc);
+        s_d3d.device->lpVtbl->CreateSampler(s_d3d.device, &desc, h);
+        h.ptr += s_d3d.sampler_inc;
+    }
+    if (sampler_cost) {
+        ++s_tj_prefix_sampler_cost.new_tables[sampler_reason][sampler_heap];
+        s_tj_prefix_sampler_cost.create_sampler_writes[sampler_reason][sampler_heap] +=
+            DRAW_TEXTURE_COUNT;
+        tj_prefix_sampler_cost_finish(sampler_reason, sampler_heap,
+                                      sampler_lookup_start, descriptor_start);
+    }
+    return (u16)table;
+}
+
+/* Morton/Z-order texel offset for RSX swizzled textures (LN bit clear).
+ * Interleaves x (even bit positions) and y (odd) until the smaller dimension's
+ * bits run out, then the larger dimension's remaining bits ride above -- the
+ * NV40 layout (matches RPCS3 convert_linear_swizzle). POT dims only, which is
+ * what the hardware requires for swizzled textures. */
+static inline u32 rsx_swz_off(u32 x, u32 y, u32 log2w, u32 log2h)
+{
+    u32 off = 0, shift = 0;
+    while (log2w && log2h) {
+        off |= (x & 1u) << shift; x >>= 1; shift++;
+        off |= (y & 1u) << shift; y >>= 1; shift++;
+        log2w--; log2h--;
+    }
+    off |= (x | y) << shift;     /* only one of x/y still has bits */
+    return off;
+}
+static inline u32 rsx_swz3_off(u32 x, u32 y, u32 z,
+                               u32 log2w, u32 log2h, u32 log2d)
+{
+    u32 off = 0, shift = 0;
+    while (log2w || log2h || log2d) {
+        if (log2w) { off |= (x & 1u) << shift++; x >>= 1; --log2w; }
+        if (log2h) { off |= (y & 1u) << shift++; y >>= 1; --log2h; }
+        if (log2d) { off |= (z & 1u) << shift++; z >>= 1; --log2d; }
+    }
+    return off;
+}
+static inline u32 rsx_log2u(u32 v) { u32 l = 0; while ((1u << l) < v) l++; return l; }
+
+/* Hash only source bytes consumed by the upload conversion: contiguous Morton
+ * storage for swizzled textures, and logical row bytes (not row padding) for
+ * linear/DXT sources. This keeps dynamic guest textures live while letting
+ * static title/menu art stay in its existing PSR resource. */
+static u64 vp_tex_source_hash(const u8* src, u32 row_bytes, u32 rows,
+                              u32 src_pitch, int contiguous)
+{
+    int perf = tj_perf_trace_enabled();
+    LONGLONG perf_start = perf ? tj_perf_now() : 0;
+    rsx_stream_hash64_state hash_state;
+    rsx_stream_hash64_init(&hash_state);
+    if (contiguous) {
+        rsx_stream_hash64_update(&hash_state, src,
+                                 (size_t)((u64)row_bytes * rows));
+    } else {
+        for (u32 y = 0; y < rows; y++) {
+            const u8* row = src + (u64)y * src_pitch;
+            rsx_stream_hash64_update(&hash_state, row, row_bytes);
+        }
+    }
+    u64 hash = rsx_stream_hash64_digest(&hash_state);
+    if (perf) {
+        s_tj_perf_phase.tex_hash_ticks += (u64)(tj_perf_now() - perf_start);
+        s_tj_perf_phase.tex_hash_calls++;
+        s_tj_perf_phase.tex_hash_bytes += (u64)row_bytes * rows;
+    }
+    return hash;
+}
+
+#define TJ_TEX_DUMP_MAX 32
+typedef struct {
+    u32 fp_addr, off, fmt, w, h;
+    u64 hash;
+} TjTexDumpKey;
+static TjTexDumpKey s_tj_tex_dump_keys[TJ_TEX_DUMP_MAX];
+static unsigned s_tj_tex_dump_count;
+
+static int tj_tex_dump_selected(u32 fp_addr)
+{
+    static int initialized = 0, enabled = 0;
+    static u32 target;
+    if (!initialized) {
+        enabled = tj_env_u32_hex("TJ_TEX_DUMP_FP", &target);
+        initialized = 1;
+    }
+    return enabled && target == fp_addr;
+}
+
+static int tj_tex_dump_claim(u32 fp_addr, u32 off, u32 fmt, u32 w, u32 h,
+                             u64 hash)
+{
+    for (unsigned i = 0; i < s_tj_tex_dump_count; ++i) {
+        TjTexDumpKey* key = &s_tj_tex_dump_keys[i];
+        if (key->fp_addr == fp_addr && key->off == off && key->fmt == fmt &&
+            key->w == w && key->h == h && key->hash == hash)
+            return 0;
+    }
+    if (s_tj_tex_dump_count >= TJ_TEX_DUMP_MAX) return 0;
+    s_tj_tex_dump_keys[s_tj_tex_dump_count++] =
+        (TjTexDumpKey){fp_addr, off, fmt, w, h, hash};
+    return 1;
+}
+
+static void tj_le16(u8* dst, u16 value)
+{
+    dst[0] = (u8)value; dst[1] = (u8)(value >> 8);
+}
+
+static void tj_le32(u8* dst, u32 value)
+{
+    dst[0] = (u8)value; dst[1] = (u8)(value >> 8);
+    dst[2] = (u8)(value >> 16); dst[3] = (u8)(value >> 24);
+}
+
+static int tj_tex_write_bmp(const char* path, const u8* src, u32 w, u32 h,
+                            u32 pitch, int swizzled)
+{
+    FILE* f = fopen(path, "wb");
+    if (!f) return 0;
+    u32 row = (w * 3u + 3u) & ~3u;
+    u64 bytes64 = 54ull + (u64)row * h;
+    if (bytes64 > 0xFFFFFFFFu) { fclose(f); return 0; }
+    u8 hdr[54] = {0};
+    hdr[0] = 'B'; hdr[1] = 'M';
+    tj_le32(hdr + 2, (u32)bytes64); tj_le32(hdr + 10, 54);
+    tj_le32(hdr + 14, 40); tj_le32(hdr + 18, w); tj_le32(hdr + 22, h);
+    tj_le16(hdr + 26, 1); tj_le16(hdr + 28, 24);
+    if (fwrite(hdr, 1, sizeof(hdr), f) != sizeof(hdr)) { fclose(f); return 0; }
+    u8 zero[3] = {0};
+    u32 lw = rsx_log2u(w), lh = rsx_log2u(h);
+    for (u32 yy = h; yy-- > 0;) {
+        for (u32 x = 0; x < w; ++x) {
+            const u8* p = swizzled ? src + (u64)rsx_swz_off(x, yy, lw, lh) * 4
+                                    : src + (u64)yy * pitch + x * 4;
+            /* A,R,G,B guest source -> RGBA upload; BMP is B,G,R. */
+            u8 bgr[3] = {p[3], p[2], p[1]};
+            if (fwrite(bgr, 1, sizeof(bgr), f) != sizeof(bgr)) { fclose(f); return 0; }
+        }
+        if (row > w * 3u && fwrite(zero, 1, row - w * 3u, f) != row - w * 3u) {
+            fclose(f); return 0;
+        }
+    }
+    return fclose(f) == 0;
+}
+
+static int tj_tex_write_dds(const char* path, const u8* src, u32 w, u32 h,
+                            u32 pitch, u32 basef)
+{
+    u32 block_bytes = basef == 0x86 ? 8u : 16u;
+    u32 row_bytes = ((w + 3u) / 4u) * block_bytes;
+    u32 rows = (h + 3u) / 4u;
+    u64 linear64 = (u64)row_bytes * rows;
+    if (linear64 > 0xFFFFFFFFu) return 0;
+    FILE* f = fopen(path, "wb");
+    if (!f) return 0;
+    u8 hdr[128] = {0};
+    memcpy(hdr, "DDS ", 4);
+    tj_le32(hdr + 4, 124);              /* DDS_HEADER::size */
+    tj_le32(hdr + 8, 0x00081007u);      /* caps|height|width|pixfmt|linear */
+    tj_le32(hdr + 12, h); tj_le32(hdr + 16, w);
+    tj_le32(hdr + 20, (u32)linear64);
+    tj_le32(hdr + 76, 32);              /* DDS_PIXELFORMAT::size */
+    tj_le32(hdr + 80, 0x4);             /* FOURCC */
+    tj_le32(hdr + 84, basef == 0x86 ? 0x31545844u :
+                         basef == 0x87 ? 0x33545844u : 0x35545844u);
+    tj_le32(hdr + 108, 0x1000);         /* DDSCAPS_TEXTURE */
+    int ok = fwrite(hdr, 1, sizeof(hdr), f) == sizeof(hdr);
+    for (u32 y = 0; ok && y < rows; ++y)
+        ok = fwrite(src + (u64)y * pitch, 1, row_bytes, f) == row_bytes;
+    return fclose(f) == 0 && ok;
+}
+
+static void tj_tex_dump_bound(u32 fp_addr, unsigned unit, const D3D12DrawRecord* tex_draw,
+                              int cache_slot, u32 wslot, DXGI_FORMAT dxgi, u32 mapping)
+{
+    extern uint8_t* vm_base;
+    u32 basef = tex_draw->tex[unit].fmt & 0x9Fu;
+    if (unit > 1 || !tj_tex_dump_selected(fp_addr) || !vm_base || cache_slot < 0 ||
+        (basef != 0x85 && (basef < 0x86 || basef > 0x88))) return;
+    VPTexSlot* slot = &s_d3d.vp_tex[cache_slot];
+    if (!tj_tex_dump_claim(fp_addr, tex_draw->tex[unit].off, tex_draw->tex[unit].fmt,
+                           tex_draw->tex[unit].w, tex_draw->tex[unit].h,
+                           slot->source_hash)) return;
+
+    const char* capture_dir = getenv("TJ_INDEXED_CAPTURE_DIR");
+    const char* dir = capture_dir && *capture_dir ? capture_dir : ".";
+    size_t len = strlen(dir);
+    int sep = len && dir[len - 1] != '\\' && dir[len - 1] != '/';
+    if (capture_dir && *capture_dir) CreateDirectoryA(dir, NULL);
+    char stem[1024], data_path[1060], meta_path[1060];
+    int stem_len = snprintf(stem, sizeof(stem),
+        "%s%stex_target_%08X_t%u_off%08X_fmt%02X_%ux%u_%016llX",
+        dir, sep ? "\\" : "", fp_addr, unit, tex_draw->tex[unit].off, basef,
+        tex_draw->tex[unit].w, tex_draw->tex[unit].h,
+        (unsigned long long)slot->source_hash);
+    int valid = stem_len > 0 && stem_len < (int)sizeof(stem);
+    if (valid) {
+        snprintf(data_path, sizeof(data_path), "%s.%s", stem,
+                 basef == 0x85 ? "bmp" : "dds");
+        snprintf(meta_path, sizeof(meta_path), "%s.txt", stem);
+    }
+    int swizzled = !(tex_draw->tex[unit].fmt & 0x20) &&
+                   (tex_draw->tex[unit].w & (tex_draw->tex[unit].w - 1u)) == 0 &&
+                   (tex_draw->tex[unit].h & (tex_draw->tex[unit].h - 1u)) == 0;
+    int ok = valid && (basef == 0x85 ?
+        tj_tex_write_bmp(data_path, vm_base + tex_draw->tex[unit].off,
+                         tex_draw->tex[unit].w, tex_draw->tex[unit].h, slot->pitch, swizzled) :
+        tj_tex_write_dds(data_path, vm_base + tex_draw->tex[unit].off,
+                         tex_draw->tex[unit].w, tex_draw->tex[unit].h, slot->pitch, basef));
+    FILE* meta = valid ? fopen(meta_path, "wb") : NULL;
+    if (!meta) ok = 0;
+    else {
+        fprintf(meta, "fp=0x%08X\nunit=%u\noff=0x%08X\nfmt=0x%02X\nwidth=%u\nheight=%u\n"
+                "source_pitch=%u\nsource_hash=0x%016llX\ncache_slot=%d\nwindow_slot=%u\n"
+                "dxgi=%u\nfinal_mapping=0x%04X\nswizzled=%d\n",
+                fp_addr, unit, tex_draw->tex[unit].off, basef, tex_draw->tex[unit].w,
+                tex_draw->tex[unit].h, slot->pitch,
+                (unsigned long long)slot->source_hash, cache_slot, wslot, (unsigned)dxgi,
+                mapping, swizzled);
+        if (fclose(meta) != 0) ok = 0;
+    }
+    printf("[TJ-TEX-DUMP] fp=%08X t%u off=%08X fmt=%02X cache=%d wslot=%u dxgi=%u map=%04X %s %s\n",
+           fp_addr, unit, tex_draw->tex[unit].off, basef, cache_slot, wslot,
+           (unsigned)dxgi, mapping,
+           valid ? data_path : "?", ok ? "success" : "failed");
+}
+
+/* Some target FPs sample base-0x85 uploads with the remap selectors written
+ * B,G,R,A rather than the usual A,R,G,B field order.  This is deliberately
+ * separate from rsx_remap_to_d3d(): TJ_TEX_ALT_REMAP_FP selects it per draw,
+ * so normal/background texture interpretation cannot change. */
+static u32 rsx_remap_to_d3d_alt_bgra(u32 c1)
+{
+    static const u8 argb_source_to_rgba[4] = {3, 0, 1, 2};
+    u32 field[4]; /* selector fields are B, G, R, A */
+    if (!(c1 & 0xFFFFu)) c1 = 0xAAE4u;
+    for (unsigned i = 0; i < 4; ++i) {
+        u32 source = (c1 >> (i * 2)) & 3u;
+        u32 op = (c1 >> (8 + i * 2)) & 3u;
+        field[i] = op == 0 ? 4u : op == 1 ? 5u : argb_source_to_rgba[source];
+    }
+    /* D3D packs R,G,B,A; re-order the B,G,R,A selector fields. */
+    return field[2] | (field[1] << 3) | (field[0] << 6) |
+           (field[3] << 9) | (1u << 12);
+}
+
+static int tj_tex_alt_remap_selected(u32 fp_addr)
+{
+    static int initialized = 0, enabled = 0;
+    static u32 target;
+    if (!initialized) {
+        enabled = tj_env_u32_hex("TJ_TEX_ALT_REMAP_FP", &target);
+        initialized = 1;
+    }
+    return enabled && target == fp_addr;
+}
+
+static void vp_tex_cache_trace(int hit)
+{
+    static int enabled = -1;
+    static u64 hits = 0, misses = 0;
+    static u32 reports = 0;
+    if (enabled < 0) enabled = getenv("TJ_TEX_CACHE_TRACE") ? 1 : 0;
+    if (!enabled) return;
+    if (hit) hits++; else misses++;
+    if (reports < 16 && (hits + misses == 1 || ((hits + misses) & 63u) == 0)) {
+        reports++;
+        fprintf(stderr, "[TJ-TEX-CACHE] hits=%llu misses=%llu\n",
+                (unsigned long long)hits, (unsigned long long)misses);
+    }
+}
+
+typedef struct VPTexFormatInfo {
+    DXGI_FORMAT dxgi;
+    u8 src_block_bytes;
+    u8 dst_texel_bytes;
+    u8 block_width;
+    u8 block_height;
+    u8 host_compressed;
+} VPTexFormatInfo;
+
+/* Host upload contract for every RSX format this backend can sample. Packed
+ * 16-bit colors and the two-pixel 0x8D/0x8E formats expand to canonical
+ * RGBA8. Sampled depth is uploaded as a color SRV, never as a DSV-only
+ * resource. RSX E4M12/D24F depth expands to IEEE-754 R32_FLOAT on upload. */
+static int vp_tex_format_info(u32 basef, VPTexFormatInfo* out)
+{
+    VPTexFormatInfo f = { DXGI_FORMAT_UNKNOWN, 0, 0, 1, 1, 0 };
+    switch (basef) {
+    case 0x81: f.dxgi = DXGI_FORMAT_R8_UNORM; f.src_block_bytes = 1; f.dst_texel_bytes = 1; break;
+    case 0x82: /* A1R5G5B5 */
+    case 0x83: /* A4R4G4B4 */
+    case 0x84: /* R5G6B5 */
+    case 0x8F: /* R6G5B5 */
+    case 0x97: /* R5G5B5A1 */
+    case 0x9D: /* D1R5G5B5 */
+        f.dxgi = DXGI_FORMAT_R8G8B8A8_UNORM;
+        f.src_block_bytes = 2; f.dst_texel_bytes = 4;
+        break;
+    case 0x85: /* A8R8G8B8 */
+    case 0x9E: /* D8R8G8B8 */
+        f.dxgi = DXGI_FORMAT_R8G8B8A8_UNORM;
+        f.src_block_bytes = 4; f.dst_texel_bytes = 4;
+        break;
+    case 0x86:
+        f.dxgi = DXGI_FORMAT_BC1_UNORM; f.src_block_bytes = 8;
+        f.block_width = f.block_height = 4; f.host_compressed = 1;
+        break;
+    case 0x87:
+        f.dxgi = DXGI_FORMAT_BC2_UNORM; f.src_block_bytes = 16;
+        f.block_width = f.block_height = 4; f.host_compressed = 1;
+        break;
+    case 0x88:
+        f.dxgi = DXGI_FORMAT_BC3_UNORM; f.src_block_bytes = 16;
+        f.block_width = f.block_height = 4; f.host_compressed = 1;
+        break;
+    case 0x8B: /* G8B8 */
+        f.dxgi = DXGI_FORMAT_R8G8_UNORM; f.src_block_bytes = 2; f.dst_texel_bytes = 2;
+        break;
+    case 0x98: /* COMPRESSED_HILO8: decompressed by endian-normalized upload */
+        f.dxgi = DXGI_FORMAT_R8G8_UNORM; f.src_block_bytes = 2; f.dst_texel_bytes = 2;
+        break;
+    case 0x99: /* COMPRESSED_HILO_S8 */
+        f.dxgi = DXGI_FORMAT_R8G8_SNORM; f.src_block_bytes = 2; f.dst_texel_bytes = 2;
+        break;
+    case 0x8D: /* firmware 0xAD: B8R8_G8R8, two pixels per block */
+    case 0x8E: /* firmware 0xAE: R8B8_R8G8, two pixels per block */
+        f.dxgi = DXGI_FORMAT_R8G8B8A8_UNORM;
+        f.src_block_bytes = 4; f.dst_texel_bytes = 4; f.block_width = 2;
+        break;
+    case 0x90: /* DEPTH24_D8 -> sampled normalized depth */
+        f.dxgi = DXGI_FORMAT_R32_FLOAT; f.src_block_bytes = 4; f.dst_texel_bytes = 4;
+        break;
+    case 0x91: /* DEPTH24_D8_FLOAT -> IEEE R32_FLOAT */
+        f.dxgi = DXGI_FORMAT_R32_FLOAT; f.src_block_bytes = 4; f.dst_texel_bytes = 4;
+        break;
+    case 0x92: /* DEPTH16 */
+    case 0x94: /* X16 */
+        f.dxgi = DXGI_FORMAT_R16_UNORM; f.src_block_bytes = 2; f.dst_texel_bytes = 2;
+        break;
+    case 0x93: /* DEPTH16_FLOAT (E4M12) -> IEEE R32_FLOAT */
+        f.dxgi = DXGI_FORMAT_R32_FLOAT; f.src_block_bytes = 2; f.dst_texel_bytes = 4;
+        break;
+    case 0x95: /* Y16_X16 */
+        f.dxgi = DXGI_FORMAT_R16G16_UNORM; f.src_block_bytes = 4; f.dst_texel_bytes = 4;
+        break;
+    case 0x9A: /* W16_Z16_Y16_X16_FLOAT */
+        f.dxgi = DXGI_FORMAT_R16G16B16A16_FLOAT; f.src_block_bytes = 8; f.dst_texel_bytes = 8;
+        break;
+    case 0x9B: /* W32_Z32_Y32_X32_FLOAT */
+        f.dxgi = DXGI_FORMAT_R32G32B32A32_FLOAT; f.src_block_bytes = 16; f.dst_texel_bytes = 16;
+        break;
+    case 0x9C: /* X32_FLOAT */
+        f.dxgi = DXGI_FORMAT_R32_FLOAT; f.src_block_bytes = 4; f.dst_texel_bytes = 4;
+        break;
+    case 0x9F: /* Y16_X16_FLOAT */
+        f.dxgi = DXGI_FORMAT_R16G16_FLOAT; f.src_block_bytes = 4; f.dst_texel_bytes = 4;
+        break;
+    default:
+        return 0;
+    }
+    if (out) *out = f;
+    return 1;
+}
+
+static int vp_tex_source_row_bytes_checked(const VPTexFormatInfo* f, u32 width,
+                                           u32* out_bytes)
+{
+    if (!f || !out_bytes || !f->block_width || !f->src_block_bytes) return -1;
+    const u64 blocks = ((u64)width + f->block_width - 1u) / f->block_width;
+    const u64 bytes = blocks * f->src_block_bytes;
+    if (!bytes || bytes > UINT32_MAX) return -1;
+    *out_bytes = (u32)bytes;
+    return 0;
+}
+
+static u32 vp_tex_source_row_bytes(const VPTexFormatInfo* f, u32 width)
+{
+    u32 bytes = 0;
+    return vp_tex_source_row_bytes_checked(f, width, &bytes) == 0 ? bytes : 0;
+}
+
+static int vp_tex_source_rows_checked(const VPTexFormatInfo* f, u32 height,
+                                      u32* out_rows)
+{
+    if (!f || !out_rows || !f->block_height) return -1;
+    const u64 rows = ((u64)height + f->block_height - 1u) / f->block_height;
+    if (!rows || rows > UINT32_MAX) return -1;
+    *out_rows = (u32)rows;
+    return 0;
+}
+
+static u32 vp_tex_source_rows(const VPTexFormatInfo* f, u32 height)
+{
+    u32 rows = 0;
+    return vp_tex_source_rows_checked(f, height, &rows) == 0 ? rows : 0;
+}
+
+static inline u16 vp_tex_be16(const u8* p)
+{
+    return (u16)(((u16)p[0] << 8) | p[1]);
+}
+
+static inline u32 vp_tex_be32(const u8* p)
+{
+    return ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+           ((u32)p[2] << 8) | (u32)p[3];
+}
+
+static inline void vp_tex_store_u16(u8* p, u16 value)
+{
+    p[0] = (u8)value;
+    p[1] = (u8)(value >> 8);
+}
+
+static inline void vp_tex_store_u32(u8* p, u32 value)
+{
+    p[0] = (u8)value;
+    p[1] = (u8)(value >> 8);
+    p[2] = (u8)(value >> 16);
+    p[3] = (u8)(value >> 24);
+}
+
+static inline u8 vp_tex_unorm(u32 value, u32 max_value)
+{
+    return (u8)((value * 255u + max_value / 2u) / max_value);
+}
+
+/* RSX floating-depth formats are not IEEE half/float bit layouts. These are
+ * the hardware-compatible expansions used by RPCS3's depth upload path. */
+static inline u32 vp_tex_depth16f_to_f32_bits(u16 value)
+{
+    return ((u32)value << 11) + (120u << 23);
+}
+
+static inline u32 vp_tex_depth24f_to_f32_bits(u32 value)
+{
+    return (value & 0xFFFFFFu) << 7;
+}
+
+static void vp_copy_tex_level(u8* dst, u32 dst_pitch, const u8* src,
+                              u32 src_pitch, u32 w, u32 h, u32 basef,
+                              int swizzled)
+{
+    VPTexFormatInfo info;
+    if (!vp_tex_format_info(basef, &info)) return;
+    u32 l2w = rsx_log2u(w), l2h = rsx_log2u(h);
+    if (info.host_compressed) {
+        u32 row_bytes = vp_tex_source_row_bytes(&info, w);
+        u32 rows = vp_tex_source_rows(&info, h);
+        for (u32 y = 0; y < rows; ++y)
+            memcpy(dst + (u64)y * dst_pitch, src + (u64)y * src_pitch, row_bytes);
+        return;
+    }
+
+    if (info.block_width == 2) {
+        /* RSX 0x8D/0x8E share B and G across a pair while carrying one R
+         * value per pixel. Expand to canonical RGBA8. Firmware sets LN for
+         * these formats; reject an impossible Morton interpretation here. */
+        if (swizzled) return;
+        for (u32 y = 0; y < h; ++y) {
+            u8* drow = dst + (u64)y * dst_pitch;
+            const u8* srow = src + (u64)y * src_pitch;
+            for (u32 x = 0; x < w; ++x) {
+                const u8* block = srow + (u64)(x >> 1) * 4u;
+                u8 r, g, b;
+                if (basef == 0x8D) {
+                    b = block[0]; r = block[(x & 1u) ? 3u : 1u]; g = block[2];
+                } else {
+                    r = block[(x & 1u) ? 2u : 0u]; b = block[1]; g = block[3];
+                }
+                drow[x * 4u + 0u] = r;
+                drow[x * 4u + 1u] = g;
+                drow[x * 4u + 2u] = b;
+                drow[x * 4u + 3u] = 255;
+            }
+        }
+        return;
+    }
+
+    for (u32 y = 0; y < h; ++y) {
+        u8* drow = dst + (u64)y * dst_pitch;
+        for (u32 x = 0; x < w; ++x) {
+            const u8* s = swizzled
+                ? src + (u64)rsx_swz_off(x, y, l2w, l2h) * info.src_block_bytes
+                : src + (u64)y * src_pitch + (u64)x * info.src_block_bytes;
+            u8* d = drow + (u64)x * info.dst_texel_bytes;
+            if (basef == 0x81) {
+                d[0] = s[0];
+            } else if (basef == 0x82) {
+                u16 v = vp_tex_be16(s);
+                d[0] = vp_tex_unorm((v >> 10) & 31u, 31u);
+                d[1] = vp_tex_unorm((v >> 5) & 31u, 31u);
+                d[2] = vp_tex_unorm(v & 31u, 31u);
+                d[3] = (v & 0x8000u) ? 255 : 0;
+            } else if (basef == 0x83) {
+                u16 v = vp_tex_be16(s);
+                d[0] = (u8)(((v >> 8) & 15u) * 17u);
+                d[1] = (u8)(((v >> 4) & 15u) * 17u);
+                d[2] = (u8)((v & 15u) * 17u);
+                d[3] = (u8)(((v >> 12) & 15u) * 17u);
+            } else if (basef == 0x84) {
+                u16 v = vp_tex_be16(s);
+                d[0] = vp_tex_unorm((v >> 11) & 31u, 31u);
+                d[1] = vp_tex_unorm((v >> 5) & 63u, 63u);
+                d[2] = vp_tex_unorm(v & 31u, 31u);
+                d[3] = 255;
+            } else if (basef == 0x85) {
+                drow[x*4u+0u] = s[1]; drow[x*4u+1u] = s[2];
+                drow[x*4u+2u] = s[3]; drow[x*4u+3u] = s[0];
+            } else if (basef == 0x8B || basef == 0x98 || basef == 0x99) {
+                /* These formats are one big-endian 16-bit word per texel. */
+                vp_tex_store_u16(d, vp_tex_be16(s));
+            } else if (basef == 0x8F) {
+                u16 v = vp_tex_be16(s);
+                d[0] = vp_tex_unorm((v >> 10) & 63u, 63u);
+                d[1] = vp_tex_unorm((v >> 5) & 31u, 31u);
+                d[2] = vp_tex_unorm(v & 31u, 31u);
+                d[3] = 255;
+            } else if (basef == 0x90) {
+                u32 v = vp_tex_be32(s);
+                float depth = (float)((v >> 8) & 0xFFFFFFu) / 16777215.0f;
+                u32 bits;
+                memcpy(&bits, &depth, sizeof(bits));
+                vp_tex_store_u32(d, bits);
+            } else if (basef == 0x91) {
+                u32 v = vp_tex_be32(s);
+                vp_tex_store_u32(d, vp_tex_depth24f_to_f32_bits(v >> 8));
+            } else if (basef == 0x92 || basef == 0x94) {
+                vp_tex_store_u16(d, vp_tex_be16(s));
+            } else if (basef == 0x93) {
+                vp_tex_store_u32(d, vp_tex_depth16f_to_f32_bits(vp_tex_be16(s)));
+            } else if (basef == 0x95) {
+                vp_tex_store_u16(d + 0, vp_tex_be16(s + 0));
+                vp_tex_store_u16(d + 2, vp_tex_be16(s + 2));
+            } else if (basef == 0x97) {
+                u16 v = vp_tex_be16(s);
+                d[0] = vp_tex_unorm((v >> 11) & 31u, 31u);
+                d[1] = vp_tex_unorm((v >> 6) & 31u, 31u);
+                d[2] = vp_tex_unorm((v >> 1) & 31u, 31u);
+                d[3] = (v & 1u) ? 255 : 0;
+            } else if (basef == 0x9A) {
+                for (u32 lane = 0; lane < 4; ++lane) {
+                    d[lane*2u + 0u] = s[lane*2u + 1u];
+                    d[lane*2u + 1u] = s[lane*2u + 0u];
+                }
+            } else if (basef == 0x9B) {
+                for (u32 lane = 0; lane < 4; ++lane)
+                    vp_tex_store_u32(d + lane * 4u, vp_tex_be32(s + lane * 4u));
+            } else if (basef == 0x9C) {
+                vp_tex_store_u32(d, vp_tex_be32(s));
+            } else if (basef == 0x9D) {
+                u16 v = vp_tex_be16(s);
+                d[0] = vp_tex_unorm((v >> 10) & 31u, 31u);
+                d[1] = vp_tex_unorm((v >> 5) & 31u, 31u);
+                d[2] = vp_tex_unorm(v & 31u, 31u);
+                d[3] = 255;
+            } else if (basef == 0x9E) {
+                d[0] = s[1]; d[1] = s[2]; d[2] = s[3]; d[3] = 255;
+            } else if (basef == 0x9F) {
+                vp_tex_store_u16(d + 0, vp_tex_be16(s + 0));
+                vp_tex_store_u16(d + 2, vp_tex_be16(s + 2));
+            } else {
+                memcpy(d, s, info.dst_texel_bytes);
+            }
+        }
+    }
+}
+
+static int vp_copy_tex_level_3d(u8* dst, u32 dst_pitch, u64 dst_slice_pitch,
+                                const u8* src, u32 src_pitch,
+                                u32 w, u32 h, u32 depth, u32 basef,
+                                int swizzled)
+{
+    VPTexFormatInfo info;
+    if (!vp_tex_format_info(basef, &info)) return -1;
+    u32 rows = vp_tex_source_rows(&info, h);
+    u64 src_slice_pitch = (u64)src_pitch * rows;
+    if (!swizzled) {
+        for (u32 z = 0; z < depth; ++z)
+            vp_copy_tex_level(dst + z * dst_slice_pitch, dst_pitch,
+                              src + z * src_slice_pitch, src_pitch,
+                              w, h, basef, 0);
+        return 0;
+    }
+    /* Bounded linear BC slices are valid source data. The active D3D12 path
+     * chooses the RGBA decoder below because BC TEXTURE3D resources are not
+     * legal there, but keep this helper correct for any BC-capable caller. */
+    if (info.host_compressed) {
+        if (swizzled) return -1;
+        for (u32 z = 0; z < depth; ++z)
+            vp_copy_tex_level(dst + z * dst_slice_pitch, dst_pitch,
+                              src + z * src_slice_pitch, src_pitch,
+                              w, h, basef, 0);
+        return 0;
+    }
+    if (info.block_width != 1u) return -1;
+
+    u64 plane_bytes = (u64)w * h * info.src_block_bytes;
+    if (!plane_bytes || plane_bytes > SIZE_MAX) return -1;
+    u8* plane = (u8*)malloc((size_t)plane_bytes);
+    if (!plane) return -1;
+    u32 l2w = rsx_log2u(w), l2h = rsx_log2u(h), l2d = rsx_log2u(depth);
+    for (u32 z = 0; z < depth; ++z) {
+        for (u32 y = 0; y < h; ++y) {
+            for (u32 x = 0; x < w; ++x) {
+                u32 morton = rsx_swz3_off(x, y, z, l2w, l2h, l2d);
+                memcpy(plane + ((u64)y * w + x) * info.src_block_bytes,
+                       src + (u64)morton * info.src_block_bytes,
+                       info.src_block_bytes);
+            }
+        }
+        vp_copy_tex_level(dst + z * dst_slice_pitch, dst_pitch,
+                          plane, w * info.src_block_bytes,
+                          w, h, basef, 0);
+    }
+    free(plane);
+    return 0;
+}
+
+static int off_rt_find(u32 off, u8 local);
+
+/* DXT is never generic Morton: POT 3D DXT uses VTC below regardless of LN;
+ * every other DXT source is planar rows of 4x4 blocks. */
+static int vp_tex_source_is_swizzled(const VPTexFormatInfo* info, u32 fmt,
+                                    u32 w_blocks, u32 h_blocks, u32 depth,
+                                    u32 dimension)
+{
+    return info && !info->host_compressed && !(fmt & 0x20u) &&
+        w_blocks && h_blocks &&
+        !(w_blocks & (w_blocks - 1u)) && !(h_blocks & (h_blocks - 1u)) &&
+        (dimension != 3u || (depth && !(depth & (depth - 1u))));
+}
+
+static int vp_tex_source_is_vtc(const VPTexFormatInfo* info,
+                                u32 w, u32 h, u32 depth, u32 dimension)
+{
+    return info && info->host_compressed && dimension == 3u &&
+        w && h && depth && !(w & (w - 1u)) && !(h & (h - 1u)) &&
+        !(depth & (depth - 1u));
+}
+
+static int vp_tex_source_has_border(u32 fmt, u8 border_type)
+{
+    VPTexFormatInfo info;
+    return vp_tex_format_info(fmt & 0x9Fu, &info) && !info.host_compressed &&
+           !border_type;
+}
+
+typedef struct {
+    u32 logical_width_blocks, logical_rows;
+    u32 padded_width_blocks, padded_rows;
+    u32 pitch, border;
+    u64 slice_bytes;
+    int swizzled;
+} VPTexSourceLevel;
+
+static int vp_tex_next_pow2(u32 value, u32* out)
+{
+    if (!value || !out || value > 0x80000000u) return -1;
+    u32 p = 1u;
+    while (p < value) p <<= 1u;
+    *out = p;
+    return 0;
+}
+
+/* Mirrors RPCS3's get_subresources_layout_impl(): bit 3 is inverted
+ * (border_type ^ 1), linear textures retain their programmed pitch and a
+ * one-block porch, while swizzled textures use a four-block porch in a
+ * next-power-of-two backing plane. Depth is a sequence of planes; it has no
+ * extra front/back porch. */
+static int vp_tex_source_level(const VPTexFormatInfo* info, u32 fmt,
+                               u32 w, u32 h, u32 depth, u32 dimension,
+                               int has_border, u32 programmed_pitch,
+                               VPTexSourceLevel* out)
+{
+    if (!info || !out || !w || !h || !depth) return -1;
+    memset(out, 0, sizeof(*out));
+    if (vp_tex_source_rows_checked(info, h, &out->logical_rows) != 0 ||
+        vp_tex_source_row_bytes_checked(info, w, &out->pitch) != 0)
+        return -1;
+    out->logical_width_blocks = out->pitch / info->src_block_bytes;
+    out->swizzled = vp_tex_source_is_swizzled(info, fmt,
+        out->logical_width_blocks, out->logical_rows, depth, dimension);
+    out->border = has_border && !info->host_compressed
+        ? (out->swizzled ? 4u : 1u) : 0u;
+    if (out->swizzled) {
+        if (vp_tex_next_pow2(out->logical_width_blocks + out->border * 2u,
+                             &out->padded_width_blocks) != 0 ||
+            vp_tex_next_pow2(out->logical_rows + out->border * 2u,
+                             &out->padded_rows) != 0)
+            return -1;
+        if (out->padded_width_blocks > UINT32_MAX / info->src_block_bytes)
+            return -1;
+        out->pitch = out->padded_width_blocks * info->src_block_bytes;
+    } else if (info->host_compressed && !(fmt & 0x20u)) {
+        /* SZ DXT is planar but tightly packed in 4x4-block rows. It does not
+         * use the programmed LN row pitch or generic Morton addressing. */
+        out->padded_width_blocks = out->logical_width_blocks;
+        out->padded_rows = out->logical_rows;
+    } else {
+        const u64 minimum = (u64)(out->logical_width_blocks + out->border * 2u) *
+                            info->src_block_bytes;
+        if (minimum > UINT32_MAX) return -1;
+        out->pitch = programmed_pitch >= minimum ? programmed_pitch : (u32)minimum;
+        out->padded_width_blocks = out->pitch / info->src_block_bytes;
+        out->padded_rows = out->logical_rows + out->border * 2u;
+    }
+    if (!out->pitch || !out->padded_rows ||
+        out->padded_rows > UINT64_MAX / out->pitch)
+        return -1;
+    out->slice_bytes = (u64)out->pitch * out->padded_rows;
+    if (!out->slice_bytes) return -1;
+    return vp_tex_source_is_vtc(info, w, h, depth, dimension) ||
+           depth <= UINT64_MAX / out->slice_bytes ? 0 : -1;
+}
+
+/* VTC retile groups depth inside 4x4x1/2/4 blocks. VTC addressing always
+ * uses logical packed block geometry, but LN 3D DXT retains its programmed
+ * allocation pitch when advancing to the next mip level. */
+static int vp_tex_source_level_bytes(const VPTexFormatInfo* info,
+                                     const VPTexSourceLevel* layout,
+                                     u32 depth, int is_3d, int vtc,
+                                     int linear_vtc,
+                                     u64* out_bytes)
+{
+    if (!info || !layout || !out_bytes) return -1;
+    u64 bytes;
+    if (vtc && !linear_vtc) {
+        bytes = (u64)layout->logical_width_blocks * layout->logical_rows;
+        if (!bytes || bytes > UINT64_MAX / depth) return -1;
+        bytes *= depth;
+        if (bytes > UINT64_MAX / info->src_block_bytes) return -1;
+        bytes *= info->src_block_bytes;
+    } else {
+        const u64 slices = is_3d ? depth : 1u;
+        if (!layout->slice_bytes || slices > UINT64_MAX / layout->slice_bytes)
+            return -1;
+        bytes = layout->slice_bytes * slices;
+    }
+    *out_bytes = bytes;
+    return 0;
+}
+
+/* RSX mipmap is a requested count, not a promise that all levels are valid.
+ * DXT stops when the smaller 4x4-block extent reaches one; ordinary 1D/2D,
+ * cube, and 3D textures stop at the largest texel extent. Keep every caller
+ * (bind, snapshot span, and upload) on this one rule. */
+static u16 vp_tex_exact_mip_count(u32 w, u32 h, u32 depth, u32 fmt,
+                                  u32 dimension, u32 requested_mips)
+{
+    const u32 basef = fmt & 0x9Fu;
+    u32 extent;
+    switch (basef) {
+    case 0x86u: case 0x87u: case 0x88u: /* DXT1/23/45: 4x4 block extent */
+        extent = w / 4u;
+        if (h / 4u < extent) extent = h / 4u;
+        if (!extent) extent = 1u;
+        break;
+    default:
+        if (dimension == 1u) { h = 1u; depth = 1u; }
+        else if (dimension == 4u) depth = 1u; /* cube faces are 2D */
+        extent = w;
+        if (h > extent) extent = h;
+        if (depth > extent) extent = depth;
+        if (!extent) extent = 1u;
+        break;
+    }
+    u16 max_mips = 1;
+    while (extent > 1u && max_mips < 16u) {
+        extent >>= 1;
+        ++max_mips;
+    }
+    if (!requested_mips) requested_mips = 1u;
+    return (u16)(requested_mips < max_mips ? requested_mips : max_mips);
+}
+
+/* Keep record-time allocation and replay-time upload on the same exact
+ * source span: all mip levels, every cube face, and every 3D slice. */
+static int vp_tex_source_span(u32 w, u32 h, u32 depth, u32 fmt,
+                              u32 src_pitch, int cube, u32 dimension,
+                              u32 mip_count, int has_border, u32* out_span,
+                              u64* out_face_stride)
+{
+    if (!out_span || !w || !h || !depth) return -1;
+    if (dimension < 1u || dimension > 3u) dimension = 2u;
+    if (cube) { dimension = 2u; depth = 1u; }
+    if (dimension == 1u) { h = 1u; depth = 1u; }
+    const int is_3d = dimension == 3u;
+    VPTexFormatInfo info;
+    if (!vp_tex_format_info(fmt & 0x9Fu, &info)) return -1;
+    has_border = has_border && !info.host_compressed;
+    mip_count = vp_tex_exact_mip_count(w, h, depth, fmt, dimension, mip_count);
+    u64 face_span = 0;
+    u32 mw = w, mh = h, md = depth;
+    for (u32 level = 0; level < mip_count; ++level) {
+        VPTexSourceLevel source_level;
+        if (vp_tex_source_level(&info, fmt, mw, mh, md, dimension,
+                                has_border, src_pitch, &source_level) != 0)
+            return -1;
+        u64 level_bytes;
+        if (vp_tex_source_level_bytes(&info, &source_level, md, is_3d,
+                                      vp_tex_source_is_vtc(&info, mw, mh, md,
+                                                           dimension),
+                                      (fmt & 0x20u) != 0,
+                                      &level_bytes) != 0)
+            return -1;
+        if (face_span > UINT64_MAX - level_bytes) return -1;
+        face_span += level_bytes;
+        if (face_span > UINT32_MAX) return -1;
+        mw = mw > 1u ? mw >> 1 : 1u;
+        mh = mh > 1u ? mh >> 1 : 1u;
+        md = md > 1u ? md >> 1 : 1u;
+    }
+    /* RSX aligns every LN-clear cube-face mip pyramid to 128 bytes. DXT has
+     * planar block rows, but still follows this SZ cube-face rule. */
+    const int cube_ln_clear = cube && !(fmt & 0x20u);
+    if (cube_ln_clear && face_span > UINT64_MAX - 127ull) return -1;
+    const u64 face_stride = cube_ln_clear
+        ? ((face_span + 127ull) & ~127ull) : face_span;
+    const u64 faces = cube ? 6u : 1u;
+    if (face_stride > UINT64_MAX / faces) return -1;
+    const u64 total = face_stride * faces;
+    if (!total || total > UINT32_MAX) return -1;
+    *out_span = (u32)total;
+    if (out_face_stride) *out_face_stride = face_stride;
+    return 0;
+}
+
+static const u8* vp_tex_source_block(const u8* src,
+                                     const VPTexSourceLevel* layout,
+                                     u32 x, u32 y, u32 z, u32 depth,
+                                     int is_3d, int vtc,
+                                     u32 block_bytes)
+{
+    u64 block;
+    x += layout->border;
+    y += layout->border;
+    if (layout->swizzled) {
+        block = is_3d
+            ? rsx_swz3_off(x, y, z, rsx_log2u(layout->padded_width_blocks),
+                            rsx_log2u(layout->padded_rows), rsx_log2u(depth))
+            : rsx_swz_off(x, y, rsx_log2u(layout->padded_width_blocks),
+                          rsx_log2u(layout->padded_rows));
+    } else if (vtc) {
+        /* NV_texture_compression_vtc interleaves four depth planes per block.
+         * RPCS3 only routes POT 3D DXT through this deinterleave path. */
+        const u32 group_first = (z >> 2u) << 2u;
+        const u32 group_depth = (depth - group_first) < 4u
+            ? depth - group_first : 4u;
+        const u64 plane = (u64)layout->logical_width_blocks * layout->logical_rows;
+        block = (u64)group_first * plane +
+                ((u64)y * layout->logical_width_blocks + x) * group_depth +
+                (z - group_first);
+    } else {
+        block = (u64)z * (layout->slice_bytes / block_bytes) +
+                (u64)y * layout->padded_width_blocks + x;
+    }
+    return src + block * block_bytes;
+}
+
+static int vp_copy_tex_level_layout(u8* dst, u32 dst_pitch, const u8* src,
+                                    const VPTexSourceLevel* layout,
+                                    u32 w, u32 h, u32 z, u32 depth,
+                                    u32 basef, int is_3d)
+{
+    VPTexFormatInfo info;
+    if (!vp_tex_format_info(basef, &info) || !layout) return -1;
+    if (!layout->swizzled && !layout->border) {
+        vp_copy_tex_level(dst, dst_pitch,
+                          src + (u64)z * layout->slice_bytes,
+                          layout->pitch, w, h, basef, 0);
+        return 0;
+    }
+    u64 bytes = (u64)layout->logical_width_blocks * layout->logical_rows *
+                info.src_block_bytes;
+    if (!bytes || bytes > SIZE_MAX) return -1;
+    u8* linear = (u8*)malloc((size_t)bytes);
+    if (!linear) return -1;
+    const int swizzled_2d = layout->swizzled && !is_3d;
+    const u32 swizzled_log2w = swizzled_2d
+        ? rsx_log2u(layout->padded_width_blocks) : 0u;
+    const u32 swizzled_log2h = swizzled_2d
+        ? rsx_log2u(layout->padded_rows) : 0u;
+    for (u32 y = 0; y < layout->logical_rows; ++y) {
+        for (u32 x = 0; x < layout->logical_width_blocks; ++x) {
+            const u8* source_block = swizzled_2d
+                ? src + (u64)rsx_swz_off(x + layout->border,
+                                         y + layout->border,
+                                         swizzled_log2w, swizzled_log2h) *
+                        info.src_block_bytes
+                : vp_tex_source_block(src, layout, x, y, z, depth, is_3d,
+                                      0, info.src_block_bytes);
+            memcpy(linear + ((u64)y * layout->logical_width_blocks + x) *
+                   info.src_block_bytes,
+                   source_block, info.src_block_bytes);
+        }
+    }
+    vp_copy_tex_level(dst, dst_pitch, linear,
+                      layout->logical_width_blocks * info.src_block_bytes,
+                      w, h, basef, 0);
+    free(linear);
+    return 0;
+}
+
+static inline void vp_dxt_rgb565(u16 c, u8 out[3])
+{
+    out[0] = vp_tex_unorm((c >> 11) & 31u, 31u);
+    out[1] = vp_tex_unorm((c >> 5) & 63u, 63u);
+    out[2] = vp_tex_unorm(c & 31u, 31u);
+}
+
+static void vp_decode_dxt_block(const u8* src, u32 basef, u8 out[64])
+{
+    const u8* color = src + (basef == 0x86u ? 0u : 8u);
+    u8 c[4][4] = {{0}};
+    const u16 c0 = (u16)(color[0] | ((u16)color[1] << 8));
+    const u16 c1 = (u16)(color[2] | ((u16)color[3] << 8));
+    vp_dxt_rgb565(c0, c[0]); vp_dxt_rgb565(c1, c[1]);
+    c[0][3] = c[1][3] = 255;
+    if (c0 > c1 || basef != 0x86u) {
+        for (u32 k = 0; k < 3; ++k) {
+            c[2][k] = (u8)((2u * c[0][k] + c[1][k]) / 3u);
+            c[3][k] = (u8)((c[0][k] + 2u * c[1][k]) / 3u);
+        }
+        c[2][3] = c[3][3] = 255;
+    } else {
+        for (u32 k = 0; k < 3; ++k) c[2][k] = (u8)((c[0][k] + c[1][k]) / 2u);
+        c[2][3] = 255; c[3][3] = 0;
+    }
+    u32 colors = (u32)color[4] | ((u32)color[5] << 8) |
+                 ((u32)color[6] << 16) | ((u32)color[7] << 24);
+    for (u32 i = 0; i < 16; ++i) {
+        memcpy(out + i * 4u, c[colors & 3u], 4u);
+        colors >>= 2u;
+    }
+    if (basef == 0x87u) {
+        for (u32 i = 0; i < 16; ++i) {
+            const u8 nibble = (src[i >> 1u] >> ((i & 1u) * 4u)) & 15u;
+            out[i * 4u + 3u] = (u8)(nibble * 17u);
+        }
+    } else if (basef == 0x88u) {
+        u8 alpha[8]; alpha[0] = src[0]; alpha[1] = src[1];
+        if (alpha[0] > alpha[1]) {
+            for (u32 i = 1; i < 7; ++i)
+                alpha[i + 1] = (u8)(((7u - i) * alpha[0] + i * alpha[1]) / 7u);
+        } else {
+            for (u32 i = 1; i < 5; ++i)
+                alpha[i + 1] = (u8)(((5u - i) * alpha[0] + i * alpha[1]) / 5u);
+            alpha[6] = 0; alpha[7] = 255;
+        }
+        u64 indices = 0;
+        for (u32 i = 0; i < 6; ++i) indices |= (u64)src[2 + i] << (i * 8u);
+        for (u32 i = 0; i < 16; ++i) out[i * 4u + 3u] = alpha[(indices >> (i * 3u)) & 7u];
+    }
+}
+
+static int vp_copy_dxt_level_3d_rgba(u8* dst, u32 dst_pitch,
+                                      u64 dst_slice_pitch, const u8* src,
+                                      const VPTexSourceLevel* layout,
+                                      u32 w, u32 h, u32 depth, u32 basef,
+                                      int vtc)
+{
+    VPTexFormatInfo info;
+    if (!vp_tex_format_info(basef, &info) || !info.host_compressed) return -1;
+    u8 rgba[64];
+    for (u32 z = 0; z < depth; ++z) {
+        u8* slice = dst + (u64)z * dst_slice_pitch;
+        for (u32 by = 0; by < layout->logical_rows; ++by) {
+            for (u32 bx = 0; bx < layout->logical_width_blocks; ++bx) {
+                vp_decode_dxt_block(vp_tex_source_block(src, layout, bx, by,
+                                    z, depth, 1, vtc, info.src_block_bytes),
+                                    basef, rgba);
+                for (u32 py = 0; py < 4u && by * 4u + py < h; ++py) {
+                    u8* row = slice + (u64)(by * 4u + py) * dst_pitch + bx * 16u;
+                    const u32 pixels = w - bx * 4u < 4u ? w - bx * 4u : 4u;
+                    memcpy(row, rgba + py * 16u, pixels * 4u);
+                }
+            }
+        }
+    }
+    return 0;
+}
+
+static u32 vp_texture_snapshot_hint_index(u32 off, u32 bytes)
+{
+    u32 key = off ^ (bytes * 0x9E3779B9u);
+    key ^= key >> 16u;
+    key *= 0x85EBCA6Bu;
+    key ^= key >> 13u;
+    return key & (VP_TEX_SNAPSHOT_HINTS - 1u);
+}
+
+static VPTexSnapshot* vp_texture_snapshot_hint_find(u32 off, u32 bytes)
+{
+    VP_SNAP_PAR_BARRIER_INDEX(OTHER);
+    VPTexSnapshot* snapshot = s_d3d.vp_tex_snapshot_hints[
+        vp_texture_snapshot_hint_index(off, bytes)];
+    for (u32 way = 0; snapshot && way < VP_TEX_SNAPSHOT_HINT_WAYS; ++way) {
+        if (snapshot->source_off == off && snapshot->bytes == bytes)
+            return snapshot;
+        snapshot = snapshot->hint_next;
+    }
+    return NULL;
+}
+
+static int vp_texture_snapshot_hint_remove(VPTexSnapshot* snapshot)
+{
+    if (!snapshot) return 0;
+    VPTexSnapshot** link = &s_d3d.vp_tex_snapshot_hints[
+        vp_texture_snapshot_hint_index(snapshot->source_off, snapshot->bytes)];
+    for (u32 way = 0; *link && way < VP_TEX_SNAPSHOT_HINT_WAYS; ++way) {
+        if (*link == snapshot) {
+            *link = snapshot->hint_next;
+            snapshot->hint_next = NULL;
+            return 1;
+        }
+        link = &(*link)->hint_next;
+    }
+    /* A NULL next link also describes a node already evicted from the hint. */
+    return snapshot->hint_next == NULL;
+}
+
+static int vp_texture_snapshot_hint_upsert(VPTexSnapshot* snapshot)
+{
+    if (!snapshot || !snapshot->bytes || !vp_texture_snapshot_hint_remove(snapshot))
+        return 0;
+    VPTexSnapshot** head = &s_d3d.vp_tex_snapshot_hints[
+        vp_texture_snapshot_hint_index(snapshot->source_off, snapshot->bytes)];
+    VPTexSnapshot** link = head;
+    for (u32 way = 0; *link && way < VP_TEX_SNAPSHOT_HINT_WAYS; ++way) {
+        VPTexSnapshot* current = *link;
+        if (current->source_off == snapshot->source_off &&
+            current->bytes == snapshot->bytes) {
+            *link = current->hint_next;
+            current->hint_next = NULL;
+            break;
+        }
+        link = &current->hint_next;
+    }
+    snapshot->hint_next = *head;
+    *head = snapshot;
+
+    VPTexSnapshot* tail = *head;
+    for (u32 way = 1; tail->hint_next && way < VP_TEX_SNAPSHOT_HINT_WAYS; ++way)
+        tail = tail->hint_next;
+    if (tail->hint_next) {
+        VPTexSnapshot* evicted = tail->hint_next;
+        tail->hint_next = NULL;
+        evicted->hint_next = NULL;
+    }
+    return 1;
+}
+
+static int vp_texture_snapshot_hint_retarget(VPTexSnapshot* snapshot, u32 off,
+        u32 bytes, u64 write_stamp, const RsxTextureWriteStampHint* stamp_hint)
+{
+    if (!snapshot || !stamp_hint || !snapshot->refs || snapshot->bytes != bytes ||
+        snapshot->source_off == off)
+        return 0;
+    if (!vp_texture_snapshot_hint_remove(snapshot)) return 0;
+    snapshot->source_off = off;
+    snapshot->source_write_stamp = write_stamp;
+    snapshot->source_stamp_hint = *stamp_hint;
+    return vp_texture_snapshot_hint_upsert(snapshot);
+}
+
+static int vp_texture_snapshot_pool_admit(VPTexSnapshot* snapshot);
+
+static void vp_texture_snapshot_discard(VPTexSnapshot* snapshot)
+{
+    if (!snapshot) return;
+    vp_texture_snapshot_hint_remove(snapshot);
+    VPTexSnapshot** link =
+        &s_d3d.vp_tex_snapshot_buckets[snapshot->hash &
+                                       (VP_TEX_SNAPSHOT_BUCKETS - 1u)];
+    while (*link && *link != snapshot) link = &(*link)->hash_next;
+    if (*link == snapshot) *link = snapshot->hash_next;
+    if (s_d3d.vp_tex_snapshot_bytes >= snapshot->bytes)
+        s_d3d.vp_tex_snapshot_bytes -= snapshot->bytes;
+    else
+        s_d3d.vp_tex_snapshot_bytes = 0;
+    snapshot->pool_retained = 0;
+    free(snapshot->data);
+    free(snapshot);
+}
+
+static void vp_texture_snapshot_release(VPTexSnapshot** owner)
+{
+    if (!owner || !*owner) return;
+    VP_SNAP_PAR_BARRIER_INDEX(OTHER);
+    VPTexSnapshot* snapshot = *owner;
+    *owner = NULL;
+    if (!snapshot->refs) return;
+    /* Transfer the last owner directly into the ring; never expose a zero-ref
+     * snapshot that remains linked in the content indexes. */
+    if (snapshot->refs == 1 && s_d3d.vp_tex_snapshot_pool_enabled &&
+        vp_texture_snapshot_pool_admit(snapshot)) return;
+    if (--snapshot->refs) return;
+    vp_texture_snapshot_discard(snapshot);
+}
+
+static void vp_texture_cache_set_source(VPTexSlot* slot, VPTexSnapshot* source)
+{
+    VP_SNAP_PAR_BARRIER_INDEX(OTHER);
+    if (slot->source_snapshot == source) return;
+    if (source) ++source->refs;
+    vp_texture_snapshot_release(&slot->source_snapshot);
+    slot->source_snapshot = source;
+}
+
+/* Opt-in windowed texture-churn counters. Recording paths only call these
+ * when enabled. The reporter exchanges each field independently, so the
+ * counters are interval deltas, not one atomic snapshot. */
+#define VP_TEX_CHURN_PROBE_MAX_ATTEMPTS 16u
+#define VP_TEX_CHURN_PROBE_MAX_BYTES_PER_ATTEMPT (1ull << 20)
+#define VP_TEX_CHURN_PROBE_MAX_BYTES_PER_WINDOW  (8ull << 20)
+
+typedef enum VPTexChurnProbeResult {
+    VP_TEX_CHURN_PROBE_NONE = 0,
+    VP_TEX_CHURN_PROBE_EQUAL = 1,
+    VP_TEX_CHURN_PROBE_DIFFERENT = 2,
+    VP_TEX_CHURN_PROBE_CAPPED = 3
+} VPTexChurnProbeResult;
+
+typedef struct VPTexChurnCounters {
+    volatile LONG64 new_snapshot_count, new_snapshot_bytes, budget_rejections;
+    volatile LONG64 trim_p0_ref_drops, trim_p0_ref_drop_bytes;
+    volatile LONG64 trim_p0_frees, trim_p0_freed_bytes;
+    volatile LONG64 trim_p1_ref_drops, trim_p1_ref_drop_bytes;
+    volatile LONG64 trim_p1_frees, trim_p1_freed_bytes;
+    volatile LONG64 upload_misses, upload_source_bytes;
+    volatile LONG64 same_snapshot_other_off_requests;
+    volatile LONG64 same_off_other_identity_hash_equal_requests;
+    volatile LONG64 same_off_other_identity_hash_different_requests;
+    volatile LONG64 fresh_allocations, reused_storage_uploads;
+    volatile LONG64 shape_plain_linear_uploads;
+    volatile LONG64 shape_plain_linear_padded_uploads, shape_other_uploads;
+    volatile LONG64 same_off_full_layout_candidate_uploads;
+    volatile LONG64 logical_compare_attempts, logical_compare_equal;
+    volatile LONG64 logical_compare_different, logical_compare_capped;
+    volatile LONG64 snapshot_pool_admissions, snapshot_pool_admission_bytes;
+    volatile LONG64 snapshot_pool_hint_reuses, snapshot_pool_hash_reuses;
+    volatile LONG64 snapshot_pool_hash_same_off_reuses;
+    volatile LONG64 snapshot_pool_hash_other_off_reuses;
+    volatile LONG64 snapshot_pool_hint_retargets; /* Includes non-pool-owned snapshots. */
+    volatile LONG64 snapshot_pool_hint_reuse_bytes, snapshot_pool_hash_reuse_bytes;
+    volatile LONG64 snapshot_pool_cap_evictions, snapshot_pool_cap_owner_drop_bytes;
+    volatile LONG64 snapshot_pool_budget_reclaims, snapshot_pool_budget_owner_drop_bytes;
+    volatile LONG64 snapshot_pool_oversize_skips, snapshot_pool_oversize_skip_bytes;
+} VPTexChurnCounters;
+
+static VPTexChurnCounters s_vp_texture_churn;
+static int s_vp_texture_churn_enabled;
+static int s_vp_texture_hint_retarget_config;
+static u32 s_vp_texture_churn_probe_window_attempts;
+static u64 s_vp_texture_churn_probe_window_bytes;
+
+static void vp_texture_churn_probe_budget_reset(void)
+{
+    s_vp_texture_churn_probe_window_attempts = 0;
+    s_vp_texture_churn_probe_window_bytes = 0;
+}
+
+static int vp_texture_churn_probe_budget_reserve(u64 logical_bytes)
+{
+    if (!logical_bytes || logical_bytes > VP_TEX_CHURN_PROBE_MAX_BYTES_PER_ATTEMPT ||
+        s_vp_texture_churn_probe_window_attempts >= VP_TEX_CHURN_PROBE_MAX_ATTEMPTS ||
+        s_vp_texture_churn_probe_window_bytes > VP_TEX_CHURN_PROBE_MAX_BYTES_PER_WINDOW ||
+        logical_bytes > VP_TEX_CHURN_PROBE_MAX_BYTES_PER_WINDOW -
+                        s_vp_texture_churn_probe_window_bytes)
+        return 0;
+    ++s_vp_texture_churn_probe_window_attempts;
+    s_vp_texture_churn_probe_window_bytes += logical_bytes;
+    return 1;
+}
+
+static VPTexChurnProbeResult vp_texture_churn_probe_snapshot_rows(
+        const VPTexSnapshot* old_snapshot, const VPTexSnapshot* new_snapshot,
+        u32 row_bytes, u32 rows, u32 pitch, u64 required_span)
+{
+    if (!s_vp_texture_churn_enabled ||
+        !old_snapshot || !new_snapshot || old_snapshot == new_snapshot ||
+        !old_snapshot->data || !new_snapshot->data || !row_bytes || !rows ||
+        !old_snapshot->refs || !new_snapshot->refs ||
+        pitch < row_bytes || !required_span ||
+        old_snapshot->bytes != new_snapshot->bytes ||
+        old_snapshot->bytes < required_span || new_snapshot->bytes < required_span ||
+        (u64)(rows - 1u) > (UINT64_MAX - row_bytes) / pitch)
+        return VP_TEX_CHURN_PROBE_NONE;
+    const u64 last_row_end = (u64)(rows - 1u) * pitch + row_bytes;
+    if (last_row_end > required_span || (u64)row_bytes > UINT64_MAX / rows)
+        return VP_TEX_CHURN_PROBE_NONE;
+    const u64 logical_bytes = (u64)row_bytes * rows;
+    if (!vp_texture_churn_probe_budget_reserve(logical_bytes))
+        return VP_TEX_CHURN_PROBE_CAPPED;
+    for (u32 y = 0; y < rows; ++y) {
+        const u64 offset = (u64)y * pitch;
+        if (memcmp(old_snapshot->data + offset, new_snapshot->data + offset,
+                   row_bytes) != 0)
+            return VP_TEX_CHURN_PROBE_DIFFERENT;
+    }
+    return VP_TEX_CHURN_PROBE_EQUAL;
+}
+
+static int vp_texture_churn_trace_enabled(void)
+{
+    return s_vp_texture_churn_enabled;
+}
+
+static void vp_texture_churn_trace_reset(void)
+{
+    const char* value = getenv("TJ_TEXTURE_CHURN_TRACE");
+    s_vp_texture_churn_enabled = value && value[0] && strcmp(value, "0") != 0;
+    vp_texture_churn_probe_budget_reset();
+    InterlockedExchange64(&s_vp_texture_churn.new_snapshot_count, 0);
+    InterlockedExchange64(&s_vp_texture_churn.new_snapshot_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.budget_rejections, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p0_ref_drops, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p0_ref_drop_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p0_frees, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p0_freed_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p1_ref_drops, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p1_ref_drop_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p1_frees, 0);
+    InterlockedExchange64(&s_vp_texture_churn.trim_p1_freed_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.upload_misses, 0);
+    InterlockedExchange64(&s_vp_texture_churn.upload_source_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.same_snapshot_other_off_requests, 0);
+    InterlockedExchange64(&s_vp_texture_churn.same_off_other_identity_hash_equal_requests, 0);
+    InterlockedExchange64(&s_vp_texture_churn.same_off_other_identity_hash_different_requests, 0);
+    InterlockedExchange64(&s_vp_texture_churn.fresh_allocations, 0);
+    InterlockedExchange64(&s_vp_texture_churn.reused_storage_uploads, 0);
+    InterlockedExchange64(&s_vp_texture_churn.shape_plain_linear_uploads, 0);
+    InterlockedExchange64(&s_vp_texture_churn.shape_plain_linear_padded_uploads, 0);
+    InterlockedExchange64(&s_vp_texture_churn.shape_other_uploads, 0);
+    InterlockedExchange64(&s_vp_texture_churn.same_off_full_layout_candidate_uploads, 0);
+    InterlockedExchange64(&s_vp_texture_churn.logical_compare_attempts, 0);
+    InterlockedExchange64(&s_vp_texture_churn.logical_compare_equal, 0);
+    InterlockedExchange64(&s_vp_texture_churn.logical_compare_different, 0);
+    InterlockedExchange64(&s_vp_texture_churn.logical_compare_capped, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_admissions, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_admission_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_hint_reuses, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_hash_reuses, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_hash_same_off_reuses, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_hash_other_off_reuses, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_hint_retargets, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_hint_reuse_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_hash_reuse_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_cap_evictions, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_cap_owner_drop_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_budget_reclaims, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_budget_owner_drop_bytes, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_oversize_skips, 0);
+    InterlockedExchange64(&s_vp_texture_churn.snapshot_pool_oversize_skip_bytes, 0);
+}
+
+static u64 vp_texture_churn_take(volatile LONG64* counter)
+{
+    return (u64)InterlockedExchange64(counter, 0);
+}
+
+typedef enum VPTexSnapshotPoolEvictReason {
+    VP_TEX_SNAPSHOT_POOL_EVICT_CAP = 1,
+    VP_TEX_SNAPSHOT_POOL_EVICT_BUDGET = 2,
+    VP_TEX_SNAPSHOT_POOL_EVICT_SHUTDOWN = 3
+} VPTexSnapshotPoolEvictReason;
+
+static void vp_texture_snapshot_pool_evict_oldest(u32 reason)
+{
+    if (!s_d3d.vp_tex_snapshot_pool_count) return;
+    const u32 index = s_d3d.vp_tex_snapshot_pool_head;
+    VPTexSnapshot* snapshot = s_d3d.vp_tex_snapshot_pool[index];
+    s_d3d.vp_tex_snapshot_pool[index] = NULL;
+    s_d3d.vp_tex_snapshot_pool_head =
+        (index + 1u) % VP_TEX_SNAPSHOT_RETAIN_MAX_ENTRIES;
+    --s_d3d.vp_tex_snapshot_pool_count;
+    if (snapshot) {
+        const u64 bytes = snapshot->bytes;
+        if (s_d3d.vp_tex_snapshot_pool_bytes >= bytes)
+            s_d3d.vp_tex_snapshot_pool_bytes -= bytes;
+        else
+            s_d3d.vp_tex_snapshot_pool_bytes = 0;
+        snapshot->pool_retained = 0;
+        if (vp_texture_churn_trace_enabled()) {
+            if (reason == VP_TEX_SNAPSHOT_POOL_EVICT_CAP) {
+                InterlockedIncrement64(&s_vp_texture_churn.snapshot_pool_cap_evictions);
+                InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_cap_owner_drop_bytes,
+                                 (LONG64)bytes);
+            } else if (reason == VP_TEX_SNAPSHOT_POOL_EVICT_BUDGET) {
+                InterlockedIncrement64(&s_vp_texture_churn.snapshot_pool_budget_reclaims);
+                InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_budget_owner_drop_bytes,
+                                 (LONG64)bytes);
+            }
+        }
+        /* Drop the pool's strong reference without allowing its final release
+         * to immediately reinsert the same node. Other owners remain intact. */
+        ++s_d3d.vp_tex_snapshot_pool_suppress;
+        vp_texture_snapshot_release(&snapshot);
+        --s_d3d.vp_tex_snapshot_pool_suppress;
+    }
+}
+
+static int vp_texture_snapshot_pool_admit(VPTexSnapshot* snapshot)
+{
+    if (!snapshot || !s_d3d.vp_tex_snapshot_pool_enabled ||
+        s_d3d.vp_tex_snapshot_pool_suppress || snapshot->pool_retained ||
+        snapshot->refs != 1 || snapshot->is_override)
+        return 0;
+    if ((u64)snapshot->bytes > VP_TEX_SNAPSHOT_RETAIN_MAX_BYTES) {
+        if (vp_texture_churn_trace_enabled()) {
+            InterlockedIncrement64(&s_vp_texture_churn.snapshot_pool_oversize_skips);
+            InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_oversize_skip_bytes,
+                             (LONG64)snapshot->bytes);
+        }
+        return 0;
+    }
+    while (s_d3d.vp_tex_snapshot_pool_count &&
+           (s_d3d.vp_tex_snapshot_pool_count >= VP_TEX_SNAPSHOT_RETAIN_MAX_ENTRIES ||
+            s_d3d.vp_tex_snapshot_pool_bytes + snapshot->bytes >
+                VP_TEX_SNAPSHOT_RETAIN_MAX_BYTES))
+        vp_texture_snapshot_pool_evict_oldest(VP_TEX_SNAPSHOT_POOL_EVICT_CAP);
+    if (s_d3d.vp_tex_snapshot_pool_count >= VP_TEX_SNAPSHOT_RETAIN_MAX_ENTRIES ||
+        s_d3d.vp_tex_snapshot_pool_bytes + snapshot->bytes >
+            VP_TEX_SNAPSHOT_RETAIN_MAX_BYTES)
+        return 0;
+    const u32 index = (s_d3d.vp_tex_snapshot_pool_head +
+                       s_d3d.vp_tex_snapshot_pool_count) %
+                      VP_TEX_SNAPSHOT_RETAIN_MAX_ENTRIES;
+    if (s_d3d.vp_tex_snapshot_pool[index]) return 0;
+    snapshot->refs = 1; /* the pool becomes the node's strong owner */
+    snapshot->pool_retained = 1;
+    s_d3d.vp_tex_snapshot_pool[index] = snapshot;
+    ++s_d3d.vp_tex_snapshot_pool_count;
+    s_d3d.vp_tex_snapshot_pool_bytes += snapshot->bytes;
+    if (vp_texture_churn_trace_enabled()) {
+        InterlockedIncrement64(&s_vp_texture_churn.snapshot_pool_admissions);
+        InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_admission_bytes,
+                         (LONG64)snapshot->bytes);
+    }
+    return 1;
+}
+
+static void vp_texture_snapshot_pool_reclaim_for_budget(u32 incoming_bytes)
+{
+    if (!s_d3d.vp_tex_snapshot_pool_enabled) return;
+    while (s_d3d.vp_tex_snapshot_pool_count &&
+           s_d3d.vp_tex_snapshot_bytes + incoming_bytes >
+               VP_TEX_SNAPSHOT_MAX_BYTES)
+        vp_texture_snapshot_pool_evict_oldest(VP_TEX_SNAPSHOT_POOL_EVICT_BUDGET);
+}
+
+static void vp_texture_snapshot_pool_drain(u32 reason)
+{
+    VP_SNAP_PAR_BARRIER(OTHER);
+    while (s_d3d.vp_tex_snapshot_pool_count)
+        vp_texture_snapshot_pool_evict_oldest(reason);
+    s_d3d.vp_tex_snapshot_pool_head = 0;
+    s_d3d.vp_tex_snapshot_pool_bytes = 0;
+}
+
+static void vp_texture_snapshot_pool_init(void)
+{
+    const char* value = getenv("TJ_TEXTURE_SNAPSHOT_RETAIN");
+    const char* retarget = getenv("TJ_TEXTURE_SNAPSHOT_HINT_RETARGET");
+    s_d3d.vp_tex_snapshot_pool_enabled = value && strcmp(value, "1") == 0;
+    s_d3d.vp_tex_snapshot_pool_suppress = 0;
+    s_vp_texture_hint_retarget_config = s_d3d.vp_tex_snapshot_pool_enabled &&
+        retarget && strcmp(retarget, "1") == 0;
+    if (value && value[0])
+        fprintf(stderr, "[TJ-TEXTURE-SNAPSHOT-POOL] enabled=%d\n",
+                s_d3d.vp_tex_snapshot_pool_enabled);
+    if (retarget && retarget[0])
+        fprintf(stderr, "[TJ-TEXTURE-SNAPSHOT-HINT-RETARGET] enabled=%d\n",
+                s_vp_texture_hint_retarget_config);
+}
+
+static int vp_texture_snapshot_hint_retarget_enabled(void)
+{
+    return s_vp_texture_hint_retarget_config &&
+           s_d3d.vp_tex_snapshot_pool_enabled;
+}
+
+static void vp_texture_churn_record_new_snapshot(u64 bytes)
+{
+    InterlockedIncrement64(&s_vp_texture_churn.new_snapshot_count);
+    InterlockedAdd64(&s_vp_texture_churn.new_snapshot_bytes, (LONG64)bytes);
+}
+
+static void vp_texture_churn_record_budget_reject(void)
+{
+    InterlockedIncrement64(&s_vp_texture_churn.budget_rejections);
+}
+
+static void vp_texture_churn_record_trim(u32 pass, u64 bytes, u64 freed_bytes)
+{
+    volatile LONG64* drops = pass ? &s_vp_texture_churn.trim_p1_ref_drops
+                                  : &s_vp_texture_churn.trim_p0_ref_drops;
+    volatile LONG64* drop_bytes = pass ? &s_vp_texture_churn.trim_p1_ref_drop_bytes
+                                       : &s_vp_texture_churn.trim_p0_ref_drop_bytes;
+    volatile LONG64* frees = pass ? &s_vp_texture_churn.trim_p1_frees
+                                  : &s_vp_texture_churn.trim_p0_frees;
+    volatile LONG64* freed_total = pass ? &s_vp_texture_churn.trim_p1_freed_bytes
+                                        : &s_vp_texture_churn.trim_p0_freed_bytes;
+    InterlockedIncrement64(drops);
+    InterlockedAdd64(drop_bytes, (LONG64)bytes);
+    if (freed_bytes) {
+        InterlockedIncrement64(frees);
+        InterlockedAdd64(freed_total, (LONG64)freed_bytes);
+    }
+}
+
+static void vp_texture_churn_record_upload_candidates(int same_snapshot_other_off,
+                                                       int same_off_hash_equal,
+                                                       int same_off_hash_different)
+{
+    if (same_snapshot_other_off)
+        InterlockedIncrement64(&s_vp_texture_churn.same_snapshot_other_off_requests);
+    if (same_off_hash_equal)
+        InterlockedIncrement64(&s_vp_texture_churn.same_off_other_identity_hash_equal_requests);
+    if (same_off_hash_different)
+        InterlockedIncrement64(&s_vp_texture_churn.same_off_other_identity_hash_different_requests);
+}
+
+static void vp_texture_churn_record_upload_miss(u64 source_bytes, int fresh_resource)
+{
+    InterlockedIncrement64(&s_vp_texture_churn.upload_misses);
+    InterlockedAdd64(&s_vp_texture_churn.upload_source_bytes, (LONG64)source_bytes);
+    if (fresh_resource)
+        InterlockedIncrement64(&s_vp_texture_churn.fresh_allocations);
+    else
+        InterlockedIncrement64(&s_vp_texture_churn.reused_storage_uploads);
+}
+
+static void vp_texture_churn_record_upload_probe(int plain_linear, int padded,
+        int candidate, VPTexChurnProbeResult result)
+{
+    if (plain_linear)
+        InterlockedIncrement64(&s_vp_texture_churn.shape_plain_linear_uploads);
+    else
+        InterlockedIncrement64(&s_vp_texture_churn.shape_other_uploads);
+    if (padded)
+        InterlockedIncrement64(&s_vp_texture_churn.shape_plain_linear_padded_uploads);
+    if (candidate)
+        InterlockedIncrement64(&s_vp_texture_churn.same_off_full_layout_candidate_uploads);
+    if (result == VP_TEX_CHURN_PROBE_EQUAL ||
+        result == VP_TEX_CHURN_PROBE_DIFFERENT) {
+        InterlockedIncrement64(&s_vp_texture_churn.logical_compare_attempts);
+        InterlockedIncrement64(result == VP_TEX_CHURN_PROBE_EQUAL
+            ? &s_vp_texture_churn.logical_compare_equal
+            : &s_vp_texture_churn.logical_compare_different);
+    } else if (result == VP_TEX_CHURN_PROBE_CAPPED) {
+        InterlockedIncrement64(&s_vp_texture_churn.logical_compare_capped);
+    }
+}
