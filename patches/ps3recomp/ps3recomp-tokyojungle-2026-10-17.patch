+static void trace_watched_event_flag_atomic(const spu_context* ctx,
+                                            const char* command,
+                                            uint32_t ea,
+                                            const uint8_t* before,
+                                            const uint8_t* after)
+{
+    if (!g_spu_event_flag_watch_ea ||
