+/* TJ_EDGE_NOWAIT, zero-draw edge with work outstanding. 0: take the original
+ * checked wait. 1: skip it; only the last final frame (list, Present, Signal)
+ * is in flight and nothing guest-visible waits on it: no texture label, MAIN
+ * writeback/export or immutable mirror, prefix owner, capture or observer.
+ * 2: that frame's post-Present Signal has already completed. */
+static int d3d12_edge_nowait_decide(void)
+{
+    if (!s_edge_nowait.final_only) {
+        ++s_edge_nowait.waited;
+        return 0;
+    }
+    const char* why = NULL;
+    if (!rsx_survival_trace_is_armed())
+        why = "unarmed";
+    else if (s_present_phase.held)
+        why = "held";     /* final frame recorded, Present not issued yet */
+    else if (!s_edge_nowait.present_ticket ||
+             s_d3d.gpu_completion_ticket != s_edge_nowait.present_ticket)
+        why = "ticket";   /* Present not issued yet, or queue work after its Signal */
+    else if (s_edge_nowait.basic_vb)
+        why = "basic_vb"; /* next records rewrite it from offset 0 */
+    else if (s_d3d.texture_label_count || s_d3d.texture_label_armed)
+        why = "labels";
+    else if (s_exact_writeback_count)
+        why = "writeback";
+    else if (s_d3d.prefix_owner_active || s_d3d.prefix_prepare_owner ||
+             s_d3d.prefix_deferred_owner || s_d3d.prefix_owners[0].phase ||
+             s_d3d.prefix_owners[1].phase)
+        why = "owner";
+    else if (s_d3d.dump_frames_left || tj_indexed_diag_has_records() ||
+             tj_compose_target_enabled() || tj_compose_capture_enabled() ||
+             tj_gcm2d_backend_perf_enabled() || tj_main_direct_readback_enabled() ||
+             d3d12_texture_release_nowait_observer_blocked())
+        why = "observer";
+    for (u32 i = 0; !why && i < MAX_GPU_MIRRORS; ++i) {
+        const GpuMirror* mirror = &s_d3d.gpu_mirror[i];
+        if (mirror->valid && (!mirror->local || mirror->immutable_source))
+            why = "mirror";
+    }
+    u64 completed = 0;
+    if (!why) {
+        completed = s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence);
+        if (completed == UINT64_MAX) why = "device"; /* the checked wait reports it */
+    }
+    if (why) {
+        s_edge_nowait.why = why;
+        ++s_edge_nowait.waited_final;
+        return 0;
+    }
+    if (completed >= s_edge_nowait.present_ticket) {
+        ++s_edge_nowait.idle;
+        return 2;
+    }
+    ++s_edge_nowait.skipped;
+    return 1;
+}
