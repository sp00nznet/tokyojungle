+static int gcm_wait_perf_append(char* line, int len, int cap, const char* fmt, ...)
+{
+    if (len < 0 || len >= cap) return len;
+    va_list args;
+    va_start(args, fmt);
+    const int n = vsnprintf(line + len, (size_t)(cap - len), fmt, args);
+    va_end(args);
+    return n < 0 ? len : (len + n < cap ? len + n : cap - 1);
+}
