+/* Opt-in TJ_VERTEX_PARALLEL=N (2..16 threads incl. caller): large linear or
+ * expanded-index draws convert disjoint vertex ranges on N-1 helper threads.
+ * read_vp_vertex only reads guest memory/state and writes its own 256-byte
+ * slots, so output bytes are identical to the serial loop. Small draws and
+ * any pool failure stay serial. */
+#define VP_PAR_MAX_WORKERS 15
+#define VP_PAR_MIN_VERTS   1024u
+#define VP_PAR_CHUNK       256u
+typedef struct VPParJob {
+    const rsx_state* state;
+    const VPVertexPlan* plan;     /* immutable caller stack, live through join */
+    VPSlot* out;
+    u32 first, count, indexed;
+    u16 attr_mask;
+    volatile LONG next_chunk;
+    volatile LONG pending;
+} VPParJob;
+static VPParJob s_vp_par_job;
+static HANDLE s_vp_par_wake[VP_PAR_MAX_WORKERS];
+static HANDLE s_vp_par_done;
+static int s_vp_par_workers = -1;   /* -1 unset, 0 disabled */
+static u64 s_vp_par_draws, s_vp_par_verts;
+static u32 read_guest_index(const rsx_state* st, u32 k);
+
+static void vp_par_run(VPParJob* j)
+{
+    s_tj_vp_upload_attr_mask = j->attr_mask;
+    for (;;) {
+        const u32 b = (u32)(InterlockedIncrement(&j->next_chunk) - 1) * VP_PAR_CHUNK;
+        if (b >= j->count) break;
+        const u32 e = j->count - b < VP_PAR_CHUNK ? j->count : b + VP_PAR_CHUNK;
+        for (u32 k = b; k < e; ++k) {
+            const u32 vi = j->indexed ? read_guest_index(j->state, j->first + k)
+                                      : j->first + k;
+            if (j->plan) read_vp_vertex_planned(j->plan, vi, &j->out[k * 16]);
+            else read_vp_vertex(j->state, vi, &j->out[k * 16]);
+        }
+    }
+}
+
+static DWORD WINAPI vp_par_worker(LPVOID arg)
+{
+    const int id = (int)(intptr_t)arg;
+    for (;;) {
+        WaitForSingleObject(s_vp_par_wake[id], INFINITE);
+        vp_par_run(&s_vp_par_job);
+        if (InterlockedDecrement(&s_vp_par_job.pending) == 0) SetEvent(s_vp_par_done);
+    }
+}
+
+static int vp_par_init(void)
+{
+    if (s_vp_par_workers >= 0) return s_vp_par_workers;
+    s_vp_par_workers = 0;
+    const char* v = getenv("TJ_VERTEX_PARALLEL");
+    int n = v ? atoi(v) : 0;
+    if (n < 2) return 0;
+    if (n > VP_PAR_MAX_WORKERS + 1) n = VP_PAR_MAX_WORKERS + 1;
+    s_vp_par_done = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (!s_vp_par_done) return 0;
+    int made = 0;
+    for (int i = 0; i < n - 1; ++i) {
+        s_vp_par_wake[i] = CreateEventW(NULL, FALSE, FALSE, NULL);
+        if (!s_vp_par_wake[i]) break;
+        HANDLE t = CreateThread(NULL, 0, vp_par_worker, (LPVOID)(intptr_t)i, 0, NULL);
+        if (!t) { CloseHandle(s_vp_par_wake[i]); s_vp_par_wake[i] = NULL; break; }
+        SetThreadPriority(t, THREAD_PRIORITY_ABOVE_NORMAL);
+        CloseHandle(t);
+        ++made;
+    }
+    s_vp_par_workers = made;
+    fprintf(stderr, "[tj-vertex-parallel] %d helper threads (min %u verts/draw)\n",
+            made, VP_PAR_MIN_VERTS);
+    return made;
+}
