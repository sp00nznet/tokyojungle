+    s_d3d.scale = 1;
+    s_d3d.internal_w = s_d3d.internal_h = 0;
+    s_d3d.out_w = s_d3d.out_h = 0;
+    rsx_fp_set_wpos_host_scale(0);
+    if (s_d3d.hwnd) {
+        /* A borderless popup becomes an ordinary window of the guest size. */
+        LONG_PTR style = GetWindowLongPtrA(s_d3d.hwnd, GWL_STYLE);
+        UINT flags = SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOMOVE;
+        if (style & WS_POPUP) {
+            style = (style & ~(LONG_PTR)WS_POPUP) | WS_OVERLAPPEDWINDOW;
+            SetWindowLongPtrA(s_d3d.hwnd, GWL_STYLE, style);
+            flags |= SWP_FRAMECHANGED;
+        }
+        RECT wr = {0, 0, (LONG)w, (LONG)h};
+        AdjustWindowRect(&wr, (DWORD)style, FALSE);
+        SetWindowPos(s_d3d.hwnd, NULL, 0, 0, wr.right - wr.left, wr.bottom - wr.top, flags);
+    }
+    fprintf(stderr, "[tj-scale] render scale 1: copy pass unavailable; swap chain and "
+            "window %ux%u\n", w, h);
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * D3D12 initialization
+ * -----------------------------------------------------------------------*/
+
+static int d3d12_gpu_queue_high_priority_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_GPU_QUEUE_HIGH_PRIORITY");
+        enabled = value && strcmp(value, "1") == 0;
+    }
+    return enabled;
+}
+
+static const char* d3d12_command_queue_priority_name(int priority)
+{
+    if (priority == D3D12_COMMAND_QUEUE_PRIORITY_NORMAL) return "NORMAL";
+    if (priority == D3D12_COMMAND_QUEUE_PRIORITY_HIGH) return "HIGH";
+    return "NONE";
+}
+
+static void d3d12_log_command_queue_priority(int requested_high, int selected_priority,
+                                              HRESULT query_hr, int high_supported,
+                                              int fallback_used, HRESULT create_hr)
+{
+    fprintf(stderr,
+        "[D3D12-QUEUE-PRIORITY] requested_high=%d selected=%s(%d) "
+        "query_hr=0x%08lX high_supported=%d fallback=%d create_hr=0x%08lX\n",
+        requested_high, d3d12_command_queue_priority_name(selected_priority),
+        selected_priority, (unsigned long)query_hr, high_supported, fallback_used,
+        (unsigned long)create_hr);
+}
+
+static HRESULT d3d12_create_command_queue_for_device(
+    ID3D12Device* device, ID3D12CommandQueue** out_queue, int request_high,
+    int* selected_priority, HRESULT* priority_query_hr, int* high_supported,
+    int* fallback_used)
+{
+    if (!device || !out_queue || !selected_priority || !priority_query_hr ||
+        !high_supported || !fallback_used)
+        return E_INVALIDARG;
+
+    *out_queue = NULL;
+    *selected_priority = -1;
+    *priority_query_hr = S_FALSE; /* no feature query unless explicitly requested */
+    *high_supported = 0;
+    *fallback_used = 0;
+
+    D3D12_COMMAND_QUEUE_DESC queue_desc = {0};
+    queue_desc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    queue_desc.Priority = D3D12_COMMAND_QUEUE_PRIORITY_NORMAL;
+
+    if (request_high) {
+        D3D12_FEATURE_DATA_COMMAND_QUEUE_PRIORITY priority = {0};
+        priority.CommandListType = D3D12_COMMAND_LIST_TYPE_DIRECT;
+        priority.Priority = D3D12_COMMAND_QUEUE_PRIORITY_HIGH;
+        *priority_query_hr = device->lpVtbl->CheckFeatureSupport(
+            device, D3D12_FEATURE_COMMAND_QUEUE_PRIORITY, &priority,
+            (UINT)sizeof(priority));
+        if (SUCCEEDED(*priority_query_hr))
+            *high_supported = priority.PriorityForTypeIsSupported != FALSE;
+
+        if (*high_supported) {
+            queue_desc.Priority = D3D12_COMMAND_QUEUE_PRIORITY_HIGH;
+            HRESULT hr = device->lpVtbl->CreateCommandQueue(
+                device, &queue_desc, &IID_ID3D12CommandQueue, (void**)out_queue);
+            if (SUCCEEDED(hr)) {
+                *selected_priority = D3D12_COMMAND_QUEUE_PRIORITY_HIGH;
+                return hr;
+            }
+            if (*out_queue) {
+                (*out_queue)->lpVtbl->Release(*out_queue);
+                *out_queue = NULL;
+            }
+            if (hr != E_INVALIDARG && hr != E_NOTIMPL)
+                return hr;
+            *fallback_used = 1;
+        } else {
+            *fallback_used = 1;
+        }
+    }
+
+    queue_desc.Priority = D3D12_COMMAND_QUEUE_PRIORITY_NORMAL;
+    HRESULT hr = device->lpVtbl->CreateCommandQueue(
+        device, &queue_desc, &IID_ID3D12CommandQueue, (void**)out_queue);
+    if (SUCCEEDED(hr)) {
+        *selected_priority = D3D12_COMMAND_QUEUE_PRIORITY_NORMAL;
+        return hr;
+    }
+    if (*out_queue) {
+        (*out_queue)->lpVtbl->Release(*out_queue);
+        *out_queue = NULL;
+    }
+    return hr;
+}
+
+static int init_d3d12(u32 width, u32 height)
+{
+    HRESULT hr;
+
+    /* DRED must be enabled before the device is created.  Keep it opt-in: it
+     * adds useful GPU breadcrumbs/page-fault data but is diagnostic overhead. */
+    if (getenv("D3D12_DRED")) {
+        ID3D12DeviceRemovedExtendedDataSettings* dred_settings = NULL;
+        hr = D3D12GetDebugInterface(
+            &IID_ID3D12DeviceRemovedExtendedDataSettings,
+            (void**)&dred_settings);
+        if (SUCCEEDED(hr) && dred_settings) {
+            dred_settings->lpVtbl->SetAutoBreadcrumbsEnablement(
+                dred_settings, D3D12_DRED_ENABLEMENT_FORCED_ON);
+            dred_settings->lpVtbl->SetPageFaultEnablement(
+                dred_settings, D3D12_DRED_ENABLEMENT_FORCED_ON);
+            dred_settings->lpVtbl->Release(dred_settings);
+            printf("[D3D12] DRED breadcrumbs/page faults enabled\n");
+        } else {
+            printf("[D3D12] DRED requested but unavailable (0x%08lX)\n", hr);
+        }
+    }
+
+    /* Enable debug layer in debug builds */
+    /* Debug layer: on in debug builds, or in any build when D3D12_DBG is set
+     * (so a Release run can capture exact PSO/validation errors). */
+    if (
+#ifdef NDEBUG
+        getenv("D3D12_DBG")
+#else
+        1
+#endif
+    ) {
+        ID3D12Debug* debug_controller = NULL;
+        hr = D3D12GetDebugInterface(&IID_ID3D12Debug, (void**)&debug_controller);
+        if (SUCCEEDED(hr) && debug_controller) {
+            debug_controller->lpVtbl->EnableDebugLayer(debug_controller);
+            debug_controller->lpVtbl->Release(debug_controller);
+            printf("[D3D12] Debug layer enabled\n");
+        } else {
+            printf("[D3D12] Debug layer requested but unavailable (0x%08lX) -- "
+                   "install 'Graphics Tools' optional feature\n", hr);
+        }
+    }
+
+    /* Create DXGI factory */
+    IDXGIFactory4* factory = NULL;
+    hr = CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&factory);
+    if (FAILED(hr)) {
+        printf("[D3D12] ERROR: CreateDXGIFactory1 failed (0x%08lX)\n", hr);
+        return -1;
+    }
+
+    /* Create D3D12 device. On a dual-GPU laptop a NULL adapter usually lands on
+     * the integrated GPU; explicitly pick the high-performance (discrete)
+     * adapter via IDXGIFactory6. Set CELLMARK_IGPU to force the low-power one
+     * (for A/B testing a suspected iGPU-driver stall). */
+    {
+        IDXGIFactory6* factory6 = NULL;
+        if (SUCCEEDED(factory->lpVtbl->QueryInterface(
+                factory, &IID_IDXGIFactory6, (void**)&factory6))) {
+            DXGI_GPU_PREFERENCE pref = getenv("CELLMARK_IGPU")
+                ? DXGI_GPU_PREFERENCE_MINIMUM_POWER
+                : DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE;
+            IDXGIAdapter1* adapter = NULL;
+            for (UINT ai = 0; factory6->lpVtbl->EnumAdapterByGpuPreference(
+                     factory6, ai, pref, &IID_IDXGIAdapter1, (void**)&adapter)
+                     != DXGI_ERROR_NOT_FOUND; ai++) {
+                DXGI_ADAPTER_DESC1 ad;
+                adapter->lpVtbl->GetDesc1(adapter, &ad);
+                if (!(ad.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) &&
+                    SUCCEEDED(D3D12CreateDevice((IUnknown*)adapter,
+                        D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device,
+                        (void**)&s_d3d.device))) {
+                    printf("[D3D12] adapter: %ls (VRAM %llu MB)\n", ad.Description,
+                           (unsigned long long)(ad.DedicatedVideoMemory >> 20));
+                    adapter->lpVtbl->Release(adapter);
+                    break;
+                }
+                adapter->lpVtbl->Release(adapter);
+                adapter = NULL;
+            }
+            factory6->lpVtbl->Release(factory6);
+        }
+    }
+    if (!s_d3d.device) {
+        hr = D3D12CreateDevice(NULL, D3D_FEATURE_LEVEL_11_0,
+                               &IID_ID3D12Device, (void**)&s_d3d.device);
+        if (FAILED(hr)) {
+            printf("[D3D12] ERROR: D3D12CreateDevice failed (0x%08lX)\n", hr);
+            factory->lpVtbl->Release(factory);
+            return -1;
+        }
+        printf("[D3D12] Device created on default adapter (feature level 11.0)\n");
+    }
+
+    /* Keep NORMAL as the default; HIGH is an explicit, feature-queried experiment. */
+    const int queue_high_requested = d3d12_gpu_queue_high_priority_enabled();
+    int queue_selected_priority = -1;
+    int queue_high_supported = 0;
+    int queue_fallback_used = 0;
+    HRESULT queue_priority_query_hr = S_FALSE;
+    hr = d3d12_create_command_queue_for_device(
+        s_d3d.device, &s_d3d.cmd_queue, queue_high_requested,
+        &queue_selected_priority, &queue_priority_query_hr,
+        &queue_high_supported, &queue_fallback_used);
+    d3d12_log_command_queue_priority(queue_high_requested, queue_selected_priority,
+        queue_priority_query_hr, queue_high_supported, queue_fallback_used, hr);
+    if (FAILED(hr)) {
+        printf("[D3D12] ERROR: CreateCommandQueue failed\n");
+        factory->lpVtbl->Release(factory);
+        return -1;
+    }
+
+    /* Create swap chain */
+    DXGI_SWAP_CHAIN_DESC1 sc_desc = {0};
+    sc_desc.Width = width;
+    sc_desc.Height = height;
+    sc_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    sc_desc.SampleDesc.Count = 1;
+    sc_desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    sc_desc.BufferCount = s_d3d.swap_buffer_count;
+    sc_desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+
+    IDXGISwapChain1* swap_chain1 = NULL;
+    hr = factory->lpVtbl->CreateSwapChainForHwnd(
+        factory, (IUnknown*)s_d3d.cmd_queue,
+        s_d3d.hwnd, &sc_desc, NULL, NULL, &swap_chain1);
+    if (FAILED(hr)) {
+        printf("[D3D12] ERROR: CreateSwapChainForHwnd failed (0x%08lX)\n", hr);
+        factory->lpVtbl->Release(factory);
+        return -1;
+    }
+
+    /* Disable Alt+Enter fullscreen toggle */
+    factory->lpVtbl->MakeWindowAssociation(factory, s_d3d.hwnd, DXGI_MWA_NO_ALT_ENTER);
+    factory->lpVtbl->Release(factory);
+
+    /* Query SwapChain3 interface */
+    hr = swap_chain1->lpVtbl->QueryInterface(
+        swap_chain1, &IID_IDXGISwapChain3, (void**)&s_d3d.swap_chain);
+    swap_chain1->lpVtbl->Release(swap_chain1);
+    if (FAILED(hr)) {
+        printf("[D3D12] ERROR: QueryInterface for SwapChain3 failed\n");
+        return -1;
+    }
+
+    s_d3d.frame_index = s_d3d.swap_chain->lpVtbl->GetCurrentBackBufferIndex(s_d3d.swap_chain);
+
+    /* Create RTV descriptor heap */
+    D3D12_DESCRIPTOR_HEAP_DESC rtv_heap_desc = {0};
+    rtv_heap_desc.NumDescriptors = s_d3d.swap_buffer_count;
+    rtv_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+    hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+        s_d3d.device, &rtv_heap_desc, &IID_ID3D12DescriptorHeap, (void**)&s_d3d.rtv_heap);
+    if (FAILED(hr)) return -1;
+
+    s_d3d.rtv_descriptor_size = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+
+    /* Create RTVs for each frame */
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv_handle;
+    s_d3d.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rtv_heap, &rtv_handle);
+
+    for (u32 i = 0; i < s_d3d.swap_buffer_count; i++) {
+        hr = s_d3d.swap_chain->lpVtbl->GetBuffer(
+            s_d3d.swap_chain, i, &IID_ID3D12Resource, (void**)&s_d3d.render_targets[i]);
+        if (FAILED(hr)) return -1;
+
+        d3d12_owned_rtv(s_d3d.render_targets[i], NULL, rtv_handle);
+        rtv_handle.ptr += s_d3d.rtv_descriptor_size;
+    }
+
+    /* ---------------------------------------------------------------
+     * Depth/stencil buffer
+     * 24-bit depth + 8-bit stencil (DXGI_FORMAT_D24_UNORM_S8_UINT).
+     * One shared depth texture across both frames — RSX games on PS3
+     * typically use a single zeta surface.
+     * ---------------------------------------------------------------*/
+    {
+        D3D12_DESCRIPTOR_HEAP_DESC dsv_heap_desc = {0};
+        dsv_heap_desc.NumDescriptors = 1 + MAX_DEPTH_SURFACES;
+        dsv_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+        hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+            s_d3d.device, &dsv_heap_desc, &IID_ID3D12DescriptorHeap,
+            (void**)&s_d3d.dsv_heap);
+        if (FAILED(hr)) {
+            printf("[D3D12] DSV heap creation failed\n");
+            return -1;
+        }
+        s_d3d.dsv_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+            s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_DSV);
+
+        D3D12_HEAP_PROPERTIES heap_props = {0};
+        heap_props.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+        D3D12_RESOURCE_DESC depth_desc = {0};
+        depth_desc.Dimension          = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        /* Sized to cover the LARGEST render target, not just the window:
+         * D3D12 clips rasterization to the smallest bound attachment, and
+         * this DSV is shared by every pass -- with a window-sized depth
+         * buffer, draws into larger offscreen RTs (wave's 1920x1080 input
+         * image) were silently cropped to the window rect. */
+        depth_desc.Width              = 2048;
+        depth_desc.Height             = 2048;
+        /* TJ_RENDER_SCALE: zeta-less draws into internal-size displays and
+         * the swap chain need the same cover in host pixels (2560x2048 at 2x),
+         * or HUD draws clip at x=2048. 1x keeps 2048x2048. */
+        if (s_d3d.scale > 1) {
+            const u32 cover_w = s_d3d.internal_w > s_d3d.out_w ? s_d3d.internal_w : s_d3d.out_w;
+            const u32 cover_h = s_d3d.internal_h > s_d3d.out_h ? s_d3d.internal_h : s_d3d.out_h;
+            if (cover_w > depth_desc.Width) depth_desc.Width = cover_w;
+            if (cover_h > depth_desc.Height) depth_desc.Height = cover_h;
+        }
+        depth_desc.DepthOrArraySize   = 1;
+        depth_desc.MipLevels          = 1;
+        depth_desc.Format             = DXGI_FORMAT_D24_UNORM_S8_UINT;
+        depth_desc.SampleDesc.Count   = 1;
+        depth_desc.Layout             = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+        depth_desc.Flags              = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+
+        D3D12_CLEAR_VALUE depth_clear = {0};
+        depth_clear.Format                       = DXGI_FORMAT_D24_UNORM_S8_UINT;
+        depth_clear.DepthStencil.Depth           = 1.0f;
+        depth_clear.DepthStencil.Stencil         = 0;
+
+        hr = s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &heap_props, D3D12_HEAP_FLAG_NONE,
+            &depth_desc, D3D12_RESOURCE_STATE_DEPTH_WRITE, &depth_clear,
+            &IID_ID3D12Resource, (void**)&s_d3d.depth_buffer);
+        if (FAILED(hr)) {
+            printf("[D3D12] Depth buffer creation failed (0x%08lX)\n", hr);
+            return -1;
+        }
+
+        D3D12_DEPTH_STENCIL_VIEW_DESC dsv_desc = {0};
+        dsv_desc.Format         = DXGI_FORMAT_D24_UNORM_S8_UINT;
+        dsv_desc.ViewDimension  = D3D12_DSV_DIMENSION_TEXTURE2D;
+
+        D3D12_CPU_DESCRIPTOR_HANDLE dsv_handle;
+        s_d3d.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.dsv_heap, &dsv_handle);
+        d3d12_owned_dsv(s_d3d.depth_buffer, &dsv_desc, dsv_handle);
+
+        if (s_d3d.scale > 1)
+            printf("[D3D12] Depth buffer created (%ux%u D24S8)\n",
+                   (u32)depth_desc.Width, depth_desc.Height);
+        else
+            printf("[D3D12] Depth buffer created (%ux%u D24S8)\n", width, height);
+    }
+
+    /* Create command allocators and command list */
+    for (u32 i = 0; i < s_d3d.swap_buffer_count; i++) {
+        hr = s_d3d.device->lpVtbl->CreateCommandAllocator(
+            s_d3d.device, D3D12_COMMAND_LIST_TYPE_DIRECT,
+            &IID_ID3D12CommandAllocator, (void**)&s_d3d.cmd_allocators[i]);
+        if (FAILED(hr)) return -1;
+    }
+
+    hr = s_d3d.device->lpVtbl->CreateCommandList(
+        s_d3d.device, 0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+        s_d3d.cmd_allocators[0], NULL,
+        &IID_ID3D12GraphicsCommandList, (void**)&s_d3d.cmd_list);
+    if (FAILED(hr)) return -1;
+    s_d3d.cmd_list->lpVtbl->QueryInterface(
+        s_d3d.cmd_list, &IID_ID3D12GraphicsCommandList8,
+        (void**)&s_d3d.cmd_list8);
+
+    /* Close the command list (it starts in recording state). */
+    hr = s_d3d.cmd_list->lpVtbl->Close(s_d3d.cmd_list);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[D3D12-COMMAND] initialization Close failed hr=0x%08lX\n", (long)hr);
+        return -1;
+    }
+
+    /* Create fence */
+    hr = s_d3d.device->lpVtbl->CreateFence(
+        s_d3d.device, 0, D3D12_FENCE_FLAG_NONE,
+        &IID_ID3D12Fence, (void**)&s_d3d.fence);
+    if (FAILED(hr)) return -1;
+
+    s_d3d.fence_event = CreateEvent(NULL, FALSE, FALSE, NULL);
+    if (!s_d3d.fence_event) {
+        fprintf(stderr, "[D3D12-FENCE] event creation failed error=%lu\n", GetLastError());
+        return -1;
+    }
+    memset(s_d3d.fence_values, 0, sizeof(s_d3d.fence_values));
+    s_d3d.gpu_completion_ticket = 0;
+    s_d3d.gpu_completion_reused = s_d3d.gpu_completion_fresh = 0;
+
+    /* ---------------------------------------------------------------
+     * Create root signature with 16 root constants (one mat4 MVP at b0).
+     * Visible only to the vertex shader — pixel shader doesn't need it.
+     * ---------------------------------------------------------------*/
+    {
+        /* param 0: mat4 MVP as 16 root constants at b0 (vertex shader).
+         * param 1: one SRV (t0) descriptor table for the atlas texture (pixel).
+         * static sampler s0: linear clamp. The plain (untextured) PSO simply
+         * never references t0/s0, so it ignores them. */
+        D3D12_DESCRIPTOR_RANGE srv_range = {0};
+        srv_range.RangeType          = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        srv_range.NumDescriptors     = 1;
+        srv_range.BaseShaderRegister = 0;   /* t0 */
+        srv_range.OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+
+        D3D12_ROOT_PARAMETER root_params[2] = {0};
+        root_params[0].ParameterType            = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        root_params[0].Constants.ShaderRegister = 0;   /* b0 */
+        root_params[0].Constants.RegisterSpace  = 0;
+        root_params[0].Constants.Num32BitValues = 16;  /* mat4 */
+        root_params[0].ShaderVisibility         = D3D12_SHADER_VISIBILITY_VERTEX;
+        root_params[1].ParameterType            = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        root_params[1].DescriptorTable.NumDescriptorRanges = 1;
+        root_params[1].DescriptorTable.pDescriptorRanges   = &srv_range;
+        root_params[1].ShaderVisibility         = D3D12_SHADER_VISIBILITY_PIXEL;
+
+        D3D12_STATIC_SAMPLER_DESC samp = {0};
+        samp.Filter           = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+        samp.AddressU         = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        samp.AddressV         = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        samp.AddressW         = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        samp.ShaderRegister   = 0;   /* s0 */
+        samp.MaxLOD           = D3D12_FLOAT32_MAX;
+        samp.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+
+        D3D12_ROOT_SIGNATURE_DESC rs_desc = {0};
+        rs_desc.NumParameters     = 2;
+        rs_desc.pParameters       = root_params;
+        rs_desc.NumStaticSamplers = 1;
+        rs_desc.pStaticSamplers   = &samp;
+        rs_desc.Flags         = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT
+                              | D3D12_ROOT_SIGNATURE_FLAG_DENY_HULL_SHADER_ROOT_ACCESS
+                              | D3D12_ROOT_SIGNATURE_FLAG_DENY_DOMAIN_SHADER_ROOT_ACCESS
+                              | D3D12_ROOT_SIGNATURE_FLAG_DENY_GEOMETRY_SHADER_ROOT_ACCESS;
+
+        ID3DBlob* signature_blob = NULL;
+        ID3DBlob* error_blob = NULL;
+        hr = D3D12SerializeRootSignature(&rs_desc, D3D_ROOT_SIGNATURE_VERSION_1,
+                                          &signature_blob, &error_blob);
+        if (FAILED(hr)) {
+            printf("[D3D12] Root signature serialization failed: %s\n",
+                   error_blob ? (const char*)error_blob->lpVtbl->GetBufferPointer(error_blob) : "?");
+            if (error_blob) error_blob->lpVtbl->Release(error_blob);
+            return -1;
+        }
+
+        hr = s_d3d.device->lpVtbl->CreateRootSignature(
+            s_d3d.device, 0,
+            signature_blob->lpVtbl->GetBufferPointer(signature_blob),
+            signature_blob->lpVtbl->GetBufferSize(signature_blob),
+            &IID_ID3D12RootSignature, (void**)&s_d3d.root_signature);
+        signature_blob->lpVtbl->Release(signature_blob);
+        if (FAILED(hr)) {
+            printf("[D3D12] Root signature creation failed\n");
+            return -1;
+        }
+    }
+
+    /* ---------------------------------------------------------------
+     * Compile shaders and create PSO
+     * ---------------------------------------------------------------*/
+    {
+        /* Basic vertex-colored shader.
+         * The MVP matrix arrives via root constants as 4 vec4 columns
+         * (PS3/OpenGL column-major convention). We multiply explicitly so
+         * we don't depend on HLSL's matrix packing — matches PS3 semantics
+         * `gl_Position = MVP * vec4(pos, 1.0)`. */
+        static const char vs_hlsl[] =
+            "cbuffer cb0 : register(b0) {\n"
+            "    float4 mvp_col0;\n"
+            "    float4 mvp_col1;\n"
+            "    float4 mvp_col2;\n"
+            "    float4 mvp_col3;\n"
+            "};\n"
+            "struct VSInput  { float3 pos : POSITION; float4 col : COLOR; };\n"
+            "struct VSOutput { float4 pos : SV_POSITION; float4 col : COLOR; };\n"
+            "VSOutput main(VSInput i) {\n"
+            "    VSOutput o;\n"
+            "    float4 p = float4(i.pos, 1.0);\n"
+            "    o.pos = mvp_col0 * p.x + mvp_col1 * p.y + mvp_col2 * p.z + mvp_col3 * p.w;\n"
+            "    o.col = i.col;\n"
+            "    return o;\n"
+            "}\n";
+        static const char ps_hlsl[] =
+            "struct PSInput { float4 pos : SV_POSITION; float4 col : COLOR; };\n"
+            "float4 main(PSInput i) : SV_TARGET { return i.col; }\n";
+
+        ID3DBlob* vs_blob = NULL;
+        ID3DBlob* ps_blob = NULL;
+        ID3DBlob* err = NULL;
+
+        hr = D3DCompile(vs_hlsl, sizeof(vs_hlsl) - 1, "vs_basic", NULL, NULL,
+                        "main", "vs_5_0", 0, 0, &vs_blob, &err);
+        if (FAILED(hr)) {
+            printf("[D3D12] VS compile failed: %s\n",
+                   err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "unknown");
+            if (err) err->lpVtbl->Release(err);
+        }
+
+        hr = D3DCompile(ps_hlsl, sizeof(ps_hlsl) - 1, "ps_basic", NULL, NULL,
+                        "main", "ps_5_0", 0, 0, &ps_blob, &err);
+        if (FAILED(hr)) {
+            printf("[D3D12] PS compile failed: %s\n",
+                   err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "unknown");
+            if (err) err->lpVtbl->Release(err);
+        }
+
+        if (vs_blob && ps_blob) {
+            D3D12_INPUT_ELEMENT_DESC input_layout[] = {
+                {"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0,
+                 D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0},
+                {"COLOR", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 12,
+                 D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0},
+                {"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 28,
+                 D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0},
+            };
+
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pso_desc = {0};
+            pso_desc.pRootSignature = s_d3d.root_signature;
+            pso_desc.VS.pShaderBytecode = vs_blob->lpVtbl->GetBufferPointer(vs_blob);
+            pso_desc.VS.BytecodeLength = vs_blob->lpVtbl->GetBufferSize(vs_blob);
+            pso_desc.PS.pShaderBytecode = ps_blob->lpVtbl->GetBufferPointer(ps_blob);
+            pso_desc.PS.BytecodeLength = ps_blob->lpVtbl->GetBufferSize(ps_blob);
+            pso_desc.InputLayout.pInputElementDescs = input_layout;
+            pso_desc.InputLayout.NumElements = 3;
+            pso_desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+            pso_desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+            pso_desc.RasterizerState.DepthClipEnable = TRUE;
+            pso_desc.BlendState.RenderTarget[0].RenderTargetWriteMask =
+                D3D12_COLOR_WRITE_ENABLE_ALL;
+            pso_desc.SampleMask = UINT_MAX;
+            pso_desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+            pso_desc.NumRenderTargets = 1;
+            pso_desc.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+            pso_desc.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+            /* Depth test enabled, write enabled, LESS func.
+             * Games with depth_test_enable=0 in RSX state can still render —
+             * LESS just means new-z must be less than existing — but future
+             * work should mirror RSX depth state into a PSO cache. */
+            pso_desc.DepthStencilState.DepthEnable    = TRUE;
+            pso_desc.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+            pso_desc.DepthStencilState.DepthFunc      = D3D12_COMPARISON_FUNC_LESS_EQUAL;
+            pso_desc.DepthStencilState.StencilEnable  = FALSE;
+            pso_desc.SampleDesc.Count = 1;
+
+            hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                s_d3d.device, &pso_desc,
+                &IID_ID3D12PipelineState, (void**)&s_d3d.pipeline_state);
+            if (SUCCEEDED(hr)) {
+                s_d3d.pipeline_ready = 1;
+                printf("[D3D12] Pipeline state created (triangle class)\n");
+            } else {
+                printf("[D3D12] PSO TRIANGLE creation failed (0x%08lX)\n", hr);
+            }
+
+            /* Line-class PSO — same shader, LINE topology type. */
+            pso_desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE;
+            hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                s_d3d.device, &pso_desc,
+                &IID_ID3D12PipelineState, (void**)&s_d3d.pipeline_state_lines);
+            if (SUCCEEDED(hr)) printf("[D3D12] Pipeline state created (line class)\n");
+            else printf("[D3D12] PSO LINE creation failed (0x%08lX)\n", hr);
+
+            /* Point-class PSO. */
+            pso_desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_POINT;
+            hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                s_d3d.device, &pso_desc,
+                &IID_ID3D12PipelineState, (void**)&s_d3d.pipeline_state_points);
+            if (SUCCEEDED(hr)) printf("[D3D12] Pipeline state created (point class)\n");
+            else printf("[D3D12] PSO POINT creation failed (0x%08lX)\n", hr);
+
+            vs_blob->lpVtbl->Release(vs_blob);
+            ps_blob->lpVtbl->Release(ps_blob);
+        }
+
+        /* -----------------------------------------------------------------
+         * Textured triangle PSO (dbgfont / 2D atlas quads). Same MVP VS but
+         * carrying UV; the PS samples the single-channel atlas as coverage
+         * and modulates the vertex color, with straight alpha blending so
+         * glyph edges composite over the framebuffer. Depth off (2D overlay).
+         * ----------------------------------------------------------------*/
+        {
+            static const char vs_tex[] =
+                "cbuffer cb0 : register(b0){float4 c0;float4 c1;float4 c2;float4 c3;};\n"
+                "struct VSIn { float3 pos:POSITION; float4 col:COLOR; float2 uv:TEXCOORD; };\n"
+                "struct VSOut{ float4 pos:SV_POSITION; float4 col:COLOR; float2 uv:TEXCOORD; };\n"
+                "VSOut main(VSIn i){ VSOut o; float4 p=float4(i.pos,1.0);\n"
+                "  o.pos=c0*p.x+c1*p.y+c2*p.z+c3*p.w; o.col=i.col; o.uv=i.uv; return o; }\n";
+            static const char ps_tex[] =
+                "Texture2D tex : register(t0);\n"
+                "SamplerState smp : register(s0);\n"
+                "struct PSIn{ float4 pos:SV_POSITION; float4 col:COLOR; float2 uv:TEXCOORD; };\n"
+                "float4 main(PSIn i):SV_TARGET{\n"
+                /* dbgfont texcoords are compressed ~10x (U) / ~8x (V) vs. the
+                 * atlas; scale to recover glyph cells. Exact per-glyph offset
+                 * still being calibrated. */
+                "  float2 uv2 = float2(i.uv.x*10.0, i.uv.y*8.0 + 0.59);\n"
+                "  float cov = tex.Sample(smp, uv2).r;\n"
+                "  return float4(i.col.rgb, i.col.a * cov); }\n";
+
+            ID3DBlob *vtb = NULL, *ptb = NULL, *e2 = NULL;
+            hr = D3DCompile(vs_tex, sizeof(vs_tex) - 1, "vs_tex", NULL, NULL, "main", "vs_5_0", 0, 0, &vtb, &e2);
+            if (FAILED(hr)) printf("[D3D12] VS(tex) compile failed: %s\n", e2 ? (const char*)e2->lpVtbl->GetBufferPointer(e2) : "?");
+            hr = D3DCompile(ps_tex, sizeof(ps_tex) - 1, "ps_tex", NULL, NULL, "main", "ps_5_0", 0, 0, &ptb, &e2);
+            if (FAILED(hr)) printf("[D3D12] PS(tex) compile failed: %s\n", e2 ? (const char*)e2->lpVtbl->GetBufferPointer(e2) : "?");
+
+            if (vtb && ptb) {
+                D3D12_INPUT_ELEMENT_DESC il[] = {
+                    {"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0,  D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0},
+                    {"COLOR",    0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 12, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0},
+                    {"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 28, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0},
+                };
+                D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+                pd.pRootSignature = s_d3d.root_signature;
+                pd.VS.pShaderBytecode = vtb->lpVtbl->GetBufferPointer(vtb);
+                pd.VS.BytecodeLength  = vtb->lpVtbl->GetBufferSize(vtb);
+                pd.PS.pShaderBytecode = ptb->lpVtbl->GetBufferPointer(ptb);
+                pd.PS.BytecodeLength  = ptb->lpVtbl->GetBufferSize(ptb);
+                pd.InputLayout.pInputElementDescs = il;
+                pd.InputLayout.NumElements = 3;
+                pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+                pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+                pd.RasterizerState.DepthClipEnable = TRUE;
+                pd.BlendState.RenderTarget[0].BlendEnable    = TRUE;
+                pd.BlendState.RenderTarget[0].SrcBlend       = D3D12_BLEND_SRC_ALPHA;
+                pd.BlendState.RenderTarget[0].DestBlend      = D3D12_BLEND_INV_SRC_ALPHA;
+                pd.BlendState.RenderTarget[0].BlendOp        = D3D12_BLEND_OP_ADD;
+                pd.BlendState.RenderTarget[0].SrcBlendAlpha  = D3D12_BLEND_ONE;
+                pd.BlendState.RenderTarget[0].DestBlendAlpha = D3D12_BLEND_INV_SRC_ALPHA;
+                pd.BlendState.RenderTarget[0].BlendOpAlpha   = D3D12_BLEND_OP_ADD;
+                pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+                pd.SampleMask = UINT_MAX;
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+                pd.NumRenderTargets = 1;
+                pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+                pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+                pd.DepthStencilState.DepthEnable = FALSE;
+                pd.DepthStencilState.StencilEnable = FALSE;
+                pd.SampleDesc.Count = 1;
+                hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                    s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_d3d.pipeline_state_tex);
+                if (SUCCEEDED(hr)) printf("[D3D12] Pipeline state created (textured class)\n");
+                else printf("[D3D12] PSO TEX creation failed (0x%08lX)\n", hr);
+            }
+            if (vtb) vtb->lpVtbl->Release(vtb);
+            if (ptb) ptb->lpVtbl->Release(ptb);
+        }
+
+        /* Host FXAA present pass. Fullscreen triangle from SV_VertexID samples
+         * the selected display surface (t0, linear clamp s0) and writes the
+         * backbuffer. Classic luma-edge FXAA; output alpha 1. Built only when
+         * host AA is enabled; failure leaves the plain copy path. */
+        if (host_aa_enabled()) {
+            static const char aa_hlsl[] =
+                "Texture2D tex : register(t0);\n"
+                "SamplerState smp : register(s0);\n"
+                "struct VO{ float4 pos:SV_POSITION; float2 uv:TEXCOORD; };\n"
+                "VO vs(uint id:SV_VertexID){ VO o; float2 uv=float2((id<<1)&2, id&2);\n"
+                "  o.uv=uv; o.pos=float4(uv*float2(2,-2)+float2(-1,1),0,1); return o; }\n"
+                "float L(float3 c){ return dot(c, float3(0.299,0.587,0.114)); }\n"
+                "float3 S(float2 uv){ return tex.SampleLevel(smp, uv, 0).rgb; }\n"
+                "float4 ps(VO i):SV_TARGET{\n"
+                "  float w,h; tex.GetDimensions(w,h); float2 px=1.0/float2(w,h);\n"
+                "  float3 m=S(i.uv);\n"
+                "  float lNW=L(S(i.uv+float2(-1,-1)*px)), lNE=L(S(i.uv+float2(1,-1)*px));\n"
+                "  float lSW=L(S(i.uv+float2(-1,1)*px)),  lSE=L(S(i.uv+float2(1,1)*px));\n"
+                "  float lM=L(m);\n"
+                "  float lMin=min(lM,min(min(lNW,lNE),min(lSW,lSE)));\n"
+                "  float lMax=max(lM,max(max(lNW,lNE),max(lSW,lSE)));\n"
+                "  if (lMax-lMin < max(0.0312, lMax*0.125)) return float4(m,1);\n"
+                "  float2 d=float2(-((lNW+lNE)-(lSW+lSE)), (lNW+lSW)-(lNE+lSE));\n"
+                "  float red=max((lNW+lNE+lSW+lSE)*(0.25*0.125), 1.0/128.0);\n"
+                "  float rcp=1.0/(min(abs(d.x),abs(d.y))+red);\n"
+                "  d=clamp(d*rcp, -8.0, 8.0)*px;\n"
+                "  float3 a=0.5*(S(i.uv+d*(1.0/3.0-0.5))+S(i.uv+d*(2.0/3.0-0.5)));\n"
+                "  float3 b=a*0.5+0.25*(S(i.uv-d*0.5)+S(i.uv+d*0.5));\n"
+                "  float lB=L(b);\n"
+                "  return float4((lB<lMin||lB>lMax)?a:b, 1); }\n";
+            ID3DBlob *avs = NULL, *aps = NULL, *ae = NULL;
+            hr = D3DCompile(aa_hlsl, sizeof(aa_hlsl) - 1, "host_aa", NULL, NULL, "vs", "vs_5_0", 0, 0, &avs, &ae);
+            if (FAILED(hr)) printf("[D3D12] host AA VS compile failed: %s\n", ae ? (const char*)ae->lpVtbl->GetBufferPointer(ae) : "?");
+            if (ae) { ae->lpVtbl->Release(ae); ae = NULL; }
+            hr = D3DCompile(aa_hlsl, sizeof(aa_hlsl) - 1, "host_aa", NULL, NULL, "ps", "ps_5_0", 0, 0, &aps, &ae);
+            if (FAILED(hr)) printf("[D3D12] host AA PS compile failed: %s\n", ae ? (const char*)ae->lpVtbl->GetBufferPointer(ae) : "?");
+            if (ae) { ae->lpVtbl->Release(ae); ae = NULL; }
+            if (avs && aps) {
+                D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+                pd.pRootSignature = s_d3d.root_signature;
+                pd.VS.pShaderBytecode = avs->lpVtbl->GetBufferPointer(avs);
+                pd.VS.BytecodeLength  = avs->lpVtbl->GetBufferSize(avs);
+                pd.PS.pShaderBytecode = aps->lpVtbl->GetBufferPointer(aps);
+                pd.PS.BytecodeLength  = aps->lpVtbl->GetBufferSize(aps);
+                pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+                pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+                pd.RasterizerState.DepthClipEnable = TRUE;
+                pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+                pd.SampleMask = UINT_MAX;
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+                pd.NumRenderTargets = 1;
+                pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+                pd.DSVFormat = DXGI_FORMAT_UNKNOWN;
+                pd.SampleDesc.Count = 1;
+                hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                    s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_d3d.pipeline_state_aa);
+                if (FAILED(hr)) { printf("[D3D12] host AA PSO creation failed (0x%08lX)\n", hr); s_d3d.pipeline_state_aa = NULL; }
+            }
+            if (avs) avs->lpVtbl->Release(avs);
+            if (aps) aps->lpVtbl->Release(aps);
+            if (s_d3d.pipeline_state_aa) {
+                D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+                hd.Type  = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+                hd.NumDescriptors = s_d3d.swap_buffer_count;
+                hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+                hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                    s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_d3d.aa_srv_heap);
+                if (FAILED(hr)) {
+                    printf("[D3D12] host AA SRV heap creation failed (0x%08lX)\n", hr);
+                    s_d3d.aa_srv_heap = NULL;
+                    s_d3d.pipeline_state_aa->lpVtbl->Release(s_d3d.pipeline_state_aa);
+                    s_d3d.pipeline_state_aa = NULL;
+                }
+            }
+            fprintf(stderr, "[tj-host-aa] FXAA present pass %s\n",
+                    (s_d3d.pipeline_state_aa && s_d3d.aa_srv_heap) ? "ready" : "UNAVAILABLE (plain copy)");
+        }
+
+        /* TJ_RENDER_SCALE exact copies between different host scales (see
+         * rs_blit_draw). Fullscreen triangle clipped to the destination rect;
+         * c0/c1 reach the PS as flat interpolants because the shared root's
+         * constants are VS-only. Load() only, so no sampler is involved. */
+        if (s_d3d.scale > 1) {
+            static const char blit_hlsl[] =
+                "Texture2D<float4> tex : register(t0);\n"
+                "cbuffer R : register(b0) { float4 c0; float4 c1; float4 c2; float4 c3; };\n"
+                "struct VO { float4 pos:SV_POSITION; nointerpolation float4 a:TEXCOORD0;\n"
+                "  nointerpolation float4 b:TEXCOORD1; };\n"
+                "VO vs(uint id:SV_VertexID){ VO o; float2 uv=float2((id<<1)&2, id&2);\n"
+                "  o.pos=float4(uv*float2(2,-2)+float2(-1,1),0,1); o.a=c0; o.b=c1; return o; }\n"
+                "float4 ps(VO i):SV_TARGET{\n"
+                "  uint2 rel=uint2(i.pos.xy)-uint2(i.a.xy);\n"
+                "  uint down=(uint)i.b.x, up=(uint)i.b.y;\n"
+                "  uint2 base=uint2(i.a.zw)+(rel/up)*down;\n"
+                "  uint2 last=uint2(i.b.zw);\n"
+                "  float4 sum=0;\n"
+                "  [loop] for (uint y=0; y<down; ++y)\n"
+                "    [loop] for (uint x=0; x<down; ++x)\n"
+                "      sum+=tex.Load(int3(min(base+uint2(x,y), last), 0));\n"
+                "  return sum/(float)(down*down); }\n";
+            ID3DBlob *bvs = NULL, *bps = NULL, *be = NULL;
+            HRESULT vs_hr, ps_hr, pso_hr = E_FAIL, heap_hr;
+            hr = vs_hr = D3DCompile(blit_hlsl, sizeof(blit_hlsl) - 1, "tj_scale_blit", NULL, NULL, "vs", "vs_5_0", 0, 0, &bvs, &be);
+            if (FAILED(hr)) printf("[D3D12] scale blit VS compile failed: %s\n", be ? (const char*)be->lpVtbl->GetBufferPointer(be) : "?");
+            if (be) { be->lpVtbl->Release(be); be = NULL; }
+            hr = ps_hr = D3DCompile(blit_hlsl, sizeof(blit_hlsl) - 1, "tj_scale_blit", NULL, NULL, "ps", "ps_5_0", 0, 0, &bps, &be);
+            if (FAILED(hr)) printf("[D3D12] scale blit PS compile failed: %s\n", be ? (const char*)be->lpVtbl->GetBufferPointer(be) : "?");
+            if (be) { be->lpVtbl->Release(be); be = NULL; }
+            if (bvs && bps) {
+                D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+                pd.pRootSignature = s_d3d.root_signature;
+                pd.VS.pShaderBytecode = bvs->lpVtbl->GetBufferPointer(bvs);
+                pd.VS.BytecodeLength  = bvs->lpVtbl->GetBufferSize(bvs);
+                pd.PS.pShaderBytecode = bps->lpVtbl->GetBufferPointer(bps);
+                pd.PS.BytecodeLength  = bps->lpVtbl->GetBufferSize(bps);
+                pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+                pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+                pd.RasterizerState.DepthClipEnable = TRUE;
+                pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+                pd.SampleMask = UINT_MAX;
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+                pd.NumRenderTargets = 1;
+                pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+                pd.DSVFormat = DXGI_FORMAT_UNKNOWN;
+                pd.SampleDesc.Count = 1;
+                hr = pso_hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                    s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_d3d.pipeline_state_scale_blit);
+                if (FAILED(hr)) s_d3d.pipeline_state_scale_blit = NULL;
+            }
+            if (bvs) bvs->lpVtbl->Release(bvs);
+            if (bps) bps->lpVtbl->Release(bps);
+            {
+                /* Slot 0: 1x copy scratch; 1..3: MRT null views. */
+                D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+                hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+                hd.NumDescriptors = 4;
+                heap_hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                    s_d3d.device, &hd, &IID_ID3D12DescriptorHeap,
+                    (void**)&s_d3d.scale_blit_rtv_heap);
+                if (FAILED(heap_hr)) s_d3d.scale_blit_rtv_heap = NULL;
+            }
+            if (s_d3d.pipeline_state_scale_blit && s_d3d.scale_blit_rtv_heap) {
+                fprintf(stderr, "[tj-scale] mixed-scale copy pass ready\n");
+            } else {
+                /* Without the pass every frame's display -> 1x OffRT copy
+                 * would halt the batch for good. Demote to 1x here, before
+                 * any display, history or depth surface exists. */
+                fprintf(stderr, "[tj-scale] mixed-scale copy pass UNAVAILABLE "
+                        "(vs=0x%08lX ps=0x%08lX pso=0x%08lX rtv_heap=0x%08lX)\n",
+                        (unsigned long)vs_hr, (unsigned long)ps_hr,
+                        (unsigned long)pso_hr, (unsigned long)heap_hr);
+                if (d3d12_render_scale_demote() != 0) return -1;
+            }
+        }
+
+        /* SRV descriptor heap (shader-visible). Layout: slot 0 = legacy atlas
+         * (dbgfont / textured 2D path), then VP_TEX_SLOTS guest textures,
+         * MAX_OFF_RTS offscreen RTs, then per-draw t0-t15 windows. All bases
+         * are derived above, and all slots start null so every complete table
+         * window is valid on tier-1 hardware. */
+        {
+            D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+            hd.Type  = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+            hd.NumDescriptors = SRV_HEAP_SIZE;
+            hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+            hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_d3d.srv_heap);
+            if (FAILED(hr)) printf("[D3D12] SRV heap creation failed (0x%08lX)\n", hr);
+            else {
+                s_d3d.srv_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+                    s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+                D3D12_SHADER_RESOURCE_VIEW_DESC nv = {0};
+                nv.Format = DXGI_FORMAT_R8_UNORM;
+                nv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+                nv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+                nv.Texture2D.MipLevels = 1;
+                D3D12_CPU_DESCRIPTOR_HANDLE hh;
+                s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &hh);
+                for (int _i = 0; _i < SRV_HEAP_SIZE; _i++) {
+                    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, NULL, &nv, hh);
+                    hh.ptr += s_d3d.srv_inc;
+                }
+            }
+        }
+
+        /* Page 0 exists immediately. Later 20-descriptor sampler-table pages are
+         * allocated only when a frame needs more than one 2048-descriptor
+         * sampler heap, preserving normal under-cap startup behavior. */
+        {
+            D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+            hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+            hd.NumDescriptors = SAMPLER_HEAP_SIZE;
+            hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+            s_d3d.sampler_inc =
+                s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+                    s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER);
+            hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                s_d3d.device, &hd, &IID_ID3D12DescriptorHeap,
+                (void**)&s_d3d.sampler_heaps[0]);
+            if (FAILED(hr))
+                printf("[D3D12] sampler heap creation failed (0x%08lX)\n", hr);
+        }
+
+        /* RTV heap for offscreen render targets (CPU-visible only). */
+        {
+            D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+            hd.Type  = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+            hd.NumDescriptors = MAX_OFF_RTS + MAX_OFF_RT_SCRATCH +
+                                MAX_DISPLAY_HISTORY + MAX_DISPLAY_SURFACES;
+            hr = s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_d3d.rt_rtv_heap);
+            if (FAILED(hr)) printf("[D3D12] offscreen RTV heap creation failed (0x%08lX)\n", hr);
+        }
+    }
+
+    /* ---------------------------------------------------------------
+     * Create dynamic vertex buffer (upload heap, 4MB)
+     * ---------------------------------------------------------------*/
+    {
+        D3D12_HEAP_PROPERTIES heap_props = {0};
+        heap_props.Type = D3D12_HEAP_TYPE_UPLOAD;
+
+        D3D12_RESOURCE_DESC buf_desc = {0};
+        buf_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        buf_desc.Width = MAX_VERTICES * VERTEX_STRIDE;
+        buf_desc.Height = 1;
+        buf_desc.DepthOrArraySize = 1;
+        buf_desc.MipLevels = 1;
+        buf_desc.SampleDesc.Count = 1;
+        buf_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+
+        hr = s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &heap_props, D3D12_HEAP_FLAG_NONE,
+            &buf_desc, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+            &IID_ID3D12Resource, (void**)&s_d3d.vertex_buffer);
+        if (SUCCEEDED(hr)) {
+            D3D12_RANGE read_range = {0, 0};
+            s_d3d.vertex_buffer->lpVtbl->Map(
+                s_d3d.vertex_buffer, 0, &read_range, &s_d3d.vb_mapped);
+            s_d3d.vb_view.BufferLocation =
+                s_d3d.vertex_buffer->lpVtbl->GetGPUVirtualAddress(s_d3d.vertex_buffer);
+            s_d3d.vb_view.StrideInBytes = VERTEX_STRIDE;
+            s_d3d.vb_view.SizeInBytes = MAX_VERTICES * VERTEX_STRIDE;
+            printf("[D3D12] Vertex buffer created (%u KB)\n",
+                   (MAX_VERTICES * VERTEX_STRIDE) / 1024);
+        }
+    }
+
+    /* ---------------------------------------------------------------
+     * Real vertex-program path resources: root signature (CBV b0 for the
+     * vp_c[] bank + dynamic SRV/sampler tables), a raw-float4 vertex buffer,
+     * and the constant-bank buffer. The PSO itself is built lazily once the
+     * game uploads its VP microcode (render_frame).
+     * ---------------------------------------------------------------*/
+    {
+        /* Complete shared SRV table: fragment t0-t15 and vertex t16-t19.
+         * Samplers use separate visibility-limited tables: pixel s0-s15 and
+         * vertex s0-s3, both sourced from one 20-descriptor draw table. */
+        D3D12_DESCRIPTOR_RANGE srv_range = {0};
+        srv_range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        srv_range.NumDescriptors = DRAW_TEXTURE_COUNT;
+        srv_range.BaseShaderRegister = 0;
+        srv_range.OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+
+        D3D12_DESCRIPTOR_RANGE pixel_sampler_range = {0};
+        pixel_sampler_range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER;
+        pixel_sampler_range.NumDescriptors = RSX_MAX_TEXTURES;
+        pixel_sampler_range.BaseShaderRegister = 0;
+        pixel_sampler_range.OffsetInDescriptorsFromTableStart =
+            D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+
+        D3D12_DESCRIPTOR_RANGE vertex_sampler_range = {0};
+        vertex_sampler_range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER;
+        vertex_sampler_range.NumDescriptors = RSX_MAX_VERTEX_TEXTURES;
+        vertex_sampler_range.BaseShaderRegister = 0;
+        vertex_sampler_range.OffsetInDescriptorsFromTableStart =
+            D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+
+        D3D12_ROOT_PARAMETER rp[5] = {0};
+        rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;   /* b0 = vp_c bank */
+        rp[0].Descriptor.ShaderRegister = 0;
+        rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+        rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        rp[1].DescriptorTable.NumDescriptorRanges = 1;
+        rp[1].DescriptorTable.pDescriptorRanges = &srv_range;
+        rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;   /* b1 = FP texscale */
+        rp[2].Descriptor.ShaderRegister = 1;
+        rp[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        rp[3].DescriptorTable.NumDescriptorRanges = 1;
+        rp[3].DescriptorTable.pDescriptorRanges = &pixel_sampler_range;
+        rp[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        rp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        rp[4].DescriptorTable.NumDescriptorRanges = 1;
+        rp[4].DescriptorTable.pDescriptorRanges = &vertex_sampler_range;
+        rp[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+
+        D3D12_ROOT_SIGNATURE_DESC rd = {0};
+        rd.NumParameters = 5; rd.pParameters = rp;
+        rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+
+        ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+        hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+        if (SUCCEEDED(hr)) {
+            s_d3d.device->lpVtbl->CreateRootSignature(s_d3d.device, 0,
+                sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+                &IID_ID3D12RootSignature, (void**)&s_d3d.vp_root_sig);
+            sig->lpVtbl->Release(sig);
+        } else if (err) { printf("[D3D12] VP root sig: %s\n", (const char*)err->lpVtbl->GetBufferPointer(err)); err->lpVtbl->Release(err); }
+
+        /* raw float4 vertex buffer + constant bank (both UPLOAD, persistently mapped) */
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Height = 1;
+        bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        D3D12_RANGE nr = {0,0};
+
+        bd.Width = (u64)MAX_VERTICES * 256 * 2;  /* generic VP vertex: 16 float4 slots,
+                                          * DOUBLE-buffered by frame parity so a
+                                          * new frame's upload never overwrites
+                                          * vertices the in-flight GPU frame is
+                                          * still reading (was: torn/missing
+                                          * triangles mixing stale+new verts) */
+        if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+                D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                &IID_ID3D12Resource, (void**)&s_d3d.vp_vb)))
+            s_d3d.vp_vb->lpVtbl->Map(s_d3d.vp_vb, 0, &nr, &s_d3d.vp_vb_mapped);
+
+        bd.Width = (u64)VP_CB_STRIDE * MAX_DRAWS * 2;   /* per-draw constant slots, x2 parity */
+        if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+                D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                &IID_ID3D12Resource, (void**)&s_d3d.vp_cb)))
+            s_d3d.vp_cb->lpVtbl->Map(s_d3d.vp_cb, 0, &nr, &s_d3d.vp_cb_mapped);
+
+        bd.Width = (u64)FP_CB_STRIDE * MAX_DRAWS * 2; /* per-draw FP b1 slots, x2 parity */
+        if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+                D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                &IID_ID3D12Resource, (void**)&s_d3d.vp_fpcb)))
+            s_d3d.vp_fpcb->lpVtbl->Map(s_d3d.vp_fpcb, 0, &nr, &s_d3d.vp_fpcb_mapped);
+
+        printf("[D3D12] VP path resources: rootsig=%p vb=%p cb=%p\n",
+               (void*)s_d3d.vp_root_sig, (void*)s_d3d.vp_vb, (void*)s_d3d.vp_cb);
+    }
+
+    printf("[D3D12] Initialization complete (%ux%u, %u buffers, pipeline=%s)\n",
+           width, height, s_d3d.swap_buffer_count,
+           s_d3d.pipeline_ready ? "ready" : "NOT ready");
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Frame sync helpers
+ * -----------------------------------------------------------------------*/
+
+static void gcm2d_backend_halt(const char* reason);
+static int wait_for_gpu_checked(void);
+static int wait_for_gpu_checked_at(RsxD3D12CompletionReason reason);
+static int fence_wait_failure(const char* operation, u64 want, u64 completed,
+                              HRESULT hr, DWORD wait_result);
+static int wait_for_fence_value_checked(u64 want, DWORD timeout_ms);
+
+/* Recording failures must stop before submission or guest completion. The
+ * caller owns cleanup: an unsubmitted list is distinct from an unknown fence. */
+static int d3d12_command_result_checked(HRESULT hr, const char* operation)
+{
+    if (SUCCEEDED(hr)) return 0;
+    fprintf(stderr, "[D3D12-COMMAND] failure op=%s hr=0x%08lX frame=%u\n",
+            operation, (long)hr, s_d3d.frame_index);
+    gcm2d_backend_halt(operation);
+    return -1;
+}
+
+/* TJ_EDGE_NOWAIT=1 (opt-in; unset keeps the original edge wait). A zero-draw
+ * FIFO completion edge right after a final frame waits for that whole frame
+ * and its Present. When the only queue work since the last checked completion
+ * is that frame (its list, Present and the Signal queued after the Present)
+ * and nothing guest-visible depends on it, the edge skips the wait and leaves
+ * fifo_prefix_outstanding set. The next render_frame opening wait and the
+ * back-buffer wait still retire it before upload banks, allocators or caches
+ * are reused. Armed only at the final submit; any other submission clears it. */
+static struct {
+    int final_only;            /* outstanding queue work = the last final frame */
+    int basic_vb;              /* that frame read the unbanked basic vertex buffer */
+    u64 present_ticket;        /* Signal queued right after its Present, 0 = none */
+    u64 skipped, idle, waited, waited_final;   /* one [TJ-PERF] window */
+    const char* why;           /* last reason a final-only edge still waited */
+} s_edge_nowait;
+
+static int d3d12_edge_nowait_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_EDGE_NOWAIT");
+        enabled = value && strcmp(value, "1") == 0;
+        if (value && value[0])
+            fprintf(stderr, "[TJ-EDGE-NOWAIT] configured enabled=%d\n", enabled);
+    }
+    return enabled;
+}
+
+/* [TJ-PERF] suffix for the window just ended ("" when off), then a new
+ * window. skip: wait skipped, frame in flight; idle: frame already complete;
+ * wait: other outstanding work; wait_final: final-only edge, still blocked. */
+static void d3d12_edge_nowait_window(char* out, size_t size)
+{
+    out[0] = '\0';
+    if (!d3d12_edge_nowait_enabled()) return;
+    snprintf(out, size, " edge_skip=%llu edge_idle=%llu edge_wait=%llu "
+             "edge_wait_final=%llu edge_why=%s",
+             (unsigned long long)s_edge_nowait.skipped,
+             (unsigned long long)s_edge_nowait.idle,
+             (unsigned long long)s_edge_nowait.waited,
+             (unsigned long long)s_edge_nowait.waited_final,
+             s_edge_nowait.why ? s_edge_nowait.why : "none");
+    s_edge_nowait.skipped = s_edge_nowait.idle = 0;
+    s_edge_nowait.waited = s_edge_nowait.waited_final = 0;
+    s_edge_nowait.why = NULL;
+}
+
+static int move_to_next_frame(void)
+{
+    s_d3d.gpu_completion_ticket = 0;
+    if (s_d3d.frame_index >= FRAME_COUNT ||
+        s_d3d.fence_values[s_d3d.frame_index] >= UINT64_MAX - 2)
+        return fence_wait_failure("frame-ticket-overflow", 0, 0, E_FAIL, WAIT_FAILED);
+    /* Prefix submissions already signal this counter. The frame list needs
+     * its own later ticket so allocator reuse cannot accept an earlier prefix
+     * signal while the final frame commands are still in flight. */
+    u64 current_fence = ++s_d3d.fence_values[s_d3d.frame_index];
+    LONGLONG sync_mark = tj_present_work_trace_sync_begin();
+    HRESULT hr = s_d3d.cmd_queue->lpVtbl->Signal(s_d3d.cmd_queue, s_d3d.fence,
+                                               current_fence);
+    tj_present_work_trace_sync_finish(sync_mark, &s_tj_present_work_trace.queue_signal_ticks,
+                                      &s_tj_present_work_trace.queue_signal_calls);
+    if (FAILED(hr))
+        return fence_wait_failure("frame-signal", current_fence,
+            s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence), hr, WAIT_FAILED);
+
+    s_d3d.gpu_completion_ticket = current_fence;
+
+    s_d3d.frame_index = s_d3d.swap_chain->lpVtbl->GetCurrentBackBufferIndex(s_d3d.swap_chain);
+
+    LONGLONG wait_mark = tj_present_work_trace_sync_begin();
+    int wait_result = wait_for_fence_value_checked(s_d3d.fence_values[s_d3d.frame_index], 2000);
+    tj_present_work_trace_sync_finish(wait_mark, &s_tj_present_work_trace.backbuffer_wait_ticks,
+                                      &s_tj_present_work_trace.backbuffer_wait_calls);
+    if (wait_result != 0) return -1;
+
+    s_d3d.fence_values[s_d3d.frame_index] = current_fence + 1;
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Present phase (TJ_PRESENT_PHASE, opt-in; the TJ presenter decides when).
+ * On a 120 Hz output a Present(1,0) issued anywhere between two
+ * display-locked ticks lands on 1 or 3 refreshes.
+ *
+ * TJ_PRESENT_PHASE=1 (interval): the presenter arms a one-shot SyncInterval
+ * (= the display divisor, 2 at 120 Hz) for a final frame's Present. DXGI then
+ * shows each frame for at least `divisor` refreshes; with one frame per tick
+ * the queue settles on exactly `divisor`. Nothing is held: composition, the
+ * back-buffer advance and every FIFO/guest-visible step stay where they were.
+ *
+ * TJ_PRESENT_PHASE=hold (A/B only): while `armed`, a final render_frame is
+ * replayed, composited (history, FXAA, overlay) and submitted exactly as
+ * before; only its Present(1,0) and back-buffer advance wait until the
+ * presenter releases them right after the next tick. Anything that needs the
+ * swap chain first (the next replay transitions and clears the current back
+ * buffer) presents a held frame itself (`forced`), so the next frame's prefix
+ * replays can defeat the phase.
+ *
+ * Both modes use three swap buffers so the next back buffer is free although
+ * the previous frame stays on screen longer. Presenter (window-owner) thread
+ * only.
+ * -----------------------------------------------------------------------*/
+static struct {
+    int armed;          /* one-shot: hold the next final Present (hold mode) */
+    int held;           /* a composed back buffer awaits its Present */
+    u32 interval;       /* one-shot SyncInterval >= 2 for the next final Present */
+    u64 presents;       /* successful swap-chain Presents */
+    u64 paced;          /* successful Presents with SyncInterval >= 2 */
+    u64 forced;         /* held frames presented before the presenter's release */
+    LONGLONG tick_qpc;  /* presenter's newest display-locked tick (QPC), 0 = none */
+    /* forced-release trace window (taken by the presenter's trace line) */
+    u64 forced_window, forced_after_count;
+    u64 forced_after_sum, forced_after_min, forced_after_max;
+} s_present_phase;
+
+/* TJ_PRESENT_PHASE=1 or hold: three swap buffers (TJ_PRESENT_PHASE_BUFFERS=2
+ * keeps two, diagnostic only). Unset: FRAME_COUNT_DEFAULT, as before. */
+static u32 d3d12_present_phase_buffer_count(void)
+{
+    const char* phase = getenv("TJ_PRESENT_PHASE");
+    if (!phase || (strcmp(phase, "1") != 0 && strcmp(phase, "hold") != 0))
+        return FRAME_COUNT_DEFAULT;
+    const char* buffers = getenv("TJ_PRESENT_PHASE_BUFFERS");
+    return buffers && strcmp(buffers, "2") == 0 ? 2u : 3u;
+}
+
+/* The swap-chain half of a final frame: Present(sync_interval,0), the
+ * optional cadence sample and the next back buffer. -1: failed, already
+ * reported and halted; submitted resources stay owned until checked
+ * completion. */
+static int d3d12_present_swap_chain(UINT sync_interval)
+{
+    /* Present may enqueue queue work even when it fails. */
+    s_d3d.gpu_completion_ticket = 0;
+    LONGLONG present_mark = tj_present_work_trace_sync_begin();
+    HRESULT present_hr = s_d3d.swap_chain->lpVtbl->Present(s_d3d.swap_chain,
+                                                           sync_interval, 0);
+    tj_present_work_trace_sync_finish(present_mark, &s_tj_present_work_trace.present_ticks,
+                                      &s_tj_present_work_trace.present_calls);
+    if (d3d12_command_result_checked(present_hr, "swap-chain present") != 0)
+        return -1;
+    ++s_present_phase.presents;
+    if (sync_interval >= 2) ++s_present_phase.paced;
+    d3d12_display_cadence_sample();   /* TJ_VBLANK_SOURCE_TRACE=1 only */
+
+    if (move_to_next_frame() != 0) {
+        gcm2d_backend_halt("next-frame fence");
+        return -1;
+    }
+    /* TJ_EDGE_NOWAIT: the Signal just queued behind this final frame's Present. */
+    if (s_edge_nowait.final_only)
+        s_edge_nowait.present_ticket = s_d3d.gpu_completion_ticket;
+    return 0;
+}
+
+/* Present a held frame now (forced: a replay needs its back buffer).
+ * 1: presented; 0: nothing held, or nothing may be shown; -1: the Present
+ * path failed and halted the backend. */
+static int d3d12_present_phase_release(int forced)
+{
+    if (!s_present_phase.held) return 0;
+    s_present_phase.held = 0;
+    if (!s_d3d.initialized || !s_d3d.swap_chain || s_d3d.gcm2d_backend_halted)
+        return 0;
+    /* A held frame ends a full replay (prefix owners drained) and the first
+     * prefix replay after it presents it before reserving an owner, so no
+     * owner can span this back-buffer advance. Should one exist, drop this
+     * Present: the next final frame redraws the same current back buffer. */
+    if (s_d3d.prefix_owner_active || s_d3d.prefix_prepare_owner ||
+        s_d3d.prefix_deferred_owner) {
+        static int logged;
+        if (!logged) {
+            logged = 1;
+            fprintf(stderr, "[TJ-PRESENT-PHASE] event=dropped reason=prefix_owner\n");
+        }
+        return 0;
+    }
+    if (d3d12_present_swap_chain(1) != 0) return -1;
+    if (forced) {
+        ++s_present_phase.forced;
+        ++s_present_phase.forced_window;
+        /* Where a forced Present landed after the newest tick, for the
+         * presenter's [TJ-VBLANK-SOURCE] trace (its own presents exclude it). */
+        LARGE_INTEGER now = {0};
+        if (s_present_phase.tick_qpc && QueryPerformanceCounter(&now) &&
+            now.QuadPart >= s_present_phase.tick_qpc) {
+            const u64 after = (u64)(now.QuadPart - s_present_phase.tick_qpc);
+            if (!s_present_phase.forced_after_count ||
+                after < s_present_phase.forced_after_min)
+                s_present_phase.forced_after_min = after;
+            if (after > s_present_phase.forced_after_max)
+                s_present_phase.forced_after_max = after;
+            s_present_phase.forced_after_sum += after;
+            ++s_present_phase.forced_after_count;
+        }
+    }
+    return 1;
+}
+
+void rsx_d3d12_backend_present_hold_arm(int arm)
+{
+    s_present_phase.armed = arm ? 1 : 0;
+}
+
+void rsx_d3d12_backend_present_interval_arm(u32 interval)
+{
+    s_present_phase.interval = interval >= 2 ? (interval > 4 ? 4u : interval) : 0u;
+}
+
+void rsx_d3d12_backend_present_phase_tick(u64 tick_qpc)
+{
+    s_present_phase.tick_qpc = (LONGLONG)tick_qpc;
+}
+
+int rsx_d3d12_backend_present_held(void)
+{
+    return s_present_phase.held;
+}
+
+int rsx_d3d12_backend_present_release(void)
+{
+    return d3d12_present_phase_release(0) > 0;
+}
+
+u64 rsx_d3d12_backend_present_count(void)
+{
+    return s_present_phase.presents;
+}
+
+u64 rsx_d3d12_backend_present_paced_count(void)
+{
+    return s_present_phase.paced;
+}
+
+u64 rsx_d3d12_backend_present_forced_count(void)
+{
+    return s_present_phase.forced;
+}
+
+/* Forced releases since the previous take, plus the QPC offsets after the
+ * newest tick of those that had a tick stamp (*stamped of them). Resets the
+ * window. */
+u64 rsx_d3d12_backend_present_forced_take(u64* stamped, u64* sum, u64* min, u64* max)
+{
+    const u64 forced = s_present_phase.forced_window;
+    if (stamped) *stamped = s_present_phase.forced_after_count;
+    if (sum) *sum = s_present_phase.forced_after_sum;
+    if (min) *min = s_present_phase.forced_after_min;
+    if (max) *max = s_present_phase.forced_after_max;
+    s_present_phase.forced_window = 0;
+    s_present_phase.forced_after_count = 0;
+    s_present_phase.forced_after_sum = 0;
+    s_present_phase.forced_after_min = 0;
+    s_present_phase.forced_after_max = 0;
+    return forced;
+}
+
+u32 rsx_d3d12_backend_swap_buffer_count(void)
+{
+    return s_d3d.swap_buffer_count ? s_d3d.swap_buffer_count : FRAME_COUNT_DEFAULT;
+}
+
+/* ---------------------------------------------------------------------------
+ * Render a frame (clear + present)
+ * -----------------------------------------------------------------------*/
+
+/* Write the mapped readback buffer (R8G8B8A8, row pitch = readback_pitch) out
+ * as a 24-bit bottom-up BMP. Debug-only. */
+static void dump_backbuffer_bmp(void)
+{
+    if (!s_d3d.readback_buf) return;
+    void* mapped = NULL;
+    D3D12_RANGE rr = {0, (SIZE_T)s_d3d.readback_pitch * s_d3d.height};
+    if (FAILED(s_d3d.readback_buf->lpVtbl->Map(s_d3d.readback_buf, 0, &rr, &mapped)) || !mapped) {
+        if (s_d3d.dump_audit_only)
+            fprintf(stderr, "[TJ-FRAME-AUDIT] frame=%llu map-failed\n",
+                    (unsigned long long)s_d3d.frame_count);
+        return;
+    }
+
+    if (s_d3d.dump_audit_only) {
+        /* Diagnostic only: sample the actual completed backbuffer. Include
+         * a central rectangle so movie letterboxing cannot hide white flashes.
+         * Save only the first frame of up to eight white episodes. */
+        u32 n = 0, white = 0, center_n = 0, center_white = 0;
+        u64 sum = 0;
+        for (u32 y = 0; y < s_d3d.height; y += 20) {
+            const u8* row = (const u8*)mapped + (u64)y * s_d3d.readback_pitch;
+            for (u32 x = 0; x < s_d3d.width; x += 20) {
+                const u8* p = row + x * 4;
+                int is_white = p[0] >= 240 && p[1] >= 240 && p[2] >= 240;
+                ++n; white += is_white; sum += p[0] + p[1] + p[2];
+                if (x >= s_d3d.width / 5 && x < s_d3d.width * 4 / 5 &&
+                    y >= s_d3d.height / 5 && y < s_d3d.height * 4 / 5) {
+                    ++center_n; center_white += is_white;
+                }
+            }
+        }
+        u32 center_pm = center_n ? center_white * 1000u / center_n : 0;
+        fprintf(stderr, "[TJ-FRAME-AUDIT] frame=%llu draws=%u mean=%.2f white_pm=%u center_white_pm=%u\n",
+                (unsigned long long)s_d3d.frame_count, s_dbg_last_draws,
+                n ? (double)sum / (3.0 * n) : 0.0, n ? white * 1000u / n : 0,
+                center_pm);
+        static int previous_white = 0, saved_episodes = 0;
+        int now_white = center_pm >= 980;
+        int save = now_white && !previous_white && saved_episodes < 8;
+        previous_white = now_white;
+        if (save) ++saved_episodes;
+        else {
+            D3D12_RANGE wr = {0, 0};
+            s_d3d.readback_buf->lpVtbl->Unmap(s_d3d.readback_buf, 0, &wr);
+            return;
+        }
+    }
+
+    static int idx = 0;
+    char path[512];
+    const char* dir = getenv("CELLMARK_DUMP_DIR");   /* default: current dir */
+    snprintf(path, sizeof(path), "%s%sframe_%03d.bmp",
+             dir ? dir : "", dir ? "/" : "", idx++);
+    if (s_d3d.dump_audit_only)
+        snprintf(path, sizeof(path), "%s%sframe_%06llu.bmp",
+                 dir ? dir : "", dir ? "/" : "",
+                 (unsigned long long)s_d3d.frame_count);
+    FILE* f = fopen(path, "wb");
+    if (f) {
+        u32 w = s_d3d.width, h = s_d3d.height;
+        u32 padded = (w * 3 + 3) & ~3u;
+        u32 imgsz  = padded * h;
+        u32 filesz = 54 + imgsz;
+        unsigned char hdr[54] = {0};
+        hdr[0] = 'B'; hdr[1] = 'M';
+        hdr[2]=filesz&0xFF; hdr[3]=(filesz>>8)&0xFF; hdr[4]=(filesz>>16)&0xFF; hdr[5]=(filesz>>24)&0xFF;
+        hdr[10]=54; hdr[14]=40;
+        hdr[18]=w&0xFF; hdr[19]=(w>>8)&0xFF; hdr[20]=(w>>16)&0xFF; hdr[21]=(w>>24)&0xFF;
+        hdr[22]=h&0xFF; hdr[23]=(h>>8)&0xFF; hdr[24]=(h>>16)&0xFF; hdr[25]=(h>>24)&0xFF;
+        hdr[26]=1; hdr[28]=24;
+        hdr[34]=imgsz&0xFF; hdr[35]=(imgsz>>8)&0xFF; hdr[36]=(imgsz>>16)&0xFF; hdr[37]=(imgsz>>24)&0xFF;
+        fwrite(hdr, 1, 54, f);
+        unsigned char* row = (unsigned char*)malloc(padded);
+        if (row) {
+            memset(row, 0, padded);
+            for (int y = (int)h - 1; y >= 0; y--) {   /* BMP is bottom-up */
+                unsigned char* src = (unsigned char*)mapped + (u32)y * s_d3d.readback_pitch;
+                for (u32 x = 0; x < w; x++) {
+                    row[x*3+0] = src[x*4+2]; /* B */
+                    row[x*3+1] = src[x*4+1]; /* G */
+                    row[x*3+2] = src[x*4+0]; /* R */
+                }
+                fwrite(row, 1, padded, f);
+            }
+            free(row);
+        }
+        fclose(f);
+        printf("[D3D12] dumped %s (%ux%u)\n", path, s_d3d.width, s_d3d.height);
+    }
+    D3D12_RANGE wr = {0, 0};
+    s_d3d.readback_buf->lpVtbl->Unmap(s_d3d.readback_buf, 0, &wr);
+}
+
+/* ---------------------------------------------------------------------------
+ * RSX frame capture ("rsxcap") -- a purpose-built GPU debugger. RSX_CAP=start
+ * [:count[:stride]] snapshots whole frames to <RSX_CAP_DIR>/frame_NN/: a text
+ * manifest of every op (in submission order, with full surface/shader/texture
+ * state) plus a BMP of the backbuffer and every offscreen colour RT used that
+ * frame. One frame, captured atomically -- no cross-frame guessing.
+ * -----------------------------------------------------------------------*/
+
+/* Shared 24-bit BMP writer for readbacks. R8G8B8A8_UNORM straight; the half/
+ * float RT formats are |v|-tonemapped so signed/HDR data is visible. */
+static void cap_write_bmp(const char* path, const void* mapped, u32 w, u32 h,
+                          u32 pitch, u32 dxgi)
+{
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    u32 rowb = (w * 3 + 3) & ~3u, datasz = rowb * h;
+    u8 hdr[54] = {0};
+    hdr[0] = 'B'; hdr[1] = 'M';
+    *(u32*)(hdr+2) = 54 + datasz; *(u32*)(hdr+10) = 54; *(u32*)(hdr+14) = 40;
+    *(int*)(hdr+18) = (int)w; *(int*)(hdr+22) = (int)h;
+    *(u16*)(hdr+26) = 1; *(u16*)(hdr+28) = 24; *(u32*)(hdr+34) = datasz;
+    fwrite(hdr, 1, 54, f);
+    u8* line = (u8*)malloc(rowb);
+    if (line) for (int y = (int)h - 1; y >= 0; y--) {   /* BMP is bottom-up */
+        const u8* srow = (const u8*)mapped + (u64)y * pitch;
+        memset(line, 0, rowb);
+        for (u32 x = 0; x < w; x++) {
+            float rv, gv, bv;
+            if (dxgi == DXGI_FORMAT_R16G16B16A16_FLOAT) {
+                const u16* hp = (const u16*)(srow + (u64)x * 8);
+                float v[3];
+                for (int c = 0; c < 3; c++) {
+                    u16 hv = hp[c]; u32 s = (hv>>15)&1, e = (hv>>10)&0x1F, m = hv&0x3FF; float fv;
+                    if (e == 0) fv = (float)m / 16777216.0f;
+                    else { u32 fb = (s<<31)|((e-15+127)<<23)|(m<<13); memcpy(&fv,&fb,4); }
+                    v[c] = fv;
+                }
+                rv = v[0]; gv = v[1]; bv = v[2];
+            } else if (dxgi == DXGI_FORMAT_R32G32B32A32_FLOAT) {
+                const float* fp = (const float*)(srow + (u64)x * 16);
+                rv = fp[0]; gv = fp[1]; bv = fp[2];
+            } else {
+                const u8* p = srow + (u64)x * 4;
+                rv = p[0]/255.0f; gv = p[1]/255.0f; bv = p[2]/255.0f;
+            }
+            float ar = rv<0?-rv:rv, ag = gv<0?-gv:gv, ab = bv<0?-bv:bv;
+            if (ar>1) ar=1; if (ag>1) ag=1; if (ab>1) ab=1;
+            line[x*3+0] = (u8)(ab*255.0f);
+            line[x*3+1] = (u8)(ag*255.0f);
+            line[x*3+2] = (u8)(ar*255.0f);
+        }
+        fwrite(line, 1, rowb, f);
+    }
+    free(line);
+    fclose(f);
+}
+
+/* Copy one GPU resource into a fresh readback buffer and write it as a BMP.
+ * Self-contained: waits, resets the frame command list, copies, executes,
+ * waits, maps. `prior` is the resource's current tracked state (restored after
+ * the copy so the caller's state tracking stays valid). */
+static void cap_readback_write(ID3D12Resource* res, u32 w, u32 h, u32 dxgi,
+                               D3D12_RESOURCE_STATES prior, u32 fi, const char* path)
+{
+    if (s_d3d.gcm2d_backend_halted || !res || !w || !h) return;
+    u32 bpp = (dxgi == DXGI_FORMAT_R16G16B16A16_FLOAT) ? 8 :
+              (dxgi == DXGI_FORMAT_R32G32B32A32_FLOAT) ? 16 : 4;
+    u32 pitch = (w * bpp + 255) & ~255u;
+
+    ID3D12Resource* rb = NULL;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width = (u64)pitch * h; rd.Height = 1; rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1; rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&rb)) || !rb)
+        return;
+
+    if (wait_for_gpu_checked_at(RSX_COMPLETION_CAPTURE) != 0) {
+        rb->lpVtbl->Release(rb);
+        gcm2d_backend_halt("capture allocator fence");
+        return;
+    }
+    if (d3d12_command_result_checked(
+            s_d3d.cmd_allocators[fi]->lpVtbl->Reset(s_d3d.cmd_allocators[fi]),
+            "capture allocator reset") != 0 ||
+        d3d12_command_result_checked(
+            s_d3d.cmd_list->lpVtbl->Reset(s_d3d.cmd_list, s_d3d.cmd_allocators[fi], NULL),
+            "capture command-list reset") != 0) {
+        rb->lpVtbl->Release(rb); /* never submitted; the opening fence completed */
+        return;
+    }
+
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = res;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    if (prior != D3D12_RESOURCE_STATE_COPY_SOURCE) {
+        b.Transition.StateBefore = prior;
+        b.Transition.StateAfter  = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        d3d12_owned_barriers(1, &b);
+    }
+
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = (DXGI_FORMAT)dxgi;
+    dst.PlacedFootprint.Footprint.Width = w; dst.PlacedFootprint.Footprint.Height = h;
+    dst.PlacedFootprint.Footprint.Depth = 1; dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    src.pResource = res; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.SubresourceIndex = 0;
+    d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, NULL);
+
+    if (prior != D3D12_RESOURCE_STATE_COPY_SOURCE) {
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b.Transition.StateAfter  = prior;
+        d3d12_owned_barriers(1, &b);
+    }
+
+    if (d3d12_command_result_checked(s_d3d.cmd_list->lpVtbl->Close(s_d3d.cmd_list),
+                                    "capture command-list close") != 0) {
+        rb->lpVtbl->Release(rb); /* never submitted */
+        return;
+    }
+    ID3D12CommandList* cl[] = { (ID3D12CommandList*)s_d3d.cmd_list };
+    s_d3d.gpu_completion_ticket = 0;
+    s_edge_nowait.final_only = 0; /* TJ_EDGE_NOWAIT: not final-frame-only work */
+    s_d3d.cmd_queue->lpVtbl->ExecuteCommandLists(s_d3d.cmd_queue, 1, cl);
+    if (wait_for_gpu_checked_at(RSX_COMPLETION_CAPTURE) != 0) {
+        gcm2d_backend_halt("capture readback fence");
+        return; /* rb remains GPU-owned until process exit */
+    }
+
+    void* mp = NULL; D3D12_RANGE rr = {0, (SIZE_T)pitch * h};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, &mp)) && mp) {
+        cap_write_bmp(path, mp, w, h, pitch, dxgi);
+        D3D12_RANGE wr = {0, 0};
+        rb->lpVtbl->Unmap(rb, 0, &wr);
+    }
+    rb->lpVtbl->Release(rb);
+}
+
+static int fence_wait_failure(const char* operation, u64 want, u64 completed,
+                              HRESULT hr, DWORD wait_result)
+{
+    HRESULT removed = s_d3d.device
+        ? s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device) : E_FAIL;
+    fprintf(stderr,
+            "[D3D12-FENCE] failure op=%s want=%llu completed=%llu frame=%u "
+            "hr=0x%08lX wait=0x%08lX removed=0x%08lX edge=%s\n",
+            operation, (unsigned long long)want, (unsigned long long)completed,
+            s_d3d.frame_index, (long)hr, (unsigned long)wait_result, (long)removed,
+            tj_gcm2d_backend_perf_enabled()
+                ? s_tj_completion_names[(unsigned)s_tj_completion_reason < RSX_COMPLETION_REASON_COUNT
+                    ? (unsigned)s_tj_completion_reason : RSX_COMPLETION_OTHER] : "off");
+    return -1;
+}
+
+/* The shared event can still carry a wake from an earlier registration.
+ * Only the fence value proves completion. Recheck after every wake, retain
+ * one total deadline, and never interpret the device-removal sentinel as a
+ * completed copy or permission to reuse a command allocator. */
+static _Thread_local u32 (*s_d3d12_fence_wait_service)(void* context, u32 remaining_ms);
+static _Thread_local void* s_d3d12_fence_wait_service_context;
+static _Thread_local int s_d3d12_fence_wait_service_busy;
+static _Thread_local int s_d3d12_fence_wait_fifo_pulse;
+
+void rsx_d3d12_backend_set_fence_wait_service(
+    u32 (*service)(void* context, u32 remaining_ms), void* context)
+{
+    s_d3d12_fence_wait_service = service;
+    s_d3d12_fence_wait_service_context = service ? context : NULL;
+    s_d3d12_fence_wait_fifo_pulse = 0;
+}
+
+void rsx_d3d12_backend_set_fence_wait_fifo_pulse(int enabled)
+{
+    s_d3d12_fence_wait_fifo_pulse = enabled && s_d3d12_fence_wait_service;
+}
+
+/* rsx_d3d12_backend_fifo_faulted without its FIFO-walk-start side effect
+ * (TJ_WATCH_BATCH pass boundary); the per-packet pulse below is not a walk. */
+static int d3d12_fifo_faulted(void)
+{
+    return s_d3d.gcm2d_backend_halted != 0;
+}
+
+void rsx_d3d12_backend_pulse_fence_wait_service(void)
+{
+    if (!s_d3d12_fence_wait_fifo_pulse || !s_d3d12_fence_wait_service ||
+        s_d3d12_fence_wait_service_busy || d3d12_fifo_faulted())
+        return;
+    s_d3d12_fence_wait_service_busy = 1;
+    /* Check an existing presenter deadline only; do not wait or decide that
+     * a fence is ready. The same guard prevents callback/FIFO reentry. */
+    (void)s_d3d12_fence_wait_service(s_d3d12_fence_wait_service_context, 1);
+    s_d3d12_fence_wait_service_busy = 0;
+}
+
+static int wait_for_fence_value_checked(u64 want, DWORD timeout_ms)
+{
+    static _Thread_local int short_poll_enabled = -1;
+    static _Thread_local int short_poll_frequency_state;
+    static _Thread_local LARGE_INTEGER short_poll_frequency;
+    static _Thread_local u64 short_poll_attempts, short_poll_hits;
+    static _Thread_local u64 short_poll_pending, short_poll_failures;
+    static _Thread_local u64 short_poll_clock_fallbacks;
+    static _Thread_local u64 short_poll_timed, short_poll_time_invalid;
+    static _Thread_local u64 short_poll_elapsed_ticks;
+    u64 completed = s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence);
+    tj_present_work_trace_wait_check(completed < want);
+    if (completed == UINT64_MAX)
+        return fence_wait_failure("device-removed", want, completed, E_FAIL, WAIT_FAILED);
+    if (completed >= want) return 0;
+
+    if (short_poll_enabled < 0) {
+        const char* value = getenv("TJ_FENCE_SHORT_POLL");
+        short_poll_enabled = value && strcmp(value, "1") == 0;
+    }
+    int short_poll_deadline_started = 0;
+    u64 wait_started = 0;
+    if (short_poll_enabled && rsx_survival_trace_is_armed() && timeout_ms > 0) {
+        enum { POLL_PENDING, POLL_HIT, POLL_FAILURE, POLL_CLOCK_FALLBACK };
+        int outcome = POLL_PENDING;
+        ++short_poll_attempts;
+
+        if (!short_poll_frequency_state) {
+            short_poll_frequency_state =
+                QueryPerformanceFrequency(&short_poll_frequency) &&
+                short_poll_frequency.QuadPart > 0 ? 1 : -1;
+        }
+        if (short_poll_frequency_state < 0) {
+            outcome = POLL_CLOCK_FALLBACK;
+            ++short_poll_time_invalid;
+        } else {
+            /* A 200us window, rounded down so the measured bound is never
+             * extended by a fractional performance-counter tick. */
+            u64 budget_ticks = (u64)short_poll_frequency.QuadPart / 5000;
+            LARGE_INTEGER poll_started;
+            int poll_started_valid = 0;
+            int poll_clock_valid = 0;
+            u64 poll_elapsed = 0;
+            LONGLONG poll_previous = 0;
+            if (!budget_ticks) {
+                outcome = POLL_CLOCK_FALLBACK;
+            } else {
+                wait_started = GetTickCount64();
+                if (!QueryPerformanceCounter(&poll_started) ||
+                    poll_started.QuadPart <= 0) {
+                    outcome = POLL_CLOCK_FALLBACK;
+                } else {
+                    short_poll_deadline_started = 1;
+                    poll_started_valid = poll_clock_valid = 1;
+                    poll_previous = poll_started.QuadPart;
+                    for (unsigned poll = 0; poll < 4096; ++poll) {
+                        completed = s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence);
+                        tj_present_work_trace_wait_check(completed < want);
+                        LARGE_INTEGER now;
+                        int clock_read = QueryPerformanceCounter(&now) &&
+                                         now.QuadPart >= poll_previous;
+                        if (clock_read) {
+                            poll_elapsed = (u64)(now.QuadPart - poll_started.QuadPart);
+                            poll_previous = now.QuadPart;
+                        } else {
+                            poll_clock_valid = 0;
+                        }
+                        if (completed == UINT64_MAX) {
+                            outcome = POLL_FAILURE;
+                            break;
+                        }
+                        if (completed >= want) {
+                            outcome = POLL_HIT;
+                            break;
+                        }
+                        if (!clock_read) {
+                            outcome = POLL_CLOCK_FALLBACK;
+                            break;
+                        }
+                        if (poll_elapsed >= budget_ticks) break;
+                    }
+                }
+            }
+
+            if (poll_started_valid && poll_clock_valid) {
+                ++short_poll_timed;
+                short_poll_elapsed_ticks += poll_elapsed;
+            } else {
+                ++short_poll_time_invalid;
+            }
+        }
+
+        if (outcome == POLL_HIT) ++short_poll_hits;
+        else if (outcome == POLL_FAILURE) ++short_poll_failures;
+        else if (outcome == POLL_CLOCK_FALLBACK) ++short_poll_clock_fallbacks;
+        else ++short_poll_pending;
+        if (short_poll_attempts == 1 || (short_poll_attempts & 255u) == 0) {
+            fprintf(stderr,
+                    "[D3D12-FENCE-POLL] tick_ms=%llu attempts=%llu hits=%llu "
+                    "pending=%llu failures=%llu clock_fallbacks=%llu "
+                    "timed=%llu invalid=%llu qpc_hz=%llu poll_ticks=%llu\n",
+                    (unsigned long long)GetTickCount64(),
+                    (unsigned long long)short_poll_attempts,
+                    (unsigned long long)short_poll_hits,
+                    (unsigned long long)short_poll_pending,
+                    (unsigned long long)short_poll_failures,
+                    (unsigned long long)short_poll_clock_fallbacks,
+                    (unsigned long long)short_poll_timed,
+                    (unsigned long long)short_poll_time_invalid,
+                    (unsigned long long)(short_poll_frequency_state > 0
+                        ? short_poll_frequency.QuadPart : 0),
+                    (unsigned long long)short_poll_elapsed_ticks);
+        }
+        if (outcome == POLL_HIT) return 0;
+        if (outcome == POLL_FAILURE)
+            return fence_wait_failure("device-removed", want, completed, E_FAIL, WAIT_FAILED);
+    }
+
+    LONGLONG phase_mark = tj_gcm2d_backend_perf_subphase_begin();
+    LONGLONG sync_mark = tj_present_work_trace_sync_begin();
+    HRESULT hr = s_d3d.fence->lpVtbl->SetEventOnCompletion(
+        s_d3d.fence, want, s_d3d.fence_event);
+    tj_present_work_trace_sync_finish(sync_mark, &s_tj_present_work_trace.fence_arm_ticks,
+                                      &s_tj_present_work_trace.fence_arm_calls);
+    if (s_tj_gcm2d_backend_perf_sample)
+        tj_gcm2d_backend_perf_subphase_end(
+            &s_tj_gcm2d_backend_perf_sample->fence_arm_ticks, phase_mark);
+    if (FAILED(hr))
+        return fence_wait_failure("event-registration", want, completed, hr, WAIT_FAILED);
+    u64 started = short_poll_deadline_started ? wait_started : GetTickCount64();
+    for (;;) {
+        completed = s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence);
+        if (completed == UINT64_MAX)
+            return fence_wait_failure("device-removed", want, completed, E_FAIL, WAIT_FAILED);
+        if (completed >= want) return 0;
+        u64 elapsed = GetTickCount64() - started;
+        if (elapsed >= timeout_ms)
+            return fence_wait_failure("timeout", want, completed, E_FAIL, WAIT_TIMEOUT);
+        DWORD wait_ms = (DWORD)(timeout_ms - elapsed);
+        u32 (*service)(void* context, u32 remaining_ms) = s_d3d12_fence_wait_service;
+        if (service && !s_d3d12_fence_wait_service_busy) {
+            s_d3d12_fence_wait_service_busy = 1;
+            u32 requested_ms = service(s_d3d12_fence_wait_service_context, wait_ms);
+            s_d3d12_fence_wait_service_busy = 0;
+
+            /* Service work can complete or remove the device, but only this
+             * exact fence ticket can authorize reuse. Include callback time in
+             * the original deadline before selecting the next OS wait slice. */
+            completed = s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence);
+            if (completed == UINT64_MAX)
+                return fence_wait_failure("device-removed", want, completed, E_FAIL, WAIT_FAILED);
+            if (completed >= want) return 0;
+            elapsed = GetTickCount64() - started;
+            if (elapsed >= timeout_ms)
+                return fence_wait_failure("timeout", want, completed, E_FAIL, WAIT_TIMEOUT);
+            wait_ms = (DWORD)(timeout_ms - elapsed);
+            if (requested_ms < 1) requested_ms = 1;
+            if (requested_ms > wait_ms) requested_ms = wait_ms;
+            wait_ms = requested_ms;
+        }
+        phase_mark = tj_gcm2d_backend_perf_subphase_begin();
+        sync_mark = tj_present_work_trace_sync_begin();
+        DWORD result = WaitForSingleObject(s_d3d.fence_event, wait_ms);
+        DWORD wait_error = result == WAIT_FAILED ? GetLastError() : ERROR_SUCCESS;
+        tj_present_work_trace_sync_finish(sync_mark, &s_tj_present_work_trace.fence_event_ticks,
+                                          &s_tj_present_work_trace.fence_event_calls);
+        if (s_tj_gcm2d_backend_perf_sample) {
+            tj_gcm2d_backend_perf_subphase_end(
+                &s_tj_gcm2d_backend_perf_sample->fence_event_ticks, phase_mark);
+            ++s_tj_gcm2d_backend_perf_sample->fence_event_calls;
+        }
+        if (result != WAIT_OBJECT_0 && result != WAIT_TIMEOUT) {
+            hr = result == WAIT_FAILED ? HRESULT_FROM_WIN32(wait_error) : E_FAIL;
+            return fence_wait_failure("event-wait", want, completed, hr, result);
+        }
+    }
+}
+
+/* Writeback cannot accept a timeout as success: mapping an unfinished copy
+ * would commit undefined bytes. Keep the existing six-second total bound. */
+static int tj_gpu_completion_perf_result(LONGLONG started, int result)
+{
+    if (started) {
+        unsigned reason = (unsigned)s_tj_completion_reason;
+        if (reason >= RSX_COMPLETION_REASON_COUNT) reason = RSX_COMPLETION_OTHER;
+        u64 ticks = (u64)(tj_gcm2d_backend_perf_now() - started);
+        ++s_tj_gcm2d_backend_perf.completion_calls[reason];
+        s_tj_gcm2d_backend_perf.completion_ticks[reason] += ticks;
+        if (ticks > s_tj_gcm2d_backend_perf.completion_max[reason])
+            s_tj_gcm2d_backend_perf.completion_max[reason] = ticks;
+        s_tj_gcm2d_backend_perf.completion_failures[reason] += result != 0;
+    }
+    return result;
+}
+
+/* Signal and wait are separate operations: the returned value belongs to this
+ * queue submission, even after later submissions advance the frame counter. */
+static int signal_for_gpu_checked(u64* ticket)
+{
+    s_d3d.gpu_completion_ticket = 0;
+    if (!ticket) return -1;
+    *ticket = 0;
+    u32 fi = s_d3d.frame_index;
+    if (fi >= FRAME_COUNT || s_d3d.fence_values[fi] >= UINT64_MAX - 1)
+        return fence_wait_failure("queue-ticket-overflow", 0, 0, E_FAIL, WAIT_FAILED);
+    u64 want = ++s_d3d.fence_values[fi];
+    LONGLONG phase_mark = tj_gcm2d_backend_perf_subphase_begin();
+    LONGLONG sync_mark = tj_present_work_trace_sync_begin();
+    HRESULT hr = s_d3d.cmd_queue->lpVtbl->Signal(s_d3d.cmd_queue, s_d3d.fence, want);
+    tj_present_work_trace_sync_finish(sync_mark, &s_tj_present_work_trace.queue_signal_ticks,
+                                      &s_tj_present_work_trace.queue_signal_calls);
+    if (s_tj_gcm2d_backend_perf_sample)
+        tj_gcm2d_backend_perf_subphase_end(
+            &s_tj_gcm2d_backend_perf_sample->fence_signal_ticks, phase_mark);
+    if (FAILED(hr))
+        return fence_wait_failure("queue-signal", want,
+            s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence), hr, WAIT_FAILED);
+    *ticket = want;
+    s_d3d.gpu_completion_ticket = want;
+    return 0;
+}
+
+static int d3d12_gpu_completion_reuse_enabled(void)
+{
+    static _Thread_local int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_GPU_COMPLETION_REUSE");
+        enabled = value && value[0] && value[0] != '0';
+    }
+    return enabled;
+}
+
+static int wait_for_gpu_checked(void)
+{
+    /* A grow or other original serialization point ends CPU-only overlap
+     * before selecting a completion ticket. Keep the checked wait below. */
+    if (d3d12_prefix_prepare_before_wait() != 0) return -1;
+    LONGLONG completion_started = tj_gcm2d_backend_perf_enabled()
+        ? tj_gcm2d_backend_perf_now() : 0;
+    if (completion_started && !s_tj_gcm2d_backend_perf.report_start_ms)
+        s_tj_gcm2d_backend_perf.report_start_ms = GetTickCount64();
+    u64 want = 0;
+    if (d3d12_gpu_completion_reuse_enabled() && rsx_survival_trace_is_armed() &&
+        s_d3d.frame_index < FRAME_COUNT &&
+        s_d3d.fence_values[s_d3d.frame_index] < UINT64_MAX - 1 &&
+        s_d3d.gpu_completion_ticket && s_d3d.gpu_completion_ticket != UINT64_MAX) {
+        /* No queue work has followed this actual Signal. It already covers
+         * the work we must finish; keep the checked wait even if still pending. */
+        want = s_d3d.gpu_completion_ticket;
+        ++s_d3d.gpu_completion_reused;
+    } else {
+        if (signal_for_gpu_checked(&want) != 0)
+            return tj_gpu_completion_perf_result(completion_started, -1);
+        ++s_d3d.gpu_completion_fresh;
+    }
+    LONGLONG wait_mark = tj_present_work_trace_sync_begin();
+    int result = wait_for_fence_value_checked(want, 6000);
+    tj_present_work_trace_sync_finish(wait_mark, &s_tj_present_work_trace.global_wait_ticks,
+                                      &s_tj_present_work_trace.global_wait_calls);
+    return tj_gpu_completion_perf_result(completion_started, result);
+}
+
+static int wait_for_gpu_checked_at(RsxD3D12CompletionReason reason)
+{
+    if (!tj_gcm2d_backend_perf_enabled()) return wait_for_gpu_checked();
+    RsxD3D12CompletionReason previous = s_tj_completion_reason;
+    s_tj_completion_reason = (unsigned)reason < RSX_COMPLETION_REASON_COUNT
+        ? reason : RSX_COMPLETION_OTHER;
+    int result = wait_for_gpu_checked();
+    s_tj_completion_reason = previous;
+    return result;
+}
