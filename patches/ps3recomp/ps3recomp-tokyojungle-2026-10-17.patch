+    spu_table_lock();
+    spu_group_t* g = spu_group_acquire(group_id);
+    if (!g) {
+        spu_table_unlock();
+        return (int64_t)(int32_t)CELL_ESRCH;
+    }
+    for (uint32_t i = 0; i < g->num_threads && i < 8; i++) {
+        uint32_t idx = g->thread_indices[i];
+        if (idx >= MAX_SPU_THREADS) continue;
