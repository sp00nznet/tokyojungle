+static void vp_plan_decode_cmp(const u8* p, u32 n, VPSlot* o)
+{
+    (void)n;
+    u32 packed = rd_beu32(p);
+    s16 x = (s16)((packed & 0x7FFu) << 5);
+    s16 y = (s16)(((packed >> 11) & 0x7FFu) << 5);
+    s16 z = (s16)(((packed >> 22) & 0x3FFu) << 6);
+    o->v[0] = (float)x / 32767.0f;
+    o->v[1] = (float)y / 32767.0f;
+    o->v[2] = (float)z / 32767.0f;
+    o->v[3] = 1.0f;
+}
+static void vp_plan_decode_ub256(const u8* p, u32 n, VPSlot* o)
+{
+    for (u32 k = 0; k < n; k++) o->v[k] = (float)p[k];
+}
