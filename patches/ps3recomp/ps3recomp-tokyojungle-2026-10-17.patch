diff --git a/libs/video/rsx_argb_upload.h b/libs/video/rsx_argb_upload.h
new file mode 100644
index 0000000..bdc67bf
--- /dev/null
+++ b/libs/video/rsx_argb_upload.h
@@ -0,0 +1,34 @@
+/* Convert immutable guest ARGB rows to a distinct RGBA upload allocation.
+ * Caller validates pitches/spans. Every output pixel and padding byte is set. */
+#ifndef PS3RECOMP_RSX_ARGB_UPLOAD_H
+#define PS3RECOMP_RSX_ARGB_UPLOAD_H
+#include <stdint.h>
+#include <string.h>
+#if defined(__SSE2__) || defined(_M_X64)
+#include <emmintrin.h>
+#endif
+
+static inline void rsx_argb_upload_rows(uint8_t* dst, uint32_t dst_pitch,
+    const uint8_t* src, uint32_t src_pitch, uint32_t pixels, uint32_t rows)
+{
+    for (uint32_t y = 0; y < rows; ++y) {
+        const uint8_t* s = src + (uint64_t)y * src_pitch;
+        uint8_t* d = dst + (uint64_t)y * dst_pitch;
+        uint32_t x = 0;
+#if defined(__SSE2__) || defined(_M_X64)
+        for (; pixels - x >= 4; x += 4) {
+            __m128i argb = _mm_loadu_si128((const __m128i*)(s + (uint64_t)x * 4));
+            __m128i rgba = _mm_or_si128(_mm_srli_epi32(argb, 8),
+                                         _mm_slli_epi32(argb, 24));
+            _mm_storeu_si128((__m128i*)(d + (uint64_t)x * 4), rgba);
+        }
+#endif
+        for (; x < pixels; ++x) {
+            d[x*4] = s[x*4+1]; d[x*4+1] = s[x*4+2];
+            d[x*4+2] = s[x*4+3]; d[x*4+3] = s[x*4];
+        }
+        size_t row_bytes = (size_t)pixels * 4;
+        if (dst_pitch > row_bytes) memset(d + row_bytes, 0, dst_pitch - row_bytes);
+    }
+}
+#endif
diff --git a/libs/video/rsx_boundary_policy.h b/libs/video/rsx_boundary_policy.h
new file mode 100644
index 0000000..e718504
--- /dev/null
+++ b/libs/video/rsx_boundary_policy.h
@@ -0,0 +1,43 @@
+#ifndef RSX_BOUNDARY_POLICY_H
+#define RSX_BOUNDARY_POLICY_H
+
+#include <stdint.h>
+
+static inline int rsx_boundary_should_arm_survival_profile(
+    uint32_t tile_index, uint32_t location, uint32_t offset,
+    uint32_t size, uint32_t pitch)
+{
+    return tile_index == 10u && location == 0u &&
+           offset == UINT32_C(0x0F510000) &&
+           size == UINT32_C(0x003A0000) && pitch == 5120u;
+}
+
+typedef enum rsx_boundary_decision {
+    RSX_BOUNDARY_ACCUMULATE,
+    RSX_BOUNDARY_COALESCE,
+    RSX_BOUNDARY_PRESENT,
+} rsx_boundary_decision;
+
+/* consumed_generation identifies the flip already consumed by the ticker.
+ * submitted_boundary_generation identifies content this backend has submitted,
+ * not completed on the GPU. */
+static inline rsx_boundary_decision rsx_boundary_decide(
+    uint64_t consumed_generation, uint64_t submitted_boundary_generation,
+    int have_display_work)
+{
+    if (!have_display_work)
+        return RSX_BOUNDARY_ACCUMULATE;
+    if (consumed_generation == 0u)
+        return RSX_BOUNDARY_PRESENT;
+    return consumed_generation == submitted_boundary_generation
+        ? RSX_BOUNDARY_COALESCE : RSX_BOUNDARY_PRESENT;
+}
+
+static inline uint64_t rsx_boundary_submitted_generation_after_submit(
+    uint64_t consumed_generation, uint64_t submitted_boundary_generation)
+{
+    return consumed_generation != 0u
+        ? consumed_generation : submitted_boundary_generation;
+}
+
+#endif
diff --git a/libs/video/rsx_bytes_equal.h b/libs/video/rsx_bytes_equal.h
new file mode 100644
index 0000000..f87f162
--- /dev/null
+++ b/libs/video/rsx_bytes_equal.h
@@ -0,0 +1,74 @@
+/* Exact equality for immutable snapshot reuse. No hash, sampling or overread. */
+#ifndef PS3RECOMP_RSX_BYTES_EQUAL_H
+#define PS3RECOMP_RSX_BYTES_EQUAL_H
+
+#include <stddef.h>
+#include <string.h>
+#if defined(__SSE2__) || defined(_M_X64)
+#include <emmintrin.h>
+#endif
+#if defined(__clang__) && (defined(__x86_64__) || defined(_M_X64))
+#include <immintrin.h>
+#define RSX_BYTES_EQUAL_HAS_AVX2 1
+#endif
+
+static inline int rsx_bytes_equal(const void* left, const void* right, size_t size)
+{
+    const unsigned char* a = (const unsigned char*)left;
+    const unsigned char* b = (const unsigned char*)right;
+#if defined(__SSE2__) || defined(_M_X64)
+    while (size >= 64) {
+        __m128i diff = _mm_xor_si128(_mm_loadu_si128((const __m128i*)(a)),
+                                    _mm_loadu_si128((const __m128i*)(b)));
+        diff = _mm_or_si128(diff, _mm_xor_si128(
+            _mm_loadu_si128((const __m128i*)(a + 16)),
+            _mm_loadu_si128((const __m128i*)(b + 16))));
+        diff = _mm_or_si128(diff, _mm_xor_si128(
+            _mm_loadu_si128((const __m128i*)(a + 32)),
+            _mm_loadu_si128((const __m128i*)(b + 32))));
+        diff = _mm_or_si128(diff, _mm_xor_si128(
+            _mm_loadu_si128((const __m128i*)(a + 48)),
+            _mm_loadu_si128((const __m128i*)(b + 48))));
+        if (_mm_movemask_epi8(_mm_cmpeq_epi8(diff, _mm_setzero_si128())) != 0xFFFF)
+            return 0;
+        a += 64; b += 64; size -= 64;
+    }
+    while (size >= 16) {
+        if (_mm_movemask_epi8(_mm_cmpeq_epi8(
+                _mm_loadu_si128((const __m128i*)a),
+                _mm_loadu_si128((const __m128i*)b))) != 0xFFFF)
+            return 0;
+        a += 16; b += 16; size -= 16;
+    }
+#endif
+    return size == 0 || memcmp(a, b, size) == 0;
+}
+
+#if defined(RSX_BYTES_EQUAL_HAS_AVX2)
+/* The caller must check both CPU and OS AVX2 support before dispatching here.
+ * Target only this routine; older x64 hosts retain the SSE2 implementation. */
+__attribute__((target("avx2")))
+static int rsx_bytes_equal_avx2(const void* left, const void* right, size_t size)
+{
+    const unsigned char* a = (const unsigned char*)left;
+    const unsigned char* b = (const unsigned char*)right;
+    while (size >= 128) {
+        __m256i diff = _mm256_xor_si256(_mm256_loadu_si256((const __m256i*)a),
+                                       _mm256_loadu_si256((const __m256i*)b));
+        diff = _mm256_or_si256(diff, _mm256_xor_si256(
+            _mm256_loadu_si256((const __m256i*)(a + 32)),
+            _mm256_loadu_si256((const __m256i*)(b + 32))));
+        diff = _mm256_or_si256(diff, _mm256_xor_si256(
+            _mm256_loadu_si256((const __m256i*)(a + 64)),
+            _mm256_loadu_si256((const __m256i*)(b + 64))));
+        diff = _mm256_or_si256(diff, _mm256_xor_si256(
+            _mm256_loadu_si256((const __m256i*)(a + 96)),
+            _mm256_loadu_si256((const __m256i*)(b + 96))));
+        if (!_mm256_testz_si256(diff, diff)) return 0;
+        a += 128; b += 128; size -= 128;
+    }
+    return rsx_bytes_equal(a, b, size);
+}
+#endif
+
+#endif
