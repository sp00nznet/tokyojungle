+/* Windowed opt-in: client = internal size, shrunk to the monitor work area at
+ * the same aspect ratio (DXGI then stretches the internal swap chain to it).
+ * The frame is measured on the created window, so its DPI is the real one. */
+static void d3d12_scale_window_fit(HWND window, u32 width, u32 height)
+{
+    RECT client = {0}, frame = {0};
+    MONITORINFO mi;
+    memset(&mi, 0, sizeof(mi));
+    mi.cbSize = sizeof(mi);
+    HMONITOR monitor = MonitorFromWindow(window, MONITOR_DEFAULTTOPRIMARY);
+    if (!width || !height || !GetClientRect(window, &client) ||
+        !GetWindowRect(window, &frame) || !monitor || !GetMonitorInfoA(monitor, &mi))
+        return;
+    const LONG extra_w = (frame.right - frame.left) - (client.right - client.left);
+    const LONG extra_h = (frame.bottom - frame.top) - (client.bottom - client.top);
+    const LONG work_w = mi.rcWork.right - mi.rcWork.left;
+    const LONG work_h = mi.rcWork.bottom - mi.rcWork.top;
+    const LONG max_w = work_w - extra_w, max_h = work_h - extra_h;
+    LONG client_w = (LONG)width, client_h = (LONG)height;
+    if (max_w > 0 && max_h > 0 && (client_w > max_w || client_h > max_h)) {
+        if ((long long)max_w * height <= (long long)max_h * width) {
+            client_w = max_w;
+            client_h = (LONG)((long long)max_w * height / width);
+        } else {
+            client_h = max_h;
+            client_w = (LONG)((long long)max_h * width / height);
+        }
+    }
+    const LONG window_w = client_w + extra_w, window_h = client_h + extra_h;
+    LONG x = mi.rcWork.left + (work_w - window_w) / 2;
+    LONG y = mi.rcWork.top + (work_h - window_h) / 2;
+    if (x < mi.rcWork.left) x = mi.rcWork.left;
+    if (y < mi.rcWork.top) y = mi.rcWork.top;
+    SetWindowPos(window, NULL, x, y, window_w, window_h, SWP_NOZORDER | SWP_NOACTIVATE);
+    fprintf(stderr, "[tj-scale] window client %ldx%ld for internal %ux%u%s\n",
+            (long)client_w, (long)client_h, width, height,
+            client_w != (LONG)width ? " (work area; DXGI stretches)" : "");
+}
