+static void tj_compose_capture_final(u32 fi, D3D12_RESOURCE_STATES prior)
+{
+    if (s_tj_main_prov.active) return;
+    tj_compose_capture_queue("live_final", s_d3d.render_targets[fi], 0, 0,
+                             s_d3d.width, s_d3d.height,
+                             DXGI_FORMAT_R8G8B8A8_UNORM,
+                             prior);
+    /* Optional readback of a bounded offscreen input at a replay prefix end.
+     * This copies GPU bytes only; it does not replace shaders or bindings. */
+    const char* selected = getenv("TJ_COMPOSE_CAPTURE_OFFRT");
+    unsigned raw = 0, w = 0, h = 0;
+    if (selected && sscanf(selected, "%x,%u,%u", &raw, &w, &h) == 3) {
+        int slot = off_rt_find(raw, 1);
+        if (slot >= 0) {
+            OffRT* r = &s_d3d.off_rt[slot];
+            if (r->off == raw && w && h && w <= r->w && h <= r->h)
+                tj_compose_capture_queue("offrt_selected_final", r->res,
+                                         0, 0, w, h, r->dxgi, r->st);
+        }
+    }
+}
