+static void d3d12_bind_vertex_texture(void* ud, u32 unit,
+                                      const rsx_texture_state* tex)
+{
+    (void)ud;
+    extern uint8_t* vm_base;
+    if (!tex || unit >= RSX_MAX_VERTEX_TEXTURES) return;
+
+    memset(&s_d3d.cur_vtexs[unit], 0, sizeof(s_d3d.cur_vtexs[unit]));
+    if (!(tex->control0 & 0x80000000u) || !vm_base) return;
+
+    u32 width = (tex->image_rect >> 16) & 0xFFFFu;
+    u32 dimension = (tex->format >> 4) & 0xFu;
+    u32 height = dimension == 1u ? 1u : tex->image_rect & 0xFFFFu;
+    u32 depth = dimension == 3u ? tex->depth : 1u;
+    u32 format = (tex->format >> 8) & 0xFFu;
+    u32 base_fmt = format & 0x9Fu;
+    if (!width || !height || !depth || !vp_tex_format_info(base_fmt, NULL))
+        return;
+
+    const int cube = dimension == 2u && (tex->format & 4u);
+    u16 mip_count = vp_tex_exact_mip_count(width, height, depth, format,
+                                            cube ? 4u : dimension,
+                                            tex->format >> 16);
+
+    u32 resolved_offset;
+    if (!cellGcmResolveLocatedChecked((tex->format & 3u) == 1u,
+                                      tex->offset & 0x7FFFFFFFu,
+                                      &resolved_offset))
+        return;
+    s_d3d.cur_vtexs[unit].off = resolved_offset;
+    s_d3d.cur_vtexs[unit].raw = tex->offset & 0x7FFFFFFFu;
+    s_d3d.cur_vtexs[unit].w = width;
+    s_d3d.cur_vtexs[unit].h = height;
+    s_d3d.cur_vtexs[unit].depth = depth;
+    s_d3d.cur_vtexs[unit].fmt = format;
+    s_d3d.cur_vtexs[unit].mips = mip_count;
+    s_d3d.cur_vtexs[unit].cube = cube;
+    s_d3d.cur_vtexs[unit].dimension =
+        s_d3d.cur_vtexs[unit].cube ? 4u : dimension;
+    s_d3d.cur_vtexs[unit].location = tex->format & 3u;
+    s_d3d.cur_vtexs[unit].pitch = tex->pitch;
+    s_d3d.cur_vtexs[unit].ctrl1 = 0x0000AAE4u; /* vertex remap is fixed identity */
+    s_d3d.cur_vtexs[unit].address = tex->address;
+    s_d3d.cur_vtexs[unit].control0 = tex->control0;
+    s_d3d.cur_vtexs[unit].filter = tex->filter;
+    s_d3d.cur_vtexs[unit].border_color = tex->border_color;
+    s_d3d.cur_vtexs[unit].border_type = 1; /* vertex textures never source a porch */
+    s_d3d.cur_vtexs[unit].set = 1;
+}
