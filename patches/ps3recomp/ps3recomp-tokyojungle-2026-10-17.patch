+static u32 d3d12_display_vblank_divisor(u32 refresh_mhz)
+{
+    if (refresh_mhz < 30000u) return 0;
+    const u32 n = (refresh_mhz + 30000u) / 60000u;
+    const u32 target = n * 60000u;
+    const u32 diff = refresh_mhz > target ? refresh_mhz - target : target - refresh_mhz;
+    return n && (u64)diff * 50u <= (u64)target ? n : 0;
