+    if (spurs_trace_enabled())
+        printf("[cellSpurs] JobChainAttributeSetName(attr=0x%08X, \"%s\")\n",
+               (u32)attr_ea, name_ea ? (const char*)(vm_base + (u32)name_ea) : "-");
+    return CELL_OK;
+}
