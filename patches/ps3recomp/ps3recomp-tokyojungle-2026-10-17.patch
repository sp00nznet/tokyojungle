+static void gcm2d_discard_records(void)
+{
+    VP_SNAP_PAR_BARRIER(RENDER);
+    gpu_blit_record_snapshots_release();
+    s_d3d.draw_count = 0;
+    s_d3d.vb_offset = 0;
+    s_d3d.vp_vb_offset = 0;
+    tj_indexed_diag_clear_records();
