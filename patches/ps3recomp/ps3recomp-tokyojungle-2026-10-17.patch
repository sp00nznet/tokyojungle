+typedef struct { int kind, slot; u32 x, y; } GpuBlitEndpoint;
+static ID3D12Resource* gpu_blit_endpoint_resource(const GpuBlitEndpoint* e);
+static D3D12_RESOURCE_STATES gpu_blit_endpoint_state(const GpuBlitEndpoint* e);
