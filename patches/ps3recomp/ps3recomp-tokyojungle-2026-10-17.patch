+        level_w = w;
+        level_h = h;
+        for (u32 level = 0; level < mip_count; ++level) {
+            VPTexSourceLevel source_level;
+            u32 subresource = face * mip_count + level;
+            if (vp_tex_source_level(&info, fmt, level_w, level_h, 1u,
+                                    dimension, has_border, src_pitch,
+                                    &source_level) != 0 ||
+                vp_copy_tex_level_layout(
+                    (u8*)mapped + footprints[subresource].Offset,
+                    footprints[subresource].Footprint.RowPitch,
+                    source + face * face_stride + face_level_off,
+                    &source_level, level_w, level_h, 0, 1, basef, 0) != 0) {
+                t->up->lpVtbl->Unmap(t->up, 0, NULL);
+                return -1;
+            }
+            face_level_off += source_level.slice_bytes;
+            level_w = level_w > 1u ? level_w >> 1 : 1u;
+            level_h = level_h > 1u ? level_h >> 1 : 1u;
+        }
+    }
