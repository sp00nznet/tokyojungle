+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+        sv.TextureCube.MostDetailedMip = 0;
+        sv.TextureCube.MipLevels = mip_count;
+        sv.TextureCube.ResourceMinLODClamp = 0.0f;
+    } else if (dimension == 1u) {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE1D;
+        sv.Texture1D.MostDetailedMip = 0;
+        sv.Texture1D.MipLevels = mip_count;
+        sv.Texture1D.ResourceMinLODClamp = 0.0f;
+    } else if (is_3d) {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE3D;
+        sv.Texture3D.MostDetailedMip = 0;
+        sv.Texture3D.MipLevels = mip_count;
+        sv.Texture3D.ResourceMinLODClamp = 0.0f;
+    } else {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sv.Texture2D.MostDetailedMip = 0;
+        sv.Texture2D.MipLevels = mip_count;
+        sv.Texture2D.ResourceMinLODClamp = 0.0f;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE sh;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &sh);
+    sh.ptr += (u64)(VP_TEX_SRV_BASE + slot) * s_d3d.srv_inc;
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, t->res, &sv, sh);
+
+    t->off = off; t->w = w; t->h = h; t->depth = depth;
+    t->fmt = fmt; t->pitch = src_pitch;
+    t->mips = (u16)mip_count;
+    t->cube = cube;
+    t->dimension = dimension;
+    t->dxgi = (u32)dxfmt;
+    t->has_border = (u8)has_border;
+    t->source_hash = source_hash;
+    vp_texture_cache_set_source(t, source_snapshot);
+    if (lookup_fast) source_snapshot->tex_cache_slot_plus1 = (u16)(slot + 1);
+    t->used = 1;
+    if (d3d12_prefix_owner_texture_capture((u32)slot) != 0) return -1;
+    /* Count only a completed cache-miss upload. Source bytes are the logical
+     * source span consumed by the successful conversion into the upload map. */
+    if (churn_trace) {
+        vp_texture_churn_record_upload_candidates(
+            churn_same_snapshot_other_off, churn_same_off_hash_equal,
+            churn_same_off_hash_different);
+        vp_texture_churn_record_upload_miss(total_source_span, fresh);
+        vp_texture_churn_record_upload_probe(
+            churn_plain_linear_shape, churn_plain_linear_padded,
+            churn_old_sameoff_snapshot != NULL, churn_probe_result);
+    }
+    return slot;
+}
+#undef VP_TEX_SLOT_EXACT_HIT
+
+/* ---------------------------------------------------------------------------
+ * Render-to-texture: offscreen RT pool.
+ *
+ * Draws/clears targeting a non-display surface (SET_SURFACE_COLOR_xOFFSET
+ * not registered via cellGcmSetDisplayBuffer) render into a pooled RGBA8
+ * texture keyed by the surface's resolved vm offset; a later draw binding a
+ * texture at that offset samples the RT directly instead of guest memory.
+ * RGBA8 for every RT (even half-float guest surfaces) keeps the existing
+ * PSO/RTV formats -- values clamp to [0,1], which demosaic's RGB data fits.
+ * -----------------------------------------------------------------------*/
+
+/* Snapshot the VP constant bank + viewport epilogue for one draw into its
+ * vp_cb slot. Runs at record time so every draw keeps the constants that
+ * were live when the guest issued it. */
+static u32 rsx_argb_mask_to_rgba(u32 mask)
+{
+    /* RSX mask lanes are A,R,G,B; HLSL vector bits below are R,G,B,A. */
+    return ((mask >> 1u) & 7u) | ((mask & 1u) << 3u);
+}
+
+static u32 rsx_remap_argb_mask(u32 control1, u32 basef, u32 input_mask)
+{
+    control1 = rsx_texture_control1_normalize(control1, basef);
+    u32 output_mask = 0;
+    for (u32 output = 0; output < 4u; ++output) {
+        const u32 source = (control1 >> (output * 2u)) & 3u;
+        const u32 op = (control1 >> (8u + output * 2u)) & 3u;
+        if (op >= 2u && (input_mask & (1u << source)))
+            output_mask |= 1u << output;
+    }
+    return output_mask;
+}
+
+/* X16/Y16_X16/HILO use a special two-channel CONTROL1 encoding. Normalize its
+ * low word like RPCS3; G8B8 is not in this format class. */
+static u32 rsx_special_16bit_remap(u32 control1)
+{
+    const u32 override = (control1 >> 16u) & 0xFFFFu;
+    u32 low = control1 & 0xFFu;
+    switch (low) {
+    case 0xE4u: low = override ? 0x56u : 0x66u; break;
+    case 0x4Eu: low = override ? 0xA9u : 0x99u; break;
+    case 0xEEu: low = 0xAAu; break;
+    case 0x44u: low = 0x55u; break;
+    default: break;
+    }
+    return (control1 & ~0xFFu) | low;
+}
+
+static u32 rsx_texture_conversion_control(u32 fmt, u32 control1,
+                                          u32 address, u32 control0,
+                                          u32 filter)
+{
+    enum {
+        RSX_CONVERT_SIGNED = 1u,
+        RSX_CONVERT_GAMMA = 2u,
+        RSX_CONVERT_BIASED = 4u,
+        RSX_CONVERT_16BIT = 8u
+    };
+    const u32 basef = fmt & 0x9Fu;
+    control1 = rsx_texture_control1_normalize(control1, basef);
+    u32 features = 0;
+    switch (basef) {
+    case 0x81: case 0x82: case 0x83: case 0x84: case 0x85:
+    case 0x86: case 0x87: case 0x88: case 0x8B: case 0x8D:
+    case 0x8E: case 0x8F: case 0x97: case 0x9D: case 0x9E:
+        features = RSX_CONVERT_SIGNED | RSX_CONVERT_GAMMA |
+                   RSX_CONVERT_BIASED;
+        break;
+    case 0x90: case 0x91: case 0x92: case 0x93:
+    case 0x98:
+        features = RSX_CONVERT_BIASED;
+        break;
+    case 0x94:
+        features = RSX_CONVERT_BIASED | RSX_CONVERT_16BIT;
+        break;
+    case 0x95:
+        features = RSX_CONVERT_SIGNED | RSX_CONVERT_BIASED |
+                   RSX_CONVERT_16BIT;
+        break;
+    default:
+        break; /* HILO_S8 and floating-point formats ignore conversion flags. */
+    }
+
+    u32 signed_argb = (features & RSX_CONVERT_SIGNED)
+        ? ((filter >> 28u) & 0xFu) : 0u;
+    /* Formats with a hardware-defined alpha constant cannot reinterpret it. */
+    if (basef == 0x81 || basef == 0x84 || basef == 0x8D ||
+        basef == 0x8E || basef == 0x8F || basef == 0x9D || basef == 0x9E)
+        signed_argb &= 0xEu;
+    const u32 signed_rgba = rsx_argb_mask_to_rgba(
+        rsx_remap_argb_mask(control1, basef, signed_argb));
+
+    /* Address gamma bits are already R,G,B,A and apply after the component
+     * crossbar, unlike signed/BX2 input properties. */
+    u32 gamma_rgba = (features & RSX_CONVERT_GAMMA)
+        ? ((address >> 20u) & 0xFu) : 0u;
+    gamma_rgba &= ~signed_rgba;
+
+    u32 biased_rgba = 0;
+    if ((features & RSX_CONVERT_BIASED) &&
+        ((address >> 12u) & 0xFu) == 1u) {
+        biased_rgba = rsx_argb_mask_to_rgba(
+            rsx_remap_argb_mask(control1, basef, 0xFu));
+        biased_rgba &= ~(signed_rgba | gamma_rgba);
+    }
+
+    return ((control0 & 4u) ? 1u : 0u) |
+           (gamma_rgba << 1u) |
+           (signed_rgba << 5u) |
+           (biased_rgba << 9u) |
+           ((features & RSX_CONVERT_16BIT) ? (1u << 13u) : 0u);
+}
+
+static void vp_record_cb(u32 slot, int vs_idx, D3D12DrawRecord* dr)
+{
+    if (!dr || slot >= MAX_DRAWS) return;
+    const u32 latest = s_d3d.prefix_deferred_owner;
+    const int retained_marker = d3d12_prefix_vertex_prepare_overlap_enabled() &&
+        s_d3d.prefix_vertex_prepare_sequence && latest && latest <= 2 &&
+        s_d3d.prefix_owners[latest - 1].phase == 2 &&
+        !s_d3d.prefix_owners[latest - 1].label_count &&
+        !s_d3d.texture_label_count && !s_d3d.texture_label_armed &&
+        s_d3d.prefix_owners[latest - 1].sequence ==
+            s_d3d.prefix_vertex_prepare_sequence;
+    if (!retained_marker && d3d12_prefix_owner_before_upload(0, 0, NULL) != 0) return;
+    /* Capture before the VP constant-bank availability check.  FP replay must
+     * retain this draw's program even when a later resource failure prevents
+     * vertex constants from being uploaded. */
+    {
+        extern uint8_t* vm_base;
+        u32 fp_off = 0;
+        int fp_local = 0;
+        int fp_resolved = dr->fp_addr &&
+            rsx_shader_program_location_is_local(dr->fp_addr, &fp_local) &&
+            cellGcmResolveLocatedChecked(fp_local, dr->fp_addr & ~0x3u, &fp_off);
+        dr->fp_resolved_off = fp_resolved ? fp_off : 0xFFFFFFFFu;
+        dr->fp_program_valid = 0;
+        if (vm_base && fp_resolved) {
+            if (rsx_fp_capture_structural(vm_base + fp_off,
+                                          RSX_FP_MAX_PROGRAM_BYTES,
+                                          &dr->fp_program) == 0)
+                dr->fp_program_valid = 1;
+        } else {
+            memset(&dr->fp_program, 0, sizeof(dr->fp_program));
+        }
+    }
+    /* TJ_SHADER_PREFETCH: start this draw's first-sight PS compile now. */
+    tj_shader_prefetch_record_fp(dr);
+    /* Reuse the exact program below; never read mutable instructions again to
+     * decide whether a stale, unused binding needs the late B wait. The bank
+     * was already checked at vertex preparation, and no snapshot/CB write has
+     * happened here. Owners with guest label writes, ordinary paths and stale
+     * markers keep their old capture-after-publication order. */
+    if (retained_marker && d3d12_prefix_owner_before_upload(0, 0, dr) != 0) return;
+    /* Derive texture use from this exact program before capturing its inputs.
+     * Both remain record-time snapshots, independent of later guest writes. */
+    vp_capture_draw_texture_snapshots(dr);
+    /* FP texcoord scale (b1): 1/size for UNnormalized textures (fmt bit
+     * 0x40 -- wave samples everything in texel space), 1.0 otherwise. */
+    if (s_d3d.vp_fpcb_mapped) {
+        float* ts = (float*)((char*)s_d3d.vp_fpcb_mapped
+            + ((u64)s_d3d.vp_parity * MAX_DRAWS + slot) * FP_CB_STRIDE);
+        memset(ts, 0, FP_CB_STRIDE);
+        for (int _u = 0; _u < RSX_MAX_TEXTURES; _u++) {
+            float sx = 1.0f, sy = 1.0f, sz = 1.0f;
+            float compare_max = FLT_MAX;
+            if (dr->tex[_u].set) {
+                const u32 basef = dr->tex[_u].fmt & 0x9Fu;
+                if ((dr->tex[_u].fmt & 0x40u) && dr->tex[_u].w)
+                    sx = 1.0f / (float)dr->tex[_u].w;
+                if ((dr->tex[_u].fmt & 0x40u) && dr->tex[_u].h)
+                    sy = 1.0f / (float)dr->tex[_u].h;
+                if ((dr->tex[_u].fmt & 0x40u) && dr->tex[_u].depth)
+                    sz = 1.0f / (float)dr->tex[_u].depth;
+                /* Fixed depth formats clamp the comparison reference to one;
+                 * floating depth retains its extended range. */
+                if (basef == 0x90u || basef == 0x92u)
+                    compare_max = 1.0f;
+            }
+            ts[_u*4+0] = sx; ts[_u*4+1] = sy;
+            ts[_u*4+2] = sz; ts[_u*4+3] = compare_max;
+        }
+        {
+            u32* controls = (u32*)ts + RSX_MAX_TEXTURES * 4u;
+            for (u32 _u = 0; _u < RSX_MAX_TEXTURES; ++_u)
+                controls[_u] = dr->tex[_u].set
+                    ? rsx_texture_conversion_control(
+                        dr->tex[_u].fmt, dr->tex[_u].ctrl1,
+                        dr->tex[_u].address, dr->tex[_u].control0,
+                        dr->tex[_u].filter)
+                    : 0u;
+        }
+        /* rsx_alphatest (after scales + texture controls): x=enable,
+         * y=ref/255, z=func-0x200, w=framebuffer sRGB output. D3D12
+         * has no fixed alpha test; guest FPs discard on it dynamically
+         * (wave's colour wheel is a disc via alpha test -- without it the
+         * palette drew as an opaque square). */
+        static _Thread_local int no_alphatest_enabled = -1;
+        if (no_alphatest_enabled < 0) no_alphatest_enabled = getenv("NO_ALPHATEST") != NULL;
+        if (!no_alphatest_enabled) {
+            { static int _at = 0;
+              if (((dr->alpha_ctl >> 16) & 1u) && _at++ < 4)
+                  printf("[ALPHATEST] enable func=%u ref=%u\n",
+                         (dr->alpha_ctl >> 8) & 0xFFu, dr->alpha_ctl & 0xFFu); }
+            u32 alpha = FP_CB_ALPHA_SLOT * 4u;
+            ts[alpha + 0] = (float)((dr->alpha_ctl >> 16) & 1u);
+            ts[alpha + 1] = (float)(dr->alpha_ctl & 0xFFu) / 255.0f;
+            ts[alpha + 2] = (float)((dr->alpha_ctl >> 8) & 0x07u);
+            ts[alpha + 3] = dr->fp_srgb ? 1.0f : 0.0f;
+        } else {
+            u32 alpha = FP_CB_ALPHA_SLOT * 4u;
+            ts[alpha + 0] = 0.0f; ts[alpha + 1] = 0.0f;
+            ts[alpha + 2] = 7.0f;
+            ts[alpha + 3] = dr->fp_srgb ? 1.0f : 0.0f;
+        }
+        {
+            u32 raster = FP_CB_RASTER_SLOT * 4u;
+            ts[raster + 0] = dr->depth_bounds_enable ? 1.0f : 0.0f;
+            ts[raster + 1] = dr->depth_bounds_min;
+            ts[raster + 2] = dr->depth_bounds_max;
+            ts[raster + 3] = (float)dr->fp_input_control;
+        }
+        {
+            u32 window = FP_CB_WINDOW_SLOT * 4u;
+            ts[window + 0] = dr->wpos_scale_y;
+            ts[window + 1] = dr->wpos_bias_x;
+            ts[window + 2] = dr->wpos_bias_y;
+            /* TJ_RENDER_SCALE: host -> guest WPOS factor (only the scaled
+             * FP prologue reads it); the 1x lane stays 0.0. */
+            ts[window + 3] = s_d3d.scale > 1
+                ? 1.0f / (float)rs_factor(dr->raster_scale) : 0.0f;
+        }
+        {
+            u32 fog = FP_CB_FOG_SLOT * 4u;
+            ts[fog + 0] = dr->fog_param0;
+            ts[fog + 1] = dr->fog_param1;
+            ts[fog + 2] = (float)dr->fog_mode;
+            ts[fog + 3] = 0.0f;
+        }
+        if (dr->fp_program_valid) {
+            u32* words = (u32*)ts;
+            for (u32 i = 0; i < dr->fp_program.inline_count; ++i) {
+                u32 raw = dr->fp_program.inline_word_index[i];
+                memcpy(words + (FP_CB_INLINE_BASE + i) * 4u,
+                       dr->fp_program.raw_words + raw, 16u);
+            }
+        }
+    }
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!s_d3d.vp_cb_mapped || !st) return;
+    char* dst = (char*)s_d3d.vp_cb_mapped
+        + ((u64)s_d3d.vp_parity * MAX_DRAWS + slot) * VP_CB_STRIDE;
+    memcpy(dst, st->vertex_constants, RSX_MAX_VERTEX_CONSTANTS * 16);
+    /* Viewport epilogue (see the render_frame notes this logic came from):
+     * x/y identity, z lane remaps GL clip z when the guest programs one. */
+    float* vpx = (float*)(dst + RSX_MAX_VERTEX_CONSTANTS * 16);
+    const float* vs_ = st->viewport_scale;
+    const float* vo_ = st->viewport_offset;
+    vpx[0] = vpx[1] = vpx[3] = 1.0f;
+    vpx[4] = vpx[5] = vpx[7] = 0.0f;
+    if (vs_[2] != 0.0f) { vpx[2] = vs_[2]; vpx[6] = vo_[2]; }
+    else                { vpx[2] = 1.0f;   vpx[6] = 0.0f;   }
+    /* HLSL packs these uints into one 16-byte cbuffer register. */
+    u32* vp_control = (u32*)(dst + (RSX_MAX_VERTEX_CONSTANTS + 2u) * 16u);
+    vp_control[0] = st->transform_branch_bits;
+    vp_control[1] = st->vertex_attrib_output_mask;
+    vp_control[2] = st->user_clip_plane_control;
+    vp_control[3] = 0;
+    float* vts = (float*)(dst + (RSX_MAX_VERTEX_CONSTANTS + 3u) * 16u);
+    for (u32 unit = 0; unit < RSX_MAX_VERTEX_TEXTURES; ++unit) {
+        float sx = 1.0f, sy = 1.0f, sz = 1.0f;
+        if (dr->vtex[unit].set && (dr->vtex[unit].fmt & 0x40u)) {
+            if (dr->vtex[unit].w) sx = 1.0f / (float)dr->vtex[unit].w;
+            if (dr->vtex[unit].h) sy = 1.0f / (float)dr->vtex[unit].h;
+            if (dr->vtex[unit].depth) sz = 1.0f / (float)dr->vtex[unit].depth;
+        }
+        vts[unit * 4u + 0u] = sx;
+        vts[unit * 4u + 1u] = sy;
+        vts[unit * 4u + 2u] = sz;
+        vts[unit * 4u + 3u] = 1.0f;
+    }
+    /* Never replace a title's matrix based on the sign of c[0][0]. Negative
+     * X scale is valid (Tokyo Jungle uses -0.974279/-0.855011 for several
+     * menu/world passes); the old c00>0 heuristic mislabeled those matrices
+     * as garbage and injected vkcube's hardcoded camera into real draws.
+     * Keep the old sample projection only as an explicit diagnostic opt-in. */
+    float* c = (float*)dst;
+    static _Thread_local int vp_fixproj_enabled = -1;
+    if (vp_fixproj_enabled < 0) vp_fixproj_enabled = getenv("VP_FIXPROJ") != NULL;
+    if (vp_fixproj_enabled) {
+        { static int _fb = 0; if (_fb++ < 6)
+            printf("[VPFB] forced diagnostic projection on draw slot %u (c00=%g vs_idx=%d)\n",
+                   slot, c[0], vs_idx); }
+        for (int _i = 0; _i < 16; _i++) c[_i] = 0.0f;
+        c[0]=1.358f; c[5]=2.414f; c[11]=1.0f;
+        c[10]=1.0f/99.0f; c[14]=-1.0f/99.0f;
+        vpx[2] = 1.0f; vpx[6] = 0.0f;
+    }
+}
+
+static void tj_indexed_diag_tconst_probe(unsigned tag, const rsx_state* st)
+{
+    static const char lanes[] = "xyzw";
+    if (!tag || !st || !st->tconst_probe_enabled) return;
+    for (unsigned slot_index = 0; slot_index < 4; ++slot_index) {
+        unsigned slot = slot_index + 4;
+        fprintf(stderr, "[TJ-TCONST#%u] c%u cur=[%.6g %.6g %.6g %.6g]", tag, slot,
+                st->vertex_constants[slot][0], st->vertex_constants[slot][1],
+                st->vertex_constants[slot][2], st->vertex_constants[slot][3]);
+        for (unsigned lane = 0; lane < 4; ++lane) {
+            u64 seq = st->tconst_probe_last_sequence[slot_index][lane];
+            if (!seq)
+                fprintf(stderr, " %c{seq=0 never}", lanes[lane]);
+            else
+                fprintf(stderr,
+                        " %c{seq=%llu raw=%08X load=%u slot=%u lane=%u}",
+                        lanes[lane], (unsigned long long)seq,
+                        st->tconst_probe_last_raw[slot_index][lane],
+                        st->tconst_probe_last_load[slot_index][lane],
+                        st->tconst_probe_last_slot[slot_index][lane],
+                        st->tconst_probe_last_lane[slot_index][lane]);
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+/* Tagged indexed-draw constant provenance: source guest state versus the
+ * exact per-draw CB slot consumed by replay. */
+static void tj_indexed_diag_record_cb(unsigned tag, u32 slot,
+                                      const D3D12DrawRecord* dr)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!tag || !st) return;
+    const float* src = &st->vertex_constants[0][0];
+    const float* cb = NULL;
+    const float* ep = NULL;
+    if (s_d3d.vp_cb_mapped && slot < MAX_DRAWS) {
+        cb = (const float*)((const char*)s_d3d.vp_cb_mapped
+            + ((u64)s_d3d.vp_parity * MAX_DRAWS + slot) * VP_CB_STRIDE);
+        ep = cb + RSX_MAX_VERTEX_CONSTANTS * 4;
+    }
+    int uses_c03 = dr && dr->vs_idx >= 0 && dr->vs_idx < s_d3d.vp_vs_n &&
+                   vp_vs_resolve(dr->vs_idx)
+        ? s_d3d.vp_vs[dr->vs_idx].uses_c03 : s_d3d.vp_uses_c03;
+    int fallback = cb && fabsf(cb[0] - 1.358f) < 0.0001f &&
+        fabsf(cb[5] - 2.414f) < 0.0001f && fabsf(cb[10] - (1.0f / 99.0f)) < 0.0001f &&
+        fabsf(cb[11] - 1.0f) < 0.0001f && fabsf(cb[14] + (1.0f / 99.0f)) < 0.0001f;
+    tj_indexed_diag_tconst_probe(tag, st);
+    fprintf(stderr,
+            "[TJ-IDX#%u] cb slot=%u uses_c03=%d fallback_sig=%d src_c0_3="
+            "[%.6g %.6g %.6g %.6g|%.6g %.6g %.6g %.6g|%.6g %.6g %.6g %.6g|%.6g %.6g %.6g %.6g]\n",
+            tag, slot, uses_c03, fallback,
+            src[0], src[1], src[2], src[3], src[4], src[5], src[6], src[7],
+            src[8], src[9], src[10], src[11], src[12], src[13], src[14], src[15]);
+    if (!cb) {
+        fprintf(stderr, "[TJ-IDX#%u] cb stored=unavailable\n", tag);
+        return;
+    }
+    fprintf(stderr,
+            "[TJ-IDX#%u] cb_c0_3=[%.6g %.6g %.6g %.6g|%.6g %.6g %.6g %.6g|"
+            "%.6g %.6g %.6g %.6g|%.6g %.6g %.6g %.6g] vp_scale=(%.6g,%.6g,%.6g,%.6g) "
+            "vp_offset=(%.6g,%.6g,%.6g,%.6g) ep_scale=(%.6g,%.6g,%.6g,%.6g) "
+            "ep_offset=(%.6g,%.6g,%.6g,%.6g)\n",
+            tag, cb[0], cb[1], cb[2], cb[3], cb[4], cb[5], cb[6], cb[7],
+            cb[8], cb[9], cb[10], cb[11], cb[12], cb[13], cb[14], cb[15],
+            st->viewport_scale[0], st->viewport_scale[1], st->viewport_scale[2], st->viewport_scale[3],
+            st->viewport_offset[0], st->viewport_offset[1], st->viewport_offset[2], st->viewport_offset[3],
+            ep[0], ep[1], ep[2], ep[3], ep[4], ep[5], ep[6], ep[7]);
+    /* The caller is already capped to eight indexed tags: keep matching live
+     * and stored provenance for c4..c12 on every one of those records. */
+    fprintf(stderr, "[TJ-IDX#%u] live_c4_12=", tag);
+    for (unsigned ci = 4; ci <= 12; ++ci)
+        fprintf(stderr, "%s[%.6g %.6g %.6g %.6g]", ci == 4 ? "" : "|",
+                src[ci * 4], src[ci * 4 + 1], src[ci * 4 + 2], src[ci * 4 + 3]);
+    fprintf(stderr, "\n[TJ-IDX#%u] cb_c4_12=", tag);
+    for (unsigned ci = 4; ci <= 12; ++ci)
+        fprintf(stderr, "%s[%.6g %.6g %.6g %.6g]", ci == 4 ? "" : "|",
+                cb[ci * 4], cb[ci * 4 + 1], cb[ci * 4 + 2], cb[ci * 4 + 3]);
+    fprintf(stderr, "\n");
+}
+
+/* Which offscreen surface (if any) does the current RSX state render to?
+ * (0, LOCAL) is a display/sentinel, while (0, MAIN) remains a valid RT.
+ * Surface identity is (raw, location): local and main offsets may numerically
+ * match without owning the same allocation. */
+static u32 current_rt_off(u32* out_w, u32* out_h, u32 out_mrt[3],
+                          u8* out_local, u8 out_mrt_local[3])
+{
+    extern int cellGcmOffsetIsDisplay(u32 offset);
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (out_w) *out_w = 0;
+    if (out_h) *out_h = 0;
+    if (out_mrt) out_mrt[0] = out_mrt[1] = out_mrt[2] = 0;
+    if (out_local) *out_local = 1;
+    if (out_mrt_local) out_mrt_local[0] = out_mrt_local[1] = out_mrt_local[2] = 1;
+    if (!st) return 0;
+    /* SET_SURFACE_COLOR_TARGET: 1 = A, 2 = B, 0x13 = MRT1 (A+B),
+     * 0x17 = MRT2 (A+B+C), 0x1F = MRT3 (A+B+C+D). */
+    int sel = (st->color_target == 2) ? 1 : 0;
+    u32 raw = st->surface_color_offset[sel];
+    u8 local = (u8)rsx_surface_dma_is_local(st->surface_color_dma[sel]);
+    if (out_local) *out_local = local;
+    if (out_mrt) {
+        if (st->color_target >= 0x13) out_mrt[0] = st->surface_color_offset[1];
+        if (st->color_target >= 0x17) out_mrt[1] = st->surface_color_offset[2];
+        if (st->color_target >= 0x1F) out_mrt[2] = st->surface_color_offset[3];
+    }
+    if (out_mrt_local) {
+        out_mrt_local[0] = (u8)rsx_surface_dma_is_local(st->surface_color_dma[1]);
+        out_mrt_local[1] = (u8)rsx_surface_dma_is_local(st->surface_color_dma[2]);
+        out_mrt_local[2] = (u8)rsx_surface_dma_is_local(st->surface_color_dma[3]);
+    }
+    static _Thread_local int rt_offdbg_enabled = -1;
+    if (rt_offdbg_enabled < 0) rt_offdbg_enabled = getenv("RT_OFFDBG") != NULL;
+    if (rt_offdbg_enabled) { static int _n=0; if (_n++ < 240)
+        fprintf(stderr, "[RTOFF] tgt=0x%X off[0]=0x%X off[1]=0x%X zeta=0x%X clip=%ux%u local=%u disp=%d -> 0x%X\n",
+                st->color_target, st->surface_color_offset[0], st->surface_color_offset[1],
+                st->surface_zeta_offset, st->surface_clip_w, st->surface_clip_h,
+                local, local && cellGcmOffsetIsDisplay(raw),
+                local && cellGcmOffsetIsDisplay(raw) ? 0 : raw); }
+    if (local && cellGcmOffsetIsDisplay(raw)) return 0;
+    /* Surface clip dims when sane; else the window size. Any size works --
+     * passes draw normalized full-surface quads -- this only picks resolution. */
+    u32 w = st->surface_clip_w, h = st->surface_clip_h;
+    if (w < 16 || w > 2048 || h < 16 || h > 2048) { w = 0; h = 0; }
+    if (out_w) *out_w = w;
+    if (out_h) *out_h = h;
+    return raw;
+}
+
+static void record_rt_registers(D3D12DrawRecord* dr)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!dr || !st) return;
+    dr->rt_target = st->color_target;
+    memcpy(dr->rt_raw, st->surface_color_offset, sizeof(dr->rt_raw));
+    memcpy(dr->rt_pitch, st->surface_color_pitch, sizeof(dr->rt_pitch));
+    for (u32 i = 0; i < 4; ++i)
+        dr->rt_raw_local[i] = (u8)rsx_surface_dma_is_local(st->surface_color_dma[i]);
+    dr->zeta_raw = st->surface_zeta_offset;
+    dr->zeta_pitch = st->surface_zeta_pitch;
+    dr->zeta_local = (u8)rsx_surface_dma_is_local(st->surface_zeta_dma);
+    dr->zeta_format = (u8)((st->surface_format >> 5) & 7u);
+    dr->rt_clip_x = st->surface_clip_x;
+    dr->rt_clip_y = st->surface_clip_y;
+    dr->rt_clip_w = st->surface_clip_w;
+    dr->rt_clip_h = st->surface_clip_h;
+    dr->rt_window_x = st->window_offset_x;
+    dr->rt_window_y = st->window_offset_y;
+    dr->scissor_x = st->scissor_x;
+    dr->scissor_y = st->scissor_y;
+    dr->scissor_w = st->scissor_w;
+    dr->scissor_h = st->scissor_h;
+    dr->vp_x = st->viewport_x;
+    dr->vp_y = st->viewport_y;
+    dr->vp_w = st->viewport_w;
+    dr->vp_h = st->viewport_h;
+    dr->clip_min = st->clip_min;
+    dr->clip_max = st->clip_max;
+    dr->depth_bounds_enable = st->depth_bounds_test_enable;
+    dr->depth_bounds_min = st->depth_bounds_min;
+    dr->depth_bounds_max = st->depth_bounds_max;
+    dr->fog_param0 = st->fog_param[0];
+    dr->fog_param1 = st->fog_param[1];
+    switch (st->fog_mode) {
+    case 0x2601u: dr->fog_mode = 1u; break; /* linear */
+    case 0x0800u: dr->fog_mode = 2u; break; /* exp */
+    case 0x0801u: dr->fog_mode = 3u; break; /* exp2 */
+    case 0x0802u: dr->fog_mode = 4u; break; /* exp abs */
+    case 0x0803u: dr->fog_mode = 5u; break; /* exp2 abs */
+    case 0x0804u: dr->fog_mode = 6u; break; /* linear abs */
+    default:      dr->fog_mode = 0u; break;
+    }
+    dr->fp_input_control = (st->texcoord_control_mask & 0x3FFu) |
+                           (st->two_side_light_enable ? 0x400u : 0u);
+    {
+        const int bottom_origin = ((st->shader_window >> 12) & 0xFu) == 1u;
+        const int integer_center = ((st->shader_window >> 16) & 0xFu) == 1u;
+        dr->wpos_scale_y = bottom_origin ? -1.0f : 1.0f;
+        dr->wpos_bias_x = integer_center ? -0.5f : 0.0f;
+        dr->wpos_bias_y = bottom_origin
+            ? (float)(st->shader_window & 0xFFFu) : 0.0f;
+        if (integer_center) dr->wpos_bias_y -= 0.5f;
+    }
+    {
+        const u32 color_format = st->surface_format & 0x1Fu;
+        const int integer_target = color_format != 0x0Bu &&
+                                   color_format != 0x0Cu &&
+                                   color_format != 0x0Du;
+        /* RSX cannot apply framebuffer sRGB packing to r-register (32-bit)
+         * exports or floating-point render targets. SET_SHADER_PACKER is a
+         * boolean register: any nonzero value enables it. */
+        dr->fp_srgb = st->shader_packer != 0 && !dr->fp_exp32 && integer_target;
+    }
+    dr->stencil_key = rsx_stencil_key(st);
+    dr->stencil_ref = (u8)(st->stencil_ref & 0xFFu);
+    dr->back_stencil_ref = (u8)(st->back_stencil_ref & 0xFFu);
+    dr->cull_key = rsx_cull_key(st);
+    dr->cmask = rsx_color_mask_d3d(st->color_mask);
+    dr->mrt_key = rsx_mrt_key(st);
+    dr->blend_color = st->blend_color;
+    dr->blend_color2 = st->blend_color2;
+    dr->logic_key = rsx_logic_key(st);
+    rsx_polygon_offset(st, dr->topology, &dr->depth_bias,
+                       &dr->slope_scaled_depth_bias);
+    { extern int cellGcmOffsetIsDisplay(u32 offset);
+      int active_surface = (st->color_target == 2) ? 1 : 0;
+      u32 raw = st->surface_color_offset[active_surface];
+      /* Capture the selected context-DMA at the common ownership point.
+       * Display-clear records begin zeroed and do not call current_rt_off(),
+       * so using their preexisting rt_local misclassified LOCAL displays. */
+      dr->rt_local = dr->rt_raw_local[active_surface];
+      dr->rt_is_display = dr->rt_local && cellGcmOffsetIsDisplay(raw);
+      dr->rt_display_raw = raw; }
+    /* TJ_RENDER_SCALE: decided here, before any surface exists, because the
+     * WPOS lane and the slope bias are baked into this record. Allocation
+     * applies the same identity rule. Slope is per host pixel. */
+    dr->raster_scale = rs_record_raster_scale(dr);
+    if (dr->raster_scale > 1)
+        dr->slope_scaled_depth_bias *= (float)dr->raster_scale;
+}
+
+/* BasicVertex fallback owns only its original untextured, single-RT contract.
+ * Capture every state value that its fixed PSO/replay can observe while the
+ * RSX record is still current; replay never reads current_rsx_state. */
+static void legacy_capture_state(D3D12DrawRecord* dr)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!dr || !st) return;
+    dr->legacy_state_captured = 1;
+    dr->blend = st->blend_enable;
+    dr->blend_key = rsx_blend_key(st, dr->blend);
+    dr->depth_key = rsx_depth_key(st);
+    dr->alpha_ctl = ((st->alpha_test_enable ? 1u : 0u) << 16)
+                  | ((st->alpha_func & 0xFFu) << 8)
+                  | (st->alpha_ref & 0xFFu);
+    dr->rt_off = current_rt_off(&dr->rt_w, &dr->rt_h, dr->rt_mrt,
+                                &dr->rt_local, dr->rt_mrt_local);
+    dr->rt_fmt = st->surface_format;
+    record_rt_registers(dr);
+    int have_mvp = 0;
+    for (u32 r = 0; r < 4; ++r)
+        for (u32 c = 0; c < 4; ++c) {
+            float v = st->vertex_constants[r][c];
+            dr->legacy_mvp[r * 4 + c] = v;
+            if (v != 0.0f) have_mvp = 1;
+        }
+    if (!have_mvp) {
+        memset(dr->legacy_mvp, 0, sizeof(dr->legacy_mvp));
+        dr->legacy_mvp[0] = dr->legacy_mvp[5] =
+        dr->legacy_mvp[10] = dr->legacy_mvp[15] = 1.0f;
+    }
+}
+
+/* RSX scissor is target-relative and independent from the viewport. Packed
+ * OffRT targets add their backing-resource origin after clamping to the
+ * logical target. */
+static D3D12_RECT draw_scissor_rect(const D3D12DrawRecord* dr,
+                                    u32 origin_x, u32 origin_y,
+                                    u32 target_w, u32 target_h)
+{
+    u32 x = dr ? dr->scissor_x : 0;
+    u32 y = dr ? dr->scissor_y : 0;
+    u32 w = dr ? dr->scissor_w : target_w;
+    u32 h = dr ? dr->scissor_h : target_h;
+    if (x > target_w) x = target_w;
+    if (y > target_h) y = target_h;
+    u64 right = (u64)x + w;
+    u64 bottom = (u64)y + h;
+    if (right > target_w) right = target_w;
+    if (bottom > target_h) bottom = target_h;
+    D3D12_RECT out = {
+        (LONG)(origin_x + x), (LONG)(origin_y + y),
+        (LONG)(origin_x + (u32)right), (LONG)(origin_y + (u32)bottom)};
+    return out;
+}
+
+/* CLEAR_SURFACE ignores the viewport, but not the logical surface/scissor.
+ * A backing may also contain other packed targets; never clear those pixels. */
+static int draw_clear_rect(const D3D12DrawRecord* dr,
+                           u32 origin_x, u32 origin_y, u32 backing_w, u32 backing_h,
+                           D3D12_RECT* out)
+{
+    if (!dr || !out || origin_x >= backing_w || origin_y >= backing_h) return 0;
+    u32 w = dr->rt_w ? dr->rt_w : backing_w - origin_x;
+    u32 h = dr->rt_h ? dr->rt_h : backing_h - origin_y;
+    if (w > backing_w - origin_x) w = backing_w - origin_x;
+    if (h > backing_h - origin_y) h = backing_h - origin_y;
+    *out = draw_scissor_rect(dr, origin_x, origin_y, w, h);
+    return out->right > out->left && out->bottom > out->top;
+}
+
+/* 0=no pixels, 1=native clear, 2=draw clear (caller must restore draw state),
+ * -1=failure. The all-channel fast path still uses the exact same rectangle.
+ * backing/origin and *out stay logical (guest) for coverage; TJ_RENDER_SCALE
+ * multiplies only the copy handed to D3D12 by the target's host scale. */
+static int clear_color_target(const D3D12DrawRecord* dr,
+                               D3D12_CPU_DESCRIPTOR_HANDLE rtv, DXGI_FORMAT format,
+                               u32 backing_w, u32 backing_h, u32 origin_x, u32 origin_y,
+                               u32 scale, D3D12_RECT* out)
+{
+    u8 mask = (u8)((dr->clear_flags & RSX_CLEAR_COLOR_MASK) >> 4);
+    if (!mask || !draw_clear_rect(dr, origin_x, origin_y, backing_w, backing_h, out))
+        return 0;
+    const u32 factor = scale > 1 ? scale : 1u;
+    D3D12_RECT host = *out;
+    rs_scale_rect(&host, factor);
+    if (mask == 15) {
+        s_d3d.cmd_list->lpVtbl->ClearRenderTargetView(
+            s_d3d.cmd_list, rtv, dr->cc, 1, &host);
+        return 1;
+    }
+    return rsx_d3d12_masked_clear(s_d3d.device, s_d3d.cmd_list, rtv, format,
+        backing_w * factor, backing_h * factor, &host, dr->cc, mask) == 0 ? 2 : -1;
+}
+
+static void draw_viewport_depth(const D3D12DrawRecord* dr, D3D12_VIEWPORT* vp);
+
+/* RSX and this backend both address render targets from their top-left edge,
+ * so D3D12 takes the recorded y/height without a vertical flip. A zero-sized
+ * guest viewport is the established full-target default. Preserve nonzero
+ * width/height; the independent scissor and render-target clip own far-edge
+ * clipping. */
+static D3D12_VIEWPORT draw_viewport_rect(const D3D12DrawRecord* dr,
+                                         u32 origin_x, u32 origin_y,
+                                         u32 target_w, u32 target_h)
+{
+    u32 x = dr ? dr->vp_x : 0;
+    u32 y = dr ? dr->vp_y : 0;
+    u32 w = dr ? dr->vp_w : 0;
+    u32 h = dr ? dr->vp_h : 0;
+    if (!w || !h) { x = 0; y = 0; w = target_w; h = target_h; }
+    D3D12_VIEWPORT out = {
+        (float)(origin_x + x), (float)(origin_y + y),
+        (float)w, (float)h, 0.0f, 1.0f};
+    draw_viewport_depth(dr, &out);
+    return out;
+}
+
+static void draw_viewport_depth(const D3D12DrawRecord* dr, D3D12_VIEWPORT* vp)
+{
+    if (!dr || !vp) return;
+    float zmin = dr->clip_min;
+    float zmax = dr->clip_max;
+    if (!isfinite(zmin)) zmin = 0.0f;
+    if (!isfinite(zmax)) zmax = 1.0f;
+    if (zmin < 0.0f) zmin = 0.0f;
+    if (zmin > 1.0f) zmin = 1.0f;
+    if (zmax < 0.0f) zmax = 0.0f;
+    if (zmax > 1.0f) zmax = 1.0f;
+    if (zmax < zmin) { float t = zmin; zmin = zmax; zmax = t; }
+    vp->MinDepth = zmin;
+    vp->MaxDepth = zmax;
+}
+
+/* RSX surface colour format (SET_SURFACE_FORMAT bits [4:0]) -> DXGI. Float
+ * targets matter: wave's water height maps store SIGNED values (F_W16..),
+ * demosaic's differential planes likewise -- RGBA8 clamps them to zero. */
+static DXGI_FORMAT rsx_surface_dxgi(u32 fmt)
+{
+    switch (fmt & 0x1F) {
+    case 0x01: /* X1R5G5B5_Z1R5G5B5 */
+    case 0x02: return DXGI_FORMAT_B5G5R5A1_UNORM; /* X1R5G5B5_O1R5G5B5 */
+    case 0x03: return DXGI_FORMAT_B5G6R5_UNORM;   /* R5G6B5 */
+    case 0x09: return DXGI_FORMAT_R8_UNORM;       /* B8 */
+    case 0x0A: return DXGI_FORMAT_R8G8_UNORM;     /* G8B8 */
+    case 0x0B: return DXGI_FORMAT_R16G16B16A16_FLOAT; /* F_W16Z16Y16X16 */
+    case 0x0C: return DXGI_FORMAT_R32G32B32A32_FLOAT; /* F_W32Z32Y32X32 */
+    case 0x0D: return DXGI_FORMAT_R32_FLOAT;          /* F_X32          */
+    default:   return DXGI_FORMAT_R8G8B8A8_UNORM;
+    }
+}
+
+/* Existing BasicVertex PSOs are fixed: RGBA8, untextured, one colour target,
+ * depth LESS_EQUAL/write, no blend/stencil/logic/cull/alpha/bounds/bias
+ * specialization. Do not approximate a later RSX state through this old path. */
+static int legacy_record_supported(const D3D12DrawRecord* dr)
+{
+    const u32 legacy_depth = 1u | 2u | (0x0203u << 8);
+    if (!dr || dr->is_vp || dr->is_clear || dr->is_scaled_blit ||
+        !dr->legacy_state_captured || !dr->vertex_count || dr->textured ||
+        dr_rt_attachment_enabled(dr, 1) || dr_rt_attachment_enabled(dr, 2) ||
+        dr_rt_attachment_enabled(dr, 3) ||
+        rsx_surface_dxgi(dr->rt_fmt) != DXGI_FORMAT_R8G8B8A8_UNORM ||
+        dr->blend_key || dr->cmask != 0xFu || dr->logic_key ||
+        dr->stencil_key || dr->depth_key != legacy_depth ||
+        (dr->alpha_ctl & (1u << 16)) || dr->depth_bounds_enable ||
+        dr->depth_bias || dr->slope_scaled_depth_bias != 0.0f ||
+        dr->zeta_pitch || dr->depth_slot || (dr->cull_key & 0x67u) ||
+        !s_d3d.root_signature || !s_d3d.vb_view.BufferLocation)
+        return 0;
+    switch (vp_topology_type(dr->topology)) {
+    case D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE:
+        if (!s_d3d.pipeline_state) return 0;
+        break;
+    case D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE:
+        if (!s_d3d.pipeline_state_lines) return 0;
+        break;
+    case D3D12_PRIMITIVE_TOPOLOGY_TYPE_POINT:
+        if (!s_d3d.pipeline_state_points) return 0;
+        break;
+    default:
+        return 0;
+    }
+    for (u32 u = 0; u < RSX_MAX_TEXTURES; ++u)
+        if (dr->tex[u].set) return 0;
+    for (u32 u = 0; u < RSX_MAX_VERTEX_TEXTURES; ++u)
+        if (dr->vtex[u].set) return 0;
+    return 1;
+}
+
+/* Convert one guest surface row into the normalized host RT representation.
+ * Guest words are big-endian. X alpha variants force their documented zero
+ * or one instead of preserving undefined guest bits. */
+static void rsx_surface_upload_row(u8* dst, const u8* src, u32 pixels, u32 fmt)
+{
+    fmt &= 0x1Fu;
+    for (u32 x = 0; x < pixels; ++x) {
+        switch (fmt) {
+        case 0x01: /* X1R5G5B5_Z1R5G5B5 */
+        case 0x02: { /* X1R5G5B5_O1R5G5B5 */
+            u16 v = vp_tex_be16(src + x * 2u);
+            v = (u16)((v & 0x7FFFu) | (fmt == 0x02 ? 0x8000u : 0u));
+            vp_tex_store_u16(dst + x * 2u, v);
+            break;
+        }
+        case 0x03: /* R5G6B5 */
+            vp_tex_store_u16(dst + x * 2u, vp_tex_be16(src + x * 2u));
+            break;
+        case 0x04: /* X8R8G8B8_Z8R8G8B8 */
+        case 0x05: /* X8R8G8B8_O8R8G8B8 */
+        case 0x08: { /* A8R8G8B8 */
+            const u8* s = src + x * 4u;
+            u8* d = dst + x * 4u;
+            d[0] = s[1]; d[1] = s[2]; d[2] = s[3];
+            d[3] = fmt == 0x04 ? 0 : fmt == 0x05 ? 255 : s[0];
+            break;
+        }
+        case 0x09: /* B8 */
+            dst[x] = src[x];
+            break;
+        case 0x0A: /* G8B8 */
+            vp_tex_store_u16(dst + x * 2u, vp_tex_be16(src + x * 2u));
+            break;
+        case 0x0B: /* F_W16Z16Y16X16 */
+            for (u32 lane = 0; lane < 4; ++lane)
+                vp_tex_store_u16(dst + x * 8u + lane * 2u,
+                                 vp_tex_be16(src + x * 8u + lane * 2u));
+            break;
+        case 0x0C: /* F_W32Z32Y32X32 */
+            for (u32 lane = 0; lane < 4; ++lane)
+                vp_tex_store_u32(dst + x * 16u + lane * 4u,
+                                 vp_tex_be32(src + x * 16u + lane * 4u));
+            break;
+        case 0x0D: /* F_X32 */
+            vp_tex_store_u32(dst + x * 4u, vp_tex_be32(src + x * 4u));
+            break;
+        case 0x0E: /* X8B8G8R8_Z8B8G8R8 */
+        case 0x0F: /* X8B8G8R8_O8B8G8R8 */
+        case 0x10: { /* A8B8G8R8 */
+            const u8* s = src + x * 4u;
+            u8* d = dst + x * 4u;
+            d[0] = s[3]; d[1] = s[2]; d[2] = s[1];
+            d[3] = fmt == 0x0E ? 0 : fmt == 0x0F ? 255 : s[0];
+            break;
+        }
+        default:
+            break;
+        }
+    }
+}
+
+static u32 dxgi_bytes_per_pixel(DXGI_FORMAT fmt)
+{
+    switch (fmt) {
+    case DXGI_FORMAT_R8_UNORM:              return 1;
+    case DXGI_FORMAT_R8G8_UNORM:
+    case DXGI_FORMAT_B5G5R5A1_UNORM:
+    case DXGI_FORMAT_B5G6R5_UNORM:          return 2;
+    case DXGI_FORMAT_R16G16B16A16_FLOAT: return 8;
+    case DXGI_FORMAT_R32G32B32A32_FLOAT: return 16;
+    case DXGI_FORMAT_R32_FLOAT:          return 4;
+    default:                              return 4;
+    }
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE depth_dsv_handle(u8 descriptor)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h = {0};
+    s_d3d.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(
+        s_d3d.dsv_heap, &h);
+    h.ptr += (u64)descriptor * s_d3d.dsv_inc;
+    return h;
+}
+
+static void depth_surface_extent(const D3D12DrawRecord* dr, u32 fallback_w,
+                                 u32 fallback_h, u32* out_w, u32* out_h)
+{
+    /* current_rt_off collapses registered colour displays to a sentinel and
+     * drops their dimensions. Zeta has its own allocation: a shadow pass can
+     * bind an unused display colour address with a 1024x1024 depth surface.
+     * A viewport does not enlarge an explicitly clipped surface. */
+    u32 bpp = dr->zeta_format == 1 ? 2u : 4u;
+    u32 logical_w = dr->rt_clip_w ? dr->rt_clip_w : dr->rt_w;
+    u32 logical_h = dr->rt_clip_h ? dr->rt_clip_h : dr->rt_h;
+    u32 w = logical_w ? logical_w : fallback_w;
+    u32 h = logical_h ? logical_h : fallback_h;
+    u32 pitch_w = dr->zeta_pitch % bpp ? 0 : dr->zeta_pitch / bpp;
+    if (pitch_w > w) w = pitch_w;
+    u64 clip_right = (u64)dr->rt_clip_x + logical_w;
+    u64 clip_bottom = (u64)dr->rt_clip_y + logical_h;
+    u64 window_right = (u64)dr->rt_window_x + logical_w;
+    u64 window_bottom = (u64)dr->rt_window_y + logical_h;
+    u64 vp_right = (u64)dr->vp_x + dr->vp_w;
+    u64 vp_bottom = (u64)dr->vp_y + dr->vp_h;
+    if (clip_right > w) w = clip_right > UINT32_MAX ? UINT32_MAX : (u32)clip_right;
+    if (clip_bottom > h) h = clip_bottom > UINT32_MAX ? UINT32_MAX : (u32)clip_bottom;
+    if (window_right > w) w = window_right > UINT32_MAX ? UINT32_MAX : (u32)window_right;
+    if (window_bottom > h) h = window_bottom > UINT32_MAX ? UINT32_MAX : (u32)window_bottom;
+    if (!dr->rt_clip_w && vp_right > w)
+        w = vp_right > UINT32_MAX ? UINT32_MAX : (u32)vp_right;
+    if (!dr->rt_clip_h && vp_bottom > h)
+        h = vp_bottom > UINT32_MAX ? UINT32_MAX : (u32)vp_bottom;
+    if (!w) w = 1;
+    if (!h) h = 1;
+    *out_w = w; *out_h = h;
+}
+
+static u8 depth_surface_get(const D3D12DrawRecord* dr)
+{
+    if (!dr || !dr->zeta_pitch) return 0;
+    u32 w, h;
+    depth_surface_extent(dr, s_d3d.width, s_d3d.height, &w, &h);
+    if (w > 8192 || h > 8192) {
+        static unsigned invalid_logs = 0;
+        if (invalid_logs++ < 8)
+            fprintf(stderr, "[D3D12] reject zeta extent raw=%08X pitch=%u size=%ux%u\n",
+                    dr->zeta_raw, dr->zeta_pitch, w, h);
+        return 0;
+    }
+
+    int slot = -1;
+    for (int i = 0; i < MAX_DEPTH_SURFACES; i++)
+        if (s_d3d.depth_surface[i].valid &&
+            s_d3d.depth_surface[i].raw == dr->zeta_raw &&
+            s_d3d.depth_surface[i].local == dr->zeta_local &&
+            s_d3d.depth_surface[i].pitch == dr->zeta_pitch &&
+            s_d3d.depth_surface[i].format == dr->zeta_format) {
+            slot = i;
+            break;
+        }
+    if (slot >= 0 && s_d3d.depth_surface[slot].w >= w &&
+        s_d3d.depth_surface[slot].h >= h)
+        return (u8)(slot + 1);
+    if (slot < 0)
+        for (int i = 0; i < MAX_DEPTH_SURFACES; i++)
+            if (!s_d3d.depth_surface[i].valid) { slot = i; break; }
+    if (slot < 0) {
+        static unsigned full_logs = 0;
+        if (full_logs++ < 8) fprintf(stderr, "[D3D12] zeta surface pool full\n");
+        return 0;
+    }
+
+    DepthSurface* ds = &s_d3d.depth_surface[slot];
+    /* A grow must retain coverage on both axes. Alternating wide/short and
+     * narrow/tall views otherwise recreate this identity on every switch,
+     * losing its initialized depth and sample ownership each time. */
+    if (ds->valid) {
+        if (ds->w > w || ds->h > h) {
+            if (s_tj_gcm2d_backend_perf_sample)
+                ++s_tj_gcm2d_backend_perf_sample->depth_extent_preserves;
+            if (tj_gcm2d_backend_perf_enabled()) {
+                static unsigned extent_logs = 0;
+                if (extent_logs++ < 16)
+                    fprintf(stderr, "[TJ-DEPTH-EXTENT] raw=%08X local=%u pitch=%u "
+                            "old=%ux%u requested=%ux%u retained=%ux%u\n",
+                            dr->zeta_raw, dr->zeta_local, dr->zeta_pitch,
+                            ds->w, ds->h, w, h,
+                            ds->w > w ? ds->w : w, ds->h > h ? ds->h : h);
+            }
+        }
+        if (ds->w > w) w = ds->w;
+        if (ds->h > h) h = ds->h;
+    }
+    /* TJ_RENDER_SCALE: an existing identity keeps its scale through this
+     * grow (the memset below clears it); a new identity takes the canonical
+     * rule record_rt_registers used. w/h stay guest; the desc is w/h x scale. */
+    const u32 scale = ds->valid ? rs_factor(ds->scale)
+        : rs_zeta_identity_scale(dr->zeta_local, dr->zeta_pitch, dr->zeta_format);
+    if (scale > 1 && ((u64)w * scale > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+                      (u64)h * scale > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION)) {
+        static unsigned host_logs = 0;
+        if (host_logs++ < 8)
+            fprintf(stderr, "[tj-scale] reject zeta host extent raw=%08X %ux%u x%u\n",
+                    dr->zeta_raw, w, h, scale);
+        return 0;
+    }
+    rsx_d3d12_depth_sample_release(&ds->sample);
+    if (ds->res) ds->res->lpVtbl->Release(ds->res);
+    memset(ds, 0, sizeof(*ds));
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0};
+    DXGI_FORMAT dsvfmt = dr->zeta_format == 1
+        ? DXGI_FORMAT_D16_UNORM : DXGI_FORMAT_D24_UNORM_S8_UINT;
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = (u64)w * scale;
+    rd.Height = h * scale;
+    rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1;
+    rd.Format = dr->zeta_format == 1 ? dsvfmt : DXGI_FORMAT_R24G8_TYPELESS;
+    rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = dsvfmt;
+    cv.DepthStencil.Depth = 1.0f;
+    if (s_tj_gcm2d_backend_perf_sample)
+        ++s_tj_gcm2d_backend_perf_sample->depth_allocations;
+    HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(
+        s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+        D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv,
+        &IID_ID3D12Resource, (void**)&ds->res);
+    if (FAILED(hr) || !ds->res) {
+        memset(ds, 0, sizeof(*ds));
+        return 0;
+    }
+    ds->raw = dr->zeta_raw;
+    ds->local = dr->zeta_local;
+    ds->pitch = dr->zeta_pitch;
+    ds->w = w;
+    ds->h = h;
+    ds->format = dr->zeta_format;
+    ds->scale = (u8)scale;
+    ds->valid = 1;
+    ds->sample_dirty = 1;
+    D3D12_DEPTH_STENCIL_VIEW_DESC vd = {0};
+    vd.Format = dsvfmt;
+    vd.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+    D3D12_CPU_DESCRIPTOR_HANDLE vh = depth_dsv_handle((u8)(slot + 1));
+    d3d12_owned_dsv(ds->res, &vd, vh);
+    return (u8)(slot + 1);
+}
+
+static int depth_surface_texture_find(const D3D12DrawRecord* dr, int unit,
+                                      u32 record)
+{
+    /* A packed linear colour view of the exact D24S8 allocation. Cropped,
+     * swizzled, mipmapped, differently pitched and other-format aliases keep
+     * their existing routes; do not select a coincidental future producer. */
+    int packed_view = (dr->tex[unit].fmt & 0xBFu) == 0xA5u && dr->tex[unit].mips <= 1;
+    for (int i = 0; i < MAX_DEPTH_SURFACES; ++i) {
+        const DepthSurface* ds = &s_d3d.depth_surface[i];
+        if (packed_view && ds->valid && ds->format == 2 && ds->res &&
+            ds->raw == dr->tex[unit].raw &&
+            ds->local == (dr->tex[unit].location == 1u) &&
+            ds->pitch == dr->tex[unit].pitch &&
+            ds->w == dr->tex[unit].w && ds->h == dr->tex[unit].h &&
+            (ds->initialized || (ds->first_write_record_plus_one &&
+                                ds->first_write_record_plus_one <= record)))
+            return i;
+    }
+    /* Bounded diagnosis for exact-address aliases rejected by format/shape or
+     * ownership. Needed to distinguish an unsupported view from a lost pass. */
+    if (tj_indexed_diag_enabled() && dr->fp_addr == 0x07600741u) {
+        static unsigned logs = 0;
+        if (unit == 0 && logs++ < 2) {
+            fprintf(stderr, "[D3D12] depth texture unresolved raw=%08X pitch=%u size=%ux%u mips=%u\n",
+                    dr->tex[unit].raw, dr->tex[unit].pitch,
+                    dr->tex[unit].w, dr->tex[unit].h, dr->tex[unit].mips);
+            for (int i = 0; i < MAX_DEPTH_SURFACES; ++i) {
+                const DepthSurface* ds = &s_d3d.depth_surface[i];
+                if (ds->valid && ds->raw == dr->tex[unit].raw)
+                    fprintf(stderr, "[D3D12] depth candidate slot=%d local=%u fmt=%u pitch=%u size=%ux%u initialized=%d first_write=%u record=%u\n",
+                            i, ds->local, ds->format, ds->pitch, ds->w, ds->h,
+                            ds->initialized, ds->first_write_record_plus_one, record);
+            }
+        }
+    }
+    return -1;
+}
+
+static DXGI_FORMAT rsx_tex_off_rt_dxgi(u32 base_fmt)
+{
+    switch (base_fmt & 0x9F) {
+    case 0x81: return DXGI_FORMAT_R8_UNORM;             /* B8 */
+    case 0x82: /* A1R5G5B5 */
+    case 0x9D: return DXGI_FORMAT_B5G5R5A1_UNORM;       /* D1R5G5B5 */
+    case 0x84: return DXGI_FORMAT_B5G6R5_UNORM;         /* R5G6B5 */
+    case 0x85: return DXGI_FORMAT_R8G8B8A8_UNORM;       /* A8R8G8B8 */
+    case 0x9E: return DXGI_FORMAT_R8G8B8A8_UNORM;       /* D8R8G8B8 */
+    case 0x8B: return DXGI_FORMAT_R8G8_UNORM;            /* G8B8 */
+    case 0x9A: return DXGI_FORMAT_R16G16B16A16_FLOAT;   /* W16Z16Y16X16 */
+    case 0x9B: return DXGI_FORMAT_R32G32B32A32_FLOAT;   /* W32Z32Y32X32 */
+    case 0x9C: return DXGI_FORMAT_R32_FLOAT;            /* X32 */
+    default:   return DXGI_FORMAT_UNKNOWN;
+    }
+}
+
+/* A bound tile proves that an offset is part of one physical local-memory
+ * allocation. Return tile-relative pixels; producer placement adds its RSX
+ * window offset to this raw-address placement. */
+static u32 off_rt_tile_canonical(u32 raw, u32 pitch, u32 bpp, u64 span,
+                                 u32* out_x, u32* out_y)
+{
+    if (out_x) *out_x = 0;
+    if (out_y) *out_y = 0;
+    if (!raw || !pitch || !bpp || !span) return raw;
+    for (u32 i = 0; i < CELL_GCM_MAX_TILE_COUNT; i++) {
+        const CellGcmTileInfo* tile = cellGcmGetTileInfo((u8)i);
+        if (!tile || !tile->bound || tile->pitch != pitch || !tile->size ||
+            pitch % bpp)
+            continue;
+        u64 begin = tile->offset;
+        u64 end = begin + tile->size;
+        u64 start = raw;
+        if (start < begin || start + span > end)
+            continue;
+        u64 delta = start - begin;
+        if (delta % bpp) continue;
+        if (out_x) *out_x = (u32)((delta % pitch) / bpp);
+        if (out_y) *out_y = (u32)(delta / pitch);
+        return tile->offset;
+    }
+    return raw;
+}
+
+static u32 off_rt_sat_add(u32 a, u32 b)
+{
+    return a > 0xFFFFFFFFu - b ? 0xFFFFFFFFu : a + b;
+}
+
+/* Surface offsets select a tile-relative rectangle; WINDOW_OFFSET adds a
+ * second placement. Keep both terms for allocation, clear, and raster state. */
+static void off_rt_target_origin(const D3D12DrawRecord* dr, u32 raw, u8 local,
+                                 u32* out_x, u32* out_y)
+{
+    u32 base_x = 0, base_y = 0, pitch = 0;
+    u32 window_x = dr ? dr->rt_window_x : 0;
+    u32 window_y = dr ? dr->rt_window_y : 0;
+    if (dr && raw && local) {
+        for (int i = 0; i < 4; i++)
+            if (dr->rt_raw[i] == raw && dr->rt_raw_local[i] == local &&
+                dr->rt_pitch[i]) {
+                pitch = dr->rt_pitch[i];
+                break;
+            }
+        u32 bpp = dxgi_bytes_per_pixel(rsx_surface_dxgi(dr->rt_fmt));
+        u64 span = dr->rt_w && dr->rt_h
+                 ? (u64)(dr->rt_h - 1) * pitch + (u64)dr->rt_w * bpp : 0;
+        off_rt_tile_canonical(raw, pitch, bpp, span, &base_x, &base_y);
+    }
+    if (out_x) *out_x = off_rt_sat_add(base_x, window_x);
+    if (out_y) *out_y = off_rt_sat_add(base_y, window_y);
+}
+
+static int off_rt_draw_has_mrt_alias(int primary, const int mrt[3])
+{
+    for (int m = 0; m < 3 && mrt[m] >= 0; m++) {
+        if (primary >= 0 && mrt[m] == primary) return 1;
+        for (int earlier = 0; earlier < m; earlier++)
+            if (mrt[m] == mrt[earlier]) return 1;
+    }
+    return 0;
+}
+
+static int off_rt_find(u32 off, u8 local)
+{
+    if (!rt_identity_is_offscreen(off, local)) return -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++)
+        if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == off &&
+            s_d3d.off_rt[i].local == local) return i;
+    if (!local) return -1; /* TILE binding is a local-memory address relation. */
+    int in_tile = -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        /* Tile canonicalization returns the raw address or a base at/below it. */
+        if (r->off > off || !r->res || !r->local) continue;
+        if (in_tile < 0) {
+            /* A canonical match needs a bound tile containing off. Without
+             * one, canonical()==off for every entry and loop 1 already
+             * rejected an exact match, so nothing below can match. */
+            in_tile = 0;
+            for (u32 t = 0; t < CELL_GCM_MAX_TILE_COUNT; t++) {
+                const CellGcmTileInfo* tile = cellGcmGetTileInfo((u8)t);
+                if (tile && tile->bound && tile->size && (u64)off >= tile->offset &&
+                    (u64)off < (u64)tile->offset + tile->size) { in_tile = 1; break; }
+            }
+            if (!in_tile) return -1;
+        }
+        u32 bpp = dxgi_bytes_per_pixel((DXGI_FORMAT)r->dxgi);
+        if (off_rt_tile_canonical(off, r->raw_pitch, bpp, bpp, NULL, NULL) == r->off)
+            return i;
+    }
+    return -1;
+}
+
+/* Ensure an RT resource exists for this surface; (re)creates the RTV at
+ * rt_rtv_heap[i] and the SRV at srv_heap[RT_SRV_BASE+i]. */
+static int off_rt_get(u32 off, u8 local, u32 logical_w, u32 logical_h,
+                      u32 required_w, u32 required_h,
+                      u32 rsx_fmt, u32 raw_pitch)
+{
+    if (!rt_identity_is_offscreen(off, local) ||
+        !s_d3d.rt_rtv_heap || !s_d3d.srv_heap) return -1;
+    if (!logical_w) logical_w = s_d3d.width;
+    if (!logical_h) logical_h = s_d3d.height;
+    DXGI_FORMAT want_fmt = rsx_surface_dxgi(rsx_fmt);
+    u32 bpp = dxgi_bytes_per_pixel(want_fmt);
+    /* Surface pitches are byte strides. Keep malformed/non-pixel-aligned
+     * pitches recorded, but do not let one create a row we cannot address. */
+    u32 usable_pitch = raw_pitch;
+    if (!usable_pitch || usable_pitch % bpp || usable_pitch / bpp < logical_w)
+        usable_pitch = logical_w * bpp;
+    u32 physical_w = usable_pitch / bpp;
+    if (physical_w < required_w) physical_w = required_w;
+    u32 physical_h = required_h > logical_h ? required_h : logical_h;
+    int slot = off_rt_find(off, local);
+    if (slot >= 0) {
+        OffRT* r = &s_d3d.off_rt[slot];
+        /* One RSX allocation is commonly reused as a viewport-sized mip chain
+         * (Tokyo Jungle: E300000 at 640x360, 320x180, ...).  The D3D texture
+         * must represent the largest view.  Shrinking/recreating it for each
+         * draw releases resources already referenced by this command list and
+         * produces a GPU page fault when the queued CopyTextureRegion runs. */
+        if (r->w >= physical_w && r->h >= physical_h &&
+            r->dxgi == (u32)want_fmt && r->rsx_fmt == (u8)(rsx_fmt & 0x1Fu)) {
+            if (r->logical_w < logical_w) r->logical_w = logical_w;
+            if (r->logical_h < logical_h) r->logical_h = logical_h;
+            if (r->raw_pitch < usable_pitch) r->raw_pitch = usable_pitch;
+            r->used = 1;
+            return slot;
+        }
+        /* A real grow/format change can only release the previous resource
+         * after earlier submitted frames are finished. */
+        if (wait_for_gpu_checked_at(RSX_COMPLETION_RESOURCE_RELEASE) != 0) {
+            gcm2d_backend_halt("offscreen resource release fence");
+            return -1;
+        }
+        r->res->lpVtbl->Release(r->res); r->res = NULL;   /* dims/format changed */
+        if (r->sample) { r->sample->lpVtbl->Release(r->sample); r->sample = NULL; }
+        if (r->up) { r->up->lpVtbl->Release(r->up); r->up = NULL; }
+    } else {
+        for (int i = 0; i < MAX_OFF_RTS; i++)
+            if (!s_d3d.off_rt[i].res) { slot = i; break; }
+        if (slot < 0) {   /* evict an entry not used this frame */
+            for (int i = 0; i < MAX_OFF_RTS; i++)
+                if (!s_d3d.off_rt[i].used) { slot = i; break; }
+            if (slot < 0) return -1;
+            s_d3d.off_rt[slot].res->lpVtbl->Release(s_d3d.off_rt[slot].res);
+            s_d3d.off_rt[slot].res = NULL;
+            if (s_d3d.off_rt[slot].sample) {
+                s_d3d.off_rt[slot].sample->lpVtbl->Release(s_d3d.off_rt[slot].sample);
+                s_d3d.off_rt[slot].sample = NULL;
+            }
+            if (s_d3d.off_rt[slot].up) {
+                s_d3d.off_rt[slot].up->lpVtbl->Release(s_d3d.off_rt[slot].up);
+                s_d3d.off_rt[slot].up = NULL;
+            }
+        }
+    }
+    OffRT* r = &s_d3d.off_rt[slot];
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = physical_w; td.Height = physical_h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = want_fmt; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = td.Format;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, &cv,
+            &IID_ID3D12Resource, (void**)&r->res)))
+        return -1;
+    r->off = off; r->w = physical_w; r->h = physical_h;
+    r->local = local;
+    r->logical_w = logical_w; r->logical_h = logical_h;
+    r->raw_pitch = usable_pitch;
+    r->dxgi = (u32)want_fmt;
+    r->rsx_fmt = (u8)(rsx_fmt & 0x1Fu);
+    r->st = D3D12_RESOURCE_STATE_COPY_DEST;
+    r->used = 1;
+
+    /* Populate the new RT from guest memory: titles CPU-initialise their
+     * render-target buffers (wave fills the height fields with texels of
+     * (0,0,0, 1.0f) -- the .w is 'inverse of mass'; from an all-zero GPU
+     * resource the water simulation can never boot). Guest data is
+     * big-endian and tightly packed. */
+    {
+        extern uint8_t* vm_base;
+        u32 pitch = (physical_w * bpp + 255) & ~255u;
+        u32 src;
+        int src_resolved = cellGcmResolveLocatedChecked(local, off, &src);
+        if (vm_base && src_resolved) {
+            extern u32 ppu_vm_size;
+            u32 source_w = usable_pitch / bpp;
+            u32 source_h = logical_h;
+            if (source_w > physical_w) source_w = physical_w;
+            if (source_h > physical_h) source_h = physical_h;
+            const u64 source_bytes = source_h
+                ? (u64)(source_h - 1u) * usable_pitch + (u64)source_w * bpp : 0;
+            const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ULL << 32);
+            if (source_bytes > vm_cap || (u64)src > vm_cap - source_bytes)
+                return -1;
+            D3D12_HEAP_PROPERTIES hu = {0}; hu.Type = D3D12_HEAP_TYPE_UPLOAD;
+            D3D12_RESOURCE_DESC bd = {0};
+            bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            bd.Width = (u64)pitch * physical_h; bd.Height = 1; bd.DepthOrArraySize = 1;
+            bd.MipLevels = 1; bd.SampleDesc.Count = 1;
+            bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(
+                    s_d3d.device, &hu, D3D12_HEAP_FLAG_NONE, &bd,
+                    D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                    &IID_ID3D12Resource, (void**)&r->up))) {
+                void* mp = NULL; D3D12_RANGE nr = {0,0};
+                if (d3d12_prefix_owner_object_mutable(r->up) != 0) return -1;
+                if (SUCCEEDED(r->up->lpVtbl->Map(r->up, 0, &nr, &mp)) && mp) {
+                    const u8* sp = vm_base + src;
+                    /* A clip origin can make the backing wider than its raw
+                     * row stride. Clear padding first; never read past one
+                     * guest row while initializing the larger D3D texture. */
+                    memset(mp, 0, (size_t)((u64)pitch * physical_h));
+                    for (u32 y = 0; y < source_h; y++) {
+                        const u8* srow = sp + (u64)y * usable_pitch;
+                        u8* drow = (u8*)mp + (u64)y * pitch;
+                        rsx_surface_upload_row(drow, srow, source_w, rsx_fmt);
+                    }
+                    r->up->lpVtbl->Unmap(r->up, 0, NULL);
+                    D3D12_TEXTURE_COPY_LOCATION cdst = {0}, csrc = {0};
+                    cdst.pResource = r->res;
+                    cdst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+                    csrc.pResource = r->up;
+                    csrc.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+                    csrc.PlacedFootprint.Footprint.Format   = want_fmt;
+                    csrc.PlacedFootprint.Footprint.Width    = physical_w;
+                    csrc.PlacedFootprint.Footprint.Height   = physical_h;
+                    csrc.PlacedFootprint.Footprint.Depth    = 1;
+                    csrc.PlacedFootprint.Footprint.RowPitch = pitch;
+                    d3d12_owned_copy_texture(&cdst, 0, 0, 0, &csrc, NULL);
+                } else {
+                    return -1; /* no valid upload bytes; do not sample uninitialized storage */
+                }
+            } else {
+                return -1;
+            }
+        }
+        {
+            D3D12_RESOURCE_BARRIER b = {0};
+            b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+            b.Transition.pResource   = r->res;
+            b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+            b.Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+            b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+            d3d12_owned_barriers(1, &b);
+            r->st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        }
+    }
+
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rh);
+    rh.ptr += (u64)slot * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    d3d12_owned_rtv(r->res, NULL, rh);
+
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = td.Format;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = 1;
+    D3D12_CPU_DESCRIPTOR_HANDLE sh;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &sh);
+    sh.ptr += (u64)(RT_SRV_BASE + slot) * s_d3d.srv_inc;
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, r->res, &sv, sh);
+
+    static int _log = 0;
+    if (_log++ < 8)
+        printf("[D3D12] offscreen RT %d: off=0x%X logical=%ux%u backing=%ux%u pitch=0x%X\n",
+               slot, off, r->logical_w, r->logical_h, r->w, r->h, r->raw_pitch);
+    return slot;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE off_rt_rtv(int slot)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rh);
+    rh.ptr += (u64)slot * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    return rh;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE off_rt_scratch_rtv(int slot)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rh);
+    rh.ptr += (u64)(MAX_OFF_RTS + slot) * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    return rh;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE display_history_rtv(int slot)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rh);
+    rh.ptr += (u64)(MAX_OFF_RTS + MAX_OFF_RT_SCRATCH + slot) *
+        s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+            s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    return rh;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE display_surface_rtv(int slot)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rh);
+    rh.ptr += (u64)(MAX_OFF_RTS + MAX_OFF_RT_SCRATCH + MAX_DISPLAY_HISTORY + slot) *
+        s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+            s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    return rh;
+}
+
+static int display_surface_find_raw(u32 raw)
+{
+    for (int i = 0; i < MAX_DISPLAY_SURFACES; ++i)
+        if (s_d3d.display_surface[i].res && s_d3d.display_surface[i].raw == raw)
+            return i;
+    return -1;
+}
+
+static void display_surface_release(DisplaySurface* surface)
+{
+    if (!surface) return;
+    if (surface->sample) surface->sample->lpVtbl->Release(surface->sample);
+    if (surface->res) surface->res->lpVtbl->Release(surface->res);
+    memset(surface, 0, sizeof(*surface));
+}
+
+/* Called only after the opening fence and command-list reset.  Registration
+ * changes must not leave historical raw identities consuming the fixed pool. */
+static void display_surface_reclaim_stale(void)
+{
+    for (int i = 0; i < MAX_DISPLAY_SURFACES; ++i) {
+        DisplaySurface* surface = &s_d3d.display_surface[i];
+        CellGcmDisplayInfo current = {0};
+        if (!surface->res) continue;
+        if (!cellGcmGetDisplaySurfaceInfo(surface->raw, surface->pitch,
+                                          surface->w, surface->h, &current) ||
+            current.offset != surface->raw || current.pitch != surface->pitch ||
+            current.width != surface->w || current.height != surface->h) {
+            if (d3d12_prefix_prepare_before_mutation(surface->res) != 0 ||
+                d3d12_prefix_prepare_before_mutation(surface->sample) != 0)
+                return;
+            display_surface_release(surface);
+        }
+    }
+}
+
+static int display_surface_find(u32 raw)
+{
+    CellGcmDisplayInfo info = {0};
+    if (cellGcmGetDisplaySurfaceInfo(raw, 0, 0, 0, &info))
+        return display_surface_get(&info);
+    return display_surface_find_raw(raw);
+}
+
+static int display_surface_get(const CellGcmDisplayInfo* info)
+{
+    if (!info || !info->width || !info->height || !s_d3d.rt_rtv_heap) return -1;
+    int slot = display_surface_find_raw(info->offset);
+    if (slot >= 0) {
+        DisplaySurface* old = &s_d3d.display_surface[slot];
+        if (old->raw == info->offset && old->pitch == info->pitch &&
+            old->w == info->width && old->h == info->height)
+            return slot;
+        /* Display registration is authoritative. The same raw may be rebound
+         * with new geometry, so discard its old backing and ordered snapshot
+         * before recreating this exact descriptor slot. */
+        display_surface_release(old);
+    }
+    if (slot < 0)
+        for (int i = 0; i < MAX_DISPLAY_SURFACES; ++i)
+            if (!s_d3d.display_surface[i].res) { slot = i; break; }
+    if (slot < 0) return -1;
+    DisplaySurface* s = &s_d3d.display_surface[slot];
+    /* TJ_RENDER_SCALE: the backing is the registration x scale; every guest
+     * field below keeps the registered geometry. */
+    const u8 scale = rs_display_geometry_scale(info->width, info->height);
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = (u64)info->width * scale; td.Height = info->height * scale;
+    td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1; td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_CLEAR_VALUE cv = {0}; cv.Format = td.Format;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_RENDER_TARGET, &cv,
+            &IID_ID3D12Resource, (void**)&s->res)))
+        return -1;
+    s->raw = info->offset; s->pitch = info->pitch; s->w = info->width; s->h = info->height;
+    s->scale = scale;
+    s->st = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    d3d12_owned_rtv(s->res, NULL,
+                                                  display_surface_rtv(slot));
+    const float black[4] = {0, 0, 0, 1};
+    s_d3d.cmd_list->lpVtbl->ClearRenderTargetView(s_d3d.cmd_list,
+                                                   display_surface_rtv(slot), black, 0, NULL);
+    /* This clear only initializes host storage. It is not guest display
+     * content and must not seed a history alias or exact MAIN export. */
+    s->valid = 0;
+    return slot;
+}
+
+static void display_surface_transition(int slot, D3D12_RESOURCE_STATES to)
+{
+    if (slot < 0 || slot >= MAX_DISPLAY_SURFACES) return;
+    DisplaySurface* s = &s_d3d.display_surface[slot];
+    if (!s->res || s->st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = s->res;
+    b.Transition.StateBefore = s->st;
+    b.Transition.StateAfter = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    d3d12_owned_barriers(1, &b);
+    s->st = to;
+}
+
+static int display_surface_sample_ensure(int slot)
+{
+    if (slot < 0 || slot >= MAX_DISPLAY_SURFACES) return -1;
+    DisplaySurface* s = &s_d3d.display_surface[slot];
+    if (!s->res) return -1;
+    if (s->sample) return 0;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    /* Full-resource copy target of the (possibly scaled) display backing. */
+    td.Width = (u64)s->w * rs_factor(s->scale); td.Height = s->h * rs_factor(s->scale);
+    td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1; td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&s->sample))) return -1;
+    s->sample_st = D3D12_RESOURCE_STATE_COPY_DEST;
+    return 0;
+}
+
+static void display_surface_sample_snapshot(int slot)
+{
+    if (display_surface_sample_ensure(slot) != 0) return;
+    DisplaySurface* s = &s_d3d.display_surface[slot];
+    if (s->sample_st != D3D12_RESOURCE_STATE_COPY_DEST) {
+        D3D12_RESOURCE_BARRIER b = {0}; b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = s->sample; b.Transition.StateBefore = s->sample_st;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        d3d12_owned_barriers(1, &b);
+    }
+    display_surface_transition(slot, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = s->sample; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = s->res; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, NULL);
+    D3D12_RESOURCE_BARRIER b = {0}; b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = s->sample; b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    d3d12_owned_barriers(1, &b);
+    s->sample_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    /* This snapshot can be taken immediately before a self-sampling draw.
+     * Restore the target now: the target-switch happened earlier in replay. */
+    display_surface_transition(slot, D3D12_RESOURCE_STATE_RENDER_TARGET);
+}
+
+/* Called before replay, after render_frame's opening GPU wait. A scratch slot
+ * therefore may grow or change format only between fully completed frames. */
+static int off_rt_scratch_prepare(int slot, u32 w, u32 h, u32 dxgi)
+{
+    if (slot < 0 || slot >= MAX_OFF_RT_SCRATCH || !w || !h ||
+        dxgi == (u32)DXGI_FORMAT_UNKNOWN)
+        return -1;
+    OffRTScratch* r = &s_d3d.off_rt_scratch[slot];
+    if (r->res && r->dxgi == dxgi && r->w >= w && r->h >= h)
+        return 0;
+    if (r->res) { r->res->lpVtbl->Release(r->res); r->res = NULL; }
+
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w; td.Height = h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = (DXGI_FORMAT)dxgi;
+    td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = td.Format;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, &cv,
+            &IID_ID3D12Resource, (void**)&r->res)))
+        return -1;
+    r->w = w; r->h = h; r->dxgi = dxgi;
+    r->st = D3D12_RESOURCE_STATE_COPY_DEST;
+    d3d12_owned_rtv(r->res, NULL, off_rt_scratch_rtv(slot));
+    return 0;
+}
+
+static void off_rt_scratch_transition(int slot, D3D12_RESOURCE_STATES to)
+{
+    OffRTScratch* r = &s_d3d.off_rt_scratch[slot];
+    if (!r->res || r->st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r->res;
+    b.Transition.StateBefore = r->st;
+    b.Transition.StateAfter = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    d3d12_owned_barriers(1, &b);
+    r->st = to;
+}
+
+/* Resolve a local texture offset inside a pitch-wide OffRT backing. Exact
+ * bases stay on off_rt_find(); this path accepts only fully-bounded, matching
+ * pixel-format rectangles, so nearby unrelated local allocations cannot alias. */
+static int off_rt_find_packed_view(u32 raw, u8 local, u32 w, u32 h, u32 tex_fmt,
+                                   int* out_parent, u32* out_x, u32* out_y)
+{
+    DXGI_FORMAT tex_dxgi = rsx_tex_off_rt_dxgi(tex_fmt);
+    u32 tex_bpp = dxgi_bytes_per_pixel(tex_dxgi);
+    u64 best_delta = ~(u64)0;
+    int best = -1;
+    u32 best_x = 0, best_y = 0;
+    if (!local || !raw || !w || !h || tex_dxgi == DXGI_FORMAT_UNKNOWN) return -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res || !r->local || raw <= r->off || !r->raw_pitch ||
+            r->dxgi != (u32)tex_dxgi ||
+            r->raw_pitch % tex_bpp)
+            continue;
+        u64 delta = (u64)raw - r->off;
+        u64 capacity = (u64)r->raw_pitch * r->h;
+        u64 span = (u64)(h - 1) * r->raw_pitch + (u64)w * tex_bpp;
+        if (delta >= capacity || delta % tex_bpp ||
+            off_rt_tile_canonical(raw, r->raw_pitch, tex_bpp, span,
+                                  NULL, NULL) != r->off)
+            continue;
+        u32 y = (u32)(delta / r->raw_pitch);
+        u32 x = (u32)((delta % r->raw_pitch) / tex_bpp);
+        if ((u64)x + w > r->w || (u64)y + h > r->h || delta >= best_delta)
+            continue;
+        best = i;
+        best_delta = delta; /* closest containing base wins if ranges overlap */
+        best_x = x;
+        best_y = y;
+    }
+    if (best < 0) return -1;
+    *out_parent = best;
+    *out_x = best_x;
+    *out_y = best_y;
+    return 0;
+}
