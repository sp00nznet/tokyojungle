+        if (!(mask & (1u << u)) || !dr->tex[u].set) continue;
+        if (dr->tex_snapshot_fault_mask & (1u << u)) return 0;
+        if (vp_record_texture_is_gpu_owned(dr, dr->tex[u].raw, dr->tex[u].location)) continue;
+        if (!dr->tex_snapshot[u]) return 0;
