+static void tj_fp_dump_target(u32 fp_addr, u32 capture_off, u32 uhash,
+                              int vs_idx, u32 vs_hash, u32 blend, int nrt,
+                              u32 rtfmt, int exp32, u32 cmask, u32 depth_key,
+                              const RSXFPStructuralProgram* program,
+                              const u8* ucode, const char* hlsl)
+{
+    if (!tj_fp_dump_target_claim(fp_addr, uhash, vs_hash, vs_idx, blend, nrt,
+                                 rtfmt, exp32, cmask, depth_key)) return;
+
+    const char* capture_dir = getenv("TJ_INDEXED_CAPTURE_DIR");
+    const char* dir = (capture_dir && *capture_dir) ? capture_dir : ".";
+    size_t dir_len = strlen(dir);
+    int needs_sep = dir_len && dir[dir_len - 1] != '\\' && dir[dir_len - 1] != '/';
+    if (capture_dir && *capture_dir) CreateDirectoryA(dir, NULL);
+
+    char hlsl_path[1024], bin_path[1024];
+    int hlsl_path_len = snprintf(hlsl_path, sizeof(hlsl_path),
+        "%s%sfp_target_%08X_uh%08X_vs%08X_vsi%d_b%08X_n%d_rt%08X_e%d_cm%08X_d%08X.hlsl",
+        dir, needs_sep ? "\\" : "", fp_addr, uhash, vs_hash, vs_idx,
+        blend, nrt, rtfmt, exp32, cmask, depth_key);
+    int bin_path_len = snprintf(bin_path, sizeof(bin_path),
+        "%s%sfp_target_%08X_uh%08X_vs%08X_vsi%d_b%08X_n%d_rt%08X_e%d_cm%08X_d%08X.bin",
+        dir, needs_sep ? "\\" : "", fp_addr, uhash, vs_hash, vs_idx,
+        blend, nrt, rtfmt, exp32, cmask, depth_key);
+    int success = hlsl_path_len > 0 && hlsl_path_len < (int)sizeof(hlsl_path) &&
+                  bin_path_len > 0 && bin_path_len < (int)sizeof(bin_path);
+    FILE* hlsl_file = success ? fopen(hlsl_path, "wb") : NULL;
+    if (!hlsl_file) success = 0;
+    else {
+        fprintf(hlsl_file,
+                "/* FP_DUMP_TARGET\n"
+                "fp_addr=0x%08X\nusz=%u\nuhash=0x%08X\n"
+                "vs_idx=%d\nvs_hash=0x%08X\nblend=0x%08X\nnrt=%d\nrtfmt=0x%08X\n"
+                "exp32=%d\ncmask=0x%08X\ndepth_key=0x%08X\n",
+                fp_addr, program->size_bytes, uhash, vs_idx, vs_hash, blend, nrt, rtfmt,
+                exp32, cmask, depth_key);
+        if (capture_off != 0xFFFFFFFFu)
+            fprintf(hlsl_file, "capture_resolved_off=0x%08X\n", capture_off);
+        else
+            fputs("capture_resolved_off=unavailable-no-live-lookup\n", hlsl_file);
+        tj_fp_dump_target_notes(hlsl_file, program, hlsl);
+        fputs("*/\n", hlsl_file);
+        if (fwrite(hlsl, 1, strlen(hlsl), hlsl_file) != strlen(hlsl)) success = 0;
+        if (fclose(hlsl_file) != 0) success = 0;
+    }
+    FILE* bin_file = success ? fopen(bin_path, "wb") : NULL;
+    if (!bin_file) success = 0;
+    else {
+        if (fwrite(ucode, 1, program->size_bytes, bin_file) != program->size_bytes) success = 0;
+        if (fclose(bin_file) != 0) success = 0;
+    }
+    printf("[FP_DUMP_TARGET] fp=0x%08X hlsl=%s bin=%s %s\n", fp_addr,
+           hlsl_path_len > 0 && hlsl_path_len < (int)sizeof(hlsl_path) ? hlsl_path : "?",
+           bin_path_len > 0 && bin_path_len < (int)sizeof(bin_path) ? bin_path : "?",
+           success ? "success" : "failed");
+}
