+          probe.tconst_probe_last_raw[0][1] == 0xBF800000u &&
+          probe.tconst_probe_last_load[0][1] == 4 &&
+          probe.tconst_probe_last_slot[0][1] == 4 && probe.tconst_probe_last_lane[0][1] == 1,
