+static void read_vp_vertex_planned(const VPVertexPlan* plan, u32 vi, VPSlot* out16)
+{
+    extern uint8_t* vm_base;
+    if (plan->has_immediate && vi < plan->immediate_count) {
+        for (u32 i = 0; i < plan->count; ++i) {
+            const VPAttrPlan* a = &plan->attrs[i];
+            const float* src = a->immediate
+                ? a->immediate + (size_t)vi * RSX_MAX_VERTEX_ATTRIBS * 4u
+                : a->current;
+            for (u32 k = 0; k < 4; k++) out16[a->slot].v[k] = src[k];
+        }
+        return;
+    }
+    for (u32 i = 0; i < plan->count; ++i) {
+        const VPAttrPlan* a = &plan->attrs[i];
+        VPSlot* o = &out16[a->slot];
+        if (!a->decode) {
+            for (u32 k = 0; k < 4; k++) o->v[k] = a->current[k];
+            continue;
+        }
+        u32 ei = vi;
+        if (a->frequency_mode == 1) ei = vi / a->frequency;
+        else if (a->frequency_mode == 2) ei = vi % a->frequency;
+        /* Keep the original u32 wrapping and a fresh checked translation on
+         * EVERY fetch. MAIN mappings may change after this plan was made. */
+        u32 off = a->base + ei * a->stride;
+        u32 ea;
+        if (!cellGcmResolveLocatedChecked(a->local, off, &ea)) {
+            for (u32 k = 0; k < 4; k++) o->v[k] = a->current[k];
+            continue;
         }
+        const u8* p = vm_base + ea;
+        if (a->seed_defaults)
+            for (u32 k = 0; k < 4; k++) o->v[k] = a->current[k];
+        a->decode(p, a->components, o);
     }
