+                       (a->offset & 0x7FFFFFFFu)) & 0x0FFFFFFFu) +
+                (u64)ei * a->stride;
+    if (raw64 > 0xFFFFFFFFu) return 0;
+    u32 raw = (u32)raw64;
+    u32 ea;
+    if (!cellGcmResolveLocatedChecked((a->offset & 0x80000000u) == 0,
+                                      raw, &ea)) return 0;
+    u32 n = a->size ? a->size : 4; if (n > 4) n = 4;
+    u32 bytes = n * ((a->type == 3 || a->type == 1 || a->type == 5) ? 2u
+                                                                        : (a->type == 4 || a->type == 7) ? 1u : 4u);
+    if (!tj_indexed_diag_guest_span(ea, bytes)) return 0;
+    const u8* p = vm_base + ea;
+    switch (a->type) {
+    case 2: for (u32 k = 0; k < n; ++k) out[k] = rd_bef(p + k * 4); break;
+    case 3: for (u32 k = 0; k < n; ++k) out[k] = rd_half_be(p + k * 2); break;
+    case 4: for (u32 k = 0; k < n; ++k) out[k] = p[k] / 255.0f; break;
+    case 1: for (u32 k = 0; k < n; ++k) out[k] = ((float)(s16)((p[k*2] << 8) | p[k*2+1]) + 0.5f) / 32767.5f; break;
+    case 5: for (u32 k = 0; k < n; ++k) out[k] = (float)(s16)((p[k*2] << 8) | p[k*2+1]); break;
+    case 6: {
