+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = dxfmt;
+    /* RSX B8 presents the byte in RGB and constant one in alpha. DXGI R8's
+     * native (R,0,0,1) view is remapped by the shared RSX crossbar. */
+    sv.Shader4ComponentMapping = rsx_remap_to_d3d(0xAAE4u, basef);
