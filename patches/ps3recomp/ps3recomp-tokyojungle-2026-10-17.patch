+/* Borderless only when the primary monitor is exactly the internal size;
+ * anything else keeps the ordinary window. */
+static int d3d12_scale_borderless_rect(u32 width, u32 height, RECT* out)
+{
+    const char* mode = getenv("TJ_WINDOW_MODE");
+    if (!mode || strcmp(mode, "borderless") != 0) {
+        if (mode && *mode && strcmp(mode, "windowed") != 0)
+            fprintf(stderr, "[tj-scale] TJ_WINDOW_MODE='%s' ignored; windowed\n", mode);
+        return 0;
+    }
+    POINT origin = {0, 0};
+    MONITORINFO mi;
+    memset(&mi, 0, sizeof(mi));
+    mi.cbSize = sizeof(mi);
+    HMONITOR monitor = MonitorFromPoint(origin, MONITOR_DEFAULTTOPRIMARY);
+    if (!monitor || !GetMonitorInfoA(monitor, &mi)) {
+        fprintf(stderr, "[tj-scale] borderless: monitor query failed; windowed\n");
+        return 0;
+    }
+    const LONG monitor_w = mi.rcMonitor.right - mi.rcMonitor.left;
+    const LONG monitor_h = mi.rcMonitor.bottom - mi.rcMonitor.top;
+    if (monitor_w != (LONG)width || monitor_h != (LONG)height) {
+        fprintf(stderr, "[tj-scale] borderless needs a %ux%u monitor (primary is %ldx%ld); "
+                "windowed\n", width, height, (long)monitor_w, (long)monitor_h);
+        return 0;
+    }
+    *out = mi.rcMonitor;
+    fprintf(stderr, "[tj-scale] borderless %ux%u at %ld,%ld\n", width, height,
+            (long)mi.rcMonitor.left, (long)mi.rcMonitor.top);
+    return 1;
+}
