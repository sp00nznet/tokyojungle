+                                   GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON), 0);
+    wc.lpszClassName = "ps3recomp_d3d12";
+    RegisterClassExA(&wc);
+
+    /* Automated performance probes must not steal focus or cover the user's
+     * desktop.  Keep the normal interactive window unchanged; the explicit
+     * test mode creates a hidden tool window off-screen while retaining a real
+     * HWND/swapchain for the D3D12 path. */
+    const int background_test = getenv("TJ_BACKGROUND_TEST_WINDOW") ? 1 : 0;
+    /* TJ_RENDER_SCALE: a visible opted-in window is per-monitor DPI aware and
+     * sized to the internal resolution (or borderless on a monitor of exactly
+     * that size). The hidden test window keeps its style and gets no DPI call. */
+    const int scaled_window = s_d3d.scale > 1 && !background_test;
+    RECT monitor = {0};
+    int borderless = 0;
+    if (scaled_window) {
