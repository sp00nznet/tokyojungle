+static u32 tj_indexed_diag_source_count(const rsx_state* state, u32 primitive,
+                                        u32 count)
+{
+    extern uint8_t* vm_base;
+    const u64 total = (u64)MAX_VERTICES * VP_VERT_STRIDE;
+    if (!state || !vm_base || !s_d3d.vp_vb_mapped ||
+        !rsx_has_vertex_position(state) || s_d3d.vp_vb_offset > total)
+        return 0;
+    u32 maxv = (u32)((total - s_d3d.vp_vb_offset) / VP_VERT_STRIDE);
+    if (primitive == 8) {
+        u32 quads = count / 4;
+        if (quads * 6 > maxv) quads = maxv / 6;
+        return quads * 4;
+    }
+    if (primitive == 9) {
+        if (count < 4) return 0;
+        u32 quads = (count - 2) / 2;
+        if (quads * 6 > maxv) quads = maxv / 6;
+        return quads ? quads * 2 + 2 : 0;
+    }
+    if (primitive == 5) {
+        if (count > maxv) count = maxv - (maxv % 3);
+        return count;
+    }
+    if (primitive == 1 || primitive == 2 || primitive == 4) {
+        if (count > maxv) count = maxv;
+        return count;
+    }
+    if (primitive == 3) {
+        if (count < 2 || maxv < 3) return 0;
+        if (count + 1 > maxv) count = maxv - 1;
+        return count;
+    }
+    if (primitive == 6 || primitive == 7 || primitive == 10) {
+        if (count < 3) return 0;
+        u32 tris = count - 2;
+        if (tris * 3 > maxv) tris = maxv / 3;
+        return tris ? tris + 2 : 0;
+    }
+    return 0;
+}
+
+static int tj_indexed_diag_index_span(const rsx_state* state, u32 first,
+                                      u32 source_count, u32* out_ea)
+{
+    if (!source_count) return 0;
+    u32 ea;
+    if (!resolve_guest_index_base(state, &ea)) return 0;
+    u64 width = ((state->index_array_dma >> 4) & 0xFu) == 1 ? 2u : 4u;
+    u64 end = ((u64)first + source_count) * width;
+    if (!tj_indexed_diag_guest_span(ea, end)) return 0;
+    if (out_ea) *out_ea = ea;
+    return 1;
+}
