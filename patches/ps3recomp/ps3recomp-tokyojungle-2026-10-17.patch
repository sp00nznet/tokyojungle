+static LRESULT CALLBACK d3d12_wndproc_body(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    /* F1 opens/closes the Controls screen and F2 the Options screen (the
+     * other key switches page); while it is open, keys (and mouse buttons
+     * while it waits for a binding) go to it instead of DefWindowProc. */
+    if ((msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN) && (wp == VK_F1 || wp == VK_F2)) {
+        if (!(lp & (1L << 30)))
+            cellPad_overlay_page_key(wp == VK_F2 ? 1 : 0);   /* F1 while waiting for a key: cancel */
+        return 0;
+    }
+    if (cellPad_overlay_is_open()) {
+        if (msg == WM_KEYDOWN || (msg == WM_SYSKEYDOWN && cellPad_overlay_capturing())) {
+            cellPad_overlay_key((int)wp, (long)lp);
+            return 0;
+        }
+        if (cellPad_overlay_capturing()) {
+            int vk = 0;
+            if (msg == WM_LBUTTONDOWN) vk = VK_LBUTTON;
+            else if (msg == WM_RBUTTONDOWN) vk = VK_RBUTTON;
+            else if (msg == WM_MBUTTONDOWN) vk = VK_MBUTTON;
+            else if (msg == WM_XBUTTONDOWN) vk = GET_XBUTTON_WPARAM(wp) == XBUTTON1 ? VK_XBUTTON1 : VK_XBUTTON2;
+            if (vk) {
+                cellPad_overlay_key(vk, 0);
+                return msg == WM_XBUTTONDOWN ? TRUE : 0;
+            }
+        }
+    }
+    switch (msg) {
+    case WM_GETMINMAXINFO:
+        /* TJ_RENDER_SCALE hidden test window: allow the full internal client
+         * size; Windows otherwise caps it at the (DPI-scaled) desktop. */
+        if (s_d3d.scale > 1 && getenv("TJ_BACKGROUND_TEST_WINDOW")) {
+            MINMAXINFO* mm = (MINMAXINFO*)lp;
+            mm->ptMaxTrackSize.x = mm->ptMaxSize.x = 16384;
+            mm->ptMaxTrackSize.y = mm->ptMaxSize.y = 16384;
+            return 0;
+        }
+        break;
+    case WM_APP + 0x51:
+        cellPadDebugPulse((u16)wp, (u32)lp);
+        return 0;
+    case WM_APP + 0x52:
+        cellPadDebugAnalogPulse((u8)(wp & 0xFF), (u8)((wp >> 8) & 0xFF),
+                                (u32)lp);
+        return 0;
+    case WM_CLOSE:
+        if (cellPad_overlay_is_open()) cellPad_overlay_toggle();   /* saves pending control changes */
+        s_d3d.window_closed = 1;
+        fprintf(stderr, "[D3D12] WM_CLOSE hwnd=%p: DestroyWindow\n", (void*)hwnd);
+        fflush(stderr);
+        d3d12_notify_close_observer();
+        DestroyWindow(hwnd);
+        return 0;
+    case WM_DESTROY:
+        fprintf(stderr, "[D3D12] WM_DESTROY hwnd=%p\n", (void*)hwnd);
+        fflush(stderr);
+        if (s_d3d.hwnd == hwnd)
+            s_d3d.hwnd = NULL;
+        PostQuitMessage(0);
+        return 0;
+    case WM_MOVE:
+        d3d12_display_vblank_note_window(0);
+        break;
+    case WM_DISPLAYCHANGE:
+        d3d12_display_vblank_note_window(1);
+        break;
+    case WM_KEYDOWN:
+        /* Game input is polled by cellPad. Escape is not a host quit request;
+         * closing this window alone leaves the guest running without a view.
+         * Keep normal close-button/Alt+F4 handling in WM_CLOSE. */
+        return 0;
+    case WM_NCLBUTTONDOWN:
+        /* Title bar / sizing border: non-modal drag (see s_d3d12_drag). A
+         * maximized window is not dragged (DefWindowProc would restore it
+         * inside the modal loop); double-click still restores/maximizes. */
+        if (d3d12_drag_hit_supported(wp)) {
+            if (!IsZoomed(hwnd) && !s_d3d12_drag.active)
+                d3d12_drag_begin(hwnd, wp);
+            return 0;
+        }
+        break;
+    case WM_MOUSEMOVE:
+        if (s_d3d12_drag.active) {
+            d3d12_drag_update(hwnd);
+            return 0;
+        }
+        break;
+    case WM_LBUTTONUP:
+        if (s_d3d12_drag.active) {
+            d3d12_drag_update(hwnd);
+            s_d3d12_drag.active = 0;
+            ReleaseCapture();
+            return 0;
+        }
+        break;
+    case WM_CAPTURECHANGED:
+        s_d3d12_drag.active = 0;
+        break;
+    case WM_NCRBUTTONDOWN:
+    case WM_NCRBUTTONUP:
+        /* Caption/icon right-click opens the modal system menu. */
+        if (wp == HTCAPTION || wp == HTSYSMENU) return 0;
+        break;
+    case WM_CONTEXTMENU:
+        /* DefWindowProc shows the modal system menu for non-client hits;
+         * the client area has no context menu. */
+        return 0;
+    case 0x0313: /* WM_POPUPSYSTEMMENU: taskbar Shift+right-click window menu */
+        return 0;
+    case WM_SYSCOMMAND:
+        /* Alt/F10 menu activation runs DefWindowProc's modal menu loop on the
+         * presenter thread (measured 2.26 s stall after WM_KEYUP VK_MENU).
+         * SC_MOUSEMENU (icon click) is the same menu; SC_MOVE/SC_SIZE start
+         * the modal move/size loop (title-bar drag handled above). There is
+         * no menu bar; SC_CLOSE (Alt+F4, icon double-click), minimize,
+         * maximize and restore still reach DefWindowProcA. */
+        switch (wp & 0xFFF0) {
+        case SC_KEYMENU:
+            fprintf(stderr, "[D3D12] SC_KEYMENU swallowed lp=0x%llX\n",
+                    (unsigned long long)lp);
+            return 0;
+        case SC_MOUSEMENU:
+        case SC_MOVE:
+        case SC_SIZE:
+            fprintf(stderr, "[D3D12] SC_%s swallowed (modal loop)\n",
+                    (wp & 0xFFF0) == SC_MOVE ? "MOVE"
+                    : (wp & 0xFFF0) == SC_SIZE ? "SIZE" : "MOUSEMENU");
+            return 0;
+        }
+        break;
+    }
+    return DefWindowProcA(hwnd, msg, wp, lp);
+}
+
+/* Register/reset and notify only on the renderer window-owner thread. The
+ * callback is a close-boundary observer; it must not perform GPU or input work. */
+void rsx_d3d12_backend_set_close_observer(void (*observer)(void))
+{
+    s_d3d12_close_observer = observer;
+}
+
+static void d3d12_notify_close_observer(void)
+{
+    if (s_d3d12_close_observer) s_d3d12_close_observer();
+}
+
+static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    TJMessagePumpSample* sample = s_tj_message_pump_current;
+    if (!sample || s_tj_message_pump_phase == TJ_MESSAGE_PUMP_NONE)
+        return d3d12_wndproc_body(hwnd, msg, wp, lp);
+    if (s_tj_message_wndproc_depth++) {
+        LRESULT result = d3d12_wndproc_body(hwnd, msg, wp, lp);
+        --s_tj_message_wndproc_depth;
+        return result;
+    }
+    uint64_t begin = 0, end = 0;
+    int begin_valid = sample->qpc_valid && tj_message_pump_trace_now(&begin);
+    if (sample->qpc_valid && !begin_valid) sample->qpc_valid = 0;
+    LRESULT result = d3d12_wndproc_body(hwnd, msg, wp, lp);
+    if (begin_valid && sample->qpc_valid &&
+        tj_message_pump_trace_now(&end) && end >= begin) {
+        uint64_t elapsed = end - begin;
+        if (elapsed > s_tj_message_pump_trace.frequency / 10 &&
+            elapsed > sample->handler_ticks) {
+            sample->handler_ticks = elapsed;
+            sample->handler_message = msg;
+            sample->handler_wparam = wp;
+            sample->handler_phase = s_tj_message_pump_phase;
+            sample->handler_valid = 1;
+        }
+    } else if (begin_valid || sample->qpc_valid) {
+        sample->qpc_valid = 0;
+    }
+    --s_tj_message_wndproc_depth;
+    return result;
 }
 
 /* ---------------------------------------------------------------------------
- * Render-to-texture: offscreen RT pool.
- *
- * Draws/clears targeting a non-display surface (SET_SURFACE_COLOR_xOFFSET
- * not registered via cellGcmSetDisplayBuffer) render into a pooled RGBA8
- * texture keyed by the surface's resolved vm offset; a later draw binding a
- * texture at that offset samples the RT directly instead of guest memory.
- * RGBA8 for every RT (even half-float guest surfaces) keeps the existing
- * PSO/RTV formats -- values clamp to [0,1], which demosaic's RGB data fits.
+ * TJ_RENDER_SCALE (opt-in). Parsed once per backend init, before the window,
+ * swap chain or any shader exists, and never changed afterwards. Unset or 1
+ * leaves every 1x path untouched and logs nothing.
  * -----------------------------------------------------------------------*/
+static u32 d3d12_render_scale_parse(void)
+{
+    const char* value = getenv("TJ_RENDER_SCALE");
+    if (!value || !*value) return 1;
+    char* end = NULL;
+    long n = strtol(value, &end, 10);
+    if (!end || *end || n < 1 || n > 3) {
+        fprintf(stderr, "[tj-scale] TJ_RENDER_SCALE='%s' ignored (1..3); scale 1\n", value);
+        return 1;
+    }
+    if (n == 1) return 1;
+    /* Guest Edge MLAA reads the display back and uploads a 1x image over it
+     * (tj_mlaa_skip). Captures, the reference replay (it sets SHORT_FRAME)
+     * and FP probes assume a 1x backbuffer or 1280-wide window coordinates. */
+    const char* mlaa = getenv("TJ_DISABLE_MLAA");
+    if (!(mlaa && mlaa[0] == '1' && mlaa[1] == '\0')) {
+        fprintf(stderr, "[tj-scale] scale %ld needs TJ_DISABLE_MLAA=1 "
+                "(guest MLAA re-uploads a 1x image); scale 1\n", n);
+        return 1;
+    }
+    static const char* const diagnostics[] = {
+        "TJ_COMPOSE_CAPTURE_SHORT_FRAME", "TJ_COMPOSE_CAPTURE_DIR",
+        "TJ_COMPOSE_CAPTURE_OFFRT", "TJ_COMPOSE_CAPTURE_FP", "TJ_INDEXED_CAPTURE_DIR",
+        "RTT_SAVERT", "RTT_PASS", "CELLMARK_DUMP", "RSX_CAP", "RSX_CAP_HOTKEY",
+        "FP_FORCE", "TJ_FP_PROBE_T0", "TJ_FP_PROBE_T1", "TJ_FP_PROBE_STAGEGRID",
+        "TJ_FP_PROBE_LATEGRID"};
+    for (u32 i = 0; i < sizeof(diagnostics) / sizeof(diagnostics[0]); ++i) {
+        if (getenv(diagnostics[i])) {
+            fprintf(stderr, "[tj-scale] scale %ld disabled by %s; scale 1\n",
+                    n, diagnostics[i]);
+            return 1;
+        }
+    }
+    if (n > 2) {
+        /* 3x on a 2560x1440 output needs the owned present resample. */
+        fprintf(stderr, "[tj-scale] scale %ld needs the present resample "
+                "(not in this build); scale 2\n", n);
+        n = 2;
+    }
+    return (u32)n;
+}
 
