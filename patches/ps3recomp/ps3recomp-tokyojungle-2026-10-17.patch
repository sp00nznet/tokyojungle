 /* lv2 PPU-fallback wrapper: signature matches spu_ppu_fallback_fn so it can be
  * registered via spu_register_ppu_fallback(entry_point, spu_lifted_fallback, fn).
  * Defined where spu_thread_get_local_store() is available (the lv2 TU); declared
diff --git a/runtime/spu/spu_main_write_gate.c b/runtime/spu/spu_main_write_gate.c
new file mode 100644
index 0000000..175e176
--- /dev/null
+++ b/runtime/spu/spu_main_write_gate.c
@@ -0,0 +1,199 @@
+#include "spu_main_write_gate.h"
+
+#include <stdint.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <pthread.h>
+#endif
+
+/* A writer registered before begin() is allowed to finish; begin waits for
+ * those preexisting tokens. A later overlap waits for end(); a later disjoint
+ * PUT proceeds, but stays registered for the next gate generation. */
+typedef struct spu_main_write_gate_state {
+#ifdef _WIN32
+    INIT_ONCE once;
+    CRITICAL_SECTION lock;
+    CONDITION_VARIABLE changed;
+    DWORD owner;
+#else
+    pthread_mutex_t lock;
+    pthread_cond_t changed;
+    pthread_t owner;
+#endif
+    uint64_t begin;
+    uint64_t end;
+    uint64_t generation;
+    uint32_t active_writers;
+    uint32_t draining_writers;
+    int active;
+    int owner_valid;
+} spu_main_write_gate_state;
+
+#ifdef _WIN32
+static spu_main_write_gate_state s_gate = { INIT_ONCE_STATIC_INIT };
+
+static BOOL CALLBACK spu_main_write_gate_init_once(PINIT_ONCE once, PVOID arg,
+                                                    PVOID *context)
+{
+    (void)once;
+    (void)arg;
+    (void)context;
+    InitializeCriticalSection(&s_gate.lock);
+    InitializeConditionVariable(&s_gate.changed);
+    return TRUE;
+}
+
+static int spu_main_write_gate_init(void)
+{
+    return InitOnceExecuteOnce(&s_gate.once, spu_main_write_gate_init_once,
+                               NULL, NULL) ? 1 : 0;
+}
+
+#define GATE_LOCK() EnterCriticalSection(&s_gate.lock)
+#define GATE_UNLOCK() LeaveCriticalSection(&s_gate.lock)
+#define GATE_WAIT() SleepConditionVariableCS(&s_gate.changed, &s_gate.lock, INFINITE)
+#define GATE_WAKE_ALL() WakeAllConditionVariable(&s_gate.changed)
+#else
+static spu_main_write_gate_state s_gate = {
+    PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER,
+    (pthread_t)0, 0, 0, 0, 0, 0, 0, 0
+};
+
+static int spu_main_write_gate_init(void) { return 1; }
+
+#define GATE_LOCK() pthread_mutex_lock(&s_gate.lock)
+#define GATE_UNLOCK() pthread_mutex_unlock(&s_gate.lock)
+#define GATE_WAIT() pthread_cond_wait(&s_gate.changed, &s_gate.lock)
+#define GATE_WAKE_ALL() pthread_cond_broadcast(&s_gate.changed)
+#endif
+
+static int gate_range(uint32_t ea, uint32_t size, uint64_t *begin,
+                      uint64_t *end)
+{
+    const uint64_t first = ea;
+    const uint64_t last = first + (uint64_t)size;
+    if (!size || last <= first || last > (UINT64_C(1) << 32))
+        return 0;
+    *begin = first;
+    *end = last;
+    return 1;
+}
+
+static int gate_overlaps(uint64_t begin, uint64_t end)
+{
+    return begin < s_gate.end && end > s_gate.begin;
+}
+
+uint64_t spu_main_write_gate_begin(uint32_t ea, uint32_t size)
+{
+    uint64_t begin, end, token;
+    if (!gate_range(ea, size, &begin, &end) || !spu_main_write_gate_init())
+        return 0;
+
+    GATE_LOCK();
+    if (s_gate.active) {
+        GATE_UNLOCK();
+        return 0;
+    }
+    if (s_gate.generation >= UINT64_MAX - 1u) {
+        GATE_UNLOCK();
+        return 0;
+    }
+    ++s_gate.generation;
+    s_gate.begin = begin;
+    s_gate.end = end;
+    s_gate.active = 1;
+    s_gate.draining_writers = s_gate.active_writers;
+    while (s_gate.draining_writers != 0)
+        GATE_WAIT();
+#ifdef _WIN32
+    s_gate.owner = GetCurrentThreadId();
+#else
+    s_gate.owner = pthread_self();
+#endif
+    s_gate.owner_valid = 1;
+    token = s_gate.generation;
+    GATE_UNLOCK();
+    return token;
+}
+
+int spu_main_write_gate_end(uint64_t token)
+{
+    if (!spu_main_write_gate_init())
+        return 0;
+
+    GATE_LOCK();
+    if (!token || !s_gate.active || !s_gate.owner_valid ||
+        token != s_gate.generation
+#ifdef _WIN32
+        || s_gate.owner != GetCurrentThreadId()
+#else
+        || !pthread_equal(s_gate.owner, pthread_self())
+#endif
+        ) {
+        GATE_UNLOCK();
+        return 0;
+    }
+    s_gate.active = 0;
+    s_gate.owner_valid = 0;
+    s_gate.draining_writers = 0;
+    s_gate.begin = 0;
+    s_gate.end = 0;
+    GATE_WAKE_ALL();
+    GATE_UNLOCK();
+    return 1;
+}
+
+uint64_t spu_main_write_gate_writer_enter(uint32_t ea, uint32_t size)
+{
+    uint64_t begin, end, token;
+    if (!gate_range(ea, size, &begin, &end) || !spu_main_write_gate_init())
+        return 0;
+
+    GATE_LOCK();
+    while (s_gate.active && gate_overlaps(begin, end))
+        GATE_WAIT();
+    /* Every valid PUT stays accounted until its memcpy finishes.  A disjoint
+     * PUT does not wait for the current gate, but a later gate still drains it
+     * before publishing a new authoritative range. */
+    if (s_gate.active_writers == UINT32_MAX) {
+        GATE_UNLOCK();
+        return 0;
+    }
+    ++s_gate.active_writers;
+    token = s_gate.generation + 1u;
+    GATE_UNLOCK();
+    return token;
+}
+
+void spu_main_write_gate_writer_exit(uint64_t writer_token)
+{
+    if (!writer_token || !spu_main_write_gate_init())
+        return;
+
+    GATE_LOCK();
+    if (s_gate.active_writers != 0) {
+        --s_gate.active_writers;
+        if (s_gate.active && writer_token <= s_gate.generation &&
+            s_gate.draining_writers != 0)
+            --s_gate.draining_writers;
+        if (s_gate.draining_writers == 0)
+            GATE_WAKE_ALL();
+    }
+    GATE_UNLOCK();
+}
+
+#ifdef SPU_MAIN_WRITE_GATE_TESTING
+int spu_main_write_gate_test_state(void)
+{
+    int state;
+    if (!spu_main_write_gate_init())
+        return -1;
+    GATE_LOCK();
+    state = s_gate.active ? (s_gate.owner_valid ? 2 : 1) : 0;
+    GATE_UNLOCK();
+    return state;
+}
+#endif
diff --git a/runtime/spu/spu_main_write_gate.h b/runtime/spu/spu_main_write_gate.h
new file mode 100644
index 0000000..14b4b1b
--- /dev/null
+++ b/runtime/spu/spu_main_write_gate.h
@@ -0,0 +1,38 @@
+/*
+ * Narrow ordering gate for guest MAIN writes that race an RSX exact
+ * LOCAL->MAIN completion.  The gate is intentionally independent of the
+ * guest-world rendezvous: it delays only overlapping regular SPU PUTs.
+ */
+#ifndef SPU_MAIN_WRITE_GATE_H
+#define SPU_MAIN_WRITE_GATE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Publish [ea, ea + size) and wait for PUTs already in flight.  Returns an
+ * opaque nonzero generation token, or zero for invalid/nested requests. */
+uint64_t spu_main_write_gate_begin(uint32_t ea, uint32_t size);
+
+/* Release a successful begin from its owner.  The exact begin token is
+ * required.  Returns 1 on success, 0 for stale/invalid/wrong-owner release. */
+int spu_main_write_gate_end(uint64_t token);
+
+/* Called by a regular MFC PUT immediately before its memcpy.  Returns an
+ * opaque nonzero writer token, or zero for invalid/overflow.  Every success
+ * must pair with writer_exit(token), including a disjoint active-gate PUT. */
+uint64_t spu_main_write_gate_writer_enter(uint32_t ea, uint32_t size);
+void spu_main_write_gate_writer_exit(uint64_t writer_token);
+
+#ifdef SPU_MAIN_WRITE_GATE_TESTING
+/* 0 idle, 1 published/draining, 2 published/owned.  Test-only seam. */
+int spu_main_write_gate_test_state(void);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/runtime/spu/spu_reservation.c b/runtime/spu/spu_reservation.c
new file mode 100644
index 0000000..c38576e
--- /dev/null
+++ b/runtime/spu/spu_reservation.c
@@ -0,0 +1,174 @@
+/* Shared SPU reservation-line ownership and HLE atomic guest-memory updates. */
+
+#include "spu_reservation.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+#include <intrin.h>
+#include <stddef.h>
+#include <string.h>
+
+extern uint8_t* vm_base;
+
+static volatile long g_resv_lock = 0;
+
+/* Test-and-test-and-set: waiters spin on a plain read (no locked RMW bouncing
+ * the line away from the holder) with a pause, and after a bounded spin yield
+ * the core so a holder preempted inside its critical section can finish. */
+#define RESV_LOCK_SPINS_BEFORE_YIELD 1024u
+
+void spu_reservation_lock(void)
+{
+    unsigned spins = 0;
+    while (_InterlockedExchange(&g_resv_lock, 1)) {
+        while (g_resv_lock) {
+            _mm_pause();
+            if (++spins >= RESV_LOCK_SPINS_BEFORE_YIELD) {
+                spins = 0;
+#ifdef _WIN32
+                SwitchToThread();
+#endif
+            }
+        }
+    }
+}
+
+void spu_reservation_unlock(void)
+{
+    _InterlockedExchange(&g_resv_lock, 0);
+}
+
+/* Comparing only bytes misses ABA: track every touched 128-byte line so an
+ * intervening writer invalidates a stale GETLLAR reservation even if it later
+ * restores the same data. */
+#define RESV_VERSION_SLOTS 65536u
+typedef struct ResvVersionSlot {
+    uint32_t line_ea;
+    uint32_t used;
+    uint64_t version;
+} ResvVersionSlot;
+
+static ResvVersionSlot g_resv_versions[RESV_VERSION_SLOTS];
+
+static ResvVersionSlot* version_slot_locked(uint32_t line_ea, int create)
+{
+    line_ea &= ~127u;
+    uint32_t i = ((line_ea >> 7) * 2654435761u) &
+                 (RESV_VERSION_SLOTS - 1u);
+    for (uint32_t probe = 0; probe < RESV_VERSION_SLOTS; probe++) {
+        ResvVersionSlot* slot = &g_resv_versions[i];
+        if (!slot->used) {
+            if (!create) return NULL;
+            slot->used = 1;
+            slot->line_ea = line_ea;
+            slot->version = 0;
+            return slot;
+        }
+        if (slot->line_ea == line_ea)
+            return slot;
+        i = (i + 1u) & (RESV_VERSION_SLOTS - 1u);
+    }
+    return NULL;
+}
+
+int spu_reservation_version_locked(uint32_t line_ea, uint64_t* version)
+{
+    ResvVersionSlot* slot = version_slot_locked(line_ea, 1);
+    if (!slot) return 0;
+    if (version) *version = slot->version;
+    return 1;
+}
+
+void spu_reservation_bump_locked(uint32_t line_ea)
+{
+    /* Only queried lines can have an outstanding GETLLAR reservation. Bulk
+     * image/HLE writes must not fill the finite table with unrelated lines and
+     * prevent later atomic reads from acquiring a reservation. The shared lock
+     * orders query and writer; entries are never removed, so every existing
+     * reservation still receives its ABA-invalidating version increment. */
+    ResvVersionSlot* slot = version_slot_locked(line_ea, 0);
+    if (slot) slot->version++;
+}
+
+void spu_reservation_notify_write(uint32_t ea, uint32_t size)
+{
+    if (!size) return;
+    uint32_t first = ea & ~127u;
+    uint32_t last = (ea + size - 1u) & ~127u;
+    spu_reservation_lock();
+    for (uint32_t line = first;; line += 128u) {
+        spu_reservation_bump_locked(line);
+        if (line == last || line > UINT32_MAX - 128u) break;
+    }
+    spu_reservation_unlock();
+}
+
+/* Ordered plain PUT (see spu_reservation.h). Per host thread: only the thread
+ * running a job of a lane window sets it, around that one job. */
+#if defined(_MSC_VER)
+static __declspec(thread) int t_put_ordered;
+#else
+static __thread int t_put_ordered;
+#endif
+
+int spu_reservation_set_put_ordered(int on)
+{
+    int old = t_put_ordered;
+    t_put_ordered = on;
+    return old;
+}
+
+int spu_reservation_put_ordered(void)
+{
+    return t_put_ordered;
+}
+
+void spu_reservation_put_copy(uint32_t ea, void* dst, const void* src,
+                              uint32_t size)
+{
+    if (!size) return;
+    uint32_t first = ea & ~127u;
+    uint32_t last = (ea + size - 1u) & ~127u;
+    spu_reservation_lock();
+    memcpy(dst, src, size);
+    for (uint32_t line = first;; line += 128u) {
+        spu_reservation_bump_locked(line);
+        if (line == last || line > UINT32_MAX - 128u) break;
+    }
+    spu_reservation_unlock();
+}
+
+int spu_reservation_compare_exchange64(uint32_t ea, uint64_t* expected,
+                                       uint64_t desired)
+{
+    if (!expected || (ea & 7u)) return 0;
+
+    spu_reservation_lock();
+    const uint8_t* p = vm_base + ea;
+    uint64_t current = ((uint64_t)p[0] << 56) |
+                       ((uint64_t)p[1] << 48) |
+                       ((uint64_t)p[2] << 40) |
+                       ((uint64_t)p[3] << 32) |
+                       ((uint64_t)p[4] << 24) |
+                       ((uint64_t)p[5] << 16) |
+                       ((uint64_t)p[6] << 8)  |
+                       (uint64_t)p[7];
+    int exchanged = current == *expected;
+    if (exchanged) {
+        uint8_t* d = vm_base + ea;
+        d[0] = (uint8_t)(desired >> 56);
+        d[1] = (uint8_t)(desired >> 48);
+        d[2] = (uint8_t)(desired >> 40);
+        d[3] = (uint8_t)(desired >> 32);
+        d[4] = (uint8_t)(desired >> 24);
+        d[5] = (uint8_t)(desired >> 16);
+        d[6] = (uint8_t)(desired >> 8);
+        d[7] = (uint8_t)desired;
+        spu_reservation_bump_locked(ea);
+    } else {
+        *expected = current;
+    }
+    spu_reservation_unlock();
+    return exchanged;
+}
diff --git a/runtime/spu/spu_reservation.h b/runtime/spu/spu_reservation.h
new file mode 100644
index 0000000..ed4fd16
--- /dev/null
+++ b/runtime/spu/spu_reservation.h
@@ -0,0 +1,39 @@
+#ifndef SPU_RESERVATION_H
+#define SPU_RESERVATION_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Shared lock/version table for all SPU GETLLAR/PUTLLC operations and HLE
+ * writers that touch the same 128-byte guest reservation lines. The *_locked
+ * helpers require the caller to hold spu_reservation_lock(). Version queries
+ * create persistent tracked entries; writes invalidate existing entries only. */
+void spu_reservation_lock(void);
+void spu_reservation_unlock(void);
+int spu_reservation_version_locked(uint32_t line_ea, uint64_t* version);
+void spu_reservation_bump_locked(uint32_t line_ea);
+
+void spu_reservation_notify_write(uint32_t ea, uint32_t size);
+
+/* Ordered plain DMA PUT. On hardware a PUT that touches a reserved line kills
+ * the reservation, so a PUTLLC racing it fails and retries. A plain host
+ * memcpy can instead land between a PUTLLC's compare and its commit and be
+ * overwritten. While the calling thread's flag is set (job-chain lane windows
+ * only, TJ_JOBCHAIN_LANES>=2), the DMA PUT path copies under the reservation
+ * lock and bumps every touched line's version. Off, nothing changes.
+ * set_put_ordered returns the previous value for the caller to restore. */
+int spu_reservation_set_put_ordered(int on);
+int spu_reservation_put_ordered(void);
+void spu_reservation_put_copy(uint32_t ea, void* dst, const void* src,
+                              uint32_t size);
+int spu_reservation_compare_exchange64(uint32_t ea, uint64_t* expected,
+                                       uint64_t desired);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SPU_RESERVATION_H */
diff --git a/runtime/spu/spu_smc_ops.h b/runtime/spu/spu_smc_ops.h
new file mode 100644
index 0000000..d713f4e
--- /dev/null
+++ b/runtime/spu/spu_smc_ops.h
@@ -0,0 +1,89 @@
+/* Small non-branch opcode set used by runtime-generated WWS SPU stubs. */
+#ifndef PS3RECOMP_SPU_SMC_OPS_H
+#define PS3RECOMP_SPU_SMC_OPS_H
+
+#include "spu_context.h"
+#include "spu_helpers.h"
+
+static inline int spu_smc_execute_nonbranch(spu_context* ctx, uint32_t word)
+{
+    const uint32_t op11 = word >> 21;
+    const uint32_t op7 = word >> 25;
+    const uint32_t op4 = word >> 28;
+    const uint32_t rt = word & 0x7F;
+    const uint32_t rt4 = (word >> 21) & 0x7F;
+    const uint32_t ra = (word >> 7) & 0x7F;
+    const uint32_t rb = (word >> 14) & 0x7F;
+    const uint32_t rc = word & 0x7F;
+    const uint32_t i7 = (word >> 14) & 0x7F;
+    const int32_t i10 = (int32_t)(word << 8) >> 22;
+    const uint32_t i16 = (word >> 7) & 0xFFFF;
+
+    if (op4 == 0xB) { /* shufb rt,ra,rb,rc */
+        ctx->gpr[rt4] = spu_shufb(ctx->gpr[ra], ctx->gpr[rb], ctx->gpr[rc]);
+        return 1;
+    }
+    if (op11 == 0x1DC) { /* rotqby rt,ra,rb */
+        ctx->gpr[rt] = spu_rotqby(ctx->gpr[ra], ctx->gpr[rb]);
+        return 1;
+    }
+    if (op11 == 0x144 || op11 == 0x1C4) { /* stqx / lqx rt,ra,rb */
+        uint32_t lsa = ctx->gpr[ra]._u32[0] + ctx->gpr[rb]._u32[0];
+        if (op11 == 0x144)
+            spu_ls_write128(ctx, lsa, ctx->gpr[rt]);
+        else
+            ctx->gpr[rt] = spu_ls_read128(ctx, lsa);
+        return 1;
+    }
+    if (op11 == 0x1FC) { /* rotqbyi rt,ra,i7 */
+        ctx->gpr[rt] = spu_rotqbyi(ctx->gpr[ra], (int)(int8_t)i7);
+        return 1;
+    }
+    if (op11 == 0x2B6) { /* xsbh rt,ra */
+        ctx->gpr[rt] = spu_xsbh(ctx->gpr[ra]);
+        return 1;
+    }
+    if (op11 == 0x2C2) { /* fcgt rt,ra,rb */
+        ctx->gpr[rt] = spu_fcgt(ctx->gpr[ra], ctx->gpr[rb]);
+        return 1;
+    }
+    if (op11 == 0x2C6) { /* fm rt,ra,rb */
+        ctx->gpr[rt] = spu_fm(ctx->gpr[ra], ctx->gpr[rb]);
+        return 1;
+    }
+    if ((word >> 24) == 0x4E) { /* cgtbi rt,ra,i10 */
+        ctx->gpr[rt] = spu_cgtbi(ctx->gpr[ra], i10);
+        return 1;
+    }
+    if ((word >> 23) == 0x065) { /* fsmbi rt,i16 */
+        ctx->gpr[rt] = spu_fsmbi((int32_t)i16);
+        return 1;
+    }
+    if (op11 >= 0x1F4 && op11 <= 0x1F7) { /* cbd/chd/cwd/cdd rt,ra,i7 */
+        switch (op11) {
+        case 0x1F4:
+            ctx->gpr[rt] = spu_cbd(ctx->gpr[ra], (int)i7);
+            break;
+        case 0x1F5:
+            ctx->gpr[rt] = spu_chd(ctx->gpr[ra], (int)i7);
+            break;
+        case 0x1F6:
+            ctx->gpr[rt] = spu_cwd(ctx->gpr[ra], (int)i7);
+            break;
+        default:
+            ctx->gpr[rt] = spu_cdd(ctx->gpr[ra], (int)i7);
+            break;
+        }
+        return 1;
+    }
+    if (op11 == 0x1FF) { /* shlqbyi rt,ra,i7 */
+        ctx->gpr[rt] = spu_shlqbyi(ctx->gpr[ra], (int)(int8_t)i7);
+        return 1;
+    }
+    if (op7 == 0x08 || op7 == 0x09) { /* hbra / hbrr performance hints */
+        return 1;
+    }
+    return 0;
+}
+
+#endif
