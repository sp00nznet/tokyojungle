+        (1u << 18) | (((NV4097_SET_TRANSFORM_CONSTANT_LOAD >> 2) & 0x7FF) << 2), 4,
+        (8u << 18) | (((NV4097_SET_TRANSFORM_CONSTANT >> 2) & 0x7FF) << 2),
+        values[0], values[1], values[2], values[3],
+        values[4], values[5], values[6], values[7]
+    };
