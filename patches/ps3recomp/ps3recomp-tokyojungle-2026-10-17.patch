+static void tj_compose_capture_copy_after_replay(void)
+{
+    if (!s_tj_compose_capture.copy_active ||
+        s_tj_compose_capture.selected_slot < 0 ||
+        s_tj_compose_capture.selected_slot >= MAX_DISPLAY_SURFACES)
+        return;
+    DisplaySurface* s = &s_d3d.display_surface[s_tj_compose_capture.selected_slot];
+    tj_compose_capture_queue("copy_selected_after_replay", s->res, 0, 0, s->w, s->h,
+                             DXGI_FORMAT_R8G8B8A8_UNORM, s->st);
+}
