+static u32 d3d12_display_vblank_query_refresh(IDXGIOutput* output, HMONITOR* monitor,
+                                              WCHAR* device, int device_chars)
+{
+    DXGI_OUTPUT_DESC desc;
+    DEVMODEW mode;
+    memset(&desc, 0, sizeof(desc));
+    memset(&mode, 0, sizeof(mode));
+    mode.dmSize = sizeof(mode);
+    *monitor = NULL;
+    device[0] = L'\0';
+    if (FAILED(output->lpVtbl->GetDesc(output, &desc))) return 0;
+    *monitor = desc.Monitor;
+    lstrcpynW(device, desc.DeviceName, device_chars);
+    /* 0 and 1 mean "hardware default", i.e. unknown. */
+    if (!EnumDisplaySettingsW(desc.DeviceName, ENUM_CURRENT_SETTINGS, &mode) ||
+        mode.dmDisplayFrequency <= 1)
