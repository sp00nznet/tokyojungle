--- /dev/null
+++ b/libs/video/rsx_fp_probe_inject.h
@@ -0,0 +1,181 @@
+#ifndef RSX_FP_PROBE_INJECT_H
+#define RSX_FP_PROBE_INJECT_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+/* Unsigned 1-8 digit hexadecimal parser: no whitespace, sign, or overflow. */
+static int rsx_fp_probe_parse_u32_hex(const char* value, uint32_t* out_value)
+{
+    const char* p = value;
+    if (!p || !out_value) return 0;
+    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) p += 2;
+    uint32_t parsed = 0;
+    unsigned digits = 0;
+    for (; *p; ++p) {
+        unsigned nibble;
+        if (*p >= '0' && *p <= '9') nibble = (unsigned)(*p - '0');
+        else if (*p >= 'a' && *p <= 'f') nibble = (unsigned)(*p - 'a') + 10;
+        else if (*p >= 'A' && *p <= 'F') nibble = (unsigned)(*p - 'A') + 10;
+        else return 0;
+        if (digits++ == 8) return 0;
+        parsed = (parsed << 4) | nibble;
+    }
+    if (!digits) return 0;
+    *out_value = parsed;
+    return 1;
+}
+
+static int rsx_fp_probe_target_matches(const char* value, uint32_t fp_addr)
+{
+    uint32_t target;
+    return rsx_fp_probe_parse_u32_hex(value, &target) && target == fp_addr;
+}
+
+/* Inject after all translated FP instructions, directly before generated
+ * exports/alpha test.  Returns zero without changing hlsl if any prerequisite
+ * declaration, marker, or capacity check fails. */
+static int rsx_fp_probe_stagegrid_inject(char* hlsl, size_t capacity)
+{
+    static const char marker[] = "    PSOut _po;";
+    static const char injected[] =
+        "    int _tj_fp_stage_band = (int)(input.position.x / (1280.0 / 7.0));\n"
+        "    _tj_fp_stage_band = min(6, max(0, _tj_fp_stage_band));\n"
+        "    float3 _tj_fp_stage_rgb;\n"
+        "    if (_tj_fp_stage_band == 0) _tj_fp_stage_rgb = rsx_tex0.Sample(rsx_samp0, (input.tc1.xy / input.tc1.w) * rsx_texscale[0].xy).rgb;\n"
+        "    else if (_tj_fp_stage_band == 1) _tj_fp_stage_rgb = float3(frac(input.tc1.xy / input.tc1.w), 0);\n"
+        "    else if (_tj_fp_stage_band == 2) _tj_fp_stage_rgb = r[0].xxx;\n"
+        "    else if (_tj_fp_stage_band == 3) _tj_fp_stage_rgb = rsx_tex1.Sample(rsx_samp1, input.tc0.xy * rsx_texscale[1].xy).rgb * input.col0.rgb;\n"
+        "    else if (_tj_fp_stage_band == 4) _tj_fp_stage_rgb = h[7].www;\n"
+        "    else if (_tj_fp_stage_band == 5) _tj_fp_stage_rgb = h[2].rgb;\n"
+        "    else _tj_fp_stage_rgb = h[0].rgb;\n"
+        "    PSOut _tj_fp_stage_out = (PSOut)0;\n"
+        "    _tj_fp_stage_out.c0 = float4(_tj_fp_stage_rgb, 1);\n"
+        "    return _tj_fp_stage_out;\n";
+    size_t length = 0;
+    while (length < capacity && hlsl[length]) ++length;
+    if (length == capacity ||
+        !strstr(hlsl, "float4 position : SV_POSITION") ||
+        !strstr(hlsl, "float4 col0 : COLOR0") ||
+        !strstr(hlsl, "tc0:TEXCOORD0") || !strstr(hlsl, "tc1:TEXCOORD1") ||
+        !strstr(hlsl, "rsx_tex0 : register(t0)") ||
+        !strstr(hlsl, "rsx_tex1 : register(t1)") ||
+        !strstr(hlsl, "rsx_samp0 : register(s0)") ||
+        !strstr(hlsl, "rsx_samp1 : register(s1)") ||
+        !strstr(hlsl, "rsx_texscale[4]") ||
+        !strstr(hlsl, "float4 r[48]; float4 h[48];")) return 0;
+    char* export_marker = strstr(hlsl, marker);
+    size_t insert_size = sizeof(injected) - 1;
+    if (!export_marker || insert_size > capacity - length - 1) return 0;
+    size_t offset = (size_t)(export_marker - hlsl);
+    memmove(hlsl + offset + insert_size, hlsl + offset, length - offset + 1);
+    memcpy(hlsl + offset, injected, insert_size);
+    return 1;
+}
+
+/* Target FP late-path grid.  This samples values which still exist directly
+ * before the generated export, so it does not need to alter any translated
+ * instruction.  A changed input/decompiler declaration fails closed. */
+static int rsx_fp_probe_lategrid_inject(char* hlsl, size_t capacity)
+{
+    static const char marker[] = "    PSOut _po;";
+    static const char injected[] =
+        "    int _tj_fp_late_band = (int)(input.position.x / (1280.0 / 7.0));\n"
+        "    _tj_fp_late_band = min(6, max(0, _tj_fp_late_band));\n"
+        "    float3 _tj_fp_late_rgb;\n"
+        "    if (_tj_fp_late_band == 0) _tj_fp_late_rgb = rsx_tex1.Sample(rsx_samp1, input.tc0.xy * rsx_texscale[1].xy).rgb * input.col0.rgb;\n"
+        "    else if (_tj_fp_late_band == 1) _tj_fp_late_rgb = h[7].www;\n"
+        "    else if (_tj_fp_late_band == 2) _tj_fp_late_rgb = h[2].rgb;\n"
+        "    else if (_tj_fp_late_band == 3) _tj_fp_late_rgb = input.fog.yyy;\n"
+        "    else if (_tj_fp_late_band == 4) _tj_fp_late_rgb = h[2].www;\n"
+        "    else if (_tj_fp_late_band == 5) _tj_fp_late_rgb = r[1].www;\n"
+        "    else _tj_fp_late_rgb = h[0].rgb;\n"
+        "    PSOut _tj_fp_late_out = (PSOut)0;\n"
+        "    _tj_fp_late_out.c0 = float4(_tj_fp_late_rgb, 1);\n"
+        "    return _tj_fp_late_out;\n";
+    size_t length = 0;
+    while (length < capacity && hlsl[length]) ++length;
+    if (length == capacity ||
+        !strstr(hlsl, "float4 position : SV_POSITION") ||
+        !strstr(hlsl, "float4 col0 : COLOR0") ||
+        !strstr(hlsl, "float4 fog : FOG") ||
+        !strstr(hlsl, "tc0:TEXCOORD0") ||
+        !strstr(hlsl, "rsx_tex1 : register(t1)") ||
+        !strstr(hlsl, "rsx_samp1 : register(s1)") ||
+        !strstr(hlsl, "rsx_texscale[4]") ||
+        !strstr(hlsl, "float4 r[48]; float4 h[48];")) return 0;
+    char* export_marker = strstr(hlsl, marker);
+    size_t insert_size = sizeof(injected) - 1;
+    if (!export_marker || insert_size > capacity - length - 1) return 0;
+    size_t offset = (size_t)(export_marker - hlsl);
+    memmove(hlsl + offset + insert_size, hlsl + offset, length - offset + 1);
+    memcpy(hlsl + offset, injected, insert_size);
+    return 1;
+}
+
+/* Target-program-only TXP repair. Match the full generated t0/TEXCOORD1
+ * expression, rather than any generic TXP lowering, so a changed decompiler
+ * spelling or another projected sample fails closed without mutation. */
+static int rsx_fp_probe_txp_zeroq_inject(char* hlsl, size_t capacity)
+{
+    static const char old_sample[] =
+        "rsx_tex0.Sample(rsx_samp0, ((input.tc1).xyzw).xy / ((input.tc1).xyzw).w * rsx_texscale[0].xy)";
+    static const char new_sample[] =
+        "rsx_tex0.Sample(rsx_samp0, _tj_txp_zeroq(((input.tc1).xyzw).xy, ((input.tc1).xyzw).w, rsx_texscale[0].xy))";
+    static const char main_marker[] = "PSOut main(PSInput input) {\n";
+    static const char helper[] =
+        "float2 _tj_txp_zeroq(float2 xy, float q, float2 scale) {\n"
+        "    return q == 0.0 ? float2(0,0) : (xy / q) * scale;\n"
+        "}\n";
+    size_t length = 0;
+    while (length < capacity && hlsl[length]) ++length;
+    if (length == capacity) return 0;
+    char* sample = strstr(hlsl, old_sample);
+    char* main = strstr(hlsl, main_marker);
+    if (!sample || !main || strstr(sample + sizeof(old_sample) - 1, old_sample)) return 0;
+    size_t old_size = sizeof(old_sample) - 1;
+    size_t new_size = sizeof(new_sample) - 1;
+    size_t helper_size = sizeof(helper) - 1;
+    if (new_size - old_size > capacity - length - 1 ||
+        helper_size > capacity - (length + new_size - old_size) - 1) return 0;
+    size_t sample_offset = (size_t)(sample - hlsl);
+    memmove(hlsl + sample_offset + new_size, hlsl + sample_offset + old_size,
+            length - sample_offset - old_size + 1);
+    memcpy(hlsl + sample_offset, new_sample, new_size);
+    length += new_size - old_size;
+    main = strstr(hlsl, main_marker);
+    size_t main_offset = (size_t)(main - hlsl);
+    memmove(hlsl + main_offset + helper_size, hlsl + main_offset,
+            length - main_offset + 1);
+    memcpy(hlsl + main_offset, helper, helper_size);
+    return 1;
+}
+
+/* Screen-space t0 scan for one target FP.  All prerequisites are generated
+ * declarations; a changed decompiler spelling leaves HLSL untouched. */
+static int rsx_fp_probe_t0_screen_inject(char* hlsl, size_t capacity)
+{
+    static const char entry_marker[] = "PSOut main(PSInput input) {\n";
+    static const char injected[] =
+        "    float2 _tj_fp_probe_t0_uv = saturate(input.position.xy * float2(1.0/1280.0,1.0/720.0)) * rsx_texscale[0].xy;\n"
+        "    float4 _tj_fp_probe_t0_s = rsx_tex0.Sample(rsx_samp0, _tj_fp_probe_t0_uv);\n"
+        "    PSOut _tj_fp_probe_t0_out = (PSOut)0;\n"
+        "    _tj_fp_probe_t0_out.c0 = float4(_tj_fp_probe_t0_s.r, _tj_fp_probe_t0_s.g, max(_tj_fp_probe_t0_s.b, _tj_fp_probe_t0_s.a), 1);\n"
+        "    return _tj_fp_probe_t0_out;\n";
+    size_t length = 0;
+    while (length < capacity && hlsl[length]) ++length;
+    if (length == capacity || !strstr(hlsl, "float4 position : SV_POSITION") ||
+        !strstr(hlsl, "rsx_tex0 : register(t0)") ||
+        !strstr(hlsl, "rsx_samp0 : register(s0)") ||
+        !strstr(hlsl, "rsx_texscale[4]")) return 0;
+    char* entry = strstr(hlsl, entry_marker);
+    size_t insert_size = sizeof(injected) - 1;
+    if (!entry || insert_size > capacity - length - 1) return 0;
+    size_t offset = (size_t)(entry - hlsl) + sizeof(entry_marker) - 1;
+    memmove(hlsl + offset + insert_size, hlsl + offset, length - offset + 1);
+    memcpy(hlsl + offset, injected, insert_size);
+    return 1;
+}
+
+#endif
diff --git a/libs/video/rsx_ordered_display_alias.h b/libs/video/rsx_ordered_display_alias.h
new file mode 100644
index 0000000..f5f61fb
--- /dev/null
+++ b/libs/video/rsx_ordered_display_alias.h
@@ -0,0 +1,206 @@
+/* Pure FIFO-order predicate shared by the deferred D3D12 alias path and its
+ * no-D3D regression test. A later copy must never retarget an earlier read. */
+#ifndef PS3RECOMP_RSX_ORDERED_DISPLAY_ALIAS_H
+#define PS3RECOMP_RSX_ORDERED_DISPLAY_ALIAS_H
+
+#include <stdint.h>
+
+typedef struct rsx_display_alias_surface {
+    uint32_t raw;
+    uint32_t pitch;
+    uint32_t width;
+    uint32_t height;
+} rsx_display_alias_surface;
+
+/* Strict history aliases are exactly the next equal-stride allocation after
+ * two registered, equal-geometry display parents. */
+static inline int rsx_display_history_alias_parents(
+    const rsx_display_alias_surface* first,
+    const rsx_display_alias_surface* second,
+    const rsx_display_alias_surface* alias,
+    uint32_t* first_raw_out, uint32_t* second_raw_out)
+{
+    if (!first || !second || !alias || second->raw <= first->raw ||
+        first->pitch != second->pitch || first->width != second->width ||
+        first->height != second->height || alias->pitch != first->pitch ||
+        alias->width != first->width || alias->height != first->height)
+        return 0;
+    uint64_t stride = (uint64_t)second->raw - first->raw;
+    if ((uint64_t)second->raw + stride != alias->raw)
+        return 0;
+    if (first_raw_out) *first_raw_out = first->raw;
+    if (second_raw_out) *second_raw_out = second->raw;
+    return 1;
+}
+
+/* Records the only permitted metadata parent pair for one alias. Identical
+ * entries (including a duplicate traversal) keep the selection; a different
+ * matching pair makes ownership ambiguous. */
+static inline int rsx_display_history_alias_select_unique_pair(
+    const rsx_display_alias_surface* first,
+    const rsx_display_alias_surface* second,
+    const rsx_display_alias_surface* alias,
+    uint32_t* selected_first_raw, uint32_t* selected_second_raw,
+    int* have_selected)
+{
+    uint32_t first_raw, second_raw;
+    if (!rsx_display_history_alias_parents(first, second, alias,
+                                           &first_raw, &second_raw))
+        return 0;
+    if (!selected_first_raw || !selected_second_raw || !have_selected)
+        return -1;
+    if (!*have_selected) {
+        *selected_first_raw = first_raw;
+        *selected_second_raw = second_raw;
+        *have_selected = 1;
+        return 1;
+    }
+    return (*selected_first_raw == first_raw &&
+            *selected_second_raw == second_raw) ? 1 : -1;
+}
+
+static inline int rsx_ordered_display_alias_copy_precedes(
+    uint32_t reader_record, uint32_t copy_record, int copy_prepared,
+    int copy_dst_is_display, int copy_dst_slot, int wanted_display_slot)
+{
+    return copy_record < reader_record && copy_prepared &&
+        copy_dst_is_display && copy_dst_slot == wanted_display_slot;
+}
+
+/* A live parent may be assembled by adjacent exact copies.  Keep this small
+ * pure union proof separate from persistent DisplaySurface coverage: it only
+ * considers prepared copies preceding this one reader and can be replayed with
+ * `executed_only` to prove the same contributing rectangles actually ran. */
+#define RSX_ORDERED_DISPLAY_ALIAS_MAX_COPY_RECTS 32
+typedef enum rsx_ordered_display_alias_copy_proof {
+    RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_ERROR = -1,
+    RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_NO = 0,
+    RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_YES = 1,
+} rsx_ordered_display_alias_copy_proof;
+
+typedef struct rsx_ordered_display_alias_copy_rect {
+    uint32_t record;
+    uint32_t x, y, w, h;
+    int prepared;
+    int executed;
+    int dst_is_display;
+    int dst_slot;
+} rsx_ordered_display_alias_copy_rect;
+
+static inline int rsx_ordered_display_alias_copy_union_covers(
+    const rsx_ordered_display_alias_copy_rect* copies, uint32_t count,
+    uint32_t reader_record, int wanted_display_slot, int executed_only,
+    uint32_t want_x, uint32_t want_y, uint32_t want_w, uint32_t want_h,
+    int* latest_copy_out)
+{
+    uint32_t x_cut[RSX_ORDERED_DISPLAY_ALIAS_MAX_COPY_RECTS * 2 + 2];
+    uint32_t n = 2;
+    int latest = -1;
+    uint64_t want_x_end, want_y_end;
+    if (latest_copy_out) *latest_copy_out = -1;
+    if (!copies || count > RSX_ORDERED_DISPLAY_ALIAS_MAX_COPY_RECTS ||
+        !want_w || !want_h)
+        return RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_ERROR;
+    want_x_end = (uint64_t)want_x + want_w;
+    want_y_end = (uint64_t)want_y + want_h;
+    if (want_x_end > UINT32_MAX || want_y_end > UINT32_MAX)
+        return RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_ERROR;
+    x_cut[0] = want_x;
+    x_cut[1] = (uint32_t)want_x_end;
+    for (uint32_t i = 0; i < count; ++i) {
+        const rsx_ordered_display_alias_copy_rect* c = &copies[i];
+        uint64_t x_end, y_end;
+        if (!rsx_ordered_display_alias_copy_precedes(
+                reader_record, c->record, c->prepared, c->dst_is_display,
+                c->dst_slot, wanted_display_slot) ||
+            (executed_only && !c->executed))
+            continue;
+        x_end = (uint64_t)c->x + c->w;
+        y_end = (uint64_t)c->y + c->h;
+        if (!c->w || !c->h || x_end > UINT32_MAX || y_end > UINT32_MAX)
+            return RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_ERROR;
+        if (c->x >= want_x_end || c->y >= want_y_end ||
+            x_end <= want_x || y_end <= want_y)
+            continue;
+        x_cut[n++] = c->x < want_x ? want_x : c->x;
+        x_cut[n++] = x_end > want_x_end ? (uint32_t)want_x_end : (uint32_t)x_end;
+        if ((int)c->record > latest) latest = (int)c->record;
+    }
+    for (uint32_t i = 1; i < n; ++i) {
+        uint32_t v = x_cut[i], j = i;
+        while (j && x_cut[j - 1] > v) { x_cut[j] = x_cut[j - 1]; --j; }
+        x_cut[j] = v;
+    }
+    for (uint32_t xi = 0; xi + 1 < n; ++xi) {
+        uint32_t left = x_cut[xi], right = x_cut[xi + 1], covered = want_y;
+        if (left == right) continue;
+        for (;;) {
+            uint32_t best = covered;
+            for (uint32_t i = 0; i < count; ++i) {
+                const rsx_ordered_display_alias_copy_rect* c = &copies[i];
+                uint64_t x_end, y_end;
+                if (!rsx_ordered_display_alias_copy_precedes(
+                        reader_record, c->record, c->prepared, c->dst_is_display,
+                        c->dst_slot, wanted_display_slot) ||
+                    (executed_only && !c->executed))
+                    continue;
+                x_end = (uint64_t)c->x + c->w;
+                y_end = (uint64_t)c->y + c->h;
+                if (!c->w || !c->h || x_end > UINT32_MAX || y_end > UINT32_MAX)
+                    return RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_ERROR;
+                if (c->x > left || x_end < right || c->y > covered || y_end <= covered)
+                    continue;
+                if (y_end > best) best = y_end > want_y_end ?
+                    (uint32_t)want_y_end : (uint32_t)y_end;
+            }
+            if (best == covered) return RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_NO;
+            covered = best;
+            if (covered >= want_y_end) break;
+        }
+    }
+    if (latest < 0) return RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_NO;
+    if (latest_copy_out) *latest_copy_out = latest;
+    return RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_YES;
+}
+
+/* A history alias has no fixed parent. It becomes live only when exactly one
+ * parent DisplaySurface has a preceding exact-copy producer. */
+static inline int rsx_ordered_display_alias_unique_owner(
+    int first_slot, int second_slot, int first_prior, int second_prior)
+{
+    int first_live = first_slot >= 0 && first_prior;
+    int second_live = second_slot >= 0 && second_prior;
+    return first_live == second_live ? -1 : (first_live ? first_slot : second_slot);
+}
+
+/* Corrupt/capped proof for either existing parent is not evidence that the
+ * other parent owns the alias. Keep the read on history/null instead. */
+static inline int rsx_ordered_display_alias_unique_owner_proofs(
+    int first_slot, int second_slot, int first_proof, int second_proof)
+{
+    if ((first_slot >= 0 && first_proof == RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_ERROR) ||
+        (second_slot >= 0 && second_proof == RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_ERROR))
+        return -1;
+    return rsx_ordered_display_alias_unique_owner(
+        first_slot, second_slot,
+        first_proof == RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_YES,
+        second_proof == RSX_ORDERED_DISPLAY_ALIAS_COPY_PROOF_YES);
+}
+
+/* A recognized display read is terminal: live ownership, completed history,
+ * or an explicit null SRV. It must not fall through to another resource class. */
+typedef enum rsx_ordered_display_alias_route {
+    RSX_ORDERED_DISPLAY_ALIAS_ROUTE_NULL = 0,
+    RSX_ORDERED_DISPLAY_ALIAS_ROUTE_HISTORY,
+    RSX_ORDERED_DISPLAY_ALIAS_ROUTE_LIVE,
+} rsx_ordered_display_alias_route;
+
+static inline rsx_ordered_display_alias_route
+rsx_ordered_display_alias_terminal_route(int live_owner, int history_available)
+{
+    return live_owner >= 0 ? RSX_ORDERED_DISPLAY_ALIAS_ROUTE_LIVE :
+        (history_available ? RSX_ORDERED_DISPLAY_ALIAS_ROUTE_HISTORY :
+                             RSX_ORDERED_DISPLAY_ALIAS_ROUTE_NULL);
+}
+
+#endif /* PS3RECOMP_RSX_ORDERED_DISPLAY_ALIAS_H */
diff --git a/libs/video/rsx_prompt_atlas.c b/libs/video/rsx_prompt_atlas.c
new file mode 100644
index 0000000..d996847
--- /dev/null
+++ b/libs/video/rsx_prompt_atlas.c
@@ -0,0 +1,517 @@
+/*
+ * ps3recomp - PC key prompts inside the game's DXT5 UI atlases
+ * (see rsx_prompt_atlas.h)
+ *
+ * Rects come from the decoded US (NPUA80523) packs: art rect = bbox of the
+ * glyph's connected alpha>0 component(s); clear rect = art + 2 px, clipped
+ * to the sprite's UV cell (ELF table 0x27D340, normalised to 1024x512) and
+ * to neighbouring art. Hashes are XXH64 seed 0 of the payload after the
+ * 16-byte TJPACK entry header.
+ *
+ * Compiled only when PS3RECOMP_PROMPT_ART is defined.
+ */
+
+#ifdef PS3RECOMP_PROMPT_ART
+
+#include "rsx_prompt_atlas.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+/* Colour of transparent margin texels: the key-cap plate (#101318), so
+ * bilinear filtering at the cell edge darkens instead of fringing. */
+#define TPA_CLEAR_R 0x10
+#define TPA_CLEAR_G 0x13
+#define TPA_CLEAR_B 0x18
+
+#define K  PAD_PROMPT_STYLE_KEY
+#define P  PAD_PROMPT_STYLE_PLATE
+#define D  PAD_PROMPT_STYLE_DPAD
+#define KT PAD_PROMPT_STYLE_KEY_TEXT
+#define LU PAD_PROMPT_LIT_UP
+#define LD PAD_PROMPT_LIT_DOWN
+#define LL PAD_PROMPT_LIT_LEFT
+#define LR PAD_PROMPT_LIT_RIGHT
+
+/* lang/EN/effectTexPack_EN.pac[0]: in-game key guide / tutorial atlas,
+ * 1024x512 DXT5. Drawn through func_000FDD3C (ELF table 0x27D340). Not
+ * redrawn here: '+' idx26, arrow idx34, stick tilt frames idx37-48 and the
+ * mission banners. */
+static const TjPromptCell k_effect_en0_cells[] = {
+    /* name                         art rect           clear rect          style button                lit      caption */
+    {"idx9 dpad (down lit)",        2, 131,  61, 189,   0, 129,  63, 191,  D,  PAD_PROMPT_GROUP_DPAD,  LD,      NULL},
+    {"idx7 dpad (left+right lit)",  2, 197,  61, 255,   0, 195,  63, 256,  D,  PAD_PROMPT_GROUP_DPAD,  LL | LR, NULL},
+    {"idx10 dpad (up+down lit)",    2, 262,  61, 320,   0, 260,  63, 320,  D,  PAD_PROMPT_GROUP_DPAD,  LU | LD, NULL},
+    {"idx11 triangle",             67, 134, 122, 189,  65, 132, 124, 191,  K,  PAD_PROMPT_TRIANGLE,    0,       NULL},
+    {"idx12 circle",              131, 133, 186, 188, 129, 131, 188, 190,  K,  PAD_PROMPT_CIRCLE,      0,       NULL},
