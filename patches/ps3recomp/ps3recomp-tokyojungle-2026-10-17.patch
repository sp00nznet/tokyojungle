+/* Build (or fetch) a PSO pairing the current decompiled VS with the guest's
+ * FRAGMENT program at fp_addr: read the FP ucode from guest memory, decompile
+ * to HLSL (rsx_fp_decompiler), compile, and cache. This replaces the two
+ * hardcoded pixel shaders for draws whose FP we can translate -- e.g.
+ * gcm/cube's plasma FP `c = tex2D(t0, uv).x; out = (c, 0, c, 1)`. */
+#include "rsx_fp_probe_inject.h"
+
+static int tj_parse_u32_hex(const char* value, u32* out_value)
+{
+    uint32_t parsed;
+    if (!out_value || !rsx_fp_probe_parse_u32_hex(value, &parsed)) return 0;
+    *out_value = (u32)parsed;
+    return 1;
+}
+
+static int tj_env_u32_hex(const char* name, u32* out_value)
+{
+    const char* value = getenv(name);
+    return value && tj_parse_u32_hex(value, out_value);
+}
+
+static int tj_fp_force_selected(u32 fp_addr)
+{
+    const char* value = getenv("FP_FORCE");
+    u32 wanted;
+    if (!value) return 0;
+    if (strcmp(value, "1") == 0) return 1;
+    return tj_parse_u32_hex(value, &wanted) && wanted == fp_addr;
+}
+
+/* Return before translated instructions, OP_KIL, and generated alpha testing.
+ * The caller owns the fixed HLSL buffer. */
+static int tj_fp_force_inject(char* hlsl, size_t capacity)
+{
+    static const char entry_marker[] = "PSOut main(PSInput input) {\n";
+    static const char injected[] =
+        "    PSOut _tj_fp_force_out = (PSOut)0;\n"
+        "    _tj_fp_force_out.c0 = float4(1,0,1,1);\n"
+        "    return _tj_fp_force_out;\n";
+    size_t length = 0;
+    while (length < capacity && hlsl[length]) ++length;
+    if (length == capacity) return 0;
+
+    char* entry = strstr(hlsl, entry_marker);
+    size_t insert_size = sizeof(injected) - 1;
+    if (!entry || insert_size > capacity - length - 1) return 0;
+
+    size_t offset = (size_t)(entry - hlsl) + sizeof(entry_marker) - 1;
+    memmove(hlsl + offset + insert_size, hlsl + offset, length - offset + 1);
+    memcpy(hlsl + offset, injected, insert_size);
+    return 1;
+}
+
+static int tj_fp_probe_t1_selected(u32 fp_addr)
+{
+    u32 target;
+    return tj_env_u32_hex("TJ_FP_PROBE_T1", &target) && target == fp_addr;
+}
+
+static int tj_fp_probe_stagegrid_selected(u32 fp_addr)
+{
+    return rsx_fp_probe_target_matches(getenv("TJ_FP_PROBE_STAGEGRID"), fp_addr);
+}
+
+static int tj_fp_probe_lategrid_selected(u32 fp_addr)
+{
+    return fp_addr == 0x07600741u &&
+           rsx_fp_probe_target_matches(getenv("TJ_FP_PROBE_LATEGRID"), fp_addr);
+}
+
+static int tj_fp_probe_t0_selected(u32 fp_addr)
+{
+    return fp_addr == 0x07600741u &&
+           rsx_fp_probe_target_matches(getenv("TJ_FP_PROBE_T0"), fp_addr);
+}
+
+static int tj_txp_zeroq_selected(u32 fp_addr)
+{
+    return fp_addr == 0x07600741u &&
+           rsx_fp_probe_target_matches(getenv("TJ_TXP_ZEROQ_FP"), fp_addr);
+}
+
+/* Target-only sampler probe.  Keep this separate from FP_FORCE: it samples
+ * the normal bound t1 using the target program's declared tc0 interpolator. */
+static int tj_fp_probe_t1_inject(char* hlsl, size_t capacity)
+{
+    static const char entry_marker[] = "PSOut main(PSInput input) {\n";
+    static const char injected[] =
+        "    PSOut _tj_fp_probe_t1_out = (PSOut)0;\n"
+        "    _tj_fp_probe_t1_out.c0 = rsx_tex1.Sample(rsx_samp1, input.tc0.xy * rsx_texscale[1].xy);\n"
+        "    _tj_fp_probe_t1_out.c0.a = 1;\n"
+        "    return _tj_fp_probe_t1_out;\n";
+    size_t length = 0;
+    while (length < capacity && hlsl[length]) ++length;
+    if (length == capacity || !strstr(hlsl, "rsx_tex1 : register(t1)") ||
+        !strstr(hlsl, "rsx_samp1 : register(s1)") ||
+        !strstr(hlsl, "tc0:TEXCOORD0")) return 0;
+    char* entry = strstr(hlsl, entry_marker);
+    size_t insert_size = sizeof(injected) - 1;
+    if (!entry || insert_size > capacity - length - 1) return 0;
+    size_t offset = (size_t)(entry - hlsl) + sizeof(entry_marker) - 1;
+    memmove(hlsl + offset + insert_size, hlsl + offset, length - offset + 1);
+    memcpy(hlsl + offset, injected, insert_size);
+    return 1;
+}
+
+#define TJ_FP_DUMP_TARGET_MAX 32
+typedef struct {
+    u32 fp_addr, uhash, vs_hash, blend, rtfmt, cmask, depth_key;
+    int vs_idx, nrt, exp32;
+} TjFpDumpTargetVariant;
+static TjFpDumpTargetVariant s_tj_fp_dump_target_variants[TJ_FP_DUMP_TARGET_MAX];
+static unsigned s_tj_fp_dump_target_count;
+
+static int tj_fp_dump_target_claim(u32 fp_addr, u32 uhash, u32 vs_hash,
+                                   int vs_idx, u32 blend, int nrt, u32 rtfmt,
+                                   int exp32, u32 cmask, u32 depth_key)
+{
+    for (unsigned i = 0; i < s_tj_fp_dump_target_count; ++i) {
+        TjFpDumpTargetVariant* v = &s_tj_fp_dump_target_variants[i];
+        if (v->fp_addr == fp_addr && v->uhash == uhash && v->vs_hash == vs_hash &&
+            v->vs_idx == vs_idx && v->blend == blend && v->nrt == nrt &&
+            v->rtfmt == rtfmt && v->exp32 == exp32 && v->cmask == cmask &&
+            v->depth_key == depth_key)
+            return 0;
+    }
+    if (s_tj_fp_dump_target_count >= TJ_FP_DUMP_TARGET_MAX) return 0;
+    TjFpDumpTargetVariant* v =
+        &s_tj_fp_dump_target_variants[s_tj_fp_dump_target_count++];
+    v->fp_addr = fp_addr; v->uhash = uhash; v->vs_hash = vs_hash;
+    v->vs_idx = vs_idx; v->blend = blend; v->nrt = nrt; v->rtfmt = rtfmt;
+    v->exp32 = exp32; v->cmask = cmask; v->depth_key = depth_key;
+    return 1;
+}
+
+static void tj_fp_dump_target_notes(FILE* file,
+                                    const RSXFPStructuralProgram* program,
+                                    const char* hlsl)
+{
+    static const char* tex_names[] = {"TEX", "TXP", "TXD", "TXL", "TXB"};
+    static const u32 tex_opcodes[] = {0x17, 0x18, 0x19, 0x2F, 0x31};
+    unsigned tex_counts[5][16] = {{0}};
+    for (u32 byte_off = 0, slot = 0; byte_off < program->size_bytes;) {
+        u32 word = byte_off / 4u;
+        u32 w0 = program->raw_words[word + 0u];
+        u32 opcode = (w0 >> 24) & 0x3Fu;
+        u32 unit = (w0 >> 17) & 0xFu;
+        for (unsigned i = 0; i < 5; ++i)
+            if (opcode == tex_opcodes[i]) ++tex_counts[i][unit];
+        byte_off += 16;
+        if (slot < program->inline_count &&
+            program->inline_word_index[slot] == byte_off / 4u) {
+            byte_off += 16;
+            ++slot;
+        }
+        if (w0 & 1u) break;
+    }
+    for (unsigned i = 0; i < 5; ++i) {
+        int any = 0;
+        fprintf(file, "texture_%s_units=", tex_names[i]);
+        for (unsigned unit = 0; unit < 16; ++unit) {
+            if (!tex_counts[i][unit]) continue;
+            fprintf(file, "%s%u:%u", any ? "," : "", unit, tex_counts[i][unit]);
+            any = 1;
+        }
+        fprintf(file, "%s\n", any ? "" : "none");
+    }
+
+    unsigned todo_count = 0, todo_listed = 0;
+    const char* cursor = hlsl;
+    while ((cursor = strstr(cursor, "/* TODO:")) != NULL) {
+        const char* end = strstr(cursor, "*/");
+        if (!end) break;
+        ++todo_count;
+        if (todo_listed < 32) {
+            /* Keep the outer metadata block valid HLSL: omit the generated
+             * comment delimiters from the copied TODO text. */
+            const char* todo_text = cursor + 3;
+            size_t todo_len = (size_t)(end - todo_text);
+            fprintf(file, "unsupported_hlsl_todo_%u=%.*s\n", todo_listed,
+                    (int)todo_len, todo_text);
+            ++todo_listed;
+        }
+        cursor = end + 2;
+    }
+    fprintf(file, "unsupported_hlsl_todo_count=%u\n", todo_count);
+}
