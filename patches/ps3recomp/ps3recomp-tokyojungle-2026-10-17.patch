+    if (outcome >= TJ_LABEL_EARLY_OUTCOME_COUNT) return;
+    const u64 now = GetTickCount64();
+    if (!epoch) epoch = now;
+    ++counts[outcome];
+    if (now - epoch < 1000) return;
+    if (tj_verbose_stats())
+        fprintf(stderr, "[tj-label-early] window_ms=%llu label_early=%llu fallback_pending_older=%llu "
+                "fallback_state=%llu fallback_records=%llu input_edges=%llu capacity_edges=%llu\n",
+                (unsigned long long)(now - epoch),
+                (unsigned long long)counts[TJ_LABEL_EARLY_PUBLISHED],
+                (unsigned long long)counts[TJ_LABEL_EARLY_PENDING_OLDER],
+                (unsigned long long)counts[TJ_LABEL_EARLY_STATE],
+                (unsigned long long)counts[TJ_LABEL_EARLY_RECORDS],
+                (unsigned long long)counts[TJ_LABEL_EARLY_INPUT_EDGE],
+                (unsigned long long)counts[TJ_LABEL_EARLY_CAPACITY_EDGE]);
