+static int d3d12_prefix_ownership_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_PREFIX_OWNERSHIP");
+        enabled = value && strcmp(value, "1") == 0;
+    }
+    return enabled;
+}
+
+/* Opt-in exact lookup shortcuts: 0 off (default), 1 use them, 2 audit. Audit
+ * computes the shortcut and the original scan, logs any disagreement, and
+ * always keeps the original scan's result. */
+static int tj_lookup_fastpath_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* value = getenv("TJ_LOOKUP_FASTPATH");
+        mode = value && strcmp(value, "1") == 0 ? 1 :
+               value && strcmp(value, "2") == 0 ? 2 : 0;
+        if (mode)
+            fprintf(stderr, "[tj-lookup-fastpath] enabled%s\n",
+                    mode == 2 ? " audit" : "");
+    }
+    return mode;
+}
+
+static void tj_lookup_fastpath_mismatch(const char* site, long long fast,
+                                        long long slow)
+{
+    static unsigned logs = 0;
+    /* Last-hit/hint probes may legitimately miss (fast=-1) and fall back to
+     * the scan; only a wrong positive is a mismatch there. prefix_object is a
+     * full membership mirror, so any disagreement counts. */
+    if (fast < 0 && strcmp(site, "prefix_object") != 0) return;
+    if (logs < 20u) {
+        ++logs;
+        fprintf(stderr, "[tj-lookup-fastpath] MISMATCH %s fast=%lld slow=%lld\n",
+                site, fast, slow);
+    }
+}
+
+/* TJ_LOOKUP_FASTPATH membership mirror of one owner's objects[] array:
+ * open-addressed cells hold objects[] index + 1 (0 = empty), pos[] records
+ * each entry's cell so a reset clears only occupied cells. The mirror is used
+ * only while count == object_count. objects[] remains the sole source of
+ * order, AddRef, capacity and halt behaviour. last memoizes one member; a
+ * member holds an AddRef, so its address cannot be reused while listed. */
+#define PREFIX_OBJECT_HASH_SIZE 16384u
+_Static_assert(PREFIX_OBJECT_HASH_SIZE >= 2u * PREFIX_OBJECT_CAP &&
+               (PREFIX_OBJECT_HASH_SIZE & (PREFIX_OBJECT_HASH_SIZE - 1u)) == 0,
+               "prefix object hash must be a power of two >= 2 * PREFIX_OBJECT_CAP");
+typedef struct {
+    u32 table[PREFIX_OBJECT_HASH_SIZE];
+    u32 pos[PREFIX_OBJECT_CAP];
+    u32 count;
+    const void* last;
+} D3D12PrefixObjectHash;
+static D3D12PrefixObjectHash s_prefix_object_hash[2];
+
+static u32 d3d12_prefix_object_hash_cell(const void* pointer)
+{
+    const u64 mixed = (u64)(size_t)pointer * 0x9E3779B97F4A7C15ull;
+    return (u32)(mixed >> 32) & (PREFIX_OBJECT_HASH_SIZE - 1u);
+}
+
+static void d3d12_prefix_object_hash_reset(D3D12PrefixObjectHash* hash)
+{
+    for (u32 i = 0; i < hash->count && i < PREFIX_OBJECT_CAP; ++i)
+        hash->table[hash->pos[i]] = 0;
+    hash->count = 0;
+    hash->last = NULL;
+}
+
+/* Append the entry for objects[hash->count]; the caller keeps them in step. */
+static void d3d12_prefix_object_hash_append(D3D12PrefixObjectHash* hash,
+                                            const D3D12PrefixOwner* owner)
+{
+    const u32 index = hash->count;
+    u32 cell = d3d12_prefix_object_hash_cell(owner->objects[index]);
+    while (hash->table[cell]) cell = (cell + 1u) & (PREFIX_OBJECT_HASH_SIZE - 1u);
+    hash->table[cell] = index + 1u;
+    hash->pos[index] = cell;
+    hash->count = index + 1u;
+}
+
+static void d3d12_prefix_object_hash_sync(D3D12PrefixObjectHash* hash,
+                                          const D3D12PrefixOwner* owner)
+{
+    if (hash->count == owner->object_count) return;
+    d3d12_prefix_object_hash_reset(hash);
+    while (hash->count < owner->object_count)
+        d3d12_prefix_object_hash_append(hash, owner);
+}
+
+static int d3d12_prefix_object_hash_contains(const D3D12PrefixObjectHash* hash,
+                                             const D3D12PrefixOwner* owner,
+                                             const void* object)
+{
+    if (hash->last == object) return 1;
+    /* At most PREFIX_OBJECT_CAP of the cells are occupied, so a probe always
+     * reaches an empty cell. */
+    for (u32 cell = d3d12_prefix_object_hash_cell(object);;
+         cell = (cell + 1u) & (PREFIX_OBJECT_HASH_SIZE - 1u)) {
+        const u32 entry = hash->table[cell];
+        if (!entry) return 0;
+        if (entry <= owner->object_count && owner->objects[entry - 1u] == object)
+            return 1;
+    }
+}
+
+static void vp_texture_snapshot_release (VPTexSnapshot** owner);
+
+/* D3D12 recording does not retain passed COM objects. RTV/DSV descriptors are
+ * consumed during recording; retain resources, not copies of their CPU heaps.
+ * Same-queue GPU writes/barriers keep their existing order. CPU overwrite and
+ * allocation recycling remain forbidden until checked completion. */
+static int d3d12_prefix_owner_object_capture(void* pointer)
+{
+    if (!s_d3d.prefix_owner_active || !pointer) return 0;
+    if (s_d3d.prefix_owner_active > 2 || s_d3d.gcm2d_backend_halted) {
+        gcm2d_backend_halt("prefix owner object active slot");
+        return -1;
+    }
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[s_d3d.prefix_owner_active - 1];
+    if (owner->phase != 1 || owner->object_count > PREFIX_OBJECT_CAP) {
+        gcm2d_backend_halt("prefix owner object reservation");
+        return -1;
+    }
+    IUnknown* object = (IUnknown*)pointer;
+    const int lookup_fast = tj_lookup_fastpath_mode();
+    D3D12PrefixObjectHash* hash = lookup_fast
+        ? &s_prefix_object_hash[s_d3d.prefix_owner_active - 1] : NULL;
+    if (hash) {
+        d3d12_prefix_object_hash_sync(hash, owner);
+        int found = d3d12_prefix_object_hash_contains(hash, owner, object);
+        if (lookup_fast == 2) {
+            int slow_found = 0;
+            for (u32 i = 0; i < owner->object_count; ++i)
+                if (owner->objects[i] == object) { slow_found = 1; break; }
+            if (found != slow_found)
+                tj_lookup_fastpath_mismatch("prefix_object", found, slow_found);
+            found = slow_found;
+        }
+        if (found) {
+            hash->last = object;
+            return 0;
+        }
+    } else {
+        for (u32 i = 0; i < owner->object_count; ++i)
+            if (owner->objects[i] == object) return 0;
+    }
+    if (owner->object_count == PREFIX_OBJECT_CAP) {
+        gcm2d_backend_halt("prefix owner object capacity");
+        return -1;
+    }
+    object->lpVtbl->AddRef(object);
+    owner->objects[owner->object_count++] = object;
+    if (hash) {
+        d3d12_prefix_object_hash_append(hash, owner);
+        hash->last = object;
+    }
+    return 0;
+}
+
+static int d3d12_prefix_owner_object_reserved(const void* pointer)
+{
+    if (!pointer || !d3d12_prefix_ownership_enabled()) return 0;
+    for (u32 slot = 0; slot < 2; ++slot) {
+        const D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+        if (!owner->phase || (owner->phase == 2 && owner->completion_checked)) continue;
+        for (u32 i = 0; i < owner->object_count; ++i)
+            if (owner->objects[i] == pointer) return 1;
+    }
+    return 0;
+}
+
+static int d3d12_prefix_owner_object_mutable(const void* pointer)
+{
+    if (d3d12_prefix_prepare_before_mutation(pointer) != 0) return -1;
+    if (d3d12_prefix_queue_ahead_before_mutation(pointer) != 0) return -1;
+    if (d3d12_prefix_owner_object_reserved(pointer)) {
+        gcm2d_backend_halt("prefix owner object CPU overwrite/recycle");
+        return -1;
+    }
+    return 0;
+}
+
+static void d3d12_owned_barriers(UINT count, const D3D12_RESOURCE_BARRIER* barriers)
+{
+    if (!s_d3d.prefix_owner_active) {
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, count, barriers);
+        return;
+    }
+    for (UINT i = 0; i < count; ++i) {
+        const D3D12_RESOURCE_BARRIER* b = &barriers[i];
+        if (b->Type == D3D12_RESOURCE_BARRIER_TYPE_TRANSITION) {
+            if (d3d12_prefix_owner_object_capture(b->Transition.pResource) != 0) return;
+        } else if (b->Type == D3D12_RESOURCE_BARRIER_TYPE_ALIASING) {
+            if (d3d12_prefix_owner_object_capture(b->Aliasing.pResourceBefore) != 0 ||
+                d3d12_prefix_owner_object_capture(b->Aliasing.pResourceAfter) != 0) return;
+        } else if (b->Type == D3D12_RESOURCE_BARRIER_TYPE_UAV) {
+            if (d3d12_prefix_owner_object_capture(b->UAV.pResource) != 0) return;
+        }
+    }
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, count, barriers);
+}
+
+static void d3d12_owned_copy_texture(const D3D12_TEXTURE_COPY_LOCATION* dst,
+    UINT x, UINT y, UINT z, const D3D12_TEXTURE_COPY_LOCATION* src, const D3D12_BOX* box)
+{
+    if (d3d12_prefix_owner_object_capture(dst->pResource) != 0 ||
+        d3d12_prefix_owner_object_capture(src->pResource) != 0) return;
+    s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, dst, x, y, z, src, box);
+}
