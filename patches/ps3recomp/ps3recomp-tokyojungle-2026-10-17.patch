+static void tj_compose_capture_alias_before_record(u32 record)
+{
+    if (s_tj_compose_capture.alias_active &&
+        record == s_tj_compose_capture.last_consumer_record)
+        tj_compose_capture_alias_boundary("before");
+}
+
+static void tj_compose_capture_alias_after_record(u32 record)
+{
+    if (s_tj_compose_capture.alias_active &&
+        record == s_tj_compose_capture.last_consumer_record)
+        /* Called after any scratch copy-back from the selected record. */
+        tj_compose_capture_alias_boundary("after");
+}
