+static const char* pad_xi_name(unsigned mask)
+{
+    for (size_t i = 0; i < sizeof(s_pad_xi_names) / sizeof(s_pad_xi_names[0]); i++)
+        if (s_pad_xi_names[i].mask == mask) return s_pad_xi_names[i].name;
+    return "None";
