+/* Recreate the guest byte order from a record-time structural capture for
+ * optional dumps only.  Replay and PSO selection never read live FP memory. */
+static void fp_structural_to_guest_bytes(const RSXFPStructuralProgram* program,
+                                         u8* out)
+{
+    for (u32 i = 0; i < program->raw_word_count; ++i) {
+        u32 be = (program->raw_words[i] << 16) | (program->raw_words[i] >> 16);
+        out[i * 4u + 0u] = (u8)(be >> 24);
+        out[i * 4u + 1u] = (u8)(be >> 16);
+        out[i * 4u + 2u] = (u8)(be >> 8);
+        out[i * 4u + 3u] = (u8)be;
+    }
+}
+
+/* Hash + compile the CURRENT rsx_state vertex program into the VS cache;
+ * returns the cache slot (or -1). Called at draw-record time so each draw
+ * carries the VP that was loaded when it was submitted. */
+static u32 vp_hash_ucode(const u8* p, u32 n)
+{
+    u32 h = 2166136261u;
+    for (u32 i = 0; i < n; i++) { h ^= p[i]; h *= 16777619u; }
+    return h ? h : 1u;
+}
+
+/* Pure raw-bank hash memo. Compare every owned byte on every hit; no
+ * address, generation, VS slot or program lifetime is trusted. Entry and
+ * texture dimensions are still mixed by vp_get_vs on every call. */
+typedef struct TJVpHashMemo {
+    u8 bank[sizeof(((rsx_state*)0)->vp_ucode)];
+    u32 bytes, hash;
+    int valid;
+} TJVpHashMemo;
+_Static_assert(sizeof(((rsx_state*)0)->vp_ucode) == 16384u,
+               "VP hash memo requires the fixed 16 KiB resident bank");
+static _Thread_local TJVpHashMemo s_tj_vp_hash_memo;
+typedef struct TJVpHashReuseStats {
+    volatile LONG64 calls, hits, misses, bypass, hash_bytes, compare_bytes;
+} TJVpHashReuseStats;
+static TJVpHashReuseStats s_tj_vp_hash_reuse_stats;
+static int vp_texture_churn_trace_enabled(void);
+
+static int vp_hash_ucode_reuse_enabled(void)
+{
+    static _Thread_local int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("TJ_VP_UCODE_HASH_REUSE");
+        enabled = value && strcmp(value, "1") == 0;
+    }
+    return enabled;
+}
+
+static u32 vp_hash_ucode_reuse(const u8* p, u32 n)
+{
+    const int enabled = vp_hash_ucode_reuse_enabled();
+    const int trace = vp_texture_churn_trace_enabled();
+    TJVpHashMemo* memo = &s_tj_vp_hash_memo;
+    if (trace) InterlockedIncrement64(&s_tj_vp_hash_reuse_stats.calls);
+    if (enabled && n <= sizeof(memo->bank)) {
+        if (memo->valid && n == memo->bytes) {
+            if (trace) InterlockedAdd64(&s_tj_vp_hash_reuse_stats.compare_bytes, n);
+            if (!n || memcmp(p, memo->bank, n) == 0) {
+                if (trace) InterlockedIncrement64(&s_tj_vp_hash_reuse_stats.hits);
+                return memo->hash;
+            }
+        }
+        if (n) memcpy(memo->bank, p, n);
+        const u32 hash = vp_hash_ucode(memo->bank, n);
+        memo->bytes = n;
+        memo->hash = hash;
+        memo->valid = 1;
+        if (trace) {
+            InterlockedIncrement64(&s_tj_vp_hash_reuse_stats.misses);
+            InterlockedAdd64(&s_tj_vp_hash_reuse_stats.hash_bytes, n);
+        }
+        return hash;
+    }
+    if (trace) {
+        InterlockedIncrement64(&s_tj_vp_hash_reuse_stats.bypass);
+        InterlockedAdd64(&s_tj_vp_hash_reuse_stats.hash_bytes, n);
+    }
+    return vp_hash_ucode(p, n);
+}
+
+static void vp_hash_ucode_reuse_report(ULONGLONG t_ms, u64 frame_count,
+                                       ULONGLONG interval_ms)
+{
+    /* Called only by the opt-in aggregate churn report. Requested compare
+     * spans are not actual bytes read by an early-exiting memcmp. */
+    fprintf(stderr, "[TJ-VP-HASH-REUSE] t_ms=%llu frame_count=%llu interval_ms=%llu enabled=%d calls=%llu hits=%llu misses=%llu bypass=%llu hash_bytes=%llu compare_bytes=%llu\n",
+            (unsigned long long)t_ms, (unsigned long long)frame_count,
+            (unsigned long long)interval_ms, vp_hash_ucode_reuse_enabled(),
+            (unsigned long long)InterlockedExchange64(&s_tj_vp_hash_reuse_stats.calls, 0),
+            (unsigned long long)InterlockedExchange64(&s_tj_vp_hash_reuse_stats.hits, 0),
+            (unsigned long long)InterlockedExchange64(&s_tj_vp_hash_reuse_stats.misses, 0),
+            (unsigned long long)InterlockedExchange64(&s_tj_vp_hash_reuse_stats.bypass, 0),
+            (unsigned long long)InterlockedExchange64(&s_tj_vp_hash_reuse_stats.hash_bytes, 0),
+            (unsigned long long)InterlockedExchange64(&s_tj_vp_hash_reuse_stats.compare_bytes, 0));
+}
