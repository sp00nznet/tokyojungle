+static void vp_vertex_plan_init(VPVertexPlan* plan, const rsx_state* state)
+{
+    const u16 used = s_tj_vp_upload_attr_mask;
+    plan->count = 0;
+    plan->has_immediate = state->immediate_vertex_data != NULL;
+    plan->immediate_count = state->immediate_vertex_count;
+    for (u32 i = 0; i < 16; ++i) {
+        if (!(used & (1u << i))) continue;
+        VPAttrPlan* p = &plan->attrs[plan->count++];
+        const rsx_vertex_attrib* a = &state->vertex_attribs[i];
+        p->slot = i;
+        p->current = state->vertex_data4f[i];
+        p->immediate = plan->has_immediate &&
+            (state->immediate_vertex_mask & (1u << i))
+            ? state->immediate_vertex_data + (size_t)i * 4u : NULL;
+        p->decode = NULL;
+        if (!(state->vertex_attrib_input_mask & (1u << i)) ||
+            !a->enabled || a->stride == 0) continue;
+        p->components = a->size ? a->size : 4;
+        if (p->components > 4) p->components = 4;
+        p->stride = a->stride;
+        p->base = (state->vertex_data_base_offset +
+                   (a->offset & 0x7FFFFFFFu)) & 0x0FFFFFFFu;
+        p->local = (a->offset & 0x80000000u) == 0;
+        p->frequency = a->frequency;
+        p->frequency_mode = 0;
+        if (a->frequency > 1 && !vp_frequency_override_disabled())
+            p->frequency_mode = (state->frequency_divider_op & (1u << i)) ? 2 : 1;
+        p->seed_defaults = p->components < 4 && a->type != 6;
+        switch (a->type) {
+        case 1: p->decode = vp_plan_decode_s1; break;
+        case 3: p->decode = vp_plan_decode_sf; break;
+        case 4: p->decode = vp_plan_decode_ub; break;
+        case 5: p->decode = vp_plan_decode_s32k; break;
+        case 6: p->decode = vp_plan_decode_cmp; break;
+        case 7: p->decode = vp_plan_decode_ub256; break;
+        default: p->decode = vp_plan_decode_f; break; /* F and unknown types */
+        }
+    }
+}
