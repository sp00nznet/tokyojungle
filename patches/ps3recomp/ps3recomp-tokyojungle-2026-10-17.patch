+static void d3d12_owned_dsv(ID3D12Resource* res,
+    const D3D12_DEPTH_STENCIL_VIEW_DESC* desc, D3D12_CPU_DESCRIPTOR_HANDLE handle)
+{
+    if (d3d12_prefix_owner_object_capture(res) != 0) return;
