+int rsx_d3d12_backend_complete_fifo_prefix(void)
+{
+    /* Labels, reference, interrupt, acquire and replay all follow. */
+    VP_SNAP_PAR_BARRIER(PREFIX);
+    if (!s_d3d.initialized || s_d3d.gcm2d_backend_halted) return -1;
+    if (d3d12_prefix_overlap_drain(s_tj_completion_reason) != 0) return -1;
+    LONGLONG work_start = 0;
+    if (tj_present_work_trace_enabled()) {
+        tj_present_work_trace_arm(rsx_survival_trace_is_armed());
+        work_start = tj_present_work_trace_begin();
+    }
+    /* A reference/interrupt after a normal submit may still need a checked
+     * completion.  Do not manufacture an empty command list/fence otherwise. */
+    if (!s_d3d.draw_count) {
+        if (s_d3d.fifo_prefix_outstanding) {
+            /* TJ_EDGE_NOWAIT: 1 leaves the in-flight final frame outstanding
+             * for the next opening wait; 2 needs no wait. */
+            const int edge = d3d12_edge_nowait_enabled() ? d3d12_edge_nowait_decide() : 0;
+            if (edge != 1) {
+                if (edge == 0 && wait_for_gpu_checked() != 0) {
+                    gcm2d_backend_halt("FIFO edge fence");
+                    return -1;
+                }
+                s_d3d.fifo_prefix_outstanding = 0;
+                s_d3d.fifo_prefix_serial++;
+                s_edge_nowait.final_only = 0;
+            }
+        }
+    } else {
+        if (d3d12_prefix_ownership_enabled()) render_fifo_prefix_owned();
+        else render_frame(0, 0, 0, 1);
+        if (s_d3d.gcm2d_backend_halted) return -1;
+    }
+    d3d12_publish_texture_labels();
+    vp_watch_batch_arm(); /* TJ_WATCH_BATCH: replay/commit/labels done */
+    if (tj_present_work_trace_enabled())
+        tj_present_work_trace_cpu_finish(work_start, 1);
+    return 0;
+}
