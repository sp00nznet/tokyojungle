+static double tj_prompt_now_ms(void)
+{
+    LARGE_INTEGER f, t;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t);
+    return (double)t.QuadPart * 1000.0 / (double)f.QuadPart;
+}
+
+/* Once per final present (render_frame): publish the bindings signature the
+ * record path uses. Held while the F1/F2 screen is open, so each key typed
+ * there does not rebuild the atlases; the new keys apply when it closes. */
+static void tj_prompt_latch(void)
+{
+    VP_SNAP_PAR_BARRIER(OTHER); /* queued captures resolve with the old sig */
+    ++s_tj_prompt_presents;
+    if (cellPad_overlay_is_open()) return;
+    unsigned long long sig = 0;
+    int vks[CELL_PAD_PROMPT_ACTIONS];
+    if (!cellPad_prompt_keys(&sig, vks)) sig = 0;
+    if ((u64)sig == (u64)s_tj_prompt_sig) return;
+    if (sig) {
+        const LONG next = (s_tj_prompt_latch_index + 1) & 1;
+        TjPromptLatch* slot = &s_tj_prompt_latches[next];
+        InterlockedExchange64(&slot->sig, 0);
+        memcpy(slot->vks, vks, sizeof(vks));
+        InterlockedExchange64(&slot->sig, (LONG64)sig);
+        InterlockedExchange(&s_tj_prompt_latch_index, next);
+    }
+    InterlockedExchange64(&s_tj_prompt_sig, (LONG64)sig);
+    if (s_tj_prompt_latch_logs < 64u) {
+        ++s_tj_prompt_latch_logs;
+        if (sig) {
+            static const int show[] = {0, 1, 2, 3, 4, 5, 6, 7, 10, 11, 12};
+            static const char* const names[] = {"cross", "circle", "square", "triangle", "l1",
+                                                "r1", "l2", "r2", "start", "select", "up"};
+            char line[256];
+            int n = snprintf(line, sizeof(line), "[tj-prompts] keyboard prompts sig=%016llX",
+                             (unsigned long long)sig);
+            for (u32 i = 0; i < sizeof(show) / sizeof(show[0]) && n > 0 &&
+                            n < (int)sizeof(line); ++i) {
+                char full[PAD_PROMPT_LABEL_MAX], compact[PAD_PROMPT_LABEL_MAX];
+                pad_prompt_key_names(vks[show[i]], full, sizeof(full), compact, sizeof(compact));
+                n += snprintf(line + n, sizeof(line) - (size_t)n, " %s=%s", names[i], full);
+            }
+            fprintf(stderr, "%s\n", line);
+        } else {
+            fprintf(stderr, "[tj-prompts] original PS3 prompts (controller active)\n");
+        }
+    }
+}
+
+/* The original no longer belongs to an entry: drop its weak override. */
+static void tj_prompt_forget(VPTexSnapshot* original)
+{
+    if (!original) return;
+    original->prompt_override = NULL;
+    original->prompt_sig = 0;
+}
+
+/* NULL result, *retry says why:
+ *   0 patch error (counts toward the 3 failures that keep PS3 art);
+ *   1 the keys of this signature were being replaced by a newer latch:
+ *     try again on a later draw;
+ *   2 snapshot budget full or out of memory: try again after a short wait
+ *     (log_wait 0 = already waiting, do not log again). */
+static VPTexSnapshot* tj_prompt_build(const TjPromptAtlas* atlas,
+                                      const VPTexSnapshot* original, u64 sig, int* retry,
+                                      int log_wait)
+{
+    /* Keys of exactly this signature (the latch writes the other slot). */
+    int vks[CELL_PAD_PROMPT_ACTIONS];
+    const TjPromptLatch* slot = NULL;
+    *retry = 0;
+    for (u32 i = 0; i < 2u && !slot; ++i)
+        if ((u64)s_tj_prompt_latches[i].sig == sig) slot = &s_tj_prompt_latches[i];
+    if (slot) {
+        memcpy(vks, slot->vks, sizeof(vks));
+        MemoryBarrier();
+    }
+    if (!slot || (u64)slot->sig != sig) {
+        *retry = 1;
+        return NULL;
+    }
+
+    const u32 bytes = original->bytes;
+    vp_texture_cache_trim_sources(bytes);
+    *retry = 2;
+    if (s_d3d.vp_tex_snapshot_bytes + bytes > VP_TEX_SNAPSHOT_MAX_BYTES) {
+        if (log_wait)
+            fprintf(stderr, "[tj-prompts] %s: snapshot budget full, original art kept "
+                    "(retrying)\n", atlas->name);
+        return NULL;
+    }
+    VPTexSnapshot* ov = (VPTexSnapshot*)calloc(1, sizeof(*ov));
+    if (!ov) return NULL;
+    ov->data = (u8*)malloc(bytes);
+    if (!ov->data) { free(ov); return NULL; }
+    *retry = 0;
+    const double t0 = tj_prompt_now_ms();
+    memcpy(ov->data, original->data, bytes);
+    PadPromptLabels labels;
+    pad_prompt_labels_from_vks(&labels, vks);
+    TjPromptPatchInfo info;
+    const int rc = tj_prompt_atlas_patch(atlas, ov->data, bytes, atlas->w / 4u * 16u,
+                                         &labels, 1, NULL, NULL, &info);
+    if (rc != 0) {
+        if (rc == -3) *retry = 2;     /* out of memory inside the patcher */
+        if (rc != -3 || log_wait)
+            fprintf(stderr, "[tj-prompts] %s: patch failed (%d), original art kept\n",
+                    atlas->name, rc);
+        free(ov->data);
+        free(ov);
+        return NULL;
+    }
+    ov->bytes = bytes;
+    ov->source_off = original->source_off;
+    ov->hash = vp_tex_source_hash(ov->data, bytes, 1u, bytes, 1);
+    ov->refs = 1;                 /* the entry's */
+    ov->is_override = 1;
+    s_d3d.vp_tex_snapshot_bytes += bytes;
+    fprintf(stderr, "[tj-prompts] patched %s sig=%016llX cells=%u blocks=%u art=%.1fms "
+            "encode=%.1fms total=%.1fms\n", atlas->name, (unsigned long long)sig,
+            info.cells, info.blocks, info.ms_art, info.ms_encode, tj_prompt_now_ms() - t0);
+    return ov;
+}
+
+/* Atlas whose content hash this snapshot has, or NULL. */
+static const TjPromptAtlas* tj_prompt_atlas_of(const VPTexSnapshot* snap, u32* index)
+{
+    u32 count = 0;
+    const TjPromptAtlas* table = tj_prompt_atlas_table(&count);
+    for (u32 i = 0; i < count && i < TJ_PROMPT_MAX_ATLASES; ++i)
+        if (table[i].xxh64 == snap->hash) { *index = i; return &table[i]; }
+    return NULL;
+}
+
+/* This draw binds the atlas as authored (format, size, 2D, one face). The
+ * snapshot is shared by content, so this is checked per draw, not cached. */
+static int tj_prompt_shape_ok(const D3D12DrawRecord* dr, u32 u, const TjPromptAtlas* atlas)
+{
+    return (dr->tex[u].fmt & 0x9Fu) == atlas->rsx_fmt && dr->tex[u].w == atlas->w &&
+           dr->tex[u].h == atlas->h && !dr->tex[u].cube && dr->tex[u].depth <= 1u &&
+           (!dr->tex[u].dimension || dr->tex[u].dimension == 2u);
+}
+
+/* snapshot->prompt_sig differs from the latched signature: decide again. */
+static void tj_prompt_resolve(const D3D12DrawRecord* dr, u32 u, VPTexSnapshot* snap, u64 sig)
+{
+    snap->prompt_sig = sig;
+    snap->prompt_override = NULL;
+    if (!sig || snap->is_override) return;
+    u32 index = 0;
+    const TjPromptAtlas* atlas = tj_prompt_atlas_of(snap, &index);
+    if (!atlas) {
+        for (u32 i = 0; i < sizeof(k_tj_prompt_watch) / sizeof(k_tj_prompt_watch[0]); ++i)
+            if (k_tj_prompt_watch[i].hash == snap->hash && !s_tj_prompt_watch_logged[i]) {
+                s_tj_prompt_watch_logged[i] = 1;
+                fprintf(stderr, "[tj-prompts] seen %s off=0x%08X %ux%u fmt=0x%02X bytes=%u "
+                        "(PS3 art kept: not patched yet)\n", k_tj_prompt_watch[i].name,
+                        dr->tex[u].off, dr->tex[u].w, dr->tex[u].h, dr->tex[u].fmt, snap->bytes);
+            }
+        return;
+    }
+    TjPromptEntry* e = &s_tj_prompt_entries[index];
+    const int shape_ok = tj_prompt_shape_ok(dr, u, atlas);
+    if (!shape_ok || snap->bytes != atlas->bytes) {
+        if (!e->shape_logged) {
+            e->shape_logged = 1;
+            fprintf(stderr, "[tj-prompts] %s hash seen with another shape (%ux%u fmt=0x%02X "
+                    "mips=%u bytes=%u): PS3 art kept\n", atlas->name, dr->tex[u].w,
+                    dr->tex[u].h, dr->tex[u].fmt, dr->tex[u].mips, snap->bytes);
+        }
+        /* Byte size is the snapshot's own (settled); the bound shape belongs
+         * to this draw, so a later draw of the same bytes decides again. */
+        if (snap->bytes == atlas->bytes) snap->prompt_sig = 0;
+        return;
+    }
+    if (!e->matched_logged) {
+        e->matched_logged = 1;
+        fprintf(stderr, "[tj-prompts] match %s off=0x%08X %ux%u fmt=0x%02X mips=%u bytes=%u\n",
+                atlas->name, dr->tex[u].off, dr->tex[u].w, dr->tex[u].h, dr->tex[u].fmt,
+                dr->tex[u].mips, snap->bytes);
+    }
+    if (e->original != snap) {
+        if (e->original) {
+            tj_prompt_forget(e->original);
+            vp_texture_snapshot_release(&e->original);
+        }
+        ++snap->refs;
+        e->original = snap;
+    }
+    for (u32 v = 0; v < TJ_PROMPT_VARIANTS; ++v) {
+        if (!e->var[v] || e->var_sig[v] != sig) continue;
+        if (v) {
+            VPTexSnapshot* t = e->var[0]; e->var[0] = e->var[v]; e->var[v] = t;
+            const u64 ts = e->var_sig[0]; e->var_sig[0] = e->var_sig[v]; e->var_sig[v] = ts;
+        }
+        snap->prompt_override = e->var[0];
+        return;
+    }
+    if (e->failures >= 3u) return;
+    if (e->retry_wait && (int)(s_tj_prompt_presents - e->retry_at) < 0) {
+        snap->prompt_sig = 0;              /* budget/memory wait: decide again later */
+        return;
+    }
+    int retry = 0;
+    VPTexSnapshot* ov = tj_prompt_build(atlas, snap, sig, &retry, !e->retry_wait);
+    if (!ov) {
+        if (retry) snap->prompt_sig = 0;   /* resolve again on a later draw */
+        if (retry == 2) {                  /* transient: not counted as a failure */
+            e->retry_wait = 1;
+            e->retry_at = s_tj_prompt_presents + TJ_PROMPT_RETRY_PRESENTS;
+        } else if (!retry) {
+            ++e->failures;                 /* 3 patch errors in a row: PS3 art */
+        }
+        return;
+    }
+    e->failures = 0;
+    e->retry_wait = 0;
+    /* No weak pointer can name the evicted variant: snap's was cleared above
+     * and no other original carries one. */
+    vp_texture_snapshot_release(&e->var[TJ_PROMPT_VARIANTS - 1u]);
+    for (u32 v = TJ_PROMPT_VARIANTS - 1u; v > 0u; --v) {
+        e->var[v] = e->var[v - 1u];
+        e->var_sig[v] = e->var_sig[v - 1u];
+    }
+    e->var[0] = ov;
+    e->var_sig[0] = sig;
+    snap->prompt_override = ov;
+}
+
+/* Fragment unit u just got its record-time snapshot. */
+static void tj_prompt_apply(D3D12DrawRecord* dr, u32 u)
+{
+    VPTexSnapshot* snap = dr->tex_snapshot[u];
+    const u64 sig = (u64)s_tj_prompt_sig;
+    if (snap->prompt_sig != sig) tj_prompt_resolve(dr, u, snap, sig);
+    VPTexSnapshot* ov = snap->prompt_override;
+    if (!ov) return;
+    u32 index = 0;
+    const TjPromptAtlas* atlas = tj_prompt_atlas_of(snap, &index);
+    if (!atlas || !tj_prompt_shape_ok(dr, u, atlas)) {
+        TjPromptEntry* e = atlas ? &s_tj_prompt_entries[index] : NULL;
+        if (e && !e->shape_logged) {
+            e->shape_logged = 1;
+            fprintf(stderr, "[tj-prompts] %s hash seen with another shape (%ux%u fmt=0x%02X "
+                    "mips=%u bytes=%u): PS3 art kept for that draw\n", atlas->name,
+                    dr->tex[u].w, dr->tex[u].h, dr->tex[u].fmt, dr->tex[u].mips, snap->bytes);
+        }
+        return;                            /* this draw keeps the original */
+    }
+    ++ov->refs;
+    vp_texture_snapshot_release(&dr->tex_snapshot[u]);  /* the entry still holds it */
+    dr->tex_snapshot[u] = ov;
+}
+
+/* Shutdown/reinit: give every entry reference back (after the GPU wait). */
+static void tj_prompt_release_all(void)
+{
+    VP_SNAP_PAR_BARRIER(LIFE);
+    for (u32 i = 0; i < TJ_PROMPT_MAX_ATLASES; ++i) {
+        TjPromptEntry* e = &s_tj_prompt_entries[i];
+        if (e->original) {
+            tj_prompt_forget(e->original);
+            vp_texture_snapshot_release(&e->original);
+        }
+        for (u32 v = 0; v < TJ_PROMPT_VARIANTS; ++v) {
+            vp_texture_snapshot_release(&e->var[v]);
+            e->var_sig[v] = 0;
+        }
+        e->failures = 0;
+        e->retry_wait = 0;
+    }
+    InterlockedExchange64(&s_tj_prompt_sig, 0);
+}
+#endif /* PS3RECOMP_PROMPT_ART */
+
+static int vp_record_texture_is_gpu_owned(const D3D12DrawRecord* dr,
+                                          u32 raw, u32 location)
+{
+    extern int cellGcmOffsetIsDisplay(u32 offset);
+    u8 local = location == 1u; /* texture format: 1 LOCAL, 2 MAIN */
+    if (!dr) return 0;
+    if ((local && cellGcmOffsetIsDisplay(raw)) || off_rt_find(raw, local) >= 0) return 1;
+    if (raw == dr->rt_off && local == dr->rt_local) return 1;
+    for (u32 m = 0; m < 3; ++m)
+        if (dr_rt_attachment_enabled(dr, (int)m + 1) &&
+            raw == dr->rt_mrt[m] && local == dr->rt_mrt_local[m]) return 1;
+    return 0;
+}
+
+static u32 vp_fragment_texture_mask(const D3D12DrawRecord* dr)
+{
+    /* Use the same inputs for record-time capture and replay preparation.
+     * A stale unused GPU binding must not create copies or transitions either.
+     * Keep t0 for the fallback PSO and all inputs for unknown/probe programs. */
+    static int shader_probe = -1;
+    if (shader_probe < 0)
+        shader_probe = getenv("FP_FORCE") || getenv("TJ_FP_PROBE_T0") ||
+            getenv("TJ_FP_PROBE_T1") || getenv("TJ_FP_PROBE_STAGEGRID") ||
+            getenv("TJ_FP_PROBE_LATEGRID");
+    return dr && dr->fp_program_valid && !shader_probe
+        ? dr->fp_program.texture_read_mask | 1u : 0xFFFFu;
+}
+
+/* ---------------------------------------------------------------------------
+ * TJ_SNAPSHOT_PARALLEL=1 (opt-in; needs TJ_TEXTURE_WRITE_WATCH=1 or 2). Unset
+ * or any other value never enters this code: vp_capture_draw_texture_snapshots
+ * captures serially as before and every VP_SNAP_PAR_BARRIER() sees nothing
+ * pending.
+ *
+ * Moved off the presenter: only each capture's write-watch observation -- its
+ * source span, the one GetWriteWatch(RESET) query and that query's page-epoch
+ * update, exactly what vp_texture_write_stamp_percall does -- run by ONE
+ * helper thread in the original capture order while the presenter converts
+ * and records the following draws. When the queued captures are applied, in
+ * order, each runs vp_capture_tex_snapshot_impl_obs with its observation in
+ * place of the per-call query, so hint/hash lookups, byte compares, hashes,
+ * copies, the post-copy query, budget/pool/refcount/retention/hint updates,
+ * prompt overrides and fault masks run on the presenter exactly as before.
+ *
+ * One helper, not N: GetWriteWatch(RESET) calls of one process serialize in
+ * the kernel (standalone bench 2026-10-17: 2-16 concurrent callers gained at
+ * most ~1.5x on clean ranges and lost throughput once pages were dirty). The
+ * gain is overlap with the presenter's other work. One in-order helper also
+ * keeps the OS query order serial, so which query consumes which dirty-page
+ * notification, every epoch and every stamp equal the serial values. The
+ * TJ_VERTEX_PARALLEL pool is fork-join per draw (its joins would stall behind
+ * an asynchronous consumer), so only its pattern is reused: auto-reset wake
+ * events, Interlocked indices, ABOVE_NORMAL priority, lazy start.
+ *
+ * Batch boundary ("drain": finish every queued observation, then apply all):
+ *  - Before code reads or changes what a capture reads or produces:
+ *    VP_SNAP_PAR_BARRIER() in the snapshot hint/pool/cache functions, record
+ *    release/retain/replay (render_frame, discard, halt), the write watch
+ *    (per-call stamp, serial capture) and prefix-owner retirement.
+ *  - Before the presenter publishes progress to the guest or stores into
+ *    guest memory; each such point first enters a drained backend function:
+ *    texture/back-end labels (prepare_texture_label, complete_fifo_prefix;
+ *    an early 0x1D74 label is written after prepare returns), NV406E
+ *    acquire/release (acquire_gpu_free, flush_texture_labels_at), reference
+ *    and interrupt (complete_fifo_prefix before the GET/ref store), every
+ *    non-NV4097 non-metadata method incl. NV3089/NV0039/NV308A/NV309E/NV3062
+ *    CPU stores (flush_texture_labels_at, then the exact-blit hooks), clears,
+ *    replay/present/flip completion (render_frame, present_buffer), owner
+ *    label publication, and the end of every FIFO walk (the trailing
+ *    flush_texture_labels in cellGcm_rsx_process_fifo). The guest may rewrite
+ *    texture bytes only after it observes one of these, so an observation
+ *    later than the serial one but before the next of them sees the bytes the
+ *    serial capture saw; unordered guest writes race the RSX on hardware too.
+ *  - Residual: a walk stores GET (= PUT) just before its trailing flush, so
+ *    a walk's last batch is observed microseconds after that store. GET
+ *    reports command fetch, not execution (the RSX samples textures after GET
+ *    passes a draw), so it never licenses a texture rewrite; a DRAW_INDEX_
+ *    ARRAY span still pending at PUT already records after that store.
+ *
+ * Ownership: the helper touches the write watch only for an item it claimed
+ * (CAS on claimed) and publishes done afterwards; the presenter touches the
+ * watch only when done == claimed. A drain whose remaining items are not yet
+ * claimed observes them itself (no wake latency); a helper mid-item is
+ * waited for. Pushing never touches the watch.
+ *
+ * Off (serial) for the run: watch mode 0 (nothing to move), TJ_WATCH_BATCH or
+ * TJ_SNAPSHOT_FRAME_REUSE (other watch consumers), TJ_NON3D_LABEL_PASS=1
+ * (unhooked NV308A LOCAL stores), TJ_INDEXED_DIAG, helper creation failure.
+ * Serial per draw: watch not active yet (lazy setup) or disabled, foreign
+ * thread. Audit mode 2 still compares every byte at apply; a mismatch on a
+ * deferred observation logs [TJ-SNAP-PARALLEL] audit (query age, later write)
+ * before the usual disable, and the rest of that drain then uses stamp 0, as
+ * serial captures after a disable do. sp_* counters ride on [TJ-PERF].
+ * -----------------------------------------------------------------------*/
+#define VP_SNAP_PAR_RING 4096u          /* power of two; a full ring drains */
+#define VP_SNAP_PAR_HELPER_SPIN_US 100u /* helper idle spin before it sleeps */
+#define VP_SNAP_PAR_WAIT_SPIN_US 200u   /* drain spin before blocking */
+
+typedef struct VPSnapParItem {
+    /* Request: written by the presenter before tail publishes it. */
+    D3D12DrawRecord* dr;
+    u32 off, w, h, depth, fmt, pitch, dimension, mips;
+    int cube, has_border;
+    u32 unit, vertex;
+    /* Observation: written by the item's claimer before done covers it. */
+    int queried;                   /* the span/bounds held and the query ran */
+    int state_before, state_after; /* watch state around that query */
+    u32 bytes;
+    u64 stamp;
+    RsxTextureWriteStampHint hint;
+    LONGLONG query_qpc, query_ticks;
+} VPSnapParItem;
+
+typedef struct VPSnapParIndex {  /* one shared index per cache line */
+    volatile LONG v;
+    char pad[64 - sizeof(LONG)];
+} VPSnapParIndex;
+
+typedef struct VPSnapParWindow { /* one [TJ-PERF] window, presenter-side */
+    u64 items, drains, batch_max, serial_draws, ring_full, audit, wakes;
+    u64 steal_items, steal_queries, steal_ticks, wait_ticks, apply_ticks;
+    u64 site[VP_SNAP_PAR_SITE_COUNT];
+} VPSnapParWindow;
+
+static int s_vp_snap_par_config = -1; /* TJ_SNAPSHOT_PARALLEL, read once */
+static struct {
+    VPSnapParIndex tail;    /* items published (presenter) */
+    VPSnapParIndex claimed; /* next item to observe (CAS: helper or drain) */
+    VPSnapParIndex done;    /* items observed, in order (their claimer) */
+    VPSnapParIndex idle;    /* helper is asleep or about to sleep */
+    VPSnapParIndex waiting; /* a drain blocks on done_event */
+    volatile LONG64 helper_queries, helper_ticks, helper_sleeps, foreign;
+    LONG applied;           /* items applied (presenter) */
+    int broken;             /* helper unavailable: serial for the run */
+    DWORD owner_tid;        /* the presenter thread that queues and applies */
+    HANDLE wake, done_event, thread;
+    VPSnapParWindow win;
+    VPSnapParItem ring[VP_SNAP_PAR_RING];
+} s_vp_snap_par;
+
+static int vp_snap_par_enabled(void)
+{
+    if (s_vp_snap_par_config < 0) {
+        const char* value = getenv("TJ_SNAPSHOT_PARALLEL");
+        const int requested = value && strcmp(value, "1") == 0;
+        const char* inactive = value && value[0] && !requested ? "value_must_be_1" : NULL;
+        int mode = 0;
+        if (requested) {
+            /* Only a request consults the other options (and their one-time
+             * log lines); unset keeps the original first-use order. */
+            const char* label_pass = getenv("TJ_NON3D_LABEL_PASS");
+            mode = vp_texture_write_watch_mode();
+            if (!mode) inactive = "needs_TJ_TEXTURE_WRITE_WATCH=1_or_2";
+            else if (vp_watch_batch_enabled()) inactive = "TJ_WATCH_BATCH";
+            else if (vp_snapshot_frame_reuse_enabled()) inactive = "TJ_SNAPSHOT_FRAME_REUSE";
+            else if (label_pass && strcmp(label_pass, "1") == 0)
+                inactive = "TJ_NON3D_LABEL_PASS_unhooked_stores";
+            else if (getenv("TJ_INDEXED_DIAG")) inactive = "TJ_INDEXED_DIAG";
+        }
+        s_vp_snap_par_config = requested && !inactive;
+        if (value && value[0])
+            fprintf(stderr, "[TJ-SNAP-PARALLEL] enabled=%d%s%s watch_mode=%d "
+                    "helper_threads=1 ring=%u\n", s_vp_snap_par_config,
+                    inactive ? " inactive=" : "", inactive ? inactive : "", mode,
+                    VP_SNAP_PAR_RING);
+    }
+    return s_vp_snap_par_config > 0 && !s_vp_snap_par.broken;
+}
+
+/* The observation of one capture, run by its claimer (helper, or a drain):
+ * vp_capture_tex_snapshot_impl_obs's early exits in its order (no query for
+ * a capture that returns before querying), then its exact per-call query.
+ * Pure inputs only: the item's fields, vm_base/ppu_vm_size and the watch. */
+static void vp_snap_par_observe(VPSnapParItem* it)
+{
+    extern u8* vm_base;
+    extern u32 ppu_vm_size;
+    it->queried = 0;
+    it->stamp = 0;
+    it->bytes = 0;
+    memset(&it->hint, 0, sizeof(it->hint));
+    it->query_qpc = it->query_ticks = 0;
+    it->state_before = it->state_after = s_vp_write_watch.state;
+    u32 bytes = 0;
+    if (!it->w || !it->h || !it->depth ||
+        vp_tex_source_span(it->w, it->h, it->depth, it->fmt, it->pitch, it->cube,
+                           it->dimension, it->mips, it->has_border, &bytes,
+                           NULL) != 0)
+        return;
+    const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ull << 32);
+    if (!vm_base || (u64)it->off + bytes > vm_cap ||
+        bytes > VP_TEX_SNAPSHOT_SINGLE_MAX_BYTES)
+        return;
+    LARGE_INTEGER begin, end;
+    QueryPerformanceCounter(&begin);
+    it->stamp = rsx_texture_write_watch_stamp_cached(&s_vp_write_watch, vm_base,
+                                                     vm_cap, it->off, bytes, &it->hint);
+    QueryPerformanceCounter(&end);
+    it->state_after = s_vp_write_watch.state;
+    it->bytes = bytes;
+    it->queried = 1;
+    it->query_qpc = end.QuadPart;
+    it->query_ticks = end.QuadPart - begin.QuadPart;
+}
+
+static DWORD WINAPI vp_snap_par_main(LPVOID unused)
+{
+    (void)unused;
+    LARGE_INTEGER frequency;
+    QueryPerformanceFrequency(&frequency);
+    const LONGLONG spin = frequency.QuadPart * VP_SNAP_PAR_HELPER_SPIN_US / 1000000;
+    for (;;) {
+        const LONG c = InterlockedCompareExchange(&s_vp_snap_par.claimed.v, 0, 0);
+        if (c == InterlockedCompareExchange(&s_vp_snap_par.tail.v, 0, 0)) {
+            /* Draws arrive microseconds apart while a walk records: spin
+             * briefly, then sleep until a push sees idle and wakes us. */
+            LARGE_INTEGER start, now;
+            QueryPerformanceCounter(&start);
+            int found = 0;
+            do {
+                for (int i = 0; i < 8; ++i) YieldProcessor();
+                found = InterlockedCompareExchange(&s_vp_snap_par.tail.v, 0, 0) !=
+                        InterlockedCompareExchange(&s_vp_snap_par.claimed.v, 0, 0);
+                QueryPerformanceCounter(&now);
+            } while (!found && now.QuadPart - start.QuadPart < spin);
+            if (found) continue;
+            InterlockedExchange(&s_vp_snap_par.idle.v, 1);
+            if (InterlockedCompareExchange(&s_vp_snap_par.tail.v, 0, 0) ==
+                InterlockedCompareExchange(&s_vp_snap_par.claimed.v, 0, 0)) {
+                InterlockedIncrement64(&s_vp_snap_par.helper_sleeps);
+                WaitForSingleObject(s_vp_snap_par.wake, INFINITE);
+            }
+            InterlockedExchange(&s_vp_snap_par.idle.v, 0);
+            continue;
+        }
+        if (InterlockedCompareExchange(&s_vp_snap_par.claimed.v,
+                                       (LONG)((u32)c + 1u), c) != c)
+            continue; /* a drain took the remaining items */
+        VPSnapParItem* it = &s_vp_snap_par.ring[(u32)c & (VP_SNAP_PAR_RING - 1u)];
+        vp_snap_par_observe(it);
+        if (it->queried) {
+            InterlockedIncrement64(&s_vp_snap_par.helper_queries);
+            InterlockedAdd64(&s_vp_snap_par.helper_ticks, it->query_ticks);
+        }
+        InterlockedExchange(&s_vp_snap_par.done.v, (LONG)((u32)c + 1u));
+        if (InterlockedCompareExchange(&s_vp_snap_par.waiting.v, 0, 0))
+            SetEvent(s_vp_snap_par.done_event);
+    }
+}
+
+static int vp_snap_par_start(void)
+{
+    if (s_vp_snap_par.thread) return 1;
+    if (s_vp_snap_par.broken) return 0;
+    s_vp_snap_par.wake = CreateEventW(NULL, FALSE, FALSE, NULL);
+    s_vp_snap_par.done_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    HANDLE thread = s_vp_snap_par.wake && s_vp_snap_par.done_event
+        ? CreateThread(NULL, 0, vp_snap_par_main, NULL, 0, NULL) : NULL;
+    if (!thread) {
+        const DWORD error = GetLastError();
+        if (s_vp_snap_par.wake) CloseHandle(s_vp_snap_par.wake);
+        if (s_vp_snap_par.done_event) CloseHandle(s_vp_snap_par.done_event);
+        s_vp_snap_par.wake = s_vp_snap_par.done_event = NULL;
+        s_vp_snap_par.broken = 1;
+        fprintf(stderr, "[TJ-SNAP-PARALLEL] helper creation failed (%lu); "
+                "serial captures\n", (unsigned long)error);
+        return 0;
+    }
+    SetThreadPriority(thread, THREAD_PRIORITY_ABOVE_NORMAL);
+    s_vp_snap_par.thread = thread;
+    fprintf(stderr, "[TJ-SNAP-PARALLEL] helper started (spin %u us)\n",
+            VP_SNAP_PAR_HELPER_SPIN_US);
+    return 1;
+}
+
+static void vp_snap_par_drain(u32 site);
+
+static void vp_snap_par_push(D3D12DrawRecord* dr, u32 unit, u32 vertex,
+                             u32 off, u32 w, u32 h, u32 depth, u32 fmt,
+                             u32 pitch, int cube, u32 dimension, u32 mips,
+                             int has_border)
+{
+    LONG tail = s_vp_snap_par.tail.v;
+    if ((u32)tail - (u32)s_vp_snap_par.applied >= VP_SNAP_PAR_RING) {
+        ++s_vp_snap_par.win.ring_full;
+        vp_snap_par_drain(VP_SNAP_PAR_SITE_RING);
+        tail = s_vp_snap_par.tail.v;
+    }
+    VPSnapParItem* it = &s_vp_snap_par.ring[(u32)tail & (VP_SNAP_PAR_RING - 1u)];
+    it->dr = dr;
+    it->unit = unit;
+    it->vertex = vertex;
+    it->off = off; it->w = w; it->h = h; it->depth = depth; it->fmt = fmt;
+    it->pitch = pitch; it->cube = cube; it->dimension = dimension;
+    it->mips = mips; it->has_border = has_border;
+    InterlockedExchange(&s_vp_snap_par.tail.v, (LONG)((u32)tail + 1u));
+    ++s_vp_snap_par_pending;
+    ++s_vp_snap_par.win.items;
+    /* Lost-wakeup safe: the helper sets idle before its last tail check. */
+    if (s_vp_snap_par.idle.v && InterlockedExchange(&s_vp_snap_par.idle.v, 0)) {
+        SetEvent(s_vp_snap_par.wake);
+        ++s_vp_snap_par.win.wakes;
+    }
+}
+
+/* Every item below tail observed: by the helper, or here when the helper is
+ * between items (claimed == done) -- then this drain claims the rest. */
+static void vp_snap_par_wait(LONG tail)
+{
+    static LONGLONG spin;
+    if (!spin) {
+        LARGE_INTEGER frequency;
+        QueryPerformanceFrequency(&frequency);
+        spin = frequency.QuadPart * VP_SNAP_PAR_WAIT_SPIN_US / 1000000;
+        if (spin <= 0) spin = 1;
+    }
+    LARGE_INTEGER start, now;
+    QueryPerformanceCounter(&start);
+    for (;;) {
+        const LONG done = InterlockedCompareExchange(&s_vp_snap_par.done.v, 0, 0);
+        if (done == tail) return;
+        const LONG claimed = InterlockedCompareExchange(&s_vp_snap_par.claimed.v, 0, 0);
+        if (claimed == done &&
+            InterlockedCompareExchange(&s_vp_snap_par.claimed.v, tail, claimed) == claimed) {
+            LARGE_INTEGER begin, end;
+            QueryPerformanceCounter(&begin);
+            for (u32 i = (u32)claimed; i != (u32)tail; ++i) {
+                VPSnapParItem* it = &s_vp_snap_par.ring[i & (VP_SNAP_PAR_RING - 1u)];
+                vp_snap_par_observe(it);
+                s_vp_snap_par.win.steal_queries += (u64)it->queried;
+            }
+            QueryPerformanceCounter(&end);
+            s_vp_snap_par.win.steal_items += (u32)tail - (u32)claimed;
+            s_vp_snap_par.win.steal_ticks += (u64)(end.QuadPart - begin.QuadPart);
+            InterlockedExchange(&s_vp_snap_par.done.v, tail);
+            return;
+        }
+        for (int i = 0; i < 8; ++i) YieldProcessor();
+        QueryPerformanceCounter(&now);
+        if (now.QuadPart - start.QuadPart >= spin) {
+            /* The helper was preempted mid-item: block until it publishes. */
+            InterlockedExchange(&s_vp_snap_par.waiting.v, 1);
+            if (InterlockedCompareExchange(&s_vp_snap_par.done.v, 0, 0) != tail)
+                WaitForSingleObject(s_vp_snap_par.done_event, 1);
+            InterlockedExchange(&s_vp_snap_par.waiting.v, 0);
+        }
+    }
+}
+
+/* Apply in queue order: the ordinary capture of each, with its observation in
+ * place of the per-call query, then the serial loop's fault/prompt steps. */
+static void vp_snap_par_apply(LONG tail)
+{
+    s_vp_snap_par_applying = 1;
+    s_tj_label_early_ok = 0; /* fills counted records' snapshots/faults */
+    const u64 mismatches = s_vp_watch_mismatches;
+    for (u32 i = (u32)s_vp_snap_par.applied; i != (u32)tail; ++i) {
+        const VPSnapParItem* it = &s_vp_snap_par.ring[i & (VP_SNAP_PAR_RING - 1u)];
+        D3D12DrawRecord* dr = it->dr;
+        const u32 u = it->unit;
+        if (it->queried && it->state_before >= 0 && it->state_after < 0)
+            fprintf(stderr, "[TJ-TEXTURE-WATCH] unavailable error=%u; full byte checks retained\n",
+                    s_vp_write_watch.error);
+        VPSnapParObs obs;
+        obs.valid = it->queried;
+        obs.off = it->off;
+        obs.bytes = it->bytes;
+        /* An audit disable earlier in this drain: a serial capture after it
+         * would find the watch disabled (stamp 0, hint untouched). */
+        obs.stamp = s_vp_watch_mismatches != mismatches ? 0 : it->stamp;
+        obs.hint = it->hint;
+        obs.query_qpc = it->query_qpc;
+        if (it->vertex) {
+            if (vp_capture_tex_snapshot_obs(it->off, it->w, it->h, it->depth,
+                    it->fmt, it->pitch, it->cube, it->dimension, it->mips, 0,
+                    &dr->vtex_snapshot[u], &obs) != 0)
+                dr->vtex_snapshot_fault_mask |= 1u << u;
+        } else if (vp_capture_tex_snapshot_obs(it->off, it->w, it->h, it->depth,
+                       it->fmt, it->pitch, it->cube, it->dimension, it->mips,
+                       it->has_border, &dr->tex_snapshot[u], &obs) != 0) {
+            dr->tex_snapshot_fault_mask |= 1u << u;
+        }
+#ifdef PS3RECOMP_PROMPT_ART
+        else if (dr->tex_snapshot[u] &&
+                 (dr->tex_snapshot[u]->prompt_sig != (u64)s_tj_prompt_sig ||
+                  dr->tex_snapshot[u]->prompt_override))
+            tj_prompt_apply(dr, u);
+#endif
+    }
+    s_vp_snap_par.applied = tail;
+    s_vp_snap_par_pending = 0;
+    s_vp_snap_par_applying = 0;
+}
+
+static void vp_snap_par_drain(u32 site)
+{
+    const LONG tail = s_vp_snap_par.tail.v;
+    if (s_vp_snap_par_applying || s_vp_snap_par.applied == tail) return;
+    VPSnapParWindow* w = &s_vp_snap_par.win;
+    const u32 batch = (u32)tail - (u32)s_vp_snap_par.applied;
+    const u64 stolen_before = w->steal_ticks;
+    LARGE_INTEGER t0, t1, t2;
+    QueryPerformanceCounter(&t0);
+    vp_snap_par_wait(tail);
+    QueryPerformanceCounter(&t1);
+    vp_snap_par_apply(tail);
+    QueryPerformanceCounter(&t2);
+    ++w->drains;
+    if (batch > w->batch_max) w->batch_max = batch;
+    ++w->site[site < VP_SNAP_PAR_SITE_COUNT ? site : VP_SNAP_PAR_SITE_OTHER];
+    const u64 waited = (u64)(t1.QuadPart - t0.QuadPart);
+    const u64 stolen = w->steal_ticks - stolen_before;
+    w->wait_ticks += waited > stolen ? waited - stolen : 0;
+    w->apply_ticks += (u64)(t2.QuadPart - t1.QuadPart);
+}
+
+static void vp_snap_par_barrier_slow(u32 site)
+{
+    if (GetCurrentThreadId() != s_vp_snap_par.owner_tid) {
+        /* Snapshot state is single-threaded; such a caller would race the
+         * serial path as well. Never apply from it. */
+        if (InterlockedIncrement64(&s_vp_snap_par.foreign) == 1)
+            fprintf(stderr, "[TJ-SNAP-PARALLEL] barrier site=%u on a non-presenter "
+                    "thread with captures pending; left to the presenter\n", site);
+        return;
+    }
+    vp_snap_par_drain(site);
+}
+
+/* 0: every capture of this record was queued (possibly none); -1: capture
+ * serially. Same units, same order and same arguments as the serial loop. */
+static int vp_snap_par_queue_draw(D3D12DrawRecord* dr)
+{
+    if (!vp_snap_par_enabled()) return -1;
+    const DWORD tid = GetCurrentThreadId();
+    if (!s_vp_snap_par_pending) {
+        /* Nothing outstanding, so the watch may be read here. Its lazy setup
+         * (first use) and a disabled watch stay on the serial path. */
+        if (s_vp_write_watch.state != 1 || !vp_snap_par_start()) {
+            ++s_vp_snap_par.win.serial_draws;
+            return -1;
+        }
+        s_vp_snap_par.owner_tid = tid;
+    } else if (tid != s_vp_snap_par.owner_tid) {
+        InterlockedIncrement64(&s_vp_snap_par.foreign);
+        return -1;
+    }
+    const u32 fragment_mask = vp_fragment_texture_mask(dr);
+    for (u32 u = 0; u < RSX_MAX_TEXTURES; ++u) {
+        if (!(fragment_mask & (1u << u)) || !dr->tex[u].set ||
+            vp_record_texture_is_gpu_owned(dr, dr->tex[u].raw,
+                                            dr->tex[u].location))
+            continue;
+        vp_snap_par_push(dr, u, 0, dr->tex[u].off, dr->tex[u].w, dr->tex[u].h,
+                         dr->tex[u].depth, dr->tex[u].fmt, dr->tex[u].pitch,
+                         dr->tex[u].cube, dr->tex[u].dimension, dr->tex[u].mips,
+                         vp_tex_source_has_border(dr->tex[u].fmt,
+                                                  dr->tex[u].border_type));
+    }
+    for (u32 u = 0; u < RSX_MAX_VERTEX_TEXTURES; ++u) {
+        if (!dr->vtex[u].set ||
+            vp_record_texture_is_gpu_owned(dr, dr->vtex[u].raw,
+                                            dr->vtex[u].location))
+            continue;
+        vp_snap_par_push(dr, u, 1, dr->vtex[u].off, dr->vtex[u].w, dr->vtex[u].h,
+                         dr->vtex[u].depth, dr->vtex[u].fmt, dr->vtex[u].pitch,
+                         dr->vtex[u].cube, dr->vtex[u].dimension, dr->vtex[u].mips, 0);
+    }
+    return 0;
+}
+
+/* Audit (mode 2) found different bytes under an unchanged deferred stamp.
+ * Ask the OS whether the range was written after that query (a write between
+ * the deferred query and this compare) before the caller disables the watch. */
+static void vp_snap_par_audit_mismatch(u32 off, u32 bytes, u64 stamp,
+                                       const RsxTextureWriteStampHint* hint,
+                                       const VPSnapParObs* obs)
+{
+    extern u8* vm_base;
+    extern u32 ppu_vm_size;
+    const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ull << 32);
+    LARGE_INTEGER now, frequency;
+    QueryPerformanceCounter(&now);
+    QueryPerformanceFrequency(&frequency);
+    RsxTextureWriteStampHint probe = *hint;
+    const u64 fresh = vp_texture_write_stamp_percall(vm_base, vm_cap, off, bytes, &probe);
+    ++s_vp_snap_par.win.audit;
+    fprintf(stderr, "[TJ-SNAP-PARALLEL] audit mismatch off=0x%X bytes=%u "
+            "query_age_us=%llu post_query_write=%d\n", off, bytes,
+            (unsigned long long)(frequency.QuadPart > 0 && now.QuadPart > obs->query_qpc
+                ? (u64)(now.QuadPart - obs->query_qpc) * 1000000ull /
+                  (u64)frequency.QuadPart : 0),
+            fresh ? fresh != stamp : -1);
+}
+
+/* [TJ-PERF] suffix for the window just ended ("" when off), then a new one.
+ * sp_saved_est_us = helper query time minus drain waits for the helper: the
+ * query time the presenter no longer spent (an estimate; a helper query can
+ * cost more or less than the same query on the presenter). steal = queries a
+ * drain ran itself; d_* = drains by boundary kind. */
+static void vp_snap_par_window(char* out, size_t size)
+{
+    out[0] = '\0';
+    if (s_vp_snap_par_config <= 0) return;
+    static LARGE_INTEGER frequency;
+    if (!frequency.QuadPart) QueryPerformanceFrequency(&frequency);
+    const u64 f = (u64)frequency.QuadPart;
+    VPSnapParWindow* w = &s_vp_snap_par.win;
+    const u64 helper_queries = (u64)InterlockedExchange64(&s_vp_snap_par.helper_queries, 0);
+    const u64 helper_ticks = (u64)InterlockedExchange64(&s_vp_snap_par.helper_ticks, 0);
+    const u64 sleeps = (u64)InterlockedExchange64(&s_vp_snap_par.helper_sleeps, 0);
+    const u64 helper_us = f ? helper_ticks * 1000000ull / f : 0;
+    const u64 wait_us = f ? w->wait_ticks * 1000000ull / f : 0;
+    snprintf(out, size, " sp_items=%llu sp_drains=%llu sp_batch_max=%llu "
+             "sp_helper_q=%llu sp_helper_us=%llu sp_steal_items=%llu sp_steal_q=%llu "
+             "sp_steal_us=%llu sp_wait_us=%llu sp_apply_us=%llu sp_saved_est_us=%llu "
+             "sp_serial_draws=%llu sp_sleeps=%llu sp_wakes=%llu sp_ring_full=%llu "
+             "sp_audit=%llu sp_foreign_total=%llu sp_d_flush=%llu sp_d_label=%llu "
+             "sp_d_prefix=%llu sp_d_acquire=%llu sp_d_render=%llu sp_d_blit=%llu "
+             "sp_d_watch=%llu sp_d_ring=%llu sp_d_life=%llu sp_d_other=%llu%s",
+             (unsigned long long)w->items, (unsigned long long)w->drains,
+             (unsigned long long)w->batch_max, (unsigned long long)helper_queries,
+             (unsigned long long)helper_us, (unsigned long long)w->steal_items,
+             (unsigned long long)w->steal_queries,
+             (unsigned long long)(f ? w->steal_ticks * 1000000ull / f : 0),
+             (unsigned long long)wait_us,
+             (unsigned long long)(f ? w->apply_ticks * 1000000ull / f : 0),
+             (unsigned long long)(helper_us > wait_us ? helper_us - wait_us : 0),
+             (unsigned long long)w->serial_draws, (unsigned long long)sleeps,
+             (unsigned long long)w->wakes, (unsigned long long)w->ring_full,
+             (unsigned long long)w->audit,
+             (unsigned long long)s_vp_snap_par.foreign,
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_FLUSH],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_LABEL],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_PREFIX],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_ACQUIRE],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_RENDER],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_BLIT],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_WATCH],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_RING],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_LIFE],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_OTHER],
+             s_vp_snap_par.broken ? " sp_off=1" : "");
+    memset(w, 0, sizeof(*w));
+}
+
+/* ---------------------------------------------------------------------------
+ * TJ_SNAPSHOT_LATE_PROOF=1 (opt-in; needs TJ_TEXTURE_WRITE_WATCH=1 or 2).
+ * Unset or any other value never enters this code.
+ * A unit whose (off, bytes) hint names a tracked snapshot C (stamp S != 0)
+ * gets C now, with one reference: the serial stamp-equal reuse result. Its
+ * per-call query is not taken at the capture. ONE ordinary per-call query
+ * per distinct (off, bytes, C, S) runs at the next VP_SNAP_PAR_BARRIER (see
+ * the PARALLEL site list) or rsx_d3d12_backend_snapshot_late_resolve
+ * (walk-end GET, flip request).
+ *  - Clean (stamp still S): no write reached the range between the
+ *    observation that set S (before C's bytes were read) and this query,
+ *    which follows every capture it serves. Identical to serial.
+ *  - Dirty or unavailable: one ordinary capture here serves all owners; a
+ *    write ordered after the draw needs a guest observation of a barrier.
+ * The query never precedes a capture it serves (unlike TJ_WATCH_BATCH); the
+ * audit compare follows its own query directly (unlike PARALLEL).
+ * Mode 2: defers only when C equals memory at the capture; re-compares
+ * after a clean proof. lp_* counters ride on [TJ-PERF].
+ * -----------------------------------------------------------------------*/
+#define VP_LATE_MAX_ENTRIES 512u
+#define VP_LATE_MAX_OWNERS 4096u
+#define VP_LATE_SLOTS 1024u               /* power of two, > 2 x entries */
+#define VP_LATE_NONE 0xFFFFFFFFu
+#define VP_LATE_SITE_GCM ((u32)VP_SNAP_PAR_SITE_COUNT)
+#define VP_LATE_NEWER_LOGS 16u
+typedef struct VPLateEntry {
+    VPTexSnapshot* cand;            /* one reference per owner */
+    u32 off, bytes;
+    u64 stamp;                      /* cand->source_write_stamp at deferral */
+    RsxTextureWriteStampHint hint;  /* cand->source_stamp_hint then */
+    u32 first_owner, last_owner, owners;
+} VPLateEntry;
+typedef struct VPLateOwner { D3D12DrawRecord* dr; u32 next; u16 unit; u8 vertex; } VPLateOwner;
+typedef struct VPLateWindow {
+    u64 deferred, entries, resolves, clean, dirty, recapture_fail, ticks;
+    u64 full, ineligible, a_tc_ne, a_tr, newer, slot_changed, nested, other_thread, memo_lowered;
+    u64 site[VP_SNAP_PAR_SITE_COUNT + 1];
+} VPLateWindow;
+typedef struct VPLateParams { u32 off, w, h, depth, fmt, pitch, dimension, mips; int cube, has_border; } VPLateParams;
+static int s_vp_late_config = -1; /* TJ_SNAPSHOT_LATE_PROOF, read once */
+static u32 s_vp_late_lo = 0xFFFFFFFFu; /* lowest record index a recapture rewrote */
+static struct {
+    int off;                        /* a foreign-thread barrier stopped deferral */
+    DWORD owner_tid;
+    u32 gen;                        /* slot_gen == gen: slot live this window */
+    u32 entry_count, owner_count, newer_logs;
+    volatile LONG64 foreign_total;
+    u32 slot_gen[VP_LATE_SLOTS];
+    u16 slot_entry[VP_LATE_SLOTS];
+    VPLateEntry entries[VP_LATE_MAX_ENTRIES];
+    VPLateOwner owners[VP_LATE_MAX_OWNERS];
+    VPLateWindow win;
+} s_vp_late = { .gen = 1 };
+
+static int vp_late_enabled(void)
+{
+    if (s_vp_late_config < 0) {
+        const char* value = getenv("TJ_SNAPSHOT_LATE_PROOF");
+        const int requested = value && (!strcmp(value, "1") || !strcmp(value, "2"));
+        const char* inactive = value && value[0] && !requested ? "value_must_be_1_or_2" : NULL;
+        int mode = 0;
+        if (requested) {
+            const char* label_pass = getenv("TJ_NON3D_LABEL_PASS");
+            mode = vp_texture_write_watch_mode();
+            if (!mode) inactive = "needs_TJ_TEXTURE_WRITE_WATCH=1_or_2";
+            else if (vp_watch_batch_enabled()) inactive = "TJ_WATCH_BATCH";
+            else if (vp_snapshot_frame_reuse_enabled()) inactive = "TJ_SNAPSHOT_FRAME_REUSE";
+            else if (vp_snap_par_enabled()) inactive = "TJ_SNAPSHOT_PARALLEL";
+            else if (label_pass && strcmp(label_pass, "1") == 0)
+                inactive = "TJ_NON3D_LABEL_PASS_unhooked_stores";
+            else if (getenv("TJ_INDEXED_DIAG")) inactive = "TJ_INDEXED_DIAG";
+            else if (tj_gcm2d_backend_perf_enabled()) inactive = "TJ_GCM2D_BACKEND_PERF";
+        }
+        s_vp_late_config = requested && !inactive ? value[0] - '0' : 0;
+        if (value && value[0])
+            fprintf(stderr, "[TJ-SNAP-LATE] enabled=%d%s%s watch_mode=%d entries=%u owners=%u\n",
+                    s_vp_late_config, inactive ? " inactive=" : "", inactive ? inactive : "",
+                    mode, VP_LATE_MAX_ENTRIES, VP_LATE_MAX_OWNERS);
+    }
+    return s_vp_late_config > 0 && !s_vp_late.off;
+}
+
+/* Exactly the arguments the serial loop below passes for this unit. */
+static void vp_late_params(const D3D12DrawRecord* dr, u32 u, int vertex, VPLateParams* p)
+{
+    if (vertex) {
+        p->off = dr->vtex[u].off; p->w = dr->vtex[u].w; p->h = dr->vtex[u].h;
+        p->depth = dr->vtex[u].depth; p->fmt = dr->vtex[u].fmt; p->pitch = dr->vtex[u].pitch;
+        p->dimension = dr->vtex[u].dimension; p->mips = dr->vtex[u].mips;
+        p->cube = dr->vtex[u].cube; p->has_border = 0;
+    } else {
+        p->off = dr->tex[u].off; p->w = dr->tex[u].w; p->h = dr->tex[u].h;
+        p->depth = dr->tex[u].depth; p->fmt = dr->tex[u].fmt; p->pitch = dr->tex[u].pitch;
+        p->dimension = dr->tex[u].dimension; p->mips = dr->tex[u].mips; p->cube = dr->tex[u].cube;
+        p->has_border = vp_tex_source_has_border(dr->tex[u].fmt, dr->tex[u].border_type);
+    }
+}
+
+/* 1: deferred (the slot holds cand with one reference); 0: capture now. */
+static int vp_late_try_defer(D3D12DrawRecord* dr, u32 u, int vertex)
+{
+    extern u8* vm_base;
+    extern u32 ppu_vm_size;
+    if (s_vp_late.off || s_vp_write_watch.state != 1) return 0;
+    const DWORD tid = GetCurrentThreadId();
+    if (!s_vp_late_pending) s_vp_late.owner_tid = tid;
+    else if (tid != s_vp_late.owner_tid) { ++s_vp_late.win.other_thread; return 0; }
+    if (s_vp_late.entry_count >= VP_LATE_MAX_ENTRIES ||
+        s_vp_late.owner_count >= VP_LATE_MAX_OWNERS) { ++s_vp_late.win.full; return 0; }
+    VPLateParams p;
+    vp_late_params(dr, u, vertex, &p);
+    u32 bytes = 0;
+    if (!p.w || !p.h || !p.depth ||
+        vp_tex_source_span(p.w, p.h, p.depth, p.fmt, p.pitch, p.cube, p.dimension,
+                           p.mips, p.has_border, &bytes, NULL) != 0)
+        return 0;
+    const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ull << 32);
+    if (!vm_base || (u64)p.off + bytes > vm_cap || bytes > VP_TEX_SNAPSHOT_SINGLE_MAX_BYTES)
+        return 0;
+    VPTexSnapshot* cand = vp_texture_snapshot_hint_find(p.off, bytes);
+    if (!cand || !cand->source_write_stamp || cand->is_override) { ++s_vp_late.win.ineligible; return 0; }
+#ifdef PS3RECOMP_PROMPT_ART
+    if (!vertex && (cand->prompt_sig != (u64)s_tj_prompt_sig || cand->prompt_override)) {
+        ++s_vp_late.win.ineligible; return 0; }
+#endif
+    if (s_vp_late_config == 1 && vp_texture_write_watch_mode() == 2 &&
+        !vp_snapshot_bytes_equal(cand->data, vm_base + p.off, bytes)) {
+        ++s_vp_late.win.a_tc_ne;   /* serial path: query, hash, copy now */
+        return 0;
+    }
+    const u64 stamp = cand->source_write_stamp;
+    u32 key = p.off ^ (bytes * 0x9E3779B9u) ^ (u32)((uintptr_t)cand >> 4) ^ (u32)stamp;
+    key ^= key >> 16u; key *= 0x85EBCA6Bu; key ^= key >> 13u;
+    u32 index = VP_LATE_NONE;
+    for (u32 probe = 0; probe < VP_LATE_SLOTS && index == VP_LATE_NONE; ++probe) {
+        const u32 s = (key + probe) & (VP_LATE_SLOTS - 1u);
+        if (s_vp_late.slot_gen[s] != s_vp_late.gen) {
+            index = s_vp_late.entry_count++;
+            VPLateEntry* fresh = &s_vp_late.entries[index];
+            fresh->cand = cand; fresh->off = p.off; fresh->bytes = bytes; fresh->stamp = stamp;
+            fresh->hint = cand->source_stamp_hint;
+            fresh->first_owner = fresh->last_owner = VP_LATE_NONE; fresh->owners = 0;
+            s_vp_late.slot_gen[s] = s_vp_late.gen;
+            s_vp_late.slot_entry[s] = (u16)index;
+            ++s_vp_late.win.entries;
+        } else {
+            const VPLateEntry* live = &s_vp_late.entries[s_vp_late.slot_entry[s]];
+            if (live->cand == cand && live->off == p.off && live->bytes == bytes && live->stamp == stamp)
+                index = s_vp_late.slot_entry[s];
+        }
+    }
+    if (index == VP_LATE_NONE) { ++s_vp_late.win.full; return 0; }
+    if (s_vp_late_config == 2) { ++s_vp_late.win.deferred; ++s_vp_late_pending; return 0; } /* count only: serial capture follows */
+    VPLateEntry* e = &s_vp_late.entries[index];
+    const u32 o = s_vp_late.owner_count++;
+    s_vp_late.owners[o].dr = dr; s_vp_late.owners[o].next = VP_LATE_NONE;
+    s_vp_late.owners[o].unit = (u16)u; s_vp_late.owners[o].vertex = (u8)(vertex != 0);
+    if (e->last_owner == VP_LATE_NONE) e->first_owner = o;
+    else s_vp_late.owners[e->last_owner].next = o;
+    e->last_owner = o;
+    ++e->owners;
+    ++cand->refs;                   /* the serial reuse's reference */
+    if (vertex) dr->vtex_snapshot[u] = cand; else dr->tex_snapshot[u] = cand;
+    ++s_vp_late_pending;
+    ++s_vp_late.win.deferred;
+    return 1;
+}
+
+/* Trace parity: a deferred unit counts as one capture in texture_snapshot_*. */
+static int vp_late_capture_unit(D3D12DrawRecord* dr, u32 u, int vertex)
+{
+    const int trace = tj_draw_cost_trace_enabled();
+    const LONGLONG start = trace ? tj_present_work_trace_sync_begin() : 0;
+    const int deferred = vp_late_try_defer(dr, u, vertex);
+    if (trace) {
+        u64 none = 0;
+        if (deferred)
+            s_tj_present_work_trace.texture_snapshot_bytes +=
+                (vertex ? dr->vtex_snapshot[u] : dr->tex_snapshot[u])->bytes;
+        tj_present_work_trace_sync_finish(start, &s_tj_present_work_trace.texture_snapshot_ticks,
+            deferred ? &s_tj_present_work_trace.texture_snapshot_calls : &none);
+    }
+    return deferred;
+}
+
+static void vp_late_recapture(const VPLateEntry* e, int mode, u32 site)
+{
+    const VPLateOwner* first = &s_vp_late.owners[e->first_owner];
+    VPLateParams p;
+    vp_late_params(first->dr, first->unit, first->vertex, &p);
+    VPTexSnapshot* result = NULL;
+    /* The ordinary serial capture here; C still holds references, so dedup can find it. */
+    const int rc = vp_capture_tex_snapshot_impl(p.off, p.w, p.h, p.depth, p.fmt, p.pitch,
+                                                p.cube, p.dimension, p.mips, p.has_border, &result);
+    if (rc != 0) { result = NULL; ++s_vp_late.win.recapture_fail; }
+    if (mode == 2 && result && result != e->cand && result->bytes == e->bytes &&
+        !vp_snapshot_bytes_equal(result->data, e->cand->data, e->bytes)) {
+        ++s_vp_late.win.newer;      /* unordered writer, or a missed barrier: classify */
+        if (s_vp_late.newer_logs++ < VP_LATE_NEWER_LOGS)
+            fprintf(stderr, "[TJ-SNAP-LATE] newer off=0x%X bytes=%u owners=%u site=%u\n",
+                    e->off, e->bytes, e->owners, site);
+    }
+    int first_use = 1;
+    for (u32 o = e->first_owner; o != VP_LATE_NONE; o = s_vp_late.owners[o].next) {
+        const VPLateOwner* w = &s_vp_late.owners[o];
+        D3D12DrawRecord* dr = w->dr;
+        VPTexSnapshot** slot = w->vertex ? &dr->vtex_snapshot[w->unit] : &dr->tex_snapshot[w->unit];
+        if (*slot != e->cand) { ++s_vp_late.win.slot_changed; continue; }
+        vp_texture_snapshot_release(slot);          /* the deferred reference to C */
+        { const ptrdiff_t k = dr - s_d3d.draws;
+          const u32 idx = (k < 0 || k >= MAX_DRAWS) ? 0u : (u32)k;
+          if (idx < s_vp_late_lo) s_vp_late_lo = idx; }
+        if (rc != 0) {
+            if (w->vertex) dr->vtex_snapshot_fault_mask |= 1u << w->unit;
+            else dr->tex_snapshot_fault_mask |= 1u << w->unit;
+            continue;
+        }
+        if (!result) continue;
+        if (!first_use) ++result->refs;
+        first_use = 0;
+        *slot = result;
+#ifdef PS3RECOMP_PROMPT_ART
+        if (!w->vertex && (result->prompt_sig != (u64)s_tj_prompt_sig || result->prompt_override))
+            tj_prompt_apply(dr, w->unit);
+#endif
+    }
+    if (result && first_use) vp_texture_snapshot_release(&result);
+}
+
+static void vp_late_resolve(u32 site)
+{
+    extern u8* vm_base;
+    extern u32 ppu_vm_size;
+    if (!s_vp_late_pending || s_vp_late_resolving) return;
+    s_vp_late_resolving = 1;
+    LARGE_INTEGER begin, end;
+    QueryPerformanceCounter(&begin);
+    const int trace = tj_draw_cost_trace_enabled();
+    const LONGLONG trace_start = trace ? tj_present_work_trace_sync_begin() : 0;
+    const int mode = vp_texture_write_watch_mode();
+    const int churn_trace = vp_texture_churn_trace_enabled();
+    const u64 vm_cap = ppu_vm_size ? (u64)ppu_vm_size : (1ull << 32);
+    int changed = 0;
+    for (u32 i = 0; s_vp_late_config == 1 && i < s_vp_late.entry_count; ++i) {
+        const VPLateEntry* e = &s_vp_late.entries[i];
+        VPTexSnapshot* cand = e->cand;
+        RsxTextureWriteStampHint hint = e->hint;
+        const u64 stamp = vp_texture_write_stamp_percall(vm_base, vm_cap, e->off, e->bytes, &hint);
+        if (!stamp || stamp != e->stamp) {
+            ++s_vp_late.win.dirty; changed = 1;
+            vp_late_recapture(e, mode, site);
+            continue;
+        }
+        ++s_vp_late.win.clean;
+        if (mode == 2 && !vp_snapshot_bytes_equal(cand->data, vm_base + e->off, e->bytes)) {
+            RsxTextureWriteStampHint probe = hint;
+            const u64 fresh = vp_texture_write_stamp_percall(vm_base, vm_cap, e->off, e->bytes, &probe);
+            ++s_vp_late.win.a_tr;
+            ++s_vp_watch_mismatches;
+            fprintf(stderr, "[TJ-SNAP-LATE] audit mismatch off=0x%X bytes=%u owners=%u site=%u "
+                    "post_query_write=%d\n", e->off, e->bytes, e->owners, site,
+                    fresh ? fresh != stamp : -1);
+            rsx_texture_write_watch_fail(&s_vp_write_watch, ERROR_INVALID_DATA);
+            fprintf(stderr, "[TJ-TEXTURE-WATCH] audit mismatch off=0x%X bytes=%u\n", e->off, e->bytes);
+            /* Owners keep C: each equalled memory at its capture. */
+        }
+        s_vp_watch_hits += e->owners;
+        s_vp_watch_bytes += (u64)e->bytes * e->owners;
+        if (cand->source_off == e->off && cand->bytes == e->bytes &&
+            cand->source_write_stamp == e->stamp)
+            cand->source_stamp_hint = hint;
+        if (churn_trace && cand->pool_retained) {
+            InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_hint_reuses, (LONG64)e->owners);
+            InterlockedAdd64(&s_vp_texture_churn.snapshot_pool_hint_reuse_bytes,
+                             (LONG64)cand->bytes * (LONG64)e->owners);
+        }
+    }
+    s_vp_late.entry_count = s_vp_late.owner_count = 0;
+    if (++s_vp_late.gen == 0) { memset(s_vp_late.slot_gen, 0, sizeof(s_vp_late.slot_gen)); s_vp_late.gen = 1; }
+    s_vp_late_pending = 0;
+    if (changed && s_vp_late_lo < s_tj_label_early_ok) {
+        s_tj_label_early_ok = s_vp_late_lo; ++s_vp_late.win.memo_lowered; } /* monotone; expected never */
+    s_vp_late_lo = 0xFFFFFFFFu;
+    ++s_vp_late.win.resolves;
+    ++s_vp_late.win.site[site <= VP_LATE_SITE_GCM ? site : VP_SNAP_PAR_SITE_OTHER];
+    QueryPerformanceCounter(&end);
+    if (end.QuadPart > begin.QuadPart) s_vp_late.win.ticks += (u64)(end.QuadPart - begin.QuadPart);
+    if (trace) { u64 none = 0; tj_present_work_trace_sync_finish(trace_start,
+                     &s_tj_present_work_trace.texture_snapshot_ticks, &none); }
+    s_vp_late_resolving = 0;
+}
+
+static void vp_late_barrier_slow(u32 site)
+{
+    /* Thread first: a foreign barrier always stops deferral and is counted. */
+    if (GetCurrentThreadId() != s_vp_late.owner_tid) {
+        if (InterlockedIncrement64(&s_vp_late.foreign_total) == 1)
+            fprintf(stderr, "[TJ-SNAP-LATE] barrier site=%u on a non-owner thread with %d proofs "
+                    "pending; deferral stopped, the owner resolves them\n", site, s_vp_late_pending);
+        s_vp_late.off = 1;
+        return;
+    }
+    if (s_vp_late_capture_depth) { ++s_vp_late.win.nested; return; }
+    vp_late_resolve(site);
+}
+
+void rsx_d3d12_backend_snapshot_late_resolve(void)
+{
+    if (s_vp_late_pending && !s_vp_late_resolving) vp_late_barrier_slow(VP_LATE_SITE_GCM);
+}
+
+/* [TJ-PERF] suffix ("" when off). Saved queries = lp_def - lp_ent. */
+static void vp_late_window(char* out, size_t size)
+{
+    out[0] = '\0';
+    if (s_vp_late_config <= 0) return;
+    static LARGE_INTEGER frequency;
+    if (!frequency.QuadPart) QueryPerformanceFrequency(&frequency);
+    const VPLateWindow* w = &s_vp_late.win;
+    snprintf(out, size, " lp_def=%llu lp_ent=%llu lp_res=%llu lp_clean=%llu lp_dirty=%llu "
+             "lp_recap_fail=%llu lp_us=%llu lp_full=%llu lp_inel=%llu lp_a_tc_ne=%llu lp_a_tr=%llu "
+             "lp_newer=%llu lp_slot=%llu lp_nested=%llu lp_thread=%llu lp_foreign_total=%llu "
+             "lp_memo_lowered=%llu "
+             "lp_d_flush=%llu lp_d_label=%llu lp_d_prefix=%llu lp_d_acquire=%llu lp_d_render=%llu "
+             "lp_d_blit=%llu lp_d_life=%llu lp_d_other=%llu lp_d_gcm=%llu%s",
+             (unsigned long long)w->deferred, (unsigned long long)w->entries,
+             (unsigned long long)w->resolves, (unsigned long long)w->clean,
+             (unsigned long long)w->dirty, (unsigned long long)w->recapture_fail,
+             (unsigned long long)(frequency.QuadPart ? w->ticks * 1000000ull / (u64)frequency.QuadPart : 0),
+             (unsigned long long)w->full, (unsigned long long)w->ineligible,
+             (unsigned long long)w->a_tc_ne, (unsigned long long)w->a_tr,
+             (unsigned long long)w->newer, (unsigned long long)w->slot_changed,
+             (unsigned long long)w->nested, (unsigned long long)w->other_thread,
+             (unsigned long long)s_vp_late.foreign_total, (unsigned long long)w->memo_lowered,
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_FLUSH], (unsigned long long)w->site[VP_SNAP_PAR_SITE_LABEL],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_PREFIX], (unsigned long long)w->site[VP_SNAP_PAR_SITE_ACQUIRE],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_RENDER], (unsigned long long)w->site[VP_SNAP_PAR_SITE_BLIT],
+             (unsigned long long)w->site[VP_SNAP_PAR_SITE_LIFE], (unsigned long long)w->site[VP_SNAP_PAR_SITE_OTHER],
+             (unsigned long long)w->site[VP_LATE_SITE_GCM], s_vp_late.off ? " lp_off=1" : "");
+    memset(&s_vp_late.win, 0, sizeof(s_vp_late.win));
+}
+
+static void vp_capture_draw_texture_snapshots(D3D12DrawRecord* dr)
+{
+    if (!dr) return;
+    /* TJ_SNAPSHOT_PARALLEL: queue the captures below instead (same units and
+     * order); they are applied before anything can observe them. */
+    if (s_vp_snap_par_config && vp_snap_par_queue_draw(dr) == 0) return;
+    /* TJ_SNAPSHOT_LATE_PROOF: units served from their hinted snapshot are
+     * proven at the next barrier; the others capture here as before. No
+     * barrier inside this loop resolves (captures publish nothing). */
+    const int late = s_vp_late_config && vp_late_enabled();
+    if (late) ++s_vp_late_capture_depth;
+    const u32 fragment_mask = vp_fragment_texture_mask(dr);
+    for (u32 u = 0; u < RSX_MAX_TEXTURES; ++u) {
+        if (!(fragment_mask & (1u << u)) || !dr->tex[u].set ||
+            vp_record_texture_is_gpu_owned(dr, dr->tex[u].raw,
+                                            dr->tex[u].location))
+            continue;
+        if (late && vp_late_capture_unit(dr, u, 0)) continue;
+        if (vp_capture_tex_snapshot(dr->tex[u].off, dr->tex[u].w,
+                dr->tex[u].h, dr->tex[u].depth, dr->tex[u].fmt,
+                dr->tex[u].pitch, dr->tex[u].cube, dr->tex[u].dimension,
+                dr->tex[u].mips, vp_tex_source_has_border(
+                    dr->tex[u].fmt, dr->tex[u].border_type),
+                &dr->tex_snapshot[u]) != 0)
+            dr->tex_snapshot_fault_mask |= 1u << u;
+#ifdef PS3RECOMP_PROMPT_ART
+        /* PC key prompts: one compare unless this snapshot needs a decision
+         * for the latched signature or carries a key-cap override. */
+        else if (dr->tex_snapshot[u] &&
+                 (dr->tex_snapshot[u]->prompt_sig != (u64)s_tj_prompt_sig ||
+                  dr->tex_snapshot[u]->prompt_override))
+            tj_prompt_apply(dr, u);
+#endif
+    }
+    for (u32 u = 0; u < RSX_MAX_VERTEX_TEXTURES; ++u) {
+        if (!dr->vtex[u].set ||
+            vp_record_texture_is_gpu_owned(dr, dr->vtex[u].raw,
+                                            dr->vtex[u].location))
+            continue;
+        if (late && vp_late_capture_unit(dr, u, 1)) continue;
+        if (vp_capture_tex_snapshot(dr->vtex[u].off, dr->vtex[u].w,
+                dr->vtex[u].h, dr->vtex[u].depth, dr->vtex[u].fmt,
+                dr->vtex[u].pitch, dr->vtex[u].cube, dr->vtex[u].dimension,
+                dr->vtex[u].mips, 0,
+                &dr->vtex_snapshot[u]) != 0)
+            dr->vtex_snapshot_fault_mask |= 1u << u;
+    }
+    if (late) --s_vp_late_capture_depth;
+}
+
+/* Exact-hit slot identity for vp_upload_tex_slot, shared by its full scan and
+ * the TJ_LOOKUP_FASTPATH hint probe so both apply one test. It reads that
+ * function's normalized locals. */
+#define VP_TEX_SLOT_EXACT_HIT(cached) \
+    ((cached)->res && (cached)->up && (cached)->dxgi == (u32)dxfmt && \
+     (cached)->off == off && (cached)->w == w && (cached)->h == h && \
+     (cached)->depth == depth && (cached)->fmt == fmt && \
+     (cached)->pitch == src_pitch && (cached)->mips == mip_count && \
+     (cached)->cube == cube && (cached)->dimension == dimension && \
+     (cached)->has_border == has_border && \
+     (cached)->source_hash == source_hash && \
+     (cached)->source_snapshot == source_snapshot)
+_Static_assert(VP_TEX_SLOTS < 65535, "VPTexSnapshot slot hint is u16");
+
+static int vp_upload_tex_slot(u32 off, u32 w, u32 h, u32 depth,
+                              u32 fmt, u32 src_pitch, int cube,
+                              u32 dimension, u32 mip_count,
+                              int has_border,
+                              VPTexSnapshot* source_snapshot)
+{
+    extern uint8_t* vm_base;
+    VP_SNAP_PAR_BARRIER(RENDER);
+    if (!w || !h || !depth || !source_snapshot ||
+        !source_snapshot->data || !s_d3d.srv_heap) return -1;
+    if (dimension < 1u || dimension > 3u) dimension = 2u;
+    if (cube) { dimension = 2u; depth = 1u; }
+    if (dimension == 1u) { h = 1u; depth = 1u; }
+    const int is_3d = dimension == 3u;
+    /* Format classes use base = fmt & 0x9F to remove LN/UN. */
+    u32 basef = fmt & 0x9F;
+    VPTexFormatInfo info;
+    if (!vp_tex_format_info(basef, &info)) return -1;
+    has_border = has_border && !info.host_compressed;
+    int argb = (basef == 0x85);
+    int two_channel_8 = (basef == 0x8B || basef == 0x98 || basef == 0x99);
+    int dxt  = info.host_compressed;
+    int rgba16f = (basef == 0x9A);
+    u32 src_texel_bytes = info.block_width == 1u
+                        ? info.src_block_bytes
+                        : info.src_block_bytes / info.block_width;
+    DXGI_FORMAT dxfmt = info.dxgi;
+    /* D3D12 does not permit BC resources with TEXTURE3D. Decode exactly at
+     * upload time instead of inventing a BC3D route; the snapshot remains the
+     * original RSX/VTC byte layout. */
+    const int dxt_3d_rgba = is_3d && dxt;
+    if (dxt_3d_rgba) dxfmt = DXGI_FORMAT_R8G8B8A8_UNORM;
+    u32 blkrow = vp_tex_source_row_bytes(&info, w);
+    u32 blkrows = vp_tex_source_rows(&info, h);
+    mip_count = vp_tex_exact_mip_count(w, h, depth, fmt, dimension, mip_count);
+    VPTexSourceLevel base_source;
+    if (vp_tex_source_level(&info, fmt, w, h, depth, dimension,
+                            has_border, src_pitch, &base_source) != 0)
+        return -1;
+    int swz = base_source.swizzled;
+    u32 row_bytes = blkrow;
+    src_pitch = base_source.pitch;
+    u32 source_rows = blkrows;
+
+    u32 total_source_span = 0;
