+    rsx_process_method(&probe, NV4097_SET_TRANSFORM_CONSTANT + 4, 0xBF800000u);
+    CHECK(probe.tconst_probe_method_sequence == 11 && probe.vertex_constants[4][1] == -1.0f &&
