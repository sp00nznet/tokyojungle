+    InterlockedExchange64(&s_dvb.last_tick_qpc, 0);
+    InterlockedExchange64(&s_dvb.vblanks, 0);
+    InterlockedExchange64(&s_dvb.missed, 0);
+    InterlockedExchange64(&s_dvb.spurious, 0);
