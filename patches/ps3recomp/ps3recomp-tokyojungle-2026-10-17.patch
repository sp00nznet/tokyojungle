+static void d3d12_drag_update(HWND hwnd)
+{
+    POINT p;
+    if (!s_d3d12_drag.active || !GetCursorPos(&p)) return;
+    const LONG dx = p.x - s_d3d12_drag.cursor.x;
+    const LONG dy = p.y - s_d3d12_drag.cursor.y;
+    RECT r = s_d3d12_drag.rect;
+    const WPARAM hit = s_d3d12_drag.hit;
+    if (hit == HTCAPTION) {
+        SetWindowPos(hwnd, NULL, r.left + dx, r.top + dy, 0, 0,
+                     SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+        return;
+    }
+    const LONG min_w = GetSystemMetrics(SM_CXMINTRACK);
+    const LONG min_h = GetSystemMetrics(SM_CYMINTRACK);
+    if (hit == HTLEFT || hit == HTTOPLEFT || hit == HTBOTTOMLEFT)
+        r.left = r.left + dx < r.right - min_w ? r.left + dx : r.right - min_w;
+    if (hit == HTRIGHT || hit == HTTOPRIGHT || hit == HTBOTTOMRIGHT)
+        r.right = r.right + dx > r.left + min_w ? r.right + dx : r.left + min_w;
+    if (hit == HTTOP || hit == HTTOPLEFT || hit == HTTOPRIGHT)
+        r.top = r.top + dy < r.bottom - min_h ? r.top + dy : r.bottom - min_h;
+    if (hit == HTBOTTOM || hit == HTBOTTOMLEFT || hit == HTBOTTOMRIGHT)
+        r.bottom = r.bottom + dy > r.top + min_h ? r.bottom + dy : r.top + min_h;
+    SetWindowPos(hwnd, NULL, r.left, r.top, r.right - r.left, r.bottom - r.top,
+                 SWP_NOZORDER | SWP_NOACTIVATE);
+}
