+static void gcm2d_backend_halt(const char* reason)
+{
+    VP_SNAP_PAR_BARRIER(RENDER); /* serial captures preceded every halt */
+    if (!s_d3d.gcm2d_backend_halted) {
+        s_d3d.gcm2d_backend_halted = 1;
+        fprintf(stderr, "[GCM2D-GPU] HALT: %s; suppressing all GPU frames\n", reason);
+    }
+    s_d3d.gcm2d_batch_fault = 1;
+    gcm2d_discard_records();
