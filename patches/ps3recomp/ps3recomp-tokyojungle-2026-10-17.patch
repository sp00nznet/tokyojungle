+    }
+    case 7: for (u32 k = 0; k < n; ++k) out[k] = (float)p[k]; break;
+    default: for (u32 k = 0; k < n; ++k) out[k] = rd_bef(p + k * 4); break;
+    }
+    *out_ei = ei; *out_ea = ea;
+    return 1;
+}
