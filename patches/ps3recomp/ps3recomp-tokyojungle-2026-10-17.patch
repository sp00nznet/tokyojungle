+    DWORD ex_style = background_test ? WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW : 0;
+    DWORD style = frame_style | (background_test ? 0 : WS_VISIBLE);
+    int x = background_test ? -32000 : borderless ? monitor.left : CW_USEDEFAULT;
+    int y = background_test ? -32000 : borderless ? monitor.top : CW_USEDEFAULT;
