+/* Primitive restart resets assembly. Expand each restart-delimited segment to
+ * independent point/line/triangle lists because this backend uploads resolved
+ * vertices instead of a host index buffer. */
+static u32 upload_restart_vp_indexed(const rsx_state* state, u32 primitive,
+                                     u32 first, u32 count, u32* topology)
+{
+    if (d3d12_prefix_owner_before_upload(0, 1, NULL) != 0) return 0;
+    extern uint8_t* vm_base;
+    if (!state || !vm_base || !s_d3d.vp_vb_mapped ||
+        !rsx_has_vertex_position(state) || !state->restart_index_enable)
+        return 0;
+    u32 capacity = (MAX_VERTICES * VP_VERT_STRIDE - s_d3d.vp_vb_offset) /
+                   VP_VERT_STRIDE;
+    VPSlot* out = (VPSlot*)((u8*)s_d3d.vp_vb_mapped
+        + (u64)s_d3d.vp_parity * MAX_VERTICES * VP_VERT_STRIDE +
+          s_d3d.vp_vb_offset);
+    u32 emitted = 0;
+    *topology = primitive == RSX_PRIMITIVE_POINTS
+        ? D3D_TOPOLOGY_POINTLIST
