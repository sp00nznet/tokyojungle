+}
+
+/* Existing targets may already have their requested state and descriptors;
+ * neither a barrier nor view creation then visits them. Pin the actual target
+ * selection before binding, including depth-only and aliased MRT scratch. */
+static int d3d12_prefix_owner_targets_capture(int primary, int display, int scratch,
+                                             const int mrt[3], u8 depth)
+{
+    if (!s_d3d.prefix_owner_active) return 0;
+    if (primary < -1 || primary >= MAX_OFF_RTS || display < -1 ||
+        display >= MAX_DISPLAY_SURFACES || depth > MAX_DEPTH_SURFACES ||
+        s_d3d.frame_index >= FRAME_COUNT) {
+        gcm2d_backend_halt("prefix owner target selection");
+        return -1;
+    }
+    ID3D12Resource* target = display >= 0 ? s_d3d.display_surface[display].res
+        : scratch ? s_d3d.off_rt_scratch[0].res
+        : primary >= 0 ? s_d3d.off_rt[primary].res
+        : s_d3d.render_targets[s_d3d.frame_index];
+    ID3D12Resource* zeta = depth ? s_d3d.depth_surface[depth - 1u].res : s_d3d.depth_buffer;
+    if (!target || !zeta || d3d12_prefix_owner_object_capture(target) != 0 ||
+        d3d12_prefix_owner_object_capture(zeta) != 0) {
+        gcm2d_backend_halt("prefix owner target resource");
+        return -1;
+    }
+    for (u32 m = 0; m < 3 && mrt[m] >= 0; ++m) {
+        if (mrt[m] >= MAX_OFF_RTS) {
+            gcm2d_backend_halt("prefix owner MRT selection");
+            return -1;
+        }
+        target = scratch ? s_d3d.off_rt_scratch[m + 1u].res : s_d3d.off_rt[mrt[m]].res;
+        if (!target || d3d12_prefix_owner_object_capture(target) != 0) {
+            gcm2d_backend_halt("prefix owner MRT resource");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static int d3d12_prefix_owner_texture_reserved(u32 slot)
+{
+    if (!d3d12_prefix_ownership_enabled()) return 0;
+    if (slot >= VP_TEX_SLOTS) return 1;
+    for (u32 i = 0; i < 2; ++i)
+        if (s_d3d.prefix_owners[i].phase &&
+            s_d3d.prefix_owners[i].textures[slot].res) return 1;
+    return 0;
+}
+
+static int d3d12_prefix_owner_texture_mutable(u32 slot)
+{
+    if (d3d12_prefix_owner_texture_reserved(slot)) {
+        gcm2d_backend_halt("prefix owner texture overwrite");
+        return -1;
+    }
+    return 0;
+}
+
+static int d3d12_prefix_owner_texture_capture(u32 slot)
+{
+    if (!s_d3d.prefix_owner_active) return 0;
+    if (slot >= VP_TEX_SLOTS || s_d3d.prefix_owner_active > 2) {
+        gcm2d_backend_halt("prefix owner texture slot");
+        return -1;
+    }
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[s_d3d.prefix_owner_active - 1];
+    const VPTexSlot* source = &s_d3d.vp_tex[slot];
+    VPTexSlot* retained = &owner->textures[slot];
+    if (owner->phase != 1 || !source->res || !source->up || !source->source_snapshot) {
+        gcm2d_backend_halt("prefix owner texture version");
+        return -1;
+    }
+    if (retained->res) {
+        if (retained->res != source->res || retained->up != source->up ||
+            retained->source_snapshot != source->source_snapshot ||
+            retained->source_hash != source->source_hash ||
+            retained->off != source->off || retained->w != source->w ||
+            retained->h != source->h || retained->depth != source->depth ||
+            retained->fmt != source->fmt || retained->pitch != source->pitch ||
+            retained->mips != source->mips || retained->cube != source->cube ||
+            retained->dimension != source->dimension || retained->dxgi != source->dxgi ||
+            retained->has_border != source->has_border) {
+            gcm2d_backend_halt("prefix owner texture identity changed");
+            return -1;
+        }
+        return 0;
+    }
+    *retained = *source;
+    retained->res->lpVtbl->AddRef(retained->res);
+    retained->up->lpVtbl->AddRef(retained->up);
+    ++retained->source_snapshot->refs;
+    ++owner->texture_count;
+    return 0;
+}
+
+static int d3d12_prefix_owner_descriptors_init(D3D12PrefixOwner* owner)
+{
+    if (!s_d3d.srv_inc || !s_d3d.sampler_inc) {
+        gcm2d_backend_halt("prefix owner descriptor stride unavailable");
+        return -1;
+    }
+    if (!owner->srv_heap) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        hd.NumDescriptors = SRV_HEAP_SIZE;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (d3d12_command_result_checked(s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&owner->srv_heap),
+                "prefix owner SRV heap create") != 0) return -1;
+        D3D12_SHADER_RESOURCE_VIEW_DESC nv = {0};
+        nv.Format = DXGI_FORMAT_R8_UNORM;
+        nv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        nv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        nv.Texture2D.MipLevels = 1;
+        D3D12_CPU_DESCRIPTOR_HANDLE h;
+        owner->srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(owner->srv_heap, &h);
+        for (u32 i = 0; i < SRV_HEAP_SIZE; ++i) {
+            s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, NULL, &nv, h);
+            h.ptr += s_d3d.srv_inc;
+        }
+    }
+    if (!owner->sampler_heaps[0]) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+        hd.NumDescriptors = SAMPLER_HEAP_SIZE;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (d3d12_command_result_checked(s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                s_d3d.device, &hd, &IID_ID3D12DescriptorHeap,
+                (void**)&owner->sampler_heaps[0]), "prefix owner sampler heap create") != 0)
+            return -1;
+    }
+    return 0;
+}
+
+static void d3d12_prefix_owner_release_uploads(D3D12PrefixOwner* owner)
+{
+    for (u32 i = 0; i < owner->object_count; ++i) {
+        owner->objects[i]->lpVtbl->Release(owner->objects[i]);
+        owner->objects[i] = NULL;
+    }
+    owner->object_count = 0;
+    if (tj_lookup_fastpath_mode())
+        for (u32 i = 0; i < 2; ++i)
+            if (owner == &s_d3d.prefix_owners[i])
+                d3d12_prefix_object_hash_reset(&s_prefix_object_hash[i]);
+    for (u32 i = 0; i < VP_TEX_SLOTS; ++i) {
+        VPTexSlot* texture = &owner->textures[i];
+        if (texture->res) texture->res->lpVtbl->Release(texture->res);
+        if (texture->up) texture->up->lpVtbl->Release(texture->up);
+        vp_texture_snapshot_release(&texture->source_snapshot);
+        memset(texture, 0, sizeof(*texture));
+    }
+    owner->texture_count = 0;
+    for (u32 i = 0; i < 4; ++i) {
+        if (owner->uploads[i]) owner->uploads[i]->lpVtbl->Release(owner->uploads[i]);
+        owner->uploads[i] = NULL;
+        owner->upload_first[i] = owner->upload_bytes[i] = 0;
+    }
+    if (owner->completion_fence)
+        owner->completion_fence->lpVtbl->Release(owner->completion_fence);
+    owner->completion_fence = NULL;
+}
+
+static int d3d12_prefix_owner_context_init(u32 slot)
+{
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+    if (owner->list) return 0;
+    if (d3d12_command_result_checked(
+            s_d3d.device->lpVtbl->CreateCommandAllocator(s_d3d.device,
+                D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator,
+                (void**)&owner->allocator), "prefix owner allocator create") != 0)
+        return -1;
+    if (d3d12_command_result_checked(
+            s_d3d.device->lpVtbl->CreateCommandList(s_d3d.device, 0,
+                D3D12_COMMAND_LIST_TYPE_DIRECT, owner->allocator, NULL,
+                &IID_ID3D12GraphicsCommandList, (void**)&owner->list),
+            "prefix owner command-list create") != 0)
+        return -1;
+    owner->list->lpVtbl->QueryInterface(owner->list,
+        &IID_ID3D12GraphicsCommandList8, (void**)&owner->list8);
+    return d3d12_command_result_checked(owner->list->lpVtbl->Close(owner->list),
+                                        "prefix owner initial close");
+}
+
+static int d3d12_prefix_owner_begin(u32 slot)
+{
+    if (slot >= 2 || s_d3d.prefix_owner_active || s_d3d.gcm2d_backend_halted ||
+        !s_d3d.device || !s_d3d.fence || s_d3d.prefix_owners[slot].phase) {
+        gcm2d_backend_halt("prefix owner reservation invariant");
+        return -1;
+    }
+    if (d3d12_prefix_owner_context_init(slot) != 0) return -1;
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+    if (d3d12_prefix_owner_descriptors_init(owner) != 0) return -1;
+    owner->uploads[0] = s_d3d.vertex_buffer;
+    owner->uploads[1] = s_d3d.vp_vb;
+    owner->uploads[2] = s_d3d.vp_cb;
+    owner->uploads[3] = s_d3d.vp_fpcb;
+    owner->upload_bytes[0] = (u64)MAX_VERTICES * VERTEX_STRIDE;
+    owner->upload_bytes[1] = (u64)MAX_VERTICES * 256u; /* same bank size as vp_vb allocation */
+    owner->upload_bytes[2] = (u64)MAX_DRAWS * VP_CB_STRIDE;
+    owner->upload_bytes[3] = (u64)MAX_DRAWS * FP_CB_STRIDE;
+    for (u32 i = 0; i < 4; ++i) {
+        owner->upload_first[i] = i ? slot * owner->upload_bytes[i] : 0;
+        if (owner->uploads[i]) owner->uploads[i]->lpVtbl->AddRef(owner->uploads[i]);
+    }
+    owner->completion_fence = s_d3d.fence;
+    owner->completion_fence->lpVtbl->AddRef(owner->completion_fence);
+    owner->fence_value = 0;
+    owner->sequence = 0;
+    owner->label_count = owner->label_flush_kind = 0;
+    owner->signal_queued = 0;
+    owner->cpu_retirement_ready = 0;
+    owner->completion_checked = 0;
+    owner->phase = 1;
+    return 0;
+}
+
+static int d3d12_prefix_owner_before_upload(int basic, int vertex_only,
+                                           const D3D12DrawRecord* retained)
+{
+    if (!d3d12_prefix_ownership_enabled()) return 0;
+    if (s_d3d.gcm2d_backend_halted) return -1;
+    if (s_d3d.prefix_deferred_owner &&
+        (basic || s_d3d.prefix_deferred_owner == (u32)s_d3d.vp_parity + 1)) {
+        /* Recording can encounter a basic-upload fallback. Clear its prepare
+         * marker through the phase-1 retirement path before rechecking banks. */
+        if (s_d3d.prefix_prepare_owner) {
+            if (d3d12_prefix_prepare_before_wait() != 0) return -1;
+        } else if (d3d12_prefix_overlap_drain(RSX_COMPLETION_RESOURCE_RELEASE) != 0)
+            return -1;
+    }
+    /* Only a successful new early A retirement creates this obligation.
+     * An ordinary deferred batch keeps its existing overlap behavior. Exact B
+     * sequence matching also excludes a subsequently reused owner slot. */
+    if (s_d3d.prefix_vertex_prepare_sequence) {
+        const u32 latest = s_d3d.prefix_deferred_owner;
+        if (!latest || latest > 2 ||
+            s_d3d.prefix_owners[latest - 1].sequence !=
+                s_d3d.prefix_vertex_prepare_sequence)
+            s_d3d.prefix_vertex_prepare_sequence = 0;
+        else if (!vertex_only) {
+            /* Packed/depth aliases can fall back to CPU texture snapshots.
+             * The retained program masks only this late exact-B obligation;
+             * ordinary callers and the early bank gate keep all bindings. */
+            if (d3d12_prefix_current_gpu_alias(1, retained) &&
+                d3d12_prefix_overlap_drain(RSX_COMPLETION_RESOURCE_RELEASE) != 0)
+                return -1;
+            s_d3d.prefix_vertex_prepare_sequence = 0;
+        }
+    }
+    if (s_d3d.prefix_deferred_owner && s_d3d.prefix_deferred_owner <= 2) {
+        static u32 reported_pending;
+        const u32 slot = s_d3d.prefix_deferred_owner - 1, bit = 1u << slot;
+        const D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+        if (!(reported_pending & bit) && owner->phase == 2 && owner->signal_queued) {
+            u64 completed = owner->completion_fence->lpVtbl->GetCompletedValue(owner->completion_fence);
+            if (completed != UINT64_MAX && completed < owner->fence_value) {
+                reported_pending |= bit;
+                fprintf(stderr, "[TJ-PREFIX-OVERLAP] cpu_prepare_pending slot=%u fence=%llu completed=%llu next_bank=%d\n",
+                    slot, (unsigned long long)owner->fence_value,
+                    (unsigned long long)completed, s_d3d.vp_parity);
+            }
+        }
+    }
+    if (s_d3d.vp_parity < 0 || s_d3d.vp_parity > 1) {
+        gcm2d_backend_halt("prefix owner upload parity");
+        return -1;
+    }
+    /* The first CPU VP upload precedes owner_begin. Reclaim only its old bank
+     * in the proven empty-record state; all ordinary/observer paths still drain. */
+    if (!basic && d3d12_prefix_queue_ahead_enabled() &&
+        s_d3d.prefix_owners[s_d3d.vp_parity].phase == 2 &&
+        s_d3d.prefix_deferred_owner != (u32)s_d3d.vp_parity + 1) {
+        if (d3d12_prefix_queue_ahead_record_bank_ready(vertex_only)) {
+            const u32 slot = (u32)s_d3d.vp_parity;
+            const u32 latest = s_d3d.prefix_deferred_owner;
+            if (d3d12_prefix_queue_ahead_retire_old(slot, s_tj_completion_reason) != 0)
+                return -1;
+            if (!s_d3d.prefix_owners[slot].phase &&
+                s_d3d.prefix_deferred_owner == latest) {
+                ++s_d3d.prefix_queue_ahead_record_retires;
+                if (vertex_only && d3d12_prefix_vertex_prepare_overlap_enabled())
+                    s_d3d.prefix_vertex_prepare_sequence =
+                        s_d3d.prefix_owners[latest - 1].sequence;
+            }
+        } else if (d3d12_prefix_overlap_drain(RSX_COMPLETION_RESOURCE_RELEASE) != 0)
+            return -1;
+    }
+    for (u32 i = 0; i < 2; ++i) {
+        const D3D12PrefixOwner* owner = &s_d3d.prefix_owners[i];
+        if (owner->phase == 3 ||
+            (owner->phase == 2 && (basic || i == (u32)s_d3d.vp_parity)) ||
+            (owner->phase == 1 && s_d3d.prefix_owner_active != i + 1)) {
+            gcm2d_backend_halt("prefix owner upload still reserved");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static int d3d12_prefix_owner_submit(void)
+{
+    if (!s_d3d.prefix_owner_active) return 0;
+    if (s_d3d.prefix_owner_active > 2) {
+        gcm2d_backend_halt("prefix owner active slot");
+        return -1;
+    }
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[s_d3d.prefix_owner_active - 1];
+    if (s_d3d.gcm2d_backend_halted || owner->phase != 1 || owner->srv_heap != s_d3d.srv_heap ||
+        owner->sampler_heaps[0] != s_d3d.sampler_heaps[0] ||
+        s_d3d.frame_index >= FRAME_COUNT ||
+        s_d3d.fence_values[s_d3d.frame_index] >= UINT64_MAX - 1 ||
+        s_d3d.prefix_submit_sequence == UINT64_MAX ||
+        s_d3d.texture_label_count > d3d12_texture_label_cap() || s_d3d.texture_label_armed) {
+        gcm2d_backend_halt("prefix owner submission invariant");
+        return -1;
+    }
+    owner->frame_index = s_d3d.frame_index;
+    owner->sequence = ++s_d3d.prefix_submit_sequence;
+    owner->label_count = s_d3d.texture_label_count;
+    owner->label_flush_kind = s_d3d.texture_label_flush_kind;
+    memcpy(owner->labels, s_d3d.texture_labels,
+           owner->label_count * sizeof(owner->labels[0]));
+    s_d3d.texture_label_count = s_d3d.texture_label_flush_kind = 0;
+    memcpy(owner->sampler_heaps, s_d3d.sampler_heaps, sizeof(owner->sampler_heaps));
+    owner->phase = 2; /* Retain even if subsequent queue Signal fails. */
+    return 0;
+}
+
+static int d3d12_prefix_owner_signal(void)
+{
+    if (!s_d3d.prefix_owner_active || s_d3d.prefix_owner_active > 2) {
+        gcm2d_backend_halt("prefix owner signal slot");
+        return -1;
+    }
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[s_d3d.prefix_owner_active - 1];
+    if (s_d3d.gcm2d_backend_halted || owner->phase != 2 || owner->signal_queued ||
+        owner->fence_value || owner->completion_fence != s_d3d.fence ||
+        owner->frame_index != s_d3d.frame_index ||
+        signal_for_gpu_checked(&owner->fence_value) != 0) {
+        owner->phase = 3;
+        gcm2d_backend_halt("prefix owner queue signal");
+        return -1;
+    }
+    owner->signal_queued = 1;
+    return 0;
+}
+
+static int d3d12_prefix_owner_checked_completion(u32 slot, int result)
+{
+    if (slot >= 2) {
+        gcm2d_backend_halt("prefix owner completion slot");
+        return -1;
+    }
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+    if (result != 0 || s_d3d.gcm2d_backend_halted || owner->phase != 2 ||
+        !owner->signal_queued || !owner->fence_value || owner->fence_value == UINT64_MAX ||
+        !owner->completion_fence || owner->completion_fence != s_d3d.fence ||
+        owner->frame_index >= FRAME_COUNT) {
+        owner->phase = 3;
+        gcm2d_backend_halt("prefix owner completion ticket");
+        return -1;
+    }
+    u64 completed = owner->completion_fence->lpVtbl->GetCompletedValue(owner->completion_fence);
+    if (completed == UINT64_MAX || completed < owner->fence_value) {
+        owner->phase = 3;
+        gcm2d_backend_halt("prefix owner checked fence");
+        return -1;
+    }
+    owner->completion_checked = 1;
+    tj_prefix_gpu_collect(slot);
+    return 0;
+}
+
+static int d3d12_prefix_owner_wait(u32 slot, u32 site,
+                                   RsxD3D12CompletionReason reason)
+{
+    const int diagnostic = tj_prefix_wait_trace_enabled();
+    if ((unsigned)reason >= RSX_COMPLETION_REASON_COUNT) reason = RSX_COMPLETION_OTHER;
+    if (slot >= 2) {
+        if (diagnostic)
+            tj_prefix_wait_trace_owner(site, reason, TJ_PREFIX_WAIT_PRECHECK_FAILURE, 0, 0, 0);
+        gcm2d_backend_halt("prefix owner wait slot");
+        return -1;
+    }
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+    if (s_d3d.gcm2d_backend_halted || owner->phase != 2 || !owner->signal_queued ||
+        !owner->fence_value || owner->fence_value == UINT64_MAX ||
+        owner->completion_fence != s_d3d.fence) {
+        if (diagnostic)
+            tj_prefix_wait_trace_owner(site, reason, TJ_PREFIX_WAIT_PRECHECK_FAILURE, 0, 0, 0);
+        return d3d12_prefix_owner_checked_completion(slot, -1);
+    }
+    tj_prefix_gpu_wait_start(slot);
+    const u64 wait_ticks_before = diagnostic
+        ? s_tj_present_work_trace.owner_wait_ticks : 0;
+    const u64 clock_invalid_before = diagnostic
+        ? s_tj_present_work_trace.cpu_clock_invalid : 0;
+    LONGLONG wait_mark = tj_present_work_trace_sync_begin();
+    int wait_result = wait_for_fence_value_checked(owner->fence_value, 6000);
+    tj_present_work_trace_sync_finish(wait_mark, &s_tj_present_work_trace.owner_wait_ticks,
+                                      &s_tj_present_work_trace.owner_wait_calls);
+    const u64 elapsed_ticks = diagnostic &&
+        s_tj_present_work_trace.owner_wait_ticks >= wait_ticks_before
+        ? s_tj_present_work_trace.owner_wait_ticks - wait_ticks_before : 0;
+    const int clock_invalid = diagnostic &&
+        s_tj_present_work_trace.cpu_clock_invalid > clock_invalid_before;
+    const int untimed = diagnostic && (wait_mark <= 0 || clock_invalid);
+    int result = d3d12_prefix_owner_checked_completion(slot, wait_result);
+    u32 outcome = wait_result != 0 ? TJ_PREFIX_WAIT_FENCE_FAILURE :
+        result != 0 ? TJ_PREFIX_WAIT_POSTCHECK_FAILURE : TJ_PREFIX_WAIT_OK;
+    if (diagnostic)
+        tj_prefix_wait_trace_owner(site, reason, outcome, elapsed_ticks, clock_invalid, untimed);
+    return result;
+}
+
+/* The synchronous route retains its signal + bounded wait and attribution.
+ * A future overlap caller must signal here, then drain this exact owner later. */
+static int d3d12_prefix_owner_complete(void)
+{
+    if (!s_d3d.prefix_owner_active) return wait_for_gpu_checked();
+    LONGLONG started = tj_gcm2d_backend_perf_enabled() ? tj_gcm2d_backend_perf_now() : 0;
+    int result = d3d12_prefix_owner_signal();
+    const u32 wait_site = tj_prefix_wait_trace_enabled() &&
+        s_tj_completion_reason == RSX_COMPLETION_LOCAL_MAIN_COPY && s_exact_writeback_count
+        ? TJ_PREFIX_WAIT_LOCAL_MAIN_READBACK : TJ_PREFIX_WAIT_SYNC;
+    if (result == 0) result = d3d12_prefix_owner_wait(s_d3d.prefix_owner_active - 1,
+        wait_site, s_tj_completion_reason);
+    return tj_gpu_completion_perf_result(started, result);
+}
+
+static int d3d12_prefix_owner_end(u32 slot)
+{
+    if (slot >= 2) return -1;
+    VP_SNAP_PAR_BARRIER(PREFIX); /* publishes labels, drops owner references */
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+    if (owner->phase >= 2 &&
+        (owner->phase != 2 || !owner->completion_checked || !owner->signal_queued ||
+         !owner->cpu_retirement_ready ||
+         !owner->sequence || owner->sequence != s_d3d.prefix_retired_sequence + 1 ||
+         owner->sequence > s_d3d.prefix_submit_sequence || owner->label_count > d3d12_texture_label_cap() ||
+         s_d3d.gcm2d_backend_halted)) {
+        owner->phase = 3;
+        gcm2d_backend_halt("prefix owner retirement invariant");
+        return -1; /* Submitted resources remain held until process exit. */
+    }
+    if (owner->phase == 2) {
+        static u32 reported, reported_survival, reported_texture_survival, reported_label_survival;
+        const u32 bit = 1u << slot;
+        const int survival = rsx_survival_trace_is_armed();
+        if (!(reported & bit) || (survival && !(reported_survival & bit)) ||
+            (survival && owner->texture_count && !(reported_texture_survival & bit)) ||
+            (survival && owner->label_count && !(reported_label_survival & bit))) {
+            u32 sampler_pages = 0;
+            for (u32 page = 0; page < SAMPLER_HEAP_PAGE_COUNT; ++page)
+                sampler_pages += owner->sampler_heaps[page] != NULL;
+            fprintf(stderr, "[TJ-PREFIX-OWNER] phase=retired slot=%u survival=%d fence=%llu vp_first=%llu vp_bytes=%llu textures=%u sampler_pages=%u objects=%u sequence=%llu labels=%u\n",
+                slot, survival, (unsigned long long)owner->fence_value,
+                (unsigned long long)owner->upload_first[1],
+                (unsigned long long)owner->upload_bytes[1], owner->texture_count, sampler_pages,
+                owner->object_count, (unsigned long long)owner->sequence, owner->label_count);
+            reported |= bit;
+            if (survival) reported_survival |= bit;
+            if (survival && owner->texture_count) reported_texture_survival |= bit;
+            if (survival && owner->label_count) reported_label_survival |= bit;
+        }
+        /* The caller has also completed any MAIN commit/observer work. Keep
+         * equal-address writes in FIFO order; never publish a later owner first. */
+        d3d12_publish_texture_label_batch(owner->labels, owner->label_count,
+                                          owner->label_flush_kind);
+        s_d3d.prefix_retired_sequence = owner->sequence;
+    }
+    d3d12_prefix_owner_release_uploads(owner);
+    owner->phase = owner->completion_checked = 0;
+    owner->fence_value = 0;
+    owner->sequence = 0;
+    owner->label_count = owner->label_flush_kind = 0;
+    owner->signal_queued = 0;
+    owner->cpu_retirement_ready = 0;
+    return 0;
+}
+
+/* A completed GPU fence alone does not finish guest-memory commits or capture
+ * observers. Callers mark that CPU work ready before this ordered drain. */
+static int d3d12_prefix_owner_drain_ready(RsxD3D12CompletionReason reason)
+{
+    if (s_d3d.gcm2d_backend_halted) return -1;
+    if ((unsigned)reason >= RSX_COMPLETION_REASON_COUNT) reason = RSX_COMPLETION_OTHER;
+    while (s_d3d.prefix_retired_sequence < s_d3d.prefix_submit_sequence) {
+        u32 slot = 2;
+        for (u32 i = 0; i < 2; ++i)
+            if (s_d3d.prefix_owners[i].phase >= 2 &&
+                s_d3d.prefix_owners[i].sequence == s_d3d.prefix_retired_sequence + 1) {
+                slot = i;
+                break;
+            }
+        if (slot == 2 || !s_d3d.prefix_owners[slot].cpu_retirement_ready) {
+            gcm2d_backend_halt("prefix owner drain order or CPU observer");
+            return -1;
+        }
+        if (d3d12_prefix_owner_wait(slot, TJ_PREFIX_WAIT_ORDERED_FULL_DRAIN, reason) != 0 ||
+            d3d12_prefix_owner_end(slot) != 0)
+            return -1;
+    }
+    return 0;
+}
+
+static int d3d12_prefix_overlap_drain_with_reasons(
+    RsxD3D12CompletionReason reason, RsxD3D12CompletionReason cost_reason)
+{
+    if (!s_d3d.prefix_deferred_owner) return 0;
+    VP_SNAP_PAR_BARRIER(PREFIX);
+    if (s_d3d.prefix_deferred_owner > 2 || s_d3d.texture_label_armed == 2) {
+        gcm2d_backend_halt("prefix overlap unattached label");
+        return -1;
+    }
+    LONGLONG started = tj_present_work_trace_enabled() ? tj_present_work_trace_begin() : 0;
+    LONGLONG cost = tj_prefix_cost_begin();
+    int result = d3d12_prefix_owner_drain_ready(reason);
+    tj_prefix_cost_mark(cost, TJ_COST_DEFERRED, cost_reason);
+    if (result != 0) return -1;
+    if (tj_present_work_trace_enabled()) tj_present_work_trace_cpu_finish(started, 1);
+    s_d3d.prefix_deferred_owner = 0;
+    s_d3d.fifo_prefix_outstanding = 0;
+    ++s_d3d.fifo_prefix_serial;
+    return 0;
+}
+
+static int d3d12_prefix_overlap_drain(RsxD3D12CompletionReason reason)
+{
+    return d3d12_prefix_overlap_drain_with_reasons(reason, reason);
+}
+
+static int d3d12_prefix_owner_destroy(u32 slot)
+{
+    if (slot >= 2) return -1;
+    D3D12PrefixOwner* owner = &s_d3d.prefix_owners[slot];
+    if (owner->phase >= 2) return -1;
+    tj_prefix_gpu_release(slot);
+    d3d12_prefix_owner_release_uploads(owner);
+    if (owner->list8) owner->list8->lpVtbl->Release(owner->list8);
+    if (owner->list) owner->list->lpVtbl->Release(owner->list);
+    if (owner->allocator) owner->allocator->lpVtbl->Release(owner->allocator);
+    if (owner->srv_heap) owner->srv_heap->lpVtbl->Release(owner->srv_heap);
+    for (u32 page = 0; page < SAMPLER_HEAP_PAGE_COUNT; ++page)
+        if (owner->sampler_heaps[page])
+            owner->sampler_heaps[page]->lpVtbl->Release(owner->sampler_heaps[page]);
+    memset(owner, 0, sizeof(*owner));
+    return 0;
+}
+
+/* Post-submit failures must explain why the fail-closed halt happened, but
+ * the exclusive guest-world interval may not log, allocate, or call D3D.
+ * Keep only POD evidence there and emit it after exclusive_end. */
+typedef struct {
+    const char* code;
+    u32 plan, record, row;
+    u64 expected_generation, current_generation;
+    HRESULT hr;
+    int queued, has_readback, mapped;
+    u32 src_raw, dst_raw, src_ea, dst_ea;
+    u32 x, y, w, h, byte_offset;
+    u8 baseline_byte, current_byte;
+} ExactWritebackFailure;
+
+static void exact_writeback_failure_set(ExactWritebackFailure* f, const char* code,
+                                        u32 plan, const ExactBlitWritebackPlan* p,
+                                        u32 row, u64 current_generation, HRESULT hr,
+                                        int mapped)
+{
+    if (!f || f->code) return; /* preserve the first observable failure */
+    f->code = code;
+    f->plan = plan;
+    f->record = p ? p->record : UINT32_MAX;
+    f->row = row;
+    f->expected_generation = p ? p->mapping_generation : 0;
+    f->current_generation = current_generation;
+    f->hr = hr;
+    f->queued = p ? p->queued : 0;
+    f->has_readback = p && p->readback != NULL;
+    f->mapped = mapped;
+    f->byte_offset = UINT32_MAX;
+    if (p) {
+        const RsxD3D12ExactBlit* b = p->record < MAX_DRAWS
+            ? &s_d3d.draws[p->record].scaled_blit : NULL;
+        f->src_raw = b ? b->src_raw : 0; f->dst_raw = b ? b->dst_raw : p->mapping_raw;
+        f->src_ea = b ? b->src_ea : 0; f->dst_ea = b ? b->dst_ea : p->guest_ea;
+        f->x = p->x; f->y = p->y; f->w = p->w; f->h = p->h;
+    }
+}
+
+static void exact_writeback_failure_report(const ExactWritebackFailure* f)
+{
+    if (!f || !f->code) return;
+    fprintf(stderr,
+            "[GCM2D-WB] postsubmit-reject code=%s plan=%u rec=%u row=%u "
+            "gen=expected:%llu current:%llu queued=%d readback=%d mapped=%d "
+            "src=raw:%08X ea:%08X dst=raw:%08X ea:%08X rect=%u,%u %ux%u "
+            "diff=%u bytes=%02X/%02X hr=0x%08lX\n",
+            f->code, f->plan, f->record, f->row,
+            (unsigned long long)f->expected_generation,
+            (unsigned long long)f->current_generation,
+            f->queued, f->has_readback, f->mapped,
+            f->src_raw, f->src_ea, f->dst_raw, f->dst_ea,
+            f->x, f->y, f->w, f->h, f->byte_offset,
+            f->baseline_byte, f->current_byte, (long)f->hr);
+}
+
+static int exact_writeback_map_convert_all(ExactWritebackFailure* failure)
+{
+    /* Opt-in views coexist until commit. Bound their total mapped address
+     * space before opening any view, rather than only each allocation. */
+    u64 mapped_bytes = 0;
+    for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+        ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+        if (!p->mapped_commit) continue;
+        u64 bytes = (u64)p->readback_pitch * p->h;
+        if (bytes > (256ULL << 20) - mapped_bytes) {
+            exact_writeback_failure_set(failure, "MAP_LIMIT", i, p, UINT32_MAX,
+                                        cellGcmMainMappingGeneration(), S_OK, 0);
+            return -1;
+        }
+        mapped_bytes += bytes;
+    }
+    for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+        ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+        void* mapped = NULL;
+        D3D12_RANGE rr = {0, (SIZE_T)p->readback_pitch * p->h};
+        if (!p->queued) {
+            exact_writeback_failure_set(failure, "MAP_QUEUED", i, p, UINT32_MAX,
+                                        cellGcmMainMappingGeneration(), S_OK, 0);
+            return -1;
+        }
+        if (!p->readback) {
+            exact_writeback_failure_set(failure, "MAP_RESOURCE", i, p, UINT32_MAX,
+                                        cellGcmMainMappingGeneration(), S_OK, 0);
+            return -1;
+        }
+        if (!p->w || !p->h || p->w > 16384u || p->h > 16384u ||
+            p->readback_pitch < p->w * 4u || p->mapped_rgba || p->readback_mapped ||
+            (!p->mapped_commit && !p->packed_argb)) {
+            exact_writeback_failure_set(failure, "MAP_STORAGE", i, p, UINT32_MAX,
+                                        cellGcmMainMappingGeneration(), S_OK, 0);
+            return -1;
+        }
+        HRESULT hr = p->readback->lpVtbl->Map(p->readback, 0, &rr, &mapped);
+        p->readback_mapped = SUCCEEDED(hr);
+        if (FAILED(hr) || !mapped) {
+            /* A failed call owns no Map, even if its output is non-null. A
+             * successful null result is balanced by outside-exclusive cleanup. */
+            exact_writeback_failure_set(failure, "MAP_RESULT", i, p, UINT32_MAX,
+                                        cellGcmMainMappingGeneration(), hr, mapped != NULL);
+            return -1;
+        }
+        if (p->mapped_commit) {
+            p->mapped_rgba = (const u8*)mapped;
+        } else {
+            rsx_exact_blit_rgba_rows_to_guest_argb(p->packed_argb, p->w * 4u,
+                                                   (const u8*)mapped, p->readback_pitch,
+                                                   p->w, p->h);
+            D3D12_RANGE wr = {0, 0};
+            p->readback->lpVtbl->Unmap(p->readback, 0, &wr);
+            p->readback_mapped = 0;
+        }
+    }
+    return 0;
+}
+
+/* Only CPU recording may overlap. Retire the one prior submitted owner before
+ * any conflicting CPU mutation, fresh global wait, or new owner submission. */
+static int d3d12_prefix_prepare_retire(void)
+{
+    const u32 prior = s_d3d.prefix_prepare_owner;
+    if (!prior) return 0;
+    VP_SNAP_PAR_BARRIER(PREFIX);
+    if (prior > 2 || prior != s_d3d.prefix_deferred_owner ||
+        !s_d3d.prefix_owner_active || s_d3d.prefix_owner_active > 2 ||
+        prior == s_d3d.prefix_owner_active || s_exact_writeback_count ||
+        s_d3d.prefix_owners[prior - 1].phase != 2 ||
+        !s_d3d.prefix_owners[prior - 1].cpu_retirement_ready ||
+        s_d3d.prefix_owners[s_d3d.prefix_owner_active - 1].phase != 1) {
+        gcm2d_backend_halt("prefix prepare retirement invariant");
+        return -1;
+    }
+    if (d3d12_prefix_overlap_drain(RSX_COMPLETION_RESOURCE_RELEASE) != 0)
+        return -1;
+    s_d3d.prefix_prepare_owner = 0;
+    return 0;
+}
+
+/* The opt-in queued pair still uses the strict CPU-snapshot admission above.
+ * Validate before Execute: the old owner is the sole submitted sequence and
+ * the new owner is an unsubmitted private context. Original guest observers
+ * still use the ordered full drain, including the queue-ahead mode. */
+static int d3d12_prefix_queued_pair_preflight(void)
+{
+    const u32 prior = s_d3d.prefix_prepare_owner;
+    const u32 active = s_d3d.prefix_owner_active;
+    if (s_d3d.gcm2d_backend_halted || !prior || prior > 2 || !active || active > 2 ||
+        prior == active || prior != s_d3d.prefix_deferred_owner ||
+        s_d3d.frame_index >= FRAME_COUNT) {
+        gcm2d_backend_halt("prefix queued pair preflight state");
+        return -1;
+    }
+    const D3D12PrefixOwner* old = &s_d3d.prefix_owners[prior - 1];
+    const D3D12PrefixOwner* next = &s_d3d.prefix_owners[active - 1];
+    if (old->phase != 2 || !old->signal_queued || !old->cpu_retirement_ready ||
+        !old->fence_value || old->fence_value >= UINT64_MAX - 1 ||
+        old->completion_fence != s_d3d.fence || old->frame_index != s_d3d.frame_index ||
+        old->sequence != s_d3d.prefix_retired_sequence + 1 ||
+        old->sequence != s_d3d.prefix_submit_sequence || old->sequence == UINT64_MAX ||
+        next->phase != 1 || next->signal_queued || next->fence_value || next->sequence ||
+        next->completion_fence != s_d3d.fence) {
+        gcm2d_backend_halt("prefix queued pair preflight tickets");
+        return -1;
+    }
+    /* A lost optimization gate uses the original phase-1 retirement route.
+     * It must not make an otherwise supported prefix fail just for this flag. */
+    if (s_exact_writeback_count || s_d3d.texture_label_armed ||
+        s_d3d.texture_label_count || !s_d3d.fifo_prefix_epoch_open ||
+        !s_d3d.fifo_prefix_outstanding ||
+        old->fence_value != s_d3d.fence_values[s_d3d.frame_index]) return 0;
+    return 1;
+}
+
+/* New Execute/Signal is already queued. Normally check/end only the older
+ * exact ticket; the separate queue-ahead flag retains both until later reuse.
+ * On any failure both submitted owners stay retained and processing halts. */
+static int d3d12_prefix_queued_pair_retire(void)
+{
+    const u32 prior = s_d3d.prefix_prepare_owner;
+    const u32 active = s_d3d.prefix_owner_active;
+    if (s_d3d.gcm2d_backend_halted || !prior || prior > 2 || !active || active > 2 ||
+        prior == active || prior != s_d3d.prefix_deferred_owner ||
+        s_exact_writeback_count || s_d3d.texture_label_armed ||
+        s_d3d.texture_label_count || !s_d3d.fifo_prefix_epoch_open ||
+        !s_d3d.fifo_prefix_outstanding || s_d3d.frame_index >= FRAME_COUNT) {
+        gcm2d_backend_halt("prefix queued pair retirement state");
+        return -1;
+    }
+    const D3D12PrefixOwner* old = &s_d3d.prefix_owners[prior - 1];
+    const D3D12PrefixOwner* next = &s_d3d.prefix_owners[active - 1];
+    if (old->phase != 2 || next->phase != 2 || !old->signal_queued || !next->signal_queued ||
+        !old->cpu_retirement_ready || !next->cpu_retirement_ready ||
+        !old->fence_value || old->fence_value == UINT64_MAX ||
+        !next->fence_value || next->fence_value == UINT64_MAX ||
+        old->fence_value >= next->fence_value ||
+        old->completion_fence != s_d3d.fence || next->completion_fence != s_d3d.fence ||
+        old->frame_index != s_d3d.frame_index || next->frame_index != s_d3d.frame_index ||
+        next->fence_value != s_d3d.fence_values[s_d3d.frame_index] ||
+        old->sequence != s_d3d.prefix_retired_sequence + 1 ||
+        old->sequence == UINT64_MAX || next->sequence != old->sequence + 1 ||
+        next->sequence != s_d3d.prefix_submit_sequence) {
+        gcm2d_backend_halt("prefix queued pair retirement tickets");
+        return -1;
+    }
+    /* Separate opt-in: retain both until a bank reuse or original observer.
+     * Every ticket above is validated before changing the newest marker. */
+    if (d3d12_prefix_queue_ahead_enabled()) {
+        s_d3d.prefix_deferred_owner = active;
+        s_d3d.prefix_prepare_owner = 0;
+        ++s_d3d.prefix_queued_pairs;
+        ++s_d3d.prefix_queue_ahead_deferred;
+        return 0;
+    }
+    LONGLONG started = tj_present_work_trace_enabled() ? tj_present_work_trace_begin() : 0;
+    LONGLONG cost = tj_prefix_cost_begin();
+    /* owner_wait uses the low-level exact-ticket wait, which has no global
+     * prepare hook, fresh Signal, frame advance, or drain of the new owner. */
+    int result = d3d12_prefix_owner_wait(prior - 1, TJ_PREFIX_WAIT_QUEUED_PAIR_RETIRE,
+                                         s_tj_completion_reason);
+    if (result == 0) result = d3d12_prefix_owner_end(prior - 1);
+    tj_prefix_cost_mark(cost, TJ_COST_DEFERRED, RSX_COMPLETION_RESOURCE_RELEASE);
+    if (result != 0) return -1;
+    if (tj_present_work_trace_enabled()) tj_present_work_trace_cpu_finish(started, 1);
+    /* The outstanding epoch continues with next. Its final full drain owns
+     * the serial increment and outstanding reset. */
+    s_d3d.prefix_deferred_owner = active;
+    s_d3d.prefix_prepare_owner = 0;
+    ++s_d3d.prefix_queued_pairs;
+    return 0;
+}
+
+/* No active recording context: both prior contexts have submitted immutable
+ * CPU inputs and no pending CPU plans/observers. Retire the oldest exact slot
+ * while preserving the newest ticket, refs, labels and outstanding epoch. */
+static int d3d12_prefix_queue_ahead_retire_old(u32 slot,
+                                               RsxD3D12CompletionReason reason)
+{
+    VP_SNAP_PAR_BARRIER(PREFIX);
+    if ((unsigned)reason >= RSX_COMPLETION_REASON_COUNT) reason = RSX_COMPLETION_OTHER;
+    const u32 latest = s_d3d.prefix_deferred_owner;
+    if (s_d3d.gcm2d_backend_halted || slot >= 2 || !latest || latest > 2 ||
+        latest == slot + 1 || s_d3d.prefix_owner_active || s_d3d.prefix_prepare_owner) {
+        gcm2d_backend_halt("prefix queue ahead partial state");
+        return -1;
+    }
+    const D3D12PrefixOwner* old = &s_d3d.prefix_owners[slot];
+    const D3D12PrefixOwner* next = &s_d3d.prefix_owners[latest - 1];
+    if (old->phase != 2 || next->phase != 2 || !old->signal_queued || !next->signal_queued ||
+        !old->cpu_retirement_ready || !next->cpu_retirement_ready ||
+        !old->fence_value || old->fence_value == UINT64_MAX ||
+        !next->fence_value || next->fence_value == UINT64_MAX ||
+        old->fence_value >= next->fence_value ||
+        !old->completion_fence || old->completion_fence != next->completion_fence ||
+        old->frame_index >= FRAME_COUNT || next->frame_index >= FRAME_COUNT ||
+        old->sequence != s_d3d.prefix_retired_sequence + 1 || old->sequence == UINT64_MAX ||
+        next->sequence != old->sequence + 1 || next->sequence != s_d3d.prefix_submit_sequence) {
+        gcm2d_backend_halt("prefix queue ahead partial tickets");
+        return -1;
+    }
+    /* Losing an optimization condition is supported: keep all original CPU
+     * plans and observers, and retire both through the ordinary checked path.
+     * A fresh same-frame Signal may advance the counter past next's ticket. */
+    if (s_exact_writeback_count || s_d3d.texture_label_armed ||
+        !s_d3d.fifo_prefix_outstanding || s_d3d.frame_index >= FRAME_COUNT ||
+        old->completion_fence != s_d3d.fence ||
+        old->frame_index != s_d3d.frame_index || next->frame_index != s_d3d.frame_index ||
+        next->fence_value > s_d3d.fence_values[s_d3d.frame_index])
+        return d3d12_prefix_overlap_drain_with_reasons(
+            reason, RSX_COMPLETION_RESOURCE_RELEASE);
+    LONGLONG started = tj_present_work_trace_enabled() ? tj_present_work_trace_begin() : 0;
+    LONGLONG cost = tj_prefix_cost_begin();
+    int result = d3d12_prefix_owner_wait(slot, TJ_PREFIX_WAIT_QUEUE_AHEAD_OLD_RETIRE,
+                                         reason);
+    if (result == 0) result = d3d12_prefix_owner_end(slot);
+    tj_prefix_cost_mark(cost, TJ_COST_DEFERRED, RSX_COMPLETION_RESOURCE_RELEASE);
+    if (result != 0) return -1;
+    if (tj_present_work_trace_enabled()) tj_present_work_trace_cpu_finish(started, 1);
+    ++s_d3d.prefix_queue_ahead_bank_drains;
+    return 0;
+}
+
+static int d3d12_prefix_queue_ahead_before_mutation(const void* pointer)
+{
+    if (!d3d12_prefix_queue_ahead_enabled() || !pointer ||
+        s_d3d.prefix_owner_active || s_d3d.prefix_prepare_owner ||
+        !s_d3d.prefix_deferred_owner || !d3d12_prefix_owner_object_reserved(pointer)) return 0;
+    const u32 latest = s_d3d.prefix_deferred_owner;
+    if (latest > 2)
+        return d3d12_prefix_overlap_drain_with_reasons(
+            s_tj_completion_reason, RSX_COMPLETION_RESOURCE_RELEASE);
+    const D3D12PrefixOwner* next = &s_d3d.prefix_owners[latest - 1];
+    for (u32 i = 0; i < next->object_count; ++i)
+        if (next->objects[i] == pointer)
+            return d3d12_prefix_overlap_drain_with_reasons(
+                s_tj_completion_reason, RSX_COMPLETION_RESOURCE_RELEASE);
+    return d3d12_prefix_queue_ahead_retire_old(1u - (latest - 1),
+                                                s_tj_completion_reason);
+}
+
+/* Admission remains a side-effect-free predicate. A definite owned replay may
+ * first reclaim its oldest parity slot, before owner_begin; the upload hook
+ * alone may be too late because some uploads occur inside render_frame. */
+static int d3d12_prefix_queue_ahead_prepare(RsxD3D12CompletionReason reason)
+{
+    const int trace = tj_prefix_wait_trace_enabled();
+    if (trace) ++s_tj_prefix_wait_trace.prepare.calls;
+    if (!d3d12_prefix_queue_ahead_enabled()) {
+        if (trace) ++s_tj_prefix_wait_trace.prepare.outcomes[TJ_PREFIX_WAIT_PREPARE_DISABLED];
+        return 0;
+    }
+    if (s_d3d.prefix_owner_active || s_d3d.prefix_prepare_owner) {
+        if (trace) ++s_tj_prefix_wait_trace.prepare.outcomes[TJ_PREFIX_WAIT_PREPARE_BUSY];
+        return 0;
+    }
+    if (!s_d3d.prefix_deferred_owner) {
+        if (trace) ++s_tj_prefix_wait_trace.prepare.outcomes[TJ_PREFIX_WAIT_PREPARE_NO_DEFERRED];
+        return 0;
+    }
+    if (s_d3d.vp_parity < 0 || s_d3d.vp_parity > 1) {
+        if (trace) ++s_tj_prefix_wait_trace.prepare.outcomes[TJ_PREFIX_WAIT_PREPARE_BAD_PARITY];
+        return 0;
+    }
+    if (!d3d12_prefix_overlap_eligible()) {
+        if (trace) ++s_tj_prefix_wait_trace.prepare.outcomes[TJ_PREFIX_WAIT_PREPARE_OVERLAP];
+        return 0;
+    }
+    const u32 slot = (u32)s_d3d.vp_parity;
+    if (s_d3d.prefix_owners[slot].phase == 2 &&
+        s_d3d.prefix_deferred_owner != slot + 1) {
+        if (trace)
+            ++s_tj_prefix_wait_trace.prepare.outcomes[TJ_PREFIX_WAIT_PREPARE_RETIRE_CANDIDATE];
+        return d3d12_prefix_queue_ahead_retire_old(slot, reason);
+    }
+    if (trace) ++s_tj_prefix_wait_trace.prepare.outcomes[TJ_PREFIX_WAIT_PREPARE_NO_RETIRE];
+    return 0;
+}
+
+static int d3d12_prefix_prepare_before_wait(void)
+{
+    if (s_d3d.prefix_prepare_owner) ++s_d3d.prefix_prepare_mid_drains;
+    return s_d3d.prefix_prepare_owner ? d3d12_prefix_prepare_retire() : 0;
+}
+
+static int d3d12_prefix_prepare_before_mutation(const void* pointer)
+{
+    if (s_d3d.prefix_prepare_owner &&
+        d3d12_prefix_owner_object_reserved(pointer)) {
+        ++s_d3d.prefix_prepare_mid_drains;
+        return d3d12_prefix_prepare_retire();
+    }
+    return 0;
+}
+
+/* Rendezvous follows the ordinary C boolean convention: nonzero means the
+ * caller owns the exclusive world / finished its release successfully. Keep
+ * that polarity named here so writeback never reinterprets it as HRESULT. */
+static int guest_world_succeeded(int result)
+{
+    return result != 0;
+}
+
+static void vp_watch_batch_note_write(u32 ea, u64 bytes); /* TJ_WATCH_BATCH */
+
+/* Only the block below runs while the world is exclusive.  It does no D3D,
+ * allocation, logging, resolver callback, or ordinary reservation operation. */
+static int exact_writeback_commit_all(ExactWritebackFailure* failure)
+{
+    int committed = 0;
+    if (!s_exact_writeback_count) return 0;
+    if (guest_world_is_poisoned()) {
+        exact_writeback_failure_set(failure, "POISON", UINT32_MAX, NULL, UINT32_MAX,
+                                    cellGcmMainMappingGeneration(), S_OK, 0);
+        return -1;
+    }
+    /* Validate storage for the entire batch before any guest write. Map and
+     * allocation failures cannot silently select the other commit path. */
+    for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+        ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+        if (!p->w || !p->h || p->w > 16384u || p->h > 16384u ||
+            (p->mapped_commit ? (!p->mapped_rgba || !p->readback_mapped ||
+                                  !p->readback || !p->queued ||
+                                  p->readback_pitch < p->w * 4u) : !p->packed_argb)) {
+            exact_writeback_failure_set(failure, "COMMIT_STORAGE", i, p, UINT32_MAX,
+                                        cellGcmMainMappingGeneration(), S_OK, 0);
+            return -1;
+        }
+    }
+    if (!guest_world_succeeded(guest_world_exclusive_begin())) {
+        exact_writeback_failure_set(failure, "BEGIN", UINT32_MAX, NULL, UINT32_MAX,
+                                    cellGcmMainMappingGeneration(), S_OK, 0);
+        return -1;
+    }
+    int precommit_ok = 1;
+    for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+        ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+        u64 current_generation = cellGcmMainMappingGeneration();
+        if ((p->mapping_generation & 1u) || current_generation != p->mapping_generation) {
+            exact_writeback_failure_set(failure, "GEN", i, p, UINT32_MAX,
+                                        current_generation, S_OK, 0);
+            precommit_ok = 0;
+            break;
+        }
+        if (!rsx_exact_blit_dirty_rows_match(p->guest_rows, p->guest_pitch,
+                                             p->baseline, p->w * 4u, p->h)) {
+            u32 bad_row = UINT32_MAX;
+            /* The existing pure predicate remains the acceptance check.  On
+             * failure only, rescan its already-suspended rows for the first
+             * mismatch to make the diagnostic actionable. */
+            if (p->guest_rows && p->baseline && p->guest_pitch && p->w && p->h &&
+                p->w * 4u <= p->guest_pitch) {
+                u32 row_bytes = p->w * 4u;
+                for (u32 row = 0; row < p->h; ++row) {
+                    if (memcmp(p->guest_rows + (u64)row * p->guest_pitch,
+                               p->baseline + (u64)row * row_bytes, row_bytes) != 0) {
+                        bad_row = row;
+                        for (u32 col = 0; col < row_bytes; ++col) {
+                            u8 current = p->guest_rows[(u64)row * p->guest_pitch + col];
+                            u8 baseline = p->baseline[(u64)row * row_bytes + col];
+                            if (current != baseline) {
+                                failure->byte_offset = col;
+                                failure->baseline_byte = baseline;
+                                failure->current_byte = current;
+                                break;
+                            }
+                        }
+                        break;
+                    }
+                }
+            }
+            u32 first_diff = failure->byte_offset;
+            u8 baseline_byte = failure->baseline_byte;
+            u8 current_byte = failure->current_byte;
+            exact_writeback_failure_set(failure, "BASELINE", i, p, bad_row,
+                                        current_generation, S_OK, 0);
+            failure->byte_offset = first_diff;
+            failure->baseline_byte = baseline_byte;
+            failure->current_byte = current_byte;
+            precommit_ok = 0;
+        }
+        if (!precommit_ok) break;
+    }
+    if (precommit_ok) {
+        for (u32 i = 0; i < s_exact_writeback_count; ++i) {
+            ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+            u32 row_bytes = p->w * 4u;
+            for (u32 row = 0; row < p->h; ++row) {
+                u8* dst = p->guest_rows + (u64)row * p->guest_pitch;
+                if (p->mapped_commit) {
+                    rsx_exact_blit_rgba_to_guest_argb(dst,
+                        p->mapped_rgba + (u64)row * p->readback_pitch, p->w);
+                } else {
+                    memcpy(dst, p->packed_argb + (u64)row * row_bytes, row_bytes);
+                }
+                u32 line = (p->guest_ea + row * p->guest_pitch) & ~127u;
+                u32 last = (p->guest_ea + row * p->guest_pitch + row_bytes - 1u) & ~127u;
+                do {
+                    spu_reservation_bump_locked(line);
+                    line += 128u;
+                } while (line != last + 128u);
+            }
+        }
+        committed = 1;
+    }
+    /* End must always happen; it is allowed to resume threads but is the only
+     * non-copy operation after begin.  Any failure halts before Present. */
+    if (!guest_world_succeeded(guest_world_exclusive_end())) {
+        exact_writeback_failure_set(failure, "END", UINT32_MAX, NULL, UINT32_MAX,
+                                    0, S_OK, 0);
+        return -1;
+    }
+    /* TJ_WATCH_BATCH (no-op when off): committed rows were written after the
+     * pass's batch query; their chunks fall back to per-call queries. */
+    for (u32 i = 0; committed && i < s_exact_writeback_count; ++i) {
+        const ExactBlitWritebackPlan* p = &s_exact_writeback[i];
+        vp_watch_batch_note_write(p->guest_ea,
+            (u64)(p->h - 1u) * p->guest_pitch + (u64)p->w * 4u);
+    }
+    return committed ? 0 : -1;
+}
+
+/* TJ_COMPOSE_CAPTURE_DIR captures the known Survival composition stages from
+ * one armed frame.  Queue the copies into the frame command list at the exact
+ * op boundary, then map them after that list completes; never reset/submit a
+ * list from inside replay. */
+#define TJ_COMPOSE_CAPTURE_MAX 20
+#define TJ_COMPOSE_ALIAS_RECORD_MAX 16
+enum { GPU_BLIT_DISPLAY, GPU_BLIT_OFFRT, GPU_BLIT_MIRROR };
+typedef struct {
+    ID3D12Resource* rb;
+    char name[48];
+    u32 w, h, pitch, dxgi;
+} TjComposeCaptureItem;
+typedef struct {
+    u32 record, src_raw, dst_raw;
+    u8 src_local, dst_local;
+    int prepared, dst_kind, dst_slot;
+} TjComposeAliasPreflight;
+typedef struct {
+    u64 batch;
+    u32 record, raw, alias_raw, x, y, w, h;
+    int slot;
+} TjComposeAliasExact;
+typedef struct {
+    u32 record;
+    int src_kind, src_slot, dst_kind, dst_slot;
+    u32 src_x, src_y, dst_x, dst_y;
+    u32 src_raw, src_pitch, src_point_x, src_point_y;
+    u32 dst_raw, dst_pitch, dst_point_x, dst_point_y, copy_w, copy_h;
+} TjComposeCopyPlan;
+typedef struct {
+    u64 batch;
+    u32 ea, raw, pitch, w, h;
+    u64 span;
+    int kind, slot;
+    u32 record, x, y, copy_w, copy_h;
+} TjMainProvSpan;
+typedef struct {
+    int enabled, phase, active;
+    char dir[300];
+    TjMainProvSpan saved_dst, load_src, next_src;
+} TjMainProv;
+typedef struct {
+    int enabled, alias_enabled, copy_enabled, active, done;
+    int alias_pending, alias_active, copy_pending, copy_active;
+    u32 count;
+    char dir[300];
+    TjComposeCaptureItem item[TJ_COMPOSE_CAPTURE_MAX];
+    /* TJ_COMPOSE_ALIAS_DIAG state. batch_seq is process-monotonic rather
+     * than frame_count, which titles are free to reset. */
+    u64 batch, consumed_flip_generation;
+    u32 frame_index, consumed_buffer_id, selected_raw;
+    int selected_slot;
+    u32 consumer_total, consumer_record[TJ_COMPOSE_ALIAS_RECORD_MAX];
+    u32 consumer_stored, consumer_dropped, last_consumer_record;
+    int last_consumer_unit;
+    u32 parent_raw[2];
+    int parent_slot[2];
+    int history_slot, history_valid;
+    u32 history_state;
+    u64 history_generation;
+    u32 history_completed_raw;
+    u64 history_before_generation;
+    u32 history_before_completed_raw;
+    TjComposeAliasPreflight preflight[TJ_COMPOSE_ALIAS_RECORD_MAX];
+    u32 preflight_count, preflight_dropped;
+    TjComposeAliasExact exact[TJ_COMPOSE_ALIAS_RECORD_MAX];
+    u32 exact_count, exact_dropped;
+    TjComposeCopyPlan copy_plan[2];
+    u32 copy_plan_count;
+} TjComposeCapture;
+static TjComposeCapture s_tj_compose_capture = {-1, -1, -1};
+static u64 s_tj_compose_alias_batch_seq;
+static TjMainProv s_tj_main_prov = {-1};
+static u32 s_tj_compose_target_fp, s_tj_compose_target_count;
+/* Two before-images plus up to sixteen ordered display writes and endpoints. */
+static u32 s_tj_compose_target_ordinal[16], s_tj_compose_target_raw[16];
+static int tj_env_u32_hex(const char* name, u32* out_value);
+
+static int tj_compose_target_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+        enabled = tj_env_u32_hex("TJ_COMPOSE_CAPTURE_FP", &s_tj_compose_target_fp) &&
+                  s_tj_compose_target_fp != 0;
+    return enabled;
+}
+
+static int tj_compose_capture_enabled(void)
+{
+    if (s_tj_compose_capture.enabled < 0) {
+        const char* dir = getenv("TJ_COMPOSE_CAPTURE_DIR");
+        s_tj_compose_capture.enabled = dir && *dir;
+    }
+    return s_tj_compose_capture.enabled;
+}
+
+static int tj_compose_copy_diag_enabled(void)
+{
+    if (s_tj_main_prov.enabled < 0)
+        s_tj_main_prov.enabled = getenv("TJ_COMPOSE_MAIN_PROV") ? 1 : 0;
+    if (s_tj_main_prov.enabled && tj_compose_capture_enabled()) return 0;
+    if (s_tj_compose_capture.copy_enabled < 0)
+        s_tj_compose_capture.copy_enabled = getenv("TJ_COMPOSE_COPY_DIAG") ? 1 : 0;
+    return s_tj_compose_capture.copy_enabled && tj_compose_capture_enabled();
+}
+
+static int tj_compose_main_prov_enabled(void)
+{
+    if (s_tj_main_prov.enabled < 0)
+        s_tj_main_prov.enabled = getenv("TJ_COMPOSE_MAIN_PROV") ? 1 : 0;
+    return s_tj_main_prov.enabled && tj_compose_capture_enabled();
+}
+
+static int tj_compose_alias_diag_enabled(void)
+{
+    /* MAIN provenance, then copy, own the capture slots exclusively. */
+    if (tj_compose_main_prov_enabled()) return 0;
+    if (tj_compose_copy_diag_enabled()) return 0;
+    if (s_tj_compose_capture.alias_enabled < 0)
+        s_tj_compose_capture.alias_enabled = getenv("TJ_COMPOSE_ALIAS_DIAG") ? 1 : 0;
+    return s_tj_compose_capture.alias_enabled && tj_compose_capture_enabled();
+}
+
+static void tj_compose_capture_queue(const char* name, ID3D12Resource* res,
+                                     u32 x, u32 y, u32 w, u32 h, u32 dxgi,
+                                     D3D12_RESOURCE_STATES prior);
+static void tj_compose_capture_alias_history(const char* name);
+static int display_surface_find(u32 raw);
+static int display_surface_get(const CellGcmDisplayInfo* info);
+
+static int selected_display_raw_for_id(u32 selected_buffer_id, u32* out_raw)
+{
+    CellGcmDisplayInfo* info = cellGcmGetDisplayBufferByFlipIndex(selected_buffer_id);
+    if (!info || !info->width || !info->height) return 0;
+    *out_raw = info->offset;
+    return 1;
+}
+
+static int tj_compose_capture_selected_surface(u32 selected_display_raw,
+                                               int selected_display_valid)
+{
+    CellGcmDisplayInfo info = {0};
+    if (!selected_display_valid || !cellGcmGetDisplaySurfaceInfo(
+            selected_display_raw, 0, 0, 0, &info)) return -1;
+    return display_surface_get(&info);
+}
+
+/* Raw-only consumers must refresh through the registered display metadata
+ * before using an existing slot; raw equality alone can retain old geometry. */
+static int display_surface_get_registered(u32 raw)
+{
+    CellGcmDisplayInfo info = {0};
+    return cellGcmGetDisplaySurfaceInfo(raw, 0, 0, 0, &info)
+        ? display_surface_get(&info) : -1;
+}
+
+static int tj_compose_alias_history_slot(void)
+{
+    for (int i = 0; i < MAX_DISPLAY_HISTORY; ++i)
+        if (s_d3d.display_history[i].res && s_d3d.display_history[i].raw == 0x00740000u)
+            return i;
+    return -1;
+}
+
+static int tj_main_prov_span_from_mirror(int slot, u32 record,
+                                         const RsxD3D12ExactBlit* b,
+                                         int source, u32 endpoint_x,
+                                         u32 endpoint_y, TjMainProvSpan* out)
+{
+    if (slot < 0 || slot >= MAX_GPU_MIRRORS || !out) return 0;
+    const GpuMirror* m = &s_d3d.gpu_mirror[slot];
+    if (!m->valid || !m->res || m->local || !m->pitch || !m->w || !m->h)
+        return 0;
+    u32 ea;
+    if (!cellGcmResolveLocatedChecked(0, m->raw, &ea)) return 0;
+    memset(out, 0, sizeof(*out));
+    out->ea = ea; out->raw = m->raw; out->pitch = m->pitch;
+    out->batch = s_tj_compose_capture.batch;
+    out->w = m->w; out->h = m->h; out->span = (u64)m->pitch * m->h;
+    out->kind = GPU_BLIT_MIRROR; out->slot = slot; out->record = record;
+    out->x = endpoint_x + (source ? b->src_x : b->dst_x);
+    out->y = endpoint_y + (source ? b->src_y : b->dst_y);
+    out->copy_w = b->copy_w; out->copy_h = b->copy_h;
+    return 1;
+}
+
+static int tj_main_prov_span_same(const TjMainProvSpan* a,
+                                  const TjMainProvSpan* b)
+{
+    return a->ea == b->ea && a->pitch == b->pitch &&
+           a->w == b->w && a->h == b->h && a->span == b->span;
+}
+
+/* Called after endpoint preflight, before replay. Phase 0 uses the first
+ * MAIN->selected load only as a FIFO upper bound: the preceding display save
+ * is the other ping-pong backing.  Retain that backing's last region write.
+ * Phase 1 finds it again by resolved guest span, never raw alone. */
+static int tj_main_prov_plan_batch(u32 draws, int selected_slot)
+{
+    if (!tj_compose_main_prov_enabled() || selected_slot < 0 ||
+        s_tj_main_prov.phase >= 2)
+        return 0;
+    if (s_tj_main_prov.phase == 0) {
+        u32 load = ~0u;
+        for (u32 d = s_tj_compose_capture.last_consumer_record + 1;
+             d < draws && d < MAX_DRAWS; ++d) {
+            const D3D12DrawRecord* dr = &s_d3d.draws[d];
+            if (dr->is_scaled_blit && dr->scaled_blit_prepared &&
+                dr->scaled_blit_src_kind == GPU_BLIT_MIRROR &&
+                !dr->scaled_blit.src_local &&
+                dr->scaled_blit_dst_kind == GPU_BLIT_DISPLAY &&
+                dr->scaled_blit_dst_slot == selected_slot) {
+                load = d;
+                break;
+            }
+        }
+        if (load == ~0u ||
+            !tj_main_prov_span_from_mirror(
+                s_d3d.draws[load].scaled_blit_src_slot, load,
+                &s_d3d.draws[load].scaled_blit, 1,
+                s_d3d.draws[load].scaled_blit_src_x,
+                s_d3d.draws[load].scaled_blit_src_y,
+                &s_tj_main_prov.load_src)) return 0;
+        int found = 0, mirror_slot = -1;
+        for (u32 d = s_tj_compose_capture.last_consumer_record + 1; d < load; ++d) {
+            const D3D12DrawRecord* dr = &s_d3d.draws[d];
+            if (!dr->is_scaled_blit || !dr->scaled_blit_prepared ||
+                dr->scaled_blit_src_kind != GPU_BLIT_DISPLAY ||
+                dr->scaled_blit_dst_kind != GPU_BLIT_MIRROR ||
+                dr->scaled_blit.dst_local)
+                continue;
+            TjMainProvSpan producer;
+            if (!tj_main_prov_span_from_mirror(
+                    dr->scaled_blit_dst_slot, d, &dr->scaled_blit, 0,
+                    dr->scaled_blit_dst_x, dr->scaled_blit_dst_y, &producer) ||
+                tj_main_prov_span_same(&producer, &s_tj_main_prov.load_src))
+                continue;
+            if (mirror_slot < 0) mirror_slot = dr->scaled_blit_dst_slot;
+            if (dr->scaled_blit_dst_slot != mirror_slot) continue;
+            s_tj_main_prov.saved_dst = producer;
+            found = 1;
+        }
+        return found;
+    }
+    for (u32 d = 0; d < draws && d < MAX_DRAWS; ++d) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[d];
+        TjMainProvSpan candidate;
+        if (!dr->is_scaled_blit || !dr->scaled_blit_prepared ||
+            dr->scaled_blit_src_kind != GPU_BLIT_MIRROR || dr->scaled_blit.src_local ||
+            dr->scaled_blit_dst_kind != GPU_BLIT_DISPLAY ||
+            dr->scaled_blit_dst_slot != selected_slot ||
+            !tj_main_prov_span_from_mirror(dr->scaled_blit_src_slot, d,
+                                            &dr->scaled_blit, 1,
+                                            dr->scaled_blit_src_x,
+                                            dr->scaled_blit_src_y, &candidate))
+            continue;
+        if (tj_main_prov_span_same(&s_tj_main_prov.saved_dst, &candidate)) {
+            s_tj_main_prov.next_src = candidate;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Runs once per deferred render batch before exact-copy preflight. The full
+ * draw-record index is intentional: raster ordinals skip NV3089 records. */
+static void tj_compose_alias_prepare_batch(u32 draws)
+{
+    int alias_diag = tj_compose_alias_diag_enabled();
+    int copy_diag = tj_compose_copy_diag_enabled();
+    int main_diag = tj_compose_main_prov_enabled();
+    s_tj_compose_capture.alias_pending = 0;
+    s_tj_compose_capture.copy_pending = 0;
+    if (!alias_diag && !copy_diag && !main_diag)
+        return;
+    s_tj_compose_capture.batch = ++s_tj_compose_alias_batch_seq;
+    if (s_tj_compose_capture.done && !main_diag)
+        return;
+    s_tj_compose_capture.consumer_total = 0;
+    s_tj_compose_capture.consumer_stored = 0;
+    s_tj_compose_capture.consumer_dropped = 0;
+    s_tj_compose_capture.last_consumer_record = ~0u;
+    s_tj_compose_capture.last_consumer_unit = -1;
+    s_tj_compose_capture.parent_raw[0] = s_tj_compose_capture.parent_raw[1] = 0;
+    s_tj_compose_capture.parent_slot[0] = s_tj_compose_capture.parent_slot[1] = -1;
+    s_tj_compose_capture.preflight_count = s_tj_compose_capture.preflight_dropped = 0;
+    s_tj_compose_capture.copy_plan_count = 0;
+    for (u32 d = 0; d < draws && d < MAX_DRAWS; ++d) {
+        D3D12DrawRecord* dr = &s_d3d.draws[d];
+        if (!dr->is_vp || dr->is_clear || dr->is_scaled_blit) continue;
+        for (int u = 0; u < RSX_MAX_TEXTURES; ++u) {
+            if (!dr->tex[u].set || dr->tex[u].location != 1 ||
+                dr->tex[u].raw != 0x00740000u)
+                continue;
+            if (s_tj_compose_capture.consumer_stored < TJ_COMPOSE_ALIAS_RECORD_MAX)
+                s_tj_compose_capture.consumer_record[
+                    s_tj_compose_capture.consumer_stored++] = d;
+            else
+                s_tj_compose_capture.consumer_dropped++;
+            s_tj_compose_capture.consumer_total++;
+            s_tj_compose_capture.last_consumer_record = d;
+            s_tj_compose_capture.last_consumer_unit = u;
+            {
+                CellGcmDisplayInfo parent[2] = {{0}};
+                extern int cellGcmGetDisplayHistoryAliasParents(
+                    u32, u32, u32, u32, CellGcmDisplayInfo*, CellGcmDisplayInfo*);
+                if (cellGcmGetDisplayHistoryAliasParents(
+                        dr->tex[u].raw, dr->tex[u].pitch, dr->tex[u].w, dr->tex[u].h,
+                        &parent[0], &parent[1])) {
+                    s_tj_compose_capture.parent_raw[0] = parent[0].offset;
+                    s_tj_compose_capture.parent_raw[1] = parent[1].offset;
+                    s_tj_compose_capture.parent_slot[0] = display_surface_get(&parent[0]);
+                    s_tj_compose_capture.parent_slot[1] = display_surface_get(&parent[1]);
+                }
+            }
+        }
+    }
+    s_tj_compose_capture.alias_pending = alias_diag &&
+        s_tj_compose_capture.consumer_total != 0;
+    s_tj_compose_capture.copy_pending = copy_diag &&
+        s_tj_compose_capture.consumer_total != 0;
+}
+
+static void tj_compose_capture_guest_display(u32 selected_buffer_id)
+{
+    extern uint8_t* vm_base;
+    extern u32 ppu_vm_size;
+    CellGcmDisplayInfo* info = cellGcmGetDisplayBufferByFlipIndex(selected_buffer_id);
+    char path[512];
+    if (!info || !info->width || !info->height || info->pitch < info->width * 4 ||
+        !vm_base) {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] guest_active omitted=display-unavailable\n");
+        return;
+    }
+    u32 ea;
+    if (!cellGcmResolveLocatedChecked(1, info->offset, &ea)) {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] guest_active omitted=display-unmapped\n");
+        return;
+    }
+    u64 bytes = (u64)(info->height - 1) * info->pitch + (u64)info->width * 4;
+    u64 cap = ppu_vm_size ? (u64)ppu_vm_size : (1ULL << 32);
+    if (bytes > cap || (u64)ea > cap - bytes) {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] guest_active omitted=guest-span raw=%08X ea=%08X\n",
+                info->offset, ea);
+        return;
+    }
+    u64 rgba_bytes = (u64)info->width * info->height * 4;
+    u8* rgba = (u8*)malloc((size_t)rgba_bytes);
+    if (!rgba) {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] guest_active omitted=oom\n");
+        return;
+    }
+    for (u32 y = 0; y < info->height; ++y) {
+        const u8* src = vm_base + ea + (u64)y * info->pitch;
+        u8* dst = rgba + (u64)y * info->width * 4;
+        for (u32 x = 0; x < info->width; ++x) {
+            /* Guest display A8R8G8B8 bytes -> capture writer RGBA bytes. */
+            dst[x*4+0] = src[x*4+1]; dst[x*4+1] = src[x*4+2];
+            dst[x*4+2] = src[x*4+3]; dst[x*4+3] = src[x*4+0];
+        }
+    }
+    snprintf(path, sizeof(path), "%s/guest_active_raw_%08X.bmp",
+             s_tj_compose_capture.dir, info->offset);
+    cap_write_bmp(path, rgba, info->width, info->height, info->width * 4,
+                  DXGI_FORMAT_R8G8B8A8_UNORM);
+    free(rgba);
+    fprintf(stderr, "[TJ-COMPOSE-CAP] guest_active raw=%08X ea=%08X %ux%u\n",
+            info->offset, ea, info->width, info->height);
+}
+
+static void tj_compose_capture_begin(u32 fi, u32 draws, u32 selected_buffer_id,
+                                     u32 selected_display_raw, int selected_display_valid)
+{
+    int alias_diag = tj_compose_alias_diag_enabled();
+    int copy_diag = tj_compose_copy_diag_enabled();
+    int main_diag = tj_compose_main_prov_enabled();
+    int target_diag = tj_compose_target_enabled();
+    if (target_diag) {
+        extern volatile LONG g_tj_geometry_trace_armed;
+        if (!tj_compose_capture_enabled() || s_tj_compose_capture.done ||
+            alias_diag || copy_diag || main_diag ||
+            (InterlockedCompareExchange(&g_tj_geometry_trace_armed, 0, 0) < 2 &&
+             !getenv("TJ_COMPOSE_CAPTURE_SHORT_FRAME")))
+            return;
+        s_tj_compose_target_count = 0;
+        u32 ordinal = 0;
+        for (u32 d = 0; d < draws && d < MAX_DRAWS; ++d) {
+            const D3D12DrawRecord* dr = &s_d3d.draws[d];
+            if (dr->is_scaled_blit) continue;
+            if (dr->is_vp && dr->rt_is_display &&
+                ((!dr->is_clear && dr->fp_addr == s_tj_compose_target_fp) ||
+                 s_tj_compose_target_count) &&
+                s_tj_compose_target_count < 16) {
+                u32 n = s_tj_compose_target_count++;
+                s_tj_compose_target_ordinal[n] = ordinal;
+                s_tj_compose_target_raw[n] = dr->rt_display_raw;
+            }
+            ++ordinal;
+        }
+        if (!s_tj_compose_target_count) return;
+    }
+    int selected_slot = tj_compose_capture_selected_surface(
+        selected_display_raw, selected_display_valid);
+    if (main_diag) {
+        int phase0_ready = s_tj_main_prov.phase == 0 &&
+            s_tj_compose_capture.consumer_total != 0;
+        if (!tj_compose_capture_enabled() || !rsx_survival_trace_is_armed() ||
+            s_tj_main_prov.phase >= 2 || selected_slot < 0 ||
+            (!phase0_ready && s_tj_main_prov.phase == 0) ||
+            !tj_main_prov_plan_batch(draws, selected_slot))
+            return;
+        const char* base = getenv("TJ_COMPOSE_CAPTURE_DIR");
+        if (s_tj_main_prov.phase == 0) {
+            CreateDirectoryA(base, NULL);
+            snprintf(s_tj_main_prov.dir, sizeof(s_tj_main_prov.dir),
+                     "%s/main_prov_%llu", base,
+                     (unsigned long long)s_tj_compose_capture.batch);
+            CreateDirectoryA(s_tj_main_prov.dir, NULL);
+        }
+        snprintf(s_tj_compose_capture.dir, sizeof(s_tj_compose_capture.dir),
+                 "%s", s_tj_main_prov.dir);
+        s_tj_compose_capture.active = 1;
+        s_tj_compose_capture.count = 0;
+        s_tj_compose_capture.frame_index = fi;
+        s_tj_compose_capture.consumed_buffer_id = selected_buffer_id;
+        s_tj_compose_capture.selected_raw = selected_display_raw;
+        s_tj_compose_capture.selected_slot = selected_slot;
+        s_tj_main_prov.active = 1;
+        if (getenv("TJ_COMPOSE_COPY_DIAG") || getenv("TJ_COMPOSE_ALIAS_DIAG"))
+            fprintf(stderr, "[TJ-MAIN-PROV] mode=main copy_alias=suppressed\n");
+        return;
+    }
+    if (copy_diag && s_tj_compose_capture.copy_pending && selected_slot >= 0) {
+        /* Preflight has already cached endpoints.  Keep the first two FIFO
+         * copies after the last raw-740 consumer that produce this display. */
+        for (u32 d = s_tj_compose_capture.last_consumer_record + 1;
+             d < draws && d < MAX_DRAWS && s_tj_compose_capture.copy_plan_count < 2; ++d) {
+            const D3D12DrawRecord* dr = &s_d3d.draws[d];
+            if (!dr->is_scaled_blit || !dr->scaled_blit_prepared ||
+                dr->scaled_blit_dst_kind != GPU_BLIT_DISPLAY ||
+                dr->scaled_blit_dst_slot != selected_slot)
+                continue;
+            TjComposeCopyPlan* p = &s_tj_compose_capture.copy_plan[
+                s_tj_compose_capture.copy_plan_count++];
+            const RsxD3D12ExactBlit* b = &dr->scaled_blit;
+            p->record = d;
+            p->src_kind = dr->scaled_blit_src_kind; p->src_slot = dr->scaled_blit_src_slot;
+            p->dst_kind = dr->scaled_blit_dst_kind; p->dst_slot = dr->scaled_blit_dst_slot;
+            p->src_x = dr->scaled_blit_src_x; p->src_y = dr->scaled_blit_src_y;
+            p->dst_x = dr->scaled_blit_dst_x; p->dst_y = dr->scaled_blit_dst_y;
+            p->src_raw = b->src_raw; p->src_pitch = b->src_pitch;
+            p->src_point_x = b->src_x; p->src_point_y = b->src_y;
+            p->dst_raw = b->dst_raw; p->dst_pitch = b->dst_pitch;
+            p->dst_point_x = b->dst_x; p->dst_point_y = b->dst_y;
+            p->copy_w = b->copy_w; p->copy_h = b->copy_h;
+        }
+    }
+    if (!tj_compose_capture_enabled() || s_tj_compose_capture.done ||
+        !rsx_survival_trace_is_armed() ||
+        (target_diag ? !s_tj_compose_target_count :
+         copy_diag ? !s_tj_compose_capture.copy_plan_count :
+         alias_diag ? !s_tj_compose_capture.alias_pending :
+         (draws <= 98 && !getenv("TJ_COMPOSE_CAPTURE_SHORT_FRAME"))))
+        return;
+    const char* base = getenv("TJ_COMPOSE_CAPTURE_DIR");
+    CreateDirectoryA(base, NULL);
+    snprintf(s_tj_compose_capture.dir, sizeof(s_tj_compose_capture.dir),
+             "%s/compose_%llu", base, (unsigned long long)s_d3d.frame_count);
+    CreateDirectoryA(s_tj_compose_capture.dir, NULL);
+    s_tj_compose_capture.active = 1;
+    s_tj_compose_capture.done = 1;
+    s_tj_compose_capture.alias_active = alias_diag;
+    s_tj_compose_capture.copy_active = copy_diag;
+    s_tj_compose_capture.count = 0;
+    s_tj_compose_capture.frame_index = fi;
+    s_tj_compose_capture.consumed_buffer_id = selected_buffer_id;
+    s_tj_compose_capture.selected_raw = selected_display_raw;
+    s_tj_compose_capture.selected_slot = selected_slot;
+    {
+        CellGcmFlipTicket ticket = {0};
+        cellGcm_flip_consumed_ticket_snapshot(&ticket);
+        s_tj_compose_capture.consumed_flip_generation = ticket.generation;
+    }
+    s_tj_compose_capture.history_slot = tj_compose_alias_history_slot();
+    s_tj_compose_capture.history_valid = s_tj_compose_capture.history_slot >= 0 ?
+        s_d3d.display_history[s_tj_compose_capture.history_slot].valid : 0;
+    s_tj_compose_capture.history_state = s_tj_compose_capture.history_slot >= 0 ?
+        (u32)s_d3d.display_history[s_tj_compose_capture.history_slot].st : 0;
+    s_tj_compose_capture.history_before_generation = s_tj_compose_capture.history_generation;
+    s_tj_compose_capture.history_before_completed_raw =
+        s_tj_compose_capture.history_completed_raw;
+    if (alias_diag) {
+        if (s_tj_compose_capture.parent_slot[0] >= 0)
+            s_tj_compose_capture.parent_slot[0] =
+                display_surface_get_registered(s_tj_compose_capture.parent_raw[0]);
+        if (s_tj_compose_capture.parent_slot[1] >= 0)
+            s_tj_compose_capture.parent_slot[1] =
+                display_surface_get_registered(s_tj_compose_capture.parent_raw[1]);
+        return; /* Alias mode owns all nine slots dynamically during replay. */
+    }
+    if (copy_diag) {
+        if (getenv("TJ_COMPOSE_ALIAS_DIAG"))
+            fprintf(stderr, "[TJ-COMPOSE-COPY] mode=copy alias_mode=suppressed\n");
+        tj_compose_capture_alias_history("copy_history740_before");
+        return; /* Copy mode owns the remaining eight slots during replay. */
+    }
+    fprintf(stderr, "[TJ-COMPOSE-CAP] begin frame=%llu draws=%u dir=%s\n",
+            (unsigned long long)s_d3d.frame_count, draws, s_tj_compose_capture.dir);
+    if (target_diag) {
+        char path[512];
+        snprintf(path, sizeof(path), "%s/ordered_ops.txt", s_tj_compose_capture.dir);
+        FILE* f = fopen(path, "w");
+        if (f) {
+            u32 ordinal = 0;
+            fprintf(f, "selected_raw=%08X selected_valid=%d captures=%u limit=16\n",
+                    selected_display_raw, selected_display_valid, s_tj_compose_target_count);
+            for (u32 d = 0; d < draws && d < MAX_DRAWS; ++d) {
+                const D3D12DrawRecord* r = &s_d3d.draws[d];
+                if (r->is_scaled_blit) {
+                    const RsxD3D12ExactBlit* b = &r->scaled_blit;
+                    fprintf(f, "record=%u COPY src=%c:%08X dst=%c:%08X size=%ux%u\n",
+                            d, b->src_local ? 'L' : 'M', b->src_raw,
+                            b->dst_local ? 'L' : 'M', b->dst_raw, b->copy_w, b->copy_h);
+                    continue;
+                }
+                fprintf(f, "record=%u op=%u %s display=%d raw=%08X rt=%08X fp=%08X vs=%d n=%u cmask=%X blend=%08X depth=%08X clear=%02X scissor=%u,%u,%ux%u zeta=%c:%08X\n",
+                        d, ordinal++, r->is_clear ? "CLEAR" : "DRAW", r->rt_is_display,
+                        r->rt_display_raw, r->rt_off, r->fp_addr, r->vs_idx,
+                        r->vertex_count, r->cmask, r->blend_key, r->depth_key,
+                        r->clear_flags, r->scissor_x, r->scissor_y,
+                        r->scissor_w, r->scissor_h, r->zeta_local ? 'L' : 'M', r->zeta_raw);
+                if (!r->is_clear)
+                    for (u32 t = 0; t < RSX_MAX_TEXTURES; ++t)
+                        if (r->tex[t].set)
+                            fprintf(f, " t%u=%08X %ux%u fmt=%02X\n", t,
+                                    r->tex[t].raw, r->tex[t].w, r->tex[t].h, r->tex[t].fmt);
+            }
+            fclose(f);
+        }
+    }
+    tj_compose_capture_guest_display(selected_buffer_id);
+    /* This is after the frame-start clear, before replay mutates the selected
+     * persistent display surface.  The swapchain remains only the final copy. */
+    int ds = tj_compose_capture_selected_surface(selected_display_raw,
+                                                 selected_display_valid);
+    if (ds >= 0) {
+        DisplaySurface* s = &s_d3d.display_surface[ds];
+        tj_compose_capture_queue("host_frame_begin", s->res, 0, 0,
+                                 s->w, s->h, DXGI_FORMAT_R8G8B8A8_UNORM, s->st);
+    } else {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] host_frame_begin omitted=display-surface-unavailable\n");
+    }
+}
+
+static void tj_compose_capture_queue(const char* name, ID3D12Resource* res,
+                                     u32 x, u32 y, u32 w, u32 h, u32 dxgi,
+                                     D3D12_RESOURCE_STATES prior)
+{
+    if (!s_tj_compose_capture.active || !res || !w || !h ||
+        s_tj_compose_capture.count >= TJ_COMPOSE_CAPTURE_MAX)
+        return;
+    TjComposeCaptureItem* item = &s_tj_compose_capture.item[s_tj_compose_capture.count];
+    u32 bpp = dxgi == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8 :
+              dxgi == DXGI_FORMAT_R32G32B32A32_FLOAT ? 16 : 4;
+    u32 pitch = (w * bpp + 255) & ~255u;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width = (u64)pitch * h; rd.Height = 1; rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1; rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&item->rb)) || !item->rb) {
+        fprintf(stderr, "[TJ-COMPOSE-CAP] %s omitted=readback-alloc\n", name);
+        return;
+    }
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = res;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    if (prior != D3D12_RESOURCE_STATE_COPY_SOURCE) {
+        b.Transition.StateBefore = prior;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        d3d12_owned_barriers(1, &b);
+    }
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = item->rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = (DXGI_FORMAT)dxgi;
+    dst.PlacedFootprint.Footprint.Width = w; dst.PlacedFootprint.Footprint.Height = h;
+    dst.PlacedFootprint.Footprint.Depth = 1; dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    src.pResource = res; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box = {x, y, 0, x + w, y + h, 1};
+    d3d12_owned_copy_texture(&dst, 0, 0, 0, &src, &box);
+    if (prior != D3D12_RESOURCE_STATE_COPY_SOURCE) {
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b.Transition.StateAfter = prior;
+        d3d12_owned_barriers(1, &b);
+    }
+    snprintf(item->name, sizeof(item->name), "%s", name);
+    item->w = w; item->h = h; item->pitch = pitch; item->dxgi = dxgi;
+    s_tj_compose_capture.count++;
+}
+
+static void tj_compose_capture_write(void)
+{
+    if (!s_tj_compose_capture.active) return;
+    if (wait_for_gpu_checked_at(RSX_COMPLETION_CAPTURE) != 0) {
+        gcm2d_backend_halt("compose capture fence");
+        return;
+    }
+    for (u32 i = 0; i < s_tj_compose_capture.count; ++i) {
+        TjComposeCaptureItem* item = &s_tj_compose_capture.item[i];
+        void* mapped = NULL;
+        D3D12_RANGE range = {0, (SIZE_T)item->pitch * item->h};
+        if (SUCCEEDED(item->rb->lpVtbl->Map(item->rb, 0, &range, &mapped)) && mapped) {
+            char path[512];
+            snprintf(path, sizeof(path), "%s/%s.bmp", s_tj_compose_capture.dir, item->name);
+            cap_write_bmp(path, mapped, item->w, item->h, item->pitch, item->dxgi);
+            D3D12_RANGE written = {0, 0};
+            item->rb->lpVtbl->Unmap(item->rb, 0, &written);
+            fprintf(stderr, "[TJ-COMPOSE-CAP] wrote %s\n", path);
+        }
+        item->rb->lpVtbl->Release(item->rb);
+        item->rb = NULL;
+    }
+    if (s_tj_main_prov.active) {
+        char path[512];
+        snprintf(path, sizeof(path), "%s/main_prov_report.txt", s_tj_main_prov.dir);
+        FILE* f = fopen(path, s_tj_main_prov.phase == 0 ? "w" : "a");
+        if (f) {
+            const TjMainProvSpan* p = s_tj_main_prov.phase == 0
+                ? &s_tj_main_prov.saved_dst : &s_tj_main_prov.next_src;
+            fprintf(f, "phase=%u batch=%llu record=%u kind=%d slot=%d raw=%08X ea=%08X pitch=%u full=%ux%u span=%llu rect=%u,%u %ux%u captures=%u\n",
+                    (unsigned)s_tj_main_prov.phase, (unsigned long long)p->batch,
+                    p->record, p->kind, p->slot, p->raw, p->ea, p->pitch,
+                    p->w, p->h, (unsigned long long)p->span,
+                    p->x, p->y, p->copy_w, p->copy_h,
+                    s_tj_compose_capture.count);
+            if (s_tj_main_prov.phase == 0) {
+                const TjMainProvSpan* l = &s_tj_main_prov.load_src;
+                fprintf(f, "load_upper batch=%llu record=%u kind=%d slot=%d raw=%08X ea=%08X pitch=%u full=%ux%u span=%llu rect=%u,%u %ux%u differs=%d\n",
+                        (unsigned long long)l->batch, l->record, l->kind, l->slot,
+                        l->raw, l->ea, l->pitch, l->w, l->h,
+                        (unsigned long long)l->span, l->x, l->y,
+                        l->copy_w, l->copy_h,
+                        !tj_main_prov_span_same(&s_tj_main_prov.saved_dst, l));
+            }
+            if (s_tj_main_prov.phase == 1) {
+                const TjMainProvSpan* n = &s_tj_main_prov.saved_dst;
+                fprintf(f, "match_n batch=%llu record=%u raw=%08X ea=%08X pitch=%u full=%ux%u span=%llu\n",
+                        (unsigned long long)n->batch, n->record, n->raw, n->ea,
+                        n->pitch, n->w, n->h, (unsigned long long)n->span);
+            }
+            fclose(f);
+            fprintf(stderr, "[TJ-MAIN-PROV] phase=%d batch=%llu record=%u captures=%u report=%s\n",
+                    s_tj_main_prov.phase, (unsigned long long)p->batch,
+                    p->record, s_tj_compose_capture.count, path);
+        }
+        s_tj_main_prov.phase++;
+        s_tj_main_prov.active = 0;
+    }
+    if (s_tj_compose_capture.alias_active) {
+        char path[512];
+        snprintf(path, sizeof(path), "%s/alias_report.txt", s_tj_compose_capture.dir);
+        FILE* f = fopen(path, "w");
+        if (f) {
+            fprintf(f, "batch=%llu frame_index=%u flip_generation=%llu selected_id=%u selected_raw=%08X selected_slot=%d\n",
+                    (unsigned long long)s_tj_compose_capture.batch,
+                    s_tj_compose_capture.frame_index,
+                    (unsigned long long)s_tj_compose_capture.consumed_flip_generation,
+                    s_tj_compose_capture.consumed_buffer_id,
+                    s_tj_compose_capture.selected_raw, s_tj_compose_capture.selected_slot);
+            fprintf(f, "consumers total=%u stored=%u dropped=%u last_record=%u last_unit=%d\n",
+                    s_tj_compose_capture.consumer_total, s_tj_compose_capture.consumer_stored,
+                    s_tj_compose_capture.consumer_dropped,
+                    s_tj_compose_capture.last_consumer_record,
+                    s_tj_compose_capture.last_consumer_unit);
+            for (u32 i = 0; i < s_tj_compose_capture.consumer_stored; ++i)
+                fprintf(f, "consumer[%u] record=%u\n", i,
+                        s_tj_compose_capture.consumer_record[i]);
+            fprintf(f, "parents raw0=%08X slot0=%d raw1=%08X slot1=%d\n",
+                    s_tj_compose_capture.parent_raw[0], s_tj_compose_capture.parent_slot[0],
+                    s_tj_compose_capture.parent_raw[1], s_tj_compose_capture.parent_slot[1]);
+            fprintf(f, "history raw=00740000 slot=%d valid=%d state=%u before_commit_batch=%llu before_completed_raw=%08X\n",
+                    s_tj_compose_capture.history_slot, s_tj_compose_capture.history_valid,
+                    s_tj_compose_capture.history_state,
+                    (unsigned long long)s_tj_compose_capture.history_before_generation,
+                    s_tj_compose_capture.history_before_completed_raw);
+            fprintf(f, "preflight stored=%u dropped=%u\n",
+                    s_tj_compose_capture.preflight_count,
+                    s_tj_compose_capture.preflight_dropped);
+            for (u32 i = 0; i < s_tj_compose_capture.preflight_count; ++i) {
+                const TjComposeAliasPreflight* p = &s_tj_compose_capture.preflight[i];
+                fprintf(f, "preflight[%u] record=%u src=%c:%08X dst=%c:%08X prepared=%d dst_kind=%d dst_slot=%d\n",
+                        i, p->record, p->src_local ? 'L' : 'M', p->src_raw,
+                        p->dst_local ? 'L' : 'M', p->dst_raw,
+                        p->prepared, p->dst_kind, p->dst_slot);
+            }
+            fprintf(f, "display_exact stored=%u dropped=%u\n",
+                    s_tj_compose_capture.exact_count, s_tj_compose_capture.exact_dropped);
+            for (u32 i = 0; i < s_tj_compose_capture.exact_count; ++i) {
+                const TjComposeAliasExact* e = &s_tj_compose_capture.exact[i];
+                fprintf(f, "display_exact[%u] batch=%llu record=%u slot=%d raw=%08X alias_raw=%08X rect=%u,%u %ux%u\n",
+                        i, (unsigned long long)e->batch, e->record, e->slot,
+                        e->raw, e->alias_raw, e->x, e->y, e->w, e->h);
+            }
+            fclose(f);
+            fprintf(stderr, "[TJ-COMPOSE-ALIAS] batch=%llu consumers=%u last=%u captures=%u report=%s\n",
+                    (unsigned long long)s_tj_compose_capture.batch,
+                    s_tj_compose_capture.consumer_total,
+                    s_tj_compose_capture.last_consumer_record,
+                    s_tj_compose_capture.count, path);
+        }
+    }
+    if (s_tj_compose_capture.copy_active) {
+        char path[512];
+        snprintf(path, sizeof(path), "%s/copy_report.txt", s_tj_compose_capture.dir);
+        FILE* f = fopen(path, "w");
+        if (f) {
+            fprintf(f, "mode=copy batch=%llu frame_index=%u flip_generation=%llu selected_id=%u selected_raw=%08X selected_slot=%d\n",
+                    (unsigned long long)s_tj_compose_capture.batch,
+                    s_tj_compose_capture.frame_index,
+                    (unsigned long long)s_tj_compose_capture.consumed_flip_generation,
+                    s_tj_compose_capture.consumed_buffer_id,
+                    s_tj_compose_capture.selected_raw, s_tj_compose_capture.selected_slot);
+            fprintf(f, "raw740 consumers=%u last_record=%u planned=%u captures=%u\n",
+                    s_tj_compose_capture.consumer_total,
+                    s_tj_compose_capture.last_consumer_record,
+                    s_tj_compose_capture.copy_plan_count, s_tj_compose_capture.count);
+            for (u32 i = 0; i < s_tj_compose_capture.copy_plan_count; ++i) {
+                const TjComposeCopyPlan* p = &s_tj_compose_capture.copy_plan[i];
+                fprintf(f, "copy[%u] record=%u src(kind=%d slot=%d raw=%08X pitch=%u origin=%u,%u point=%u,%u) dst(kind=%d slot=%d raw=%08X pitch=%u origin=%u,%u point=%u,%u) size=%ux%u\n",
+                        i, p->record, p->src_kind, p->src_slot, p->src_raw,
+                        p->src_pitch, p->src_x, p->src_y, p->src_point_x, p->src_point_y,
+                        p->dst_kind, p->dst_slot,
+                        p->dst_raw, p->dst_pitch, p->dst_x, p->dst_y,
+                        p->dst_point_x, p->dst_point_y,
+                        p->copy_w, p->copy_h);
+            }
+            fclose(f);
+            fprintf(stderr, "[TJ-COMPOSE-COPY] batch=%llu consumers=%u planned=%u captures=%u report=%s\n",
+                    (unsigned long long)s_tj_compose_capture.batch,
+                    s_tj_compose_capture.consumer_total,
+                    s_tj_compose_capture.copy_plan_count,
+                    s_tj_compose_capture.count, path);
+        }
+    }
+    s_tj_compose_capture.active = 0;
+    s_tj_compose_capture.alias_active = 0;
+    s_tj_compose_capture.copy_active = 0;
+}
+
+static void tj_compose_capture_reset(int recache_env)
+{
+    for (u32 i = 0; i < TJ_COMPOSE_CAPTURE_MAX; ++i) {
+        if (s_tj_compose_capture.item[i].rb) {
+            s_tj_compose_capture.item[i].rb->lpVtbl->Release(
+                s_tj_compose_capture.item[i].rb);
+        }
+    }
+    memset(&s_tj_compose_capture, 0, sizeof(s_tj_compose_capture));
+    s_tj_compose_capture.enabled = recache_env ? -1 : 0;
+    s_tj_compose_capture.alias_enabled = recache_env ? -1 : 0;
+    s_tj_compose_capture.copy_enabled = recache_env ? -1 : 0;
+    memset(&s_tj_main_prov, 0, sizeof(s_tj_main_prov));
+    s_tj_main_prov.enabled = recache_env ? -1 : 0;
+}
+
+static void rsx_capture_frame(u32 fi, u32 ndraws, u32 capidx,
+                              const char* base_override)
+{
+    char dir[300]; const char* base = base_override ? base_override : getenv("RSX_CAP_DIR");
+    if (!base || !*base) base = "rsxcap";
+    CreateDirectoryA(base, NULL);
+    snprintf(dir, sizeof dir, "%s/frame_%02u", base, capidx);
+    CreateDirectoryA(dir, NULL);
+    char path[512];
+
+    /* Manifest: every op in submission order with full state. */
+    snprintf(path, sizeof path, "%s/manifest.txt", dir);
+    FILE* mf = fopen(path, "w");
+    if (mf) {
+        fprintf(mf, "frame_count=%llu draws=%u backbuffer=%ux%u\n",
+                (unsigned long long)s_d3d.frame_count, ndraws, s_d3d.width, s_d3d.height);
+        for (int i = 0; i < MAX_OFF_RTS; i++)
+            if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].used)
+                fprintf(mf, "offrt[%d] off=0x%08X %ux%u dxgi=%u\n", i, s_d3d.off_rt[i].off,
+                        s_d3d.off_rt[i].w, s_d3d.off_rt[i].h, s_d3d.off_rt[i].dxgi);
+        fprintf(mf, "--- ops ---\n");
+        for (u32 d = 0; d < ndraws && d < MAX_DRAWS; d++) {
+            const D3D12DrawRecord* r = &s_d3d.draws[d];
+            if (r->is_clear)
+                fprintf(mf, "op%03u CLEAR rt=0x%08X mrt=0x%X/0x%X/0x%X cc=(%.3f,%.3f,%.3f,%.3f) flags=%02X scissor=%u,%u,%ux%u zeta=%c:%08X pitch=%u\n",
+                        d, r->rt_off, r->rt_mrt[0], r->rt_mrt[1], r->rt_mrt[2],
+                        r->cc[0], r->cc[1], r->cc[2], r->cc[3], r->clear_flags,
+                        r->scissor_x, r->scissor_y, r->scissor_w, r->scissor_h,
+                        r->zeta_local ? 'L' : 'M', r->zeta_raw, r->zeta_pitch);
+            else {
+                fprintf(mf, "op%03u DRAW  rt=0x%08X mrt=0x%X/0x%X/0x%X vp=%u,%u,%ux%u fp=0x%08X vs=%d "
+                            "n=%u cmask=%X alpha=0x%X blend=%d bk=0x%X depth=0x%X t0=0x%08X t1=0x%08X t2=0x%08X t3=0x%08X\n",
+                        d, r->rt_off, r->rt_mrt[0], r->rt_mrt[1], r->rt_mrt[2],
+                        r->vp_x, r->vp_y, r->vp_w, r->vp_h,
+                        r->fp_addr, r->vs_idx, r->vertex_count, r->cmask,
+                        r->alpha_ctl, r->blend, r->blend_key, r->depth_key,
+                        r->tex[0].raw, r->tex[1].raw, r->tex[2].raw, r->tex[3].raw);
+                for (int u = 0; u < RSX_MAX_TEXTURES; u++)
+                    if (r->tex[u].set)
+                        fprintf(mf, "      t%d off=0x%08X fmt=0x%02X (%s%s) %ux%u "
+                                    "addr=0x%08X ctrl0=0x%08X ctrl1=0x%08X filter=0x%08X "
+                                    "border=0x%08X remap=0x%04X\n", u,
+                                r->tex[u].off, r->tex[u].fmt,
+                                (r->tex[u].fmt & 0x20) ? "LN" : "SZ",
+                                (r->tex[u].fmt & 0x40) ? ",NR" : "",
+                                r->tex[u].w, r->tex[u].h, r->tex[u].address,
+                                r->tex[u].control0, r->tex[u].ctrl1, r->tex[u].filter,
+                                r->tex[u].border_color, r->tex[u].ctrl1 & 0xFFFF);
+                if (r->is_vp && s_d3d.vp_vb_mapped) {
+                    u32 par = (u32)(s_d3d.vp_parity ^ 1);
+                    const u8* vb = (const u8*)s_d3d.vp_vb_mapped
+                                 + (u64)par * MAX_VERTICES * 256u
+                                 + r->vb_byte_offset;
+                    u32 nv = r->vertex_count < 3 ? r->vertex_count : 3;
+                    for (u32 v = 0; v < nv; v++) {
+                        const float* f = (const float*)(vb + (u64)v * 256u);
+                        fprintf(mf, "      v%u a0=(%.4f,%.4f,%.4f,%.4f) "
+                                    "a3=(%.4f,%.4f,%.4f,%.4f) "
+                                    "a8=(%.4f,%.4f,%.4f,%.4f)\n", v,
+                                f[0], f[1], f[2], f[3],
+                                f[12], f[13], f[14], f[15],
+                                f[32], f[33], f[34], f[35]);
+                    }
+                }
+            }
+        }
+        /* Per-draw VP constant banks for the first few offscreen-RT geometry
+         * draws: c[0..3] is the projection row-major for most CG VPs; also scan
+         * for the largest non-zero slot so a mis-placed MVP is obvious. Records
+         * live at slot==draw-index; parity is post-^1 here (capture is after the
+         * frame's vp_parity flip), so read the other half. */
+        if (s_d3d.vp_cb_mapped) {
+            u32 par = (u32)(s_d3d.vp_parity ^ 1);
+            fprintf(mf, "--- vp constants (first offscreen geometry draws) ---\n");
+            int shown = 0;
+            for (u32 d = 0; d < ndraws && d < MAX_DRAWS && shown < 4; d++) {
+                const D3D12DrawRecord* r = &s_d3d.draws[d];
+                if (r->is_clear || (!r->rt_off && r->rt_local)) continue;
+                const float* c = (const float*)((const char*)s_d3d.vp_cb_mapped
+                    + ((u64)par * MAX_DRAWS + d) * VP_CB_STRIDE);
+                int last_nz = -1; float maxabs = 0.0f;
+                for (int i = 0; i < RSX_MAX_VERTEX_CONSTANTS * 4; i++) {
+                    float a = c[i] < 0 ? -c[i] : c[i];
+                    if (a > 1e-9f) last_nz = i;
+                    if (a > maxabs) maxabs = a;
+                }
+                fprintf(mf, "op%03u vs=%d lastNZslot=%d maxabs=%.3f\n",
+                        d, r->vs_idx, last_nz / 4, maxabs);
+                if (shown == 0) {   /* full non-zero slot dump for the 1st draw */
+                    for (int s = 0; s <= last_nz / 4; s++) {
+                        const float* v = c + s * 4;
+                        if ((v[0]||v[1]||v[2]||v[3]))
+                            fprintf(mf, "   c[%3d] = %9.4f %9.4f %9.4f %9.4f\n",
+                                    s, v[0], v[1], v[2], v[3]);
+                    }
+                }
+                shown++;
+            }
+        }
+        fclose(mf);
+    }
+
+    /* Backbuffer (in PRESENT state at capture time) + every used offscreen RT. */
+    snprintf(path, sizeof path, "%s/backbuffer.bmp", dir);
+    cap_readback_write(s_d3d.render_targets[fi], s_d3d.width, s_d3d.height,
+                       DXGI_FORMAT_R8G8B8A8_UNORM, D3D12_RESOURCE_STATE_PRESENT, fi, path);
+    if (s_d3d.gcm2d_backend_halted) return;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res || !r->used) continue;
+        snprintf(path, sizeof path, "%s/rt_%08X.bmp", dir, r->off);
+        cap_readback_write(r->res, r->w, r->h, r->dxgi, r->st, fi, path);
+        if (s_d3d.gcm2d_backend_halted) return;
+    }
+    printf("[RSXCAP] frame %llu -> %s (%u ops)\n",
+           (unsigned long long)s_d3d.frame_count, dir, ndraws);
+}
+
+static u32 vp_texture_dimension_key(const rsx_state* st)
+{
+    u32 key = 0;
+    if (!st) return 0x492u; /* four 2D units */
+    for (u32 unit = 0; unit < RSX_MAX_VERTEX_TEXTURES; ++unit) {
+        u32 fmt = st->vertex_textures[unit].format;
+        u32 dim = (fmt >> 4) & 0xFu;
+        if (dim == 2u && (fmt & 4u)) dim = 4u;
+        if (dim < 1u || dim > 4u) dim = 2u;
+        key |= dim << (unit * 3u);
+    }
+    return key;
+}
+
+/* The fallback atlas/colour PSO build result belongs to this exact VP source
+ * and entry/configuration. A failed build is remembered by this full key, not
+ * merely its byte count, so it cannot suppress a different same-sized VP. */
+static u32 vp_static_compile_key(const rsx_state* st)
+{
+    u32 hash = 2166136261u;
+    for (u32 i = 0; i < st->vp_ucode_bytes; ++i) {
+        hash ^= st->vp_ucode[i];
+        hash *= 16777619u;
+    }
+    hash ^= st->vp_ucode_bytes;
+    hash *= 16777619u;
+    hash ^= st->transform_program_start;
+    hash *= 16777619u;
+    hash ^= vp_texture_dimension_key(st);
+    hash *= 16777619u;
+    return hash ? hash : 1u;
+}
+
+/* ---------------------------------------------------------------------------
+ * Runtime HLSL bytecode cache. TJ_SHADER_CACHE=0 disables it entirely (plain
+ * D3DCompile); TJ_SHADER_CACHE_DIR overrides <exe dir>\shader-cache.
+ *
+ * Exact-input reuse only. The SHA-256 key covers the file format, the loaded
+ * d3dcompiler_47.dll file version, source name, entry, target, both flag
+ * words, the source length and the exact HLSL bytes; these call sites pass
+ * no defines and no include handler. A disk file is accepted only when its
+ * header equals the expected identity, its stored HLSL is byte-identical and
+ * its bytecode matches the stored SHA-256; anything else is ignored and the
+ * shader is compiled. Failures are never cached and no cache read/write
+ * failure can fail a compile. The session map also shares one blob (AddRef)
+ * between identical compiles in this process.
+ * -----------------------------------------------------------------------*/
+#define TJ_SHADER_CACHE_MAGIC       0x43534A54u /* bytes "TJSC" (LE) */
+#define TJ_SHADER_CACHE_FORMAT      1u
+#define TJ_SHADER_CACHE_PATH_MAX    1024u
+#define TJ_SHADER_CACHE_MAX_SOURCE  (64ull * 1024ull * 1024ull)
+#define TJ_SHADER_CACHE_MAX_BLOB    (16ull * 1024ull * 1024ull)
+#define TJ_SHADER_SESSION_MAX       8192u
+#define TJ_SHADER_SESSION_SLOTS     16384u /* open-addressed, power of two */
+#define TJ_SHADER_SESSION_MAX_BYTES (256ull * 1024ull * 1024ull)
+
+typedef struct {
+    u32 magic, version;
+    u32 compiler_ms, compiler_ls; /* d3dcompiler_47.dll VS_FIXEDFILEINFO */
+    char target[16];
+    char entry[32];
+    char name[32];
+    u32 flags1, flags2;
+    u64 src_len, blob_len;
+    u8 key[32];                   /* SHA-256 identity; also the file name */
+    u8 blob_sha256[32];           /* bytecode integrity */
+} TJShaderCacheHeader;
+_Static_assert(sizeof(TJShaderCacheHeader) == 184,
+               "TJShaderCacheHeader must stay unpadded");
+
+typedef struct {
+    TJShaderCacheHeader id; /* identity; blob_len/blob_sha256 stay zero */
+    char* source;           /* exact HLSL, owned */
+    ID3DBlob* blob;         /* one reference owned by the session map */
+} TJShaderSessionEntry;
+
+typedef struct {
+    INIT_ONCE once;
+    SRWLOCK lock;           /* guards the session map */
+    int enabled, disk;
+    BCRYPT_ALG_HANDLE sha256;
+    u32 compiler_ms, compiler_ls;
+    volatile LONG temp_serial;
+    wchar_t dir[TJ_SHADER_CACHE_PATH_MAX];
+    u32 session_n;
+    u64 session_bytes;
+    u32 session_slots[TJ_SHADER_SESSION_SLOTS]; /* entry index + 1 */
+    TJShaderSessionEntry session[TJ_SHADER_SESSION_MAX];
+} TJShaderCacheState;
+/* Zero storage is INIT_ONCE_STATIC_INIT and SRWLOCK_INIT. */
+static TJShaderCacheState s_tj_shader_cache;
+
+typedef struct { const void* data; size_t size; } TJShaderHashPart;
+
+static int tj_shader_sha256(const TJShaderHashPart* parts, u32 count, u8 out[32])
+{
+    BCRYPT_HASH_HANDLE hash = NULL;
+    int ok = s_tj_shader_cache.sha256 &&
+        BCRYPT_SUCCESS(BCryptCreateHash(s_tj_shader_cache.sha256, &hash,
+                                        NULL, 0, NULL, 0, 0));
+    for (u32 i = 0; ok && i < count; ++i) {
+        const u8* p = (const u8*)parts[i].data;
+        size_t left = parts[i].size;
+        while (ok && left) {
+            ULONG chunk = left > 0x40000000u ? 0x40000000u : (ULONG)left;
+            ok = BCRYPT_SUCCESS(BCryptHashData(hash, (PUCHAR)p, chunk, 0));
+            p += chunk;
+            left -= chunk;
+        }
+    }
+    if (ok) ok = BCRYPT_SUCCESS(BCryptFinishHash(hash, out, 32, 0));
+    if (hash) BCryptDestroyHash(hash);
+    return ok;
+}
+
+static int tj_shader_cache_compiler_version(u32* ms, u32* ls)
+{
+    wchar_t path[TJ_SHADER_CACHE_PATH_MAX];
+    HMODULE module = GetModuleHandleW(L"d3dcompiler_47.dll");
+    DWORD n = module ? GetModuleFileNameW(module, path, TJ_SHADER_CACHE_PATH_MAX) : 0;
+    if (!n || n >= TJ_SHADER_CACHE_PATH_MAX) return 0;
+    DWORD ignored = 0;
+    DWORD size = GetFileVersionInfoSizeW(path, &ignored);
+    void* data = size ? malloc(size) : NULL;
+    VS_FIXEDFILEINFO* info = NULL;
+    UINT info_len = 0;
+    int ok = data && GetFileVersionInfoW(path, 0, size, data) &&
+             VerQueryValueW(data, L"\\", (LPVOID*)&info, &info_len) &&
+             info && info_len >= sizeof(*info) && info->dwSignature == 0xFEEF04BDu;
+    if (ok) {
+        *ms = info->dwFileVersionMS;
+        *ls = info->dwFileVersionLS;
+    }
+    free(data);
+    return ok;
+}
+
+/* Create each missing component; existing/root components fail harmlessly. */
+static int tj_shader_cache_make_dir(wchar_t* dir)
+{
+    size_t len = 0;
+    while (dir[len]) ++len;
+    for (size_t i = 1; i <= len; ++i) {
+        if (i < len && dir[i] != L'\\' && dir[i] != L'/') continue;
+        if (dir[i - 1] == L':' || dir[i - 1] == L'\\' || dir[i - 1] == L'/') continue;
+        wchar_t saved = dir[i];
+        dir[i] = 0;
+        CreateDirectoryW(dir, NULL);
+        dir[i] = saved;
+    }
+    DWORD attributes = GetFileAttributesW(dir);
+    return attributes != INVALID_FILE_ATTRIBUTES &&
+           (attributes & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static BOOL CALLBACK tj_shader_cache_init_once(PINIT_ONCE once, PVOID parameter,
+                                               PVOID* context)
+{
+    static const wchar_t leaf[] = L"shader-cache";
+    TJShaderCacheState* c = &s_tj_shader_cache;
+    const char* env = getenv("TJ_SHADER_CACHE");
+    char dir_utf8[TJ_SHADER_CACHE_PATH_MAX * 3];
+    (void)once; (void)parameter; (void)context;
+    c->enabled = !(env && strcmp(env, "0") == 0);
+
+    DWORD n = GetEnvironmentVariableW(L"TJ_SHADER_CACHE_DIR", c->dir,
+                                      TJ_SHADER_CACHE_PATH_MAX);
+    if (n >= TJ_SHADER_CACHE_PATH_MAX) {
+        c->dir[0] = 0; /* set but too long: no disk cache */
+    } else if (n == 0) {
+        size_t cut = 0;
+        n = GetModuleFileNameW(NULL, c->dir, TJ_SHADER_CACHE_PATH_MAX);
+        for (DWORD i = 0; n < TJ_SHADER_CACHE_PATH_MAX && i < n; ++i)
+            if (c->dir[i] == L'\\' || c->dir[i] == L'/') cut = i + 1u;
+        if (!n || n >= TJ_SHADER_CACHE_PATH_MAX || !cut ||
+            cut + sizeof(leaf) / sizeof(leaf[0]) > TJ_SHADER_CACHE_PATH_MAX)
+            c->dir[0] = 0;
+        else
+            memcpy(c->dir + cut, leaf, sizeof(leaf));
+    }
+    size_t len = 0;
+    while (c->dir[len]) ++len;
+    while (len > 1u && (c->dir[len - 1u] == L'\\' || c->dir[len - 1u] == L'/') &&
+           c->dir[len - 2u] != L':')
+        c->dir[--len] = 0;
+
+    if (c->enabled &&
+        !BCRYPT_SUCCESS(BCryptOpenAlgorithmProvider(&c->sha256,
+                                                    BCRYPT_SHA256_ALGORITHM, NULL, 0))) {
+        c->sha256 = NULL;
+        c->enabled = 0;
+    }
+    /* Unknown compiler identity: session reuse only, never disk files. */
+    if (c->enabled && c->dir[0] &&
+        tj_shader_cache_compiler_version(&c->compiler_ms, &c->compiler_ls))
+        c->disk = tj_shader_cache_make_dir(c->dir);
+    if (!WideCharToMultiByte(CP_UTF8, 0, c->dir, -1, dir_utf8, (int)sizeof(dir_utf8),
+                             NULL, NULL))
+        dir_utf8[0] = 0;
+    fprintf(stderr, "[tj-shader-cache] dir=%s enabled=%d disk=%d compiler=%u.%u.%u.%u\n",
+            dir_utf8, c->enabled, c->disk,
+            c->compiler_ms >> 16, c->compiler_ms & 0xFFFFu,
+            c->compiler_ls >> 16, c->compiler_ls & 0xFFFFu);
+    return TRUE;
+}
+
+static TJShaderCacheState* tj_shader_cache_state(void)
+{
+    InitOnceExecuteOnce(&s_tj_shader_cache.once, tj_shader_cache_init_once, NULL, NULL);
+    return &s_tj_shader_cache;
+}
+
+static int tj_shader_cache_field(char* field, size_t capacity, const char* value)
+{
+    size_t n = value ? strlen(value) : capacity;
+    if (n >= capacity) return 0;
+    memcpy(field, value, n);
+    return 1;
+}
+
+static int tj_shader_cache_identity(TJShaderCacheHeader* id,
+                                    const TJShaderCacheState* c,
+                                    const char* src, size_t len, const char* name,
+                                    const char* entry, const char* target,
+                                    UINT flags1, UINT flags2)
+{
+    memset(id, 0, sizeof(*id));
+    if (!src || !len || (u64)len > TJ_SHADER_CACHE_MAX_SOURCE ||
+        !tj_shader_cache_field(id->target, sizeof(id->target), target) ||
+        !tj_shader_cache_field(id->entry, sizeof(id->entry), entry) ||
+        !tj_shader_cache_field(id->name, sizeof(id->name), name))
+        return 0;
+    id->magic = TJ_SHADER_CACHE_MAGIC;
+    id->version = TJ_SHADER_CACHE_FORMAT;
+    id->compiler_ms = c->compiler_ms;
+    id->compiler_ls = c->compiler_ls;
+    id->flags1 = flags1;
+    id->flags2 = flags2;
+    id->src_len = (u64)len;
+    /* key, blob_len and blob_sha256 are still zero while hashing. */
+    TJShaderHashPart parts[2] = { { id, sizeof(*id) }, { src, len } };
+    return tj_shader_sha256(parts, 2, id->key);
+}
+
+/* Caller holds the lock. On a miss *empty_slot is the first free probe cell. */
+static TJShaderSessionEntry* tj_shader_session_probe(TJShaderCacheState* c,
+                                                     const TJShaderCacheHeader* id,
+                                                     const char* src, size_t len,
+                                                     u32* empty_slot)
+{
+    u32 probe;
+    memcpy(&probe, id->key, sizeof(probe));
+    probe &= TJ_SHADER_SESSION_SLOTS - 1u;
+    if (empty_slot) *empty_slot = UINT32_MAX;
+    for (u32 n = 0; n < TJ_SHADER_SESSION_SLOTS; ++n) {
+        const u32 e = c->session_slots[probe];
+        if (!e) {
+            if (empty_slot) *empty_slot = probe;
+            return NULL;
+        }
+        TJShaderSessionEntry* entry = &c->session[e - 1u];
+        if (memcmp(&entry->id, id, sizeof(*id)) == 0 &&
+            memcmp(entry->source, src, len) == 0)
+            return entry;
+        probe = (probe + 1u) & (TJ_SHADER_SESSION_SLOTS - 1u);
+    }
+    return NULL;
+}
+
+static ID3DBlob* tj_shader_session_find(TJShaderCacheState* c,
+                                        const TJShaderCacheHeader* id,
+                                        const char* src, size_t len)
+{
+    ID3DBlob* blob = NULL;
+    AcquireSRWLockShared(&c->lock);
+    TJShaderSessionEntry* entry = tj_shader_session_probe(c, id, src, len, NULL);
+    if (entry) {
+        blob = entry->blob;
+        blob->lpVtbl->AddRef(blob);
+    }
+    ReleaseSRWLockShared(&c->lock);
+    return blob;
+}
+
+/* Bounded by entry count and retained bytes; once full, new shaders are
+ * simply not retained (the disk cache still serves them). */
+static void tj_shader_session_insert(TJShaderCacheState* c,
+                                     const TJShaderCacheHeader* id,
+                                     const char* src, size_t len, ID3DBlob* blob)
+{
+    const u64 bytes = (u64)len + (u64)blob->lpVtbl->GetBufferSize(blob);
+    u32 slot = UINT32_MAX;
+    AcquireSRWLockExclusive(&c->lock);
+    if (c->session_n < TJ_SHADER_SESSION_MAX &&
+        c->session_bytes + bytes <= TJ_SHADER_SESSION_MAX_BYTES &&
+        !tj_shader_session_probe(c, id, src, len, &slot) && slot != UINT32_MAX) {
+        char* copy = (char*)malloc(len);
+        if (copy) {
+            TJShaderSessionEntry* entry = &c->session[c->session_n];
+            memcpy(copy, src, len);
+            entry->id = *id;
+            entry->source = copy;
+            entry->blob = blob;
+            blob->lpVtbl->AddRef(blob);
+            c->session_slots[slot] = ++c->session_n;
+            c->session_bytes += bytes;
+        }
+    }
+    ReleaseSRWLockExclusive(&c->lock);
+}
+
+static void tj_shader_session_release_all(void)
+{
+    TJShaderCacheState* c = &s_tj_shader_cache;
+    AcquireSRWLockExclusive(&c->lock);
+    for (u32 i = 0; i < c->session_n; ++i) {
+        if (c->session[i].blob)
+            c->session[i].blob->lpVtbl->Release(c->session[i].blob);
+        free(c->session[i].source);
+        memset(&c->session[i], 0, sizeof(c->session[i]));
+    }
+    memset(c->session_slots, 0, sizeof(c->session_slots));
+    c->session_n = 0;
+    c->session_bytes = 0;
+    ReleaseSRWLockExclusive(&c->lock);
+}
+
+static int tj_shader_cache_append(wchar_t* out, size_t* at, const char* ascii)
+{
+    for (; *ascii; ++ascii) {
+        if (*at + 1u >= TJ_SHADER_CACHE_PATH_MAX) return 0;
+        out[(*at)++] = (wchar_t)(u8)*ascii;
+    }
+    out[*at] = 0;
+    return 1;
+}
+
+static int tj_shader_cache_path(wchar_t* out, const TJShaderCacheState* c,
+                                const u8 key[32])
+{
+    static const char hex[] = "0123456789abcdef";
+    char name[64 + sizeof(".dxbc")];
+    size_t at = 0;
+    for (u32 i = 0; i < 32u; ++i) {
+        name[2u * i] = hex[key[i] >> 4];
+        name[2u * i + 1u] = hex[key[i] & 15u];
+    }
+    memcpy(name + 64, ".dxbc", sizeof(".dxbc"));
+    while (c->dir[at] && at + 1u < TJ_SHADER_CACHE_PATH_MAX) {
+        out[at] = c->dir[at];
+        ++at;
+    }
+    out[at] = 0;
+    return !c->dir[at] && tj_shader_cache_append(out, &at, "\\") &&
+           tj_shader_cache_append(out, &at, name);
+}
+
+static int tj_shader_cache_read(HANDLE file, void* data, u64 size)
+{
+    u8* p = (u8*)data;
+    while (size) {
+        DWORD chunk = size > 0x10000000u ? 0x10000000u : (DWORD)size, got = 0;
+        if (!ReadFile(file, p, chunk, &got, NULL) || got != chunk) return 0;
+        p += chunk;
+        size -= chunk;
+    }
+    return 1;
+}
+
+static int tj_shader_cache_write(HANDLE file, const void* data, u64 size)
+{
+    const u8* p = (const u8*)data;
+    while (size) {
+        DWORD chunk = size > 0x10000000u ? 0x10000000u : (DWORD)size, put = 0;
+        if (!WriteFile(file, p, chunk, &put, NULL) || put != chunk) return 0;
+        p += chunk;
+        size -= chunk;
+    }
+    return 1;
+}
+
+static ID3DBlob* tj_shader_cache_load(const wchar_t* path, const TJShaderCacheHeader* id,
+                                      const char* src, size_t len)
+{
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                              NULL, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    TJShaderCacheHeader stored, expect = *id;
+    LARGE_INTEGER size;
+    u8* data = NULL;
+    ID3DBlob* blob = NULL;
+    u8 digest[32];
+    memset(&stored, 0, sizeof(stored));
+    if (GetFileSizeEx(file, &size) && size.QuadPart >= (LONGLONG)sizeof(stored) &&
+        tj_shader_cache_read(file, &stored, sizeof(stored))) {
+        /* Everything but the bytecode length/digest must equal this request. */
+        expect.blob_len = stored.blob_len;
+        memcpy(expect.blob_sha256, stored.blob_sha256, sizeof(expect.blob_sha256));
+        if (memcmp(&expect, &stored, sizeof(stored)) == 0 &&
+            stored.blob_len && stored.blob_len <= TJ_SHADER_CACHE_MAX_BLOB &&
+            (u64)size.QuadPart == sizeof(stored) + stored.src_len + stored.blob_len)
+            data = (u8*)malloc((size_t)(stored.src_len + stored.blob_len));
+    }
+    if (data && tj_shader_cache_read(file, data, stored.src_len + stored.blob_len) &&
+        memcmp(data, src, len) == 0) {
+        TJShaderHashPart part = { data + len, (size_t)stored.blob_len };
+        if (tj_shader_sha256(&part, 1, digest) &&
+            memcmp(digest, stored.blob_sha256, sizeof(digest)) == 0 &&
+            SUCCEEDED(D3DCreateBlob((SIZE_T)stored.blob_len, &blob)) && blob)
+            memcpy(blob->lpVtbl->GetBufferPointer(blob), data + len,
+                   (size_t)stored.blob_len);
+        else
+            blob = NULL;
+    }
+    free(data);
+    CloseHandle(file);
+    return blob;
+}
+
+/* Readers only ever see complete files: write a unique temp file in the same
+ * directory, then publish it with one replacing rename. */
+static void tj_shader_cache_store(TJShaderCacheState* c, const wchar_t* path,
+                                  const TJShaderCacheHeader* id,
+                                  const char* src, size_t len, ID3DBlob* blob)
+{
+    const void* bytes = blob->lpVtbl->GetBufferPointer(blob);
+    const u64 blob_len = (u64)blob->lpVtbl->GetBufferSize(blob);
+    TJShaderCacheHeader header = *id;
+    TJShaderHashPart part = { bytes, (size_t)blob_len };
+    wchar_t temp[TJ_SHADER_CACHE_PATH_MAX];
+    char suffix[48];
+    size_t at = 0;
+    if (!bytes || !blob_len || blob_len > TJ_SHADER_CACHE_MAX_BLOB) return;
+    header.blob_len = blob_len;
+    if (!tj_shader_sha256(&part, 1, header.blob_sha256)) return;
+    while (path[at] && at + 1u < TJ_SHADER_CACHE_PATH_MAX) {
+        temp[at] = path[at];
+        ++at;
+    }
+    temp[at] = 0;
+    snprintf(suffix, sizeof(suffix), ".%lu-%ld.tmp",
+             (unsigned long)GetCurrentProcessId(),
+             (long)InterlockedIncrement(&c->temp_serial));
+    if (path[at] || !tj_shader_cache_append(temp, &at, suffix)) return;
+    HANDLE file = CreateFileW(temp, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                              FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) return;
+    int ok = tj_shader_cache_write(file, &header, sizeof(header)) &&
+             tj_shader_cache_write(file, src, len) &&
+             tj_shader_cache_write(file, bytes, blob_len);
+    if (!CloseHandle(file)) ok = 0;
+    if (!ok || !MoveFileExW(temp, path, MOVEFILE_REPLACE_EXISTING))
+        DeleteFileW(temp);
+}
+
+/* Set only on TJ_SHADER_PREFETCH worker threads: their compiles stay out of
+ * the renderer-thread present-work counters (which are not atomic). */
+static _Thread_local int s_tj_shader_prefetch_worker;
+
+/* Drop-in for D3DCompile(src, len, name, NULL, NULL, entry, target, flags1,
+ * flags2, out_blob, out_err). The returned blob is a new reference; on a
+ * cache hit no error blob is produced. Failures always come from D3DCompile
+ * itself, so error blobs and failure HRESULTs are unchanged. */
+static HRESULT tj_shader_compile_cached(const char* src, size_t len, const char* name,
+                                        const char* entry, const char* target,
+                                        UINT flags1, UINT flags2,
+                                        ID3DBlob** out_blob, ID3DBlob** out_err,
+                                        int* out_cache_hit)
+{
+    TJShaderCacheState* c = tj_shader_cache_state();
+    TJPresentWorkTrace* trace = &s_tj_present_work_trace;
+    const int is_vs = target && target[0] == 'v';
+    const int traced = !s_tj_shader_prefetch_worker;
+    const LONGLONG trace_start = traced ? tj_present_work_trace_sync_begin() : 0;
+    TJShaderCacheHeader id;
+    wchar_t path[TJ_SHADER_CACHE_PATH_MAX];
+    int have_path = 0;
+    ID3DBlob* blob = NULL;
+    HRESULT hr;
+
+    if (out_blob) *out_blob = NULL;
+    if (out_err) *out_err = NULL;
+    if (out_cache_hit) *out_cache_hit = 0;
+    const int cacheable = c->enabled && out_blob &&
+        tj_shader_cache_identity(&id, c, src, len, name, entry, target, flags1, flags2);
+    if (cacheable) {
+        blob = tj_shader_session_find(c, &id, src, len);
+        if (!blob && c->disk && tj_shader_cache_path(path, c, id.key)) {
+            have_path = 1;
+            blob = tj_shader_cache_load(path, &id, src, len);
+            if (blob) tj_shader_session_insert(c, &id, src, len, blob);
+        }
+    }
+    if (blob) {
+        *out_blob = blob;
+        if (out_cache_hit) *out_cache_hit = 1;
+        hr = S_OK;
+    } else {
+        hr = D3DCompile(src, len, name, NULL, NULL, entry, target, flags1, flags2,
+                        out_blob, out_err);
+        if (cacheable && SUCCEEDED(hr) && *out_blob) {
+            tj_shader_session_insert(c, &id, src, len, *out_blob);
+            if (have_path) tj_shader_cache_store(c, path, &id, src, len, *out_blob);
+        }
+    }
+    if (!traced) return hr;
+    if (tj_present_work_trace_enabled() && trace->active &&
+        tj_present_interval_trace_enabled()) {
+        if (blob) ++trace->shader_cache_hits;
+        else ++trace->shader_cache_misses;
+    }
+    tj_present_work_trace_sync_finish(trace_start,
+        is_vs ? &trace->vs_compile_ticks : &trace->ps_compile_ticks,
+        is_vs ? &trace->vs_compile_calls : &trace->ps_compile_calls);
+    return hr;
+}
+
+/* ---- TJ_SHADER_PREFETCH=1: asynchronous first-sight shader compiles -------
+ * Default off: nothing below runs, no threads exist, every compile stays
+ * synchronous. When on, a small worker pool runs tj_shader_compile_cached
+ * for jobs submitted at draw-record time:
+ *   VS: vp_get_vs submits on a slot miss; consumers vp_vs_resolve() the slot.
+ *   PS: the exact final guest-FP HLSL is submitted at record time;
+ *       vp_fp_blob_get_or_compile claims and waits for it at replay.
+ * A job is identified by its exact source bytes + name + entry + target +
+ * flags, so equal requests coalesce. Workers touch only the job struct and
+ * the (thread-safe) compile helper; the queue/table are under one SRWLOCK.
+ * Results are exactly what the synchronous helper call would return. A
+ * waiter that finds its job still queued compiles it inline (same helper),
+ * so a wait is bounded by that one compile; there are no timeouts. */
+#define TJ_SHADER_PREFETCH_MAX_WORKERS 6
+#define TJ_SHADER_PREFETCH_TABLE 512   /* retained unclaimed/pending jobs */
+
+typedef struct TJShaderJob {
+    struct TJShaderJob* next;      /* work-queue link (lock) */
+    volatile LONG refs;
+    volatile LONG finished;        /* result published (before done is set) */
+    int queued;                    /* still in the work queue (lock) */
+    HANDLE done;                   /* manual-reset: result published */
+    u64 key, serial;
+    const char* name;              /* string literals owned by the callers */
+    const char* entry;
+    const char* target;
+    UINT flags1, flags2;
+    HRESULT hr;
+    ID3DBlob* blob;
+    ID3DBlob* error;
+    size_t source_len;
+    char source[];                 /* exact source, NUL-terminated copy */
+} TJShaderJob;
+
+typedef struct TJShaderPrefetch {
+    INIT_ONCE once;                /* zero = INIT_ONCE_STATIC_INIT */
+    SRWLOCK lock;                  /* zero = SRWLOCK_INIT; queue + table */
+    int enabled, vs_enabled, ps_enabled, workers;
+    HANDLE wake;                   /* counting semaphore, one per enqueue */
+    TJShaderJob* head;
+    TJShaderJob* tail;
+    TJShaderJob* table[TJ_SHADER_PREFETCH_TABLE];
+    u32 table_n;
+    u64 serial;
+} TJShaderPrefetch;
+static TJShaderPrefetch s_tj_prefetch;
+
+static u64 tj_shader_prefetch_hash(const char* src, size_t len)
+{
+    u64 hash = 14695981039346656037ULL;
+    for (size_t i = 0; i < len; ++i) {
+        hash ^= (u8)src[i];
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+/* Full-barrier read: a 1 means hr/blob/error are already published. */
+static int tj_shader_job_finished(TJShaderJob* job)
+{
+    return InterlockedCompareExchange(&job->finished, 1, 1) == 1;
+}
+
+static void tj_shader_job_release(TJShaderJob* job)
+{
+    if (!job || InterlockedDecrement(&job->refs) != 0) return;
+    if (job->blob) job->blob->lpVtbl->Release(job->blob);
+    if (job->error) job->error->lpVtbl->Release(job->error);
+    if (job->done) CloseHandle(job->done);
+    free(job);
+}
+
+/* Compile one job (worker, or a waiter that dequeued it) and publish. */
+static void tj_shader_job_run(TJShaderJob* job)
+{
+    ID3DBlob* blob = NULL;
+    ID3DBlob* error = NULL;
+    HRESULT hr = tj_shader_compile_cached(job->source, job->source_len, job->name,
+                                          job->entry, job->target, job->flags1,
+                                          job->flags2, &blob, &error, NULL);
+    job->hr = hr;
+    job->blob = blob;
+    job->error = error;
+    InterlockedExchange(&job->finished, 1);
+    SetEvent(job->done);
+}
+
+static DWORD WINAPI tj_shader_prefetch_worker(LPVOID arg)
+{
+    (void)arg;
+    s_tj_shader_prefetch_worker = 1;
+    for (;;) {
+        WaitForSingleObject(s_tj_prefetch.wake, INFINITE);
+        AcquireSRWLockExclusive(&s_tj_prefetch.lock);
+        TJShaderJob* job = s_tj_prefetch.head;
+        if (job) {
+            s_tj_prefetch.head = job->next;
+            if (!s_tj_prefetch.head) s_tj_prefetch.tail = NULL;
+            job->next = NULL;
+            job->queued = 0;
+        }
+        ReleaseSRWLockExclusive(&s_tj_prefetch.lock);
+        if (!job) continue;   /* taken inline by its waiter, or drained */
+        tj_shader_job_run(job);
+        tj_shader_job_release(job);   /* queue reference */
+    }
+}
+
+static int tj_shader_prefetch_env_set(const char* name)
+{
+    return getenv(name) != NULL;
+}
+
+static BOOL CALLBACK tj_shader_prefetch_init_once(PINIT_ONCE once, PVOID parameter,
+                                                  PVOID* context)
+{
+    TJShaderPrefetch* p = &s_tj_prefetch;
+    const char* value = getenv("TJ_SHADER_PREFETCH");
+    (void)once; (void)parameter; (void)context;
+    if (!value || strcmp(value, "1") != 0) return TRUE;
+    SYSTEM_INFO info;
+    GetSystemInfo(&info);
+    int want = (int)(info.dwNumberOfProcessors / 4u);
+    if (want < 1) want = 1;
+    if (want > TJ_SHADER_PREFETCH_MAX_WORKERS) want = TJ_SHADER_PREFETCH_MAX_WORKERS;
+    p->wake = CreateSemaphoreW(NULL, 0, 0x7FFFFFFF, NULL);
+    for (int i = 0; p->wake && i < want; ++i) {
+        HANDLE t = CreateThread(NULL, 0, tj_shader_prefetch_worker, NULL, 0, NULL);
+        if (!t) break;
+        SetThreadPriority(t, THREAD_PRIORITY_NORMAL);
+        CloseHandle(t);
+        ++p->workers;
+    }
+    if (!p->workers) {
+        fprintf(stderr, "[tj-shader-prefetch] disabled: no worker threads\n");
+        return TRUE;
+    }
+    /* Debug-only overrides that the record-time copy cannot reproduce
+     * byte-for-byte keep the synchronous path for that shader kind. */
+    p->vs_enabled = !tj_shader_prefetch_env_set("TJ_VP_DUMP_HASH");
+    p->ps_enabled = !(tj_shader_prefetch_env_set("FP_OFF") ||
+                      tj_shader_prefetch_env_set("FP_FORCE") ||
+                      tj_shader_prefetch_env_set("FP_ONE") ||
+                      tj_shader_prefetch_env_set("RTT_VIEWRT") ||
+                      tj_shader_prefetch_env_set("TJ_FP_PROBE_T0") ||
+                      tj_shader_prefetch_env_set("TJ_FP_PROBE_T1") ||
+                      tj_shader_prefetch_env_set("TJ_FP_PROBE_STAGEGRID") ||
+                      tj_shader_prefetch_env_set("TJ_FP_PROBE_LATEGRID") ||
+                      tj_shader_prefetch_env_set("TJ_TXP_ZEROQ_FP"));
+    p->enabled = 1;
+    fprintf(stderr, "[tj-shader-prefetch] enabled workers=%d\n", p->workers);
+    if (!p->vs_enabled || !p->ps_enabled)
+        fprintf(stderr, "[tj-shader-prefetch] debug env keeps synchronous: vs=%d ps=%d\n",
+                !p->vs_enabled, !p->ps_enabled);
+    return TRUE;
+}
+
+static TJShaderPrefetch* tj_shader_prefetch_state(void)
+{
+    InitOnceExecuteOnce(&s_tj_prefetch.once, tj_shader_prefetch_init_once, NULL, NULL);
+    return &s_tj_prefetch;
+}
+
+/* Caller holds the lock. */
+static int tj_shader_prefetch_find(const char* src, size_t len, u64 key,
+                                   const char* name, const char* entry,
+                                   const char* target, UINT flags1, UINT flags2)
+{
+    TJShaderPrefetch* p = &s_tj_prefetch;
+    for (u32 i = 0; i < p->table_n; ++i) {
+        const TJShaderJob* j = p->table[i];
+        if (j->key == key && j->source_len == len && j->flags1 == flags1 &&
+            j->flags2 == flags2 && strcmp(j->target, target) == 0 &&
+            strcmp(j->entry, entry) == 0 && strcmp(j->name, name) == 0 &&
+            memcmp(j->source, src, len) == 0)
+            return (int)i;
+    }
+    return -1;
+}
+
+/* Caller holds the lock; returns the table reference to the caller. */
+static TJShaderJob* tj_shader_prefetch_unlink(u32 i)
+{
+    TJShaderPrefetch* p = &s_tj_prefetch;
+    TJShaderJob* job = p->table[i];
+    p->table[i] = p->table[--p->table_n];
+    p->table[p->table_n] = NULL;
+    return job;
+}
+
+/* Returns a caller reference to a new or coalesced job, or NULL (prefetch
+ * off, table full of unfinished jobs, or allocation failure): the caller
+ * then keeps its synchronous path. */
+static TJShaderJob* tj_shader_prefetch_submit(const char* src, size_t len,
+                                              const char* name, const char* entry,
+                                              const char* target,
+                                              UINT flags1, UINT flags2)
+{
+    TJShaderPrefetch* p = tj_shader_prefetch_state();
+    TJShaderJob* evicted = NULL;
+    TJShaderJob* job = NULL;
+    if (!p->enabled || !src || !len) return NULL;
+    const u64 key = tj_shader_prefetch_hash(src, len);
+    AcquireSRWLockExclusive(&p->lock);
+    int at = tj_shader_prefetch_find(src, len, key, name, entry, target, flags1, flags2);
+    if (at >= 0) {
+        job = p->table[at];
+        InterlockedIncrement(&job->refs);
+        ReleaseSRWLockExclusive(&p->lock);
+        return job;
+    }
+    if (p->table_n >= TJ_SHADER_PREFETCH_TABLE) {
+        int oldest = -1;
+        for (u32 i = 0; i < p->table_n; ++i)
+            if (tj_shader_job_finished(p->table[i]) &&
+                (oldest < 0 || p->table[i]->serial < p->table[oldest]->serial))
+                oldest = (int)i;
+        if (oldest >= 0) evicted = tj_shader_prefetch_unlink((u32)oldest);
+    }
+    if (p->table_n < TJ_SHADER_PREFETCH_TABLE)
+        job = (TJShaderJob*)calloc(1, sizeof(TJShaderJob) + len + 1u);
+    if (job) {
+        job->done = CreateEventW(NULL, TRUE, FALSE, NULL);
+        if (!job->done) {
+            free(job);
+            job = NULL;
+        }
+    }
+    if (job) {
+        memcpy(job->source, src, len);
+        job->source[len] = '\0';
+        job->source_len = len;
+        job->key = key;
+        job->serial = ++p->serial;
+        job->name = name;
+        job->entry = entry;
+        job->target = target;
+        job->flags1 = flags1;
+        job->flags2 = flags2;
+        job->refs = 3;                 /* table + queue + caller */
+        job->queued = 1;
+        p->table[p->table_n++] = job;
+        if (p->tail) p->tail->next = job;
+        else p->head = job;
+        p->tail = job;
+    }
+    ReleaseSRWLockExclusive(&p->lock);
+    tj_shader_job_release(evicted);
+    if (!job) return NULL;
+    ReleaseSemaphore(p->wake, 1, NULL);
+    {
+        TJPresentWorkTrace* trace = &s_tj_present_work_trace;
+        if (tj_present_work_trace_enabled() && trace->active &&
+            tj_present_interval_trace_enabled())
+            ++trace->prefetch_jobs;
+    }
+    return job;
+}
+
+/* Remove the exact-identity job from the table (caller gets the table
+ * reference), or NULL when none was prefetched. */
+static TJShaderJob* tj_shader_prefetch_claim(const char* src, size_t len,
+                                             const char* name, const char* entry,
+                                             const char* target,
+                                             UINT flags1, UINT flags2)
+{
+    TJShaderPrefetch* p = tj_shader_prefetch_state();
+    TJShaderJob* job = NULL;
+    if (!p->enabled || !src || !len) return NULL;
+    const u64 key = tj_shader_prefetch_hash(src, len);
+    AcquireSRWLockExclusive(&p->lock);
+    int at = tj_shader_prefetch_find(src, len, key, name, entry, target, flags1, flags2);
+    if (at >= 0) job = tj_shader_prefetch_unlink((u32)at);
+    ReleaseSRWLockExclusive(&p->lock);
+    return job;
+}
+
+/* Drop this job from the table if it is still there (no-op otherwise). */
+static void tj_shader_prefetch_forget(TJShaderJob* job)
+{
+    TJShaderPrefetch* p = &s_tj_prefetch;
+    TJShaderJob* unlinked = NULL;
+    AcquireSRWLockExclusive(&p->lock);
+    for (u32 i = 0; i < p->table_n; ++i)
+        if (p->table[i] == job) {
+            unlinked = tj_shader_prefetch_unlink(i);
+            break;
+        }
+    ReleaseSRWLockExclusive(&p->lock);
+    tj_shader_job_release(unlinked);
+}
+
+/* Block until the job's result exists and return it exactly as
+ * tj_shader_compile_cached would have: new references in out_blob/out_err.
+ * A job no worker has started yet is dequeued and compiled right here. */
+static HRESULT tj_shader_prefetch_take(TJShaderJob* job, ID3DBlob** out_blob,
+                                       ID3DBlob** out_err)
+{
+    TJShaderPrefetch* p = &s_tj_prefetch;
+    int run_here = 0;
+    if (out_blob) *out_blob = NULL;
+    if (out_err) *out_err = NULL;
+    if (!tj_shader_job_finished(job)) {
+        AcquireSRWLockExclusive(&p->lock);
+        if (job->queued) {
+            TJShaderJob* prev = NULL;
+            for (TJShaderJob* q = p->head; q; prev = q, q = q->next)
+                if (q == job) {
+                    if (prev) prev->next = q->next;
+                    else p->head = q->next;
+                    if (p->tail == q) p->tail = prev;
+                    q->next = NULL;
+                    break;
+                }
+            job->queued = 0;
+            run_here = 1;
+        }
+        ReleaseSRWLockExclusive(&p->lock);
+    }
+    if (run_here) {
+        tj_shader_job_run(job);
+        tj_shader_job_release(job);   /* the queue reference it carried */
+    } else if (!tj_shader_job_finished(job)) {
+        TJPresentWorkTrace* trace = &s_tj_present_work_trace;
+        LONGLONG start = tj_present_work_trace_sync_begin();
+        WaitForSingleObject(job->done, INFINITE);
+        tj_present_work_trace_sync_finish(start, &trace->prefetch_wait_ticks,
+                                          &trace->prefetch_wait_calls);
+    }
+    if (job->blob && out_blob) {
+        job->blob->lpVtbl->AddRef(job->blob);
+        *out_blob = job->blob;
+    }
+    if (job->error && out_err) {
+        job->error->lpVtbl->AddRef(job->error);
+        *out_err = job->error;
+    }
+    return job->hr;
+}
+
+/* Decompile the captured RSX vertex program to HLSL and build the VP PSO
+ * (decompiled VS + atlas alpha-test PS). One-shot per program. */
+static void compile_vp(void)
+{
+    extern int rsx_vp_decompile_entry_tex(
+        const uint8_t*, u32, u32, u32, char*, u32);
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!st || st->vp_ucode_bytes < 16 || !s_d3d.vp_root_sig) return;
+    u32 compile_key = vp_static_compile_key(st);
+    s_d3d.vp_compiled_key = compile_key;
+
+    static char hlsl[768 * 1024];
+    int ni = rsx_vp_decompile_entry_tex(st->vp_ucode, st->vp_ucode_bytes,
+                                        st->transform_program_start,
+                                        vp_texture_dimension_key(st),
+                                        hlsl, sizeof hlsl);
+    /* Does this VP read vp_c[0..3]? Gates the garbage-projection fallback:
+     * programs keeping their MVP elsewhere (gcm/cube: c[256..259]) must not
+     * have c[0..3] stomped nor the viewport z-lane overridden. */
+    s_d3d.vp_uses_c03 = (strstr(hlsl, "vp_c[0]") || strstr(hlsl, "vp_c[1]") ||
+                         strstr(hlsl, "vp_c[2]") || strstr(hlsl, "vp_c[3]")) ? 1 : 0;
+    if (ni <= 0) { printf("[VP] decompile failed (%d)\n", ni); return; }
+    if (getenv("VP_DUMP")) {
+        FILE* vf = fopen("vp_dump.hlsl", "w");
+        if (vf) { fwrite(hlsl, 1, strlen(hlsl), vf); fclose(vf);
+                  printf("[VP] dumped vp_dump.hlsl (%d instrs)\n", ni); }
+        printf("[VPRAW] first 3 instrs (%u ucode bytes):\n", st->vp_ucode_bytes);
+        for (u32 _q = 0; _q < 48 && _q < st->vp_ucode_bytes; _q += 16)
+            printf("[VPRAW]  d0=%02X%02X%02X%02X d1=%02X%02X%02X%02X d2=%02X%02X%02X%02X d3=%02X%02X%02X%02X\n",
+                st->vp_ucode[_q+0],st->vp_ucode[_q+1],st->vp_ucode[_q+2],st->vp_ucode[_q+3],
+                st->vp_ucode[_q+4],st->vp_ucode[_q+5],st->vp_ucode[_q+6],st->vp_ucode[_q+7],
+                st->vp_ucode[_q+8],st->vp_ucode[_q+9],st->vp_ucode[_q+10],st->vp_ucode[_q+11],
+                st->vp_ucode[_q+12],st->vp_ucode[_q+13],st->vp_ucode[_q+14],st->vp_ucode[_q+15]);
+    }
+
+    /* Pixel shader mirrors dbgfont's FP: sample the atlas coverage at TEXCOORD0
+     * (VP output o[7]), alpha-test at 0.5, output the vertex color (o[1]). */
+#define VP_STATIC_PSIN \
+        "struct PSIn{ float4 pos:SV_Position; float4 col0:COLOR0; float4 col1:COLOR1;\n" \
+        "  float4 bcol0:COLOR2; float4 bcol1:COLOR3; float4 fog:FOG;\n" \
+        "  float4 t0:TEXCOORD0; float4 t1:TEXCOORD1; float4 t2:TEXCOORD2; float4 t3:TEXCOORD3;\n" \
+        "  float4 t4:TEXCOORD4; float4 t5:TEXCOORD5; float4 t6:TEXCOORD6; float4 t7:TEXCOORD7;\n" \
+        "  float4 t8:TEXCOORD8; float4 t9:TEXCOORD9; bool front_face:SV_IsFrontFace; };\n"
+    static const char ps[] =
+        "Texture2D tex : register(t0); SamplerState smp : register(s0);\n"
+        VP_STATIC_PSIN
+        "float4 main(PSIn i):SV_TARGET{ float cov = tex.Sample(smp, i.t0.xy).r;\n"
+        "  if (cov <= 0.5) discard; return float4(i.col0.rgb, 1); }\n";
+
+    ID3DBlob *vb=NULL,*pb=NULL,*e=NULL;
+    HRESULT hr = tj_shader_compile_cached(hlsl, strlen(hlsl), "vp", "main", "vs_5_0", 0, 0, &vb, &e, NULL);
+    if (FAILED(hr)) { printf("[VP] VS compile FAIL: %s\n", e?(const char*)e->lpVtbl->GetBufferPointer(e):"?"); if(e)e->lpVtbl->Release(e); return; }
+    hr = D3DCompile(ps, sizeof(ps)-1, "vpps", NULL, NULL, "main", "ps_5_0", 0, 0, &pb, &e);
+    if (FAILED(hr)) { printf("[VP] PS compile FAIL: %s\n", e?(const char*)e->lpVtbl->GetBufferPointer(e):"?"); if(e)e->lpVtbl->Release(e); if(vb)vb->lpVtbl->Release(vb); return; }
+
+    /* The decompiled VS declares inputs a0:ATTR0 .. a15:ATTR15 and the HLSL
+     * compiler keeps whichever the program body reads. D3D12 requires EVERY VS
+     * input to have a matching input-layout element (by semantic name+index),
+     * so declare all 16 ATTR slots. (The old single "POSITION" element matched
+     * NO VS input once the decompiler switched to ATTR semantics -> PSO failed
+     * with E_INVALIDARG for every VP, blanking cellmark's text and vkcube.)
+     * The VP path uploads only attrib0 to vp_vb (one float4/vertex), so every
+     * slot reads that same float4 at offset 0; attributes other than position
+     * therefore alias attrib0 for now (colours/uv wrong until the VP path
+     * uploads multiple attributes), but geometry is correct and the PSO is
+     * valid. */
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    for (int _e = 0; _e < 16; _e++) {
+        il[_e].SemanticName = "ATTR";
+        il[_e].SemanticIndex = _e;
+        il[_e].Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+        il[_e].InputSlot = 0;
+        /* 256-byte generic VP vertex: every ATTRi is a float4 slot at i*16
+         * (read_vp_vertex converts each enabled RSX attrib by type; disabled
+         * slots use the matching RSX constant/current attribute). Covers tiny3d (a0/a3/a8), SDK gcm samples
+         * (a0/a1/a2), dbgfont -- no aliasing. */
+        il[_e].AlignedByteOffset = (UINT)(_e * 16);
+        il[_e].InputSlotClass = D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA;
+        il[_e].InstanceDataStepRate = 0;
+    }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = s_d3d.vp_root_sig;
+    pd.VS.pShaderBytecode = vb->lpVtbl->GetBufferPointer(vb); pd.VS.BytecodeLength = vb->lpVtbl->GetBufferSize(vb);
+    pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb); pd.PS.BytecodeLength = pb->lpVtbl->GetBufferSize(pb);
+    pd.InputLayout.pInputElementDescs = il; pd.InputLayout.NumElements = 16;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1; pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    /* Depth test ON (LESS_EQUAL, matching the guest's rsxtiny_DepthTestFunc 515 /
+     * CELL_GCM_LEQUAL). Without it the cube's faces drew in submission order and
+     * back faces overwrote the front -> you saw through the near face to the
+     * darker interior. The depth buffer is bound + cleared to 1.0 each frame. */
+    pd.DepthStencilState.DepthEnable = TRUE;
+    pd.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+    pd.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_LESS_EQUAL;
+    pd.DepthStencilState.StencilEnable = FALSE;
+    pd.SampleDesc.Count = 1;
+    hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_d3d.pipeline_state_vp);
+    if (SUCCEEDED(hr)) {
+        HRESULT class_hr;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE;
+        class_hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+            s_d3d.device, &pd, &IID_ID3D12PipelineState,
+            (void**)&s_d3d.pipeline_state_vp_lines);
+        if (FAILED(class_hr))
+            printf("[VP] atlas LINE PSO FAIL (0x%08lX)\n", class_hr);
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_POINT;
+        class_hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+            s_d3d.device, &pd, &IID_ID3D12PipelineState,
+            (void**)&s_d3d.pipeline_state_vp_points);
+        if (FAILED(class_hr))
+            printf("[VP] atlas POINT PSO FAIL (0x%08lX)\n", class_hr);
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    }
+    pd.DSVFormat = DXGI_FORMAT_D16_UNORM;
+    HRESULT d16_hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+        s_d3d.device, &pd, &IID_ID3D12PipelineState,
+        (void**)&s_d3d.pipeline_state_vp_d16);
+    if (SUCCEEDED(d16_hr)) {
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE;
+        s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+            s_d3d.device, &pd, &IID_ID3D12PipelineState,
+            (void**)&s_d3d.pipeline_state_vp_d16_lines);
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_POINT;
+        s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+            s_d3d.device, &pd, &IID_ID3D12PipelineState,
+            (void**)&s_d3d.pipeline_state_vp_d16_points);
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    }
+    pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+
+    /* Second PSO: same VS but a COLOUR-only PS (no texture sample, no alpha
+     * discard) for untextured 3D geometry (vkcube's cube). The atlas PS above
+     * samples a texture and discards where coverage<=0.5, which blanks any draw
+     * with no atlas bound. */
+    {
+        static const char ps_col[] =
+            VP_STATIC_PSIN
+            "float4 main(PSIn i):SV_TARGET{ return float4(i.col0.rgb, 1); }\n";
+#undef VP_STATIC_PSIN
+        ID3DBlob *pcb=NULL,*ec=NULL;
+        if (SUCCEEDED(D3DCompile(ps_col, sizeof(ps_col)-1, "vppsc", NULL, NULL,
+                                 "main", "ps_5_0", 0, 0, &pcb, &ec)) && pcb) {
+            pd.PS.pShaderBytecode = pcb->lpVtbl->GetBufferPointer(pcb);
+            pd.PS.BytecodeLength  = pcb->lpVtbl->GetBufferSize(pcb);
+            HRESULT hr2 = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                s_d3d.device, &pd, &IID_ID3D12PipelineState,
+                (void**)&s_d3d.pipeline_state_vp_color);
+            printf(SUCCEEDED(hr2) ? "[VP] colour pipeline ready\n"
+                                  : "[VP] colour PSO FAIL (0x%08lX)\n", hr2);
+            if (SUCCEEDED(hr2)) {
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE;
+                HRESULT line_hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                    s_d3d.device, &pd, &IID_ID3D12PipelineState,
+                    (void**)&s_d3d.pipeline_state_vp_color_lines);
+                if (FAILED(line_hr))
+                    printf("[VP] colour LINE PSO FAIL (0x%08lX)\n", line_hr);
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_POINT;
+                HRESULT point_hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                    s_d3d.device, &pd, &IID_ID3D12PipelineState,
+                    (void**)&s_d3d.pipeline_state_vp_color_points);
+                if (FAILED(point_hr))
+                    printf("[VP] colour POINT PSO FAIL (0x%08lX)\n", point_hr);
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+            }
+            pd.DSVFormat = DXGI_FORMAT_D16_UNORM;
+            HRESULT color_d16_hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                s_d3d.device, &pd, &IID_ID3D12PipelineState,
+                (void**)&s_d3d.pipeline_state_vp_color_d16);
+            if (SUCCEEDED(color_d16_hr)) {
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE;
+                s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                    s_d3d.device, &pd, &IID_ID3D12PipelineState,
+                    (void**)&s_d3d.pipeline_state_vp_color_d16_lines);
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_POINT;
+                s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                    s_d3d.device, &pd, &IID_ID3D12PipelineState,
+                    (void**)&s_d3d.pipeline_state_vp_color_d16_points);
+                pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+            }
+            pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+            pcb->lpVtbl->Release(pcb);
+        }
+        if (ec) ec->lpVtbl->Release(ec);
+    }
+    /* Keep the VS bytecode for guest-FP PSO builds (vp_get_fp_pso); bump the
+     * generation so cached FP PSOs built against the old VS are rebuilt. */
+    if (s_d3d.vp_vs_blob) s_d3d.vp_vs_blob->lpVtbl->Release(s_d3d.vp_vs_blob);
+    s_d3d.vp_vs_blob = vb;
+    s_d3d.vp_gen++;
+    pb->lpVtbl->Release(pb);
+    if (SUCCEEDED(hr)) {
+        s_d3d.vp_ready = 1;
+        printf("[VP] pipeline ready (%d instrs)\n", ni);
+    }
+    else {
+        printf("[VP] PSO creation FAIL (0x%08lX)\n", hr);
+        /* Drain the debug layer's message queue to get the EXACT validation
+         * reason (E_INVALIDARG is otherwise opaque). One-shot. */
+        ID3D12InfoQueue* iq = NULL;
+        if (SUCCEEDED(s_d3d.device->lpVtbl->QueryInterface(
+                s_d3d.device, &IID_ID3D12InfoQueue, (void**)&iq)) && iq) {
+            UINT64 n = iq->lpVtbl->GetNumStoredMessages(iq);
+            for (UINT64 mi = 0; mi < n; mi++) {
+                SIZE_T len = 0;
+                iq->lpVtbl->GetMessage(iq, mi, NULL, &len);
+                D3D12_MESSAGE* m = (D3D12_MESSAGE*)malloc(len);
+                if (m && SUCCEEDED(iq->lpVtbl->GetMessage(iq, mi, m, &len)))
+                    printf("[VP][DBG] %s\n", m->pDescription);
+                free(m);
+            }
+            iq->lpVtbl->Release(iq);
+        }
+    }
+}
