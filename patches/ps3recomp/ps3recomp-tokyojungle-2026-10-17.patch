+        snprintf(note, note_size, "reason=no_swap_chain");
+        return 0;
+    }
+    if (!QueryPerformanceFrequency(&frequency) || frequency.QuadPart < 1000) {
+        snprintf(note, note_size, "reason=no_qpc");
+        return 0;
+    }
+    IDXGIOutput* output = NULL;
+    HRESULT hr = s_d3d.swap_chain->lpVtbl->GetContainingOutput(s_d3d.swap_chain, &output);
+    if (FAILED(hr) || !output) {
+        snprintf(note, note_size, "reason=no_output hr=0x%08lX", (unsigned long)hr);
+        return 0;
+    }
+    WCHAR device[32];
+    HMONITOR monitor = NULL;
