+/* ---------------------------------------------------------------------------
+ * BC3 codec
+ * -----------------------------------------------------------------------*/
+static void tpa_565_expand(uint16_t c, int out[3])
+{
+    int r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
+    out[0] = (r << 3) | (r >> 2);
+    out[1] = (g << 2) | (g >> 4);
+    out[2] = (b << 3) | (b >> 2);
+}
+
+static void tpa_color_palette(uint16_t c0, uint16_t c1, int pal[4][3])
+{
+    tpa_565_expand(c0, pal[0]);
+    tpa_565_expand(c1, pal[1]);
+    for (int k = 0; k < 3; k++) {          /* BC3 colour is always 4-colour */
+        pal[2][k] = (2 * pal[0][k] + pal[1][k]) / 3;
+        pal[3][k] = (pal[0][k] + 2 * pal[1][k]) / 3;
+    }
+}
+
+static void tpa_alpha_palette(int a0, int a1, int pal[8])
+{
+    pal[0] = a0; pal[1] = a1;
+    if (a0 > a1) {
+        for (int i = 1; i < 7; i++) pal[i + 1] = ((7 - i) * a0 + i * a1) / 7;
+    } else {
+        for (int i = 1; i < 5; i++) pal[i + 1] = ((5 - i) * a0 + i * a1) / 5;
+        pal[6] = 0; pal[7] = 255;
+    }
+}
+
+void tj_bc3_decode_block(const uint8_t src[16], uint8_t rgba[64])
+{
+    int ap[8];
+    tpa_alpha_palette(src[0], src[1], ap);
+    uint64_t abits = 0;
+    for (int i = 0; i < 6; i++) abits |= (uint64_t)src[2 + i] << (8 * i);
+    int cp[4][3];
+    uint16_t c0 = (uint16_t)(src[8] | (src[9] << 8)), c1 = (uint16_t)(src[10] | (src[11] << 8));
+    tpa_color_palette(c0, c1, cp);
+    uint32_t cbits = (uint32_t)src[12] | ((uint32_t)src[13] << 8) |
+                     ((uint32_t)src[14] << 16) | ((uint32_t)src[15] << 24);
+    for (int i = 0; i < 16; i++) {
+        const int* c = cp[(cbits >> (2 * i)) & 3u];
+        rgba[4 * i + 0] = (uint8_t)c[0];
+        rgba[4 * i + 1] = (uint8_t)c[1];
+        rgba[4 * i + 2] = (uint8_t)c[2];
+        rgba[4 * i + 3] = (uint8_t)ap[(abits >> (3 * i)) & 7u];
+    }
+}
+
+/* -- alpha -- */
+static int tpa_alpha_eval(const uint8_t a[16], int a0, int a1, uint64_t* bits)
+{
+    int pal[8], err = 0;
+    uint64_t b = 0;
+    tpa_alpha_palette(a0, a1, pal);
+    for (int i = 0; i < 16; i++) {
+        int best = 0, bd = 1 << 30;
+        for (int k = 0; k < 8; k++) {
+            int d = (int)a[i] - pal[k];
+            d *= d;
+            if (d < bd) { bd = d; best = k; }
+        }
+        err += bd;
+        b |= (uint64_t)best << (3 * i);
+    }
+    *bits = b;
+    return err;
+}
+
+static void tpa_encode_alpha(const uint8_t a[16], uint8_t dst[8], int quality)
+{
+    int mn = 255, mx = 0, lo = 255, hi = 0;
+    for (int i = 0; i < 16; i++) {
+        if (a[i] < mn) mn = a[i];
+        if (a[i] > mx) mx = a[i];
+        if (a[i] != 0 && a[i] != 255) {
+            if (a[i] < lo) lo = a[i];
+            if (a[i] > hi) hi = a[i];
+        }
+    }
+    int best_a0 = mn, best_a1 = mn, best_err = 1 << 30;
+    uint64_t best_bits = 0, bits;
+    if (mn == mx) {                          /* a0 == a1: index 0 everywhere */
+        best_err = 0; best_bits = 0;
+    } else {
+        /* 8-level, a0 > a1 */
+        int r = quality > 0 ? 3 : 0;
+        for (int d0 = 0; d0 <= r; d0++)
+            for (int d1 = 0; d1 <= r; d1++) {
+                int a0 = mx - d0, a1 = mn + d1;
+                if (a0 <= a1) continue;
+                int e = tpa_alpha_eval(a, a0, a1, &bits);
+                if (e < best_err) { best_err = e; best_a0 = a0; best_a1 = a1; best_bits = bits; }
+            }
+        /* 6-level with explicit 0 and 255, a0 <= a1 */
+        if (lo > hi) { lo = 0; hi = 0; }
+        int e = tpa_alpha_eval(a, lo, hi, &bits);
+        if (e < best_err) { best_err = e; best_a0 = lo; best_a1 = hi; best_bits = bits; }
+    }
+    dst[0] = (uint8_t)best_a0;
+    dst[1] = (uint8_t)best_a1;
+    for (int i = 0; i < 6; i++) dst[2 + i] = (uint8_t)(best_bits >> (8 * i));
+}
+
+/* -- colour -- */
+typedef struct TpaColorIn {
+    float p[16][3];
+    float w[16];
+} TpaColorIn;
+
+static uint16_t tpa_pack565(const float c[3])
+{
+    int r = (int)lroundf(c[0] * 31.f / 255.f);
+    int g = (int)lroundf(c[1] * 63.f / 255.f);
+    int b = (int)lroundf(c[2] * 31.f / 255.f);
+    r = r < 0 ? 0 : (r > 31 ? 31 : r);
+    g = g < 0 ? 0 : (g > 63 ? 63 : g);
+    b = b < 0 ? 0 : (b > 31 ? 31 : b);
+    return (uint16_t)((r << 11) | (g << 5) | b);
+}
+
+static float tpa_color_eval(const TpaColorIn* in, uint16_t c0, uint16_t c1, uint32_t* idx)
+{
+    int pal[4][3];
+    tpa_color_palette(c0, c1, pal);
+    float err = 0.f;
+    uint32_t bits = 0;
+    for (int i = 0; i < 16; i++) {
+        int best = 0;
+        float bd = 1e30f;
+        for (int k = 0; k < 4; k++) {
+            float dr = in->p[i][0] - (float)pal[k][0];
+            float dg = in->p[i][1] - (float)pal[k][1];
+            float db = in->p[i][2] - (float)pal[k][2];
+            float d = dr * dr + dg * dg + db * db;
+            if (d < bd) { bd = d; best = k; }
+        }
+        err += in->w[i] * bd;
+        bits |= (uint32_t)best << (2 * i);
+    }
+    *idx = bits;
+    return err;
+}
+
+/* Least-squares endpoints for fixed indices. Returns 0 when singular. */
+static int tpa_color_refit(const TpaColorIn* in, uint32_t idx, float e0[3], float e1[3])
+{
+    static const float wa[4] = {1.f, 0.f, 2.f / 3.f, 1.f / 3.f};
+    float aa = 0, ab = 0, bb = 0, ap[3] = {0, 0, 0}, bp[3] = {0, 0, 0};
+    for (int i = 0; i < 16; i++) {
+        float a = wa[(idx >> (2 * i)) & 3u], b = 1.f - a, w = in->w[i];
+        aa += w * a * a; ab += w * a * b; bb += w * b * b;
+        for (int k = 0; k < 3; k++) { ap[k] += w * a * in->p[i][k]; bp[k] += w * b * in->p[i][k]; }
+    }
+    float det = aa * bb - ab * ab;
+    if (fabsf(det) < 1e-6f) return 0;
+    float inv = 1.f / det;
+    for (int k = 0; k < 3; k++) {
+        e0[k] = (ap[k] * bb - bp[k] * ab) * inv;
+        e1[k] = (bp[k] * aa - ap[k] * ab) * inv;
+        e0[k] = e0[k] < 0.f ? 0.f : (e0[k] > 255.f ? 255.f : e0[k]);
+        e1[k] = e1[k] < 0.f ? 0.f : (e1[k] > 255.f ? 255.f : e1[k]);
+    }
+    return 1;
+}
+
+static uint16_t tpa_565_add(uint16_t c, int ch, int d)
+{
+    int v[3] = {(c >> 11) & 31, (c >> 5) & 63, c & 31};
+    const int lim[3] = {31, 63, 31};
+    v[ch] += d;
+    if (v[ch] < 0 || v[ch] > lim[ch]) return c;
+    return (uint16_t)((v[0] << 11) | (v[1] << 5) | v[2]);
+}
+
+static void tpa_encode_color(const TpaColorIn* in, uint8_t dst[8], int quality)
+{
+    float wsum = 0.f, mean[3] = {0, 0, 0};
+    for (int i = 0; i < 16; i++) {
+        wsum += in->w[i];
+        for (int k = 0; k < 3; k++) mean[k] += in->w[i] * in->p[i][k];
+    }
+    for (int k = 0; k < 3; k++) mean[k] /= wsum;
+    float cov[6] = {0, 0, 0, 0, 0, 0};    /* rr rg rb gg gb bb */
+    for (int i = 0; i < 16; i++) {
+        float d[3] = {in->p[i][0] - mean[0], in->p[i][1] - mean[1], in->p[i][2] - mean[2]};
+        float w = in->w[i];
+        cov[0] += w * d[0] * d[0]; cov[1] += w * d[0] * d[1]; cov[2] += w * d[0] * d[2];
+        cov[3] += w * d[1] * d[1]; cov[4] += w * d[1] * d[2]; cov[5] += w * d[2] * d[2];
+    }
+    float v[3] = {1.f, 1.f, 1.f};
+    for (int it = 0; it < 8; it++) {
+        float n[3] = {cov[0] * v[0] + cov[1] * v[1] + cov[2] * v[2],
+                      cov[1] * v[0] + cov[3] * v[1] + cov[4] * v[2],
+                      cov[2] * v[0] + cov[4] * v[1] + cov[5] * v[2]};
+        float len = sqrtf(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
+        if (len < 1e-6f) break;
+        v[0] = n[0] / len; v[1] = n[1] / len; v[2] = n[2] / len;
+    }
+    /* Extent along the axis over the texels that will be visible. */
+    float tmin = 1e30f, tmax = -1e30f;
+    for (int pass = 0; pass < 2 && tmin > tmax; pass++)
+        for (int i = 0; i < 16; i++) {
+            if (pass == 0 && in->w[i] < 0.25f) continue;
+            float t = (in->p[i][0] - mean[0]) * v[0] + (in->p[i][1] - mean[1]) * v[1] +
+                      (in->p[i][2] - mean[2]) * v[2];
+            if (t < tmin) tmin = t;
+            if (t > tmax) tmax = t;
+        }
+    float inset = (tmax - tmin) / 16.f;
+    float e0[3], e1[3];
+    for (int k = 0; k < 3; k++) {
+        e0[k] = mean[k] + (tmax - inset) * v[k];
+        e1[k] = mean[k] + (tmin + inset) * v[k];
+        e0[k] = e0[k] < 0.f ? 0.f : (e0[k] > 255.f ? 255.f : e0[k]);
+        e1[k] = e1[k] < 0.f ? 0.f : (e1[k] > 255.f ? 255.f : e1[k]);
+    }
+    uint16_t c0 = tpa_pack565(e0), c1 = tpa_pack565(e1);
+    uint32_t idx, bidx;
+    float best = tpa_color_eval(in, c0, c1, &bidx);
+    for (int it = 0; it < 2; it++) {
+        if (!tpa_color_refit(in, bidx, e0, e1)) break;
+        uint16_t n0 = tpa_pack565(e0), n1 = tpa_pack565(e1);
+        float e = tpa_color_eval(in, n0, n1, &idx);
+        if (e < best) { best = e; c0 = n0; c1 = n1; bidx = idx; } else break;
+    }
+    if (quality > 0) {
+        for (int pass = 0; pass < 8; pass++) {
+            int improved = 0;
+            for (int ch = 0; ch < 6; ch++)
+                for (int d = -1; d <= 1; d += 2) {
+                    uint16_t n0 = ch < 3 ? tpa_565_add(c0, ch, d) : c0;
+                    uint16_t n1 = ch < 3 ? c1 : tpa_565_add(c1, ch - 3, d);
+                    float e = tpa_color_eval(in, n0, n1, &idx);
+                    if (e < best) { best = e; c0 = n0; c1 = n1; bidx = idx; improved = 1; }
+                }
+            if (!improved) break;
+        }
+    }
+    /* Canonical order: c0 > c1 (4-colour under every decoder) or c0 == c1. */
+    if (c0 < c1) {
+        uint16_t t = c0; c0 = c1; c1 = t;
+        bidx ^= 0x55555555u;                 /* 0<->1, 2<->3 */
+    } else if (c0 == c1) {
+        bidx = 0;
+    }
+    dst[0] = (uint8_t)c0; dst[1] = (uint8_t)(c0 >> 8);
+    dst[2] = (uint8_t)c1; dst[3] = (uint8_t)(c1 >> 8);
+    dst[4] = (uint8_t)bidx; dst[5] = (uint8_t)(bidx >> 8);
+    dst[6] = (uint8_t)(bidx >> 16); dst[7] = (uint8_t)(bidx >> 24);
+}
+
+void tj_bc3_encode_block(const uint8_t rgba[64], uint8_t dst[16], int quality)
+{
+    uint8_t a[16];
+    TpaColorIn in;
+    for (int i = 0; i < 16; i++) {
+        a[i] = rgba[4 * i + 3];
+        for (int k = 0; k < 3; k++) in.p[i][k] = (float)rgba[4 * i + k];
+        /* Hidden texels still count a little: bilinear filtering samples them. */
+        in.w[i] = 0.06f + 0.94f * (float)a[i] / 255.f;
+    }
+    tpa_encode_alpha(a, dst, quality);
+    tpa_encode_color(&in, dst + 8, quality);
+}
+
+/* ---------------------------------------------------------------------------
+ * Patcher
+ * -----------------------------------------------------------------------*/
+static double tpa_now_ms(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER f, t;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t);
+    return (double)t.QuadPart * 1000.0 / (double)f.QuadPart;
+#else
+    return 0.0;
+#endif
+}
+
+int tj_prompt_atlas_patch(const TjPromptAtlas* atlas, uint8_t* bc3, size_t bytes,
+                          uint32_t pitch, const PadPromptLabels* labels, int quality,
+                          uint8_t* intended, uint8_t* touched, TjPromptPatchInfo* info)
+{
+    if (info) memset(info, 0, sizeof(*info));
+    if (!atlas || !bc3 || !labels || (atlas->w & 3u) || (atlas->h & 3u)) return -1;
+    const uint32_t bw = atlas->w / 4u, bh = atlas->h / 4u;
+    if (pitch != bw * 16u || bytes != (size_t)pitch * bh || bytes != atlas->bytes) return -1;
+    char err[128];
+    if (tj_prompt_atlas_validate(atlas, err, sizeof(err)) != 0) return -1;
+
+    int rc = 0;
+    double t0 = tpa_now_ms();
+    uint8_t** art = (uint8_t**)calloc(atlas->cell_count, sizeof(uint8_t*));
+    uint8_t* tb = touched ? touched : (uint8_t*)malloc((size_t)bw * bh);
+    if (!art || !tb) { rc = -3; goto done; }
+    memset(tb, 0, (size_t)bw * bh);
+
+    for (uint32_t i = 0; i < atlas->cell_count; i++) {
+        const TjPromptCell* c = &atlas->cells[i];
+        int aw = c->ax1 - c->ax0, ah = c->ay1 - c->ay0;
+        art[i] = (uint8_t*)malloc((size_t)aw * (size_t)ah * 4u);
+        if (!art[i]) { rc = -3; goto done; }
+        PadPromptArtSpec spec;
+        spec.style = (PadPromptStyle)c->style;
+        spec.button = c->button;
+        spec.lit = c->lit;
+        spec.caption = c->caption;
+        if (pad_prompt_art_render(&spec, labels, aw, ah, art[i]) != 0) { rc = -2; goto done; }
+        for (int by = c->cy0 / 4; by <= (c->cy1 - 1) / 4; by++)
+            for (int bx = c->cx0 / 4; bx <= (c->cx1 - 1) / 4; bx++)
+                tb[(size_t)by * bw + (size_t)bx] = 1;
+    }
+    double t1 = tpa_now_ms();
+
+    uint32_t blocks = 0;
+    for (uint32_t by = 0; by < bh; by++)
+        for (uint32_t bx = 0; bx < bw; bx++) {
+            if (!tb[(size_t)by * bw + bx]) continue;
+            uint8_t* blk = bc3 + (size_t)by * pitch + (size_t)bx * 16u;
+            uint8_t px[64];
+            tj_bc3_decode_block(blk, px);
+            for (int t = 0; t < 16; t++) {
+                int X = (int)bx * 4 + (t & 3), Y = (int)by * 4 + (t >> 2);
+                for (uint32_t i = 0; i < atlas->cell_count; i++) {
+                    const TjPromptCell* c = &atlas->cells[i];
+                    if (X < c->cx0 || X >= c->cx1 || Y < c->cy0 || Y >= c->cy1) continue;
+                    uint8_t* d = px + 4 * t;
+                    if (X >= c->ax0 && X < c->ax1 && Y >= c->ay0 && Y < c->ay1) {
+                        const uint8_t* s = art[i] + 4u * ((size_t)(Y - c->ay0) * (size_t)(c->ax1 - c->ax0) +
+                                                          (size_t)(X - c->ax0));
+                        memcpy(d, s, 4);
+                    } else {
+                        d[0] = TPA_CLEAR_R; d[1] = TPA_CLEAR_G; d[2] = TPA_CLEAR_B; d[3] = 0;
+                    }
+                    break;
+                }
+            }
+            if (intended)
+                for (int r = 0; r < 4; r++)
+                    memcpy(intended + 4u * ((size_t)(by * 4u + (uint32_t)r) * atlas->w + bx * 4u),
+                           px + 16 * r, 16);
+            tj_bc3_encode_block(px, blk, quality);
+            blocks++;
+        }
+    double t2 = tpa_now_ms();
+    if (info) {
+        info->cells = atlas->cell_count;
+        info->blocks = blocks;
+        info->ms_art = t1 - t0;
+        info->ms_encode = t2 - t1;
+    }
+
+done:
+    if (art)
+        for (uint32_t i = 0; i < atlas->cell_count; i++) free(art[i]);
+    free(art);
+    if (tb && tb != touched) free(tb);
+    return rc;
+}
+
+#else  /* !PS3RECOMP_PROMPT_ART */
+typedef int rsx_prompt_atlas_disabled;   /* ISO C: a unit needs one declaration */
+#endif
diff --git a/libs/video/rsx_prompt_atlas.h b/libs/video/rsx_prompt_atlas.h
new file mode 100644
index 0000000..05749e9
--- /dev/null
+++ b/libs/video/rsx_prompt_atlas.h
@@ -0,0 +1,94 @@
+/*
+ * ps3recomp - PC key prompts inside the game's DXT5 UI atlases
+ *
+ * Table of the Tokyo Jungle (NPUA80523) texture atlases that hold PS3 button
+ * glyphs, keyed by the renderer's content hash (rsx_stream_hash64, XXH64
+ * seed 0, of the whole single-mip BC3 payload), plus an in-place patcher that
+ * redraws each glyph cell as a PC key cap (libs/input/pad_prompt_art.c).
+ *
+ * Patching rules
+ *  - Each cell has an art rect (the original glyph's alpha bbox) and a clear
+ *    rect (art + 2 px, clipped to the sprite's UV cell and to neighbours).
+ *  - Every 4x4 block that the clear rect touches is decoded, the pixels inside
+ *    the clear rect are REPLACED (art inside the art rect, transparent in the
+ *    margin), pixels outside it keep their decoded value, and the block is
+ *    re-encoded. Blocks no clear rect touches are left byte-identical.
+ *  - The encoder always writes colour endpoints c0 > c1 (or c0 == c1 with all
+ *    indices 0), so DXT1-style 3-colour decoders give the same result.
+ *
+ * This step covers effectTexPack_EN.pac[0] and titleTexPack_EN.pac[3] only.
+ * Compiled only when PS3RECOMP_PROMPT_ART is defined (every .c file in libs/video is
+ * globbed into ps3recomp_runtime; without the define this unit is empty).
+ */
+
+#ifndef PS3RECOMP_RSX_PROMPT_ATLAS_H
+#define PS3RECOMP_RSX_PROMPT_ATLAS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "../input/pad_prompt_art.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct TjPromptCell {
+    const char* name;            /* e.g. "idx13 cross" (ELF table 0x27D340 index) */
+    int16_t ax0, ay0, ax1, ay1;  /* art rect, end-exclusive texels */
+    int16_t cx0, cy0, cx1, cy1;  /* clear rect (contains the art rect) */
+    uint8_t style;               /* PadPromptStyle */
+    uint8_t button;              /* PadPromptButton, or a PAD_PROMPT_GROUP_* */
+    uint8_t lit;                 /* DPAD: PAD_PROMPT_LIT_* */
+    const char* caption;         /* KEY_TEXT caption, else NULL */
+} TjPromptCell;
+
+typedef struct TjPromptAtlas {
+    const char* name;            /* "effectTexPack_EN.pac[0]" */
+    uint64_t xxh64;              /* rsx_stream_hash64 of the original payload */
+    uint32_t bytes;              /* payload bytes (single mip, tight BC3) */
+    uint32_t w, h;
+    uint32_t rsx_fmt;            /* 0x88 = DXT45 (match with fmt & 0x9F) */
+    const TjPromptCell* cells;
+    uint32_t cell_count;
+} TjPromptAtlas;
+
+/* All known atlases. */
+const TjPromptAtlas* tj_prompt_atlas_table(uint32_t* count);
+
+/* Atlas with this content hash and shape, or NULL. */
+const TjPromptAtlas* tj_prompt_atlas_find(uint64_t hash, size_t bytes, uint32_t w, uint32_t h);
+
+/* Checks that every rect lies inside the texture, art rects lie inside their
+ * clear rects and no two clear rects overlap. Returns 0 when valid; err gets
+ * the first problem. */
+int tj_prompt_atlas_validate(const TjPromptAtlas* atlas, char* err, size_t err_cap);
+
+/* BC3 (DXT5) block codec. rgba = 16 texels row-major, R,G,B,A.
+ * quality 0: PCA endpoints + least-squares refit; 1: adds an endpoint search. */
+void tj_bc3_decode_block(const uint8_t src[16], uint8_t rgba[64]);
+void tj_bc3_encode_block(const uint8_t rgba[64], uint8_t dst[16], int quality);
+
+typedef struct TjPromptPatchInfo {
+    uint32_t cells;              /* cells redrawn */
+    uint32_t blocks;             /* 4x4 blocks re-encoded */
+    double ms_art;               /* key-cap rendering */
+    double ms_encode;            /* decode + merge + encode */
+} TjPromptPatchInfo;
+
+/* Rewrites the prompt cells of a BC3 payload in place.
+ *   bc3/bytes/pitch: the copy to patch; pitch must be the tight row pitch
+ *                    (w/4*16) and bytes == pitch * h/4, otherwise -1.
+ *   intended:        optional w*h*4 RGBA; receives the merged pixels the
+ *                    encoder was given, for every touched block.
+ *   touched:         optional (w/4)*(h/4) bytes; set to 1 per touched block.
+ * Returns 0 on success, -1 bad arguments, -2 art rendering failed, -3 no memory. */
+int tj_prompt_atlas_patch(const TjPromptAtlas* atlas, uint8_t* bc3, size_t bytes,
+                          uint32_t pitch, const PadPromptLabels* labels, int quality,
+                          uint8_t* intended, uint8_t* touched, TjPromptPatchInfo* info);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_RSX_PROMPT_ATLAS_H */
diff --git a/libs/video/rsx_scaled_blit.h b/libs/video/rsx_scaled_blit.h
new file mode 100644
index 0000000..9c4632b
--- /dev/null
+++ b/libs/video/rsx_scaled_blit.h
@@ -0,0 +1,485 @@
+/* CPU implementation of the NV3089 scaled-image SRCCOPY path. */
+#ifndef PS3RECOMP_RSX_SCALED_BLIT_H
+#define PS3RECOMP_RSX_SCALED_BLIT_H
+
+#include <stdint.h>
+#include <string.h>
+#if defined(__SSE2__) || defined(_M_X64)
+#include <emmintrin.h>
+#endif
+
+enum rsx_scaled_blit_result {
+    RSX_SCALED_BLIT_OK = 0,
+    RSX_SCALED_BLIT_EMPTY,
+    RSX_SCALED_BLIT_UNSUPPORTED_FORMAT,
+    RSX_SCALED_BLIT_UNSUPPORTED_SURFACE,
+    RSX_SCALED_BLIT_UNSUPPORTED_OPERATION
+};
+
+struct rsx_scaled_blit_desc {
+    const uint8_t* src;
+    uint8_t* dst;
+    uint16_t src_pitch, dst_pitch;
+    uint16_t in_width, in_height;
+    uint16_t out_width, out_height;
+    uint16_t clip_x, clip_y, clip_width, clip_height;
+    uint16_t out_x, out_y;
+    uint16_t in_x_4, in_y_4;
+    int32_t ds_dx, dt_dy;
+    uint8_t src_format, dst_format;
+    uint8_t origin, interpolator;
+};
+
+enum rsx_scaled_blit_interpolator {
+    RSX_SCALED_BLIT_INTERPOLATOR_ZOH = 0,
+    RSX_SCALED_BLIT_INTERPOLATOR_FOH = 1
+};
+
+/* Exact 4-byte-pixel copy rectangle shared by the CPU and deferred GPU paths.
+ * This deliberately excludes scaling and format conversion: the CPU blit
+ * remains authoritative for every other NV3089 operation. */
+struct rsx_scaled_blit_exact_region {
+    uint16_t src_x, src_y;
+    uint16_t dst_x, dst_y;
+    uint16_t width, height;
+};
+
+/* Resolve a raw + byte-delta alias into a linear RGBA backing texture.  The
+ * caller supplies the actual backing dimensions; aliases that would wrap a
+ * row are rejected because CopyTextureRegion cannot represent that layout. */
+static inline int rsx_scaled_blit_alias_origin(
+    uint32_t base_raw, uint32_t raw, uint32_t pitch, uint32_t backing_w,
+    uint32_t backing_h, uint32_t rect_w, uint32_t rect_h,
+    uint32_t* out_x, uint32_t* out_y)
+{
+    if (!pitch || (pitch & 3u) || !backing_w || !backing_h || !rect_w || !rect_h ||
+        raw < base_raw)
+        return 0;
+    uint64_t delta = (uint64_t)raw - base_raw;
+    uint64_t backing_bytes = (uint64_t)pitch * backing_h;
+    if ((delta & 3u) || delta >= backing_bytes) return 0;
+    uint32_t x = (uint32_t)((delta % pitch) / 4u);
+    uint32_t y = (uint32_t)(delta / pitch);
+    if (x >= backing_w || y >= backing_h || rect_w > backing_w - x ||
+        rect_h > backing_h - y)
+        return 0;
+    if (out_x) *out_x = x;
+    if (out_y) *out_y = y;
+    return 1;
+}
+
+static inline int rsx_scaled_blit_guest_span_valid(
+    uint32_t ea, uint32_t pitch, uint32_t physical_w, uint32_t h,
+    uint64_t vm_size, uint64_t* out_bytes)
+{
+    if (!pitch || (pitch & 3u) || !physical_w || !h ||
+        physical_w > pitch / 4u)
+        return 0;
+    uint64_t bytes = (uint64_t)(h - 1u) * pitch + (uint64_t)physical_w * 4u;
+    uint64_t cap = vm_size ? vm_size : (1ULL << 32);
+    if (!bytes || (uint64_t)ea > cap || bytes > cap - ea)
+        return 0;
+    if (out_bytes) *out_bytes = bytes;
+    return 1;
+}
+
+/* Generic linear guest surface validation for CPU NV3089 paths.  Keep this
+ * separate from the RGBA-only deferred-record span helper above. */
+static inline int rsx_scaled_blit_guest_surface_valid(
+    uint32_t ea, uint64_t pitch, uint32_t physical_w, uint32_t h,
+    uint32_t bpp, uint64_t vm_size)
+{
+    if (!pitch || !physical_w || !h || !bpp ||
+        (uint64_t)physical_w > UINT64_MAX / bpp)
+        return 0;
+    uint64_t row_bytes = (uint64_t)physical_w * bpp;
+    if (pitch < row_bytes || (uint64_t)(h - 1u) >
+        (UINT64_MAX - row_bytes) / pitch)
+        return 0;
+    uint64_t bytes = (uint64_t)(h - 1u) * pitch + row_bytes;
+    uint64_t cap = vm_size ? vm_size : (UINT64_C(1) << 32);
+    return (uint64_t)ea <= cap && bytes <= cap - ea;
+}
+
+/* Deferred D3D readback is R,G,B,A; guest A8R8G8B8 bytes are A,R,G,B.
+ * Operate only on packed dirty rows, never D3D's padded row pitch. */
+static inline void rsx_exact_blit_rgba_to_guest_argb(
+    uint8_t* dst, const uint8_t* src, uint32_t pixels)
+{
+    uint32_t x = 0;
+#if defined(__SSE2__) || defined(_M_X64)
+    /* Runtime readback uses distinct allocations. Retain the original scalar
+     * semantics for any overlapping caller rather than widening its reads. */
+    uintptr_t d = (uintptr_t)dst, s = (uintptr_t)src;
+    uint64_t bytes = (uint64_t)pixels * 4;
+    if ((d > s ? d - s : s - d) >= bytes) {
+        for (; pixels - x >= 4; x += 4) {
+            __m128i rgba = _mm_loadu_si128((const __m128i*)(src + (uint64_t)x * 4));
+            __m128i argb = _mm_or_si128(_mm_slli_epi32(rgba, 8),
+                                         _mm_srli_epi32(rgba, 24));
+            _mm_storeu_si128((__m128i*)(dst + (uint64_t)x * 4), argb);
+        }
+    }
+#endif
+    for (; x < pixels; ++x) {
+        dst[x * 4 + 0] = src[x * 4 + 3];
+        dst[x * 4 + 1] = src[x * 4 + 0];
+        dst[x * 4 + 2] = src[x * 4 + 1];
+        dst[x * 4 + 3] = src[x * 4 + 2];
+    }
+}
+
+static inline int rsx_exact_blit_rects_overlap(
+    uint32_t ax, uint32_t ay, uint32_t aw, uint32_t ah,
+    uint32_t bx, uint32_t by, uint32_t bw, uint32_t bh)
+{
+    uint64_t ar = (uint64_t)ax + aw, ab = (uint64_t)ay + ah;
+    uint64_t br = (uint64_t)bx + bw, bb = (uint64_t)by + bh;
+    return ax < br && bx < ar && ay < bb && by < ab;
+}
+
+/* A later terminal write may replace an earlier plan only when it covers the
+ * entire older rectangle. Partial overlap would otherwise discard untouched
+ * authoritative pixels, so backend preflight rejects it. */
+static inline int rsx_exact_blit_rect_fully_contains(
+    uint32_t outer_x, uint32_t outer_y, uint32_t outer_w, uint32_t outer_h,
+    uint32_t inner_x, uint32_t inner_y, uint32_t inner_w, uint32_t inner_h)
+{
+    uint64_t outer_r = (uint64_t)outer_x + outer_w;
+    uint64_t outer_b = (uint64_t)outer_y + outer_h;
+    uint64_t inner_r = (uint64_t)inner_x + inner_w;
+    uint64_t inner_b = (uint64_t)inner_y + inner_h;
+    return outer_w && outer_h && inner_w && inner_h &&
+           outer_x <= inner_x && outer_y <= inner_y &&
+           outer_r >= inner_r && outer_b >= inner_b;
+}
+
+/* Sequential preflight snapshots source authority before it updates the
+ * destination. The returned value is record-local: a future producer cannot
+ * retroactively authorize an earlier source. */
+static inline int rsx_exact_blit_authority_step(
+    int source_authoritative, int* destination_authoritative)
+{
+    int cached = source_authoritative != 0;
+    if (cached && destination_authoritative) *destination_authoritative = 1;
+    return cached;
+}
+
+static inline int rsx_exact_blit_mapping_generation_stable(
+    uint64_t before, uint64_t after)
+{
+    return !(before & 1u) && before == after;
+}
+
+static inline int rsx_exact_blit_record_mapping_matches(
+    uint64_t record_generation, uint64_t before, uint64_t after,
+    uint32_t record_src_ea, uint32_t resolved_src_ea,
+    uint32_t record_dst_ea, uint32_t resolved_dst_ea)
+{
+    return rsx_exact_blit_mapping_generation_stable(before, after) &&
+           record_generation == before &&
+           record_src_ea == resolved_src_ea &&
+           record_dst_ea == resolved_dst_ea;
+}
+
+static inline int rsx_exact_blit_canonical_spans_overlap(
+    uint32_t ea_a, uint64_t span_a, uint32_t ea_b, uint64_t span_b)
+{
+    return span_a && span_b && (uint64_t)ea_a < (uint64_t)ea_b + span_b &&
+           (uint64_t)ea_b < (uint64_t)ea_a + span_a;
+}
+
+/* A Texture2D SRV cannot crop or reinterpret a MAIN mirror.  Reuse is safe
+ * only for the exact resolved layout; every other canonical overlap must be
+ * rejected before an immutable guest snapshot can be created. */
+static inline int rsx_exact_blit_main_source_layout_matches(
+    uint32_t mirror_ea, uint32_t mirror_pitch, uint32_t mirror_w,
+    uint32_t mirror_h, uint32_t source_ea, uint32_t source_pitch,
+    uint32_t source_w, uint32_t source_h)
+{
+    return mirror_pitch == source_pitch && mirror_w == source_w &&
+           mirror_h == source_h && mirror_ea == source_ea;
+}
+
+static inline int rsx_exact_blit_baseline_matches(
+    const uint8_t* current, const uint8_t* baseline, uint64_t bytes)
+{
+    return current && baseline && bytes <= SIZE_MAX &&
+           memcmp(current, baseline, (size_t)bytes) == 0;
+}
+
+/* The writeback path keeps the GPU result packed and checks every dirty guest
+ * row immediately before its all-or-nothing commit.  Keep this pure so the
+ * focused test can cover split rectangles without D3D/guest-thread state. */
+static inline int rsx_exact_blit_dirty_rows_match(
+    const uint8_t* guest, uint32_t guest_pitch, const uint8_t* baseline,
+    uint32_t row_bytes, uint32_t rows)
+{
+    if (!guest || !baseline || !guest_pitch || !row_bytes || !rows ||
+        row_bytes > guest_pitch)
+        return 0;
+    for (uint32_t y = 0; y < rows; ++y)
+        if (memcmp(guest + (uint64_t)y * guest_pitch,
+                   baseline + (uint64_t)y * row_bytes, row_bytes) != 0)
+            return 0;
+    return 1;
+}
+
+static inline void rsx_exact_blit_rgba_rows_to_guest_argb(
+    uint8_t* guest, uint32_t guest_pitch, const uint8_t* rgba,
+    uint32_t rgba_pitch, uint32_t pixels, uint32_t rows)
+{
+    for (uint32_t y = 0; y < rows; ++y)
+        rsx_exact_blit_rgba_to_guest_argb(guest + (uint64_t)y * guest_pitch,
+                                          rgba + (uint64_t)y * rgba_pitch,
+                                          pixels);
+}
+
+static inline uint32_t rsx_scaled_src_bpp(uint8_t format)
+{
+    if (format == 3 || format == 4) return 4; /* A/X8R8G8B8 */
+    if (format == 7) return 2;                /* R5G6B5 */
+    return 0;
+}
+
+static inline uint32_t rsx_scaled_dst_bpp(uint8_t format)
+{
+    if (format == 10 || format == 11) return 4; /* A8R8G8B8 / Y32 */
+    if (format == 4) return 2;                  /* R5G6B5 */
+    return 0;
+}
+
+/* Morton/Z-order texel index for a power-of-two RSX swizzled surface.  Keep
+ * the layout primitive here so CPU transfer paths use the same addressing as
+ * the texture uploader. */
+static inline uint32_t rsx_scaled_swizzled_offset(
+    uint32_t x, uint32_t y, uint32_t log2w, uint32_t log2h)
+{
+    uint32_t off = 0, shift = 0;
+    while (log2w && log2h) {
+        off |= (x & 1u) << shift; x >>= 1; ++shift;
+        off |= (y & 1u) << shift; y >>= 1; ++shift;
+        --log2w; --log2h;
+    }
+    return off | ((x | y) << shift);
+}
+
+static inline void rsx_scaled_convert_pixel(
+    uint8_t* dst, const uint8_t* src, uint32_t src_bpp, uint32_t dst_bpp)
+{
+    if (src_bpp == dst_bpp) {
+        memcpy(dst, src, src_bpp);
+    } else if (src_bpp == 2) {
+        uint16_t p = (uint16_t)(((uint16_t)src[0] << 8) | src[1]);
+        dst[0] = 0xFF;
+        dst[1] = (uint8_t)((((p >> 11) & 31) * 255 + 15) / 31);
+        dst[2] = (uint8_t)((((p >> 5) & 63) * 255 + 31) / 63);
+        dst[3] = (uint8_t)(((p & 31) * 255 + 15) / 31);
+    } else {
+        uint16_t p = (uint16_t)(((uint16_t)(src[1] >> 3) << 11) |
+                                ((uint16_t)(src[2] >> 2) << 5) |
+                                (src[3] >> 3));
+        dst[0] = (uint8_t)(p >> 8);
+        dst[1] = (uint8_t)p;
+    }
+}
+
+static inline void rsx_scaled_read_rgba(
+    uint8_t out[4], const uint8_t* src, uint32_t src_bpp)
+{
+    if (src_bpp == 4)
+        memcpy(out, src, 4);
+    else
+        rsx_scaled_convert_pixel(out, src, src_bpp, 4);
+}
+
+static inline int rsx_scaled_blit_exact_rgba_region(
+    const struct rsx_scaled_blit_desc* d,
+    struct rsx_scaled_blit_exact_region* out)
+{
+    uint32_t src_bpp = rsx_scaled_src_bpp(d->src_format);
+    uint32_t dst_bpp = rsx_scaled_dst_bpp(d->dst_format);
+    if (src_bpp != 4 || dst_bpp != 4 || !d->in_width || !d->in_height ||
+        !d->out_width || !d->out_height || !d->clip_width || !d->clip_height ||
+        !d->ds_dx || !d->dt_dy)
+        return 0;
+    uint32_t step_x = (uint32_t)d->ds_dx;
+    uint32_t step_y = (uint32_t)d->dt_dy;
+    if (step_x != 0x100000u || step_y != 0x100000u ||
+        d->clip_x >= d->out_width || d->clip_y >= d->out_height)
+        return 0;
+    uint32_t width = d->clip_width, height = d->clip_height;
+    if (width > d->out_width - d->clip_x) width = d->out_width - d->clip_x;
+    if (height > d->out_height - d->clip_y) height = d->out_height - d->clip_y;
+    int32_t base_x = (int32_t)d->in_x_4 - (d->origin == 1 ? 8 : 0);
+    int32_t base_y = (int32_t)d->in_y_4 - (d->origin == 1 ? 8 : 0);
+    base_x = base_x > 0 ? base_x / 16 : 0;
+    base_y = base_y > 0 ? base_y / 16 : 0;
+    uint32_t src_x = (uint32_t)base_x + d->clip_x;
+    uint32_t src_y = (uint32_t)base_y + d->clip_y;
+    if (src_x >= d->in_width || src_y >= d->in_height) return 0;
+    if (width > d->in_width - src_x) width = d->in_width - src_x;
+    if (height > d->in_height - src_y) height = d->in_height - src_y;
+    if (!width || !height || d->out_x > 0xFFFFu - d->clip_x ||
+        d->out_y > 0xFFFFu - d->clip_y)
+        return 0;
+    if (out) {
+        out->src_x = (uint16_t)src_x; out->src_y = (uint16_t)src_y;
+        out->dst_x = (uint16_t)(d->out_x + d->clip_x);
+        out->dst_y = (uint16_t)(d->out_y + d->clip_y);
+        out->width = (uint16_t)width; out->height = (uint16_t)height;
+    }
+    return 1;
+}
+
+/* Negative NV3089 scale mirrors around the remaining source extent.  Clamp
+ * the absolute-scale sample before reversing it so oversized coordinates keep
+ * sampling the nearest edge instead of repeating the wrong edge. */
+static inline uint32_t rsx_scaled_blit_axis_coordinate(
+    uint32_t sample, int32_t step, uint32_t source_extent)
+{
+    uint64_t magnitude = step < 0 ? (uint64_t)-(int64_t)step : (uint64_t)step;
+    uint64_t coordinate = ((uint64_t)sample * magnitude) >> 20;
+    if (coordinate >= source_extent)
+        coordinate = source_extent - 1u;
+    return step < 0 ? source_extent - 1u - (uint32_t)coordinate :
+                      (uint32_t)coordinate;
+}
+
+/* FOH blends toward the next texel in the signed scale direction.  Keep the
+ * fixed-point product in 64 bits before clamping extreme 11.20 scales. */
+static inline void rsx_scaled_blit_axis_foh(
+    uint32_t sample, int32_t step, uint32_t source_extent,
+    uint32_t* first, uint32_t* second, uint32_t* fraction)
+{
+    const uint64_t magnitude = step < 0 ? (uint64_t)-(int64_t)step :
+                                           (uint64_t)step;
+    const uint64_t fixed = (uint64_t)sample * magnitude;
+    uint64_t coordinate = fixed >> 20;
+    uint32_t frac = (uint32_t)(fixed & 0xFFFFFu);
+    if (coordinate >= source_extent - 1u) {
+        coordinate = source_extent - 1u;
+        frac = 0;
+    }
+    if (step < 0) {
+        *first = source_extent - 1u - (uint32_t)coordinate;
+        *second = *first ? *first - 1u : *first;
+    } else {
+        *first = (uint32_t)coordinate;
+        *second = *first + 1u < source_extent ? *first + 1u : *first;
+    }
+    *fraction = frac;
+}
+
+static inline uint8_t rsx_scaled_blit_lerp_u8(
+    uint8_t first, uint8_t second, uint32_t fraction)
+{
+    const uint32_t one = 0x100000u;
+    return (uint8_t)(((uint64_t)first * (one - fraction) +
+                      (uint64_t)second * fraction + (one >> 1)) >> 20);
+}
+
+static inline enum rsx_scaled_blit_result rsx_scaled_blit(
+    const struct rsx_scaled_blit_desc* d)
+{
+    uint32_t src_bpp = rsx_scaled_src_bpp(d->src_format);
+    uint32_t dst_bpp = rsx_scaled_dst_bpp(d->dst_format);
+    if (!src_bpp || !dst_bpp)
+        return RSX_SCALED_BLIT_UNSUPPORTED_FORMAT;
+    if (!d->in_width || !d->in_height || !d->out_width || !d->out_height ||
+        !d->clip_width || !d->clip_height)
+        return RSX_SCALED_BLIT_EMPTY;
+    if (!d->ds_dx || !d->dt_dy)
+        return RSX_SCALED_BLIT_UNSUPPORTED_OPERATION;
+
+    uint32_t src_pitch = d->src_pitch ? d->src_pitch : d->in_width * src_bpp;
+    uint32_t dst_pitch = d->dst_pitch ? d->dst_pitch : d->out_width * dst_bpp;
+    if (d->clip_x >= d->out_width || d->clip_y >= d->out_height)
+        return RSX_SCALED_BLIT_EMPTY;
+    uint32_t copy_w = d->clip_width;
+    uint32_t copy_h = d->clip_height;
+    if (copy_w > d->out_width - d->clip_x)
+        copy_w = d->out_width - d->clip_x;
+    if (copy_h > d->out_height - d->clip_y)
+        copy_h = d->out_height - d->clip_y;
+    int32_t base_x = (int32_t)d->in_x_4 - (d->origin == 1 ? 8 : 0);
+    int32_t base_y = (int32_t)d->in_y_4 - (d->origin == 1 ? 8 : 0);
+    base_x = base_x > 0 ? base_x / 16 : 0;
+    base_y = base_y > 0 ? base_y / 16 : 0;
+    if ((uint32_t)base_x >= d->in_width || (uint32_t)base_y >= d->in_height)
+        return RSX_SCALED_BLIT_EMPTY;
+    /* rel_x/rel_y are added to base before forming src.  Clamp against the
+     * remaining source extent, not the whole source, so a nonzero IMAGE_IN
+     * point cannot form a pointer past the source allocation. */
+    uint32_t source_width = d->in_width - (uint32_t)base_x;
+    uint32_t source_height = d->in_height - (uint32_t)base_y;
+    int32_t step_x = d->ds_dx;
+    int32_t step_y = d->dt_dy;
+
+    if (src_bpp == dst_bpp && step_x == 0x100000 && step_y == 0x100000) {
+        uint32_t sx = base_x + d->clip_x;
+        uint32_t sy = base_y + d->clip_y;
+        if (sx >= d->in_width || sy >= d->in_height)
+            return RSX_SCALED_BLIT_EMPTY;
+        if (copy_w > d->in_width - sx) copy_w = d->in_width - sx;
+        if (copy_h > d->in_height - sy) copy_h = d->in_height - sy;
+        for (uint32_t y = 0; y < copy_h; y++)
+            memcpy(d->dst + (size_t)(d->out_y + d->clip_y + y) * dst_pitch +
+                              (size_t)(d->out_x + d->clip_x) * dst_bpp,
+                   d->src + (size_t)(sy + y) * src_pitch +
+                              (size_t)sx * src_bpp,
+                   (size_t)copy_w * src_bpp);
+        return RSX_SCALED_BLIT_OK;
+    }
+
+    for (uint32_t y = 0; y < copy_h; y++) {
+        uint32_t rel_y = rsx_scaled_blit_axis_coordinate(
+            d->clip_y + y, step_y, source_height);
+        for (uint32_t x = 0; x < copy_w; x++) {
+            uint32_t rel_x = rsx_scaled_blit_axis_coordinate(
+                d->clip_x + x, step_x, source_width);
+            uint8_t* dst = d->dst +
+                (size_t)(d->out_y + d->clip_y + y) * dst_pitch +
+                (size_t)(d->out_x + d->clip_x + x) * dst_bpp;
+            if (d->interpolator != RSX_SCALED_BLIT_INTERPOLATOR_FOH) {
+                const uint8_t* src = d->src +
+                    (size_t)(base_y + rel_y) * src_pitch +
+                    (size_t)(base_x + rel_x) * src_bpp;
+                rsx_scaled_convert_pixel(dst, src, src_bpp, dst_bpp);
+            } else {
+                uint32_t rel_x1, rel_y1, frac_x, frac_y;
+                uint8_t p00[4], p10[4], p01[4], p11[4];
+                uint8_t top[4], bottom[4], blended[4];
+                rsx_scaled_blit_axis_foh(d->clip_x + x, step_x, source_width,
+                                          &rel_x, &rel_x1, &frac_x);
+                rsx_scaled_blit_axis_foh(d->clip_y + y, step_y, source_height,
+                                          &rel_y, &rel_y1, &frac_y);
+                const uint8_t* s00 = d->src +
+                    (size_t)(base_y + rel_y) * src_pitch +
+                    (size_t)(base_x + rel_x) * src_bpp;
+                const uint8_t* s10 = d->src +
+                    (size_t)(base_y + rel_y) * src_pitch +
+                    (size_t)(base_x + rel_x1) * src_bpp;
+                const uint8_t* s01 = d->src +
+                    (size_t)(base_y + rel_y1) * src_pitch +
+                    (size_t)(base_x + rel_x) * src_bpp;
+                const uint8_t* s11 = d->src +
+                    (size_t)(base_y + rel_y1) * src_pitch +
+                    (size_t)(base_x + rel_x1) * src_bpp;
+                rsx_scaled_read_rgba(p00, s00, src_bpp);
+                rsx_scaled_read_rgba(p10, s10, src_bpp);
+                rsx_scaled_read_rgba(p01, s01, src_bpp);
+                rsx_scaled_read_rgba(p11, s11, src_bpp);
+                for (uint32_t c = 0; c < 4u; ++c) {
+                    top[c] = rsx_scaled_blit_lerp_u8(p00[c], p10[c], frac_x);
+                    bottom[c] = rsx_scaled_blit_lerp_u8(p01[c], p11[c], frac_x);
+                    blended[c] = rsx_scaled_blit_lerp_u8(top[c], bottom[c], frac_y);
+                }
+                rsx_scaled_convert_pixel(dst, blended, 4, dst_bpp);
+            }
+        }
+    }
+    return RSX_SCALED_BLIT_OK;
+}
+
+#endif
diff --git a/libs/video/rsx_stream_hash.c b/libs/video/rsx_stream_hash.c
new file mode 100644
index 0000000..a372a3d
--- /dev/null
+++ b/libs/video/rsx_stream_hash.c
@@ -0,0 +1,168 @@
+#include "rsx_stream_hash.h"
+
+#include <string.h>
+
+#define RSX_H64_P1 UINT64_C(11400714785074694791)
+#define RSX_H64_P2 UINT64_C(14029467366897019727)
+#define RSX_H64_P3 UINT64_C(1609587929392839161)
+#define RSX_H64_P4 UINT64_C(9650029242287828579)
+#define RSX_H64_P5 UINT64_C(2870177450012600261)
+
+static uint64_t rsx_h64_rotl(uint64_t value, unsigned count)
+{
+    return (value << count) | (value >> (64u - count));
+}
+
+/* Windows and clang-cl targets are little-endian.  The byte reconstruction
+ * keeps the digest defined if this helper is built by a big-endian test host. */
+static uint64_t rsx_h64_read64le(const void* data)
+{
+    uint64_t native_value;
+    memcpy(&native_value, data, sizeof(native_value));
+#if defined(_WIN32) || defined(__LITTLE_ENDIAN__) || \
+    (defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+    return native_value;
+#else
+    const unsigned char* bytes = (const unsigned char*)data;
+    (void)native_value;
+    return (uint64_t)bytes[0]        | ((uint64_t)bytes[1] << 8)  |
+           ((uint64_t)bytes[2] << 16) | ((uint64_t)bytes[3] << 24) |
+           ((uint64_t)bytes[4] << 32) | ((uint64_t)bytes[5] << 40) |
+           ((uint64_t)bytes[6] << 48) | ((uint64_t)bytes[7] << 56);
+#endif
+}
+
+static uint32_t rsx_h64_read32le(const void* data)
+{
+    uint32_t native_value;
+    memcpy(&native_value, data, sizeof(native_value));
+#if defined(_WIN32) || defined(__LITTLE_ENDIAN__) || \
+    (defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+    return native_value;
+#else
+    const unsigned char* bytes = (const unsigned char*)data;
+    (void)native_value;
+    return (uint32_t)bytes[0]        | ((uint32_t)bytes[1] << 8) |
+           ((uint32_t)bytes[2] << 16) | ((uint32_t)bytes[3] << 24);
+#endif
+}
+
+static uint64_t rsx_h64_round(uint64_t acc, uint64_t input)
+{
+    acc += input * RSX_H64_P2;
+    acc = rsx_h64_rotl(acc, 31);
+    acc *= RSX_H64_P1;
+    return acc;
+}
+
+static uint64_t rsx_h64_merge_round(uint64_t acc, uint64_t value)
+{
+    acc ^= rsx_h64_round(0, value);
+    return acc * RSX_H64_P1 + RSX_H64_P4;
+}
+
+static void rsx_h64_consume32(rsx_stream_hash64_state* state,
+                              const unsigned char* input)
+{
+    state->v1 = rsx_h64_round(state->v1, rsx_h64_read64le(input + 0));
+    state->v2 = rsx_h64_round(state->v2, rsx_h64_read64le(input + 8));
+    state->v3 = rsx_h64_round(state->v3, rsx_h64_read64le(input + 16));
+    state->v4 = rsx_h64_round(state->v4, rsx_h64_read64le(input + 24));
+}
+
+void rsx_stream_hash64_init(rsx_stream_hash64_state* state)
+{
+    if (!state) return;
+    state->total_len = 0;
+    state->v1 = RSX_H64_P1 + RSX_H64_P2;
+    state->v2 = RSX_H64_P2;
+    state->v3 = 0;
+    state->v4 = 0 - RSX_H64_P1;
+    state->tail_len = 0;
+}
+
+void rsx_stream_hash64_update(rsx_stream_hash64_state* state,
+                              const void* data, size_t size)
+{
+    if (!state || !size) return;
+    if (!data) return;
+
+    const unsigned char* input = (const unsigned char*)data;
+    const unsigned char* end = input + size;
+    state->total_len += (uint64_t)size;
+
+    if (state->tail_len + size < sizeof(state->tail)) {
+        memcpy(state->tail + state->tail_len, input, size);
+        state->tail_len += size;
+        return;
+    }
+
+    if (state->tail_len) {
+        size_t needed = sizeof(state->tail) - state->tail_len;
+        memcpy(state->tail + state->tail_len, input, needed);
+        rsx_h64_consume32(state, state->tail);
+        input += needed;
+        state->tail_len = 0;
+    }
+
+    while ((size_t)(end - input) >= sizeof(state->tail)) {
+        rsx_h64_consume32(state, input);
+        input += sizeof(state->tail);
+    }
+
+    if (input != end) {
+        state->tail_len = (size_t)(end - input);
+        memcpy(state->tail, input, state->tail_len);
+    }
+}
+
+uint64_t rsx_stream_hash64_digest(const rsx_stream_hash64_state* state)
+{
+    if (!state) return 0;
+
+    uint64_t hash;
+    if (state->total_len >= 32) {
+        hash = rsx_h64_rotl(state->v1, 1) + rsx_h64_rotl(state->v2, 7) +
+               rsx_h64_rotl(state->v3, 12) + rsx_h64_rotl(state->v4, 18);
+        hash = rsx_h64_merge_round(hash, state->v1);
+        hash = rsx_h64_merge_round(hash, state->v2);
+        hash = rsx_h64_merge_round(hash, state->v3);
+        hash = rsx_h64_merge_round(hash, state->v4);
+    } else {
+        hash = RSX_H64_P5;
+    }
+
+    hash += state->total_len;
+    const unsigned char* input = state->tail;
+    const unsigned char* end = input + state->tail_len;
+    while ((size_t)(end - input) >= 8) {
+        uint64_t lane = rsx_h64_round(0, rsx_h64_read64le(input));
+        hash ^= lane;
+        hash = rsx_h64_rotl(hash, 27) * RSX_H64_P1 + RSX_H64_P4;
+        input += 8;
+    }
+    if ((size_t)(end - input) >= 4) {
+        hash ^= (uint64_t)rsx_h64_read32le(input) * RSX_H64_P1;
+        hash = rsx_h64_rotl(hash, 23) * RSX_H64_P2 + RSX_H64_P3;
+        input += 4;
+    }
+    while (input != end) {
+        hash ^= (uint64_t)(*input++) * RSX_H64_P5;
+        hash = rsx_h64_rotl(hash, 11) * RSX_H64_P1;
+    }
+
+    hash ^= hash >> 33;
+    hash *= RSX_H64_P2;
+    hash ^= hash >> 29;
+    hash *= RSX_H64_P3;
+    hash ^= hash >> 32;
+    return hash;
+}
+
+uint64_t rsx_stream_hash64(const void* data, size_t size)
+{
+    rsx_stream_hash64_state state;
+    rsx_stream_hash64_init(&state);
+    rsx_stream_hash64_update(&state, data, size);
+    return rsx_stream_hash64_digest(&state);
+}
diff --git a/libs/video/rsx_stream_hash.h b/libs/video/rsx_stream_hash.h
new file mode 100644
index 0000000..9c090de
--- /dev/null
+++ b/libs/video/rsx_stream_hash.h
@@ -0,0 +1,28 @@
+/* Deterministic streaming 64-bit content hash for RSX upload sources.
+ *
+ * XXH64-style scalar algorithm: fixed seed zero, no CPU dispatch, and all
+ * unaligned input loads pass through memcpy.  It is intentionally independent
+ * of guest-memory ownership/invalidation; callers still read every byte. */
+#ifndef PS3RECOMP_RSX_STREAM_HASH_H
+#define PS3RECOMP_RSX_STREAM_HASH_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct rsx_stream_hash64_state {
+    uint64_t total_len;
+    uint64_t v1;
+    uint64_t v2;
+    uint64_t v3;
+    uint64_t v4;
+    unsigned char tail[32];
+    size_t tail_len;
+} rsx_stream_hash64_state;
+
+void rsx_stream_hash64_init(rsx_stream_hash64_state* state);
+void rsx_stream_hash64_update(rsx_stream_hash64_state* state,
+                              const void* data, size_t size);
+uint64_t rsx_stream_hash64_digest(const rsx_stream_hash64_state* state);
+uint64_t rsx_stream_hash64(const void* data, size_t size);
+
+#endif
